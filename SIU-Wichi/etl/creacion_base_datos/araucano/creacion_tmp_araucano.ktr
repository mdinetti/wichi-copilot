    <sql>--Crea el esquema araucano_tmp
CREATE SCHEMA araucano_tmp;

--Tablas del esquema araucano_tmp
CREATE TABLE araucano_tmp.d_facultad
(
  idfacultad character varying,
  facultad character varying,
  provincia character varying,
  localidad character varying
);

CREATE TABLE araucano_tmp.d_mug_paises
(
  idpais character varying,
  nombre_pais character varying,
  continente character varying,
  nombre_continente character varying 
);

CREATE TABLE araucano_tmp.d_subserie
(
  idserie character varying,
  idsubserie character varying,
  idsubserieopcion character varying,
  nombreserie character varying
);

CREATE TABLE araucano_tmp.d_tipotitulo
(
  idtipotitulo character varying,
  tipotitulo character varying,
  nivel character varying
);

CREATE TABLE araucano_tmp.d_titulo
(
  idtitulo character varying,
  titulo character varying,
  rama character varying,
  disciplina character varying,
  area character varying
);

CREATE TABLE araucano_tmp.d_actividades
(
  idactividad character varying,
  nombre_actividad character varying
);

CREATE TABLE araucano_tmp.d_procedencias
(
  idProcedencia character varying,
  Nombre_Procedencia character varying
);

CREATE TABLE araucano_tmp.ft_cuadros1y2
(
    idfacultad character varying,
