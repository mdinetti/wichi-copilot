  </step>
  <step>
    <name>mapuche_tmp.ft_legajo</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT 
  ft_legajos.periodo_info as periodo_id,
  substring(periodo_info::TEXT FROM 1 for 4)::integer as anio_id,
  substring(periodo_info::TEXT FROM 5 for 2)::integer as mes_id, 
  ft_legajos.total_carga_horaria_hs, 
  ft_legajos.cant_legajos_con_cargo_activo, 
  ft_legajos.cant_legajos_liq, 
  d_persona.persona_id, 
  d_nivelestudio.nivelestudio_id, 
  d_activo.activo_id, 
  d_sexo.sexo_id, 
  d_rangoedad.edad_id, 
  d_estadocivil.estadocivil_id,
  d_discapacidad.discapacidad_id,
  d_categoria_incentivo.categoria_incentivo_id,
  d_dedicacion_incentivo.dedicacion_incentivo_id,
  d_titulo.titulo_id,
  nivest.nivelestudio_id as nivel_estudio_liq_id,
  d_regional.regional_id as regional_cabecera_id,
  d_dependenciadesig.dependenciadesign_id as dependencia_cabecera_id, 
  d_tipo_documento.tipo_documento_id,
  d_identidad_genero.identidad_genero_id,
  d_dependenciadesemp.dependenciadesemp_id as depdesemp_cabecera_id,
  d_obra_social.obra_social_id,
  titliq.titulo_id as titulo_liq_id,
  dpa.persona_anexos_id,
  current_date as fechacarga,
  ${subfuente_id} as subfuente_id 
FROM 
  mapuche_tmp.ft_legajos
  left outer join mapuche_dsa.d_persona on (ft_legajos.legajo_id = d_persona.legajo_codigo AND d_persona.vigente = 'Y' and d_persona.subfuente_id = ${subfuente_persona})
  left outer join mapuche_dsa.d_persona_anexos dpa on (ft_legajos.legajo_id = dpa.legajo_codigo AND dpa.vigente = 'Y' and dpa.subfuente_id = ${subfuente_persona})
  left outer join mapuche_dsa.d_activo on (ft_legajos.activo_id = d_activo.activo_codigo AND d_activo.vigente = 'Y' ) 
  left outer join mapuche_dsa.d_sexo on ( d_sexo.sexo_codigo = ft_legajos.sexo_id AND d_sexo.vigente = 'Y')
  left outer join mapuche_dsa.d_rangoedad on (d_rangoedad.edad = ft_legajos.edad AND d_rangoedad.vigente = 'Y')
  left outer join mapuche_dsa.d_estadocivil on (d_estadocivil.estadocivil_codigo = ft_legajos.estado_civil_id AND d_estadocivil.vigente = 'Y' and d_estadocivil.subfuente_id = ${subfuente_estadocivil}) 
  left outer join mapuche_dsa.d_nivelestudio on (d_nivelestudio.nivelestudio_codigo = ft_legajos.nivel_estudio_id AND   d_nivelestudio.vigente = 'Y'  and d_nivelestudio.subfuente_id = ${subfuente_nivelestudio}) 
  left outer join mapuche_dsa.d_discapacidad on (d_discapacidad.discapacidad_codigo = ft_legajos.discapacidad_id AND d_discapacidad.vigente = 'Y')
  left outer join mapuche_dsa.d_categoria_incentivo on (d_categoria_incentivo.categoria_incentivo_codigo = mapuche_tmp.ft_legajos.categoria_incentivo_codigo)
  left outer join mapuche_dsa.d_dedicacion_incentivo on (d_dedicacion_incentivo.dedicacion_incentivo_codigo = mapuche_tmp.ft_legajos.dedicacion_incentivo_codigo)
  left outer join mapuche_dsa.d_titulo on ( d_titulo.titulo_codigo = ft_legajos.titulo AND d_titulo.vigente = 'Y'  and d_titulo.subfuente_id = ${subfuente_titulo})
  left outer join mapuche_dsa.d_nivelestudio nivest on (nivest.nivelestudio_codigo = ft_legajos.nivel_estudio_liq AND nivest.vigente = 'Y' and nivest.subfuente_id = ${subfuente_nivelestudio}) 
  left outer join mapuche_dsa.d_regional on (d_regional.regional_codigo = ft_legajos.regional_cabecera_id AND d_regional.vigente = 'Y' and d_regional.subfuente_id = ${subfuente_regional})
  left outer join mapuche_dsa.d_dependenciadesig on (mapuche_dsa.d_dependenciadesig.instalacion_id=${instalacion_id} AND ft_legajos.dependencia_cabecera_id = d_dependenciadesig.dependenciadesign_codigo AND d_dependenciadesig.vigente = 'Y')
  left outer join mapuche_dsa.d_identidad_genero on (ft_legajos.identidad_genero = d_identidad_genero.identidad_genero_codigo AND d_identidad_genero.vigente = 'Y' and d_identidad_genero.subfuente_id = ${subfuente_identidad_genero}) 
  left outer join mapuche_dsa.d_titulo titliq on ( titliq.titulo_codigo = ft_legajos.titulo_liq AND titliq.vigente = 'Y'  and titliq.subfuente_id = ${subfuente_titulo})
  left outer join mapuche_dsa.d_obra_social on (ft_legajos.codc_obsoc = d_obra_social.obra_social_codigo AND d_obra_social.vigente = 'Y' and d_obra_social.subfuente_id = ${subfuente_obra_social}) 
  left outer join mapuche_dsa.d_tipo_documento on (ft_legajos.tipo_docum = d_tipo_documento.tipo_documento_codigo AND d_tipo_documento.vigente = 'Y' and d_tipo_documento.subfuente_id = ${subfuente_tipo_documento}) 
  left outer join mapuche_dsa.d_dependenciadesemp on (ft_legajos.depdesemp_cabecera = d_dependenciadesemp.dependenciadesemp_codigo AND d_dependenciadesemp.vigente = 'Y' ) 
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>160</xloc>
      <yloc>144</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
