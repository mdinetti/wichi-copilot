<?xml version="1.0" encoding="UTF-8" ?>

<!--

Este xml especifica validaciones a realizar
en la carga de datos a Wichi. Si no se cumple alguna
de las validaciones significa que los datos son
inválidos o que el extractor o importador es
inadecuado.

Mantener una copia de este archivo en los
exportadores y otra en los importadores, para poder
controlar que al actualizar una se actualice la otra.

-->


<validaciones id="validacionesMapuche"> <!-- el id debe cambiar con cualquier cambio en este xml -->
	<sistemaFuente>
		<codigo>2</codigo> <!-- el código del sistema fuente según estándares wichi -->
		<nombre>mapuche</nombre> <!-- valor permitido para el nombre del sistema fuente, sin el número de versión -->
		<obtencionDeSistema> <!-- cómo saber cuál es el sistema fuente (nombre sin versión) -->
			<sql><![CDATA[
                            select (case when(
				    select count(distinct(table_name))
				    from information_schema.tables
				    where table_schema = 'mapuche'
				    and table_name in (
					'dh01',
					'dh02',
					'dh03',
					'dh21'					)
				) = 4 then 'mapuche' else 'no_mapuche' end) as sistema
			]]>
			</sql>
		</obtencionDeSistema>
	</sistemaFuente>
	<versionSistemaFuente>
			<versionesAceptadas> <!-- versiones del sistema fuente que pasan la validación --> 
				<version>^3\.12\.1$</version>
				<version>^3\.12\.2$</version>
				<version>^3\.12\.3$</version>
				<version>^3\.13\..*$</version>
				<version>^3\.14\..*$</version>
				<version>^3\.15\..*$</version>
				<version>^3\.16\..*$</version>
				<version>^3\.17\..*$</version>
				<version>^3\.18\..*$</version>
				<version>^3\.19\..*$</version>
				<version>^3\.20\..*$</version>
				<version>^3\.21\..$</version>
				<version>^3\.22\..$</version>
				<version>^3\.23\..$</version>
				<version>^3\.24\..$</version>
				<version>^3\.25\..$</version>
				<version>^3\.26\.0$</version>
			</versionesAceptadas>
			<versionesNoAceptadas> <!-- versiones del sistema fuente que NO pasan la validación -->
				<version>^1\..*</version>
				<version>^2\..*</version>
				<version>^3\.0\..*$</version>
				<version>^3\.1\..*$</version>
				<version>^3\.2\..*$</version>
				<version>^3\.3\..*$</version>
				<version>^3\.4\..*$</version>
				<version>^3\.5\..*$</version>
				<version>^3\.6\..*$</version>
				<version>^3\.7\..*$</version>
				<version>^3\.8\..*$</version>
				<version>^3\.9\..*$</version>
				<version>^3\.10\..*$</version>
				<version>^3\.11\..*$</version>
				<version>^3\.12\.0$</version>
			</versionesNoAceptadas>
			<obtencionDeVersion>  <!-- cómo saber cuál es la versión del sistema fuente -->
				 <sql><![CDATA[
					SELECT dato_parametro as version  FROM mapuche.rrhhini  WHERE nombre_parametro = 'Version'
					]]>
				</sql>
			</obtencionDeVersion>
		</versionSistemaFuente>
