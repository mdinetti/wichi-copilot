<?xml version="1.0" encoding="UTF-8" ?>

<!--

Este xml especifica validaciones a realizar
en la carga de datos a Wichi. Si no se cumple alguna
de las validaciones significa que los datos son
inválidos o que el extractor o importador es
inadecuado.

Mantener una copia de este archivo en los
exportadores y otra en los importadores, para poder
controlar que al actualizar una se actualice la otra.

-->


<validaciones id="validacionesSudocu"> <!-- el id debe cambiar con cualquier cambio en este xml -->
	<sistemaFuente>
		<codigo>12</codigo> <!-- el código del sistema fuente según estándares wichi -->
		<nombre>Sudocu</nombre> <!-- valor permitido para el nombre del sistema fuente, sin el número de versión -->
		<obtencionDeSistema> <!-- cómo saber cuál es el sistema fuente (nombre sin versión) -->
			<sql><![CDATA[
                            select (case when(
				    select count(distinct(table_name))
				    from information_schema.tables
				    where table_schema = 'sudocu'
				    and table_name in (
					'areas',
					'usuarios',
					'documentos',
					'documentos_estados',
					'documentos_leidos',
					'documentos_tipos',
					'documentos_versiones',
					'eventos',
					'eventos_tipos'
					)
				) = 9 then 'Sudocu' else 'no_Sudocu' end) as sistema
			]]>
			</sql>
		</obtencionDeSistema>
	</sistemaFuente>
	<versionSistemaFuente>
			<versionesAceptadas> <!-- versiones del sistema fuente que pasan la validación --> 
				<version>^1\.3\.2$</version>
				<version>^1\.3\.3$</version>
				<version>^1\.3\.4$</version>
			</versionesAceptadas>
			<versionesNoAceptadas> <!-- versiones del sistema fuente que NO pasan la validación -->
				<version>^1\.1\..*</version>
				<version>^1\.2\..*</version>
				<version>^1\.3\.0$</version>				
				<version>^1\.3\.1$</version>
			</versionesNoAceptadas>
			<obtencionDeVersion>  <!-- cómo saber cuál es la versión del sistema fuente -->
				 <sql><![CDATA[
				 SELECT REPLACE((valor->'version')::character varying, '"', '')::character varying as version 
				 FROM sudocu.config where clave = 'version'
				 ]]>
				</sql>
			</obtencionDeVersion>
		</versionSistemaFuente>
