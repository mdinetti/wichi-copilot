  <step>
    <name>ft_preinscripciones</name>
    <type>TableInput</type>
    <description>Se leen los datos de la base siu_dsa.guarani_tmp</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT ra.responsable_academica_id, 
pf.propuesta_formativa_id, 
u.ubicacion_id, 
modalidad, 
pi.periodo_inscripcion_id,
pi.anio_academico,
fecha_preinscripcion, 
estado_preinsc, 
apyno, 
td.tipo_documento_desc  || ' ' || nro_documento as tipoynum, 
lts.sexo_id, 
fecha_nacimiento, 
lte.edad_id,
n.nacionalidad_id, 
loc_nac.localidad_id as loc_nacimiento_id,
estc.estado_civil_id, 
alu_est_civil_uh, 
tp.turno_preferido_id, 
ltpro.procedencia_id as colegio_secundario_id, 
titulo_secundario, 
anio_egreso_sec, 
lth.horas_trabajadas_id, 
CASE WHEN pertenece_pueblo_originario = 'S' AND pueblo_originario = 27 THEN pueblo_originario_otro
	 WHEN pertenece_pueblo_originario = 'S' THEN po.pueblo_originario_desc
		ELSE 'No Pertenece/NULO' END as pueblo_originario,
CASE WHEN identidad_genero = 13 THEN identidad_genero_otro
	ELSE coalesce(ig.identidad_genero_desc,'VACIO/NULO') END as identidad_genero,
celular_numero, 
e_mail, 
apyno_elegido, 
apyno_padre, 
apyno_madre, 
CASE WHEN sit_laboral_padre = 1 THEN  'Si - ' || top.trabajo_ocupacion_desc
	WHEN sit_laboral_padre IS NULL THEN 'No informado'
	ELSE 'No' END as padre_trab,  
CASE WHEN sit_laboral_madre = 1 THEN  'Si - ' || tom.trabajo_ocupacion_desc
	WHEN sit_laboral_madre IS NULL THEN 'No informado'
	ELSE 'No' END as madre_trab,
sit_actual_padre, 
sit_actual_madre, 
ep.estudio_padres_id as estudio_padre_id, 
em.estudio_padres_id as estudio_madre_id,
tipo_allegado_desc || ' ' || apyno_pers_alleg as allegado,
costeo_estudios as costeo_estudios_id,
tiene_beca as beca,
tecno_pc as tecno_pc_id,
tecno_int as tecno_internet_id,
idioma as idioma_id,
condicion_discapacidad, 
tiene_cud, 
discapacidad as discapacidad_id,
ch.cantidad_hijos_id, 
v.vive_con_id, 
cs.cobertura_salud_id, 
loc_per.localidad_id as localidad_periodo_lectivo_id, 
loc_pro.localidad_id as localidad_procedencia_id, 
es_celiaco, 
adeuda_materias
FROM guarani3_tmp.ft_preinscripciones ft
LEFT JOIN guarani3_tmp.d_tipo_documento td ON (ft.tipo_documento = td.tipo_documento_codigo)
LEFT JOIN guarani3_tmp.d_pueblos_originarios po ON (ft.pueblo_originario = po.pueblo_originario_codigo)
LEFT JOIN guarani3_tmp.d_identidad_genero ig ON (ft.identidad_genero = ig.identidad_genero_codigo)
LEFT JOIN guarani3_tmp.d_trabajo_ocupacion top ON (ft.padre_trab_ocup::integer = top.trabajo_ocupacion_codigo)
LEFT JOIN guarani3_tmp.d_trabajo_ocupacion tom ON (ft.madre_trab_ocup::integer = tom.trabajo_ocupacion_codigo)
LEFT JOIN guarani3_tmp.d_tipo_allegado ta ON (ft.tipo_allegado = ta.tipo_allegado_codigo)
LEFT JOIN guarani3_dsa.d_vive_con v ON (ft.vive_actual_con = v.vive_con_codigo)
LEFT JOIN guarani3_dsa.d_cobertura_salud cs ON (ft.obra_social_alu::integer = cs.cobertura_salud_codigo)
LEFT JOIN guarani3_dsa.d_periodo_inscripcion_preinscripciones pi ON (ft.periodo_insc = pi.periodo_inscripcion_codigo and pi.instalacion_id = ${instalacion_id})
LEFT JOIN guarani3_dsa.d_turno_preferido tp ON (ft.turno_preferido::integer = tp.turno_preferido_codigo and tp.instalacion_id = ${instalacion_id})
LEFT JOIN guarani3_dsa.d_cantidad_hijos ch ON (ft.cant_hijos_alum = ch.cantidad_hijos_codigo)
LEFT JOIN guarani3.d_propuesta_formativa pf on (ft.propuesta::text = pf.propuesta_formativa_codigo and pf.instalacion_id = ${g3_instalacion_id} and pf.vigente = 'Y')
LEFT JOIN guarani3.d_responsable_academica ra on (ft.responsable_academica::text = ra.responsable_academica_codigo and ra.instalacion_id = ${g3_instalacion_id} and ra.vigente = 'Y')
LEFT JOIN guarani3.d_ubicacion u on (ft.ubicacion::text = ubicacion_codigo and u.instalacion_id = ${g3_instalacion_id} and u.vigente = 'Y')
LEFT JOIN guarani3.d_sexo lts on (ft.sexo = lts.sexo_codigo and lts.vigente = 'Y')
LEFT JOIN guarani3.d_nacionalidad n on (ft.nacionalidad = n.nacionalidad_codigo and n.vigente='Y')
LEFT JOIN guarani3.d_localidad loc_nac on (ft.loc_nacimiento = loc_nac.localidad_codigo and loc_nac.vigente='Y')    
LEFT JOIN guarani3.d_estado_civil estc on (ft.estado_civil = estc.estado_civil_codigo and estc.vigente='Y')
LEFT JOIN guarani3.d_procedencia ltpro on (ft.colegio_secundario = ltpro.colegio_id and ltpro.vigente = 'Y')
LEFT JOIN guarani3.d_horas_trabajadas lth on (ft.alu_trabajo::text = lth.horas_trabajadas_codigo and lth.vigente = 'Y')
LEFT JOIN guarani3.d_localidad loc_per on (ft.loc_per_lect = loc_per.localidad_codigo and loc_per.vigente='Y')    
LEFT JOIN guarani3.d_localidad loc_pro on (ft.loc_proc = loc_pro.localidad_codigo and loc_pro.vigente='Y')
LEFT JOIN guarani3.d_estudio_padres ep on (ft.nivel_estudio_padre = ep.estudio_padres_codigo and ep.vigente='Y') 
LEFT JOIN guarani3.d_estudio_padres em on (ft.nivel_estudio_madre = em.estudio_padres_codigo and em.vigente='Y')
left join guarani3.d_edad lte on (ft.edad = lte.edad and lte.vigente = 'Y' ) </sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
