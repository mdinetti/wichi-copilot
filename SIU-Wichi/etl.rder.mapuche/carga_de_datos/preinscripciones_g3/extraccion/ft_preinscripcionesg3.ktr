    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_preinscripcionesg3</connection>
    <sql>WITH allegados_padre as (SELECT * FROM negocio.mdp_personas_allegados pap
WHERE pap.dato_allegado = (SELECT max(dato_allegado) FROM negocio.mdp_personas_allegados WHERE tipo_allegado = 'P'
   					       AND pap.dato_censal = dato_censal )),
allegados_madre as (SELECT * FROM negocio.mdp_personas_allegados pam
WHERE pam.dato_allegado = (SELECT max(dato_allegado) FROM negocio.mdp_personas_allegados WHERE tipo_allegado = 'M'
   					       AND pam.dato_censal = dato_censal )),						   
estudios as (SELECT * FROM negocio.mdp_datos_estudios pe WHERE pe.dato_estudio = (SELECT max(dato_estudio) FROM negocio.mdp_datos_estudios WHERE persona = pe.persona 
AND nivel_estudio = 3))
SELECT  responsable_academica, propuesta, ubicacion, modalidad, periodo_insc, date(fecha_preinscripcion) as fecha_preinscripcion, pp.estado as estado_preinsc,  
p.apellido || ', ' || p.nombres as apyno, 
pd.tipo_documento, pd.nro_documento,  /*unir en base wichi*/ 
(CASE p.sexo WHEN 'M' THEN 1 WHEN 'F' THEN 2 WHEN 'X' THEN 3 END) as sexo,
p.fecha_nacimiento, 
CASE WHEN (extract(MONTH FROM pp.fecha_preinscripcion) - extract(MONTH FROM p.fecha_nacimiento)) &lt; 0
	THEN ((extract(Year FROM pp.fecha_preinscripcion) - extract(YEAR FROM p.fecha_nacimiento)) - 1)
	WHEN ((extract(MONTH FROM pp.fecha_preinscripcion) - extract(MONTH FROM p.fecha_nacimiento)) = 0) AND (extract(DAY FROM p.fecha_nacimiento) > 1)
	THEN (extract(Year FROM pp.fecha_preinscripcion) - extract(YEAR FROM p.fecha_nacimiento) - 1)
	ELSE (extract(Year FROM pp.fecha_preinscripcion) - extract(YEAR FROM p.fecha_nacimiento)) END AS edad,
p.nacionalidad,
p.localidad_nacimiento as loc_nacimiento, dp.estado_civil, dp.unido_hecho as alu_est_civil_uh, --estado civil unido de hecho
dp.turno_preferido, 
pe.colegio as colegio_secundario, 
pe.titulo as titulo_secundario, 
pe.anio_egreso as anio_egreso_sec,
CASE
	WHEN de.trabajo_existe IS NULL OR (de.trabajo_existe = 1 AND de.trabajo_hora_sem IS NULL) THEN '-8' 
	WHEN de.trabajo_existe = 1 THEN de.trabajo_hora_sem 
	WHEN de.trabajo_existe = 4 THEN '-8'   
	ELSE '-9' 
END  as alu_trabajo,
--sit_laboral_alu,
p.pertenece_pueblo_originario, p.pueblo_originario, p.pueblo_originario_otro,
p.identidad_genero, p.identidad_genero_otro, 
(SELECT pc.telefono_codigo_area || pc.telefono_numero FROM negocio.mdp_personas_contactos pc 
 WHERE p.persona = pc.persona AND pc.contacto_tipo = 'C' ORDER BY persona_contacto DESC LIMIT 1) as celular_numero,
(SELECT pce.email FROM negocio.mdp_personas_contactos pce 
 WHERE p.persona = pce.persona AND pce.contacto_tipo = 'MP' ORDER BY persona_contacto DESC LIMIT 1) as e_mail,
p.apellido_elegido || ', ' || p.nombres_elegido as apyno_elegido, 

pap.apellido || ', ' || pap.nombres as apyno_padre, 
pam.apellido || ', ' || pam.nombres as apyno_madre, 
pap.trabajo_existe as sit_laboral_padre, 
pap.trabajo_ocupacion as padre_trab_ocup, 
pam.trabajo_existe as sit_laboral_madre, 
pam.trabajo_ocupacion as madre_trab_ocup,
dp.situacion_padre as sit_actual_padre, dp.situacion_madre as sit_actual_madre,-- padre_vive, madre_vive,
CASE WHEN pap.estudio_alcanzado = 12 THEN 13
	WHEN (pap.estudio_alcanzado is null) THEN 0
	WHEN (pap.estudio_alcanzado = 13) THEN -2
	WHEN pap.estudio_alcanzado = 14 THEN 12
	ELSE pap.estudio_alcanzado END as nivel_estudio_padre,  
CASE WHEN pam.estudio_alcanzado = 12 THEN 13
	WHEN (pam.estudio_alcanzado is null) THEN 0
	WHEN (pam.estudio_alcanzado = 13) THEN -2
	WHEN pam.estudio_alcanzado = 14 THEN 12
	ELSE pam.estudio_alcanzado END as nivel_estudio_madre,
(SELECT pao.tipo_allegado FROM negocio.mdp_personas_allegados pao 
 WHERE dc.dato_censal = pao.dato_censal AND pao.tipo_allegado NOT IN ('M','P') ORDER BY dato_allegado DESC LIMIT 1) as tipo_allegado, 
(SELECT  pao.apellido || ', ' || pao.nombres FROM negocio.mdp_personas_allegados pao 
 WHERE dc.dato_censal = pao.dato_censal AND pao.tipo_allegado NOT IN ('M','P')  ORDER BY dato_allegado DESC LIMIT 1) as apyno_pers_alleg, 

(CASE WHEN de.costeo_estudios_familiar = 'S' THEN 'familiar-' ELSE '' END 
	|| CASE WHEN de.costeo_estudios_plan_social = 'S' THEN 'plan_social-' ELSE '' END 
	|| CASE WHEN de.costeo_estudios_trabajo = 'S' THEN 'trabajo-' ELSE '' END 
	|| CASE WHEN de.costeo_estudios_beca = 'S' THEN 'beca-' ELSE '' END 
	|| CASE WHEN de.costeo_estudios_otro = 'S' THEN 'otro-' ELSE '' END) as costeo_estudios,

de.beca as tiene_beca,

(CASE WHEN da.tecnologia_pc_casa = 'S' THEN 'casa-' ELSE '' END 
	|| CASE WHEN da.tecnologia_pc_trabajo = 'S' THEN 'trabajo-' ELSE '' END 
	|| CASE WHEN da.tecnologia_pc_universidad = 'S' THEN 'universidad-' ELSE '' END 
	|| CASE WHEN da.tecnologia_pc_otro_lugar = 'S' THEN 'otro-' ELSE '' END) as tecno_pc,

(CASE WHEN da.tecnologia_int_movil = 'S' THEN 'movil-' ELSE '' END 
    || CASE WHEN da.tecnologia_int_casa = 'S' THEN 'casa-' ELSE '' END 
	|| CASE WHEN da.tecnologia_int_trabajo = 'S' THEN 'trabajo-' ELSE '' END 
	|| CASE WHEN da.tecnologia_int_universidad = 'S' THEN 'universidad-' ELSE '' END 
	|| CASE WHEN da.tecnologia_int_otro_lugar = 'S' THEN 'lugar-' ELSE '' END) as tecno_int,

(CASE WHEN da.nivel_idioma_ingles in (1,2,3) THEN 'Ingles-' ELSE '' END 
	|| CASE WHEN da.nivel_idioma_aleman in (1,2,3) THEN 'Alemán-' ELSE '' END 
	|| CASE WHEN da.nivel_idioma_frances in (1,2,3) THEN 'Francés-' ELSE '' END 
	|| CASE WHEN da.nivel_idioma_italiano in (1,2,3) THEN 'Italiano-' ELSE '' END 
	|| CASE WHEN da.nivel_idioma_portugues in (1,2,3) THEN 'Portugués-' ELSE '' END 
	|| CASE WHEN da.nivel_idioma_chino in (1,2,3) THEN 'Chino-' ELSE '' END 
	|| CASE WHEN da.idioma_otro is not null THEN 'Otro-' ELSE '' END) as idioma ,

dd.condicion_discapacidad,
dd.tiene_cud,
(CASE WHEN dd.disc_auditiva = 'S' THEN 'disc_auditiva-' ELSE '' END 
	|| CASE WHEN dd.disc_visual = 'S' THEN 'disc_visual-' ELSE '' END 
	|| CASE WHEN dd.disc_motora = 'S' THEN 'disc_motora-' ELSE '' END 
	|| CASE WHEN dd.disc_cond_psicosocial = 'S' THEN 'disc_cond_psicosocial-' ELSE '' END 
	|| CASE WHEN dd.disc_otra = 'S' THEN 'disc_otra-' ELSE '' END ) as discapacidad,

dp.cantidad_hijos as cant_hijos_alum, 
dp.vive_con as vive_actual_con, --mdp_vive_con
dp.cobertura_salud as obra_social_alu,  --mdp_cobertura_salud
dp.periodo_lectivo_localidad as loc_per_lect, 
dp.procedencia_localidad as loc_proc, 
dp.es_celiaco, pe.adeuda_materias_secundario as adeuda_materias
FROM negocio.sga_preinscripcion_propuesta pp LEFT JOIN negocio.mdp_personas p ON (pp.persona = p.persona)
LEFT JOIN negocio.mdp_personas_documentos pd ON (p.documento_principal = pd.documento)
LEFT JOIN negocio.mdp_datos_censales dc ON (p.persona = dc.persona)
LEFT JOIN negocio.mdp_datos_economicos de ON (dc.dato_censal = de.dato_censal)
LEFT JOIN negocio.mdp_datos_discapacidad dd ON (dc.dato_censal = dd.dato_censal)
LEFT JOIN negocio.mdp_datos_personales dp ON (dc.dato_censal = dp.dato_censal)
LEFT JOIN negocio.mdp_datos_actividades da ON (dc.dato_censal = da.dato_censal)
LEFT JOIN allegados_padre pap ON (dc.dato_censal = pap.dato_censal)
LEFT JOIN allegados_madre pam ON (dc.dato_censal = pam.dato_censal)
LEFT JOIN estudios pe ON (p.persona = pe.persona)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
