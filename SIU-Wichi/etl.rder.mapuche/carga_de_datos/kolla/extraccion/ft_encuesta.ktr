  </step>
  <step>
    <name>ft_encuesta</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_fuente</connection>
    <sql>SELECT
  substring('${carga_instalacion}',1, position('-' in '${carga_instalacion}')-1) AS instalacion_id,
  rd.respondido_encuesta   AS encuestado_codigo,
  re.respondido_formulario AS encuestado_formulario_codigo,
  ed.encuesta AS encuesta_codigo,
  fh.habilitacion::text AS habilitacion,
  ed.pregunta AS pregunta_codigo, 
  rd.respuesta_codigo::text AS respuesta_codigo,
  rd.respuesta_valor::text AS respuesta_valor_original,
  ((SELECT 
     count(*) 
   FROM kolla.sge_encuesta_definicion ed2 
   WHERE ed2.encuesta=ed.encuesta AND 
     ed2.bloque IN (SELECT b2.bloque FROM kolla.sge_bloque b2 WHERE b2.orden &lt; b.orden)) + 
      (SELECT 
     count(*) 
   FROM kolla.sge_encuesta_definicion ed3 
   WHERE ed3.encuesta=ed.encuesta AND ed3.bloque=ed.bloque AND ed3.orden&lt;ed.orden)
 + 1 ) AS posicion,
  b.orden AS bloque_codigo,
  rf.fecha_terminado AS fecha
 FROM kolla.sge_respondido_detalle rd, kolla.sge_encuesta_definicion ed, kolla.sge_pregunta p, kolla.sge_bloque b, 
  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, kolla.sge_formulario_habilitado fh,
  kolla.temp_encuestas tmp
 WHERE tmp.encuesta_codigo = ed.encuesta  AND
 rd.encuesta_definicion=ed.encuesta_definicion AND ed.pregunta=p.pregunta AND ed.bloque = b.bloque AND p.componente_numero NOT IN (4,5) AND
  rd.respondido_encuesta=re.respondido_encuesta AND re.respondido_formulario=rf.respondido_formulario AND rf.formulario_habilitado=fh.formulario_habilitado 
  AND fh.habilitacion = tmp.habilitacion AND rf.terminado='S'
UNION
SELECT  
  substring('${carga_instalacion}',1, position('-' in '${carga_instalacion}')-1) AS instalacion_id,
  rd.respondido_encuesta   AS encuestado_codigo,
  re.respondido_formulario AS encuestado_formulario_codigo,
  ed.encuesta AS encuesta_codigo,
  fh.habilitacion::text AS habilitacion,
  pr.pregunta AS pregunta_codigo, 
  array_to_string(array_agg(rd.respuesta_codigo ORDER BY pr.orden), '-/-') as respuesta_codigo,
  array_to_string(array_agg(r.valor_tabulado ORDER BY pr.orden), ' -/- ') as respuesta_valor,
  ((SELECT 
     count(*) 
   FROM kolla.sge_encuesta_definicion ed2 
   WHERE ed2.encuesta=ed.encuesta AND 
     ed2.bloque IN (SELECT b2.bloque FROM kolla.sge_bloque b2 WHERE b2.orden &lt; b.orden)) + 
      (SELECT 
     count(*) 
   FROM kolla.sge_encuesta_definicion ed3 
   WHERE ed3.encuesta=ed.encuesta AND ed3.bloque=ed.bloque AND ed3.orden&lt;ed.orden)
 + 1 ) AS posicion,
  b.orden AS bloque_codigo,
  rf.fecha_terminado AS fecha
 FROM kolla.sge_respondido_detalle rd, kolla.sge_pregunta_respuesta pr, kolla.sge_encuesta_definicion ed, kolla.sge_respuesta r, kolla.sge_pregunta p, kolla.sge_bloque b, 
  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, kolla.sge_formulario_habilitado fh,
  kolla.temp_encuestas tmp
 WHERE tmp.encuesta_codigo = ed.encuesta  AND rd.respuesta_codigo=pr.respuesta 
  AND rd.encuesta_definicion=ed.encuesta_definicion AND ed.pregunta=pr.pregunta
  AND rd.respuesta_codigo=r.respuesta
  AND ed.bloque = b.bloque
  AND rd.respuesta_codigo>0 AND rd.respuesta_codigo IS NOT NULL AND ed.pregunta=p.pregunta AND p.componente_numero IN (4,5)
  AND rd.respondido_encuesta=re.respondido_encuesta AND re.respondido_formulario=rf.respondido_formulario AND rf.formulario_habilitado=fh.formulario_habilitado 
  AND fh.habilitacion = tmp.habilitacion AND rf.terminado='S'
  AND p.tabla_asociada='' 
GROUP BY 1, 2, 3, 4, 5, 6, 9, 10, 11
UNION
SELECT 
  substring('${carga_instalacion}',1, position('-' in '${carga_instalacion}')-1) AS instalacion_id,
  rd.respondido_encuesta   AS encuestado_codigo,
  re.respondido_formulario AS encuestado_formulario_codigo,
  ed.encuesta AS encuesta_codigo,
  fh.habilitacion::text AS habilitacion,
  ed.pregunta AS pregunta_codigo, 
  array_to_string(array_agg(rd.respuesta_codigo ORDER BY rd.respuesta_codigo), '-/-') as respuesta_codigo,
  array_to_string(array_agg(rd.respuesta_valor ORDER BY rd.respuesta_valor), ' -/- ') as respuesta_valor,
  --rd.respuesta_codigo::text AS respuesta_codigo,
  --rd.respuesta_valor::text AS respuesta_valor_original,
  ((SELECT 
     count(*) 
   FROM kolla.sge_encuesta_definicion ed2 
   WHERE ed2.encuesta=ed.encuesta AND 
     ed2.bloque IN (SELECT b2.bloque FROM kolla.sge_bloque b2 WHERE b2.orden &lt; b.orden)) + 
      (SELECT 
     count(*) 
   FROM kolla.sge_encuesta_definicion ed3 
   WHERE ed3.encuesta=ed.encuesta AND ed3.bloque=ed.bloque AND ed3.orden&lt;ed.orden)
 + 1 ) AS posicion,
  b.orden AS bloque_codigo,
  rf.fecha_terminado AS fecha
 FROM kolla.sge_respondido_detalle rd, kolla.sge_encuesta_definicion ed, kolla.sge_pregunta p, kolla.sge_bloque b, 
  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, kolla.sge_formulario_habilitado fh,
  kolla.temp_encuestas tmp
 WHERE tmp.encuesta_codigo = ed.encuesta  AND rd.encuesta_definicion=ed.encuesta_definicion AND ed.pregunta=p.pregunta AND ed.bloque = b.bloque AND p.componente_numero IN (4,5)
  AND rd.respondido_encuesta=re.respondido_encuesta AND re.respondido_formulario=rf.respondido_formulario AND rf.formulario_habilitado=fh.formulario_habilitado 
  AND fh.habilitacion = tmp.habilitacion AND rf.terminado='S'
  AND p.tabla_asociada&lt;&gt;'' 
GROUP BY 1, 2, 3, 4, 5, 6, 9, 10, 11
UNION
SELECT DISTINCT
  substring('${carga_instalacion}',1, position('-' in '${carga_instalacion}')-1) AS instalacion_id,
  rd.respondido_encuesta   AS encuestado_codigo,
  re.respondido_formulario AS encuestado_formulario_codigo,
  ed.encuesta AS encuesta_codigo,
  fh.habilitacion::text AS habilitacion,
  -100 AS pregunta_codigo, 
  ''::text AS respuesta_codigo,
  fh.concepto::text AS respuesta_valor_original,
  0 AS posicion,
  0 AS bloque_codigo,
  rf.fecha_terminado AS fecha
 FROM kolla.sge_respondido_detalle rd, kolla.sge_encuesta_definicion ed,
  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, 
  kolla.sge_formulario_habilitado_detalle fhd, kolla.sge_formulario_habilitado fh,
  kolla.temp_encuestas tmp
 WHERE tmp.encuesta_codigo = ed.encuesta  AND rd.encuesta_definicion=ed.encuesta_definicion AND 
  rd.respondido_encuesta=re.respondido_encuesta AND re.formulario_habilitado_detalle=fhd.formulario_habilitado_detalle AND
  fhd.formulario_habilitado=fh.formulario_habilitado AND
  re.respondido_formulario=rf.respondido_formulario  
  AND fh.habilitacion = tmp.habilitacion AND rf.terminado='S'
UNION
SELECT DISTINCT
  substring('${carga_instalacion}',1, position('-' in '${carga_instalacion}')-1) AS instalacion_id,
  rd.respondido_encuesta   AS encuestado_codigo,
  re.respondido_formulario AS encuestado_formulario_codigo,
  ed.encuesta AS encuesta_codigo,
  fh.habilitacion::text AS habilitacion,
  -200 AS pregunta_codigo, 
  ''::text AS respuesta_codigo,
  fhd.elemento::text AS respuesta_valor_original,
  0 AS posicion,
  0 AS bloque_codigo,
  rf.fecha_terminado AS fecha
 FROM kolla.sge_respondido_detalle rd, kolla.sge_encuesta_definicion ed,
  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, 
  kolla.sge_formulario_habilitado_detalle fhd, kolla.sge_formulario_habilitado fh,
  kolla.temp_encuestas tmp
 WHERE tmp.encuesta_codigo = ed.encuesta  AND rd.encuesta_definicion=ed.encuesta_definicion AND 
  rd.respondido_encuesta=re.respondido_encuesta AND re.formulario_habilitado_detalle=fhd.formulario_habilitado_detalle AND
  fhd.formulario_habilitado=fh.formulario_habilitado AND
  re.respondido_formulario=rf.respondido_formulario 
  AND fh.habilitacion = tmp.habilitacion AND 
  rf.terminado='S'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
