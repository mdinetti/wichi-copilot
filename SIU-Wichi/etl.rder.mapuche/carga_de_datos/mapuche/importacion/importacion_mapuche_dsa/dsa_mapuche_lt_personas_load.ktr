    <connection>siu_dsa</connection>
    <sql>SELECT distinct
 ft_legajos.legajo_id, 
 ft_legajos.apellido, 
 ft_legajos.nombre,
 apellido || ',' || nombre || ' (' || cast(ft_legajos.legajo_id as varchar) || ')' as apellidonombre_desc,
 cuil,
 correo_electronico,
 fecha_nacimiento,
 direccion,
 domicilio_codigo,
 grupo_sanguineo,
 telefono,
 nro_ficha,
 nro_docum::integer as nro_documento,
 anioalta as anioalta_id,
 mesalta as mesalta_id,
 anioactualizacion as anioactualizacion_id,
 mesactualizacion as mesactualizacion_id,
 fec_ingreso as fecha_ingreso,
 fecha_recibo,
 nro_afili,
 ft_legajos.codigosituacion::integer,
 ft_legajos.codigocondicion::integer,
 ft_legajos.codigoactividad::integer,
 ft_legajos.codigozona,
 ft_legajos.porcaporteadicss::numeric(15,2),
 ft_legajos.provincialocalidad,
 cbu,
 ${subfuente} as subfuente_id
FROM 
  mapuche_tmp.ft_legajos
order by 1;</sql>
