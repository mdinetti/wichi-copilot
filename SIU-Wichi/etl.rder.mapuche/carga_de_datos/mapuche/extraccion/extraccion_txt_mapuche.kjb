    <entry>
      <name>Crear funciones y tablas temporales</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE OR REPLACE FUNCTION get_codigo_ona(text,text)
RETURNS integer AS
$BODY$
SELECT	do01.codigo_ona AS codigo_ona	
FROM mapuche.do01
WHERE 	do01.codc_regio = $1
AND do01.codigo_pampa = $2
$BODY$
  LANGUAGE sql VOLATILE
  COST 100;

-----------------------------------
-----------
----------------------------------
CREATE OR REPLACE FUNCTION tratar_ona(text)
RETURNS character varying AS
$BODY$
DECLARE 
  _cantidad integer;
  _codigo text;
	BEGIN
		_cantidad = length($1);

		SELECT CASE WHEN _cantidad =1 THEN '000'||$1
    WHEN _cantidad =2 THEN '00'||$1
    WHEN _cantidad =3 THEN '0'||$1
    ELSE $1
		END INTO _codigo;
		RETURN _codigo;	 
END;
$BODY$
  LANGUAGE plpgsql VOLATILE
  COST 100;

-----------------------------------
-----------
----------------------------------
CREATE OR REPLACE FUNCTION get_nudo(text,text,text,text)  --codc_uacad, --sede, --ona , cod_pres
RETURNS character varying AS
$BODY$
DECLARE 
  _nudo text;
  _codigo_ona text;
	BEGIN
		_nudo = NULL;
		_codigo_ona = NULL;
		SELECT dh96.nudo_sirhu INTO _nudo FROM mapuche.dh96 WHERE dh96.codigodependencia = $1;

		IF _nudo IS NULL THEN 
			SELECT get_codigo_ona($2,$1)::text  INTO _codigo_ona; 
			IF _codigo_ona IS NULL AND $3 = '0' THEN _codigo_ona = '9999';
			ELSE IF _codigo_ona IS NULL THEN _codigo_ona = $3;
END IF;
			_nudo = '070200'||$4||tratar_ona(_codigo_ona);
			END IF;
		END IF;	
		
		RETURN _nudo;
	END;
$BODY$
  LANGUAGE plpgsql VOLATILE
  COST 100;


-----------------------------------
-----------
----------------------------------

CREATE OR REPLACE FUNCTION get_estado_licencia(integer)
RETURNS  integer AS
$BODY$
DECLARE 
  _licencias RECORD;
	BEGIN
		SELECT 	es_remunerada,	es_absorcion,	porcremuneracion INTO _licencias
			FROM mapuche.dl02 WHERE nrovarlicencia = $1;
		IF((_licencias.es_remunerada IS TRUE) AND (_licencias.porcremuneracion > 0)) THEN
				return  2;			
			ELSE
				IF(_licencias.es_absorcion IS TRUE) THEN
					return 1;			
				ELSE
					return 3;		
				END IF;		
			END IF;
	END;
$BODY$
  LANGUAGE plpgsql VOLATILE
  COST 100;
-----------------------------------
-----------
----------------------------------				

CREATE OR REPLACE FUNCTION evaluar_licencias_cargo(integer,date,integer,integer)
RETURNS TABLE (nrovarlicencia integer) AS
$BODY$
	DECLARE
		periodo_actual ALIAS FOR $2;
		per_anoct ALIAS FOR $3;
		per_mesct ALIAS FOR $4;
BEGIN
	RETURN QUERY
		SELECT dh05.nrovarlicencia FROM  mapuche.dh05 dh05
		WHERE nro_cargo = $1
		AND (fec_desde &lt; periodo_actual)
		AND (fec_hasta IS NULL OR fec_hasta >= (per_anoct ||'-'||per_mesct ||'-'||01)::DATE );
END;
$BODY$
  LANGUAGE plpgsql VOLATILE
  COST 100;


CREATE OR REPLACE FUNCTION evaluar_licencias_legajo(integer,date,integer,integer)
RETURNS TABLE (nrovarlicencia integer) AS
$BODY$
	DECLARE
		periodo_actual ALIAS FOR $2;
		per_anoct ALIAS FOR $3;
		per_mesct ALIAS FOR $4;
BEGIN
	RETURN QUERY
		SELECT dh05.nrovarlicencia FROM  mapuche.dh05 dh05
		WHERE nro_legaj = $1
		AND (fec_desde &lt; periodo_actual)
		AND (fec_hasta IS NULL OR fec_hasta >= (per_anoct ||'-'||per_mesct ||'-'||01)::DATE );
END;
$BODY$
  LANGUAGE plpgsql VOLATILE
  COST 100;

-----------------------------------
-----------
----------------------------------
CREATE OR REPLACE FUNCTION  evaluar_Licencias(integer,integer,date,integer,integer)
RETURNS integer AS
$BODY$
	DECLARE
		legajo ALIAS FOR $1;
		cargo ALIAS FOR $2;
		periodo_actual ALIAS FOR $3;
		per_anoct ALIAS FOR $4;
		per_mesct ALIAS FOR $5;
		estado integer;
		_lic_leg record;
		_lic_carg record;
BEGIN

		SELECT CASE WHEN cargo IN (SELECT dh03.nro_cargo FROM mapuche.dh03 WHERE ((fec_alta &lt; periodo_actual ) AND (fec_baja IS NULL OR fec_baja >= (per_anoct ||'-'||per_mesct ||'-'||01)::DATE)))
		THEN 1 ELSE 0 END INTO estado;
		IF estado = 1 THEN
			estado=1;
			FOR _lic_leg IN SELECT evaluar_licencias_legajo(legajo,periodo_actual,per_anoct,per_mesct) LOOP
				estado = get_estado_licencia(_lic_leg.evaluar_licencias_legajo);
				if(estado = 3) THEN
				return estado;
				END IF;
			END LOOP;
			
			for _lic_carg IN SELECT evaluar_licencias_cargo(cargo,periodo_actual,per_anoct,per_mesct) LOOP
				estado = get_estado_licencia(_lic_carg.evaluar_licencias_cargo);
				if(estado = 3) THEN
				return estado;
				END IF;
			END LOOP;
		END IF;
		RETURN estado;
END;
$BODY$
  LANGUAGE plpgsql VOLATILE
  COST 100;

-------------------------------------------------------------------------------------------------------
-------
-------------------------------------------------------------------------------------------------------

CREATE OR REPLACE FUNCTION get_nivel_estudio_liq(integer,integer,integer)
  RETURNS character AS
$BODY$
SELECT trim(dh33.codc_nivel) as codc_nivel
FROM
mapuche.dh06,
mapuche.dh33,
mapuche.dh83
WHERE
dh06.nro_legaj = $1 AND
dh06.sino_liqui = 'S' AND
(EXTRACT (YEAR FROM dh06.fec_inici) &lt; $2 OR
(EXTRACT (YEAR FROM dh06.fec_inici) = $2 AND EXTRACT (MONTH FROM dh06.fec_inici) &lt;= $3) OR
dh06.fec_inici IS NULL) AND
dh06.codc_titul = dh33.codc_titul AND
dh33.codc_nivel = dh83.codc_nivel
ORDER BY nro_jerar DESC
LIMIT 1
$BODY$
  LANGUAGE sql VOLATILE
  COST 100;

-------------------------------------------------------------------------------------------------------
-------
-------------------------------------------------------------------------------------------------------

CREATE OR REPLACE FUNCTION get_titulo_liq(integer,integer,integer)
  RETURNS character AS
$BODY$
SELECT trim(dh33.codc_titul) as codc_titul
FROM
mapuche.dh06,
mapuche.dh33,
mapuche.dh83
WHERE
dh06.nro_legaj = $1 AND
dh06.sino_liqui = 'S' AND
(EXTRACT (YEAR FROM dh06.fec_inici) &lt; $2 OR
(EXTRACT (YEAR FROM dh06.fec_inici) = $2 AND EXTRACT (MONTH FROM dh06.fec_inici) &lt;= $3) OR
dh06.fec_inici IS NULL) AND
dh06.codc_titul = dh33.codc_titul AND
dh33.codc_nivel = dh83.codc_nivel
ORDER BY nro_jerar DESC
LIMIT 1
$BODY$
  LANGUAGE sql VOLATILE
  COST 100;

-- --------------------------------------------------------------------------------------------------------------------
   -- La tabla de vinculos sirve para unir los cargos que estan relacionados (vinculados), esta compuesta por dos campos
   -- nro_cargo_base (cargo inicial que luego va pasando por distintos cargos durante la evolucion de la persona).
   -- nro_cargo (cada uno de los distintos cargos que va teniendo la persona durante su vida 
   -- Ejemplo: si una persona tiene los siguientes cargos: 1 --> 3 --> 5
   -- En la tabla queda de la siguiente forma
   -- nro_cargo_base          nro_cargo
   --       1                    1
   --       1                    3
   --       1                    5
   -- --------------------------------------------------------------------------------------------------------------------
   -- Generacion de tabla vinculos
DROP TABLE IF EXISTS public.vinculos; 

CREATE TABLE public.vinculos(
nro_cargo_base integer, nro_cargo integer
);

CREATE OR REPLACE FUNCTION public.generar_vinculos()
  RETURNS boolean AS
$BODY$

DECLARE
   CantVinculos INT4;

BEGIN
   
   -- Se eliminan sus datos
   TRUNCATE public.vinculos;
   -- Se cargan todos los cargos iguales.
   INSERT INTO public.vinculos SELECT vcl_cargo, nro_cargo 
				FROM mapuche.dh10 
				WHERE vcl_cargo = nro_cargo; 
   -- Se cargan todos los cargos que son base.
   INSERT INTO public.vinculos (SELECT vcl_cargo, nro_cargo 
				FROM mapuche.dh10 
				WHERE vcl_cargo &lt;&gt; nro_cargo AND
					vcl_cargo IN (SELECT vcl_cargo FROM mapuche.dh10 WHERE vcl_cargo=nro_cargo)); 
   -- Se cuentan la cantidad de registros.
   CantVinculos = 0;

   WHILE CantVinculos &lt; (SELECT count(1) FROM public.vinculos) LOOP
      -- Se cargan todos los cargos que no estan en la tabla vinculos y que tienen su cargo base ya cargado
      CantVinculos = (SELECT count(1) FROM public.vinculos);
      INSERT INTO public.vinculos (SELECT v.nro_cargo_base, d.nro_cargo 
				FROM mapuche.dh10 d, public.vinculos v
				WHERE d.vcl_cargo = v.nro_cargo
				AND NOT EXISTS (SELECT 1 FROM public.vinculos vin WHERE vin.nro_cargo_base=v.nro_cargo_base AND vin.nro_cargo=d.nro_cargo LIMIT 1));
   END LOOP;
   RETURN 1;
END
$BODY$
LANGUAGE plpgsql VOLATILE;

SELECT public.generar_vinculos();</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
