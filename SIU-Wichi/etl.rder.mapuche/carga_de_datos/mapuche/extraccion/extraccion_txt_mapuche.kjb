    <entry>
      <name>eliminar funciones</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP FUNCTION get_codigo_ona(text,text);
DROP FUNCTION tratar_ona(text);
DROP FUNCTION get_nudo(text,text,text,text);
