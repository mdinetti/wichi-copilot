    <entry>
      <name>Borrar datos FTs dw (periodo)</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>--Borrar los datos del período en correspondiente en las FTs de la base siu_dw.rhun
delete from rhun.ft_cargo_liquidado where periodo_id = ${periodo};
delete from rhun.ft_cargos_planta where periodo_id = ${periodo};
delete from rhun.ft_datos_personales_planta where periodo_id = ${periodo};
delete from rhun.ft_detalle_liquidacion_haberes where periodo_id = ${periodo};
delete from rhun.ft_detalle_liquidacion_haberes_por_grupo where periodo_id = ${periodo};
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
