    <entry>
      <name>DELETE  ft_alumnosarau</name>
      <description/>
      <type>SQL</type>
      <sql>DELETE FROM guarani.gua_dw_ft_alumnosarau&#xa;WHERE unidadacademica_id IN &#xa;&#x28;SELECT DISTINCT&#x28;b.unidadacademica_id&#x29;&#xa;FROM guarani_tmp.gua_dsa_lt_unidadesacademicas a &#xa;INNER JOIN guarani.gua_dw_lt_unidadesacademicas b&#xa;ON a.unidadacademica_id &#x3d; b.unidadacademica_id_gua&#xa;&#x29;&#x3b;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>731</xloc>
      <yloc>226</yloc>
      </entry>
