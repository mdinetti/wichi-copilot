  <step>
    <name>examen</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_guarani</connection>
    <sql>-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Archivo: FT_Examen.txt
--  * Examenes de Actas Cerradas y Abiertas
--  * Examenes en otras propuestas (Examenes equivalentes). Muestra examenes de actividades
--    que se encuentran en el plan actual del alumno
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- ACTAS DE EXAMEN CERRADAS
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
WITH actas_cerradas as (SELECT *  FROM negocio.sga_actas WHERE sga_actas.origen = 'E' AND estado='C'),
actas_cerradas_det as (SELECT * FROM negocio.sga_actas_detalle WHERE sga_actas_detalle.instancia IN (3,4,7) -- Regulares / Libres / Examen Complementario
	  AND sga_actas_detalle.estado = 'A' AND sga_actas_detalle.rectificado = 'N'),
 actas_abiertas as (SELECT *  FROM negocio.sga_actas WHERE sga_actas.origen = 'E' AND estado='A')
SELECT  
	_wichi_mesas_examen.mesa_examen_ubicacion as ubicacion_id,
	cast(_wichi_mesas_examen.anio_academico as integer) as anio_academico,
	sga_periodos_genericos.periodo_generico_tipo as codigo_tipo_periodo,
	pte.nombre as turno_examen_nombre,
	_wichi_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,
	to_char(greatest(_wichi_mesas_examen.mesa_examen_fecha,'19000101'::date), 'DD/MM/YYYY') as fecha_examen,
    _wichi_mesas_examen.llamado_mesa as mesa_id,
	sga_alumnos.alumno,
	sga_alumnos.propuesta,
	actas_cerradas_det.plan_version as plan_version,
	sga_elementos.elemento as actividad,
	sga_catedras.catedra as catedra,
	actas_cerradas_det.resultado as resultado,
	actas_cerradas_det.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	0 as actividad_comun,
	actas_cerradas.tipo_acta as tipo_acta,
	actas_cerradas.nro_acta as nro_acta,
	actas_cerradas.estado as estado_acta,
	actas_cerradas_det.instancia as condicion_alumno,
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (_wichi_mesas_examen.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera
	intentos.nro_intento as nrointento,       -- Número de vez que intenta rendir examen de la materia
	
	1 as uno, -- Cantidad de registros de exámenes. Es siempre 1
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    0 as modalidad,
 	sga_alumnos.persona,
	'select get_horas_trabajo_araucano('||sga_alumnos.persona||')' as query_horas_trabajadas,
	'select get_estado_civil('||sga_alumnos.persona||')' as query_estado_civil,
	'select get_localidad_per_lec('||sga_alumnos.persona||')' as query_localidad_per_lec,
	'select get_localidad_proc('||sga_alumnos.persona||')' as query_localidad_proc,
	'select get_costeo_estudios('||sga_alumnos.persona||')' as query_costeo_estudios,
	'select get_beca('||sga_alumnos.persona||')' as query_beca,
	'select get_tecno_internet('||sga_alumnos.persona||')' as query_tecno_internet,
	'select get_tecno_pc('||sga_alumnos.persona||')' as query_tecno_pc,
	'select get_idioma('||sga_alumnos.persona||')' as query_idioma,
	0 as discapacidad

	FROM actas_cerradas,
	     actas_cerradas_det LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = actas_cerradas_det.escala_nota AND sga_escalas_notas_det.nota = actas_cerradas_det.nota),
	     sga_planes_versiones,
	     _wichi_mesas_examen
                LEFT JOIN sga_catedras ON sga_catedras.catedra = _wichi_mesas_examen.mesa_examen_catedra,
	     sga_elementos,
	     sga_periodos as pte,
	     sga_alumnos,
	     sga_propuestas,
	     mdp_personas,
	     _wichi_ingreso_alumnos as ingreso,
	     _wichi_intentos_examenes intentos,
		 sga_periodos_genericos
	     
	WHERE actas_cerradas_det.id_acta = actas_cerradas.id_acta
	  AND _wichi_mesas_examen.llamado_mesa = actas_cerradas.llamado_mesa
	  AND sga_elementos.elemento = _wichi_mesas_examen.mesa_examen_elemento
	  AND pte.periodo = _wichi_mesas_examen.turno_examen_periodo
	  AND pte.periodo_generico = sga_periodos_genericos.periodo_generico
	  AND sga_planes_versiones.plan_version = actas_cerradas_det.plan_version
	  AND sga_alumnos.alumno = actas_cerradas_det.alumno
	  AND sga_alumnos.persona = mdp_personas.persona
	  AND sga_propuestas.propuesta = sga_alumnos.propuesta
	  AND ingreso.alumno = sga_alumnos.alumno
	  AND intentos.alumno = actas_cerradas_det.alumno
	  AND intentos.elemento = _wichi_mesas_examen.mesa_examen_elemento
      AND intentos.llamado_mesa = _wichi_mesas_examen.llamado_mesa
      AND (${periodo} = 0 or _wichi_mesas_examen.anio_academico = ${periodo})

UNION ALL

  -- Examenes aprobados en otras propuestas del alumno
  SELECT  
	_wichi_mesas_examen.mesa_examen_ubicacion as ubicacion_id,
	cast(_wichi_mesas_examen.anio_academico as integer) as anio_academico,
	sga_periodos_genericos.periodo_generico_tipo as codigo_tipo_periodo,
	pte.nombre as turno_examen_nombre,
	_wichi_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,
	to_char(greatest(_wichi_mesas_examen.mesa_examen_fecha,'19000101'::date), 'DD/MM/YYYY') as fecha_examen,
    _wichi_mesas_examen.llamado_mesa as mesa_id,
	sga_alumnos2.alumno,     
	sga_alumnos2.propuesta,
	sga_planes_versiones2.plan_version as plan_version,  
	sga_elementos.elemento as actividad,  
	sga_catedras.catedra as catedra,
	actas_cerradas_det.resultado as resultado,
	actas_cerradas_det.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	1 as actividad_comun,
	actas_cerradas.tipo_acta as tipo_acta,
	actas_cerradas.nro_acta as nro_acta,
	actas_cerradas.estado as estado_acta,
	actas_cerradas_det.instancia as condicion_alumno,
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (_wichi_mesas_examen.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera
	intentos.nro_intento as nrointento,       -- Número de vez que intenta rendir examen de la materia
	
	1 as uno, -- Cantidad de registros de exámenes. Es siempre 1
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    0 as modalidad,
 	sga_alumnos.persona,
	'select get_horas_trabajo_araucano('||sga_alumnos.persona||')' as query_horas_trabajadas,
	'select get_estado_civil('||sga_alumnos.persona||')' as query_estado_civil,
	'select get_localidad_per_lec('||sga_alumnos.persona||')' as query_localidad_per_lec,
	'select get_localidad_proc('||sga_alumnos.persona||')' as query_localidad_proc,
	'select get_costeo_estudios('||sga_alumnos.persona||')' as query_costeo_estudios,
	'select get_beca('||sga_alumnos.persona||')' as query_beca,
	'select get_tecno_internet('||sga_alumnos.persona||')' as query_tecno_internet,
	'select get_tecno_pc('||sga_alumnos.persona||')' as query_tecno_pc,
	'select get_idioma('||sga_alumnos.persona||')' as query_idioma,
	0 as discapacidad

	FROM 
         actas_cerradas,
	     actas_cerradas_det LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = actas_cerradas_det.escala_nota AND sga_escalas_notas_det.nota = actas_cerradas_det.nota),
	     sga_planes_versiones,
	     _wichi_mesas_examen
                LEFT JOIN sga_catedras ON sga_catedras.catedra = _wichi_mesas_examen.mesa_examen_catedra,
	     sga_elementos,
	     sga_periodos as pte,
	     sga_alumnos,
	     sga_propuestas,
	     mdp_personas,
	     _wichi_ingreso_alumnos as ingreso,
	     _wichi_intentos_examenes intentos,

	     sga_alumnos as sga_alumnos2,
	     sga_planes_versiones as sga_planes_versiones2,
	     sga_elementos_plan as sga_elementos_plan2,
	     sga_elementos_revision as sga_elementos_revision2,
		 sga_periodos_genericos
	     
	WHERE actas_cerradas_det.id_acta = actas_cerradas.id_acta
	  AND _wichi_mesas_examen.llamado_mesa = actas_cerradas.llamado_mesa
	  AND sga_elementos.elemento = _wichi_mesas_examen.mesa_examen_elemento
	  AND pte.periodo = _wichi_mesas_examen.turno_examen_periodo
	  AND pte.periodo_generico = sga_periodos_genericos.periodo_generico
	  AND sga_planes_versiones.plan_version = actas_cerradas_det.plan_version
	  AND sga_alumnos.alumno = actas_cerradas_det.alumno
	  AND sga_alumnos.persona = mdp_personas.persona
	  AND sga_elementos.elemento = _wichi_mesas_examen.mesa_examen_elemento
	  
	  -- Otra propuesta del alumno  
	  AND sga_alumnos2.persona = sga_alumnos.persona
	  AND sga_alumnos2.propuesta &lt;&gt; sga_alumnos.propuesta
	  AND sga_propuestas.propuesta = sga_alumnos2.propuesta
	  AND sga_planes_versiones2.plan_version = sga_alumnos2.plan_version
	  AND ingreso.alumno = sga_alumnos2.alumno
	  AND sga_elementos_revision2.elemento = sga_elementos.elemento
	  AND sga_elementos_plan2.plan_version      = sga_alumnos2.plan_version
	  AND sga_elementos_plan2.elemento_revision = sga_elementos_revision2.elemento_revision
	  
	  AND intentos.alumno = actas_cerradas_det.alumno
	  AND intentos.elemento = _wichi_mesas_examen.mesa_examen_elemento
      AND intentos.llamado_mesa = _wichi_mesas_examen.llamado_mesa
	  AND (${periodo} = 0 or _wichi_mesas_examen.anio_academico = ${periodo})


-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- ACTAS ABIERTAS
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
UNION ALL

-- Actas abiertas de examenes donde el alumno lo hizo por su propuesta
SELECT  
	_wichi_mesas_examen.mesa_examen_ubicacion as ubicacion_id,
	cast(_wichi_mesas_examen.anio_academico as integer) as anio_academico,
	sga_periodos_genericos.periodo_generico_tipo as codigo_tipo_periodo,
	pte.nombre as turno_examen_nombre,
	_wichi_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,
	to_char(greatest(_wichi_mesas_examen.mesa_examen_fecha,'19000101'::date), 'DD/MM/YYYY') as fecha_examen,
    _wichi_mesas_examen.llamado_mesa as mesa_id,
	sga_alumnos.alumno,
	sga_alumnos.propuesta, -- sga_propuestas.codigo as carrera,
	sga_eval_detalle_examenes.plan_version as plan_version,
	sga_elementos.elemento as actividad, 
	--_wichi_mesas_examen.mesa_examen_elemento as materia,
	sga_catedras.catedra as catedra,
	sga_eval_detalle_examenes.resultado as resultado,
	sga_eval_detalle_examenes.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	0 as actividad_comun,
	actas_abiertas.tipo_acta as tipo_acta,
	actas_abiertas.nro_acta as nro_acta,
	actas_abiertas.estado as estado_acta,
	sga_eval_detalle_examenes.instancia as condicion_alumno,
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (_wichi_mesas_examen.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera
	intentos.nro_intento as nrointento,       -- Número de vez que intenta rendir examen de la materia
	
	1 as uno, -- Cantidad de registros de exámenes. Es siempre 1
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    0 as modalidad,
 	sga_alumnos.persona,
	'select get_horas_trabajo_araucano('||sga_alumnos.persona||')' as query_horas_trabajadas,
	'select get_estado_civil('||sga_alumnos.persona||')' as query_estado_civil,
	'select get_localidad_per_lec('||sga_alumnos.persona||')' as query_localidad_per_lec,
	'select get_localidad_proc('||sga_alumnos.persona||')' as query_localidad_proc,
	'select get_costeo_estudios('||sga_alumnos.persona||')' as query_costeo_estudios,
	'select get_beca('||sga_alumnos.persona||')' as query_beca,
	'select get_tecno_internet('||sga_alumnos.persona||')' as query_tecno_internet,
	'select get_tecno_pc('||sga_alumnos.persona||')' as query_tecno_pc,
	'select get_idioma('||sga_alumnos.persona||')' as query_idioma,
	0 as discapacidad

	FROM 
         actas_abiertas,
         sga_eval_detalle_examenes LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = sga_eval_detalle_examenes.escala_nota AND  sga_escalas_notas_det.nota = sga_eval_detalle_examenes.nota),
	     sga_planes_versiones,
	     _wichi_mesas_examen
                LEFT JOIN sga_catedras ON sga_catedras.catedra = _wichi_mesas_examen.mesa_examen_catedra,
	     sga_elementos,
	     sga_periodos as pte,
	     sga_alumnos,
	     sga_propuestas,
	     mdp_personas,
	     _wichi_ingreso_alumnos as ingreso,
	     _wichi_intentos_examenes as intentos,
		 sga_periodos_genericos
	     
	WHERE sga_eval_detalle_examenes.id_acta = actas_abiertas.id_acta
	  AND sga_eval_detalle_examenes.instancia IN (3,4,7) -- Regulares / Libres / Examen Complementario
	  AND _wichi_mesas_examen.llamado_mesa = actas_abiertas.llamado_mesa
	  AND sga_elementos.elemento = _wichi_mesas_examen.mesa_examen_elemento
	  AND pte.periodo = _wichi_mesas_examen.turno_examen_periodo
	  AND pte.periodo_generico = sga_periodos_genericos.periodo_generico
	  AND sga_planes_versiones.plan_version = sga_eval_detalle_examenes.plan_version
	  AND sga_alumnos.alumno = sga_eval_detalle_examenes.alumno
	  AND sga_alumnos.persona = mdp_personas.persona
	  AND sga_propuestas.propuesta = sga_alumnos.propuesta

	  AND ingreso.alumno = sga_alumnos.alumno

	  AND intentos.alumno = sga_alumnos.alumno
	  AND intentos.elemento = sga_elementos.elemento
      AND intentos.llamado_mesa = actas_abiertas.llamado_mesa
	  AND (${periodo} = 0 or _wichi_mesas_examen.anio_academico = ${periodo})

UNION ALL

  -- Examenes aprobados en otras propuestas del alumno
  SELECT  
	_wichi_mesas_examen.mesa_examen_ubicacion as ubicacion_id,
	cast(_wichi_mesas_examen.anio_academico as integer) as anio_academico,
	sga_periodos_genericos.periodo_generico_tipo as codigo_tipo_periodo,
	pte.nombre as turno_examen_nombre,
	_wichi_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,
	to_char(greatest(_wichi_mesas_examen.mesa_examen_fecha,'19000101'::date), 'DD/MM/YYYY') as fecha_examen,
    _wichi_mesas_examen.llamado_mesa as mesa_id,
	sga_alumnos2.alumno,     
	sga_alumnos2.propuesta, 
	sga_planes_versiones2.plan_version as plan_version, 
	sga_elementos.elemento as actividad, 
	sga_catedras.catedra as catedra,
	sga_eval_detalle_examenes.resultado as resultado,
	sga_eval_detalle_examenes.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	1 as actividad_comun,
	actas_abiertas.tipo_acta as tipo_acta,
	actas_abiertas.nro_acta as nro_acta,
	actas_abiertas.estado as estado_acta,
	sga_eval_detalle_examenes.instancia as condicion_alumno,
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (_wichi_mesas_examen.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera
	intentos.nro_intento as nrointento,       -- Número de vez que intenta rendir examen de la materia
	
	1 as uno, -- Cantidad de registros de exámenes. Es siempre 1
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    0 as modalidad,
 	sga_alumnos.persona,
	'select get_horas_trabajo_araucano('||sga_alumnos.persona||')' as query_horas_trabajadas,
	'select get_estado_civil('||sga_alumnos.persona||')' as query_estado_civil,
	'select get_localidad_per_lec('||sga_alumnos.persona||')' as query_localidad_per_lec,
	'select get_localidad_proc('||sga_alumnos.persona||')' as query_localidad_proc,
	'select get_costeo_estudios('||sga_alumnos.persona||')' as query_costeo_estudios,
	'select get_beca('||sga_alumnos.persona||')' as query_beca,
	'select get_tecno_internet('||sga_alumnos.persona||')' as query_tecno_internet,
	'select get_tecno_pc('||sga_alumnos.persona||')' as query_tecno_pc,
	'select get_idioma('||sga_alumnos.persona||')' as query_idioma,
	0 as discapacidad
	FROM 
         actas_abiertas,
         sga_eval_detalle_examenes LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = sga_eval_detalle_examenes.escala_nota AND  sga_escalas_notas_det.nota = sga_eval_detalle_examenes.nota),
	     sga_planes_versiones,
	     _wichi_mesas_examen
                LEFT JOIN sga_catedras ON sga_catedras.catedra = _wichi_mesas_examen.mesa_examen_catedra,
	     sga_elementos,
	     sga_periodos as pte,
	     sga_alumnos,
	     sga_propuestas,
	     mdp_personas,
	     _wichi_ingreso_alumnos as ingreso,
	     _wichi_intentos_examenes intentos,

	     sga_alumnos as sga_alumnos2,
	     sga_planes_versiones as sga_planes_versiones2,
	     sga_elementos_plan as sga_elementos_plan2,
	     sga_elementos_revision as sga_elementos_revision2,
		 sga_periodos_genericos
	     
	WHERE sga_eval_detalle_examenes.id_acta = actas_abiertas.id_acta
	  AND sga_eval_detalle_examenes.instancia IN (3,4,7) -- Regulares / Libres / Examen Complementario
	  AND _wichi_mesas_examen.llamado_mesa = actas_abiertas.llamado_mesa
	  AND sga_elementos.elemento = _wichi_mesas_examen.mesa_examen_elemento

	  AND pte.periodo = _wichi_mesas_examen.turno_examen_periodo
	  AND pte.periodo_generico = sga_periodos_genericos.periodo_generico
	  AND sga_planes_versiones.plan_version = sga_eval_detalle_examenes.plan_version
	  AND sga_alumnos.alumno = sga_eval_detalle_examenes.alumno
	  AND sga_alumnos.persona = mdp_personas.persona
	  
	  -- Otra propuesta del alumno  
	  AND sga_alumnos2.persona = sga_alumnos.persona
	  AND sga_alumnos2.propuesta &lt;&gt; sga_alumnos.propuesta
	  AND sga_propuestas.propuesta = sga_alumnos2.propuesta
	  AND sga_planes_versiones2.plan_version = sga_alumnos2.plan_version
	  AND ingreso.alumno = sga_alumnos2.alumno
	  AND sga_elementos_revision2.elemento = sga_elementos.elemento
	  AND sga_elementos_plan2.plan_version      = sga_alumnos2.plan_version
	  AND sga_elementos_plan2.elemento_revision = sga_elementos_revision2.elemento_revision
	  
	  AND intentos.alumno = sga_eval_detalle_examenes.alumno
	  AND intentos.elemento = _wichi_mesas_examen.mesa_examen_elemento
	  AND intentos.llamado_mesa = _wichi_mesas_examen.llamado_mesa
	  AND (${periodo} = 0 or _wichi_mesas_examen.anio_academico = ${periodo})</sql>
