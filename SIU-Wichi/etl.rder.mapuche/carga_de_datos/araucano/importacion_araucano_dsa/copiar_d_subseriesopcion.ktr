  <step>
    <name>leer tabla</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>araucano_tmp</connection>
    <sql>SELECT
  DISTINCT a_agregar.idserie as serie,
  coalesce(a_agregar.idsubserie,' ') as subserie,
  coalesce(a_agregar.idsubserieopcion,' ') as subserieopcion,
  s.nombreserie as nombreserie,
  CASE 	WHEN idsubserie = 'NIQE' THEN 'Nuevos Inscriptos por Equivalencia según Edad'
	WHEN idsubserie = 'PMA' THEN 'Reinscriptos por Materias Aprobadas el Año Anterior'
	WHEN idsubserie = 'AYM' THEN 'Reinscriptos por Materias Aprobadas'
	WHEN idsubserie = 'TRA' THEN 'Estudiantes de Grado por Situación Laboral'
	WHEN idsubserie = 'PAI' THEN 'Egresados por Año de Ingreso'
	WHEN idsubserie = 'AE' THEN 'Estudiantes de Grado por Edad?'
	WHEN idsubserie = 'AYE' THEN 'Reinscriptos por Exámenes Rendidos' 
	WHEN idsubserie = 'MAX' THEN 'Estudiantes Extranjeros según Rango de Edad'
	WHEN idsubserie = 'NIPE' THEN 'Nuevos Inscriptos por Primera Vez según Edad'
	WHEN idsubserie = 'INST' THEN 'Nuevos Inscriptos clasificados según Nivel de Instrucción de los Padres'
	WHEN idsubserie = 'EPAI' THEN 'Egresados por Equivalencia y Año de Ingreso'
	WHEN idsubserie = 'PM' THEN s.nombreserie || ' Por Materias Aprobadas'
	WHEN idsubserie = 'PC' THEN s.nombreserie || ' Por Materias Regularizadas'
    WHEN idsubserie = 'AC' THEN s.nombreserie || ' Por Actividades Realizadas'
	WHEN idsubserie = 'PE' THEN 'Egresados por Primera Vez según Rango de Edad'
	WHEN idsubserie = 'QE' THEN 'Egresados por Equivalencia según Rango de Edad'
	ELSE '' END as nombresubserie,
  coalesce(a_agregar.nombreserie,'') as nombresubserieopcion,
  now() as fechaact
FROM araucano_tmp.d_subserie a_agregar, araucano_dsa.academica_d_series s
WHERE a_agregar.idserie = s.serie;
</sql>
