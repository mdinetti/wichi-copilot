  <step>
    <name>base_pilaga</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_pilaga</connection>
    <sql>------------------------------------------------------------------&#xa;--Union liquidaciones por partida , comprobante y periodos&#xa;-------------------------------------------------------------------&#xa;	SELECT 	pa.tramite&#xa;		, pa.paso&#xa;		, pa.paso_anterior&#xa;		, tr.fecha_valor&#x3a;&#x3a;date as fecha_valor&#xa;		, pa.tipo_contenedor, pa.anio_contenedor, pa.nro_contenedor -- Expediente&#xa;		, pa.ejercicio&#x3a;&#x3a;integer AS ejercicio&#xa;		, tr.fecha&#x3a;&#x3a;date AS fecha_movimiento&#xa;		, li.fecha_vencimiento&#x3a;&#x3a;date AS fecha_vencimiento&#xa;		, replace&#x28;replace&#x28;pa.descripcion,E&#x27;&#x5c;r&#x27;, &#x27;&#x27;&#x29;,E&#x27;&#x5c;n&#x27;,&#x27;&#x27;&#x29; as concepto_desc&#xa;		, substring&#x28;dm.partida,1,1&#x29; as tipo_ejercicio --&#x28;A&#x29;actual o &#x28;R&#x29;remanente&#xa;		, substring&#x28;dm.partida, 8,11&#x29;  as codup&#xa;		, substring&#x28;dm.partida, 3,4&#x29;   as codgru&#xa;		, substring&#x28;dm.partida, 20,2&#x29;  as codfuente&#xa;		, substring&#x28;dm.partida, 38,10&#x29; as codinciso&#xa;		, substring&#x28;dm.partida, 51,2&#x29;  as coddec&#xa;		, substring&#x28;dm.partida, 23,14&#x29; as codprog&#xa;		, substring&#x28;dm.partida, 56,1&#x29;  as codfun&#xa;		, substring&#x28;dm.partida, 54,1&#x29;  as codfi&#xa;		, case when dm.etapa_presupuestaria &#x3d; &#x27;DE&#x27; then dm.importe else 0.0 end as devengado&#xa;		, substring&#x28;dm.partida, 49,1&#x29; as moneda &#xa;		, pa.proveedor_o_beneficiario as codpersona&#xa;		, pa.tipo_doc_ppal&#xa;		, pa.nro_doc_ppal&#xa;		, pa.anio_doc_ppal&#xa;		, pa.tipo_operacion&#xa;		, li.estado as estado_liquidacion_codigo&#xa;		, extract&#x28;month from tr.fecha_valor&#x29; as mes&#xa;		, comprob.comprobante as comprobante_codigo&#xa;		, comprob.tipo_de_comprobante as comprobante_tipo_codigo&#xa;		, comprob.numero as numero&#xa;		, comprob.anio as anio&#xa;		, fd.medidor as medidor_codigo, fd.concepto as concepto_codigo, fd.servicio_publico as servicio_publico_codigo&#xa;		, fd.unidad_medida as unidad_medida_codigo&#xa;		, Coalesce&#x28;e1.codigo_completo,coalesce&#x28;e2.codigo_completo,e3.codigo_completo&#x29;&#x29; as unidad_presupuestaria_medidor_codigo &#xa;		, m.cod_edificio as edificio_codigo&#xa;		, pa.importe as devengado_total&#xa;		, dm.importe as devengado_partida&#xa;		, comprob.importe as importe_total_comprobante&#xa;		, CASE WHEN pa.importe &#x3c;&#x3e; 0 THEN &#x28;dm.importe &#x2a; 100&#x29;&#x2f;pa.importe &#xa;			ELSE 0 END as porc_dev_partida&#xa;		, CASE WHEN pa.importe &#x3c;&#x3e; 0 THEN &#x28;comprob.importe &#x2a; &#x28;&#x28;dm.importe &#x2a; 100&#x29;&#x2f;pa.importe&#x29;&#x29;&#x2f;100&#xa;			ELSE 0 END as importe_porc&#xa;		, fd.cantidad_medida as consumo&#xa;		, fd.importe &#xa;		, CASE WHEN pa.importe &#x3c;&#x3e; 0 THEN &#x28;fd.cantidad_medida &#x2a; &#x28;&#x28;dm.importe &#x2a; 100&#x29;&#x2f;pa.importe&#x29;&#x29;&#x2f;100&#xa;			ELSE 0 END as consumo_calculado &#xa;		, CASE WHEN pa.importe &#x3c;&#x3e; 0 THEN &#x28;fd.importe &#x2a; &#x28;&#x28;dm.importe &#x2a; 100&#x29;&#x2f;pa.importe&#x29;&#x29;&#x2f;100&#xa;			ELSE 0 END as importe_calculado&#xa;		, tmp.periodo&#xa;		, tmp.periodo_desde&#xa;		, tmp.periodo_hasta&#xa;		, tmp.dias_totales&#xa;		, tmp.dias_periodo&#xa;		, CASE WHEN pa.importe &#x3c;&#x3e; 0 THEN round&#x28;&#x28;&#x28;&#x28;fd.importe &#x2a; &#x28;&#x28;dm.importe &#x2a; 100&#x29;&#x2f;pa.importe&#x29;&#x29;&#x2f;100&#x29;&#x2a;tmp.dias_periodo&#x29;&#x2f;tmp.dias_totales,2&#x29;&#xa;			ELSE 0 END as importe_final&#xa;		, CASE WHEN pa.importe &#x3c;&#x3e; 0 THEN round&#x28;&#x28;&#x28;&#x28;fd.cantidad_medida &#x2a; &#x28;&#x28;dm.importe &#x2a; 100&#x29;&#x2f;pa.importe&#x29;&#x29;&#x2f;100&#x29;&#x2a;tmp.dias_periodo&#x29;&#x2f;tmp.dias_totales,2&#x29;&#xa;			ELSE 0 END as consumo_final&#xa;	FROM 	sau_gb_tramites as tramite&#xa;		INNER JOIN sau_gb_pasos as pa &#xa;			ON pa.tramite &#x3d; tramite.tramite&#xa;		INNER JOIN sau_gb_transacciones as tr &#xa;			ON tr.paso &#x3d; pa.paso&#xa;		INNER JOIN sau_no_mapeador_transaccional mt &#xa;			ON tr.transaccion &#x3d; mt.numero_en_gestion&#xa;		INNER JOIN sau_np_detalles_movimientos dm &#xa;			ON dm.mov_presupuestario_contable &#x3d; mt.mov_presupuestario_contable&#xa;		INNER JOIN&#x28;&#xa;		SELECT cr.paso, co.comprobante, co.tipo_de_comprobante, co.numero, co.anio, co.persona, co.importe&#xa;			FROM sau_gb_comprobantes_respaldo cr, sau_no_comprobantes co &#xa;				WHERE cr.comprobante &#x3d; co.comprobante AND tipo_de_comprobante IN &#xa;			&#x28;SELECT tipo_de_documentacion FROM sau_no_documentacion_tipos &#xa;				WHERE tipo_documentacion&#x3d;&#x27;C&#x27;&#x29;&#xa;		&#x29; comprob on pa.paso &#x3d; comprob.paso OR pa.paso_anterior &#x3d; comprob.paso &#xa;		LEFT JOIN sau_li_liquidaciones li &#xa;			ON li.nro_operacion_original &#x3d; pa.paso AND li.estado &#x3c;&#x3e; &#x27;U&#x27;&#xa;		LEFT JOIN public.sau_sp_facturas_detalle fd ON fd.comprobante &#x3d; comprob.comprobante&#xa;		LEFT JOIN  public.sau_sp_medidores m ON fd.medidor &#x3d; m.medidor&#xa;		LEFT JOIN public.sau_np_elementos e1 ON m.sub_subunidad &#x3d; e1.elemento&#xa;		LEFT JOIN public.sau_np_elementos e2 ON m.sub_unidad &#x3d; e2.elemento&#xa;		LEFT JOIN public.sau_np_elementos e3 ON m.unidad_principal &#x3d; e3.elemento&#xa;		LEFT JOIN &#x28;SELECT 	fac_periodo.comprobante&#xa;	,extract&#x28;year from fac_periodo.dia&#x29;&#x7c;&#x7c;&#x27;&#x27;&#x7c;&#x7c; lpad&#x28;cast&#x28;extract&#x28;month from fac_periodo.dia&#x29; as varchar&#x28;2&#x29;&#x29;, 2, &#x27;0&#x27;&#x29; AS periodo&#xa;	,fac_periodo.periodo_desde, fac_periodo.periodo_hasta&#xa;	,fac_periodo.periodo_hasta - fac_periodo.periodo_desde &#x2b; 1 AS dias_totales&#xa;	,count&#x28;&#x2a;&#x29; AS dias_periodo&#xa;FROM &#x28;&#xa;SELECT comprobante, &#xa;CASE WHEN extract&#x28;year from periodo_desde&#x29; in &#x28;e.ejercicio&#x3a;&#x3a;integer, e.ejercicio&#x3a;&#x3a;integer -1&#x29;  THEN periodo_desde&#xa;     WHEN extract&#x28;year from periodo_hasta&#x29;  in &#x28;e.ejercicio&#x3a;&#x3a;integer, e.ejercicio&#x3a;&#x3a;integer -1&#x29; THEN periodo_hasta&#xa;ELSE &#x28;&#x27;31-12-&#x27; &#x7c;&#x7c; e.ejercicio&#x29;&#x3a;&#x3a;date&#xa;END AS periodo_desde,&#xa;CASE WHEN extract&#x28;year from periodo_hasta&#x29; in &#x28;e.ejercicio&#x3a;&#x3a;integer, e.ejercicio&#x3a;&#x3a;integer -1&#x29;  THEN periodo_hasta&#xa;ELSE &#x28;&#x27;31-12-&#x27; &#x7c;&#x7c; e.ejercicio&#x29;&#x3a;&#x3a;date&#xa;END AS periodo_hasta,&#xa;generate_series&#x28;CASE WHEN extract&#x28;year from periodo_desde&#x29; in &#x28;e.ejercicio&#x3a;&#x3a;integer, e.ejercicio&#x3a;&#x3a;integer -1&#x29;  THEN periodo_desde&#xa;     WHEN extract&#x28;year from periodo_hasta&#x29;  in &#x28;e.ejercicio&#x3a;&#x3a;integer, e.ejercicio&#x3a;&#x3a;integer -1&#x29; THEN periodo_hasta&#xa;ELSE &#x28;&#x27;31-12-&#x27; &#x7c;&#x7c; e.ejercicio&#x29;&#x3a;&#x3a;date&#xa;END,CASE WHEN extract&#x28;year from periodo_hasta&#x29; in &#x28;e.ejercicio&#x3a;&#x3a;integer, e.ejercicio&#x3a;&#x3a;integer -1&#x29;  THEN periodo_hasta&#xa;ELSE &#x28;&#x27;31-12-&#x27; &#x7c;&#x7c; e.ejercicio&#x29;&#x3a;&#x3a;date&#xa;END,&#x27;1 day&#x27;&#x29; as dia FROM public.sau_sp_facturas f, public.sau_no_ejercicios e&#xa;WHERE e.estado &#x3d; &#x27;A&#x27;&#x29; fac_periodo  &#xa;GROUP BY 1,2,3,4,5&#x29; tmp ON fd.comprobante &#x3d; tmp.comprobante&#xa;	WHERE pa.ejercicio &#x3d; &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29;&#xa;	 AND  dm.etapa_presupuestaria &#x3d;&#x27;DE&#x27; AND tramite.circuito &#x3d; &#x27;SRVP&#x27;&#x3b;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
