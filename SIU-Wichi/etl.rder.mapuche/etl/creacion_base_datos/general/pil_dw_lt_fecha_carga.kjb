      <description/>
      <type>SQL</type>
      <sql>CREATE TABLE dw_lt_fecha&#xa;&#x28;&#xa;  fecha date NOT NULL,&#xa;  ano integer NOT NULL,&#xa;  mes integer NOT NULL,&#xa;  dia integer NOT NULL,&#xa;  diasemana integer NOT NULL,&#xa;  semana_desc character varying NOT NULL,&#xa;  semanaabrev_desc character varying NOT NULL,&#xa;  mes_desc character varying NOT NULL,&#xa;  mesabrev_desc character varying NOT NULL&#xa;&#x29;&#xa;WITH &#x28;&#xa;  OIDS&#x3d;FALSE&#xa;&#x29;&#x3b;&#xa;&#xa;</sql>
