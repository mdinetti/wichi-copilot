    <sql>--Crea el esquema araucano_tmp&#xa;CREATE SCHEMA araucano_tmp&#x3b;&#xa;&#xa;--Tablas del esquema araucano_tmp&#xa;CREATE TABLE araucano_tmp.d_facultad&#xa;&#x28;&#xa;  idfacultad character varying,&#xa;  facultad character varying,&#xa;  provincia character varying,&#xa;  localidad character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.d_mug_paises&#xa;&#x28;&#xa;  idpais character varying,&#xa;  nombre_pais character varying,&#xa;  continente character varying,&#xa;  nombre_continente character varying &#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.d_subserie&#xa;&#x28;&#xa;  idserie character varying,&#xa;  idsubserie character varying,&#xa;  idsubserieopcion character varying,&#xa;  nombreserie character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.d_tipotitulo&#xa;&#x28;&#xa;  idtipotitulo character varying,&#xa;  tipotitulo character varying,&#xa;  nivel character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.d_titulo&#xa;&#x28;&#xa;  idtitulo character varying,&#xa;  titulo character varying,&#xa;  rama character varying,&#xa;  disciplina character varying,&#xa;  area character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.d_actividades&#xa;&#x28;&#xa;  idactividad character varying,&#xa;  nombre_actividad character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.d_procedencias&#xa;&#x28;&#xa;  idProcedencia character varying,&#xa;  Nombre_Procedencia character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.ft_cuadros1y2&#xa;&#x28;&#xa;    idfacultad character varying,&#xa;    idtitulo character varying,&#xa;    anioinformado character varying,&#xa;    idtipotitulo character varying,&#xa;    idfacultadingreso character varying,&#xa;    genero character varying,&#xa;    idserie character varying,&#xa;    cantidadm_c1y2 character varying,&#xa;    cantidadn_c1y2 character varying,&#xa;    cantidads_c1y2 character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.ft_totaldetallea&#xa;&#x28;&#xa;  idfacultad character varying,&#xa;  idtitulo character varying,&#xa;  anioinformado character varying,&#xa;  idtipotitulo character varying,&#xa;  idfacultadingreso character varying,&#xa;  genero character varying,&#xa;  anioingreso character varying,&#xa;  idserie_c3 character varying,&#xa;  idsubserie_c3 character varying,&#xa;  cantidadm_c3 character varying,&#xa;  cantidadn_c3 character varying,&#xa;  cantidads_c3 character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.ft_totaldetalled_aye&#xa;&#x28;&#xa;  idfacultad character varying,&#xa;  idtitulo character varying,&#xa;  anioinformado character varying,&#xa;  idtipotitulo character varying,&#xa;  genero character varying,&#xa;  anioingreso character varying,&#xa;  idserie_c5 character varying,&#xa;  idsubserie_c5 character varying,&#xa;  idsubserieopcion_c5 character varying,&#xa;  cantidadm_c5 character varying,&#xa;  cantidadn_c5 character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.ft_totaldetalled_aym&#xa;&#x28;&#xa;  idfacultad character varying,&#xa;  idtitulo character varying,&#xa;  anioinformado character varying,&#xa;  idtipotitulo character varying,&#xa;  genero character varying,&#xa;  anioingreso character varying,&#xa;  idserie_c4 character varying,&#xa;  idsubserie_c4 character varying,&#xa;  idsubserieopcion_c4 character varying,&#xa;  cantidadm_c4 character varying,&#xa;  cantidadn_c4 character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE araucano_tmp.ft_totaldetalles_ae&#xa;&#x28;&#xa;  idfacultad character varying,&#xa;  idtitulo character varying,&#xa;  anioinformado character varying,&#xa;  idtipotitulo character varying,&#xa;  idfacultadingreso character varying,&#xa;  genero character varying,&#xa;  idserie_edad character varying,&#xa;  idsubserie_edad character varying,&#xa;  idsubserieopcion_edad character varying,&#xa;  cantidadm_c8 character varying,&#xa;  cantidadn_c8 character varying,&#xa;  cantidads_c8 ch