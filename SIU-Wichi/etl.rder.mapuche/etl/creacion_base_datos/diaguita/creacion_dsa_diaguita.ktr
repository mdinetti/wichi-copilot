    <quoteString>N</quoteString>
    <sql>--Crea el esquema diaguita_dsa&#xa;&#xa;&#xa;create schema diaguita_dsa&#x3b;&#xa;&#xa;&#xa;--Crea las tablas de diaguita_dsa&#xa;&#xa;create table diaguita_dsa.d_tipo_documento&#x28;&#xa;  tipo_documento_id serial,  &#xa;  tipo_documento_codigo text,&#xa;  tipo_documento_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_expediente&#x28;&#xa;  expediente_id serial,  &#xa;  expediente_codigo text,&#xa;  expediente_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_numero_anterior&#x28;&#xa;  numero_anterior_id serial,  &#xa;  numero_anterior_codigo text,&#xa;  numero_anterior_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_estado_bien&#x28;&#xa;   estado_bien_id serial&#xa;  ,estado_bien_codigo text&#xa;  ,estado_bien_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_ubicacion_fisica&#x28;&#xa;   ubicacion_fisica_id serial&#xa;  ,ubicacion_fisica_codigo text&#xa;  ,ubicacion_fisica_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_catalogo_bien&#x28;&#xa;   catalogo_bien_id serial&#xa;  ,catalogo_bien_nivel1_codigo integer&#xa;  ,catalogo_bien_nivel1_desc text&#xa;  ,catalogo_bien_nivel2_codigo integer&#xa;  ,catalogo_bien_nivel2_desc text&#xa;  ,catalogo_bien_nivel3_codigo integer&#xa;  ,catalogo_bien_nivel3_desc text&#xa;  ,catalogo_bien_nivel4_codigo integer&#xa;  ,catalogo_bien_nivel4_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_catalogo_bien_servicio&#x28;&#xa;   catalogo_bien_id serial&#xa;  ,catalogo_bien_nivel1_codigo integer&#xa;  ,catalogo_bien_nivel1_desc text&#xa;  ,catalogo_bien_nivel2_codigo integer&#xa;  ,catalogo_bien_nivel2_desc text&#xa;  ,catalogo_bien_nivel3_codigo integer&#xa;  ,catalogo_bien_nivel3_desc text&#xa;  ,catalogo_bien_nivel4_codigo integer&#xa;  ,catalogo_bien_nivel4_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_bien_patrimonial&#x28;&#xa;   bien_patrimonial_id serial&#xa;  ,bien_patrimonial_codigo text&#xa;  ,bien_patrimonial_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_numero_patrimonial&#x28;&#xa;   numero_patrimonial_id serial&#xa;  ,numero_patrimonial_codigo text&#xa;  ,numero_patrimonial_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_motivo_alta_bien&#x28;&#xa;   motivo_alta_id serial&#xa;  ,motivo_alta_codigo text&#xa;  ,motivo_alta_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_motivo_baja_bien&#x28;&#xa;   motivo_baja_id serial&#xa;  ,motivo_baja_codigo text&#xa;  ,motivo_baja_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_area&#x28;&#xa;   area_id serial&#xa;  ,area_nivel1_codigo text&#xa;  ,area_nivel2_codigo text&#xa;  ,area_nivel1_desc text&#xa;  ,area_nivel2_desc text&#xa;  ,oficina_patrimonio_codigo text&#xa;  ,instalacion_id integer&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_vida_util&#x28;&#xa;   vida_util_id serial&#xa;  ,vida_util_codigo text&#xa;  ,vida_util_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_tipo_bien&#x28;&#xa;   tipo_bien_id serial&#xa;  ,tipo_bien_codigo text&#xa;  ,tipo_bien_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_alta_baja&#x28;&#xa;   alta_baja_id serial&#xa;  ,alta_baja_codigo text&#xa;  ,alta_baja_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_oficina_patrimonio&#x28;&#xa;   oficina_patrimonio_id serial&#xa;  ,oficina_patrimonio_codigo text&#xa;  ,oficina_patrimonio_desc text&#xa;  ,fecha_desde date&#xa;  ,fecha_hasta date&#xa;  ,version integer&#xa;  ,vigente character varying&#xa;  ,fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.d_persona&#xa;&#x28;&#xa;  persona_id serial,&#xa;  persona_codigo integer,&#xa;  persona_tipo_documento character varying,&#xa;  persona_nro_documento character varying,&#xa;  fisica_o_juridica character varying,&#xa;  razon_social_apyno character varying,&#xa;  nombre_fantasia character varying,&#xa;  genero_id character varying,&#xa;  nacionalidad character varying,&#xa;  email character varying,&#xa;  cbu character varying,&#xa;  persona_detalle character varying,&#xa;  estado character varying,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  version integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE diaguita_dsa.d_responsable&#xa;&#x28;&#xa;  responsable_id serial NOT NULL,&#xa;  responsable_codigo text,&#xa;  responsable_desc text,&#xa;  cuil text,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  version integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.ft_patrimonio&#x28;&#xa;   tipo_documento_id integer&#xa;  ,expediente_id integer&#xa;  ,numero_anterior_id integer&#xa;  ,bien_patrimonial_id integer&#xa;  ,numero_patrimonial_id integer&#xa;  ,motivo_baja_id smallint&#xa;  ,numero_alta_id integer&#xa;  ,fecha_alta_id date&#xa;  ,motivo_alta_id smallint&#xa;  ,estado_bien_id smallint&#xa;  ,catalogo_bien_id integer&#xa;  ,area_responsable_id integer&#xa;  ,ubicacion_fisica_id integer&#xa;  ,fecha_incorporacion_id date&#xa;  ,fecha_baja_id date&#xa;  ,alta_baja_id smallint&#xa;  ,vida_util smallint&#xa;  ,tipo_bien_id smallint&#xa;  ,oficina_patrimonio_id smallint&#xa;  ,persona_id integer&#xa;  ,expediente_baja_id integer&#xa;  ,responsable_uso_id integer&#xa;  ,valor_bien numeric&#x28;15,2&#x29;&#xa;  ,valor_residual numeric&#x28;15,2&#x29;&#xa;  ,amortizacion_acumulada numeric&#x28;15,2&#x29;&#xa;  ,cant_bienes integer&#xa;&#x29;&#x3b;&#xa;&#xa;create table diaguita_dsa.w_area&#x28;&#xa;   codigo text&#xa;  ,codigo_padre text&#xa;  ,codigo_asignado text&#xa;  ,nombre text&#xa;  ,id_oficina_patrimonio text&#xa;  ,codigos_ya_asignados text&#xa;&#x29;&#x3b;&#xa;COMMENT ON COLUMN diaguita_dsa.w_area.codigos_ya_asignados IS &#x27;Contiene la lista de codigos para verificar que si aparece uno repetido corte el ciclo infinito.&#x27;&#x3b;&#xa;CREATE TABLE diaguita_dsa.w_areas_referenciadas&#xa;&#x28;&#xa;  codigo text,&#xa;  CONSTRAINT w_areas_referenciadas_pkey PRIMARY KEY &#x28;codigo&#x29;&#xa;&#x29;&#xa;WITH &#x28;&#xa;  OIDS&#x3d;FALSE&#xa;&#x29;&#x3b;&#xa;&#xa;--Crea las funciones de diaguita_dsa&#xa;CREATE OR REPLACE FUNCTION diaguita_dsa.podar_area&#x28;&#x29;&#xa;  RETURNS text AS&#xa;&#x24;BODY&#x24;&#xa;  declare&#xa;    n integer&#x3b;&#xa;    m integer&#x3b;&#xa;    id text&#x3b;&#xa;    noUsados integer &#x3a;&#x3d; 0&#x3b;&#xa;    noUsados1 integer&#x3b;&#xa;    unicosEnNivel integer &#x3a;&#x3d; 0&#x3b;&#xa;    ascensos integer &#x3a;&#x3d; 0&#x3b;&#xa;  begin&#xa;    -- Se crea un tabla con todas las referencias a areas de las distintas tablas de hechos&#xa;    TRUNCATE diaguita_dsa.w_areas_referenciadas&#x3b;&#xa;    INSERT INTO diaguita_dsa.w_areas_referenciadas &#x28;codigo&#x29;&#xa;    SELECT DISTINCT id_area_responsable FROM diaguita_tmp.ft_patrimonio&#xa;    WHERE id_area_responsable IS NOT NULL AND id_area_responsable NOT IN &#x28;SELECT codigo FROM diaguita_dsa.w_areas_referenciadas&#x29;&#x3b;&#xa;    INSERT INTO diaguita_dsa.w_areas_referenciadas &#x28;codigo&#x29;&#xa;    SELECT DISTINCT id_area_solicitud FROM diaguita_tmp.ft_compras&#xa;    WHERE id_area_solicitud IS NOT NULL AND id_area_solicitud NOT IN &#x28;SELECT codigo FROM diaguita_dsa.w_areas_referenciadas&#x29;&#x3b;&#xa;    INSERT INTO diaguita_dsa.w_areas_referenciadas &#x28;codigo&#x29;&#xa;    SELECT DISTINCT id_area_item_solicitado FROM diaguita_tmp.ft_compras&#xa;    WHERE id_area_item_solicitado IS NOT NULL AND id_area_item_solicitado NOT IN &#x28;SELECT codigo FROM diaguita_dsa.w_areas_referenciadas&#x29;&#x3b;&#xa;    INSERT INTO diaguita_dsa.w_areas_referenciadas &#x28;codigo&#x29;&#xa;    SELECT DISTINCT id_area_oc FROM diaguita_tmp.ft_compras&#xa;    WHERE id_area_oc IS NOT NULL AND id_area_oc NOT IN &#x28;SELECT codigo FROM diaguita_dsa.w_areas_referenciadas&#x29;&#x3b;&#xa;    INSERT INTO diaguita_dsa.w_areas_referenciadas &#x28;codigo&#x29;&#xa;    SELECT DISTINCT id_area_re FROM diaguita_tmp.ft_compras&#xa;    WHERE id_area_re IS NOT NULL AND id_area_re NOT IN &#x28;SELECT codigo FROM diaguita_dsa.w_areas_referenciadas&#x29;&#x3b;&#xa;&#xa;    truncate table diaguita_dsa.w_area&#x3b;&#xa;    insert into diaguita_dsa.w_area&#xa;      &#x28;codigo, codigo_padre, codigo_asignado, nombre, id_oficina_patrimonio, codigos_ya_asignados&#x29;&#xa;      select id_area, id_area_padre, id_area, nombre, id_oficina_patrimonio, &#x27;&#x2a;&#x27; &#x7c;&#x7c; trim&#x28;id_area&#x29; &#x7c;&#x7c; &#x27;&#x2a;&#x27;&#xa;        from diaguita_tmp.d_area&#x3b;&#xa;    loop&#xa;      select count&#x28;&#x2a;&#x29; into noUsados1&#xa;        from diaguita_dsa.w_area a&#xa;        where not exists &#x28;&#xa;          select ah.codigo&#xa;            from diaguita_dsa.w_area ah&#xa;            where ah.codigo_padre &#x3d; a.codigo&#xa;        &#x29; and not exists &#x28;&#xa;          select f.codigo&#xa;            from diaguita_dsa.w_areas_referenciadas f&#xa;            where f.codigo &#x3d; a.codigo&#xa;        &#x29;&#x3b;&#xa;      if noUsados1 &#x3d; 0 then&#xa;        exit&#x3b;&#xa;      end if&#x3b;&#xa;      delete from diaguita_dsa.w_area a&#xa;        where not exists &#x28;&#xa;          select ah.codigo&#xa;            from diaguita_dsa.w_area ah&#xa;            where ah.codigo_padre &#x3d; a.codigo&#xa;        &#x29; and not exists &#x28;&#xa;          select f.codigo&#xa;            from diaguita_dsa.w_areas_referenciadas f&#xa;            where f.codigo &#x3d; a.codigo&#xa;        &#x29;&#x3b;&#xa;      noUsados &#x3a;&#x3d; noUsados &#x2b; noUsados1&#x3b;&#xa;    end loop&#x3b;&#xa;    loop&#xa;      select count&#x28;&#x2a;&#x29; into n&#xa;        from diaguita_dsa.w_area&#xa;        where codigo_padre is null&#x3b;&#xa;      if n &#x3d; 0 then&#xa;        raise &#x27;Error en la estructura de &#xe1;reas&#x27;&#x3b;&#xa;        return &#x27;ERROR&#x27;&#x3b;&#xa;      elsif n &#x3e; 1 then&#xa;        exit&#x3b;&#xa;      end if&#x3b;&#xa;      select codigo into id&#xa;        from diaguita_dsa.w_area&#xa;        where codigo_padre is null&#x3b;&#xa;      update diaguita_dsa.w_area&#xa;        set codigo_padre &#x3d; null&#xa;        where codigo_padre &#x3d; id&#x3b;&#xa;      delete from diaguita_dsa.w_area&#xa;        where codigo &#x3d; id&#x3b;&#xa;      unicosEnNivel &#x3a;&#x3d; unicosEnNivel &#x2b; 1&#x3b;&#xa;    end loop&#x3b;&#xa;    loop&#xa;      select count&#x28;&#x2a;&#x29; into m&#xa;        from diaguita_dsa.w_area ah&#xa;        left join diaguita_dsa.w_area aa on aa.codigo &#x3d; ah.codigo_asignado&#xa;        left join diaguita_dsa.w_area ap on ap.codigo &#x3d; aa.codigo_padre&#xa;        where ah.codigo_padre is not null&#xa;          and aa.codigo_padre is not null&#xa;          and ap.codigo_padre is not null&#xa;          and strpos&#x28;ah.codigos_ya_asignados, &#x27;&#x2a;&#x27; &#x7c;&#x7c; trim&#x28;aa.codigo_padre&#x29; &#x7c;&#x7c; &#x27;&#x2a;&#x27;&#x29;&#x3d;0&#x3b;&#xa;      if m &#x3d; 0 then&#xa;        exit&#x3b;&#xa;      end if&#x3b;&#xa;      update diaguita_dsa.w_area ah&#xa;        set codigo_asignado &#x3d; aa.codigo_padre,&#xa;        codigos_ya_asignados &#x3d; ah.codigos_ya_asignados &#x7c;&#x7c; trim&#x28;aa.codigo_padre&#x29; &#x7c;&#x7c; &#x27;&#x2a;&#x27;&#xa;        from diaguita_dsa.w_area aa&#xa;        left join diaguita_dsa.w_area ap on ap.codigo &#x3d; aa.codigo_padre&#xa;        where ah.codigo_padre is not null&#xa;          and aa.codigo_padre is not null&#xa;          and ap.codigo_padre is not null&#xa;          and aa.codigo &#x3d; ah.codigo_asignado&#xa;          and strpos&#x28;ah.codigos_ya_asignados, &#x27;&#x2a;&#x27; &#x7c;&#x7c; trim&#x28;aa.codigo_padre&#x29; &#x7c;&#x7c; &#x27;&#x2a;&#x27;&#x29;&#x3d;0&#x3b;&#xa;      ascensos &#x3a;&#x3d; ascensos &#x2b; 1&#x3b;&#xa;    end loop&#x3b;&#xa;    select count&#x28;&#x2a;&#x29; into m&#xa;      from diaguita_dsa.w_area&#xa;      where codigo_padre is not null and codigo_padre&#x21;&#x3d;codigo_asignado&#x3b;&#xa;    return noUsados &#x7c;&#x7c; &#x27;&#x7c;&#x27; &#x7c;&#x7c; unicosEnNivel &#x7c;&#x7c; &#x27;&#x7c;&#x27; &#x7c;&#x7c; n &#x7c;&#x7c; &#x27;&#x7c;&#x27; &#x7c;&#x7c; ascensos &#x7c;&#x7c; &#x27;&#x7c;&#x27; &#x7c;&#x7c; m&#x3b;&#xa;  end&#x3b;&#xa;&#x24;BODY&#x24;&#xa;  LANGUAGE plpgsql VOLATILE&#xa;  COST 100&#x3b;&#xa;CREATE TABLE diaguita_dsa.d_lugar_entrega&#xa;&#x28;&#xa;  id_lugar_entrega integer not null,&#xa;  nombre_lugar_entrega character varying,&#xa;  domicilio_lugar_entrega character varying,&#xa;  localidad_lugar_entrega character varying,&#xa;  codigo_postal_lugar_entrega character varying,&#xa;  CONSTRAINT d_lugar_entrega_pkey PRIMARY KEY &#x28;id_lugar_entrega&#x29;&#xa;&#x29;&#x3b;&#xa;CREATE TABLE diaguita_dsa.d_oficina_contrataciones&#xa;&#x28;&#xa;  id_oficina integer not null,&#xa;  nombre character varying,&#xa;  CONSTRAINT d_oficina_contratacion_pkey PRIMARY KEY &#x28;id_oficina&#x29;&#xa;&#x29;&#x3b;&#xa;CREATE TABLE diaguita_dsa.d_proveedor&#xa;&#x28;&#xa;  id_proveedor integer not null,&#xa;  razon_social character varying,&#xa;  nombre_fantasia character varying,&#xa;  email character varying,&#xa;  cbu character varying,&#xa;  cuit character varying,&#xa;  descripcion_domicilio character varying,&#xa;  nombre_localidad character varying,&#xa;  CONSTRAINT d_proveedor_pkey PRIMARY KEY &#x28;id_proveedor&#x29;&#xa;&#x29;&#x3b;&#xa;CREATE TABLE diaguita_dsa.d_procedimiento_modalidades&#xa;&#x28;&#xa;  id_procedimiento_modalidad integer not null,&#xa;  nombre character varying,&#xa;  CONSTRAINT d_procedimiento_modalidad_pkey PRIMARY KEY &#x28;id_procedimiento_modalidad&#x29;&#xa;&#x29;&#x3b;&#xa;CREATE TABLE diaguita_dsa.d_procedimiento_clases&#xa;&#x28;&#xa;  id_procedimiento_clase integer not null,&#xa;  nombre character varying,&#xa;  CONSTRAINT d_procedimiento_clase_pkey PRIMARY KEY &#x28;id_procedimiento_clase&#x29;&#xa;&#x29;&#x3b;&#xa;CREATE TABLE diaguita_dsa.d_rubro&#xa;&#x28;&#xa;  id_rubro integer NOT NULL,&#xa;  rubro_desc character varying,&#xa;  CONSTRAINT d_rubro_pkey PRIMARY KEY &#x28;id_rubro&#x29;&#xa;&#x29;&#x3b;&#xa;CREATE TABLE diaguita_dsa.d_moneda&#xa;&#x28;&#xa;  id_moneda integer NOT NULL,&#xa;  moneda_desc character varying,&#xa;  CONSTRAINT d_moneda_pkey PRIMARY KEY &#x28;id_moneda&#x29;&#xa;&#x29;&#x3b;&#xa;CREATE TABLE diaguita_dsa.d_usuario&#xa;&#x28;&#xa;  id_usuario integer NOT NULL,&#xa;  apyno character varying,&#xa;  CONSTRAINT d_usuario_pkey PRIMARY KEY &#x28;id_usuario&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE diaguita_dsa.ft_compras&#xa;&#x28;&#xa;  id_compras serial not null,&#xa;  etapa character varying,&#xa;  identificador_solicitud character varying,&#xa;  fecha_creacion_solicitud date,&#xa;  descripcion_solicitud character varying,&#xa;  prioridad_solicitud character varying,&#xa;  estado_solicitud character varying,&#xa;  referente_solicitud character varying,&#xa;  id_lugar_entrega_solicitud integer,&#xa;  id_oficina_central_contratacion_solicitud integer,&#xa;  id_area_solicitud integer,&#xa;  descripcion_item_solicitado character varying,&#xa;  id_rubro_solicitud integer,&#xa;  cantidad_item_solicitado double precision DEFAULT 0,&#xa;  unidad_medida_item_solicitado character varying,&#xa;  precio_estimado_item_solicitado double precision DEFAULT 0,&#xa;  id_area_item_solicitado integer,&#xa;  numero_mcc character varying,&#xa;  descripcion_mcc character varying,&#xa;  identificador_convocatoria character varying,&#xa;  fecha_creacion_convocatoria date,&#xa;  descripcion_convocatoria character varying,&#xa;  estado_convocatoria character varying,&#xa;  prioridad_convocatoria character varying,&#xa;  id_convocatoria integer,&#xa;  expediente_ejercicio_conv integer,&#xa;  expediente_convocatoria character varying,&#xa;  tipo_procedimiento_convocatoria character varying,&#xa;  id_oficina_convocatoria integer,&#xa;  id_procedimiento_modalidad integer,&#xa;  id_procedimiento_clase integer,&#xa;  usuario_autorizante_conv integer,&#xa;  fecha_autorizacion_conv date,&#xa;  id_renglon integer,&#xa;  descripcion_renglon character varying,&#xa;  numero_renglon character varying,&#xa;  precio_estimado_renglon double precision DEFAULT 0,&#xa;  catalogo_bien_servicio_renglon integer,&#xa;  id_rubro_convocatoria integer,&#xa;  id_renglon_area integer,&#xa;  cantidad_renglon double precision DEFAULT 0,&#xa;  id_item_area integer,&#xa;  id_convocatoria_aa integer,&#xa;  id_acto_apertura integer,&#xa;  inicio_acto_apertura timestamp without time zone,&#xa;  fecha_acto_apertura date,&#xa;  fin_acto_apertura timestamp without time zone,&#xa;  oficina_acto_apertura character varying,&#xa;  lugar_acto_apertura character varying,&#xa;  identificador_acto_apertura character varying,&#xa;  estado_acto_apertura character varying,&#xa;  id_acto_apertura_de integer,&#xa;  fecha_creacion_dictamen date,&#xa;  fecha_generacion_dictamen date,&#xa;  identificador_dictamen character varying,&#xa;  estado_dictamen character varying,&#xa;  -- Adjudicacion&#xa;  id_renglon_ad integer,&#xa;  estado_adjudicacion character varying,&#xa;  identificador_adjudicacion character varying,&#xa;  id_proveedor integer,&#xa;  cantidad_ad double precision DEFAULT 0,&#xa;  monto_unitario double precision DEFAULT 0,&#xa;  id_adjudicacion integer, -- Clave para Orden de Compra&#xa;  -- Orden de Compra&#xa;  id_renglon_area_oc integer,&#xa;  id_detalle_orden_compra_oc integer,&#xa;  id_proveedor_oc integer,&#xa;  id_area_oc integer,&#xa;  estado_orden_compra character varying,&#xa;  identificador_orden_compra character varying,&#xa;  fecha_emision_oc date,&#xa;  id_lugar_entrega_oc integer,&#xa;  fecha_vencimiento_oc date,&#xa;  cantidad_oc double precision DEFAULT 0,&#xa;  monto_unitario_oc double precision DEFAULT 0,&#xa;  id_adjudicacion_oc integer, -- Clave para Adjudicacion&#xa;  id_moneda_oc integer,&#xa;  -- Recepciones&#xa;  id_detalle_orden_compra_re integer,&#xa;  fecha_recepcion date,&#xa;  estado_recepcion character varying,&#xa;  remito character varying,&#xa;  factura_numero character varying,&#xa;  identificador_acta_provisoria_recepcion character varying,&#xa;  fecha_acta_provisoria_re date,&#xa;  id_area_re integer,&#xa;  identificador_acta_definitiva_recepcion character varying,&#xa;  fecha_acta_definitiva_re date,&#xa;  cantidad_recibida double precision DEFAULT 0,&#xa;  cantidad_aceptada double precision DEFAULT 0,&#xa;  cantidad_rechazada double precision DEFAULT 0,&#xa;  importe_total_solicitud double precision DEFAULT 0,&#xa;  importe_total_convocatoria double precision DEFAULT 0,&#xa;  importe_total_adjudicado double precision DEFAULT 0,&#xa;  importe_total_oc double precision DEFAULT 0,&#xa;  CONSTRAINT ft_compras_pkey PRIMARY KEY &#x28;id_compras&#x29;&#xa;&#x29;&#x3b;&#xa;</sql>
