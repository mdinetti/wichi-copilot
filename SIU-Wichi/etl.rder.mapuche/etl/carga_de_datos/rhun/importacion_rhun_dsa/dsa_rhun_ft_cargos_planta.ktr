  <step>
    <name>tmp -&#x3e; ft_cargos_planta</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT&#xa;  to_number&#x28;to_char&#x28;periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29;,&#x27;999999&#x27;&#x29; as periodo_id&#xa;, to_number&#x28;numero_cargo,&#x27;999999999&#x27;&#x29; as numero_cargo&#xa;, cuil_cuit as persona_codigo&#xa;, escalafon_id as escalafon_codigo&#xa;, cod_cargo_universidad as cargo_codigo&#xa;, equivalencia_cargo_id as equivalencia_cargo_codigo&#xa;, unidad_academica_id as unidad_academica_codigo&#xa;, ona_rama_id as ona_rama_codigo&#xa;, ona_disciplina_id as ona_disciplina_codigo&#xa;, ona_area_id as ona_area_codigo&#xa;, agrupamiento_nd_id as agrupamiento_no_docente_codigo&#xa;, nivel_ensenianza_id as nivel_ensenianza_codigo&#xa;, to_number&#x28;grado ,&#x27;9&#x27;&#x29; as grado&#xa;, CASE WHEN cast&#x28;meses_antiguedad as integer&#x29; &#x3e; 731 THEN &#x27;731&#x27; ELSE meses_antiguedad END as rango_antiguedad_codigo --Si supera los 731 meses se pone directamente meses&#x3d;731 &#x28;m&#xe1;s de 60 a&#xf1;os&#x29;, horas_dedicacion as horas_dedicacion_id&#xa;, cast&#x28;horas_dedicacion as integer&#x29;as horas_dedicacion_id&#xa;, cast&#x28;dedicacion_docente as numeric&#x28;5,2&#x29;&#x29; as porcentaje_dedicacion_id&#xa;, cast&#x28;dedicacion_investigacion as numeric&#x28;5,2&#x29;&#x29;as porcentaje_investigacion_id&#xa;, cast&#x28;dedicacion_extension as numeric&#x28;5,2&#x29;&#x29;as porcentaje_extension_id&#xa;, cast&#x28;dedicacion_gestion as numeric&#x28;5,2&#x29;&#x29;as porcentaje_gestion_id&#xa;, tipo_cargo_asociado_id as tipo_cargo_asociado_codigo&#xa;, escalafon_relacionado_id as escalafon_relacionado_codigo&#xa;, cargo_univ_relacionado_id as cargo_univ_relacionado_codigo&#xa;, nro_cargo_pers as numero_cargo_codigo&#xa;, cast&#x28;cant_cargos as integer&#x29; as cargos&#xa;, cast&#x28;sueldo_bruto as numeric&#x28;13,2&#x29;&#x29;as sueldo_bruto&#xa;, horas_dedicacion as hora_dedicacion_codigo&#xa;, &#x28;&#xa;  select coalesce&#x28;&#xa;  &#x28;&#xa;	select equivalencia_cargo_id&#xa;	from rhun_tmp.lt_equivalencias_cargos&#xa;	where&#xa;  	equivalencia_cargo_id &#x3d;&#xa;  	&#x28;&#xa;    	select equivalencia_cargo_categ_univ&#xa;    	from rhun_tmp.lt_categorias_univ&#xa;    	where&#xa;      	to_char&#x28;periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29;&#x3d;to_char&#x28;c.periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29; and&#xa;      	escalafon_categ_univ &#x3d; c.escalafon_relacionado_id and&#xa;      	cod_cargo_universidad &#x3d; c.cargo_univ_relacionado_id&#xa;  	&#x29; and&#xa;  	escalafon_id &#x3d; c.escalafon_relacionado_id&#xa;  &#x29;,&#xa;  &#x27;VACIO&#x2f;NULO&#x27;&#xa;  &#x29;&#xa;&#x29; as equivalencia_cargo_relacionado_codigo&#xa;FROM rhun_tmp.ft_cargos_planta c</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
