    <entry>
      <name>d_series2</name>
      <description/>
      <type>SQL</type>
      <sql>insert into araucano_dsa.academica_d_series&#x28;serie, nombreserie, fechaact&#x29;&#xa;  SELECT DISTINCT idserie, &#x27;&#x27;, now&#x28;&#x29;&#xa;  FROM araucano_tmp.d_subserie a_agregar&#xa;  WHERE NOT EXISTS &#x28;SELECT 1 FROM araucano_dsa.academica_d_series WHERE a_agregar.idserie &#x3d; serie&#x29;&#x3b;&#xa;&#xa;UPDATE araucano_dsa.academica_d_series SET nombreserie &#x3d; &#x27;Alumnos&#x27; WHERE serie &#x3d; &#x27;MA&#x27;&#x3b;&#xa;UPDATE araucano_dsa.academica_d_series SET nombreserie &#x3d; &#x27;Reinscriptos&#x27; WHERE serie &#x3d; &#x27;R&#x27;&#x3b;&#xa;UPDATE araucano_dsa.academica_d_series SET nombreserie &#x3d; &#x27;Nuevos Inscriptos por Equivalencia&#x27; WHERE serie &#x3d; &#x27;NIQ&#x27;&#x3b;&#xa;UPDATE araucano_dsa.academica_d_series SET nombreserie &#x3d; &#x27;Nuevos Inscriptos por Primera vez&#x27; WHERE serie &#x3d; &#x27;NIP&#x27;&#x3b;&#xa;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>araucano_dsa</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>736</xloc>
      <yloc>240</yloc>
      </entry>
    <entry>
      <name>d_titulo2</name>
      <description/>
      <type>SQL</type>
      <sql>UPDATE araucano_dsa.academica_d_titulos SET idrda &#x3d;&#xa;&#x28;&#xa;  SELECT idrda&#xa;  FROM araucano_dsa.academica_d_rda&#xa;  WHERE rda &#x3d; rama &#x7c;&#x7c; &#x27; &#x3d;&#x3d;&#x3e; &#x27; &#x7c;&#x7c; disciplina &#x7c;&#x7c; &#x27; --&#x3e; &#x27; &#x7c;&#x7c; area&#xa;&#x29;&#x3b;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>araucano_dsa</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
