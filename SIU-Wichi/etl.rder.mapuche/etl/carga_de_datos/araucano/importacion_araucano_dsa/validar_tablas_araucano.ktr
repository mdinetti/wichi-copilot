<transformation>
  <info>
    <name>validar_tablas_araucano</name>
    <description>Valida los datos leidos de los txt</description>
    <extended_description>Realiza el control de NULL, claves duplicadas y claves for&#xe1;neas.</extended_description>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <trans_status>0</trans_status>
    <directory>&#x2f;</directory>
    <parameters>
        <parameter>
            <name>dsa_clave</name>
            <default_value>postgres</default_value>
            <description>clave del usuario de postgres</description>
        </parameter>
        <parameter>
            <name>dsa_nombrebase</name>
            <default_value>siu_dsa</default_value>
            <description>nombre de la base de datos</description>
        </parameter>
        <parameter>
            <name>dsa_nombrehost</name>
            <default_value>localhost</default_value>
            <description>nombre o ip del host</description>
        </parameter>
        <parameter>
            <name>dsa_puerto</name>
            <default_value>5432</default_value>
            <description>puerto al que se conecta a la base de datos</description>
        </parameter>
        <parameter>
            <name>dsa_usuario</name>
            <default_value>postgres</default_value>
            <description>usuario de postgres</description>
        </parameter>
    </parameters>
