<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>principal_carga_diaguita</name>
    <description>Carga de datos provenientes de SIU-Diaguita</description>
    <extended_description>Carga de datos provenientes de SIU-Diaguita.&#xa;A fin de posibilitar la carga de datos en instalaciones donde no exista conectividad entre el la base de datos Wichi y el sistema fuente, el proceso de carga est&#xe1; separado en extracci&#xf3;n e importaci&#xf3;n.&#xa;</extended_description>
    <job_version/>
    <job_status>1</job_status>
  <directory>&#x2f;</directory>
  <created_user>-</created_user>
  <created_date>2013&#x2f;01&#x2f;24 12&#x3a;23&#x3a;51.985</created_date>
  <modified_user>-</modified_user>
  <modified_date>2013&#x2f;01&#x2f;24 12&#x3a;23&#x3a;51.985</modified_date>
    <parameters>
        <parameter>
            <name>base_wichi_clave</name>
            <default_value>__SIN_VALOR___x1tljQ7imSqp_fBnDme5M2WZBADj0iuK</default_value>
            <description>clave del usuario de la base siu_wichi</description>
        </parameter>
        <parameter>
            <name>base_wichi_host</name>
            <default_value>localhost</default_value>
            <description>IP o nombre del host donde se encuentra la base siu_wichi</description>
        </parameter>
        <parameter>
            <name>base_wichi_nombre</name>
            <default_value>siu_wichi</default_value>
            <description>nombre de la base de datos de wichi</description>
        </parameter>
        <parameter>
            <name>base_wichi_puerto</name>
            <default_value>5432</default_value>
            <description>puerto al en el que escucha el servidor de postgres de wichi</description>
        </parameter>
        <parameter>
            <name>base_wichi_usuario</name>
            <default_value>postgres</default_value>
            <description>usuario que tiene acceso al servidor de postgres de wichi</description>
        </parameter>
        <parameter>
            <name>carga_actualizacion</name>
            <default_value>auto</default_value>
            <description>0&#x2f;1&#x2f;auto . Si es &#x22;auto&#x22; carga o actualiza los datos seg&#xfa;n corresponda. Los valores 0 y 1 permiten restringir la acci&#xf3;n&#x3a; Si es 0 y en wichi existen datos para el periodo, detiene la ejecucion. Si es 1 y en wichi no existen datos para el periodo, detiene la ejecuci&#xf3;n.</description>
        </parameter>
        <parameter>
            <name>carga_comentario</name>
            <default_value/>
            <description>&#x28;Opcional&#x29; </description>
        </parameter>
        <parameter>
            <name>carga_directorioTemporal</name>
            <default_value>&#x2f;home&#x2f;wichi&#x2f;diaguita</default_value>
            <description>directorio temporal vac&#xed;o para armado del paquete</description>
        </parameter>
        <parameter>
            <name>carga_instalacion</name>
            <default_value/>
            <description>N&#xfa;mero de instalaci&#xf3;n en formato id-codigo &#x28;ej&#x3a; 2-362&#x29;</description>
        </parameter>
        <parameter>
            <name>carga_periodo</name>
            <default_value>0</default_value>
            <description>A&#xf1;o al que corresponden los datos importados ej&#x3a;2012</description>
        </parameter>
        <parameter>
            <name>paquete_directorio</name>
            <default_value>-</default_value>
            <description>&#x28;Opcional&#x29; si se especifica, al terminar deja una copia del paquete de datos wichi. Debe ser distinto de &#x22;-&#x22;</description>
        </parameter>
        <parameter>
            <name>paquete_encriptacion</name>
            <default_value>ninguna</default_value>
            <description>tipo de encriptaci&#xf3;n&#x3a; publica&#x7c;ninguna</description>
        </parameter>
        <parameter>
            <name>paquete_passPgp</name>
            <default_value/>
            <description>&#x28;Opcional&#x29; &#x28;Solo si se usa encriptaci&#xf3;n&#x29; </description>
        </parameter>
        <parameter>
            <name>paquete_rutaGpg</name>
            <default_value>&#x2f;usr&#x2f;bin&#x2f;gpg</default_value>
            <description>&#x28;Solo si se usa encriptaci&#xf3;n&#x29; ruta al ejecutable de gpg</description>
        </parameter>
        <parameter>
            <name>paquete_userIdServidorCentral</name>
            <default_value/>
            <description>&#x28;Solo si se usa encriptaci&#xf3;n&#x29; user ID de gpg del servidor central Wichi</description>
        </parameter>
        <parameter>
            <name>paquete_wildcardPgp</name>
            <default_value/>
            <description>&#x28;Solo si se usa encriptaci&#xf3;n&#x29; Generalmente se puede dejar vac&#xed;o</description>
        </parameter>
        <parameter>
            <name>performance_commit_size</name>
            <default_value>10000</default_value>
            <description>cada cuantos insert se hace commit</description>
        </parameter>
    </parameters>
    <slaveservers>
    </slaveservers>
