  <step>
    <name>cursado</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_guarani</connection>
    <sql>-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;-- Generaci&#xf3;n del archivo LT_Cursadas.txt&#xa;-- Cuenta los siguiente&#x3a;&#xa;--  &#x2a; Promocionados en actas de promocion cerradas.&#xa;--  &#x2a; Aprobados en actas de cursadas que no promocionaron&#xa;--  &#x2a; Desaprobados en actas de cursadas y promocion&#xa;--  &#x2a; Ausentes en actas de cursadas y promocion&#xa;-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;WITH actas as &#x28;SELECT &#x2a;  FROM negocio.sga_actas where origen IN &#x28;&#x27;R&#x27;,&#x27;P&#x27;&#x29; AND estado &#x3d; &#x27;C&#x27;&#x29;,&#xa;actas_det as &#x28;SELECT &#x2a;  FROM negocio.sga_actas_detalle WHERE sga_actas_detalle.resultado IN &#x28;&#x27;A&#x27;,&#x27;R&#x27;,&#x27;U&#x27;&#x29;&#xa;	AND sga_actas_detalle.estado &#x3d; &#x27;A&#x27;AND sga_actas_detalle.rectificado &#x3d; &#x27;N&#x27;&#x29;&#xa;SELECT&#xa;	vw_comisiones.ubicacion ,&#xa;	cast&#x28;vw_comisiones.anio_academico as integer&#x29; as anio_academico,&#xa;	sga_periodos_genericos.periodo_generico_tipo AS tipoperiodo,&#xa;	vw_comisiones.periodo_nombre as periodo_lectivo,&#xa;	vw_comisiones.orden as orden_periodo_en_anio,&#xa;	sga_alumnos.alumno,&#xa;	sga_alumnos.propuesta,&#xa;	actas_det.plan_version as plan_version,&#xa;	vw_comisiones.elemento as actividad,&#xa;	CASE&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;M&#x27; THEN 1&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;F&#x27; THEN 2&#xa;	END AS sexo,&#xa;       &#x28;CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE &#x28;&#xa;		extract&#x28;year from age&#x28;date &#x28;vw_comisiones.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;, mdp_personas.fecha_nacimiento&#x29;&#x29;&#xa;	&#x29; END&#x29; as edad,&#xa;	mdp_personas.nacionalidad,&#xa;	&#x28;SELECT CASE WHEN mdp_datos_estudios.nivel_estudio &#x3d; 3 THEN mdp_datos_estudios.colegio &#xa;		ELSE NULL END&#xa;	FROM mdp_datos_estudios &#xa;	WHERE mdp_datos_estudios.persona &#x3d; mdp_personas.persona&#xa;	LIMIT 1&#x29; as colegio,&#xa;	sga_catedras.catedra as catedra,&#xa;	vw_comisiones.comision as comision,&#xa;	CASE&#xa;	   WHEN actas.origen &#x3d; &#x27;P&#x27; AND actas_det.resultado &#x3d; &#x27;A&#x27; THEN 5 -- Promociono&#xa;	   WHEN actas.origen &#x3d; &#x27;P&#x27; AND actas_det.resultado &#x3c;&#x3e; &#x27;A&#x27; THEN 104 -- No Promocion&#xf3; &#x28;No promocionados y Ausentes&#x29;&#xa;       ELSE	actas_det.cond_regularidad&#xa;       END as condicion_regularidad,&#xa;	CASE&#xa;	   WHEN actas.origen &#x3d; &#x27;P&#x27; AND actas_det.resultado &#x3d; &#x27;A&#x27; THEN &#x27;PR&#x27; -- Promociono&#xa;	   WHEN actas.origen &#x3d; &#x27;P&#x27; AND actas_det.resultado &#x3c;&#x3e; &#x27;A&#x27; THEN &#x27;NP&#x27; -- No Promocion&#xf3; &#x28;No promocionados y Ausentes&#x29;&#xa;	   WHEN actas.origen &#x3d; &#x27;R&#x27; THEN actas_det.resultado  -- Resultados del acta de cursadas &#xa;	END AS resultado,&#xa;	actas_det.nota as nota,&#xa;	sga_escalas_notas_det.concepto as concepto,&#xa;	actas_det.pct_asistencia,&#xa;	0 as actividad_comun,&#xa;	actas.nro_acta as acta,&#xa;	actas.estado as estado_acta,&#xa;	&#xa;	intentos.total_intentos as totalintentoscursada, -- Total de veces que ha intentado cursar la materia dentro de la carrera&#xa;	intentos.nro_intento as nrointentocursada,       -- N&#xfa;mero de vez que intenta cursar la materia dentro de la carrera.&#xa;	&#xa;	1 as cantidad_registros_cursada,&#xa;	ingreso.anio_academico_institucion as anio_ingreso_institucion,&#xa;	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,&#xa;	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,&#xa;	sga_alumnos.persona,&#xa;	&#x27;select get_horas_trabajo_araucano&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_horas_trabajadas,&#xa;	&#x27;select get_estado_civil&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_estado_civil,&#xa;	&#x27;select get_localidad_per_lec&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_localidad_per_lec,&#xa;	&#x27;select get_localidad_proc&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_localidad_proc,&#xa;	&#x27;select get_costeo_estudios&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_costeo_estudios,&#xa;	&#x27;select get_beca&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_beca,&#xa;	&#x27;select get_tecno_internet&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_tecno_internet,&#xa;	&#x27;select get_tecno_pc&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_tecno_pc,&#xa;	&#x27;select get_idioma&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_idioma,&#xa;	0 as discapacidad&#xa;&#xa;FROM&#xa;	actas,&#xa;	actas_det LEFT JOIN sga_escalas_notas_det ON &#x28;sga_escalas_notas_det.escala_nota &#x3d; actas_det.escala_nota AND sga_escalas_notas_det.nota &#x3d; actas_det.nota&#x29;, &#xa;	sga_planes_versiones,&#xa;	vw_comisiones&#xa;	   LEFT JOIN sga_catedras ON sga_catedras.catedra &#x3d; vw_comisiones.catedra,&#xa;	sga_alumnos,&#xa;	mdp_personas,&#xa;	sga_propuestas,&#xa;	_wichi_intentos_cursadas as intentos,&#xa;	_wichi_ingreso_alumnos as ingreso,&#xa;	sga_periodos_genericos&#xa;	&#xa;WHERE actas_det.id_acta &#x3d; actas.id_acta&#xa;        AND &#x28;&#x28;actas.origen &#x3d; &#x27;P&#x27;&#x29; OR&#xa;             &#x28;actas.origen &#x3d; &#x27;R&#x27; AND actas_det.resultado &#x3c;&#x3e; &#x27;A&#x27;&#x29; OR&#xa;             &#x28;actas.origen &#x3d; &#x27;R&#x27; AND actas_det.resultado &#x3d; &#x27;A&#x27; AND &#xa;              NOT EXISTS &#x28;SELECT 1 FROM _wichi_alumnos_promovidos as promo WHERE promo.comision &#x3d; actas.comision AND promo.alumno &#x3d; actas_det.alumno&#x29;&#x29; -- No cuento las promociones en actas de cursadas&#xa;            &#x29; &#xa;	AND vw_comisiones.comision &#x3d; actas.comision&#xa;	AND vw_comisiones.periodo_generico &#x3d; sga_periodos_genericos.periodo_generico&#xa;	AND sga_planes_versiones.plan_version &#x3d; actas_det.plan_version&#xa;	AND sga_alumnos.alumno &#x3d; actas_det.alumno&#xa;	AND sga_alumnos.persona &#x3d; mdp_personas.persona&#xa;	AND sga_propuestas.propuesta &#x3d; sga_alumnos.propuesta&#xa;	&#xa;	-- Intentos de cursada de la materia&#xa;	AND intentos.alumno &#x3d; actas_det.alumno&#xa;	AND intentos.elemento &#x3d; vw_comisiones.elemento&#xa;	AND intentos.comision &#x3d; vw_comisiones.comision&#xa;	&#xa;	AND ingreso.alumno &#x3d; sga_alumnos.alumno&#xa;	AND &#x28;&#x24;&#x7b;periodo&#x7d; &#x3d; 0 or vw_comisiones.anio_academico&#x3d; &#x24;&#x7b;periodo&#x7d;&#x29;&#xa;&#xa;UNION ALL&#xa;&#xa;-- Cursadas aprobadas en otras propuestas del alumno &#x28;Cursadas de actividades comunes con el plan actual&#x29;&#xa;SELECT&#xa;	vw_comisiones.ubicacion,&#xa;	cast&#x28;vw_comisiones.anio_academico as integer&#x29; as anio_academico,&#xa;	sga_periodos_genericos.periodo_generico_tipo AS tipoperiodo,&#xa;	vw_comisiones.periodo_nombre as periodo_lectivo,&#xa;	vw_comisiones.orden as orden_periodo_en_anio,&#xa;	sga_alumnos2.alumno , &#xa;	sga_alumnos2.propuesta , &#xa;	sga_planes_versiones2.plan_version as plan_version, -- actas_det.plan_version&#xa;	vw_comisiones.elemento as actididad, -- vw_comisiones.elemento&#xa;	CASE&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;M&#x27; THEN 1&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;F&#x27; THEN 2&#xa;	END AS sexo,&#xa;       &#x28;CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE &#x28;&#xa;		extract&#x28;year from age&#x28;date &#x28;vw_comisiones.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;, mdp_personas.fecha_nacimiento&#x29;&#x29;&#xa;	&#x29; END&#x29; as edad,&#xa;	mdp_personas.nacionalidad,&#xa;	&#x28;SELECT CASE WHEN mdp_datos_estudios.nivel_estudio &#x3d; 3 THEN mdp_datos_estudios.colegio &#xa;		ELSE NULL END&#xa;	FROM mdp_datos_estudios &#xa;	WHERE mdp_datos_estudios.persona &#x3d; mdp_personas.persona&#xa;	LIMIT 1&#x29; as colegio,&#xa;	sga_catedras.catedra as catedra,&#xa;	vw_comisiones.comision as comision,&#xa;	CASE&#xa;	   WHEN actas.origen &#x3d; &#x27;P&#x27; AND actas_det.resultado &#x3d; &#x27;A&#x27; THEN 5 -- Promociono&#xa;           ELSE	actas_det.cond_regularidad&#xa;        END as condicion_regularidad,&#xa;	--actas_det.resultado as resultado,	&#xa;	CASE&#xa;	   WHEN actas.origen &#x3d; &#x27;P&#x27; AND actas_det.resultado &#x3d; &#x27;A&#x27; THEN &#x27;PR&#x27; -- Promociono&#xa;	   ELSE actas_det.resultado &#xa;	END AS resultado,&#xa;	&#xa;	actas_det.nota as nota,&#xa;	sga_escalas_notas_det.concepto as concepto,&#xa;	actas_det.pct_asistencia AS porcentajeasistencia,&#xa;	1 as actividad_comun,&#xa;	actas.nro_acta as acta,&#xa;	actas.estado as estado_acta,&#xa;	&#xa;	intentos.total_intentos as totalintentoscursada, -- Total de veces que ha intentado cursar la materia dentro de la carrera&#xa;	intentos.nro_intento as nrointentocursada,       -- N&#xfa;mero de vez que intenta cursar la materia dentro de la carrera.&#xa;	&#xa;	1 as cantidad_registros_cursada,&#xa;	ingreso.anio_academico_institucion as anio_ingreso_institucion,&#xa;	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,&#xa;	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,&#xa;	sga_alumnos.persona,&#xa;	&#x27;select get_horas_trabajo_araucano&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_horas_trabajadas,&#xa;	&#x27;select get_estado_civil&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_estado_civil,&#xa;	&#x27;select get_localidad_per_lec&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_localidad_per_lec,&#xa;	&#x27;select get_localidad_proc&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_localidad_proc,&#xa;	&#x27;select get_costeo_estudios&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_costeo_estudios,&#xa;	&#x27;select get_beca&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_beca,&#xa;	&#x27;select get_tecno_internet&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_tecno_internet,&#xa;	&#x27;select get_tecno_pc&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_tecno_pc,&#xa;	&#x27;select get_idioma&#x28;&#x27;&#x7c;&#x7c;sga_alumnos.persona&#x7c;&#x7c;&#x27;&#x29;&#x27; as query_idioma,&#xa;	0 as discapacidad&#xa;FROM&#xa;	actas,&#xa;	actas_det LEFT JOIN sga_escalas_notas_det ON &#x28;sga_escalas_notas_det.escala_nota &#x3d; actas_det.escala_nota AND sga_escalas_notas_det.nota &#x3d; actas_det.nota&#x29;,&#xa;	sga_planes_versiones,&#xa;	vw_comisiones&#xa;	   LEFT JOIN sga_catedras ON sga_catedras.catedra &#x3d; vw_comisiones.catedra,&#xa;	sga_alumnos,&#xa;	mdp_personas,&#xa;	sga_propuestas,&#xa;	_wichi_intentos_cursadas as intentos,&#xa;	_wichi_ingreso_alumnos as ingreso,&#xa;	sga_alumnos as sga_alumnos2,&#xa;	sga_planes_versiones as sga_planes_versiones2,&#xa;	sga_elementos_plan as sga_elementos_plan2,&#xa;	sga_elementos_revision as sga_elementos_revision2,&#xa;	sga_periodos_genericos&#xa;	&#xa;WHERE&#xa;	actas_det.id_acta &#x3d; actas.id_acta&#xa;        AND &#x28;&#x28;actas.origen &#x3d; &#x27;P&#x27; AND actas_det.resultado &#x3d; &#x27;A&#x27;&#x29; OR&#xa;             &#x28;actas.origen &#x3d; &#x27;R&#x27; AND actas_det.resultado &#x3c;&#x3e; &#x27;A&#x27;&#x29; OR&#xa;             &#x28;actas.origen &#x3d; &#x27;R&#x27; AND actas_det.resultado &#x3d; &#x27;A&#x27; AND &#xa;              NOT EXISTS &#x28;SELECT 1 FROM _wichi_alumnos_promovidos as promo WHERE promo.comision &#x3d; actas.comision AND promo.alumno &#x3d; actas_det.alumno&#x29;&#x29; -- No cuento las promociones en actas de cursadas&#xa;            &#x29; &#xa;	AND vw_comisiones.comision &#x3d; actas.comision&#xa;	AND vw_comisiones.periodo_generico &#x3d; sga_periodos_genericos.periodo_generico&#xa;	AND sga_planes_versiones.plan_version &#x3d; actas_det.plan_version&#xa;	AND sga_alumnos.alumno &#x3d; actas_det.alumno&#xa;	AND sga_alumnos.persona &#x3d; mdp_personas.persona&#xa;	&#xa;	-- Intentos de cursada en la otra propuesta&#xa;	AND intentos.alumno   &#x3d; actas_det.alumno&#xa;	AND intentos.elemento &#x3d; vw_comisiones.elemento&#xa;	AND intentos.comision &#x3d; vw_comisiones.comision&#xa;&#xa;	-- Otra propuesta del alumno  &#xa;	AND sga_alumnos2.persona &#x3d; sga_alumnos.persona&#xa;	AND sga_alumnos2.propuesta &#x3c;&#x3e; sga_alumnos.propuesta&#xa;	AND sga_propuestas.propuesta &#x3d; sga_alumnos2.propuesta&#xa;	AND sga_planes_versiones2.plan_version &#x3d; sga_alumnos2.plan_version&#xa;	AND ingreso.alumno &#x3d; sga_alumnos2.alumno&#xa;	AND sga_elementos_revision2.elemento &#x3d; vw_comisiones.elemento&#xa;	AND sga_elementos_plan2.plan_version      &#x3d; sga_alumnos2.plan_version&#xa;	AND sga_elementos_plan2.elemento_revision &#x3d; sga_elementos_revision2.elemento_revision&#xa;	AND &#x28;&#x24;&#x7b;periodo&#x7d; &#x3d; 0 or vw_comisiones.anio_academico&#x3d; &#x24;&#x7b;periodo&#x7d;&#x29;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
