    <connection>siu_dsa</connection>
    <sql>SELECT&#xa;    instalacion_id, anio_academico, plan_version_id, responsable_academica_id, &#xa;    propuesta_formativa_id, ubicacion_id, titulo_araucano_id, sexo_id, &#xa;    anio_ingreso_propuesta, procedencia_id, actividades_rendidas_anio_anterior_id, &#xa;       actividades_aprobadas_anio_anterior_id, total_actividades_rendidas_id, &#xa;       total_actividades_aprobadas_id, horas_trabajadas_id, tipo_ingreso_id, &#xa;       edad_id, alumno_id, nacionalidad_id, calidad_alumno_id, rama_disciplinar_id, &#xa;	persona_id, estado_civil_id, localidad_periodo_lectivo_id, localidad_procedencia_id,&#xa;	costeo_estudios_id , beca, tecno_internet_id, &#xa;       tecno_pc_id, idioma_id,CASE WHEN discapacidad_id &#x3d; 0 THEN &#x27;No&#x27; ELSE &#x27;Si&#x27; END as discapacidad_sino, discapacidad_id, situacion_aspirante_id, nuevos_inscriptos, reinscriptos, &#xa;    egresados, total_alumnos, estudio_padres_id, situacion_laboral_padres_id&#xa;, 0 as unidad_generica_id&#xa;, &#x24;&#x7b;importacion_id&#x7d; as importacion_id&#xa;FROM guarani3_dsa.ft_alumnos&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
