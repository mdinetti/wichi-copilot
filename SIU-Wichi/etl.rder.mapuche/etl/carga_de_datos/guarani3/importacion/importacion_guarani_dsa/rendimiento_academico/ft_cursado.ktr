    <sql>SELECT&#xa; ltub.ubicacion_id&#xa;, cast&#x28;cast&#x28;ltaa.anio_id as numeric&#x29; as integer&#x29; as anio_academico&#xa;, lttp.tipo_periodo_id&#xa;, ltpc.periodo_id as periodo_lectivo_id &#xa;, cast&#x28;orden_periodo_en_anio as integer&#x29; as orden_periodo_en_anio&#xa;, a.alumno_id &#xa;, lte.edad_id&#xa;, lts.sexo_id&#xa;, n.nacionalidad_id &#xa;, ltpro.procedencia_id&#xa;, doc.docente_id&#xa;, ltc.propuesta_formativa_id&#xa;, ra.responsable_academica_id&#xa;, ltpl.plan_version_id&#xa;, ltm.actividad_id&#xa;, ltcr.catedra_id&#xa;, ltco.comision_id&#xa;, ltcg.condicion_id&#xa;, ltno.nota_id&#xa;, cast&#x28;replace&#x28;porcentaje_asistencia,&#x27;,&#x27;,&#x27;.&#x27;&#x29; as decimal&#x28;5,2&#x29;&#x29; as porcentaje_asistencia&#xa;, ltmc.actividad_comun_id as tipo_actividad_id&#xa;, lta.acta_id&#xa;, ltin.intento_id as total_intentos_cursada&#xa;, ltin.intento_id as nro_intento_cursada&#xa;, cast&#x28;cantidad_registros_cursada as integer&#x29; as cantidad_registros_cursada&#xa;, cast&#x28;&#x28;case when ltiu.anio_id &#x3c; 1949 then -1 else ltiu.anio_id end&#x29;as integer&#x29; as anio_ingreso_institucion&#xa;, ltpi.periodo_inscripcion_id as periodo_inscripcion_pf_id&#xa;, per.persona_id&#xa;, coalesce&#x28;lth.horas_trabajadas_id, &#xa;    &#x28;select horas_trabajadas_id from guarani3_dsa.d_horas_trabajadas where horas_trabajadas_codigo &#x3d; &#x27;-9&#x27; and vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;  &#x29; as horas_trabajadas_id&#xa;, estc.estado_civil_id&#xa;, loc_per.localidad_id as localidad_periodo_lectivo_id&#xa;, loc_pro.localidad_id as localidad_procedencia_id&#xa;, ft.costeo_estudios_id&#xa;, ft.beca&#xa;, ft.tecno_internet_id&#xa;, ft.tecno_pc_id&#xa;, ft.idioma_id&#xa;, ft.discapacidad_id&#xa;FROM guarani3_tmp.ft_cursado ft&#xa;left outer join guarani3_dsa.d_ubicacion ltub on &#x28;ft.ubicacion_id&#x3d;ltub.ubicacion_codigo and ltub.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltub.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join public.d_anio ltaa on &#x28;cast&#x28;ft.anio_academico as integer&#x29; &#x3d; ltaa.anio_id&#x29;&#xa;left outer join guarani3_dsa.d_tipo_periodo lttp on &#x28;ft.tipo_periodo_id&#x3d;lttp.tipo_periodo_codigo and lttp.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_alumno a on &#x28;ft.alumno_id&#x3a;&#x3a;integer &#x3d; a.alumno_codigo and a.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and a.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_edad lte on &#x28;ft.edad_id&#x3a;&#x3a;integer &#x3d; lte.edad and lte.vigente &#x3d; &#x27;Y&#x27; &#x29;&#xa;left outer join guarani3_dsa.d_sexo lts on &#x28;ft.sexo_id&#x3a;&#x3a;integer &#x3d; lts.sexo_codigo and lts.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_nacionalidad n on &#x28;ft.nacionalidad_id&#x3a;&#x3a;integer &#x3d; n.nacionalidad_codigo and n.vigente&#x3d;&#x27;Y&#x27;&#x29; &#xa;left outer join guarani3_dsa.d_procedencia ltpro on &#x28;ft.colegio_secundario_id &#x3d; ltpro.colegio_id and ltpro.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_propuesta_formativa ltc on &#x28;ft.propuesta_formativa_id &#x3d; ltc.propuesta_formativa_codigo and ltc.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d;  and ltc.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_tmp.d_propuesta_formativa pf on &#x28;ft.propuesta_formativa_id &#x3d; pf.propuesta_formativa_id&#x29;&#xa;left outer join guarani3_dsa.d_responsable_academica ra on &#x28;pf.responsables_academicas_codigo &#x3d; ra.responsable_academica_codigo and ra.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ra.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_actividad ltm on &#x28;ft.actividad_id&#x3a;&#x3a;integer&#x3d;ltm.elemento and ltm.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltm.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_catedra ltcr on &#x28; ft.catedra_id &#x3d; ltcr.catedra_codigo and ltcr.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltcr.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_tmp.d_condicion_regularidad ltcd on &#x28;ft.condicion_regularidad_id &#x3d; ltcd.condicion_regularidad_id&#x29;&#xa;left outer join guarani3_dsa.d_condicion ltcg on &#x28;ltcd.condicion_regularidad_desc &#x3d; ltcg.condicion_desc and  ltcg.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_acta lta on &#x28;ft.acta&#x3d;lta.acta_codigo and ft.estado_acta_id &#x3d; lta.estado_acta_id and lta.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and lta.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_actividad_comun ltmc on &#x28;ft.tipo_actividad_id&#x3d;ltmc.actividad_comun_codigo and ltmc.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_plan_version ltpl on &#x28;ft.plan_version_id&#x3d;ltpl.plan_version_codigo and ltpl.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltpl.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_concepto ltct on &#x28;&#x28;&#x28;ft.concepto is null AND coalesce&#x28;rtrim&#x28;ft.concepto&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x3d;ltct.concepto_codigo&#x29; OR &#x28;ft.concepto&#x3d;ltct.concepto_codigo and ltct.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d;&#x29;&#x29; and ltct.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_resultado ltr on &#x28;ft.resultado_id&#x3d;ltr.resultado_codigo and ltr.concepto_id &#x3d; ltct.concepto_id and ltr.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltr.vigente&#x3d;&#x27;Y&#x27; &#x29;&#xa;left outer join guarani3_dsa.d_nota ltno on &#x28;coalesce&#x28;rtrim&#x28;ft.nota&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29; &#x3d; ltno.nota_codigo and ltr.resultado_id &#x3d; ltno.resultado_id and ltr.resultado_codigo&#x3d;ft.resultado_id &#xa;and ltct.concepto_id &#x3d; ltr.concepto_id and ltct.concepto_codigo&#x3d;coalesce&#x28;rtrim&#x28;ft.concepto&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29; and ltno.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltno.vigente&#x3d;&#x27;Y&#x27;&#x29; &#xa;left outer join guarani3_dsa.d_comision ltco on &#x28;ft.comision_id &#x3d; ltco.comision_codigo and ltco.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltco.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_total_intento ltti on &#x28;ft.total_intentos_cursada &#x3d; ltti.total_intento_codigo and ltti.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_intento ltin on &#x28;&#x28;ft.nro_intento_cursada&#x7c;&#x7c;&#x27;&#x2f;&#x27;&#x7c;&#x7c;total_intentos_cursada&#x29; &#x3d; ltin.nro_intento_id and ltin.total_intento_id &#x3d; ltti.total_intento_id and  ltin.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join public.d_anio ltiu on &#x28;cast &#x28;ft.anio_ingreso_institucion as integer&#x29;&#x3d; ltiu.anio_id&#x29;&#xa;left outer join guarani3_dsa.d_periodo_inscripcion ltpi on &#x28;ft.periodo_inscripcion_pf_desc &#x3d; ltpi.periodo_inscripcion_codigo and ft.anio_ingreso_pf &#x3d; ltpi.anio_academico and ltpi.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltpi.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_tipo_periodo lttt on &#x28;ft.tipo_periodo_id &#x3d; lttt.tipo_periodo_codigo and lttt.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_dsa.d_periodo_anio_academico ltpc on &#x28;&#x28;ft.anio_academico &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; ft.tipo_periodo_id &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; ft.periodo_lectivo_desc&#x29; &#x3d; ltpc.periodo_desc and ft.anio_academico &#x3d; ltpc.anio_academico and ltpc.tipo_periodo_id &#x3d; lttt.tipo_periodo_id and ltpc.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltpc.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_persona per on &#x28;ft.persona_id &#x3d; per.persona_codigo and per.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and per.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani3_tmp.d_comision_docentes cd on &#x28;ft.comision_id &#x3d; cd.comision_id&#x29;&#xa;left outer join guarani3_dsa.d_docente doc on &#x28;cd.responsabilidad_docentes_codigo &#x3d; doc.docente_codigo and doc.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and doc.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_horas_trabajadas lth on &#x28;ft.horas_trabajadas_id &#x3d; lth.horas_trabajadas_codigo and lth.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_localidad loc_per on &#x28;ft.localidad_periodo_lectivo_id &#x3d; loc_per.localidad_codigo and loc_per.vigente&#x3d;&#x27;Y&#x27;&#x29;    &#xa;left join guarani3_dsa.d_localidad loc_pro on &#x28;ft.localidad_procedencia_id &#x3d; loc_pro.localidad_codigo and loc_pro.vigente&#x3d;&#x27;Y&#x27;&#x29; &#xa;left join guarani3_dsa.d_estado_civil estc on &#x28;ft.estado_civil_id &#x3d; estc.estado_civil_codigo and estc.vigente&#x3d;&#x27;Y&#x27;&#x29; &#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
