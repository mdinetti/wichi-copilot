  <step>
    <name>ft_procedencia_aspirantes</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>select  ltp.periodo_inscripcion_id&#xa;      , ltc.propuesta_formativa_id&#xa;      , ra.responsable_academica_id&#xa;      , u.ubicacion_id&#xa;      , pv.plan_version_id&#xa;      , lts.sexo_id&#xa;	  , per.persona_id&#xa;      , ltpro.procedencia_id&#xa;      , ltsit.situacion_aspirante_id&#xa;      , lti.tipo_ingreso_aspirante_id&#xa;      , lte.edad_id&#xa;      , n.nacionalidad_id &#xa;      , ep.estudio_padres_id&#xa;      , lp.situacion_laboral_padres_id &#xa;	  , ft.anio_academico&#xa;	  , loc_pro.localidad_id as localidad_procedencia_id&#xa;      , ft.cantidad&#xa;FROM guarani3_tmp.ft_procedencia_aspirantes ft&#xa;left join guarani3_dsa.d_periodo_inscripcion ltp on &#x28;ft.periodo_inscripcion_id&#x3d;ltp.periodo_inscripcion_codigo and cast&#x28;ft.anio_academico as character varying&#x29;&#x3d; ltp.anio_academico and ltp.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltp.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_situacion_aspirante ltsit on &#x28;ft.situacion_aspirante_id&#x3d;ltsit.situacion_aspirante_codigo and ltsit.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_propuesta_formativa ltc on &#x28;ft.propuesta_formativa_id &#x3d; ltc.propuesta_formativa_codigo and ltc.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ltc.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left join guarani3_tmp.d_propuesta_formativa pf on &#x28;ft.propuesta_formativa_id &#x3d; pf.propuesta_formativa_id&#x29;&#xa;left join guarani3_dsa.d_responsable_academica ra on &#x28;pf.responsables_academicas_codigo &#x3d; ra.responsable_academica_codigo and ra.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and ra.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_ubicacion u on &#x28;ft.ubicacion_id &#x3d; ubicacion_codigo and u.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and u.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_plan_version pv on &#x28;ft.plan_version_id &#x3d; pv.plan_version_codigo and pv.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and pv.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_procedencia ltpro on &#x28;ft.colegio_id &#x3d; ltpro.colegio_id and ltpro.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_sexo lts on &#x28;ft.sexo_id &#x3d; lts.sexo_codigo and lts.vigente &#x3d; &#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_tipo_ingreso_aspirante lti on &#x28;ft.tipo_ingreso_aspirante_id &#x3d; lti.tipo_ingreso_aspirante_codigo and lti.vigente &#x3d; &#x27;Y&#x27; &#x29;&#xa;left join guarani3_dsa.d_edad lte on &#x28;ft.edad_id &#x3d; lte.edad and lte.vigente &#x3d; &#x27;Y&#x27; &#x29;&#xa;left join guarani3_dsa.d_nacionalidad n on &#x28;ft.nacionalidad_id &#x3d; n.nacionalidad_codigo and n.vigente&#x3d;&#x27;Y&#x27;&#x29; &#xa;--left join guarani3_dsa.d_rama_disciplinar rd on &#x28;ft.rama_disciplinar_id &#x3d; rd.rama_disciplinar_codigo and rd.vigente&#x3d;&#x27;Y&#x27;&#x29;    &#xa;left join guarani3_dsa.d_estudio_padres ep on &#x28;ft.estudio_padres_id &#x3d; ep.estudio_padres_codigo and ep.vigente&#x3d;&#x27;Y&#x27;&#x29; &#xa;left join guarani3_dsa.d_situacion_laboral_padres lp on &#x28;ft.situacion_padres_id &#x3d; lp.situacion_laboral_padres_codigo and lp.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_persona per on &#x28;ft.persona_id &#x3d; per.persona_codigo and per.instalacion_id &#x3d; &#x24;&#x7b;instalacion_id&#x7d; and per.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left join guarani3_dsa.d_localidad loc_pro on &#x28;ft.localidad_procedencia_id &#x3d; loc_pro.localidad_codigo and loc_pro.vigente&#x3d;&#x27;Y&#x27;&#x29; </sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
