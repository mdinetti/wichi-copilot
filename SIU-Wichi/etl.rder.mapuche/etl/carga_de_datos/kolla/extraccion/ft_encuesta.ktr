  <step>
    <name>ft_encuesta</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_fuente</connection>
    <sql>SELECT&#xa;  substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29; AS instalacion_id,&#xa;  rd.respondido_encuesta   AS encuestado_codigo,&#xa;  re.respondido_formulario AS encuestado_formulario_codigo,&#xa;  ed.encuesta AS encuesta_codigo,&#xa;  fh.habilitacion&#x3a;&#x3a;text AS habilitacion,&#xa;  ed.pregunta AS pregunta_codigo, &#xa;  rd.respuesta_codigo&#x3a;&#x3a;text AS respuesta_codigo,&#xa;  rd.respuesta_valor&#x3a;&#x3a;text AS respuesta_valor_original,&#xa;  &#x28;&#x28;SELECT &#xa;     count&#x28;&#x2a;&#x29; &#xa;   FROM kolla.sge_encuesta_definicion ed2 &#xa;   WHERE ed2.encuesta&#x3d;ed.encuesta AND &#xa;     ed2.bloque IN &#x28;SELECT b2.bloque FROM kolla.sge_bloque b2 WHERE b2.orden &#x3c; b.orden&#x29;&#x29; &#x2b; &#xa;      &#x28;SELECT &#xa;     count&#x28;&#x2a;&#x29; &#xa;   FROM kolla.sge_encuesta_definicion ed3 &#xa;   WHERE ed3.encuesta&#x3d;ed.encuesta AND ed3.bloque&#x3d;ed.bloque AND ed3.orden&#x3c;ed.orden&#x29;&#xa; &#x2b; 1 &#x29; AS posicion,&#xa;  b.orden AS bloque_codigo,&#xa;  rf.fecha_terminado AS fecha&#xa; FROM kolla.sge_respondido_detalle rd, kolla.sge_encuesta_definicion ed, kolla.sge_pregunta p, kolla.sge_bloque b, &#xa;  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, kolla.sge_formulario_habilitado fh,&#xa;  &#x28;select distinct encuesta_codigo from kolla.temp_encuestas&#x29; tmp&#xa; WHERE tmp.encuesta_codigo &#x3d; ed.encuesta  AND&#xa; rd.encuesta_definicion&#x3d;ed.encuesta_definicion AND ed.pregunta&#x3d;p.pregunta AND ed.bloque &#x3d; b.bloque AND p.componente_numero NOT IN &#x28;4,5&#x29; AND&#xa;  rd.respondido_encuesta&#x3d;re.respondido_encuesta AND re.respondido_formulario&#x3d;rf.respondido_formulario AND rf.formulario_habilitado&#x3d;fh.formulario_habilitado AND rf.terminado&#x3d;&#x27;S&#x27;&#xa;UNION&#xa;SELECT  &#xa;  substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29; AS instalacion_id,&#xa;  rd.respondido_encuesta   AS encuestado_codigo,&#xa;  re.respondido_formulario AS encuestado_formulario_codigo,&#xa;  ed.encuesta AS encuesta_codigo,&#xa;  fh.habilitacion&#x3a;&#x3a;text AS habilitacion,&#xa;  pr.pregunta AS pregunta_codigo, &#xa;  array_to_string&#x28;array_agg&#x28;rd.respuesta_codigo ORDER BY pr.orden&#x29;, &#x27;-&#x2f;-&#x27;&#x29; as respuesta_codigo,&#xa;  array_to_string&#x28;array_agg&#x28;r.valor_tabulado ORDER BY pr.orden&#x29;, &#x27; -&#x2f;- &#x27;&#x29; as respuesta_valor,&#xa;  &#x28;&#x28;SELECT &#xa;     count&#x28;&#x2a;&#x29; &#xa;   FROM kolla.sge_encuesta_definicion ed2 &#xa;   WHERE ed2.encuesta&#x3d;ed.encuesta AND &#xa;     ed2.bloque IN &#x28;SELECT b2.bloque FROM kolla.sge_bloque b2 WHERE b2.orden &#x3c; b.orden&#x29;&#x29; &#x2b; &#xa;      &#x28;SELECT &#xa;     count&#x28;&#x2a;&#x29; &#xa;   FROM kolla.sge_encuesta_definicion ed3 &#xa;   WHERE ed3.encuesta&#x3d;ed.encuesta AND ed3.bloque&#x3d;ed.bloque AND ed3.orden&#x3c;ed.orden&#x29;&#xa; &#x2b; 1 &#x29; AS posicion,&#xa;  b.orden AS bloque_codigo,&#xa;  rf.fecha_terminado AS fecha&#xa; FROM kolla.sge_respondido_detalle rd, kolla.sge_pregunta_respuesta pr, kolla.sge_encuesta_definicion ed, kolla.sge_respuesta r, kolla.sge_pregunta p, kolla.sge_bloque b, &#xa;  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, kolla.sge_formulario_habilitado fh,&#xa;  &#x28;select distinct encuesta_codigo from kolla.temp_encuestas&#x29; tmp&#xa; WHERE tmp.encuesta_codigo &#x3d; ed.encuesta  AND rd.respuesta_codigo&#x3d;pr.respuesta &#xa;  AND rd.encuesta_definicion&#x3d;ed.encuesta_definicion AND ed.pregunta&#x3d;pr.pregunta&#xa;  AND rd.respuesta_codigo&#x3d;r.respuesta&#xa;  AND ed.bloque &#x3d; b.bloque&#xa;  AND rd.respuesta_codigo&#x3e;0 AND rd.respuesta_codigo IS NOT NULL AND ed.pregunta&#x3d;p.pregunta AND p.componente_numero IN &#x28;4,5&#x29;&#xa;  AND rd.respondido_encuesta&#x3d;re.respondido_encuesta AND re.respondido_formulario&#x3d;rf.respondido_formulario AND rf.formulario_habilitado&#x3d;fh.formulario_habilitado AND rf.terminado&#x3d;&#x27;S&#x27;&#xa;  AND p.tabla_asociada&#x3d;&#x27;&#x27; &#xa;GROUP BY 1, 2, 3, 4, 5, 6, 9, 10, 11&#xa;UNION&#xa;SELECT &#xa;  substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29; AS instalacion_id,&#xa;  rd.respondido_encuesta   AS encuestado_codigo,&#xa;  re.respondido_formulario AS encuestado_formulario_codigo,&#xa;  ed.encuesta AS encuesta_codigo,&#xa;  fh.habilitacion&#x3a;&#x3a;text AS habilitacion,&#xa;  ed.pregunta AS pregunta_codigo, &#xa;  array_to_string&#x28;array_agg&#x28;rd.respuesta_codigo ORDER BY rd.respuesta_codigo&#x29;, &#x27;-&#x2f;-&#x27;&#x29; as respuesta_codigo,&#xa;  array_to_string&#x28;array_agg&#x28;rd.respuesta_valor ORDER BY rd.respuesta_valor&#x29;, &#x27; -&#x2f;- &#x27;&#x29; as respuesta_valor,&#xa;  --rd.respuesta_codigo&#x3a;&#x3a;text AS respuesta_codigo,&#xa;  --rd.respuesta_valor&#x3a;&#x3a;text AS respuesta_valor_original,&#xa;  &#x28;&#x28;SELECT &#xa;     count&#x28;&#x2a;&#x29; &#xa;   FROM kolla.sge_encuesta_definicion ed2 &#xa;   WHERE ed2.encuesta&#x3d;ed.encuesta AND &#xa;     ed2.bloque IN &#x28;SELECT b2.bloque FROM kolla.sge_bloque b2 WHERE b2.orden &#x3c; b.orden&#x29;&#x29; &#x2b; &#xa;      &#x28;SELECT &#xa;     count&#x28;&#x2a;&#x29; &#xa;   FROM kolla.sge_encuesta_definicion ed3 &#xa;   WHERE ed3.encuesta&#x3d;ed.encuesta AND ed3.bloque&#x3d;ed.bloque AND ed3.orden&#x3c;ed.orden&#x29;&#xa; &#x2b; 1 &#x29; AS posicion,&#xa;  b.orden AS bloque_codigo,&#xa;  rf.fecha_terminado AS fecha&#xa; FROM kolla.sge_respondido_detalle rd, kolla.sge_encuesta_definicion ed, kolla.sge_pregunta p, kolla.sge_bloque b, &#xa;  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, kolla.sge_formulario_habilitado fh,&#xa;  &#x28;select distinct encuesta_codigo from kolla.temp_encuestas&#x29; tmp&#xa; WHERE tmp.encuesta_codigo &#x3d; ed.encuesta  AND rd.encuesta_definicion&#x3d;ed.encuesta_definicion AND ed.pregunta&#x3d;p.pregunta AND ed.bloque &#x3d; b.bloque AND p.componente_numero IN &#x28;4,5&#x29;&#xa;  AND rd.respondido_encuesta&#x3d;re.respondido_encuesta AND re.respondido_formulario&#x3d;rf.respondido_formulario AND rf.formulario_habilitado&#x3d;fh.formulario_habilitado AND rf.terminado&#x3d;&#x27;S&#x27;&#xa;  AND p.tabla_asociada&#x3c;&#x3e;&#x27;&#x27; &#xa;GROUP BY 1, 2, 3, 4, 5, 6, 9, 10, 11&#xa;UNION&#xa;SELECT DISTINCT&#xa;  substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29; AS instalacion_id,&#xa;  rd.respondido_encuesta   AS encuestado_codigo,&#xa;  re.respondido_formulario AS encuestado_formulario_codigo,&#xa;  ed.encuesta AS encuesta_codigo,&#xa;  fh.habilitacion&#x3a;&#x3a;text AS habilitacion,&#xa;  -100 AS pregunta_codigo, &#xa;  &#x27;&#x27;&#x3a;&#x3a;text AS respuesta_codigo,&#xa;  fh.concepto&#x3a;&#x3a;text AS respuesta_valor_original,&#xa;  0 AS posicion,&#xa;  0 AS bloque_codigo,&#xa;  rf.fecha_terminado AS fecha&#xa; FROM kolla.sge_respondido_detalle rd, kolla.sge_encuesta_definicion ed,&#xa;  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, &#xa;  kolla.sge_formulario_habilitado_detalle fhd, kolla.sge_formulario_habilitado fh,&#xa;  &#x28;select distinct encuesta_codigo from kolla.temp_encuestas&#x29; tmp&#xa; WHERE tmp.encuesta_codigo &#x3d; ed.encuesta  AND rd.encuesta_definicion&#x3d;ed.encuesta_definicion AND &#xa;  rd.respondido_encuesta&#x3d;re.respondido_encuesta AND re.formulario_habilitado_detalle&#x3d;fhd.formulario_habilitado_detalle AND&#xa;  fhd.formulario_habilitado&#x3d;fh.formulario_habilitado AND&#xa;  re.respondido_formulario&#x3d;rf.respondido_formulario AND &#xa;  rf.terminado&#x3d;&#x27;S&#x27;&#xa;UNION&#xa;SELECT DISTINCT&#xa;  substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29; AS instalacion_id,&#xa;  rd.respondido_encuesta   AS encuestado_codigo,&#xa;  re.respondido_formulario AS encuestado_formulario_codigo,&#xa;  ed.encuesta AS encuesta_codigo,&#xa;  fh.habilitacion&#x3a;&#x3a;text AS habilitacion,&#xa;  -200 AS pregunta_codigo, &#xa;  &#x27;&#x27;&#x3a;&#x3a;text AS respuesta_codigo,&#xa;  fhd.elemento&#x3a;&#x3a;text AS respuesta_valor_original,&#xa;  0 AS posicion,&#xa;  0 AS bloque_codigo,&#xa;  rf.fecha_terminado AS fecha&#xa; FROM kolla.sge_respondido_detalle rd, kolla.sge_encuesta_definicion ed,&#xa;  kolla.sge_respondido_encuesta re, kolla.sge_respondido_formulario rf, &#xa;  kolla.sge_formulario_habilitado_detalle fhd, kolla.sge_formulario_habilitado fh,&#xa;  &#x28;select distinct encuesta_codigo from kolla.temp_encuestas&#x29; tmp&#xa; WHERE tmp.encuesta_codigo &#x3d; ed.encuesta  AND rd.encuesta_definicion&#x3d;ed.encuesta_definicion AND &#xa;  rd.respondido_encuesta&#x3d;re.respondido_encuesta AND re.formulario_habilitado_detalle&#x3d;fhd.formulario_habilitado_detalle AND&#xa;  fhd.formulario_habilitado&#x3d;fh.formulario_habilitado AND&#xa;  re.respondido_formulario&#x3d;rf.respondido_formulario AND &#xa;  rf.terminado&#x3d;&#x27;S&#x27;&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
