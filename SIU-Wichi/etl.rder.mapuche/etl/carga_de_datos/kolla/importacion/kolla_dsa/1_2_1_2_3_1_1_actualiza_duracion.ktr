  <step>
    <name>1_2_1_2_3_1_1_actualiza_duracion_media</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <sql>UPDATE kolla_dsa.ft_cuadro fta&#xa;SET facultad_id &#x3d; sel.facu, titulo_id &#x3d; sel.titu, anio_informado_id &#x3d; sel.anio, duracion_media &#x3d; sel.dura &#xa;FROM&#xa;&#x28;SELECT ft.facultad_id AS facu, ft.titulo_id AS titu, ft.anio_informado_id AS anio, &#x28;SELECT sum&#x28;cantidad &#x2a; &#x28;anio_informado_id - anio_ingreso_id&#x29;&#x29; &#xa;		FROM kolla_dsa.ft_cuadro &#xa;		WHERE ft.facultad_id&#x3d;facultad_id AND ft.titulo_id&#x3d;titulo_id AND ft.anio_informado_id&#x3d;anio_informado_id AND anio_ingreso_id &#x3c;&#x3e; 0 AND cuadro_id&#x3d;3&#xa;	&#x29; &#x2a; 12 &#x2f; sum&#x28;cantidad&#x29; AS dura&#xa;	FROM kolla_dsa.ft_cuadro ft, kolla_dsa.d_facultad f, kolla_dsa.d_titulo t&#xa;	WHERE anio_informado_id&#x3d;ft.anio_informado_id AND f.facultad_id&#x3d;ft.facultad_id AND t.titulo_id&#x3d;ft.titulo_id&#xa;	AND &#xa;	ft.anio_ingreso_id&#x3c;&#x3e;0 AND ft.cuadro_id&#x3d;3 &#xa;	AND ft.facultad_id&#x3d;f.facultad_id AND ft.titulo_id&#x3d;t.titulo_id&#xa;	GROUP BY 1, 2, 3&#x29; sel&#xa;WHERE facultad_id&#x3d;sel.facu AND titulo_id&#x3d;sel.titu AND anio_informado_id&#x3d;sel.anio&#x3b;</sql>
    <set_params>N</set_params>
