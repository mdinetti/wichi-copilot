    <entry>
      <name>Eliminar indices</name>
      <description/>
      <type>SQL</type>
      <sql>--Se borran los &#xed;ndices de la tabla dsa ft_movimientos_gastos&#xa;DROP INDEX IF EXISTS pilaga_dsa.idx_dsa_ft_movimientos_gastos_paso&#x3b;&#xa;DROP INDEX IF EXISTS pilaga_dsa.idx_dsa_ft_movimientos_gastos_paso_anterior&#x3b;&#xa;DROP INDEX IF EXISTS pilaga_dsa.idx_dsa_ft_movimientos_gastos_etapa_presup&#x3b;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dsa</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>222</xloc>
      <yloc>180</yloc>
      </entry>
    <entry>
      <name>Crear indices</name>
      <description/>
      <type>SQL</type>
      <sql>--Se crean los &#xed;ndices de la tabla dsa ft_movimientos_gastos&#xa;CREATE INDEX idx_dsa_ft_movimientos_gastos_paso&#xa;  ON pilaga_dsa.ft_movimientos_gastos&#xa;  USING btree&#xa;  &#x28;paso&#x29;&#x3b;&#xa;&#xa;CREATE INDEX idx_dsa_ft_movimientos_gastos_paso_anterior&#xa;  ON pilaga_dsa.ft_movimientos_gastos&#xa;  USING btree&#xa;  &#x28;paso_anterior&#x29;&#x3b;&#xa;&#xa;CREATE INDEX idx_dsa_ft_movimientos_gastos_etapa_presup&#xa;  ON pilaga_dsa.ft_movimientos_gastos&#xa;  USING btree&#xa;  &#x28;etapa_presupuestaria&#x29;&#x3b;&#xa;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dsa</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>453</xloc>
      <yloc>180</yloc>
      </entry>
    <entry>
      <name>Actualizar documentos_id</name>
      <description/>
      <type>SQL</type>
      <sql>-- &#x28;1&#x29;&#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_preventivo_id &#x3d; &#xa; &#x28;SELECT documento_principal_id FROM pilaga_dsa.d_documento_principal pd &#xa;	WHERE pd.documento_principal_id &#x3d; ft.documento_principal_id&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;PR&#x27;&#x3b; &#xa;-- &#x28;2&#x29;&#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_compromiso_id &#x3d; &#xa; &#x28;SELECT documento_principal_id FROM pilaga_dsa.d_documento_principal pd &#xa;	WHERE pd.documento_principal_id &#x3d; ft.documento_principal_id&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;CD&#x27;&#x3b; &#xa;-- &#x28;3&#x29;&#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_preventivo_id &#x3d; &#xa; &#x28;SELECT documento_preventivo_id FROM pilaga_dsa.ft_movimientos_gastos ft2 WHERE ft.paso_anterior&#x3d;ft2.paso LIMIT 1&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;CD&#x27;&#x3b; &#xa;-- &#x28;4&#x29;&#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_devengado_id &#x3d; &#xa; &#x28;SELECT documento_principal_id FROM pilaga_dsa.d_documento_principal pd &#xa;	WHERE pd.documento_principal_id &#x3d; ft.documento_principal_id&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;DE&#x27;&#x3b; &#xa;-- &#x28;5&#x29;&#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_preventivo_id &#x3d; &#xa; &#x28;SELECT documento_preventivo_id FROM pilaga_dsa.ft_movimientos_gastos ft2 WHERE ft.paso_anterior&#x3d;ft2.paso LIMIT 1&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;DE&#x27;&#x3b; &#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_compromiso_id &#x3d; &#xa; &#x28;SELECT documento_compromiso_id FROM pilaga_dsa.ft_movimientos_gastos ft2 WHERE ft.paso_anterior&#x3d;ft2.paso LIMIT 1&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;DE&#x27;&#x3b; &#xa;-- &#x28;6&#x29;&#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_pagado_id &#x3d; &#xa; &#x28;SELECT documento_principal_id FROM pilaga_dsa.d_documento_principal pd &#xa;	WHERE pd.documento_principal_id &#x3d; ft.documento_principal_id&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;PA&#x27;&#x3b; &#xa;-- &#x28;7&#x29;&#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_preventivo_id &#x3d; &#xa; &#x28;SELECT documento_preventivo_id FROM pilaga_dsa.ft_movimientos_gastos ft2 WHERE ft.paso_anterior&#x3d;ft2.paso LIMIT 1&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;PA&#x27;&#x3b; &#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_compromiso_id &#x3d; &#xa; &#x28;SELECT documento_compromiso_id FROM pilaga_dsa.ft_movimientos_gastos ft2 WHERE ft.paso_anterior&#x3d;ft2.paso LIMIT 1&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;PA&#x27;&#x3b; &#xa;UPDATE pilaga_dsa.ft_movimientos_gastos as ft SET documento_devengado_id &#x3d; &#xa; &#x28;SELECT documento_devengado_id FROM pilaga_dsa.ft_movimientos_gastos ft2 WHERE ft.paso_anterior&#x3d;ft2.paso LIMIT 1&#x29;&#xa;WHERE etapa_presupuestaria &#x3d; &#x27;PA&#x27;&#x3b; &#xa;&#xa;--Este campo &#x28;documento_principal_id&#x29; contendr&#xe1; el id de la &#xfa;ltima etapa en la que se encuentra el movimiento&#xa;UPDATE pilaga_dsa.ft_movimientos_gastos SET documento_principal_id &#x3d; &#xa;CASE WHEN documento_pagado_id is not null and documento_pagado_id &#x3c;&#x3e; 0&#xa;	THEN documento_pagado_id&#xa;ELSE&#xa;	CASE WHEN documento_devengado_id is not null and documento_devengado_id &#x3c;&#x3e; 0&#xa;		THEN documento_devengado_id&#xa;	ELSE&#xa;		CASE WHEN documento_compromiso_id is not null and documento_compromiso_id &#x3c;&#x3e; 0&#xa;			THEN documento_compromiso_id&#xa;		ELSE&#xa;			CASE WHEN documento_preventivo_id is not null and documento_preventivo_id &#x3c;&#x3e; 0&#xa;				THEN documento_preventivo_id&#xa;			ELSE&#xa;				documento_principal_id&#xa;			END&#xa;		END&#xa;	END&#xa;END&#x3b;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dsa</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>687</xloc>
      <yloc>188</yloc>
      </entry>
