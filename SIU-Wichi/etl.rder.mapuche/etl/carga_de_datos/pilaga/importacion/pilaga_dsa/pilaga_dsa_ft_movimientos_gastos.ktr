resolucion&#xa;, &#x27;Y&#x27; as vigente --este campo se usa para el &#x22;database lookup&#x22; para que solo busque los registros de la dimension con vigente &#x3d; Y&#xa;, &#x24;&#x7b;instalacion_id&#x7d; AS instalacion_id&#xa;FROM pilaga_tmp.ft_movimientos_gastos&#x3b;&#xa;</sql>
