  <entries>
    <entry>
      <name>cerrar importación</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>update public.importacion
set estado = 'finalizada',
    fecha_fin = now()
where importacion_id = ${importacion_id};
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
