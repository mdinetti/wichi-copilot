    <sql>--Crea el esquema rhun_tmp&#xa;CREATE SCHEMA rhun_tmp&#x3b;&#xa;&#xa;--Tablas del esquema rhun_tmp&#xa;CREATE TABLE rhun_tmp.ft_cargos_liq &#x28;&#xa;    periodo text,&#xa;    institucion_id text,&#xa;    numero_cargo text,&#xa;    cuil_cuit text,&#xa;    escalafon_id text,&#xa;    cod_cargo_universidad text,&#xa;    categ_univ_descripcion text,&#xa;    categ_univ_dedicacion text,&#xa;    equivalencia_cargo_id text,&#xa;    unidad_academica_id text,&#xa;    fuente_financiamiento_id text,&#xa;    estado_laboral_id text,&#xa;    tipo_planta_id text,&#xa;    estado_cargo_id text,&#xa;    situacion_laboral_id text,&#xa;    nivel_ensenianza_id text,&#xa;    meses_antiguedad text,&#xa;    horas_dedicacion text,&#xa;    cant_cargos text,&#xa;    nro_cargo_pers text,&#xa;    anios_antiguedad text,&#xa;    agrupamiento_nd_id text,&#xa;    tipo_cargo_asociado_id text,&#xa;    escalafon_relacionado_id text,&#xa;    cargo_univ_relacionado_id text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.ft_cargos_planta &#x28;&#xa;    periodo text,&#xa;    institucion_id text,&#xa;    numero_cargo text,&#xa;    cuil_cuit text,&#xa;    escalafon_id text,&#xa;    cod_cargo_universidad text,&#xa;    equivalencia_cargo_id text,&#xa;    unidad_academica_id text,&#xa;    ona_rama_id text,&#xa;    ona_disciplina_id text,&#xa;    ona_area_id text,&#xa;    agrupamiento_nd_id text,&#xa;    nivel_ensenianza_id text,&#xa;    grado text,&#xa;    meses_antiguedad text,&#xa;    horas_dedicacion text,&#xa;    dedicacion_docente text,&#xa;    dedicacion_investigacion text,&#xa;    dedicacion_extension text,&#xa;    dedicacion_gestion text,&#xa;    cant_cargos text,&#xa;    sueldo_bruto text,&#xa;    nro_cargo_pers text,&#xa;    tipo_cargo_asociado_id text,&#xa;    escalafon_relacionado_id text,&#xa;    cargo_univ_relacionado_id text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.ft_datos_personales_planta &#x28;&#xa;    periodo text,&#xa;    institucion_id text,&#xa;    cuil_cuit text,&#xa;    nacionalidad_id text,&#xa;    estado_civil_id text,&#xa;    sexo_id text,&#xa;    edad text,&#xa;    sistema_previsional_id text,&#xa;    sistema_previsional text,&#xa;    nivel_educacion_id text,&#xa;    titulo_id text,&#xa;    descripcion_titulo text,&#xa;    conicet_id text,&#xa;    categoria_programa_incentivos text,&#xa;    apellido_y_nombre text,&#xa;    cant_personas text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.ft_detalles_liquidaciones_haberes &#x28;&#xa;    periodo text,&#xa;    institucion_id text,&#xa;    concepto_liq_id text,&#xa;    numero_cargo text,&#xa;    anio_retroactivo text,&#xa;    mes_retroactivo text,&#xa;    importe text,&#xa;    cant_conceptos_x_cargos text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.ft_detalles_liquidaciones_haberes_por_grupos &#x28;&#xa;    periodo text,&#xa;    institucion_id text,&#xa;    tipo_grupo_concepto_id text,&#xa;    concepto_liq_id text,&#xa;    numero_cargo text,&#xa;    anio_retroactivo text,&#xa;    mes_retroactivo text,&#xa;    importe_x_grupo_de_concepto text,&#xa;    cant_conceptosxcargosxgruposconcep text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_agrupamientos_nd &#x28;&#xa;    agrupamiento_nd_id text,&#xa;    agrupamiento_nd_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_categorias_univ &#x28;&#xa;    periodo text,&#xa;    institucion_id text,&#xa;    escalafon_categ_univ text,&#xa;    cod_cargo_universidad text,&#xa;    nivel_ensenianza_id text,&#xa;    categ_univ_descripcion text,&#xa;    categ_univ_dedicacion text,&#xa;    equivalencia_cargo_categ_univ text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_conceptos_liq &#x28;&#xa;    periodo text,&#xa;    institucion_id text,&#xa;    concepto_liq_id text,&#xa;    tipo_concepto_id text,&#xa;    concepto_desc text,&#xa;    cod_objeto_gasto_permanente text,&#xa;    cod_objeto_gasto_transitorio text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_conicet &#x28;&#xa;    conicet_id text,&#xa;    conicet_tipo_categoria text,&#xa;    conicet_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_datos_personales_liq &#x28;&#xa;    periodo text,&#xa;    institucion_id text,&#xa;    cuil_cuit text,&#xa;    apellido_y_nombre text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_equivalencias_cargos &#x28;&#xa;    equivalencia_cargo_id text,&#xa;    escalafon_id text,&#xa;    categ_equiv_dedicacion text,&#xa;    categ_equiv_tipo text,&#xa;    categ_equiv_denominacion text,&#xa;    categ_equiv_horas text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_escalafones &#x28;&#xa;    escalafon_id text,&#xa;    escalafon_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_estados_cargos &#x28;&#xa;    estado_cargo_id text,&#xa;    estado_cargo_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_estados_civiles &#x28;&#xa;    estado_civil_id text,&#xa;    estado_civil_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_estados_laborales &#x28;&#xa;    estado_laboral_id text,&#xa;    estado_laboral_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_fuentes_financiamiento &#x28;&#xa;    fuente_financiamiento_id text,&#xa;    fuente_financiamiento_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_instituciones &#x28;&#xa;    institucion_id text,&#xa;    institucion_desc text,&#xa;    institucion_sigla text,&#xa;    tipo_institucion_id text,&#xa;    institucion_desc_larga text,&#xa;    institucion_cod text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_nacionalidades &#x28;&#xa;    nacionalidad_id text,&#xa;    nacionalidad_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_niveles_educacion &#x28;&#xa;    nivel_educacion_id text,&#xa;    nivel_educacion_sirhu text,&#xa;    nivel_educacion_tipo text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_niveles_ensenianza &#x28;&#xa;    nivel_ensenianza_id text,&#xa;    nivel_ensenianza_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_objeto_del_gasto &#x28;&#xa;    objeto_del_gasto_id text,&#xa;    aux_obj_del_gasto_id text,&#xa;    desc_objeto_del_gasto text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_ona_jerarquias &#x28;&#xa;    ona_rama_id text,&#xa;    ona_disciplina_id text,&#xa;    ona_area_id text,&#xa;    ona_rama_desc text,&#xa;    ona_disciplina_desc text,&#xa;    ona_area_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_ona_tipos_titulos &#x28;&#xa;    tipo_titulo_id text,&#xa;    tipo_titulo_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_ona_titulos &#x28;&#xa;    titulo_id text,&#xa;    titulo_desc text,&#xa;    tipo_titulo_id text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_ona_unidades_academicas &#x28;&#xa;    unidad_academica_id text,&#xa;    institucion_id text,&#xa;    unidad_academica_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_rango_antiguedad &#x28;&#xa;    rango_antiguedad_id text,&#xa;    rango_antiguedad_desc text,&#xa;    rango_antiguedad_doc_id text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_rango_antiguedad_docente &#x28;&#xa;    rango_antiguedad_doc_id text,&#xa;    rango_antiguedad_doc_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_sexos &#x28;&#xa;    sexo_id text,&#xa;    sexo_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_sistema_previsional &#x28;&#xa;    sistema_previsional_id text,&#xa;    sistema_previsional_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_situaciones_laborales &#x28;&#xa;    situacion_laboral_id text,&#xa;    situacion_laboral_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_tipo_cargo_asociado &#x28;&#xa;    tipo_cargo_asociado_id text,&#xa;    tipo_cargo_asociado_desc text,&#xa;    tipo_cargo_asoc_orden text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_tipos_conceptos &#x28;&#xa;    tipo_concepto_id text,&#xa;    tipo_concepto_desc text,&#xa;    tipo_concepto_sirhu text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_tipos_grupos_conceptos &#x28;&#xa;    tipo_grupo_concepto_id text,&#xa;    tipo_grupo_concepto_desc text&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_tmp.lt_tipos_planta &#x28;&#xa;    tipo_planta_id text,&#xa;    tipos_planta_desc text&#xa;&#x29;&#x3b;&#xa;</sql>
