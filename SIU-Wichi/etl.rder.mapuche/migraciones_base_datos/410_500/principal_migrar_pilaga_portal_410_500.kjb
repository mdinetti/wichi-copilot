    <entry>
      <name>migrar Dimensiones</name>
      <description/>
      <type>SQL</type>
      <sql>-- d_banco_sucursal &#x28;no tiene&#x29;&#xa;INSERT INTO pilaga.d_banco_sucursal &#x28;banco_sucursal_id, banco_desc, cuit, sucursal_desc, sucursal_codigo,  fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT 0,&#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29; &#xa;WHERE 0 NOT IN &#x28;SELECT banco_sucursal_id FROM pilaga.d_banco_sucursal&#x29;&#x3b;&#xa;&#xa;-- d_circuito_gestion &#x28;no tiene&#x29;&#xa;INSERT INTO pilaga.d_circuito_gestion &#x28;circuito_gestion_id, circuito_gestion_codigo, circuito_gestion_desc, fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;   SELECT 0,&#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29; &#xa;WHERE 0 NOT IN &#x28;SELECT circuito_gestion_id FROM pilaga.d_circuito_gestion&#x29;&#x3b;&#xa;&#xa;-- d_codigo_economico&#xa;INSERT INTO pilaga.d_codigo_economico &#x28;codigo_economico_id, codigo_economico_codigo, codigo_economico_desc, fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;	SELECT 0,&#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29; &#xa;WHERE 0 NOT IN &#x28;SELECT codigo_economico_id FROM pilaga.d_codigo_economico&#x29;&#x3b;&#xa;&#xa;-- d_tipo_comprobante&#xa;INSERT INTO pilaga.d_tipo_comprobante &#x28;tipo_comprobante_id, tipo_comprobante_codigo, tipo_comprobante_desc, fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;	SELECT 0,&#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;WHERE 0 NOT IN &#x28;SELECT tipo_comprobante_id FROM pilaga.d_tipo_comprobante&#x29;&#x3b;&#xa;&#xa;-- d_persona&#xa;INSERT INTO pilaga.d_persona &#x28;persona_id, persona_codigo, persona_tipo_documento, persona_nro_documento, fisica_o_juridica,  &#xa;	razon_social_apyno, nombre_fantasia, genero_id, nacionalidad, email, cbu, persona_detalle, estado, fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT 0, 0, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;,&#x27;VACIO&#x2f;NULO&#x27;,&#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;WHERE 0 NOT IN &#x28;SELECT persona_id FROM pilaga.d_persona&#x29;&#x3b;&#xa;&#xa;-- d_comprobante&#xa;INSERT INTO pilaga.d_comprobante &#x28;comprobante_id, comprobante_fecha, tipo_comprobante_id, persona_id, comprobante_numero, comprobante_detalle, importe, detalle, fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT 0, &#x27;2199-12-31&#x27;,0, 0, &#x27;VACIO&#x2f;NULO&#x27;,&#x27;VACIO&#x2f;NULO&#x27;, 0, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;WHERE 0 NOT IN &#x28;SELECT comprobante_id FROM pilaga.d_comprobante&#x29;&#x3b;&#xa;&#xa;-- d_concepto  &#xa;INSERT INTO pilaga.d_concepto &#x28;concepto_id, concepto_desc, fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;	SELECT 0, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;WHERE 0 NOT IN &#x28;SELECT concepto_id FROM pilaga.d_concepto&#x29;&#x3b;&#xa;&#xa;CREATE SEQUENCE id_cubos_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_cubos_seq&#x27;, &#x28;SELECT COALESCE&#x28;max&#x28;concepto_id&#x29;&#x2b;1,1&#x29; FROM pilaga.d_concepto&#x29;&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_concepto ALTER COLUMN concepto_id SET DEFAULT nextval&#x28;&#x27;id_cubos_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_concepto &#x28;concepto_desc, fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT DISTINCT concepto, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; FROM pilaga_tmp.d_liquid&#xa;WHERE concepto NOT IN &#x28;SELECT concepto_desc FROM pilaga.d_concepto&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_concepto &#x28;concepto_desc, fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT DISTINCT concepto, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; FROM pilaga_tmp.d_cabpre&#xa;WHERE concepto NOT IN &#x28;SELECT concepto_desc FROM pilaga.d_concepto&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_concepto &#x28;concepto_desc, fecha_desde, fecha_hasta, version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT DISTINCT concepto, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; FROM pilaga_tmp.d_cabcom&#xa;WHERE concepto NOT IN &#x28;SELECT concepto_desc FROM pilaga.d_concepto&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_concepto ALTER COLUMN concepto_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_cubos_seq&#x3b;&#xa;&#xa;-- d_concepto_ingreso&#xa;INSERT INTO pilaga.d_concepto_ingreso &#x28;concepto_ingreso_id, concepto_ingreso_codigo, tipo_ingreso_desc, concepto_ingreso_desc, fecha_desde, fecha_hasta,version,vigente, fecha_actualizacion&#x29;&#xa;  SELECT 0, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;WHERE 0 NOT IN &#x28;SELECT concepto_ingreso_id FROM pilaga.d_concepto_ingreso&#x29;&#x3b;&#xa;CREATE SEQUENCE id_cubos_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_cubos_seq&#x27;, &#x28;SELECT COALESCE&#x28;max&#x28;concepto_ingreso_id&#x29;&#x2b;1,1&#x29; FROM pilaga.d_concepto_ingreso&#x29;&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_concepto_ingreso ALTER COLUMN concepto_ingreso_id SET DEFAULT nextval&#x28;&#x27;id_cubos_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_concepto_ingreso &#x28;concepto_ingreso_codigo, tipo_ingreso_desc, concepto_ingreso_desc, fecha_desde, fecha_hasta,version,vigente, fecha_actualizacion&#x29;&#xa;  SELECT DISTINCT codigo_con, &#x27;ING&#x27;,&#xa;    &#x28;SELECT nombre FROM pilaga_tmp.d_coning n WHERE c.codigo_con&#x3d;n.codigo_con AND &#xa;      n.anio&#x3d;&#x28;SELECT anio FROM pilaga_tmp.d_coning ci WHERE c.codigo_con&#x3d;ci.codigo_con ORDER BY anio desc LIMIT 1&#x29;&#x29;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; &#xa;  FROM pilaga_tmp.d_coning c&#xa;WHERE codigo_con NOT IN &#x28;SELECT concepto_ingreso_codigo FROM pilaga.d_concepto_ingreso&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_concepto_ingreso ALTER COLUMN concepto_ingreso_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_cubos_seq&#x3b;&#xa;&#xa;-- d_cuenta_bancaria&#xa;INSERT INTO pilaga.d_cuenta_bancaria &#x28;cuenta_bancaria_id, cuenta_bancaria_numero, cuenta_bancaria_tipo_desc, cuenta_bancaria_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;	SELECT 0, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;WHERE 0 NOT IN &#x28;SELECT cuenta_bancaria_id FROM pilaga.d_cuenta_bancaria&#x29;&#x3b;&#xa;&#xa;--d_cuenta_tesoreria&#xa;INSERT INTO pilaga.d_cuenta_tesoreria &#x28;cuenta_tesoreria_id, cuenta_tesoreria_tipo_desc, cuenta_tesoreria_codigo, cuenta_tesoreria_desc,&#xa;  tesoreria_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT 0, &#x27;VACIO&#x2f;NULO&#x27;, 0, &#x27;VACIO&#x2f;NULO&#x27;, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29; &#xa;WHERE 0 NOT IN &#x28;SELECT cuenta_tesoreria_id FROM pilaga.d_cuenta_tesoreria&#x29;&#x3b;&#xa;&#xa;-- d_documento_principal&#xa;INSERT INTO pilaga.d_documento_principal &#x28;documento_principal_id, documento_principal_codigo, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;	SELECT 0, &#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;WHERE 0 NOT IN &#x28;SELECT documento_principal_id FROM pilaga.d_documento_principal&#x29;&#x3b;&#xa;&#xa;CREATE SEQUENCE id_cubos_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_cubos_seq&#x27;, &#x28;SELECT COALESCE&#x28;max&#x28;documento_principal_id&#x29;&#x2b;1,1&#x29; FROM pilaga.d_documento_principal&#x29;&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_documento_principal ALTER COLUMN documento_principal_id SET DEFAULT nextval&#x28;&#x27;id_cubos_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_documento_principal &#x28;documento_principal_codigo, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT DISTINCT tipcom &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nroliq &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; FROM pilaga_tmp.d_liquid&#xa;  WHERE tipcom &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nroliq &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio NOT IN &#x28;SELECT documento_principal_codigo FROM pilaga.d_documento_principal&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_documento_principal &#x28;documento_principal_codigo, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT DISTINCT tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;text, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; FROM pilaga_tmp.d_cabpre&#xa;  WHERE tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;text NOT IN &#x28;SELECT documento_principal_codigo FROM pilaga.d_documento_principal&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_documento_principal &#x28;documento_principal_codigo, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT DISTINCT tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;text, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; FROM pilaga_tmp.d_cabcom&#xa;  WHERE tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;text NOT IN &#x28;SELECT documento_principal_codigo FROM pilaga.d_documento_principal&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_documento_principal ALTER COLUMN documento_principal_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_cubos_seq&#x3b;&#xa;&#xa;-- d_expediente&#xa;CREATE SEQUENCE id_cubos_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_cubos_seq&#x27;, &#x28;SELECT COALESCE&#x28;max&#x28;expediente_id&#x29;&#x2b;1,1&#x29; FROM pilaga.d_expediente&#x29;&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_expediente ALTER COLUMN expediente_id SET DEFAULT nextval&#x28;&#x27;id_cubos_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_expediente &#x28;anio, tipo,expediente_nro, expediente_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;SELECT anio, tipo, expediente_nro, expediente_desc &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;varchar as expediente_desc, fecha_desde, fecha_hasta, version,&#xa;	vigente, fecha_actualizacion&#xa;FROM&#x28;&#xa;	SELECT DISTINCT min&#x28;anio&#x29; as anio, &#x27;EXP&#x27; as tipo, nroexp as expediente_nro,&#x27;EXP&#x27; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nroexp  as expediente_desc,  now&#x28;&#x29;&#x3a;&#x3a;date as fecha_desde&#xa;	,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date as fecha_hasta,1 as version,&#x27;Y&#x27; as vigente ,now&#x28;&#x29; as fecha_actualizacion &#xa;	FROM pilaga_tmp.d_liquid&#xa;	WHERE &#x27;EXP&#x27; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nroexp &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;varchar NOT IN &#x28;SELECT expediente_desc FROM pilaga.d_expediente&#x29; group by 2,3,4&#xa;&#x29;d_liq&#x3b;&#xa;&#xa;INSERT INTO pilaga.d_expediente &#x28;anio, tipo,expediente_nro, expediente_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;SELECT anio, tipo, expediente_nro, expediente_desc &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;varchar as expediente_desc, fecha_desde, fecha_hasta, version,&#xa;	vigente, fecha_actualizacion&#xa;FROM&#x28;&#xa;	SELECT DISTINCT min&#x28;anio&#x29; as anio, &#x27;EXP&#x27; as tipo, exp as expediente_nro, &#x27;EXP&#x27; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; exp  as expediente_desc,  now&#x28;&#x29;&#x3a;&#x3a;date as fecha_desde&#xa;	,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date as fecha_hasta,1 as version,&#x27;Y&#x27; as vigente ,now&#x28;&#x29; as fecha_actualizacion  FROM pilaga_tmp.d_cabpre&#xa;	WHERE &#x27;EXP&#x27; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; exp &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;varchar NOT IN &#x28;SELECT expediente_desc FROM pilaga.d_expediente&#x29; group by 2,3,4&#xa;&#x29;d_cabp&#x3b;&#xa;&#xa;INSERT INTO pilaga.d_expediente &#x28;anio, tipo,expediente_nro, expediente_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;SELECT anio, tipo, expediente_nro, expediente_desc &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;varchar as expediente_desc, fecha_desde, fecha_hasta, version,&#xa;	vigente, fecha_actualizacion&#xa;FROM&#x28;&#xa;	SELECT DISTINCT min&#x28;anio&#x29; as anio, &#x27;EXP&#x27; as tipo, exp as expediente_nro, &#x27;EXP&#x27; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; exp  as expediente_desc, now&#x28;&#x29;&#x3a;&#x3a;date as fecha_desde&#xa;	,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date as fecha_hasta,1 as version,&#x27;Y&#x27; as vigente ,now&#x28;&#x29; as fecha_actualizacion FROM pilaga_tmp.d_cabcom&#xa;	WHERE &#x27;EXP&#x27; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; exp &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio&#x3a;&#x3a;varchar NOT IN &#x28;SELECT expediente_desc FROM pilaga.d_expediente&#x29; group by 2,3,4&#xa;&#x29;d_cabc&#x3b;&#xa; &#xa;ALTER TABLE pilaga.d_expediente ALTER COLUMN expediente_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_cubos_seq&#x3b;&#xa;&#xa;-- d_persona&#xa;CREATE SEQUENCE id_cubos_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_cubos_seq&#x27;, &#x28;SELECT COALESCE&#x28;max&#x28;persona_id&#x29;&#x2b;1,1&#x29; FROM pilaga.d_persona&#x29;&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_persona ALTER COLUMN persona_id SET DEFAULT nextval&#x28;&#x27;id_cubos_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_persona &#x28;persona_codigo, persona_tipo_documento, persona_nro_documento,&#xa;	fisica_o_juridica, razon_social_apyno, nombre_fantasia, genero_id, nacionalidad, email, cbu, persona_detalle, &#xa;	estado, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;  SELECT &#xa;    null as persona_codigo, &#xa;    nom_tipd as persona_tipo_documento,&#xa;    CASE WHEN nom_tipd &#x3d; &#x27;CUIT&#x27; OR nom_tipd &#x3d; &#x27;CUIL&#x27; THEN&#xa;      cuit1&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; nrodoc&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; cuit2&#x3a;&#x3a;varchar&#xa;      ELSE nrodoc&#x3a;&#x3a;varchar&#xa;    END as persona_nro_documento,&#xa;    CASE WHEN  nom_tipd &#x3d; &#x27;CUIT&#x27; AND cuit1&#x3a;&#x3a;varchar &#x3d; &#x27;30&#x27; THEN &#x27;J&#x27;&#xa;      ELSE &#x27;F&#x27; &#xa;    END as fisica_o_juridica,&#xa;    nombre as razon_social_apyno,&#xa;    nombre as nombre_fantasia,&#xa;    0 as genero_id,&#xa;    &#x27;&#x27; as nacionalidad,&#xa;    &#x27;&#x27; as email,&#xa;    &#x27;&#x27; as cbu,&#xa;    CASE WHEN nom_tipd &#x3d; &#x27;CUIT&#x27; OR nom_tipd &#x3d; &#x27;CUIL&#x27; THEN&#xa;      &#x27;&#x28;&#x27; &#x7c;&#x7c; nom_tipd &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; cuit1&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; nrodoc&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; cuit2&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;&#x29; &#x27; &#x7c;&#x7c; nombre&#xa;      ELSE  &#x27;&#x28;&#x27; &#x7c;&#x7c; nom_tipd &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nrodoc&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;&#x29; &#x27; &#x7c;&#x7c; nombre&#xa;    END as persona_detalle,&#xa;    &#x27;A&#x27; as estado,&#xa;    now&#x28;&#x29;&#x3a;&#x3a;date as fecha_desde,&#xa;    &#x27;2199-12-31&#x27; as fecha_hasta&#xa;    ,1 as version&#xa;    ,&#x27;Y&#x27; as vigente&#xa;    ,now&#x28;&#x29; as fecha_actualizacion&#xa;  FROM pilaga_tmp.d_benef b, pilaga_tmp.c_tipdoc td&#xa;  WHERE b.tipdoc&#x3d;td.tipdoc AND &#xa;    &#x28;nom_tipd, &#xa;     CASE WHEN nom_tipd &#x3d; &#x27;CUIT&#x27; OR nom_tipd &#x3d; &#x27;CUIL&#x27; THEN&#xa;       cuit1&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; nrodoc&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; cuit2&#x3a;&#x3a;varchar&#xa;       ELSE nrodoc&#x3a;&#x3a;varchar&#xa;    END&#x29; NOT IN &#x28;SELECT persona_tipo_documento, persona_nro_documento FROM pilaga.d_persona&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_persona ALTER COLUMN persona_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_cubos_seq&#x3b;&#xa;&#xa;-- d_red_programatica&#xa;CREATE SEQUENCE id_cubos_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_cubos_seq&#x27;, &#x28;SELECT COALESCE&#x28;max&#x28;red_programatica_id&#x29;&#x2b;1,1&#x29; FROM pilaga.d_red_programatica&#x29;&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_red_programatica ALTER COLUMN red_programatica_id SET DEFAULT nextval&#x28;&#x27;id_cubos_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;INSERT INTO pilaga.d_red_programatica &#x28;red_programatica_codigo, programa_desc, subprograma_desc,&#xa;	proyecto_desc, actividad_desc, obra_desc, red_programatica_combo_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;SELECT DISTINCT &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_prg&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_sub&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_pry&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_act&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_obr&#x3a;&#x3a;text,2&#x29; as red_programatica_codigo,&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_prg&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; COALESCE&#x28;p.nom_prog,&#x27;&#x27;&#x29; AS programa_desc,&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_sub&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; COALESCE&#x28;s.nom_subp,&#x27;&#x27;&#x29; AS subprograma_desc,&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_pry&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; COALESCE&#x28;r.nom_proy,&#x27;&#x27;&#x29; AS proyecto_desc,&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_act&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; COALESCE&#x28;a.nom_activ,&#x27;&#x27;&#x29; AS actividad_desc,&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_obr&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; COALESCE&#x28;o.nom_obr,&#x27;&#x27;&#x29; AS obra_desc,&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_prg&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_sub&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_pry&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_act&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_obr&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#xa;  COALESCE&#x28;p.nom_prog,&#x27;&#x27;&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#xa;  COALESCE&#x28;s.nom_subp,&#x27;&#x27;&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c;&#xa;  COALESCE&#x28;r.nom_proy,&#x27;&#x27;&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#xa;  COALESCE&#x28;a.nom_activ,&#x27;&#x27;&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#xa;  COALESCE&#x28;o.nom_obr,&#x27;&#x27;&#x29; AS red_programatica_combo_desc,&#xa;  now&#x28;&#x29;&#x3a;&#x3a;date as fecha_desde,&#xa;  &#x27;2199-12-31&#x27;&#x3a;&#x3a;date as fecha_hasta,&#xa;  1 as version,&#xa;  &#x27;Y&#x27; as vigente,&#xa;  now&#x28;&#x29;as fecha_actualizacion&#xa;FROM pilaga_tmp.d_salcre AS d&#xa;LEFT OUTER JOIN pilaga_tmp.d_progra AS p ON&#xa;&#x28;&#xa;  d.codigo_prg &#x3d; p.codigo_prg AND &#xa;  p.anio &#x3d; &#x28;SELECT max&#x28;anio&#x29; FROM pilaga_tmp.d_progra pa WHERE p.codigo_prg &#x3d; pa.codigo_prg&#x29;&#xa;&#x29;&#xa;LEFT OUTER JOIN pilaga_tmp.d_subpro AS s ON&#xa;&#x28;&#xa;  d.codigo_prg &#x3d; s.codigo_prg AND &#xa;  d.codigo_sub &#x3d; s.codigo_sub AND &#xa;  s.anio &#x3d; &#x28;SELECT max&#x28;anio&#x29; FROM pilaga_tmp.d_subpro sa WHERE  p.codigo_prg &#x3d; sa.codigo_prg AND&#xa;							s.codigo_sub &#x3d; sa.codigo_sub&#x29;&#xa;&#x29;&#xa;LEFT OUTER JOIN pilaga_tmp.d_proyec AS r ON&#xa;&#x28;&#xa;  d.codigo_prg &#x3d; r.codigo_prg AND &#xa;  d.codigo_sub &#x3d; r.codigo_sub AND &#xa;  d.codigo_pry &#x3d; r.codigo_pry AND &#xa;  r.anio &#x3d; &#x28;SELECT max&#x28;anio&#x29; FROM pilaga_tmp.d_proyec ra WHERE  p.codigo_prg &#x3d; ra.codigo_prg AND&#xa;							s.codigo_sub &#x3d; ra.codigo_sub AND&#xa;							r.codigo_pry &#x3d; ra.codigo_pry&#x29;&#xa;&#x29;&#xa;LEFT OUTER JOIN pilaga_tmp.d_activi AS a ON&#xa;&#x28;&#xa;  d.codigo_prg &#x3d; a.codigo_prg AND &#xa;  d.codigo_sub &#x3d; a.codigo_sub AND &#xa;  d.codigo_pry &#x3d; a.codigo_pry AND &#xa;  d.codigo_act &#x3d; a.codigo_act AND &#xa;  a.anio &#x3d; &#x28;SELECT max&#x28;anio&#x29; FROM pilaga_tmp.d_activi aa WHERE  p.codigo_prg &#x3d; aa.codigo_prg AND&#xa;							s.codigo_sub &#x3d; aa.codigo_sub AND&#xa;							r.codigo_pry &#x3d; aa.codigo_pry AND&#xa;							a.codigo_act &#x3d; aa.codigo_act&#x29;&#xa;&#x29;&#xa;LEFT OUTER JOIN pilaga_tmp.d_obra AS o ON&#xa;&#x28;&#xa;  d.codigo_prg &#x3d; o.codigo_prg AND &#xa;  d.codigo_sub &#x3d; o.codigo_sub AND &#xa;  d.codigo_pry &#x3d; o.codigo_pry AND &#xa;  d.codigo_act &#x3d; o.codigo_act AND &#xa;  d.codigo_obr &#x3d; o.codigo_obr AND&#xa;  o.anio &#x3d; &#x28;SELECT max&#x28;anio&#x29; FROM pilaga_tmp.d_obra oa WHERE  p.codigo_prg &#x3d; oa.codigo_prg AND&#xa;							s.codigo_sub &#x3d; oa.codigo_sub AND&#xa;							r.codigo_pry &#x3d; oa.codigo_pry AND&#xa;							a.codigo_act &#x3d; oa.codigo_act AND&#xa;							o.codigo_obr &#x3d; oa.codigo_obr&#x29;&#xa;&#x29;&#xa;WHERE&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_prg&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_sub&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_pry&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_act&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_obr&#x3a;&#x3a;text,2&#x29;&#xa;NOT IN &#x28;SELECT red_programatica_codigo FROM pilaga.d_red_programatica&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_red_programatica ALTER COLUMN red_programatica_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_cubos_seq&#x3b;&#xa;&#xa;-- d_tipo_documento&#xa;CREATE SEQUENCE id_cubos_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_cubos_seq&#x27;, &#x28;SELECT COALESCE&#x28;max&#x28;tipo_documento_id&#x29;&#x2b;1,1&#x29; FROM pilaga.d_tipo_documento&#x29;&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_tipo_documento ALTER COLUMN tipo_documento_id SET DEFAULT nextval&#x28;&#x27;id_cubos_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;&#xa;INSERT INTO pilaga.d_tipo_documento &#x28;tipo_documento_codigo, tipo_documento_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;	SELECT DISTINCT tipcom, tipcom, now&#x28;&#x29;&#x3a;&#x3a;date as fecha_desde,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date as fecha_hasta,1 as version,&#x27;Y&#x27; as vigente, now&#x28;&#x29; as fecha_actualizacion &#xa;	FROM pilaga_tmp.d_liquid&#xa;	WHERE tipcom NOT IN &#x28;SELECT tipo_documento_codigo FROM pilaga.d_tipo_documento&#x29;&#x3b; &#xa;&#xa;INSERT INTO pilaga.d_tipo_documento &#x28;tipo_documento_codigo, tipo_documento_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;	SELECT DISTINCT tipo, tipo, now&#x28;&#x29;&#x3a;&#x3a;date as fecha_desde,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date as fecha_hasta,1 as version,&#x27;Y&#x27; as vigente, now&#x28;&#x29; as fecha_actualizacion &#xa;	FROM pilaga_tmp.d_cabpre&#xa;	WHERE tipo NOT IN &#x28;SELECT tipo_documento_codigo FROM pilaga.d_tipo_documento&#x29;&#x3b; &#xa;&#xa;INSERT INTO pilaga.d_tipo_documento &#x28;tipo_documento_codigo, tipo_documento_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;	SELECT DISTINCT tipo, tipo , now&#x28;&#x29;&#x3a;&#x3a;date as fecha_desde,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date as fecha_hasta,1 as version,&#x27;Y&#x27; as vigente, now&#x28;&#x29; as fecha_actualizacion &#xa;	FROM pilaga_tmp.d_cabcom&#xa;	WHERE tipo NOT IN &#x28;SELECT tipo_documento_codigo FROM pilaga.d_tipo_documento&#x29;&#x3b; &#xa;&#xa;ALTER TABLE pilaga.d_tipo_documento ALTER COLUMN tipo_documento_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_cubos_seq&#x3b;&#xa;&#xa;-- d_unidad_presupuestaria&#xa;CREATE SEQUENCE id_cubos_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_cubos_seq&#x27;, &#x28;SELECT COALESCE&#x28;max&#x28;unidad_presupuestaria_id&#x29;&#x2b;1,1&#x29; FROM pilaga.d_unidad_presupuestaria&#x29;&#x29;&#x3b;&#xa;ALTER TABLE pilaga.d_unidad_presupuestaria ALTER COLUMN unidad_presupuestaria_id SET DEFAULT nextval&#x28;&#x27;id_cubos_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;&#xa;INSERT INTO pilaga.d_unidad_presupuestaria &#x28;unidad_presupuestaria_codigo, unidad_presupuestaria_desc, subunidad_presupuestaria_desc, &#xa;  subsubunidad_presupuestaria_desc, unidad_presupuestaria_combo_desc, fecha_desde, fecha_hasta,version, vigente, fecha_actualizacion&#x29;&#xa;SELECT &#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; right&#x28;&#x27;00&#x27; &#x7c;&#x7c; subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.000&#x27; AS unidad_presupuestaria_codigo,&#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c;&#xa;  &#x28;SELECT nombre FROM pilaga_tmp.d_depcia du WHERE d.anio&#x3d;du.anio AND d.coddep&#x3d;du.coddep AND du.coddep&#x3d;du.codpre AND&#xa;						du.subdep&#x3d;du.subpre AND du.subdep&#x3d;0&#x29;&#xa;     AS unidad_presupuestaria_desc,&#xa;  CASE WHEN subdep &#x3d; 0 THEN &#x27;000 - SIN SUBUNIDAD&#x27;&#xa;    ELSE right&#x28;&#x27;00&#x27; &#x7c;&#x7c; subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nombre&#xa;  END AS subunidad_presupuestaria_desc,&#xa;  &#x27;000 - SIN SUBSUBUNIDAD&#x27; AS subsubunidad_presupuestaria_desc,&#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; right&#x28;&#x27;00&#x27; &#x7c;&#x7c; subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.000 - &#x27; &#x7c;&#x7c;&#xa;  &#x28;SELECT nombre FROM pilaga_tmp.d_depcia du WHERE d.anio&#x3d;du.anio AND d.coddep&#x3d;du.coddep AND du.coddep&#x3d;du.codpre AND&#xa;						du.subdep&#x3d;du.subpre AND du.subdep&#x3d;0&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c;   &#xa;  CASE WHEN subdep &#x3d; 0 THEN &#x27;SIN SUBUNIDAD&#x27;&#xa;    ELSE nombre&#xa;  END &#x7c;&#x7c; &#x27; - SIN SUBSUBUNIDAD&#x27;&#xa;  AS unidad_presupuestaria_combo_desc,&#xa;  now&#x28;&#x29;&#x3a;&#x3a;date as fecha_desde,&#xa;  &#x27;2199-12-31&#x27;&#x3a;&#x3a;date as fecha_hasta,&#xa;  1 as version,&#xa;  &#x27;Y&#x27; as vigente,&#xa;  now&#x28;&#x29; as fecha_actualizacion&#xa;FROM pilaga_tmp.d_depcia d&#xa;WHERE coddep&#x3d;codpre AND subdep&#x3d;subpre AND&#xa;  anio IN &#x28;SELECT max&#x28;anio&#x29; FROM pilaga_tmp.d_depcia da WHERE d.coddep&#x3d;da.coddep AND d.subdep&#x3d;da.subdep&#x29; AND&#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; right&#x28;&#x27;00&#x27; &#x7c;&#x7c; subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.000&#x27; NOT IN &#x28;SELECT unidad_presupuestaria_codigo FROM pilaga.d_unidad_presupuestaria&#x29;&#x3b; &#xa;  &#xa;ALTER TABLE pilaga.d_unidad_presupuestaria ALTER COLUMN unidad_presupuestaria_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_cubos_seq&#x3b;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dw</connection>
