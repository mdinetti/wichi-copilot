    <entry>
      <name>crear tablas tmp portal</name>
      <description/>
      <type>SQL</type>
      <sql>CREATE TABLE IF NOT EXISTS pilaga_tmp.d_activi&#xa;&#x28;&#xa;  anio numeric&#x28;4,0&#x29; NOT NULL,&#xa;  codigo_prg numeric&#x28;2,0&#x29; NOT NULL,&#xa;  codigo_sub numeric&#x28;2,0&#x29; NOT NULL,&#xa;  codigo_pry numeric&#x28;2,0&#x29; NOT NULL,&#xa;  codigo_act numeric&#x28;2,0&#x29; NOT NULL,&#xa;  nom_activ character varying&#x28;50&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS pilaga_tmp.d_benef&#xa;&#x28;&#xa;  tipdoc numeric&#x28;1,0&#x29; NOT NULL,&#xa;  cuit1 numeric&#x28;2,0&#x29; NOT NULL,&#xa;  nrodoc character varying&#x28;20&#x29; NOT NULL,&#xa;  cuit2 numeric&#x28;1,0&#x29; NOT NULL,&#xa;  nombre character varying&#x28;35&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS pilaga_tmp.d_cabcom&#xa;&#x28;&#xa;  tipo character varying&#x28;4&#x29; NOT NULL,&#xa;  anio numeric&#x28;4,0&#x29; NOT NULL,&#xa;  numero character varying&#x28;30&#x29; NOT NULL,&#xa;  anicomp numeric&#x28;4,0&#x29; NOT NULL,&#xa;  nup character varying&#x28;30&#x29; NOT NULL,&#xa;  exp character varying&#x28;40&#x29;,&#xa;  anprev numeric&#x28;4,0&#x29; NOT NULL,&#xa;  coddep numeric&#x28;3,0&#x29; NOT NULL,&#xa;  subdep numeric&#x28;3,0&#x29; NOT NULL,&#xa;  tipdoc numeric&#x28;1,0&#x29;,&#xa;  cuit1 numeric&#x28;2,0&#x29;,&#xa;  nrodoc character varying&#x28;20&#x29;,&#xa;  cuit2 numeric&#x28;1,0&#x29;,&#xa;  concepto character varying&#x28;40&#x29;,&#xa;  tipoprev character varying&#x28;4&#x29; NOT NULL DEFAULT &#x27;NUI&#x27;&#x3a;&#x3a;character varying&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS pilaga_tmp.d_cabpre&#xa;&#x28;&#xa;  anio numeric&#x28;4,0&#x29; NOT NULL,&#xa;  numero character varying&#x28;30&#x29; NOT NULL,&#xa;  anprev numeric&#x28;4,0&#x29; NOT NULL,&#xa;  exp character varying&#x28;40&#x29;,&#xa;  coddep numeric&#x28;3,0&#x29; NOT NULL,&#xa;  subdep numeric&#x28;3,0&#x29; NOT NULL,&#xa;  concepto character varying&#x28;40&#x29;,&#xa;  tippre character varying&#x28;3&#x29;,&#xa;  tipo character varying&#x28;4&#x29; NOT NULL DEFAULT &#x27;NUI&#x27;&#x3a;&#x3a;character varying&#xa;&#x29;&#x3b;&#xa;&#xa;&#xa;CREATE TABLE IF NOT EXISTS pilaga_tmp.d_codepa&#xa;&#x28;&#xa;  anio numeric&#x28;4,0&#x29; NOT NULL,&#xa;  d_codepa serial NOT NULL,&#xa;  codigo_prg numeric&#x28;2,0&#x29; NOT NULL,&#xa;  coddep numeric&#x28;3,0&#x29; NOT NULL,&#xa;  codigo_sub numeric&#x28;2,0&#x29; NOT NULL,&#xa;  subdep numeric&#x28;3,0&#x29; NOT NULL,&#xa;  codigo_pry numeric&#x28;2,0&#x29; NOT NULL,&#xa;  codigo_fue numeric&#x28;2,0&#x29; NOT NULL,&#xa;  codigo_inc numeric&#x28;1,0&#x29; NOT NULL,&#xa;  codigo_ppl numeric&#x28;1,0&#x29; NOT NULL,&#xa;  codigo_ppr numeric&#x28;1,0&#x29; NOT NULL,&#xa;  codigo_act numeric&#x28;2,0&#x29; NOT NULL,&#xa;  codigo_obr numeric&#x28;2,0&#x29;,&#xa;  codigo_fin numeric&#x28;1,0&#x29; NOT NULL,&#xa;  codigo_fun numeric&#x28;1,0&#x29; NOT NULL,&#xa;  mes numeric&#x28;2,0&#x29; NOT NULL,&#xa;  comprom numeric&#x28;12,2&#x29;,&#xa;  devengado numeric&#x28;12,2&#x29;,&#xa;  pagado numeric&#x28;12,2&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS pilaga_tmp.d_coning&#xa;&#x28;&#xa;  anio numeric&#x28;4,0&#x29; NOT NULL,&#xa;  codigo_con character varying&#x28;20&#x29; NOT NULL,&#xa;  nombre character varying&#x28;120&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS pilaga_tmp.d_depcia&#xa;&#x28;&#xa;  anio numeric&#x28;4,0&#x29; NOT NULL,&#xa;  coddep numeric&#x28;3,0&#x29; NOT NULL,&#xa;  subdep numeric&#x28;3,0&#x29; NOT NULL,&#xa;  codpre numeric&#x28;3,0&#x29;,&#xa;  subpre numeric&#x28;3,0&#x29;,&#xa;  clase character varying&#x28;1&#x29;,&#xa;  nombre character varying&#x28;50&#x29;,&#xa;  doc1 character varying&#x28;20&#x29;,&#xa;  respon character varying&#x28;40&#x29;,&#xa;  saldo numeric&#x28;12,2&#x29;,&#xa;  estado character varying&#x28;1&#x29;,&#xa;  est_via character varying&#x28;1&#x29;,&#xa;  debe numeric&#x28;12,2&#x29;,&#xa;  haber numeric&#x28;12,2&#x29;,&#xa;  salfin numeric&#x28;12,2&#x29;,&#xa;  preventivo numeric&#x28