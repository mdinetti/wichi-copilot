    <entry>
      <name>temporal &#x28;mig_ft_movimientos&#x29;</name>
      <description/>
      <type>SQL</type>
      <sql>-- ft_movimientos&#xa;-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;-- CREDITO ORIGINAL Y MODIFICATORIO&#xa;-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;DROP TABLE IF EXISTS pilaga_tmp.mig_ft_movimientos&#x3b;&#xa;SELECT &#xa;  d_salcre AS id_tabla,&#xa;  &#x27;&#x27;&#x3a;&#x3a;text as tipo,&#xa;  anio AS anio_id, &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_id, 0 AS red_programatica_id, 0 AS grupo_presupuestario_id, 0 AS codigo_economico_id, 0 AS unidad_presupuestaria_id,&#xa;  0 AS unidad_gestion_id, 0 AS finalidad_funcion_id, 0 AS moneda_id, 0 AS fondo_id, 0 AS tercero_id, 0 AS fuente_id,&#xa;  0 AS circuito_gestion_id, 0 AS objeto_del_gasto_id, 0 AS expediente_id, 0 AS concepto_id, 0 AS documento_principal_id,&#xa;  0 AS tipo_persona_id, 0 AS persona_id, 0 AS persona_comprobante_id, 0 AS comprobante_id, 0 AS contribuyente_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_vencimiento_id, 0 AS nivel_autorizacion_id, 0 AS estado_liquidacion_id, &#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_valor_id, 0 AS unidad_generica_id, 0 AS etapa_presupuestaria_id, 0 AS tipo_documento_id,&#xa;  0 AS documento_preventivo_id, 0 AS documento_compromiso_id, 0 AS documento_devengado_id, 0 AS documento_pagado_id,&#xa;  0 AS documento_devengado_ingreso_id, 0 AS documento_cobrado_id, 0 AS cuenta_tesoreria_id, 0 AS cuenta_bancaria_id,&#xa;  0 AS banco_sucursal_id, 0 AS rubro_ingreso_id, 0 AS concepto_ingreso_id, 0 AS tipo_operacion_id, mes AS mes_id,&#xa;  cred_orig AS credito_original,&#xa;  0.0 AS credito_modificatorio,&#xa;  cred_orig AS credito, -- Ver si corresponde dejarlo o es una medida calculada&#xa;  0.0 AS preventivo,&#xa;  0.0 AS compromiso,&#xa;  0.0 AS devengado,&#xa;  0.0 AS pagado,&#xa;  0.0 AS retenciones,&#xa;  0.0 AS disponibilidades,&#xa;  0.0 AS previsto_de_ingreso,&#xa;  0.0 AS estimado_de_ingreso,&#xa;  0.0 AS devengado_de_ingreso,&#xa;  0.0 AS cobrado,&#xa;  &#x27;COM&#x27;&#x3a;&#x3a;text as etapa_migracion  &#xa;INTO pilaga_tmp.mig_ft_movimientos&#xa; FROM pilaga_tmp.d_salcre&#xa; WHERE cred_orig&#x3c;&#x3e;0&#x3b;&#xa;&#xa;INSERT INTO pilaga_tmp.mig_ft_movimientos&#xa;SELECT &#xa;  d_salcre AS id_tabla,&#xa;  &#x27;&#x27;&#x3a;&#x3a;text as tipo,&#xa;  anio AS anio_id, &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_id, 0 AS red_programatica_id, 0 AS grupo_presupuestario_id, 0 AS codigo_economico_id, 0 AS unidad_presupuestaria_id,&#xa;  0 AS unidad_gestion_id, 0 AS finalidad_funcion_id, 0 AS moneda_id, 0 AS fondo_id, 0 AS tercero_id, 0 AS fuente_id,&#xa;  0 AS circuito_gestion_id, 0 AS objeto_del_gasto_id, 0 AS expediente_id, 0 AS concepto_id, 0 AS documento_id,&#xa;  0 AS tipo_persona_id, 0 AS persona_id, 0 AS persona_comprobante_id, 0 AS comprobante_id, 0 AS contribuyente_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_vencimiento_id, 0 AS nivel_autorizacion_id, 0 AS estado_liquidacion_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_valor_id, 0 AS unidad_generica_id, 0 AS etapa_presupuestaria_id, 0 AS tipo_documento_id,&#xa;  0 AS documento_preventivo_id, 0 AS documento_compromiso_id, 0 AS documento_devengado_id, 0 AS documento_pagado_id,&#xa;  0 AS documento_devengado_ingreso_id, 0 AS documento_cobrado_id, 0 AS cuenta_tesoreria_id, 0 AS cuenta_bancaria_id,&#xa;  0 AS banco_sucursal_id, 0 AS rubro_ingreso_id, 0 AS concepto_ingreso_id, 0 AS tipo_operacion_id, mes AS mes_id,&#xa;  0.0 AS credito_original,&#xa;  cred_mod AS credito_modificatorio,&#xa;  cred_mod AS credito, -- Ver si corresponde dejarlo o es una medida calculada&#xa;  0.0 AS preventivo,&#xa;  0.0 AS compromiso,&#xa;  0.0 AS devengado,&#xa;  0.0 AS pagado,&#xa;  0.0 AS retenciones,&#xa;  0.0 AS disponibilidades,&#xa;  0.0 AS previsto_de_ingreso,&#xa;  0.0 AS estimado_de_ingreso,&#xa;  0.0 AS devengado_de_ingreso,&#xa;  0.0 AS cobrado,&#xa;  &#x27;COM&#x27;&#x3a;&#x3a;text as etapa_migracion--Credito original y modificatorio&#xa; FROM pilaga_tmp.d_salcre&#xa; WHERE cred_mod&#x3c;&#x3e;0&#x3b;&#xa;&#xa;INSERT INTO pilaga_tmp.mig_ft_movimientos&#xa;SELECT &#xa;  d_salcre AS id_tabla,&#xa;  &#x27;&#x27;&#x3a;&#x3a;text as tipo,&#xa;  anio AS anio_id, &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_id, 0 AS red_programatica_id, 0 AS grupo_presupuestario_id, 0 AS codigo_economico_id, 0 AS unidad_presupuestaria_id,&#xa;  0 AS unidad_gestion_id, 0 AS finalidad_funcion_id, 0 AS moneda_id, 0 AS fondo_id, 0 AS tercero_id, 0 AS fuente_id,&#xa;  0 AS circuito_gestion_id, 0 AS objeto_del_gasto_id, 0 AS expediente_id, 0 AS concepto_id, 0 AS documento_id,&#xa;  0 AS tipo_persona_id, 0 AS persona_id, 0 AS persona_comprobante_id, 0 AS comprobante_id, 0 AS contribuyente_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_vencimiento_id, 0 AS nivel_autorizacion_id, 0 AS estado_liquidacion_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_valor_id, 0 AS unidad_generica_id, 0 AS etapa_presupuestaria_id, 0 AS tipo_documento_id,&#xa;  0 AS documento_preventivo_id, 0 AS documento_compromiso_id, 0 AS documento_devengado_id, 0 AS documento_pagado_id,&#xa;  0 AS documento_devengado_ingreso_id, 0 AS documento_cobrado_id, 0 AS cuenta_tesoreria_id, 0 AS cuenta_bancaria_id,&#xa;  0 AS banco_sucursal_id, 0 AS rubro_ingreso_id, 0 AS concepto_ingreso_id, 0 AS tipo_operacion_id, mes AS mes_id,&#xa;  0.0 AS credito_original,&#xa;  fdo_uni AS credito_modificatorio,&#xa;  fdo_uni AS credito, -- Ver si corresponde dejarlo o es una medida calculada&#xa;  0.0 AS preventivo,&#xa;  0.0 AS compromiso,&#xa;  0.0 AS devengado,&#xa;  0.0 AS pagado,&#xa;  0.0 AS retenciones,&#xa;  0.0 AS disponibilidades,&#xa;  0.0 AS previsto_de_ingreso,&#xa;  0.0 AS estimado_de_ingreso,&#xa;  0.0 AS devengado_de_ingreso,&#xa;  0.0 AS cobrado,&#xa;  &#x27;COM&#x27;&#x3a;&#x3a;text as etapa_migracion--Credito original y modificatorio&#xa; FROM pilaga_tmp.d_salcre&#xa; WHERE fdo_uni&#x3c;&#x3e;0&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos &#xa;SET fecha_id &#x3d; COALESCE&#x28;&#x28;SELECT &#x28;anio&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; mes&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date FROM pilaga_tmp.d_salcre WHERE id_tabla&#x3d;d_salcre&#x29;,&#x27;1900-01-01&#x27;&#x3a;&#x3a;date&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa; &#xa;UPDATE pilaga_tmp.mig_ft_movimientos &#xa;SET fecha_valor_id &#x3d; COALESCE&#x28;&#x28;SELECT &#x28;anio&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; mes&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date FROM pilaga_tmp.d_salcre WHERE id_tabla&#x3d;d_salcre&#x29;,&#x27;1900-01-01&#x27;&#x3a;&#x3a;date&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa; SET red_programatica_id &#x3d; COALESCE&#x28;&#x28;SELECT rp.red_programatica_id FROM pilaga.d_red_programatica rp, pilaga_tmp.d_salcre d&#xa; WHERE id_tabla&#x3d;d.d_salcre AND&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_prg&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_sub&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_pry&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_act&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_obr&#x3a;&#x3a;text,2&#x29; &#x3d; rp.red_programatica_codigo&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa; &#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa; SET grupo_presupuestario_id &#x3d; COALESCE&#x28;&#x28;SELECT grupo_presupuestario_id FROM pilaga.d_grupo_presupuestario WHERE grupo_presupuestario_codigo&#x3d;&#x27;0001&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa; SET unidad_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT up.unidad_presupuestaria_id FROM pilaga.d_unidad_presupuestaria up, pilaga_tmp.d_salcre d&#xa; WHERE id_tabla&#x3d;d.d_salcre AND&#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.000&#x27; &#x3d; up.unidad_presupuestaria_codigo&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa; SET finalidad_funcion_id &#x3d; COALESCE&#x28;&#x28;SELECT f.finalidad_funcion_id FROM pilaga.d_finalidad_funcion f, pilaga_tmp.d_salcre d &#xa;	WHERE id_tabla&#x3d;d.d_salcre AND f.finalidad_codigo&#x3d;d.codigo_fin AND f.funcion_codigo&#x3d;d.codigo_fun&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa; SET moneda_id &#x3d; COALESCE&#x28;&#x28;SELECT m.moneda_id FROM pilaga.d_moneda m WHERE m.moneda_codigo&#x3d;&#x27;1&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos SET fondo_id &#x3d; &#x28;SELECT fondo_id FROM pilaga.d_fondo WHERE fondo_desc &#x3d; &#x27;Presupuestario&#x27;&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET fuente_id &#x3d; COALESCE&#x28;&#x28;SELECT f.fuente_id FROM pilaga.d_fuente f, pilaga_tmp.d_salcre d WHERE id_tabla&#x3d;d.d_salcre AND f.fuente_codigo&#x3d;d.codigo_fue&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET circuito_gestion_id &#x3d; COALESCE&#x28;&#x28;SELECT cg.circuito_gestion_id FROM pilaga.d_circuito_gestion cg WHERE cg.circuito_gestion_codigo&#x3d;&#x27;CRED&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa; &#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET objeto_del_gasto_id &#x3d; COALESCE&#x28;&#x28;SELECT og.objeto_del_gasto_id FROM pilaga.d_objeto_del_gasto og, pilaga_tmp.d_salcre d WHERE id_tabla&#x3d;d.d_salcre AND&#xa;  og.objeto_del_gasto_codigo&#x3d;codigo_inc&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; codigo_ppl &#x7c;&#x7c; &#x27;.0.0000&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET expediente_id &#x3d; COALESCE&#x28;&#x28;SELECT e.expediente_id FROM pilaga.d_expediente e WHERE e.expediente_desc&#x3d;&#x27;VACIO&#x2f;NULO&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET etapa_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT e.etapa_presupuestaria_id FROM pilaga.d_etapa_presupuestaria e WHERE e.etapa_presupuestaria_codigo&#x3d;&#x27;CR&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET tipo_operacion_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_operacion_id FROM pilaga.d_tipo_operacion t WHERE t.tipo_operacion_codigo&#x3d;&#x27;CRED&#x27;&#x29;,0&#x29;&#xa;WHERE credito_original&#x3c;&#x3e;0 AND etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET tipo_operacion_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_operacion_id FROM pilaga.d_tipo_operacion t WHERE t.tipo_operacion_codigo&#x3d;&#x27;CREM&#x27;&#x29;,0&#x29;&#xa;WHERE credito_modificatorio&#x3c;&#x3e;0 AND etapa_migracion &#x3d; &#x27;COM&#x27;&#x3b;&#xa;&#xa;-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;-- PREVENTIVO&#xa;-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;INSERT INTO pilaga_tmp.mig_ft_movimientos&#xa;SELECT &#xa;  d_detpre AS id_tabla,&#xa;  c.tipo AS tipo,&#xa;  d.anio AS anio_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_id,&#xa;  0 AS red_programatica_id,&#xa;  0 AS grupo_presupuestario_id,&#xa;  0 AS codigo_economico_id,&#xa;  0 AS unidad_presupuestaria_id,&#xa;  0 AS unidad_gestion_id,&#xa;  0 AS finalidad_funcion_id,&#xa;  0 AS moneda_id,&#xa;  0 AS fondo_id,&#xa;  0 AS tercero_id,&#xa;  0 AS fuente_id,&#xa;  0 AS circuito_gestion_id,&#xa;  0 AS objeto_del_gasto_id,&#xa;  0 AS expediente_id,&#xa;  0 AS concepto_id,&#xa;  0 AS documento_id,&#xa;  0 AS tipo_persona_id,&#xa;  0 AS persona_id,&#xa;  0 AS persona_comprobante_id,&#xa;  0 AS comprobante_id,&#xa;  0 AS contribuyente_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_vencimiento_id,&#xa;  0 AS nivel_autorizacion_id,&#xa;  0 AS estado_liquidacion_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_valor_id,&#xa;  0 AS unidad_generica_id,&#xa;  0 AS etapa_presupuestaria_id,&#xa;  0 AS tipo_documento_id,&#xa;  0 AS documento_preventivo_id,&#xa;  0 AS documento_compromiso_id,&#xa;  0 AS documento_devengado_id,&#xa;  0 AS documento_pagado_id,&#xa;  0 AS documento_devengado_ingreso_id,&#xa;  0 AS documento_cobrado_id,&#xa;  0 AS cuenta_tesoreria_id,&#xa;  0 AS cuenta_bancaria_id,&#xa;  0 AS banco_sucursal_id,&#xa;  0 AS rubro_ingreso_id,&#xa;  0 AS concepto_ingreso_id,&#xa;  0 AS tipo_operacion_id,&#xa;  0 AS mes_id,&#xa;  0.0 AS credito_original,&#xa;  0.0 AS credito_modificatorio,&#xa;  0.0 AS credito, -- Ver si corresponde dejarlo o es una medida calculada&#xa;  preventivo AS preventivo,&#xa;  0.0 AS compromiso,&#xa;  0.0 AS devengado,&#xa;  0.0 AS pagado,&#xa;  0.0 AS retenciones,&#xa;  0.0 AS disponibilidades,&#xa;  0.0 AS previsto_de_ingreso,&#xa;  0.0 AS estimado_de_ingreso,&#xa;  0.0 AS devengado_de_ingreso,&#xa;  0.0 AS cobrado,&#xa;  &#x27;PRE&#x27;&#x3a;&#x3a;text as etapa_migracion --Preventivo&#xa;FROM pilaga_tmp.d_detpre d, pilaga_tmp.d_cabpre c &#xa;WHERE d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND d.anprev&#x3d;c.anprev AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep&#x3b;&#xa;&#xa;-- TODO&#x3a; el valor del mes esta mal calculado, en realidad no encontramos la forma de obtenerlo &#x28;o tenemos el mes o el numero de documento&#x29;&#xa;-- creemos que el dato real del mes no es obtenible.&#xa;UPDATE pilaga_tmp.mig_ft_movimientos &#xa;SET mes_id &#x3d; COALESCE&#x28;&#x28;select avg&#x28;c.mes&#x29;&#x3a;&#x3a;integer from pilaga_tmp.d_detpre p, pilaga_tmp.d_salcre c&#xa;		WHERE id_tabla &#x3d; p.d_detpre AND&#xa;			p.anio&#x3d;c.anio and p.coddep&#x3d;c.coddep and p.subdep&#x3d;c.subdep and p.codigo_fue&#x3d;c.codigo_fue and p.codigo_prg&#x3d;c.codigo_prg &#xa;			and p.codigo_sub&#x3d;c.codigo_sub and p.codigo_pry&#x3d;c.codigo_pry and p.codigo_inc&#x3d;c.codigo_inc and p.codigo_act&#x3d;c.codigo_act&#xa;			and p.codigo_obr&#x3d;c.codigo_obr and p.codigo_ppl&#x3d;c.codigo_ppl and p.preventivo&#x3c;&#x3d;c.cred_prev and c.cred_prev&#x3c;&#x3e;0&#x29;,1&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos &#xa;SET fecha_id &#x3d; COALESCE&#x28;&#x28;SELECT &#x28;anio_id&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; mes_id&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date&#x29;,&#x27;1900-01-01&#x27;&#x3a;&#x3a;date&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos &#xa;SET fecha_valor_id &#x3d; COALESCE&#x28;&#x28;SELECT &#x28;anio_id&#x3a;&#x3a;text  &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; mes_id&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date&#x29;,&#x27;1900-01-01&#x27;&#x3a;&#x3a;date&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET red_programatica_id &#x3d; COALESCE&#x28;&#x28;SELECT rp.red_programatica_id FROM pilaga.d_red_programatica rp, pilaga_tmp.d_detpre d&#xa;WHERE id_tabla&#x3d;d.d_detpre AND&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_prg&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_sub&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_pry&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_act&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_obr&#x3a;&#x3a;text,2&#x29; &#x3d; rp.red_programatica_codigo&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET grupo_presupuestario_id &#x3d; COALESCE&#x28;&#x28;SELECT grupo_presupuestario_id FROM pilaga.d_grupo_presupuestario WHERE grupo_presupuestario_codigo&#x3d;&#x27;0001&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET unidad_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT up.unidad_presupuestaria_id FROM pilaga.d_unidad_presupuestaria up, pilaga_tmp.d_detpre d&#xa;WHERE id_tabla&#x3d;d.d_detpre AND&#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.000&#x27; &#x3d; up.unidad_presupuestaria_codigo&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;-- TODO&#x3a; Hay un 10&#x25; de las funciones que quedaron mal asignadas ya que hay dos candidatas y se selecciono una &#x28;la de codigo minimo&#x29;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET finalidad_funcion_id &#x3d; COALESCE&#x28;&#x28;SELECT f.finalidad_funcion_id FROM pilaga.d_finalidad_funcion f&#xa;	WHERE f.finalidad_codigo&#x3d;3 AND f.funcion_codigo&#x3d;&#xa;						&#x28;SELECT min&#x28;c.codigo_fun&#x29;&#x3a;&#x3a;integer from pilaga_tmp.d_detpre p, pilaga_tmp.d_salcre c&#xa;							WHERE id_tabla &#x3d; p.d_detpre AND&#xa;								p.anio&#x3d;c.anio and p.coddep&#x3d;c.coddep and p.subdep&#x3d;c.subdep and &#xa;								p.codigo_fue&#x3d;c.codigo_fue and p.codigo_prg&#x3d;c.codigo_prg and &#xa;								p.codigo_sub&#x3d;c.codigo_sub and p.codigo_pry&#x3d;c.codigo_pry and&#xa;								p.codigo_inc&#x3d;c.codigo_inc and p.codigo_act&#x3d;c.codigo_act and&#xa;								p.codigo_obr&#x3d;c.codigo_obr and p.codigo_ppl&#x3d;c.codigo_ppl and &#xa;								p.preventivo&#x3c;&#x3d;c.cred_prev and c.cred_prev&#x3c;&#x3e;0&#x29;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET moneda_id &#x3d; COALESCE&#x28;&#x28;SELECT m.moneda_id FROM pilaga.d_moneda m WHERE m.moneda_codigo&#x3d;&#x27;1&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos SET fondo_id &#x3d; &#x28;SELECT fondo_id FROM pilaga.d_fondo WHERE fondo_desc &#x3d; &#x27;Presupuestario&#x27;&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET fuente_id &#x3d; COALESCE&#x28;&#x28;SELECT f.fuente_id FROM pilaga.d_fuente f, pilaga_tmp.d_detpre d WHERE id_tabla&#x3d;d.d_detpre AND f.fuente_codigo&#x3d;d.codigo_fue&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET circuito_gestion_id &#x3d; COALESCE&#x28;&#x28;SELECT cg.circuito_gestion_id FROM pilaga.d_circuito_gestion cg WHERE cg.circuito_gestion_codigo&#x3d;&#x27;GBAS&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET objeto_del_gasto_id &#x3d; COALESCE&#x28;&#x28;SELECT og.objeto_del_gasto_id FROM pilaga.d_objeto_del_gasto og, pilaga_tmp.d_detpre d WHERE id_tabla&#x3d;d.d_detpre AND&#xa;  og.objeto_del_gasto_codigo&#x3d;codigo_inc&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; codigo_ppl &#x7c;&#x7c; &#x27;.0.0000&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET expediente_id &#x3d; COALESCE&#x28;&#x28;SELECT e.expediente_id&#xa;			FROM pilaga.d_expediente e &#xa;			WHERE e.expediente_desc&#x3d;COALESCE&#x28;&#x28;SELECT &#x27;EXP - &#x27; &#x7c;&#x7c; exp &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;varchar FROM pilaga_tmp.d_cabpre c, pilaga_tmp.d_detpre d&#xa;							WHERE id_tabla&#x3d;d.d_detpre AND &#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND&#xa;							d.anprev&#x3d;c.anprev AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;							exp is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET etapa_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT e.etapa_presupuestaria_id FROM pilaga.d_etapa_presupuestaria e WHERE e.etapa_presupuestaria_codigo&#x3d;&#x27;PR&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET tipo_operacion_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_operacion_id FROM pilaga.d_tipo_operacion t WHERE t.tipo_operacion_codigo&#x3d;&#x27;CPRE&#x27;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET concepto_id &#x3d; COALESCE&#x28;&#x28;SELECT c.concepto_id&#xa;			FROM pilaga.d_concepto c &#xa;			WHERE c.concepto_desc&#x3d;COALESCE&#x28;&#x28;SELECT c.concepto FROM pilaga_tmp.d_cabpre c, pilaga_tmp.d_detpre d&#xa;							WHERE id_tabla&#x3d;d.d_detpre AND &#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND&#xa;							d.anprev&#x3d;c.anprev AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;							c.concepto is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET documento_principal_id &#x3d; COALESCE&#x28;&#x28;SELECT d.documento_principal_id&#xa;			FROM pilaga.d_documento_principal d &#xa;			WHERE d.documento_principal_codigo&#x3d;&#xa;				COALESCE&#x28;&#x28;SELECT c.tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text  &#xa;						FROM pilaga_tmp.d_cabpre c, pilaga_tmp.d_detpre d&#xa;							WHERE id_tabla&#x3d;d.d_detpre AND &#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND&#xa;							d.anprev&#x3d;c.anprev AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;						&#x28;c.tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text&#x29; is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos SET documento_preventivo_id &#x3d; COALESCE&#x28;documento_principal_id,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos&#xa;SET tipo_documento_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_documento_id FROM pilaga.d_tipo_documento t WHERE t.tipo_documento_codigo &#x3d; tipo&#x29;,0&#x29;&#xa;WHERE etapa_migracion &#x3d; &#x27;PRE&#x27;&#x3b;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
