    <entry>
      <name>VACUUM</name>
      <description/>
      <type>SQL</type>
      <sql>VACUUM FULL ANALYSE pilaga_tmp.d_liquid&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_cabpre&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_cabcom&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_coning&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_benef&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.c_tipdoc&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_salcre&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_progra&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_subpro&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_proyec&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_activi&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_obra&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_depcia&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_detpre&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_detcom&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_liqdet&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_recaud&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.d_coning&#x3b;&#xa;VACUUM FULL ANALYSE pilaga_tmp.c_tipdoc&#x3b;&#xa;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
