      </entry>
    <entry>
      <name>temporal &#x28;mig_ft_movimientos_devengado&#x29;</name>
      <description/>
      <type>SQL</type>
      <sql>-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;-- DEVENGADO&#xa;-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;DROP TABLE IF EXISTS pilaga_tmp.mig_ft_movimientos_devengado&#x3b;&#xa;SELECT &#xa;  d_liqdet AS id_tabla,&#xa;  d.nroexp AS nroexp,&#xa;  c.impoliq AS impoliq,&#xa;  d.tipcom AS tipcom,&#xa;  d.tipdoc AS tipdoc,&#xa;  d.cuit1 AS cuit1,&#xa;  d.nrodoc AS nrodoc,&#xa;  d.cuit2 AS cuit2,&#xa;  d.estado AS estado,&#xa;  d.anio AS anio_id, d.fecliq AS fecha_id, 0 AS red_programatica_id, 0 AS grupo_presupuestario_id, 0 AS codigo_economico_id, 0 AS unidad_presupuestaria_id,&#xa;  0 AS unidad_gestion_id, 0 AS finalidad_funcion_id, 0 AS moneda_id, 0 AS fondo_id, 0 AS tercero_id, 0 AS fuente_id,&#xa;  0 AS circuito_gestion_id, 0 AS objeto_del_gasto_id, 0 AS expediente_id, 0 AS concepto_id, 0 AS documento_id,&#xa;  0 AS tipo_persona_id, 0 AS beneficiario_id, 0 AS persona_comprobante_id, 0 AS comprobante_id, 0 AS contribuyente_id,&#xa;  d.fecvto AS fecha_vencimiento_id, 0 AS nivel_autorizacion_id, 0 AS estado_liquidacion_id, &#xa;  d.fecliq AS fecha_valor_id, 0 AS unidad_generica_id, 0 AS etapa_presupuestaria_id, 0 AS tipo_documento_id,&#xa;  0 AS documento_preventivo_id, 0 AS documento_compromiso_id, 0 AS documento_devengado_id, 0 AS documento_pagado_id,&#xa;  0 AS documento_devengado_ingreso_id, 0 AS documento_cobrado_id, 0 AS cuenta_tesoreria_id, 0 AS cuenta_bancaria_id,&#xa;  0 AS banco_sucursal_id, 0 AS rubro_ingreso_id, 0 AS concepto_ingreso_id, 0 AS tipo_operacion_id, 0 AS mes_id,&#xa;  0.0 AS credito_original,&#xa;  0.0 AS credito_modificatorio,&#xa;  0.0 AS credito, -- Ver si corresponde dejarlo o es una medida calculada&#xa;  0.0 AS preventivo,&#xa;  0.0 AS compromiso,&#xa;  impoliq AS devengado,&#xa;  0.0 AS pagado,&#xa;  0.0 AS retenciones,&#xa;  0.0 AS disponibilidades,&#xa;  0.0 AS previsto_de_ingreso,&#xa;  0.0 AS estimado_de_ingreso,&#xa;  0.0 AS devengado_de_ingreso,&#xa;  0.0 AS cobrado,&#xa;  d.tipliq&#xa;INTO pilaga_tmp.mig_ft_movimientos_devengado&#xa; FROM pilaga_tmp.d_liquid d, pilaga_tmp.d_liqdet c &#xa; WHERE d.anio&#x3d;c.anio AND d.tipcom&#x3d;c.tipcom AND d.nroliq&#x3d;c.nroliq AND d.tipliq&#x3d;c.tipliq&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET red_programatica_id &#x3d; COALESCE&#x28;&#x28;SELECT rp.red_programatica_id FROM pilaga.d_red_programatica rp, pilaga_tmp.d_liqdet d&#xa; WHERE id_tabla&#x3d;d.d_liqdet AND&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_prg&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_sub&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_pry&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_act&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_obr&#x3a;&#x3a;text,2&#x29; &#x3d; rp.red_programatica_codigo&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET grupo_presupuestario_id &#x3d; COALESCE&#x28;&#x28;SELECT grupo_presupuestario_id FROM pilaga.d_grupo_presupuestario WHERE grupo_presupuestario_codigo&#x3d;&#x27;0001&#x27;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET unidad_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT up.unidad_presupuestaria_id FROM pilaga.d_unidad_presupuestaria up, pilaga_tmp.d_liqdet d&#xa; WHERE id_tabla&#x3d;d.d_liqdet AND&#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.000&#x27; &#x3d; up.unidad_presupuestaria_codigo&#x29;,0&#x29;&#x3b;&#xa;&#xa;-- TODO&#x3a; Hay un 10&#x25; de las funciones que quedaron mal asignadas ya que hay dos candidatas y se selecciono una &#x28;la de codigo minimo&#x29;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET finalidad_funcion_id &#x3d; COALESCE&#x28;&#x28;SELECT f.finalidad_funcion_id FROM pilaga.d_finalidad_funcion f&#xa;	WHERE f.finalidad_codigo&#x3d;3 AND f.funcion_codigo&#x3d;&#xa;						&#x28;SELECT min&#x28;c.codigo_fun&#x29;&#x3a;&#x3a;integer from pilaga_tmp.d_liqdet p, pilaga_tmp.d_salcre c&#xa;							WHERE id_tabla &#x3d; p.d_liqdet AND&#xa;								p.anio&#x3d;c.anio and p.coddep&#x3d;c.coddep and p.subdep&#x3d;c.subdep and &#xa;								p.codigo_fue&#x3d;c.codigo_fue and p.codigo_prg&#x3d;c.codigo_prg and &#xa;								p.codigo_sub&#x3d;c.codigo_sub and p.codigo_pry&#x3d;c.codigo_pry and&#xa;								p.codigo_inc&#x3d;c.codigo_inc and p.codigo_act&#x3d;c.codigo_act and&#xa;								p.codigo_obr&#x3d;c.codigo_obr and p.codigo_ppl&#x3d;c.codigo_ppl and &#xa;								p.impoliq&#x3c;&#x3d;c.cred_prev and c.cred_prev&#x3c;&#x3e;0&#x29;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET moneda_id &#x3d; COALESCE&#x28;&#x28;SELECT m.moneda_id FROM pilaga.d_moneda m WHERE m.moneda_codigo&#x3d;&#x27;1&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado SET fondo_id &#x3d; &#x28;SELECT fondo_id FROM pilaga.d_fondo WHERE fondo_desc &#x3d; &#x27;Presupuestario&#x27;&#x29;&#x3b;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado SET fondo_id &#x3d; &#x28;SELECT fondo_id FROM pilaga.d_fondo WHERE fondo_desc &#x3d; &#x27;Deuda Exigible&#x27;&#x29;&#xa; WHERE tipliq&#x3d;&#x27;EX&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET fuente_id &#x3d; COALESCE&#x28;&#x28;SELECT f.fuente_id FROM pilaga.d_fuente f, pilaga_tmp.d_liqdet d WHERE id_tabla&#x3d;d.d_liqdet AND f.fuente_codigo&#x3d;d.codigo_fue&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET circuito_gestion_id &#x3d; COALESCE&#x28;&#x28;SELECT cg.circuito_gestion_id FROM pilaga.d_circuito_gestion cg WHERE cg.circuito_gestion_codigo&#x3d;&#x27;GBAS&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET objeto_del_gasto_id &#x3d; COALESCE&#x28;&#x28;SELECT og.objeto_del_gasto_id FROM pilaga.d_objeto_del_gasto og, pilaga_tmp.d_liqdet d WHERE id_tabla&#x3d;d.d_liqdet AND&#xa;  og.objeto_del_gasto_codigo&#x3d;codigo_inc&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; codigo_ppl&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; codigo_ppr&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.0000&#x27;&#x29;,0&#x29;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET expediente_id &#x3d; COALESCE&#x28;&#x28;SELECT e.expediente_id&#xa;			FROM pilaga.d_expediente e &#xa;			WHERE e.expediente_desc&#x3d;COALESCE&#x28;&#x27;EXP - &#x27; &#x7c;&#x7c; nroexp &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio_id&#x3a;&#x3a;varchar,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET concepto_id &#x3d; COALESCE&#x28;&#x28;SELECT c.concepto_id&#xa;			FROM pilaga.d_concepto c &#xa;			WHERE c.concepto_desc&#x3d;COALESCE&#x28;&#x28;SELECT c.concepto FROM pilaga_tmp.d_liquid c, pilaga_tmp.d_liqdet d&#xa;							WHERE id_tabla&#x3d;d.d_liqdet AND &#xa;							d.anio&#x3d;c.anio AND d.tipcom&#x3d;c.tipcom AND d.nroliq&#x3d;c.nroliq AND d.tipliq&#x3d;c.tipliq AND &#xa;							c.concepto is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET documento_id &#x3d; COALESCE&#x28;&#x28;SELECT d.documento_principal_id&#xa;			FROM pilaga.d_documento_principal d &#xa;			WHERE d.documento_principal_codigo&#x3d;&#xa;				COALESCE&#x28;&#x28;SELECT c.tipcom &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nroliq &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text  &#xa;						FROM pilaga_tmp.d_liquid c, pilaga_tmp.d_liqdet d&#xa;							WHERE id_tabla&#x3d;d.d_liqdet AND &#xa;							d.anio&#x3d;c.anio AND d.tipcom&#x3d;c.tipcom AND d.nroliq&#x3d;c.nroliq AND d.tipliq&#x3d;c.tipliq AND &#xa;							&#x28;c.tipcom &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nroliq &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text&#x29; is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado SET documento_devengado_id &#x3d; documento_id&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET beneficiario_id &#x3d; COALESCE&#x28;&#x28;SELECT persona_id FROM pilaga.d_persona p, pilaga_tmp.c_tipdoc t&#xa;				WHERE tipdoc&#x3d;t.tipdoc AND&#xa;				t.nom_tipd&#x3d;p.persona_tipo_documento AND&#xa;				CASE WHEN t.nom_tipd &#x3d; &#x27;CUIT&#x27; OR t.nom_tipd &#x3d; &#x27;CUIL&#x27; THEN&#xa;					cuit1&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; nrodoc&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; cuit2&#x3a;&#x3a;varchar&#xa;					ELSE nrodoc&#x3a;&#x3a;varchar&#xa;				END &#x3d; p.persona_nro_documento LIMIT 1&#x29;&#xa;			,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET tipo_persona_id &#x3d; COALESCE&#x28;&#x28;SELECT tipo_persona_id FROM pilaga.d_tipo_persona WHERE tipo_persona_codigo &#x3d; &#x27;P&#x27;&#x29;,0&#x29;&#xa;WHERE beneficiario_id &#x3c;&#x3e; 0&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET estado_liquidacion_id &#x3d; &#xa;	COALESCE&#x28;&#xa;		 &#x28;CASE WHEN estado IN &#x28;&#x27;1&#x27;, &#x27;2&#x27;, &#x27;3&#x27;, &#x27;4&#x27;, &#x27;5&#x27;, &#x27;6&#x27;, &#x27;7&#x27;, &#x27;8&#x27;, &#x27;A&#x27;, &#x27;S&#x27;, &#x27;D&#x27;&#x29; THEN &#x28;SELECT estado_liquidacion_id FROM pilaga.d_estado_liquidacion WHERE estado_liquidacion_codigo &#x3d; &#x27;L&#x27;&#x29;&#xa;		       WHEN estado IN &#x28;&#x27;P&#x27;, &#x27;R&#x27;&#x29; THEN &#x28;SELECT estado_liquidacion_id FROM pilaga.d_estado_liquidacion WHERE estado_liquidacion_codigo &#x3d; &#x27;P&#x27;&#x29;&#xa;		       WHEN estado &#x3d; &#x27;U&#x27; THEN &#x28;SELECT estado_liquidacion_id FROM pilaga.d_estado_liquidacion WHERE estado_liquidacion_codigo &#x3d; &#x27;U&#x27;&#x29;&#xa;		       ELSE 0&#xa;		  END&#xa;		 &#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET etapa_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT e.etapa_presupuestaria_id FROM pilaga.d_etapa_presupuestaria e WHERE e.etapa_presupuestaria_codigo&#x3d;&#x27;DE&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET tipo_documento_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_documento_id FROM pilaga.d_tipo_documento t WHERE t.tipo_documento_codigo &#x3d; tipcom&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET tipo_operacion_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_operacion_id FROM pilaga.d_tipo_operacion t WHERE t.tipo_operacion_codigo&#x3d;&#x27;CDEV&#x27;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET mes_id &#x3d; COALESCE&#x28;extract&#x28;month from fecha_id&#x29;,1&#x29;&#x3b;&#xa;&#xa;-- Obtencion de documento_preventivo y documento_compromiso en el devengado&#xa;DROP TABLE IF EXISTS pilaga_tmp.mig_temp_deveng&#x3b;&#xa;SELECT DISTINCT l.nroexp AS tt_nroexp, ld.impoliq AS tt_impoliq, min&#x28;d.d_detcom&#x29; AS tt_d_detcom, &#xa;	max&#x28;c.numero&#x29;&#x3a;&#x3a;integer - min&#x28;c.numero&#x29;&#x3a;&#x3a;integer AS tt_distancia_compromisos&#xa;	INTO pilaga_tmp.mig_temp_deveng&#xa;	FROM pilaga_tmp.d_cabcom c, pilaga_tmp.d_detcom d, pilaga_tmp.d_liquid l, pilaga_tmp.d_liqdet ld&#xa;WHERE &#xa;  d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND&#xa;  ld.anio&#x3d;l.anio AND ld.tipcom&#x3d;l.tipcom AND ld.nroliq&#x3d;l.nroliq AND ld.tipliq&#x3d;l.tipliq AND&#xa;  c.exp&#x3d;l.nroexp AND d.devengado&#x3d;ld.impoliq AND&#xa;  ld.coddep&#x3d;d.coddep AND ld.subdep&#x3d;d.subdep AND ld.codigo_fue&#x3d;d.codigo_fue AND &#xa;  ld.codigo_prg&#x3d;d.codigo_prg AND ld.codigo_pry&#x3d;d.codigo_pry AND ld.codigo_act&#x3d;d.codigo_act AND&#xa;  ld.codigo_obr&#x3d;d.codigo_obr AND ld.codigo_inc&#x3d;d.codigo_inc AND ld.codigo_ppl&#x3d;d.codigo_ppl AND&#xa;  ld.codigo_ppr&#x3d;d.codigo_ppr&#xa;GROUP BY 1,2&#x3b;&#xa;CREATE UNIQUE INDEX idx_mig_temp_deveng_index ON pilaga_tmp.mig_temp_deveng &#x28;tt_nroexp, tt_impoliq&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET documento_compromiso_id &#x3d; COALESCE&#x28;&#x28;SELECT d.documento_principal_id&#xa;			FROM pilaga.d_documento_principal d &#xa;			WHERE d.documento_principal_codigo&#x3d;&#xa;				COALESCE&#x28;&#x28;SELECT c.tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text  &#xa;						FROM pilaga_tmp.d_cabcom c, pilaga_tmp.d_detcom d, pilaga_tmp.mig_temp_deveng tt&#xa;							WHERE nroexp&#x3d;tt.tt_nroexp AND impoliq&#x3d;tt.tt_impoliq AND &#xa;							tt.tt_d_detcom &#x3d; d.d_detcom AND tt.tt_distancia_compromisos&#x3d;0 AND&#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND &#xa;							d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;							&#x28;c.tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text&#x29; is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_devengado&#xa; SET documento_preventivo_id &#x3d; COALESCE&#x28;&#x28;SELECT d.documento_principal_id&#xa;			FROM pilaga.d_documento_principal d &#xa;			WHERE d.documento_principal_codigo&#x3d;&#xa;				COALESCE&#x28;&#x28;SELECT c.tipoprev &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nup &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text  &#xa;						FROM pilaga_tmp.d_cabcom c, pilaga_tmp.d_detcom d, pilaga_tmp.mig_temp_deveng tt&#xa;							WHERE nroexp&#x3d;tt.tt_nroexp AND impoliq&#x3d;tt.tt_impoliq AND &#xa;							tt.tt_d_detcom &#x3d; d.d_detcom AND tt.tt_distancia_compromisos&#x3d;0 AND&#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND &#xa;							d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;							&#x28;c.tipoprev &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nup &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text&#x29; is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b; &#xa;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>755</xloc>
      <yloc>185</yloc>
      </entry>
    <entry>
      <name>temporal &#x28;mig_ft_movimientos_pagado&#x29;</name>
      <description/>
      <type>SQL</type>
      <sql>-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;-- PAGADO&#xa;-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;DROP TABLE IF EXISTS pilaga_tmp.mig_ft_movimientos_pagado&#x3b;&#xa;SELECT &#xa;  d_liqdet AS id_tabla,&#xa;  d.nroexp AS nroexp,&#xa;  c.impoliq AS impoliq,&#xa;  d.tipcom AS tipcom,&#xa;  d.tipdoc AS tipdoc,&#xa;  d.cuit1 AS cuit1,&#xa;  d.nrodoc AS nrodoc,&#xa;  d.cuit2 AS cuit2,&#xa;  d.estado AS estado,&#xa;  d.anio AS anio_id, d.fecliq AS fecha_id, 0 AS red_programatica_id, 0 AS grupo_presupuestario_id, 0 AS codigo_economico_id, 0 AS unidad_presupuestaria_id,&#xa;  0 AS unidad_gestion_id, 0 AS finalidad_funcion_id, 0 AS moneda_id, 0 AS fondo_id, 0 AS tercero_id, 0 AS fuente_id,&#xa;  0 AS circuito_gestion_id, 0 AS objeto_del_gasto_id, 0 AS expediente_id, 0 AS concepto_id, 0 AS documento_id,&#xa;  0 AS tipo_persona_id, 0 AS beneficiario_id, 0 AS persona_comprobante_id, 0 AS comprobante_id, 0 AS contribuyente_id,&#xa;  d.fecvto AS fecha_vencimiento_id, 0 AS nivel_autorizacion_id, 0 AS estado_liquidacion_id, &#xa;  d.fecliq AS fecha_valor_id, 0 AS unidad_generica_id, 0 AS etapa_presupuestaria_id, 0 AS tipo_documento_id,&#xa;  0 AS documento_preventivo_id, 0 AS documento_compromiso_id, 0 AS documento_devengado_id, 0 AS documento_pagado_id,&#xa;  0 AS documento_devengado_ingreso_id, 0 AS documento_cobrado_id, 0 AS cuenta_tesoreria_id, 0 AS cuenta_bancaria_id,&#xa;  0 AS banco_sucursal_id, 0 AS rubro_ingreso_id, 0 AS concepto_ingreso_id, 0 AS tipo_operacion_id, 0 AS mes_id,&#xa;  0.0 AS credito_original,&#xa;  0.0 AS credito_modificatorio,&#xa;  0.0 AS credito, -- Ver si corresponde dejarlo o es una medida calculada&#xa;  0.0 AS preventivo,&#xa;  0.0 AS compromiso,&#xa;  0.0 AS devengado,&#xa;  impoliq AS pagado,&#xa;-- TODO&#x3a; Se justifica dividir las retensiones en registros separados e identificar los agentes de recaudacion &#x3f;&#x3f;&#x3f;&#xa;  ret_ingb &#x2b; ret_obra &#x2b; ret_iva &#x2b; ret_prex &#x2b; ret_otr1 &#x2b; ret_otr2 AS retenciones,&#xa;  0.0 AS disponibilidades,&#xa;  0.0 AS previsto_de_ingreso,&#xa;  0.0 AS estimado_de_ingreso,&#xa;  0.0 AS devengado_de_ingreso,&#xa;  0.0 AS cobrado,&#xa;  d.tipliq&#xa;INTO pilaga_tmp.mig_ft_movimientos_pagado&#xa; FROM pilaga_tmp.d_liquid d, pilaga_tmp.d_liqdet c &#xa; WHERE d.anio&#x3d;c.anio AND d.tipcom&#x3d;c.tipcom AND d.nroliq&#x3d;c.nroliq AND d.tipliq&#x3d;c.tipliq AND&#xa;       d.estado IN &#x28;&#x27;P&#x27;, &#x27;R&#x27;&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET red_programatica_id &#x3d; COALESCE&#x28;&#x28;SELECT rp.red_programatica_id FROM pilaga.d_red_programatica rp, pilaga_tmp.d_liqdet d&#xa; WHERE id_tabla&#x3d;d.d_liqdet AND&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_prg&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_sub&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_pry&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_act&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_obr&#x3a;&#x3a;text,2&#x29; &#x3d; rp.red_programatica_codigo&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET grupo_presupuestario_id &#x3d; COALESCE&#x28;&#x28;SELECT grupo_presupuestario_id FROM pilaga.d_grupo_presupuestario WHERE grupo_presupuestario_codigo&#x3d;&#x27;0001&#x27;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET unidad_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT up.unidad_presupuestaria_id FROM pilaga.d_unidad_presupuestaria up, pilaga_tmp.d_liqdet d&#xa; WHERE id_tabla&#x3d;d.d_liqdet AND&#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.000&#x27; &#x3d; up.unidad_presupuestaria_codigo&#x29;,0&#x29;&#x3b;&#xa;&#xa;-- TODO&#x3a; Hay un 10&#x25; de las funciones que quedaron mal asignadas ya que hay dos candidatas y se selecciono una &#x28;la de codigo minimo&#x29;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET finalidad_funcion_id &#x3d; &#x28;SELECT f.finalidad_funcion_id FROM pilaga.d_finalidad_funcion f&#xa;	WHERE f.finalidad_codigo&#x3d;3 AND f.funcion_codigo&#x3d;&#xa;						&#x28;SELECT min&#x28;c.codigo_fun&#x29;&#x3a;&#x3a;integer from pilaga_tmp.d_liqdet p, pilaga_tmp.d_salcre c&#xa;							WHERE id_tabla &#x3d; p.d_liqdet AND&#xa;								p.anio&#x3d;c.anio and p.coddep&#x3d;c.coddep and p.subdep&#x3d;c.subdep and &#xa;								p.codigo_fue&#x3d;c.codigo_fue and p.codigo_prg&#x3d;c.codigo_prg and &#xa;								p.codigo_sub&#x3d;c.codigo_sub and p.codigo_pry&#x3d;c.codigo_pry and&#xa;								p.codigo_inc&#x3d;c.codigo_inc and p.codigo_act&#x3d;c.codigo_act and&#xa;								p.codigo_obr&#x3d;c.codigo_obr and p.codigo_ppl&#x3d;c.codigo_ppl and &#xa;								p.impoliq&#x3c;&#x3d;c.cred_prev and c.cred_prev&#x3c;&#x3e;0&#x29;&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET moneda_id &#x3d; COALESCE&#x28;&#x28;SELECT m.moneda_id FROM pilaga.d_moneda m WHERE m.moneda_codigo&#x3d;&#x27;1&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado SET fondo_id &#x3d; &#x28;SELECT fondo_id FROM pilaga.d_fondo WHERE fondo_desc &#x3d; &#x27;Presupuestario&#x27;&#x29;&#x3b;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado SET fondo_id &#x3d; &#x28;SELECT fondo_id FROM pilaga.d_fondo WHERE fondo_desc &#x3d; &#x27;Deuda Exigible&#x27;&#x29;&#xa; WHERE tipliq&#x3d;&#x27;EX&#x27;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET fuente_id &#x3d; COALESCE&#x28;&#x28;SELECT f.fuente_id FROM pilaga.d_fuente f, pilaga_tmp.d_liqdet d WHERE id_tabla&#x3d;d.d_liqdet AND f.fuente_codigo&#x3d;d.codigo_fue&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET circuito_gestion_id &#x3d; COALESCE&#x28;&#x28;SELECT cg.circuito_gestion_id FROM pilaga.d_circuito_gestion cg WHERE cg.circuito_gestion_codigo&#x3d;&#x27;GBAS&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET objeto_del_gasto_id &#x3d; COALESCE&#x28;&#x28;SELECT og.objeto_del_gasto_id FROM pilaga.d_objeto_del_gasto og, pilaga_tmp.d_liqdet d WHERE id_tabla&#x3d;d.d_liqdet AND&#xa;  og.objeto_del_gasto_codigo&#x3d;codigo_inc&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; codigo_ppl&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; codigo_ppr&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.0000&#x27;&#x29;,0&#x29;&#x3b; &#xa;&#xa;-- TODO&#x3a; Ver donde se pone este indice CREATE UNIQUE INDEX d_expediente_por_desc_index ON pilaga.d_expediente &#x28;expediente_desc&#x29;&#x3b;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET expediente_id &#x3d; COALESCE&#x28;&#x28;SELECT e.expediente_id&#xa;			FROM pilaga.d_expediente e &#xa;			WHERE e.expediente_desc&#x3d;COALESCE&#x28;&#x27;EXP - &#x27; &#x7c;&#x7c; nroexp &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio_id&#x3a;&#x3a;varchar,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET concepto_id &#x3d; COALESCE&#x28;&#x28;SELECT c.concepto_id&#xa;			FROM pilaga.d_concepto c &#xa;			WHERE c.concepto_desc&#x3d;COALESCE&#x28;&#x28;SELECT c.concepto FROM pilaga_tmp.d_liquid c, pilaga_tmp.d_liqdet d&#xa;							WHERE id_tabla&#x3d;d.d_liqdet AND &#xa;							d.anio&#x3d;c.anio AND d.tipcom&#x3d;c.tipcom AND d.nroliq&#x3d;c.nroliq AND d.tipliq&#x3d;c.tipliq AND &#xa;							c.concepto is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET documento_id &#x3d; COALESCE&#x28;&#x28;SELECT d.documento_principal_id&#xa;			FROM pilaga.d_documento_principal d &#xa;			WHERE d.documento_principal_codigo&#x3d;&#xa;				COALESCE&#x28;&#x28;SELECT c.tipcom &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nroliq &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text  &#xa;						FROM pilaga_tmp.d_liquid c, pilaga_tmp.d_liqdet d&#xa;							WHERE id_tabla&#x3d;d.d_liqdet AND &#xa;							d.anio&#x3d;c.anio AND d.tipcom&#x3d;c.tipcom AND d.nroliq&#x3d;c.nroliq AND d.tipliq&#x3d;c.tipliq AND &#xa;							&#x28;c.tipcom &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nroliq &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text&#x29; is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado SET documento_devengado_id &#x3d; COALESCE&#x28;documento_id,0&#x29;&#x3b;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado SET documento_pagado_id &#x3d; COALESCE&#x28;documento_id,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET beneficiario_id &#x3d; COALESCE&#x28;&#x28;SELECT persona_id FROM pilaga.d_persona p, pilaga_tmp.c_tipdoc t&#xa;				WHERE tipdoc&#x3d;t.tipdoc AND&#xa;				t.nom_tipd&#x3d;p.persona_tipo_documento AND&#xa;				CASE WHEN t.nom_tipd &#x3d; &#x27;CUIT&#x27; OR t.nom_tipd &#x3d; &#x27;CUIL&#x27; THEN&#xa;					cuit1&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; nrodoc&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; cuit2&#x3a;&#x3a;varchar&#xa;					ELSE nrodoc&#x3a;&#x3a;varchar&#xa;				END &#x3d; p.persona_nro_documento LIMIT 1&#x29;&#xa;			,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET tipo_persona_id &#x3d; COALESCE&#x28;&#x28;SELECT tipo_persona_id FROM pilaga.d_tipo_persona WHERE tipo_persona_codigo &#x3d; &#x27;P&#x27;&#x29;,0&#x29;&#xa;WHERE beneficiario_id &#x3c;&#x3e; 0&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET estado_liquidacion_id &#x3d; &#xa;		 COALESCE&#x28;&#x28;CASE WHEN estado IN &#x28;&#x27;P&#x27;, &#x27;R&#x27;&#x29; THEN &#x28;SELECT estado_liquidacion_id FROM pilaga.d_estado_liquidacion WHERE estado_liquidacion_codigo &#x3d; &#x27;P&#x27;&#x29;&#xa;		       ELSE 0&#xa;		  END&#xa;		 &#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET etapa_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT e.etapa_presupuestaria_id FROM pilaga.d_etapa_presupuestaria e WHERE e.etapa_presupuestaria_codigo&#x3d;&#x27;PA&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET tipo_documento_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_documento_id FROM pilaga.d_tipo_documento t WHERE t.tipo_documento_codigo &#x3d; tipcom&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET tipo_operacion_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_operacion_id FROM pilaga.d_tipo_operacion t WHERE t.tipo_operacion_codigo&#x3d;&#x27;CPAG&#x27;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET mes_id &#x3d; COALESCE&#x28;extract&#x28;month from fecha_id&#x29;,1&#x29;&#x3b;&#xa;&#xa;-- Obtencion de documento_preventivo y documento_compromiso en el devengado&#xa;DROP TABLE IF EXISTS pilaga_tmp.mig_temp_pagado&#x3b;&#xa;SELECT DISTINCT l.nroexp AS tt_nroexp, ld.impoliq AS tt_impoliq, min&#x28;d.d_detcom&#x29; AS tt_d_detcom, &#xa;	max&#x28;c.numero&#x29;&#x3a;&#x3a;integer - min&#x28;c.numero&#x29;&#x3a;&#x3a;integer AS tt_distancia_compromisos&#xa;	INTO pilaga_tmp.mig_temp_pagado&#xa;	FROM pilaga_tmp.d_cabcom c, pilaga_tmp.d_detcom d, pilaga_tmp.d_liquid l, pilaga_tmp.d_liqdet ld&#xa;WHERE &#xa;  d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND&#xa;  ld.anio&#x3d;l.anio AND ld.tipcom&#x3d;l.tipcom AND ld.nroliq&#x3d;l.nroliq AND ld.tipliq&#x3d;l.tipliq AND&#xa;  c.exp&#x3d;l.nroexp AND d.devengado&#x3d;ld.impoliq AND&#xa;  ld.coddep&#x3d;d.coddep AND ld.subdep&#x3d;d.subdep AND ld.codigo_fue&#x3d;d.codigo_fue AND &#xa;  ld.codigo_prg&#x3d;d.codigo_prg AND ld.codigo_pry&#x3d;d.codigo_pry AND ld.codigo_act&#x3d;d.codigo_act AND&#xa;  ld.codigo_obr&#x3d;d.codigo_obr AND ld.codigo_inc&#x3d;d.codigo_inc AND ld.codigo_ppl&#x3d;d.codigo_ppl AND&#xa;  ld.codigo_ppr&#x3d;d.codigo_ppr&#xa;GROUP BY 1,2&#x3b;&#xa;CREATE UNIQUE INDEX temp_temp_index ON pilaga_tmp.mig_temp_pagado &#x28;tt_nroexp, tt_impoliq&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET documento_compromiso_id &#x3d; COALESCE&#x28;&#x28;SELECT d.documento_principal_id&#xa;			FROM pilaga.d_documento_principal d &#xa;			WHERE d.documento_principal_codigo&#x3d;&#xa;				COALESCE&#x28;&#x28;SELECT c.tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text  &#xa;						FROM pilaga_tmp.d_cabcom c, pilaga_tmp.d_detcom d, pilaga_tmp.mig_temp_pagado tt&#xa;							WHERE nroexp&#x3d;tt.tt_nroexp AND impoliq&#x3d;tt.tt_impoliq AND &#xa;							tt.tt_d_detcom &#x3d; d.d_detcom AND tt.tt_distancia_compromisos&#x3d;0 AND&#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND &#xa;							d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;							&#x28;c.tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text&#x29; is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_pagado&#xa; SET documento_preventivo_id &#x3d; COALESCE&#x28;&#x28;SELECT d.documento_principal_id&#xa;			FROM pilaga.d_documento_principal d &#xa;			WHERE d.documento_principal_codigo&#x3d;&#xa;				COALESCE&#x28;&#x28;SELECT c.tipoprev &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nup &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text  &#xa;						FROM pilaga_tmp.d_cabcom c, pilaga_tmp.d_detcom d, pilaga_tmp.mig_temp_pagado tt&#xa;							WHERE nroexp&#x3d;tt.tt_nroexp AND impoliq&#x3d;tt.tt_impoliq AND &#xa;							tt.tt_d_detcom &#x3d; d.d_detcom AND tt.tt_distancia_compromisos&#x3d;0 AND&#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND &#xa;							d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;							&#x28;c.tipoprev &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nup &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text&#x29; is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b; &#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>755</xloc>
      <yloc>99</yloc>
      </entry>
    <entry>
      <name>temporal &#x28;mig_ft_movimientos_cobrado&#x29;</name>
      <description/>
      <type>SQL</type>
      <sql>-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;-- COBRADO&#xa;-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;DROP TABLE IF EXISTS pilaga_tmp.mig_ft_movimientos_cobrado&#x3b;&#xa;SELECT &#xa;  d_recaud AS id_tabla,&#xa;  r.anio AS anio_id, r.fecha AS fecha_id, 0 AS red_programatica_id, 0 AS grupo_presupuestario_id, 0 AS codigo_economico_id, 0 AS unidad_presupuestaria_id,&#xa;  0 AS unidad_gestion_id, 0 AS finalidad_funcion_id, 0 AS moneda_id, 0 AS fondo_id, 0 AS tercero_id, 0 AS fuente_id,&#xa;  0 AS circuito_gestion_id, 0 AS objeto_del_gasto_id, 0 AS expediente_id, 0 AS concepto_id, 0 AS documento_id,&#xa;  0 AS tipo_persona_id, 0 AS beneficiario_id, 0 AS persona_comprobante_id, 0 AS comprobante_id, 0 AS contribuyente_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_vencimiento_id, 0 AS nivel_autorizacion_id, 0 AS estado_liquidacion_id, &#xa;  r.fecha AS fecha_valor_id, 0 AS unidad_generica_id, 0 AS etapa_presupuestaria_id, 0 AS tipo_documento_id,&#xa;  0 AS documento_preventivo_id, 0 AS documento_compromiso_id, 0 AS documento_devengado_id, 0 AS documento_pagado_id,&#xa;  0 AS documento_devengado_ingreso_id, 0 AS documento_cobrado_id, 0 AS cuenta_tesoreria_id, 0 AS cuenta_bancaria_id,&#xa;  0 AS banco_sucursal_id, 0 AS rubro_ingreso_id, 0 AS concepto_ingreso_id, 0 AS tipo_operacion_id, 0 AS mes_id,&#xa;  0.0 AS credito_original,&#xa;  0.0 AS credito_modificatorio,&#xa;  0.0 AS credito, -- Ver si corresponde dejarlo o es una medida calculada&#xa;  0.0 AS preventivo,&#xa;  0.0 AS compromiso,&#xa;  0.0 AS devengado,&#xa;  0.0 AS pagado,&#xa;  0.0 AS retenciones,&#xa;  0.0 AS disponibilidades,&#xa;  0.0 AS previsto_de_ingreso,&#xa;  0.0 AS estimado_de_ingreso,&#xa;  0.0 AS devengado_de_ingreso,&#xa;  r.impo_rec AS cobrado&#xa;INTO pilaga_tmp.mig_ft_movimientos_cobrado&#xa; FROM pilaga_tmp.d_recaud r, pilaga_tmp.d_coning c &#xa; WHERE r.codigo_con&#x3d;c.codigo_con&#xa; AND r.anio &#x3d; c.anio&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET grupo_presupuestario_id &#x3d; COALESCE&#x28;&#x28;SELECT grupo_presupuestario_id FROM pilaga.d_grupo_presupuestario WHERE grupo_presupuestario_codigo&#x3d;&#x27;0001&#x27;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET moneda_id &#x3d; COALESCE&#x28;&#x28;SELECT m.moneda_id FROM pilaga.d_moneda m WHERE m.moneda_codigo&#x3d;&#x27;1&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado SET fondo_id &#x3d; &#x28;SELECT fondo_id FROM pilaga.d_fondo WHERE fondo_desc &#x3d; &#x27;Presupuestario&#x27;&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET fuente_id &#x3d; COALESCE&#x28;&#x28;SELECT f.fuente_id FROM pilaga.d_fuente f, pilaga_tmp.d_recaud d WHERE id_tabla&#x3d;d.d_recaud AND f.fuente_codigo&#x3d;d.codigo_fue&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET circuito_gestion_id &#x3d; COALESCE&#x28;&#x28;SELECT cg.circuito_gestion_id FROM pilaga.d_circuito_gestion cg WHERE cg.circuito_gestion_codigo&#x3d;&#x27;INGT&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET etapa_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT e.etapa_presupuestaria_id FROM pilaga.d_etapa_presupuestaria e WHERE e.etapa_presupuestaria_codigo&#x3d;&#x27;CI&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET circuito_gestion_id &#x3d; COALESCE&#x28;&#x28;SELECT cg.circuito_gestion_id FROM pilaga.d_circuito_gestion cg WHERE cg.circuito_gestion_codigo&#x3d;&#x27;CCIT&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET unidad_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT up.unidad_presupuestaria_id FROM pilaga.d_unidad_presupuestaria up, pilaga_tmp.d_recaud d&#xa; WHERE id_tabla&#x3d;d.d_recaud AND&#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.000&#x27; &#x3d; up.unidad_presupuestaria_codigo&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET rubro_ingreso_id &#x3d; COALESCE&#x28;&#x28;SELECT ri.rubro_ingreso_id FROM pilaga.d_rubro_ingreso ri, pilaga_tmp.d_recaud d&#xa; WHERE id_tabla&#x3d;d.d_recaud AND&#xa;  substring&#x28;rubro,1,1&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; substring&#x28;rubro,2,1&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; substring&#x28;rubro,3,1&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; substring&#x28;rubro,4,1&#x29; &#x3d; ri.rubro_ingreso_codigo&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET concepto_ingreso_id &#x3d; COALESCE&#x28;&#x28;SELECT ci.concepto_ingreso_id FROM pilaga.d_concepto_ingreso ci, pilaga_tmp.d_recaud d&#xa; WHERE id_tabla&#x3d;d.d_recaud AND codigo_con &#x3d; ci.concepto_ingreso_codigo&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_cobrado&#xa; SET mes_id &#x3d; COALESCE&#x28;extract&#x28;month from fecha_id&#x29;,1&#x29;&#x3b;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>755</xloc>
      <yloc>14</yloc>
      </entry>
