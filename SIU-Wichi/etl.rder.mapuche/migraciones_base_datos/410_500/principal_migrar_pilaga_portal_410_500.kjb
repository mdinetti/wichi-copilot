    <entry>
      <name>temporal &#x28;mig_ft_movimientos_compromiso&#x29;</name>
      <description/>
      <type>SQL</type>
      <sql>-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;-- COMPROMISO&#xa;-- &#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#x3d;&#xa;DROP TABLE IF EXISTS pilaga_tmp.mig_ft_movimientos_compromiso&#x3b;&#xa;SELECT &#xa;  d_detcom AS id_tabla,&#xa;  nup AS nup, exp AS exp,&#xa;  c.tipo AS tipo,&#xa;  c.tipdoc AS tipdoc,&#xa;  c.cuit1 AS cuit1,&#xa;  c.nrodoc AS nrodoc,&#xa;  c.cuit2 AS cuit2,&#xa;  d.anio AS anio_id, &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_id, 0 AS red_programatica_id, 0 AS grupo_presupuestario_id, 0 AS codigo_economico_id, 0 AS unidad_presupuestaria_id,&#xa;  0 AS unidad_gestion_id, 0 AS finalidad_funcion_id, 0 AS moneda_id, 0 AS fondo_id, 0 AS tercero_id, 0 AS fuente_id,&#xa;  0 AS circuito_gestion_id, 0 AS objeto_del_gasto_id, 0 AS expediente_id, 0 AS concepto_id, 0 AS documento_id,&#xa;  0 AS tipo_persona_id, 0 AS beneficiario_id, 0 AS persona_comprobante_id, 0 AS comprobante_id, 0 AS contribuyente_id,&#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_vencimiento_id, 0 AS nivel_autorizacion_id, 0 AS estado_liquidacion_id, &#xa;  &#x27;1900-01-01&#x27;&#x3a;&#x3a;date AS fecha_valor_id, 0 AS unidad_generica_id, 0 AS etapa_presupuestaria_id, 0 AS tipo_documento_id,&#xa;  0 AS documento_preventivo_id, 0 AS documento_compromiso_id, 0 AS documento_devengado_id, 0 AS documento_pagado_id,&#xa;  0 AS documento_devengado_ingreso_id, 0 AS documento_cobrado_id, 0 AS cuenta_tesoreria_id, 0 AS cuenta_bancaria_id,&#xa;  0 AS banco_sucursal_id, 0 AS rubro_ingreso_id, 0 AS concepto_ingreso_id, 0 AS tipo_operacion_id, 0 AS mes_id,&#xa;  0.0 AS credito_original,&#xa;  0.0 AS credito_modificatorio,&#xa;  0.0 AS credito, -- Ver si corresponde dejarlo o es una medida calculada&#xa;  0.0 AS preventivo,&#xa;  compromiso AS compromiso,&#xa;  0.0 AS devengado,&#xa;  0.0 AS pagado,&#xa;  0.0 AS retenciones,&#xa;  0.0 AS disponibilidades,&#xa;  0.0 AS previsto_de_ingreso,&#xa;  0.0 AS estimado_de_ingreso,&#xa;  0.0 AS devengado_de_ingreso,&#xa;  0.0 AS cobrado&#xa;INTO pilaga_tmp.mig_ft_movimientos_compromiso&#xa;FROM pilaga_tmp.d_detcom d, pilaga_tmp.d_cabcom c &#xa;WHERE d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep&#x3b;&#xa;&#xa;-- TODO&#x3a; el valor del mes esta mal calculado, en realidad no encontramos la forma de obtenerlo &#x28;o tenemos el mes o el numero de documento&#x29;&#xa;-- creemos que el dato real del mes no es obtenible.&#xa;DROP TABLE IF EXISTS pilaga_tmp.mig_temp_comp&#x3b;&#xa;SELECT p.anio as anio, p.numero as numero, avg&#x28;c.mes&#x29;&#x3a;&#x3a;integer as mes&#xa;INTO pilaga_tmp.mig_temp_comp&#xa;FROM pilaga_tmp.d_detpre p, pilaga_tmp.d_salcre c&#xa;		WHERE p.anio&#x3d;c.anio and p.coddep&#x3d;c.coddep and p.subdep&#x3d;c.subdep and p.codigo_fue&#x3d;c.codigo_fue and p.codigo_prg&#x3d;c.codigo_prg &#xa;			and p.codigo_sub&#x3d;c.codigo_sub and p.codigo_pry&#x3d;c.codigo_pry and p.codigo_inc&#x3d;c.codigo_inc and p.codigo_act&#x3d;c.codigo_act&#xa;			and p.codigo_obr&#x3d;c.codigo_obr and p.codigo_ppl&#x3d;c.codigo_ppl and p.preventivo&#x3c;&#x3d;c.cred_prev and c.cred_prev&#x3c;&#x3e;0&#xa;			group by 1,2&#x3b;&#xa;CREATE UNIQUE INDEX mig_temp_comp_index ON pilaga_tmp.mig_temp_comp &#x28;anio, numero&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET mes_id &#x3d; COALESCE&#x28;&#x28;select mes from pilaga_tmp.mig_temp_comp t&#xa;		WHERE anio_id &#x3d; t.anio AND nup&#x3d;t.numero&#x29;,1&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso &#xa; SET fecha_id &#x3d; COALESCE&#x28;&#x28;SELECT &#x28;anio_id&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; mes_id&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date&#x29;,&#x27;1900-01-01&#x27;&#x3a;&#x3a;date&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso &#xa; SET fecha_valor_id &#x3d; COALESCE&#x28;&#x28;SELECT &#x28;anio_id&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; mes_id&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date&#x29;,&#x27;1900-01-01&#x27;&#x3a;&#x3a;date&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET red_programatica_id &#x3d; COALESCE&#x28;&#x28;SELECT rp.red_programatica_id FROM pilaga.d_red_programatica rp, pilaga_tmp.d_detpre d&#xa; WHERE id_tabla&#x3d;d.d_detpre AND&#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_prg&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_sub&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_pry&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_act&#x3a;&#x3a;text,2&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; &#xa;  right&#x28;&#x27;0&#x27; &#x7c;&#x7c; d.codigo_obr&#x3a;&#x3a;text,2&#x29; &#x3d; rp.red_programatica_codigo&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET grupo_presupuestario_id &#x3d; COALESCE&#x28;&#x28;SELECT grupo_presupuestario_id &#xa;	FROM pilaga.d_grupo_presupuestario 	&#xa;	WHERE grupo_presupuestario_codigo&#x3d;&#x27;0001&#x27;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET unidad_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT up.unidad_presupuestaria_id FROM pilaga.d_unidad_presupuestaria up, pilaga_tmp.d_detpre d&#xa; WHERE id_tabla&#x3d;d.d_detpre AND&#xa;  right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.coddep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; right&#x28;&#x27;00&#x27; &#x7c;&#x7c; d.subdep&#x3a;&#x3a;text,3&#x29; &#x7c;&#x7c; &#x27;.000&#x27; &#x3d; up.unidad_presupuestaria_codigo&#x29;,0&#x29;&#x3b;&#xa;&#xa;-- TODO&#x3a; Hay un 10&#x25; de las funciones que quedaron mal asignadas ya que hay dos candidatas y se selecciono una &#x28;la de codigo minimo&#x29;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET finalidad_funcion_id &#x3d; COALESCE&#x28;&#x28;SELECT f.finalidad_funcion_id FROM pilaga.d_finalidad_funcion f&#xa;	WHERE f.finalidad_codigo&#x3d;3 AND f.funcion_codigo&#x3d;&#xa;						&#x28;SELECT min&#x28;c.codigo_fun&#x29;&#x3a;&#x3a;integer from pilaga_tmp.d_detpre p, pilaga_tmp.d_salcre c&#xa;							WHERE id_tabla &#x3d; p.d_detpre AND&#xa;								p.anio&#x3d;c.anio and p.coddep&#x3d;c.coddep and p.subdep&#x3d;c.subdep and &#xa;								p.codigo_fue&#x3d;c.codigo_fue and p.codigo_prg&#x3d;c.codigo_prg and &#xa;								p.codigo_sub&#x3d;c.codigo_sub and p.codigo_pry&#x3d;c.codigo_pry and&#xa;								p.codigo_inc&#x3d;c.codigo_inc and p.codigo_act&#x3d;c.codigo_act and&#xa;								p.codigo_obr&#x3d;c.codigo_obr and p.codigo_ppl&#x3d;c.codigo_ppl and &#xa;								p.preventivo&#x3c;&#x3d;c.cred_prev and c.cred_prev&#x3c;&#x3e;0&#x29;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET moneda_id &#x3d; COALESCE&#x28;&#x28;SELECT m.moneda_id FROM pilaga.d_moneda m WHERE m.moneda_codigo&#x3d;&#x27;1&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso SET fondo_id &#x3d; &#x28;SELECT fondo_id FROM pilaga.d_fondo WHERE fondo_desc &#x3d; &#x27;Presupuestario&#x27;&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET fuente_id &#x3d; COALESCE&#x28;&#x28;SELECT f.fuente_id FROM pilaga.d_fuente f, pilaga_tmp.d_detpre d WHERE id_tabla&#x3d;d.d_detpre AND f.fuente_codigo&#x3d;d.codigo_fue&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET circuito_gestion_id &#x3d; COALESCE&#x28;&#x28;SELECT cg.circuito_gestion_id FROM pilaga.d_circuito_gestion cg WHERE cg.circuito_gestion_codigo&#x3d;&#x27;GBAS&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET objeto_del_gasto_id &#x3d; COALESCE&#x28;&#x28;SELECT og.objeto_del_gasto_id FROM pilaga.d_objeto_del_gasto og, pilaga_tmp.d_detcom d WHERE id_tabla&#x3d;d.d_detcom AND&#xa;  og.objeto_del_gasto_codigo&#x3d;codigo_inc&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; codigo_ppl&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; codigo_ppr&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;.0000&#x27;&#x29;,0&#x29;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET expediente_id &#x3d; COALESCE&#x28;&#x28;SELECT e.expediente_id&#xa;			FROM pilaga.d_expediente e &#xa;			WHERE e.expediente_desc&#x3d;COALESCE&#x28;&#x27;EXP - &#x27; &#x7c;&#x7c; exp &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; anio_id&#x3a;&#x3a;varchar ,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET concepto_id &#x3d; COALESCE&#x28;&#x28;SELECT c.concepto_id&#xa;			FROM pilaga.d_concepto c &#xa;			WHERE c.concepto_desc&#x3d;COALESCE&#x28;&#x28;SELECT c.concepto FROM pilaga_tmp.d_cabcom c, pilaga_tmp.d_detcom d&#xa;							WHERE id_tabla&#x3d;d.d_detcom AND &#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND &#xa;							d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;							c.concepto is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET documento_id &#x3d; COALESCE&#x28;&#x28;SELECT d.documento_principal_id&#xa;			FROM pilaga.d_documento_principal d &#xa;			WHERE d.documento_principal_codigo&#x3d;&#xa;				COALESCE&#x28;&#x28;SELECT c.tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text  &#xa;						FROM pilaga_tmp.d_cabcom c, pilaga_tmp.d_detcom d&#xa;							WHERE id_tabla&#x3d;d.d_detcom AND &#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND &#xa;							d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;							&#x28;c.tipo &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.numero &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text&#x29; is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso SET documento_compromiso_id &#x3d; COALESCE&#x28;documento_id,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET documento_preventivo_id &#x3d; COALESCE&#x28;&#x28;SELECT d.documento_principal_id&#xa;			FROM pilaga.d_documento_principal d &#xa;			WHERE d.documento_principal_codigo&#x3d;&#xa;				COALESCE&#x28;&#x28;SELECT c.tipoprev &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nup &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text  &#xa;						FROM pilaga_tmp.d_cabcom c, pilaga_tmp.d_detcom d&#xa;							WHERE id_tabla&#x3d;d.d_detcom AND &#xa;							d.anio&#x3d;c.anio AND d.tipo&#x3d;c.tipo AND d.numero&#x3d;c.numero AND &#xa;							d.anicomp&#x3d;c.anicomp AND d.coddep&#x3d;c.coddep AND d.subdep&#x3d;c.subdep AND &#xa;							&#x28;c.tipoprev &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; c.nup &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c; c.anio&#x3a;&#x3a;text&#x29; is not null&#x29;,&#x27;VACIO&#x2f;NULO&#x27;&#x29;&#x29;,0&#x29;&#x3b; &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET etapa_presupuestaria_id &#x3d; COALESCE&#x28;&#x28;SELECT e.etapa_presupuestaria_id FROM pilaga.d_etapa_presupuestaria e WHERE e.etapa_presupuestaria_codigo&#x3d;&#x27;CD&#x27;&#x29;,0&#x29;&#x3b;  &#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET tipo_operacion_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_operacion_id FROM pilaga.d_tipo_operacion t WHERE t.tipo_operacion_codigo&#x3d;&#x27;CDEF&#x27;&#x29;,0&#x29;&#x3b;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET tipo_documento_id &#x3d; COALESCE&#x28;&#x28;SELECT t.tipo_documento_id FROM pilaga.d_tipo_documento t WHERE t.tipo_documento_codigo &#x3d; tipo&#x29;,0&#x29;&#x3b;&#xa;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET beneficiario_id &#x3d; COALESCE&#x28;&#x28;SELECT persona_id FROM pilaga.d_persona p, pilaga_tmp.c_tipdoc t&#xa;				WHERE tipdoc&#x3d;t.tipdoc AND&#xa;				t.nom_tipd&#x3d;p.persona_tipo_documento AND&#xa;				CASE WHEN t.nom_tipd &#x3d; &#x27;CUIT&#x27; OR t.nom_tipd &#x3d; &#x27;CUIL&#x27; THEN&#xa;					cuit1&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; nrodoc&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; cuit2&#x3a;&#x3a;varchar&#xa;					ELSE nrodoc&#x3a;&#x3a;varchar&#xa;				END &#x3d; p.persona_nro_documento LIMIT 1&#x29;&#xa;			,0&#x29;&#x3b;&#xa;&#xa;&#xa;UPDATE pilaga_tmp.mig_ft_movimientos_compromiso&#xa; SET tipo_persona_id &#x3d; COALESCE&#x28;&#x28;SELECT tipo_persona_id FROM pilaga.d_tipo_persona WHERE tipo_persona_codigo &#x3d; &#x27;P&#x27;&#x29;,0&#x29;&#xa;WHERE beneficiario_id &#x3c;&#x3e; 0&#x3b;&#xa;&#xa;-- TODO&#x3a; para relacionar cabcom con cabpre&#xa;-- CONSTRAINT d_cabcom_anio_fkey FOREIGN KEY &#x28;anio, tipoprev, nup, anprev, coddep, subdep&#x29;&#xa;-- REFERENCES pilaga_tmp.d_cabpre &#x28;anio, tipo, numero, anprev, coddep, subdep&#x29; MATCH SIMPLE</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
