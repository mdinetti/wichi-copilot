<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>principal_migrar_base_410_500</name>
    <description>copia de datos de la versi&#xf3;n SIU-Wichi 4.1.0 a SIU-Wichi 5.0.0</description>
    <extended_description>Este proceso copia los datos de la base de datos de SIU-Wichi 4.1.0 a la nueva base de datos de la versi&#xf3;n SIU-Wichi 5.0.0.&#xa;Las bases de datos de SIU-Wichi 5.0.0 deben estar creadas previamente.</extended_description>
    <job_version/>
    <job_status>0</job_status>
  <directory>&#x2f;</directory>
  <created_user>-</created_user>
  <created_date>2012&#x2f;10&#x2f;24 09&#x3a;28&#x3a;53.098</created_date>
  <modified_user>-</modified_user>
  <modified_date>2012&#x2f;10&#x2f;24 09&#x3a;28&#x3a;53.098</modified_date>
    <parameters>
        <parameter>
            <name>commit_size</name>
            <default_value>10000</default_value>
            <description>cada cuantos registros se hace un commit en la base</description>
        </parameter>
        <parameter>
            <name>destino_base</name>
            <default_value>siu_wichi</default_value>
            <description>nombre de la base de datos  destino</description>
        </parameter>
        <parameter>
            <name>destino_clave</name>
            <default_value>postgres</default_value>
            <description>password del usuario de la base destino</description>
        </parameter>
        <parameter>
            <name>destino_host</name>
            <default_value>localhost</default_value>
            <description>nombre o ip del host del servidor donde se encuentra la base dsa de destino</description>
        </parameter>
        <parameter>
            <name>destino_puerto</name>
            <default_value>5432</default_value>
            <description>puerto al que se conecta a la base de datos dsa de destino</description>
        </parameter>
        <parameter>
            <name>destino_usuario</name>
            <default_value>postgres</default_value>
            <description>nombre de usuario de la base siu_dsa de destino</description>
        </parameter>
        <parameter>
            <name>origen_dw_base</name>
            <default_value>siu_dw</default_value>
            <description>nombre de la base de datos dw de origen</description>
        </parameter>
        <parameter>
            <name>origen_dw_clave</name>
            <default_value>postgres</default_value>
            <description>password del usuario de la base dw de origen</description>
        </parameter>
        <parameter>
            <name>origen_dw_host</name>
            <default_value>localhost</default_value>
            <description>nombre o ip del host de la base dw de origen</description>
        </parameter>
        <parameter>
            <name>origen_dw_puerto</name>
            <default_value>5432</default_value>
            <description>puerto al que se conecta a la base de datos dw de origen</description>
        </parameter>
        <parameter>
            <name>origen_dw_usuario</name>
            <default_value>postgres</default_value>
            <description>nombre de usuario de la base dw de origen</description>
        </parameter>
    </parameters>
