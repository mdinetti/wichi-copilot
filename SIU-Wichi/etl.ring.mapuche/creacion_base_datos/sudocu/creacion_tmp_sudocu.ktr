    <sql>-------------------------------------
-- Agrega esquemas y tablas de Sudocu
-------------------------------------

CREATE SCHEMA sudocu_tmp;
-- ***************************************************************************
-- sudocu_tmp
-- ***************************************************************************

CREATE TABLE sudocu_tmp.d_area
(
  area_uuid text,
  area_sigla text,
  area_desc text,
  eliminado boolean,
  fecha_desde text,
  fecha_hasta text,
  version text,
  vigente text,
  fecha_actualizacion text
);

CREATE TABLE sudocu_tmp.d_usuario
(
  usuario_uuid text, -- text
  usuario_nro_documento text, -- dni
  apyno text, -- apellido, nombre
  email text,
  username text,
  estado text, -- eliminado
  nivel_firma text,
  fecha_desde text,
  fecha_hasta text,
  version text,
  vigente text,
  fecha_actualizacion text
);
CREATE TABLE sudocu_tmp.d_estado -- estados de los documentos
(
  estado_id text,
  tipo_documento_id text,
  estado_orden text, -- orden
  estado_desc text, -- nombre del estado
  fecha_desde text,
  fecha_hasta text,
  version text,
  vigente text,
  fecha_actualizacion text
);
CREATE TABLE sudocu_tmp.d_tipo_documento
(
  tipo_documento_id text,
  tipo_documento_sigla text, -- nombre_abrev
  tipo_documento_desc text, -- nombre del tipo de documento
  tipo_documento_visibilidad text, -- visibilidad
  tipo_documento_esencia text, -- esencia
  tipo_documento_tipo_leido text, -- tipo_leido
  tipo_documento_nivel_firma text, -- nivel_firma
  eliminado boolean,
  fecha_desde text,
  fecha_hasta text,
  version text,
  vigente text,
  fecha_actualizacion text
);
CREATE TABLE sudocu_tmp.d_documento
(
  documento_numero_asignado text, 
  documento_uuid text, --id
  documento_tipo_documento_id text, -- id_tipo
  documento_titulo text, -- titulo
  documento_fecha text, -- fecha
  documento_estado text, -- estado
  documento_estado_desc text, -- de d_estado
  documento_version text, -- version
  documento_visibilidad text, -- visibilidad
  documento_nro text, -- nro
  documento text,
  ts timestamp,
  firmas text
);  

CREATE TABLE sudocu_tmp.d_tipo_evento
(
  tipo_evento_id text, -- id
  tipo_evento_nombre  text, -- nombre
  tipo_evento_nombre_plural  text, -- nombre_plural
  tipo_evento_desc  text, -- descripcion
  fecha_desde text,
  fecha_hasta text,
  version text,
  vigente text,
  fecha_actualizacion text
);
CREATE TABLE sudocu_tmp.d_documento_version
(
  documento_version_uuid text,
  documento_uuid text, --id_original
  documento_version_titulo text, -- titulo
  documento_version_fecha text, -- fecha
  documento_version_nro text, -- nro
  estado text,
  estado_desc text, -- de d_estado
  activo text, --activo
  visibilidad text, -- visibilidad
  ts timestamp,
  fecha_desde text,
  fecha_hasta text,
  version text,
  vigente text,
  fecha_actualizacion text
);  
CREATE TABLE sudocu_tmp.ft_evento
(
  evento_id text,
  documento_uuid text,
  documento_version_uuid text,
  tipo_evento_id text,
  circuito_id text,
  area_origen_id text,
  usuario_origen_id text,
  area_destino_id text,
  usuario_destino_id text,
  autorizacion_nivel text,
  autorizacion_estado text,
  accion text,
  usuario_uuid text,
  fecha_id text,
  anio_id text,
  mes_id text,
  hora_id text,
  fecha text,
  resultado text,
  atributos text,
  ts timestamp
);

----------AGREGA TABLAS PARA INDICADORES------------
CREATE TABLE IF NOT EXISTS sudocu_tmp.archivos
(
    id character varying,
    tipo_archivo character varying(2),
    filename character varying(1000),
    ext character varying(255),
    mimetype character varying(255),
    repositorio character varying(255),
    id_repo character varying(255),
    estado integer,
    ts timestamp without time zone,
    size bigint,
    paginas integer,
    firmado boolean,
    hash character varying,
    firmas text,
    path character varying 
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.config
(
    contexto character varying(255),
    clave character varying(255),
    valor text
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.documentos_numeradores
(
    id integer
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.documentos_templates
(
    id integer,
    fecha_creacion timestamp without time zone
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.documentos_relaciones
(
    id integer,
    id_documento character varying,
    id_documento_relacionado character varying,
    id_tipo_relacion integer,
    atributos text,
    ts timestamp without time zone,
    estado integer   
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.documentos_seguimientos
(
    id character varying,
    tipo character varying(20),
    ts timestamp with time zone
);
    
CREATE TABLE IF NOT EXISTS sudocu_tmp.documentos_contenedores
(
    id integer,
    publico boolean
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.migrations
(
    id integer,
    name character varying(255),
    run_on timestamp without time zone
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.pdf_templates
(
    id integer,
    fecha_creacion timestamp without time zone
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.personas
(
    id character varying,
    tipo character varying
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.ultimos_eventos
(
    id character varying,
    ts timestamp without time zone
);

CREATE TABLE IF NOT EXISTS sudocu_tmp.size_indexes_tables
(
    nombre_tabla character varying,
    valor_size integer,
    valor_indexes integer
);
</sql>
