            <default_value/>
            <description>nombre de la base de datos de wichi</description>
        </parameter>
        <parameter>
            <name>base_wichi_puerto</name>
            <default_value/>
            <description>puerto al en el que escucha el servidor de postgres de wichi</description>
        </parameter>
        <parameter>
            <name>base_wichi_usuario</name>
            <default_value/>
            <description>usuario que tiene acceso al servidor de postgres de wichi</description>
        </parameter>
        <parameter>
            <name>carga_directorioTemporalMoodle</name>
            <default_value/>
            <description>directorio temporal vac&#xed;o para armado del paquete</description>
        </parameter>
        <parameter>
            <name>paquete_directorio</name>
            <default_value>-</default_value>
            <description>&#x28;Opcional&#x29; si se especifica, al terminar deja una copia del paquete de datos wichi. Debe ser distinto de &#x22;-&#x22;</description>
        </parameter>
        <parameter>
            <name>paquete_encriptacion</name>
            <default_value>ninguna</default_value>
            <description>tipo de encriptaci&#xf3;n&#x3a; publica&#x7c;ninguna</description>
        </parameter>
        <parameter>
            <name>performance_commit_size</name>
            <default_value>10000</default_value>
            <description>cada cuantos insert se hace commit</description>
        </parameter>
    </parameters>
