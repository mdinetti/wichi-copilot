  <step>
    <name>base_pilaga</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_pilaga</connection>
    <sql>	--ft_movimientos -&#x3e; Gastos &#xa;	--Detalle de movimientos de gastos que ser&#xe1;n incluidos en la ft_movimientos&#xa;	SELECT 	pa.tramite&#xa;		, pa.paso&#xa;		, pa.paso_anterior&#xa;		, case when pa.ejercicio NOT IN &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29; AND &#x28;dm.etapa_presupuestaria &#x3d; &#x27;DE&#x27; OR dm.etapa_presupuestaria &#x3d; &#x27;PA&#x27;&#x29; then &#xa;			tr.fecha&#x3a;&#x3a;date &#xa;		  else &#xa;			tr.fecha_valor&#x3a;&#x3a;date &#xa;		  end as fecha_valor&#xa;		, pa.tipo_contenedor, pa.anio_contenedor, pa.nro_contenedor -- Expediente&#xa;		, pa.ejercicio&#x3a;&#x3a;integer AS ejercicio&#xa;		, case when pa.ejercicio NOT IN &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29; AND &#x28;dm.etapa_presupuestaria &#x3d; &#x27;DE&#x27; OR dm.etapa_presupuestaria &#x3d; &#x27;PA&#x27;&#x29; then &#xa;			tr.fecha_valor&#x3a;&#x3a;date &#xa;		  else &#xa;			tr.fecha&#x3a;&#x3a;date &#xa;		  end as fecha_movimiento&#xa;		, li.fecha_vencimiento&#x3a;&#x3a;date AS fecha_vencimiento&#xa;		, replace&#x28;replace&#x28;pa.descripcion,E&#x27;&#x5c;r&#x27;, &#x27;&#x27;&#x29;,E&#x27;&#x5c;n&#x27;,&#x27;&#x27;&#x29; as concepto_desc&#xa;		, dm.etapa_presupuestaria&#xa;		, substring&#x28;dm.partida,1,1&#x29; as tipo_ejercicio --&#x28;A&#x29;actual o &#x28;R&#x29;remanente&#xa;		, substring&#x28;dm.partida, 8,11&#x29;  as codup&#xa;		, substring&#x28;dm.partida, 3,4&#x29;   as codgru&#xa;		, substring&#x28;dm.partida, 20,2&#x29;  as codfuente&#xa;		, substring&#x28;dm.partida, 38,10&#x29; as codinciso&#xa;		, substring&#x28;dm.partida, 51,2&#x29;  as coddec&#xa;		, substring&#x28;dm.partida, 23,14&#x29; as codprog&#xa;		, substring&#x28;dm.partida, 56,1&#x29;  as codfun&#xa;		, substring&#x28;dm.partida, 54,1&#x29;  as codfi&#xa;		, case when dm.etapa_presupuestaria &#x3d; &#x27;CR&#x27; and pa.tipo_operacion &#x3d; &#x27;CRED&#x27; then &#x27;1&#x27;&#xa;		       when dm.etapa_presupuestaria &#x3d; &#x27;CR&#x27; and pa.tipo_operacion &#x3c;&#x3e; &#x27;CRED&#x27; then &#x27;2&#x27;&#xa;		  end as codcre&#xa;		, tramite.circuito as codgest -- gestion&#xa;		, case when dm.etapa_presupuestaria &#x3d; &#x27;CR&#x27; &#xa;			and pa.tipo_operacion &#x3d; &#x27;CRED&#x27; then dm.importe else 0.0 end as credito_original&#xa;		, case when dm.etapa_presupuestaria &#x3d; &#x27;CR&#x27; &#xa;			and &#x28;pa.tipo_operacion &#x3d; &#x27;CREM&#x27; &#xa;				OR pa.tipo_operacion &#x3d; &#x27;CRET&#x27; &#xa;				OR pa.tipo_operacion &#x3d; &#x27;CREA&#x27; &#xa;				OR pa.tipo_operacion &#x3d; &#x27;CTRD&#x27; &#xa;				OR pa.tipo_operacion &#x3d; &#x27;APIP&#x27;&#xa;				OR pa.tipo_operacion &#x3d; &#x27;CRDF&#x27;&#x29; then dm.importe else 0.0 end as credito_modificatorio&#xa;		, case when dm.etapa_presupuestaria &#x3d; &#x27;CR&#x27; then dm.importe else 0.0 end as credito&#xa;		, case when dm.etapa_presupuestaria &#x3d; &#x27;PR&#x27; then dm.importe else 0.0 end as preventivo&#xa;		, case when dm.etapa_presupuestaria &#x3d; &#x27;CD&#x27; then dm.importe else 0.0 end as compromiso&#xa;&#xa;		, case when pa.ejercicio &#x3d; &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29; AND dm.etapa_presupuestaria &#x3d; &#x27;DE&#x27; then dm.importe else 0.0 end as devengado&#xa;		, case when pa.ejercicio &#x3d; &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29; AND dm.etapa_presupuestaria &#x3d; &#x27;PA&#x27; then dm.importe else 0.0 end as pagado&#xa;		, case when pa.ejercicio NOT IN &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29; AND dm.etapa_presupuestaria &#x3d; &#x27;DE&#x27; then dm.importe else 0.0 end as devengado_ex&#xa;		, case when pa.ejercicio NOT IN &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29; AND dm.etapa_presupuestaria &#x3d; &#x27;PA&#x27; then dm.importe else 0.0 end as pagado_ex&#xa;&#xa;		, 0.0 as previsto_de_ingreso --Ingresos&#xa;		, 0.0 as estimado_de_ingreso --Ingresos&#xa;		, 0.0 as devengado_de_ingreso --Ingresos&#xa;		, 0.0 as cobrado --Ingresos&#xa;		, NULL as codrubro --Ingresos&#xa;		, NULL as codconcepto --Ingresos&#xa;		, substring&#x28;dm.partida, 49,1&#x29; as moneda &#xa;		, pa.proveedor_o_beneficiario as codpersona&#xa;		, pa.tipo_doc_ppal&#xa;		, pa.nro_doc_ppal&#xa;		, pa.anio_doc_ppal&#xa;		, pa.tipo_operacion&#xa;		, 0 as contribuyente_codigo&#xa;		, 0 as nivel_autorizacion_codigo&#xa;		, li.estado as estado_liquidacion_codigo&#xa;		, 0 as retenciones&#xa;		, 0 as disponibilidades&#xa;		, extract&#x28;month from tr.fecha_valor&#x29; as mes&#xa;		, 0 as codigo_ud &#xa;		, &#x27;0&#x27; as tipo_resolucion  &#xa;		, &#x27;0&#x27; as nro_resolucion  &#xa;		, 0 as anio_resolucion&#xa;&#xa;	FROM 	sau_gb_tramites as tramite&#xa;		INNER JOIN sau_gb_pasos as pa &#xa;			ON pa.tramite &#x3d; tramite.tramite&#xa;		INNER JOIN sau_gb_transacciones as tr &#xa;			ON tr.paso &#x3d; pa.paso&#xa;		INNER JOIN sau_no_mapeador_transaccional mt &#xa;			ON tr.transaccion &#x3d; mt.numero_en_gestion&#xa;		INNER JOIN sau_np_detalles_movimientos dm &#xa;			ON dm.mov_presupuestario_contable &#x3d; mt.mov_presupuestario_contable&#xa;		LEFT JOIN sau_li_liquidaciones li &#xa;			ON li.nro_operacion_original &#x3d; pa.paso AND li.estado &#x3c;&#x3e; &#x27;U&#x27;&#xa;	WHERE 	&#x28;pa.ejercicio &#x3d; &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29;&#xa;	        AND  dm.etapa_presupuestaria in &#x28; &#x27;CR&#x27;, &#x27;PR&#x27;, &#x27;CD&#x27;, &#x27;DE&#x27;,&#x27;PA&#x27;&#x29;&#x29; &#xa;     OR&#xa;			&#x28;pa.ejercicio NOT IN &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29;&#xa;	        AND  dm.etapa_presupuestaria in &#x28; &#x27;DE&#x27;,&#x27;PA&#x27;&#x29;&#x29;&#x3b;&#xa;	 </sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>193</xloc>
      <yloc>92</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

