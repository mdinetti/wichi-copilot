  <step>
    <name>obtiene_parametros</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>wichi</connection>
    <sql>select&#xa;coalesce&#x28;&#xa;    &#x28;select valor from parametro_instalacion&#xa;    where &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27; like instalacion_id &#x7c;&#x7c; &#x27;-&#x25;&#x27; and nombre &#x3d; &#x27;host&#x27;&#x29;&#xa;,&#x27;localhost&#x27;&#x29; as host,&#xa;coalesce&#x28;&#xa;    &#x28;select valor from parametro_instalacion&#xa;    where &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27; like instalacion_id &#x7c;&#x7c; &#x27;-&#x25;&#x27; and nombre &#x3d; &#x27;puerto&#x27;&#x29;&#xa;,&#x27;5432&#x27;&#x29; as puerto,&#xa;coalesce&#x28;&#xa;    &#x28;select valor from parametro_instalacion&#xa;    where &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27; like instalacion_id &#x7c;&#x7c; &#x27;-&#x25;&#x27; and nombre &#x3d; &#x27;nombre&#x27;&#x29;&#xa;,&#x27;siu_wichi&#x27;&#x29; as base,&#xa;coalesce&#x28;&#xa;    &#x28;select valor from parametro_instalacion&#xa;    where &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27; like instalacion_id &#x7c;&#x7c; &#x27;-&#x25;&#x27; and nombre &#x3d; &#x27;usuario&#x27;&#x29;&#xa;,&#x27;postgres&#x27;&#x29; as usuario,&#xa;coalesce&#x28;&#xa;    &#x28;select encode&#x28;decrypt&#x28;valor&#x3a;&#x3a;bytea,&#x27;wichikey&#x27;&#x3a;&#x3a;bytea,&#x27;3des&#x27;&#x3a;&#x3a;text&#x29;, &#x27;escape&#x27;&#x3a;&#x3a;text&#x29; AS valor from parametro_instalacion&#xa;    where &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27; like instalacion_id &#x7c;&#x7c; &#x27;-&#x25;&#x27; and nombre &#x3d; &#x27;clave&#x27;&#x29;&#xa;,&#x27;&#x27;&#x29; as clave,&#xa;coalesce&#x28;&#xa;    &#x28;select valor from parametro_instalacion&#xa;    where &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27; like instalacion_id &#x7c;&#x7c; &#x27;-&#x25;&#x27; and nombre &#x3d; &#x27;motor&#x27;&#x29;&#xa;,&#x27;localhost&#x27;&#x29; as carga_instalacion_g3&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>115</xloc>
      <yloc>299</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>valida_instalacion</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>wichi</connection>
    <sql>select&#xa;  i.instalacion_desc,&#xa;  f.fuente_dato_desc,&#xa;  i.instalacion_id&#xa;from public.d_instalacion i&#xa;inner join d_fuente_dato f&#xa;  on f.fuente_dato_id &#x3d; i.fuente_dato_id&#xa;where &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27; &#x3d; i.instalacion_id &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; i.instalacion_codigo&#xa;and i.fuente_dato_id &#x3d; 11&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>112</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

