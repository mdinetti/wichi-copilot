  <step>
    <name>leer ft tmp</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>select&#xa;  tipo_documento,&#xa;  expediente,&#xa;  numero_anterior,&#xa;  id_bien_patrimonial,&#xa;  numero_patrimonial,&#xa;  case&#xa;	when id_motivo_baja is not null then id_motivo_baja&#xa;	when fecha_baja is not null then &#x27;VAC&#xcd;O&#x2f;NULO&#x27;&#xa;	else &#x27;No dado de baja&#x27;&#xa;  end as id_motivo_baja,&#xa;  cast&#x28;id_alta as integer&#x29; as numero_alta,&#xa;  to_date&#x28;fecha_alta, &#x27;yyyy-MM-dd&#x27;&#x29; as fecha_alta,&#xa;  id_motivo_alta,&#xa;  id_estado_bien,&#xa;  f.id_catalogo_bien_patrimonial,&#xa;  cast&#x28;coalesce&#x28;dc.id_catalogo_bien_uso_padre,&#x27;0&#x27;&#x29; as integer&#x29; as id_catalogo_bien_uso_padre,&#xa;  a.codigo_asignado as codigo_area_asignada,&#xa;  id_ubicacion_fisica,&#xa;  f.id_oficina_patrimonio,&#xa;  id_tipo_bien,&#xa;  to_date&#x28;fecha_incorporacion, &#x27;yyyy-MM-dd&#x27;&#x29; as fecha_incorporacion,&#xa;  case when fecha_baja is null then 1 else 2 end as alta_baja_id,&#xa;  to_date&#x28;fecha_baja, &#x27;yyyy-MM-dd&#x27;&#x29; as fecha_baja,&#xa;  vida_util as vida_util,&#xa;  cast&#x28;valor_bien as numeric&#x28;15,2&#x29;&#x29; as valor_bien,&#xa;  cast&#x28;valor_residual as numeric&#x28;15,2&#x29;&#x29; as valor_residual,&#xa;  cast&#x28;amortizacion_acumulada as numeric&#x28;15,2&#x29;&#x29; as amortizacion_acumulada,&#xa;  cast&#x28;persona  as integer&#x29; as id_persona,&#xa;  expediente_baja,&#xa;  id_empleado_responsable_uso,&#xa;  1 as cant_bienes,&#xa;  &#x27;Y&#x27; as vigente -- campo para usar con los database lookup&#xa;from diaguita_tmp.ft_patrimonio f&#xa;left join diaguita_dsa.w_area a on a.codigo &#x3d; f.id_area_responsable&#xa;left join diaguita_tmp.d_catalogo_bienes dc on dc.id_catalogo_bien_patrimonial &#x3d; f.id_catalogo_bien_patrimonial&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

