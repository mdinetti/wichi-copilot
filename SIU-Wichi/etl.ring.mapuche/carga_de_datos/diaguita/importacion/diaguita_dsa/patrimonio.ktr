    <sql>        select case&#xa;          when catalogo_bien_nivel4_codigo &#x21;&#x3d; 0 then catalogo_bien_nivel4_codigo&#xa;          when catalogo_bien_nivel3_codigo &#x21;&#x3d; 0 then catalogo_bien_nivel3_codigo&#xa;          when catalogo_bien_nivel2_codigo &#x21;&#x3d; 0 then catalogo_bien_nivel2_codigo&#xa;          when catalogo_bien_nivel1_codigo &#x21;&#x3d; 0 then catalogo_bien_nivel1_codigo&#xa;          else 0 end&#xa;        as codigo,&#xa;        catalogo_bien_id&#xa;        from diaguita_dsa.d_catalogo_bien&#xa;</sql>
    <limit>0</limit>
