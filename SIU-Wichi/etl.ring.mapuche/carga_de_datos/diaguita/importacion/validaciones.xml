<?xml version="1.0" encoding="UTF-8" ?>

<!--

Este xml especifica validaciones a realizar
en la carga de datos a Wichi. Si no se cumple alguna
de las validaciones significa que los datos son
inválidos o que el extractor o importador es
inadecuado.

Mantener una copia de este archivo en los
exportadores y otra en los importadores, para poder
controlar que al actualizar una se actualice la otra.

-->


<validaciones id="validacionesDiaguita4"> <!-- el id debe cambiar con cualquier cambio en este xml -->
	<sistemaFuente>
		<codigo>7</codigo> <!-- el código del sistema fuente según estándares wichi -->
		<nombre>diaguita</nombre> <!-- valor permitido para el nombre del sistema fuente, sin el número de versión -->
		<obtencionDeSistema> <!-- cómo saber cuál es el sistema fuente (nombre sin versión) -->
			<sql><![CDATA[
                            select (case when(
                                    select count(distinct(table_name))
                                    from information_schema.tables
                                    where table_schema = 'diaguita'
                                    and table_name in (
                                      'scp_amortizaciones',
                                      'scp_actas_apertura',
                                      'scp_articulos',
                                      'scp_bienes_patrimoniales',
                                      'scp_monedas')
                            ) = 5 then 'diaguita' else 'no_diaguita' end) as sistema
			]]>
			</sql>
		</obtencionDeSistema>
	</sistemaFuente>
	<versionSistemaFuente>
		<versionesAceptadas> <!-- versiones del sistema fuente que pasan la validación -->
			<version>^2\.0\.0$</version>
			<version>^2\.1\..*$</version>
			<version>^2\.2\..*$</version>
			<version>^2\.3\..*$</version>
			<version>^2\.4\..*$</version>
			<version>^2\.5\..*$</version>
			<version>^2\.6\..*$</version>
			<version>^2\.7\..*$</version>
			<version>^3\.3\.0$</version>
			<version>^3\.3\.1$</version>
			<version>^3\.3\.2$</version>
			<version>^3\.3\.3$</version>
			<version>^3\.4\.0$</version>
		</versionesAceptadas>
		<versionesNoAceptadas> <!-- versiones del sistema fuente que NO pasan la validación -->
			<version>^0\..*</version>
			<version>^1\..*</version>
		</versionesNoAceptadas>
		<obtencionDeVersion> <!-- cómo saber cuál es la versión del sistema fuente -->
			<sql><![CDATA[
				select descripcion as "version"
				from diaguita.par_version
				where fecha = (select max(fecha) from diaguita.par_version)
			]]>
			</sql>
		</obtencionDeVersion>
	</versionSistemaFuente>
