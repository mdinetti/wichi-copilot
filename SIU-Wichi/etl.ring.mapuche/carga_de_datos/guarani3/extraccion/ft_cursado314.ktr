  <step>
    <name>cursado</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_guarani</connection>
    <sql>-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Generación del archivo LT_Cursadas.txt
-- Cuenta los siguiente:
--  * Promocionados en actas de promocion cerradas.
--  * Aprobados en actas de cursadas que no promocionaron
--  * Desaprobados en actas de cursadas y promocion
--  * Ausentes en actas de cursadas y promocion
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
WITH actas as (SELECT *  FROM negocio.sga_actas where origen IN ('R','P') AND estado = 'C'),
actas_det as (SELECT *  FROM negocio.sga_actas_detalle WHERE sga_actas_detalle.resultado IN ('A','R','U')
	AND sga_actas_detalle.estado = 'A'AND sga_actas_detalle.rectificado = 'N')
SELECT
	vw_comisiones.ubicacion ,
	cast(vw_comisiones.anio_academico as integer) as anio_academico,
	sga_periodos_genericos.periodo_generico_tipo AS tipoperiodo,
	vw_comisiones.periodo_nombre as periodo_lectivo,
	vw_comisiones.orden as orden_periodo_en_anio,
	sga_alumnos.alumno,
	sga_alumnos.propuesta,
	actas_det.plan_version as plan_version,
	vw_comisiones.elemento as actividad,
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (vw_comisiones.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
	(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	sga_catedras.catedra as catedra,
	vw_comisiones.comision as comision,
	CASE
	   WHEN actas.origen = 'P' AND actas_det.resultado = 'A' THEN 5 -- Promociono
	   WHEN actas.origen = 'P' AND actas_det.resultado &lt;&gt; 'A' THEN 104 -- No Promocionó (No promocionados y Ausentes)
       ELSE	actas_det.cond_regularidad
       END as condicion_regularidad,
	CASE
	   WHEN actas.origen = 'P' AND actas_det.resultado = 'A' THEN 'PR' -- Promociono
	   WHEN actas.origen = 'P' AND actas_det.resultado &lt;&gt; 'A' THEN 'NP' -- No Promocionó (No promocionados y Ausentes)
	   WHEN actas.origen = 'R' THEN actas_det.resultado  -- Resultados del acta de cursadas 
	END AS resultado,
	actas_det.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	actas_det.pct_asistencia,
	0 as actividad_comun,
	actas.nro_acta as acta,
	actas.estado as estado_acta,
	
	intentos.total_intentos as totalintentoscursada, -- Total de veces que ha intentado cursar la materia dentro de la carrera
	intentos.nro_intento as nrointentocursada,       -- Número de vez que intenta cursar la materia dentro de la carrera.
	
	1 as cantidad_registros_cursada,
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    0 as modalidad,
	sga_alumnos.persona,
	'select get_horas_trabajo_araucano('||sga_alumnos.persona||')' as query_horas_trabajadas,
	'select get_estado_civil('||sga_alumnos.persona||')' as query_estado_civil,
	'select get_localidad_per_lec('||sga_alumnos.persona||')' as query_localidad_per_lec,
	'select get_localidad_proc('||sga_alumnos.persona||')' as query_localidad_proc,
	'select get_costeo_estudios('||sga_alumnos.persona||')' as query_costeo_estudios,
	'select get_beca('||sga_alumnos.persona||')' as query_beca,
	'select get_tecno_internet('||sga_alumnos.persona||')' as query_tecno_internet,
	'select get_tecno_pc('||sga_alumnos.persona||')' as query_tecno_pc,
	'select get_idioma('||sga_alumnos.persona||')' as query_idioma,
	0 as discapacidad

FROM
	actas,
	actas_det LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = actas_det.escala_nota AND sga_escalas_notas_det.nota = actas_det.nota), 
	sga_planes_versiones,
	vw_comisiones
	   LEFT JOIN sga_catedras ON sga_catedras.catedra = vw_comisiones.catedra,
	sga_alumnos,
	mdp_personas,
	sga_propuestas,
	_wichi_intentos_cursadas as intentos,
	_wichi_ingreso_alumnos as ingreso,
	sga_periodos_genericos
	
WHERE actas_det.id_acta = actas.id_acta
        AND ((actas.origen = 'P') OR
             (actas.origen = 'R' AND actas_det.resultado &lt;&gt; 'A') OR
             (actas.origen = 'R' AND actas_det.resultado = 'A' AND 
              NOT EXISTS (SELECT 1 FROM _wichi_alumnos_promovidos as promo WHERE promo.comision = actas.comision AND promo.alumno = actas_det.alumno)) -- No cuento las promociones en actas de cursadas
            ) 
	AND vw_comisiones.comision = actas.comision
	AND vw_comisiones.periodo_generico = sga_periodos_genericos.periodo_generico
	AND sga_planes_versiones.plan_version = actas_det.plan_version
	AND sga_alumnos.alumno = actas_det.alumno
	AND sga_alumnos.persona = mdp_personas.persona
	AND sga_propuestas.propuesta = sga_alumnos.propuesta
	
	-- Intentos de cursada de la materia
	AND intentos.alumno = actas_det.alumno
	AND intentos.elemento = vw_comisiones.elemento
	AND intentos.comision = vw_comisiones.comision
	
	AND ingreso.alumno = sga_alumnos.alumno
	AND (${periodo} = 0 or vw_comisiones.anio_academico= ${periodo})

UNION ALL

-- Cursadas aprobadas en otras propuestas del alumno (Cursadas de actividades comunes con el plan actual)
SELECT
	vw_comisiones.ubicacion,
	cast(vw_comisiones.anio_academico as integer) as anio_academico,
	sga_periodos_genericos.periodo_generico_tipo AS tipoperiodo,
	vw_comisiones.periodo_nombre as periodo_lectivo,
	vw_comisiones.orden as orden_periodo_en_anio,
	sga_alumnos2.alumno , 
	sga_alumnos2.propuesta , 
	sga_planes_versiones2.plan_version as plan_version, -- actas_det.plan_version
	vw_comisiones.elemento as actididad, -- vw_comisiones.elemento
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (vw_comisiones.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
	(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	sga_catedras.catedra as catedra,
	vw_comisiones.comision as comision,
	CASE
	   WHEN actas.origen = 'P' AND actas_det.resultado = 'A' THEN 5 -- Promociono
           ELSE	actas_det.cond_regularidad
        END as condicion_regularidad,
	--actas_det.resultado as resultado,	
	CASE
	   WHEN actas.origen = 'P' AND actas_det.resultado = 'A' THEN 'PR' -- Promociono
	   ELSE actas_det.resultado 
	END AS resultado,
	
	actas_det.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	actas_det.pct_asistencia AS porcentajeasistencia,
	1 as actividad_comun,
	actas.nro_acta as acta,
	actas.estado as estado_acta,
	
	intentos.total_intentos as totalintentoscursada, -- Total de veces que ha intentado cursar la materia dentro de la carrera
	intentos.nro_intento as nrointentocursada,       -- Número de vez que intenta cursar la materia dentro de la carrera.
	
	1 as cantidad_registros_cursada,
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    0 as modalidad,
	sga_alumnos.persona,
	'select get_horas_trabajo_araucano('||sga_alumnos.persona||')' as query_horas_trabajadas,
	'select get_estado_civil('||sga_alumnos.persona||')' as query_estado_civil,
	'select get_localidad_per_lec('||sga_alumnos.persona||')' as query_localidad_per_lec,
	'select get_localidad_proc('||sga_alumnos.persona||')' as query_localidad_proc,
	'select get_costeo_estudios('||sga_alumnos.persona||')' as query_costeo_estudios,
	'select get_beca('||sga_alumnos.persona||')' as query_beca,
	'select get_tecno_internet('||sga_alumnos.persona||')' as query_tecno_internet,
	'select get_tecno_pc('||sga_alumnos.persona||')' as query_tecno_pc,
	'select get_idioma('||sga_alumnos.persona||')' as query_idioma,
	0 as discapacidad
FROM
	actas,
	actas_det LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = actas_det.escala_nota AND sga_escalas_notas_det.nota = actas_det.nota),
	sga_planes_versiones,
	vw_comisiones
	   LEFT JOIN sga_catedras ON sga_catedras.catedra = vw_comisiones.catedra,
	sga_alumnos,
	mdp_personas,
	sga_propuestas,
	_wichi_intentos_cursadas as intentos,
	_wichi_ingreso_alumnos as ingreso,
	sga_alumnos as sga_alumnos2,
	sga_planes_versiones as sga_planes_versiones2,
	sga_elementos_plan as sga_elementos_plan2,
	sga_elementos_revision as sga_elementos_revision2,
	sga_periodos_genericos
	
WHERE
	actas_det.id_acta = actas.id_acta
        AND ((actas.origen = 'P' AND actas_det.resultado = 'A') OR
             (actas.origen = 'R' AND actas_det.resultado &lt;&gt; 'A') OR
             (actas.origen = 'R' AND actas_det.resultado = 'A' AND 
              NOT EXISTS (SELECT 1 FROM _wichi_alumnos_promovidos as promo WHERE promo.comision = actas.comision AND promo.alumno = actas_det.alumno)) -- No cuento las promociones en actas de cursadas
            ) 
	AND vw_comisiones.comision = actas.comision
	AND vw_comisiones.periodo_generico = sga_periodos_genericos.periodo_generico
	AND sga_planes_versiones.plan_version = actas_det.plan_version
	AND sga_alumnos.alumno = actas_det.alumno
	AND sga_alumnos.persona = mdp_personas.persona
	
	-- Intentos de cursada en la otra propuesta
	AND intentos.alumno   = actas_det.alumno
	AND intentos.elemento = vw_comisiones.elemento
	AND intentos.comision = vw_comisiones.comision

	-- Otra propuesta del alumno  
	AND sga_alumnos2.persona = sga_alumnos.persona
	AND sga_alumnos2.propuesta &lt;&gt; sga_alumnos.propuesta
	AND sga_propuestas.propuesta = sga_alumnos2.propuesta
	AND sga_planes_versiones2.plan_version = sga_alumnos2.plan_version
	AND ingreso.alumno = sga_alumnos2.alumno
	AND sga_elementos_revision2.elemento = vw_comisiones.elemento
	AND sga_elementos_plan2.plan_version      = sga_alumnos2.plan_version
	AND sga_elementos_plan2.elemento_revision = sga_elementos_revision2.elemento_revision
	AND (${periodo} = 0 or vw_comisiones.anio_academico= ${periodo})</sql>
    <limit>0</limit>
