  <step>
    <name>d_procedencia</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>select proc_tmp.colegio_id,&#xa;	proc_tmp.colegio_desc,&#xa;	proc_tmp.ambito_desc,&#xa;    proc_tmp.sector_desc,&#xa;	proc_tmp.localidad_id,&#xa;	proc_tmp.localidad_desc,&#xa;    proc_tmp.dpto_partido_id,&#xa;    proc_tmp.dpto_partido_desc,&#xa;	proc_tmp.provincia_id,&#xa;	proc_tmp.provincia_desc,&#xa;	proc_tmp.pais_id,&#xa;	proc_tmp.pais_desc&#xa;from&#xa;&#x28;&#xa;select distinct co.colegio_id as colegio_id,&#xa;       co.colegio_desc,&#xa;	   co.ambito_desc,&#xa;       co.sector_desc,&#xa;       co.localidad_id as localidad_id,&#xa;       lo.localidad_desc,&#xa;	   lo.dpto_partido_id,&#xa;       lo.dpto_partido_desc,&#xa;       lo.provincia_id as provincia_id,&#xa;       pr.provincia_desc,&#xa;       pr.pais_id as pais_id,&#xa;       pa.pais_desc&#xa;&#xa;from guarani3_tmp.d_colegio co&#xa;left outer join guarani3_tmp.d_localidad lo on &#x28;co.localidad_id&#x3d;lo.localidad_id&#x29;&#xa;left outer join guarani3_tmp.d_provincia pr on &#x28;lo.provincia_id&#x3d;pr.provincia_id&#x29;&#xa;left outer join guarani3_tmp.d_pais pa on &#x28;pr.pais_id&#x3d;pa.pais_id&#x29;&#xa;&#x29; proc_tmp&#xa;--cruzo con la dimension lt_procedencia del dsa para obtener los datos nuevos&#xa;left join guarani3_dsa.d_procedencia proc on &#x28;proc.colegio_id &#x3d; proc_tmp.colegio_id&#x29;&#xa;	and proc_tmp.colegio_desc &#x3d; proc.colegio_desc&#xa;	and proc_tmp.ambito_desc &#x3d; proc.ambito_desc&#xa;	and proc_tmp.sector_desc &#x3d; proc.sector_desc&#xa;	and proc_tmp.localidad_id &#x3d; proc.localidad_id&#xa;	and proc_tmp.localidad_desc &#x3d; proc.localidad_desc&#xa;	and proc_tmp.dpto_partido_id &#x3d; proc.dpto_partido_id&#xa;    and proc_tmp.dpto_partido_desc &#x3d; proc.dpto_partido_desc&#xa;	and proc_tmp.provincia_id &#x3d; proc.provincia_id&#xa;	and proc_tmp.provincia_desc &#x3d; proc.provincia_desc&#xa;	and proc_tmp.pais_id &#x3d; proc.pais_id&#xa;	and proc_tmp.pais_desc &#x3d; proc.pais_desc&#xa;&#xa;where proc.colegio_id is null&#xa;	or proc.colegio_desc is null&#xa;	or proc.localidad_id is null&#xa;	or proc.localidad_desc is null&#xa;	or proc.dpto_partido_id is null&#xa;    or proc.dpto_partido_desc is null&#xa;	or proc.provincia_id is null&#xa;	or proc.provincia_desc is null&#xa;	or proc.pais_id is null&#xa;	or proc.pais_desc is null&#xa;&#x3b;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
