    <file>
      <name>${directorio_xml}/EsquemaKollaG3_${carga_instalacion_kolla}</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>xml</extention>
