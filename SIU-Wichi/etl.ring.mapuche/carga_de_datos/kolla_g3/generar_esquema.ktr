  </step>
  <step>
    <name>obtiene el texto del esquema</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_wichi</connection>
    <sql>SELECT distinct -1, -1, replace(s.texto,'@1',i.instalacion_codigo) AS texto
 FROM public.d_instalacion i, kolla_tmp.aux_strings s
 WHERE i.instalacion_id=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::int AND s.tipo='esquema-inicio-integracion' 
UNION 
SELECT distinct e.encuesta_codigo::integer, -1, 
  replace(replace(replace(replace(s.texto,'@2','(' || (SELECT array_to_string(array_agg(e2.encuesta_id ORDER BY 1),', ') FROM kolla.d_encuesta e2 WHERE e2.encuesta_codigo=e.encuesta_codigo) || ')'),
  '@1',regexp_replace(regexp_replace(translate(e.encuesta_desc,s_e.texto, s_n.texto), '[^a-zA-Z0-9?]', ' ', 'g'), '(( ){2,}|\t+)', ' ', 'g')),'@3','(' || (SELECT array_to_string(array_agg(e2.encuesta_id ORDER BY 1),'_') FROM kolla.d_encuesta e2 
  WHERE e2.encuesta_codigo=e.encuesta_codigo) || ')'),'@4','(' || e.unidad_gestion_desc || ')') AS texto
 FROM kolla.d_encuesta e, kolla_tmp.aux_strings s, kolla_tmp.aux_strings s_n, kolla_tmp.aux_strings s_e   
 WHERE e.instalacion_id::integer=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::integer AND
  s.tipo='cubo-inicio-integracion' AND s_n.tipo='caracteres-normales' AND s_e.tipo='caracteres-especiales' AND
  e.encuesta_id IN (SELECT distinct encuesta_id FROM kolla.ft_kolla_g3 entrevistas WHERE entrevistas.instalacion_id=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::integer)
UNION
SELECT distinct e.encuesta_codigo::integer, 0, 
  s.texto AS texto
 FROM kolla.d_encuesta e, kolla_tmp.aux_strings s   
 WHERE e.instalacion_id::integer=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::integer AND
  s.tipo='cubo-inicio-elemento' AND 
  e.encuesta_id IN (SELECT distinct encuesta_id 
                         FROM kolla.ft_kolla_g3 entrevistas 
                         WHERE entrevistas.instalacion_id=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::integer AND
                               entrevistas.elemento_id>0)
UNION 
SELECT distinct
  e.encuesta_codigo::integer, 
  pos.posicion::integer,
  replace(replace(replace(replace(replace(replace(replace(s.texto,'@90',translate(pos.bloque_nombre,s_e.texto, s_n.texto)||'&amp;#13;&amp;#10;'||translate(coalesce(pos.siete_pregunta_nombre,''),s_e.texto, s_n.texto)),'@6',case when pos.bloque_codigo::integer % 2 = 0 then '#1d891d;' else '#372476;' end),'@5',lpad(pos.posicion,4,'0')),'@4',substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)),'@3', pr.pregunta_codigo::text),'@1',pos.posicion),'@2',regexp_replace(regexp_replace(translate(pr.pregunta_desc,s_e.texto, s_n.texto), '[^a-zA-Z0-9?]', ' ', 'g'), '(( ){2,}|\t+)', ' ', 'g')) AS texto
 FROM kolla.d_encuesta e, kolla_tmp.posiciones pos, kolla_dsa.d_pregunta_respuesta pr,
      kolla_tmp.aux_strings s, kolla_tmp.aux_strings s_n, kolla_tmp.aux_strings s_e 
 WHERE (pos.componente_numero &lt;&gt; '11' OR (pos.componente_numero = '11' AND '${cantidades}' IN ('D', 'A'))) AND
       e.encuesta_codigo=pos.encuesta_codigo::integer AND pr.pregunta_codigo= pos.pregunta_codigo::integer AND 
       s.tipo='dimension' AND s_n.tipo='caracteres-normales' AND s_e.tipo='caracteres-especiales' AND 
       e.encuesta_id IN (SELECT distinct encuesta_id FROM kolla.ft_kolla_g3 entrevistas WHERE entrevistas.instalacion_id=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::integer)
UNION
SELECT distinct
  e.encuesta_codigo::integer, 
  pos.posicion::integer*1000+pos.posicion_cantidad::integer,
  replace(replace(replace(replace(replace(replace(replace(s.texto,'@90',translate(pos.bloque_nombre,s_e.texto, s_n.texto)||'&amp;#13;&amp;#10;'||translate(coalesce(pos.siete_pregunta_nombre,''),s_e.texto, s_n.texto)),'@6',case when pos.bloque_codigo::integer % 2 = 0 then '#1d891d;' else '#372476;' end),'@5',lpad(pos.posicion,4,'0')),'@4',substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)),'@8', pos.posicion_cantidad),'@1',pos.posicion),'@2',regexp_replace(regexp_replace(translate(pr.pregunta_desc,s_e.texto, s_n.texto), '[^a-zA-Z0-9?]', ' ', 'g'), '(( ){2,}|\t+)', ' ', 'g')) AS texto
 FROM kolla.d_encuesta e, kolla_tmp.posiciones pos, kolla_dsa.d_pregunta_respuesta pr,
      kolla_tmp.aux_strings s, kolla_tmp.aux_strings s_n, kolla_tmp.aux_strings s_e 
 WHERE '${cantidades}' IN ('M', 'A') AND 
       e.encuesta_codigo=pos.encuesta_codigo::integer AND pr.pregunta_codigo= pos.pregunta_codigo::integer AND
       pos.posicion_cantidad::integer > 0 AND 
       s.tipo='cantidad' AND s_n.tipo='caracteres-normales' AND s_e.tipo='caracteres-especiales' AND 
       e.encuesta_id IN (SELECT distinct encuesta_id FROM kolla.ft_kolla_g3 entrevistas WHERE entrevistas.instalacion_id=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::integer)
UNION
 SELECT distinct e.encuesta_codigo::integer, 999999, s.texto as texto
 FROM kolla.d_encuesta e, kolla_tmp.aux_strings s 
 WHERE s.tipo='cubo-fin' AND
  e.encuesta_id IN (SELECT distinct encuesta_id FROM kolla.ft_kolla_g3 entrevistas 
    WHERE entrevistas.instalacion_id=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::integer)
UNION
 SELECT distinct e.encuesta_codigo::integer, 999998, s.texto as texto
 FROM kolla.d_encuesta e, kolla_tmp.aux_strings s 
 WHERE s.tipo='cubo-fin-elemento' AND
  e.encuesta_id IN (SELECT distinct encuesta_id FROM kolla.ft_kolla_g3 entrevistas 
    WHERE entrevistas.instalacion_id=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::integer AND
          entrevistas.elemento_id>0)
UNION
 SELECT DISTINCT ug.unidad_generica_id+100000 AS id, 0,
    replace(replace(replace(s.texto,'@rol',ug.rol_desc),'@encuesta',' Encuestas'),'@unidad_analisis',ug.unidad_generica_desc) AS texto 
 FROM public.d_unidad_generica ug,
     kolla_tmp.aux_strings s
 WHERE ug.unidad_generica_id > 0 AND s.tipo='rol-inicio'
UNION
 SELECT DISTINCT ug.unidad_generica_id+100000 AS id, 99999999,
     s.texto AS texto 
 FROM public.d_unidad_generica ug,
     kolla_tmp.aux_strings s
 WHERE ug.unidad_generica_id > 0 AND s.tipo='rol-fin'
UNION
 SELECT DISTINCT ug.unidad_generica_id+100000 AS id, e.encuesta_codigo,
    replace(replace(replace(replace(s.texto,'@rol',ug.rol_desc),'@encuesta',
       regexp_replace(regexp_replace(translate(e.encuesta_desc,s_e.texto, s_n.texto), '[^a-zA-Z0-9?]', ' ', 'g'), '(( ){2,}|\t+)', ' ', 'g')),
       '@1','(' || (SELECT array_to_string(array_agg(e2.encuesta_id ORDER BY 1),'_') FROM kolla.d_encuesta e2 WHERE e2.encuesta_codigo=e.encuesta_codigo) || ')')
    ,'@unidad_analisis',ug.unidad_generica_desc) AS texto 
 FROM public.d_unidad_generica ug, (SELECT encuesta_codigo, encuesta_desc FROM kolla.d_encuesta WHERE encuesta_id>0 AND
                                   encuesta_id IN (SELECT distinct encuesta_id FROM kolla.ft_kolla_g3 entrevistas 
                                                          WHERE entrevistas.instalacion_id=substring('${carga_instalacion_kolla}',1, position('-' in '${carga_instalacion_kolla}')-1)::integer)) e,
     kolla_tmp.aux_strings s, kolla_tmp.aux_strings s_n, kolla_tmp.aux_strings s_e
 WHERE ug.unidad_generica_id > 0 AND s.tipo='rol-encuesta' AND s_n.tipo='caracteres-normales' AND s_e.tipo='caracteres-especiales'
UNION
 SELECT distinct 9999999, 9999999, s.texto as texto
 FROM kolla_tmp.aux_strings s 
 WHERE s.tipo='esquema-fin'
ORDER BY 1,2;</sql>
