      <logsubject>INFO</logsubject>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>752</xloc>
      <yloc>336</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
