			<columna nombre="respuesta_codigo_combinado" desc=""></columna>
		</archivo>
		<archivo nombre="ft_encuesta.txt" desc="">
			<columna nombre="instalacion_id" desc=""></columna>
			<columna nombre="encuestado_codigo" desc=""></columna>
