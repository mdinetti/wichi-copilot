			<columna nombre="siete_pregunta_nombre" desc=""></columna>
			<columna nombre="componente_numero" desc=""></columna>
			<columna nombre="posicion_cantidad" desc=""></columna>
		</archivo>
		<archivo nombre="d_pregunta_respuesta.txt" desc="">
