    <connection>siu_dsa</connection>
    <sql>SELECT&#xa;  id,&#xa;  institucion_id,&#xa;  cuadro_id,&#xa;  anio_informado_id,&#xa;  COALESCE&#x28;anio_ingreso_id,0&#x29; AS anio_ingreso_id,&#xa;  CASE 	WHEN anio_ingreso_id IS NULL THEN 0&#xa;		WHEN anio_ingreso_id &#x3e; 0 THEN anio_informado_id - anio_ingreso_id&#xa;        ELSE 0&#xa;  END AS anios,&#xa;  unidad_generica_id,&#xa;  idprovincia&#x3a;&#x3a;char&#x28;4&#x29; AS idprovincia,&#xa;  codigopostal&#x3a;&#x3a;char&#x28;10&#x29; AS codigopostal,&#xa;  facultad_codigo,&#xa;  titulo_codigo,&#xa;  facultad_actual_codigo,&#xa;  titulo_actual_codigo,&#xa;  tipo_titulo_codigo&#x3a;&#x3a;char&#x28;4&#x29; AS tipo_titulo_codigo,&#xa;  tipo_titulo_oferta_anio_codigo&#x3a;&#x3a;char&#x28;4&#x29; AS tipo_titulo_oferta_anio_codigo,&#xa;  trim&#x28;area_codigo&#x29;&#x3a;&#x3a;varchar&#x28;4&#x29; AS area_codigo,&#xa;  trim&#x28;genero_codigo&#x29;&#x3a;&#x3a;varchar AS genero_codigo,&#xa;  serie_codigo&#x3a;&#x3a;char&#x28;4&#x29; AS serie_codigo,&#xa;  subserie_codigo&#x3a;&#x3a;char&#x28;4&#x29; AS subserie_codigo,&#xa;  subserie_opcion_codigo&#x3a;&#x3a;char&#x28;4&#x29; AS subserie_opcion_codigo,&#xa;  pais_id&#x3a;&#x3a;smallint AS pais_codigo,&#xa;  actividad_academica_id&#x3a;&#x3a;int AS actividad_academica_codigo,&#xa;  opcion_procedencia_id&#x3a;&#x3a;int AS opcion_procedencia_id,&#xa;  padre_madre_id&#x3a;&#x3a;int AS padre_madre_id,&#xa;  origen_dato_id,&#xa;  0&#x3a;&#x3a;smallint AS duracion_teorica, 0&#x3a;&#x3a;smallint AS duracion_media, 0.0&#x3a;&#x3a;numeric&#x28;6,2&#x29; AS indice_duracion,&#xa;  cantidad,&#xa;  &#x27;Y&#x27; as vigente -- campo para usar con los database lookup&#xa;FROM kolla_tmp.ft_cuadro&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
