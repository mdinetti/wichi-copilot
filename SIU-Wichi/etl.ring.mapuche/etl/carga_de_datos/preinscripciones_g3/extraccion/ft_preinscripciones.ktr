  <step>
    <name>ft_preinscripciones</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_preinscripciones</connection>
    <sql>SELECT  responsable_academica, propuesta, ubicacion, modalidad, periodo_insc, date&#x28;fecha_preinscripcion&#x29; as fecha_preinscripcion, pp.estado as estado_preinsc,  &#xa;apellido &#x7c;&#x7c; &#x27;, &#x27; &#x7c;&#x7c; nombres as apyno,&#xa;tipo_documento,&#xa;nro_documento, &#xa;sexo&#x3a;&#x3a;integer, fecha_nacimiento, nacionalidad,&#xa;loc_nacimiento, estado_civil, alu_est_civil_uh,&#xa;CASE &#xa;	WHEN turno_preferido &#x3d; &#x27;M&#x27; THEN 1&#xa;    WHEN turno_preferido &#x3d; &#x27;T&#x27; THEN 2&#xa;    WHEN turno_preferido &#x3d; &#x27;N&#x27; THEN 3&#xa;    ELSE 0&#xa;END as turno_preferido,&#xa;colegio_secundario, titulo_secundario, anio_egreso_sec,&#xa;CASE&#xa;	WHEN existe_trab_alum IS NULL OR &#x28;existe_trab_alum &#x3d; 1 AND hora_sem_trab_alum IS NULL&#x29; THEN &#x27;-8&#x27; &#xa;	WHEN existe_trab_alum &#x3d; 1 THEN hora_sem_trab_alum &#xa;	WHEN existe_trab_alum &#x3d; 4 THEN &#x27;-8&#x27;   &#xa;	ELSE &#x27;-9&#x27; &#xa;END  as alu_trabajo,&#xa; --sit_laboral_alu,&#xa;pertenece_pueblo_originario, pueblo_originario, pueblo_originario_otro,&#xa;identidad_genero, identidad_genero_otro, &#xa;celular_numero, e_mail,&#xa;apellido_elegido &#x7c;&#x7c; &#x27;, &#x27; &#x7c;&#x7c; nombres_elegido as apyno_elegido, &#xa;apellido_padre &#x7c;&#x7c; &#x27;, &#x27; &#x7c;&#x7c; nombres_padre as apyno_padre, &#xa;apellido_madre &#x7c;&#x7c; &#x27;, &#x27; &#x7c;&#x7c; nombres_madre as apyno_madre, &#xa;sit_laboral_padre, padre_trab_ocup, sit_laboral_madre, madre_trab_ocup,&#xa;--sit_actual_padre, sit_actual_madre, &#xa;CASE WHEN padre_vive &#x3d; &#x27;S&#x27; THEN &#x27;V&#x27;&#xa;ELSE padre_vive END as sit_actual_padre, &#xa;CASE WHEN madre_vive &#x3d; &#x27;S&#x27; THEN &#x27;V&#x27;&#xa;ELSE madre_vive END as sit_actual_madre,&#xa;CASE WHEN ult_est_cur_padre &#x3d; 12 THEN 13&#xa;	WHEN &#x28;ult_est_cur_padre is null&#x29; THEN 0&#xa;	WHEN &#x28;ult_est_cur_padre &#x3d; 13&#x29; THEN -2&#xa;	WHEN ult_est_cur_padre &#x3d; 14 THEN 12&#xa;	ELSE ult_est_cur_padre END as nivel_estudio_padre,  &#xa;CASE WHEN ult_est_cur_madre &#x3d; 12 THEN 13&#xa;	WHEN &#x28;ult_est_cur_madre is null&#x29; THEN 0&#xa;	WHEN &#x28;ult_est_cur_madre &#x3d; 13&#x29; THEN -2&#xa;	WHEN ult_est_cur_madre &#x3d; 14 THEN 12&#xa;	ELSE ult_est_cur_madre END as nivel_estudio_madre, &#xa;tipo_allegado, apellido_pers_alleg &#x7c;&#x7c; &#x27;, &#x27; &#x7c;&#x7c; nombre_pers_alleg as apyno_pers_alleg, &#xa;&#x28;CASE WHEN alu_cos_est_ap_fam &#x3d; &#x27;S&#x27; THEN &#x27;familiar-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_cos_est_plsoc &#x3d; &#x27;S&#x27; THEN &#x27;plan_social-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_cos_est_trab &#x3d; &#x27;S&#x27; THEN &#x27;trabajo-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_cos_est_beca &#x3d; &#x27;S&#x27; THEN &#x27;beca-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_cos_est_otra &#x3d; &#x27;S&#x27; THEN &#x27;otro-&#x27; ELSE &#x27;&#x27; END&#x29; as costeo_estudios,&#xa;tiene_beca,&#xa;&#x28;CASE WHEN alu_tec_pc_casa &#x3d; &#x27;S&#x27; THEN &#x27;casa-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_tec_pc_trab &#x3d; &#x27;S&#x27; THEN &#x27;trabajo-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_tec_pc_univ &#x3d; &#x27;S&#x27; THEN &#x27;universidad-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_tec_pc_otro &#x3d; &#x27;S&#x27; THEN &#x27;otro-&#x27; ELSE &#x27;&#x27; END&#x29; as tecno_pc,&#xa;&#xa;&#x28;CASE WHEN alu_tec_int_movil &#x3d; &#x27;S&#x27; THEN &#x27;movil-&#x27; ELSE &#x27;&#x27; END &#xa;    &#x7c;&#x7c; CASE WHEN alu_tec_int_casa &#x3d; &#x27;S&#x27; THEN &#x27;casa-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_tec_int_trab &#x3d; &#x27;S&#x27; THEN &#x27;trabajo-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_tec_int_univ &#x3d; &#x27;S&#x27; THEN &#x27;universidad-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_tec_int_otro &#x3d; &#x27;S&#x27; THEN &#x27;lugar-&#x27; ELSE &#x27;&#x27; END&#x29; as tecno_int,&#xa;&#xa;&#x28;CASE WHEN alu_idioma_ingl&#x3a;&#x3a;integer in &#x28;1,2,3&#x29; THEN &#x27;Ingles-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_idioma_alem&#x3a;&#x3a;integer in &#x28;1,2,3&#x29; THEN &#x27;Alem&#xe1;n-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_idioma_fran&#x3a;&#x3a;integer in &#x28;1,2,3&#x29; THEN &#x27;Franc&#xe9;s-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_idioma_ital&#x3a;&#x3a;integer in &#x28;1,2,3&#x29; THEN &#x27;Italiano-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_idioma_port&#x3a;&#x3a;integer in &#x28;1,2,3&#x29; THEN &#x27;Portugu&#xe9;s-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_idioma_chino&#x3a;&#x3a;integer in &#x28;1,2,3&#x29; THEN &#x27;Chino-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN alu_idioma_otro is not null THEN &#x27;Otro-&#x27; ELSE &#x27;&#x27; END&#x29; as idioma ,&#xa;&#xa;condicion_discapacidad,&#xa;tiene_cud,&#xa;&#x28;CASE WHEN disc_auditiva &#x3d; &#x27;S&#x27; THEN &#x27;disc_auditiva-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN disc_visual &#x3d; &#x27;S&#x27; THEN &#x27;disc_visual-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN disc_motora &#x3d; &#x27;S&#x27; THEN &#x27;disc_motora-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN disc_cond_psicosocial &#x3d; &#x27;S&#x27; THEN &#x27;disc_cond_psicosocial-&#x27; ELSE &#x27;&#x27; END &#xa;	&#x7c;&#x7c; CASE WHEN disc_otra &#x3d; &#x27;S&#x27; THEN &#x27;disc_otra-&#x27; ELSE &#x27;&#x27; END &#x29; as discapacidad,&#xa;&#xa;cant_hijos_alum, &#xa;vive_actual_con, &#xa;obra_social_alu,  &#xa;loc_per_lect, &#xa;loc_proc, &#xa;es_celiaco, adeuda_materias --, p.estado&#xa;FROM public.sga_preinscripcion_propuestas pp LEFT JOIN public.sga_preinscripcion p ON &#x28;pp.id_preinscripcion &#x3d; p.id_preinscripcion&#x29;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>256</xloc>
      <yloc>224</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

