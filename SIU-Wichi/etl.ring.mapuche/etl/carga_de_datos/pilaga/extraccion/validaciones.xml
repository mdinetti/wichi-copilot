<?xml version="1.0" encoding="UTF-8" ?>

<!--

Este xml especifica validaciones a realizar
en la carga de datos a Wichi. Si no se cumple alguna
de las validaciones significa que los datos son
inválidos o que el extractor o importador es
inadecuado.

Mantener una copia de este archivo en los
exportadores y otra en los importadores, para poder
controlar que al actualizar una se actualice la otra.

-->


<validaciones id="validacionesPilaga6"> <!-- el id debe cambiar con cualquier cambio en este xml -->
	<sistemaFuente>
		<codigo>3</codigo> <!-- el código del sistema fuente según estándares wichi -->
		<nombre>pilaga</nombre> <!-- valor permitido para el nombre del sistema fuente, sin el número de versión -->
		<obtencionDeSistema> <!-- cómo saber cuál es el sistema fuente (nombre sin versión) -->
			<sql><![CDATA[
                            select (case when(
                                    select count(distinct(table_name))
                                    from information_schema.tables
                                    where table_schema = 'public'
                                    and table_name in (
                                      'sau_te_bancos',
                                      'sau_np_elementos',
                                      'sau_no_comprobantes',
                                      'sau_no_comprobantes_detalle',
                                      'sau_no_documentacion_tipos')
                            ) = 5 then 'pilaga' else 'no_pilaga' end) as sistema
			]]>
			</sql>
		</obtencionDeSistema>
	</sistemaFuente>
	<versionSistemaFuente>
		<versionesAceptadas> <!-- versiones del sistema fuente que pasan la validación -->
			<version>^3\.0\..*$</version>
			<version>^3\.1\..*$</version>
			<version>^3\.2\..*$</version>
			<version>^3\.3\..*$</version>
			<version>^3\.4\..*$</version>
			<version>^3\.5\..*$</version>
			<version>^3\.6\..*$</version>
			<version>^3\.7\..*$</version>
			<version>^3\.8\..*$</version>
			<version>^3\.9\..*$</version>
			<version>^3\.10\..*$</version>
			<version>^3\.11\..*$</version>
			<version>^3\.12\..*$</version>
			<version>^3\.13\.0$</version>
		</versionesAceptadas>
		<versionesNoAceptadas> <!-- versiones del sistema fuente que NO pasan la validación -->
			<version>^0\..*</version>
			<version>^1\.4\..*</version>
			<version>^1\.5\..*</version>
			<version>^1\.6\..*</version>
			<version>^1\.7\..*</version>
			<version>^1\.8\..*</version>
			<version>^1\.9\..*</version>
			<version>^1\.10\..*</version>
			<version>^1\.11\..*</version>
			<version>^1\.12\.1</version>
			<version>^2\.0\..*$</version>
			<version>^2\.1\..*$</version>
			<version>^2\.2\..*$</version>
			<version>^2\.3\..*$</version>
		</versionesNoAceptadas>
		<obtencionDeVersion> <!-- cómo saber cuál es la versión del sistema fuente -->
			<sql><![CDATA[
				select v.descripcion as "version"
				from par_version v
				where v."version" = (
				  select max("version")
				  from par_version)
			]]>
			</sql>
		</obtencionDeVersion>
	</versionSistemaFuente>
