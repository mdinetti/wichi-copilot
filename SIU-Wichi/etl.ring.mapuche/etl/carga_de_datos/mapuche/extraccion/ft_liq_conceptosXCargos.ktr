  <step>
    <name>ft_liq_conceptosXCargos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_mapuche</connection>
    <sql>WITH ant_liq as (SELECT distinct nro_cargo, nov1_conce as antiguedad_liq, ano_retro, mes_retro  FROM mapuche.dh21 WHERE codn_conce = ${cod_antiguedad}),
     dias_trab as (SELECT distinct nro_liqui, nro_cargo, nov1_conce as dias_trabajados, ano_retro, mes_retro  FROM mapuche.dh21 WHERE codn_conce = -51)
SELECT	${periodo_info} AS periodo_info,
		dh21.nro_liqui AS nro_liquidacion,
		dh21.codn_conce,
		dh21.nro_cargo,
		dh21.nro_legaj,
		CASE 
		WHEN dh21.codn_area &lt; 10 THEN '0' || dh21.codn_area::TEXT ELSE dh21.codn_area::TEXT END || 
                CASE 
               	WHEN dh21.codn_subar &lt; 10 THEN '00' || dh21.codn_subar::TEXT 
                WHEN dh21.codn_subar &lt; 100 THEN '0' || dh21.codn_subar::TEXT 
                ELSE dh21.codn_subar::TEXT 
                END ||
                CASE 
               	WHEN dh21.codn_subsubar &lt; 10 THEN '00' || dh21.codn_subsubar::TEXT 
                WHEN dh21.codn_subsubar &lt; 100 THEN '0' || dh21.codn_subsubar::TEXT 
                ELSE dh21.codn_subsubar::TEXT 
                END AS unidad_presupuestaria, 
		dh21.tipo_ejercicio,
		dh21.codn_grupo_presup,
		dh21.codn_fuent,
		CASE WHEN (SELECT dh35.tipo_carac FROM mapuche.dh35 WHERE dh35.tipo_escal = dh21.tipoescalafon 
        AND dh35.codc_carac = (SELECT codc_carac FROM mapuche.dh03 WHERE dh03.nro_legaj = dh21.nro_legaj AND dh03.nro_cargo = dh21.nro_cargo)) = 'T'
		THEN (SELECT CASE WHEN (SELECT SUBSTRING(dh17.objt_gtote FROM 1 FOR 1) || '.' || SUBSTRING(dh17.objt_gtote FROM 2 FOR 1)
		|| '.' || SUBSTRING(dh17.objt_gtote FROM 3 FOR 1)
		FROM mapuche.dh17 WHERE dh17.codn_conce = dh21.codn_conce) IS NULL THEN '0.0.0'
		ELSE  (SELECT SUBSTRING(dh17.objt_gtote FROM 1 FOR 1) || '.' || SUBSTRING(dh17.objt_gtote FROM 2 FOR 1)
		|| '.' || SUBSTRING(dh17.objt_gtote FROM 3 FOR 1)
		FROM mapuche.dh17 WHERE dh17.codn_conce = dh21.codn_conce) END
		)
		ELSE (SELECT CASE WHEN (SELECT SUBSTRING(dh17.objt_gtope FROM 1 FOR 1) || '.' || SUBSTRING(dh17.objt_gtope FROM 2 FOR 1)
		|| '.' || SUBSTRING(dh17.objt_gtope FROM 3 FOR 1)
		FROM mapuche.dh17 WHERE dh17.codn_conce = dh21.codn_conce) IS NULL THEN '0.0.0'
		ELSE  (SELECT SUBSTRING(dh17.objt_gtope FROM 1 FOR 1) || '.' || SUBSTRING(dh17.objt_gtope FROM 2 FOR 1)
		|| '.' || SUBSTRING(dh17.objt_gtope FROM 3 FOR 1)
		FROM mapuche.dh17 WHERE dh17.codn_conce = dh21.codn_conce) END
		)END AS obj_gt, --En caso de que el concepto no se encuentre en dh17, se decidio ponerlo en 0.0.0
		CASE  WHEN dh21.codn_progr &lt; 10 THEN '0' || dh21.codn_progr::TEXT ELSE dh21.codn_progr::TEXT END ||
		CASE  WHEN dh21.codn_subpr &lt; 10 THEN '0' || dh21.codn_subpr::TEXT ELSE dh21.codn_subpr::TEXT END ||
		CASE  WHEN dh21.codn_proye &lt; 10 THEN '0' || dh21.codn_proye::TEXT ELSE dh21.codn_proye::TEXT END ||
		CASE  WHEN dh21.codn_activ &lt; 10 THEN '0' || dh21.codn_activ::TEXT ELSE dh21.codn_activ::TEXT END ||
		CASE  WHEN dh21.codn_obra &lt; 10 THEN '0' || dh21.codn_obra::TEXT ELSE dh21.codn_obra::TEXT END AS red,
		dh21.codn_final,
		dh21.codn_funci,
		dh21.impp_conce,
        vinculos.nro_cargo_base,
		dh24.porc_ipres::text,
		ant_liq.antiguedad_liq,
		dias_trab.dias_trabajados,
		dh21.ano_retro::TEXT as anio_retro,			
		CASE WHEN dh21.mes_retro = 0 OR  dh21.mes_retro >9 THEN dh21.mes_retro::TEXT
			ELSE '0' || dh21.mes_retro::TEXT END AS mes_retro,
		recibos.nro_recibo,
		dh21.nro_orimp,
		1 AS cant_cargos,
	    dh21.nov1_conce,
	    dh21.nov2_conce
FROM mapuche.dh21 LEFT JOIN public.vinculos ON (dh21.nro_cargo = vinculos.nro_cargo)
LEFT JOIN ant_liq ON (dh21.nro_cargo = ant_liq.nro_cargo AND dh21.ano_retro = ant_liq.ano_retro AND dh21.mes_retro = ant_liq.mes_retro)
LEFT JOIN dias_trab ON (dh21.nro_cargo = dias_trab.nro_cargo AND dh21.nro_liqui = dias_trab.nro_liqui AND dh21.ano_retro = dias_trab.ano_retro AND dh21.mes_retro = dias_trab.mes_retro)
LEFT JOIN mapuche.dh24 ON (dh21.nro_cargo = dh24.nro_cargo AND dh21.codn_progr = dh24.codn_progr AND dh21.codn_subpr = dh24.codn_subpr AND
  dh21.codn_proye = dh24.codn_proye AND dh21.codn_activ = dh24.codn_activ AND dh21.codn_obra = dh24.codn_obra AND
  dh21.codn_fuent = dh24.codn_fuent AND dh21.codn_area = dh24.codn_area AND dh21.codn_subar = dh24.codn_subar AND
  dh21.codn_final = dh24.codn_final AND dh21.codn_funci = dh24.codn_funci AND dh21.codn_grupo_presup = dh24.codn_grupo_presup AND
  dh21.tipo_ejercicio = dh24.tipo_ejercicio AND dh21.codn_subsubar = dh24.codn_subsubar )
  LEFT JOIN mapuche.dhr2 recibos ON (recibos.nro_liqui = dh21.nro_liqui AND recibos.nro_legaj= dh21.nro_legaj  AND recibos.nro_cargo = dh21.nro_cargo AND recibos.anulado is false)
WHERE
		dh21.nro_liqui IN (SELECT nro_liqui FROM mapuche.dh22 WHERE (per_liano , per_limes) = (SELECT	per_anoct, per_mesct FROM mapuche.dh99))
		AND dh21.codn_conce > 0
ORDER BY nro_liquidacion,dh21.nro_legaj,dh21.nro_cargo,dh21.codn_conce</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
