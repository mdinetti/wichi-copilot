    <fields>
      <field>
        <name>periodo_info</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal>,</decimal>
        <group>,</group>
        <nullif>-</nullif>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>nro_liquidacion</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal>,</decimal>
        <group>,</group>
        <nullif>-</nullif>
        <trim_type>none</trim_type>
        <length>15</length>
        <precision>-1</precision>
      </field>
