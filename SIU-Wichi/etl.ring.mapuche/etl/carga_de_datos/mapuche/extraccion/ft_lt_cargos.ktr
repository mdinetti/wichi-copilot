  <step>
    <name>ft_lt_cargos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_mapuche</connection>
    <sql>WITH cargos AS (
    SELECT distinct nro_cargo FROM mapuche.dh03 dh03
        WHERE (fec_alta &lt; (${periodo_actual}::character varying)::date)
              AND (fec_baja IS NULL OR fec_baja >= (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE)
              AND dh03.nro_legaj IN (SELECT nro_legaj FROM mapuche.dh01 WHERE tipo_estad &lt;&gt; 'P' UNION SELECT distinct nro_legaj FROM mapuche.dh21)
    UNION
    SELECT distinct nro_cargo FROM mapuche.dh03 dh03
        WHERE (fec_alta &lt; (${periodo_actual}::character varying)::date) AND dh03.nro_cargo IN (SELECT nro_cargo FROM mapuche.dh21 WHERE dh21.nro_legaj = nro_legaj AND dh21.codn_conce > 0 AND dh21.nro_orimp > 0)
              AND dh03.nro_legaj IN (SELECT nro_legaj FROM mapuche.dh01 WHERE tipo_estad &lt;&gt; 'P' UNION SELECT distinct nro_legaj FROM mapuche.dh21)
)
     SELECT
${periodo_info} AS periodo_info,
dh03.nro_cargo,
dh03.nro_legaj,
dh03.codc_uacad,
get_nudo(dh03.codc_uacad,dh03.codc_regio,'''${ona}'''::text, ${cod_pres}::text) as nudo, --codc_uacad, --sede, --ona , cod_pres
coddependesemp AS dependencia_desemp_id,
codc_categ,
codc_agrup,
(CASE
WHEN (SELECT dh18.nro_cargo FROM mapuche.dh18 WHERE dh18.nro_cargo = dh03.nro_cargo AND (fec_desde &lt; (${periodo_actual}::character varying)::date )
AND (fec_hasta IS NULL OR fec_hasta >= (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE) LIMIT 1) IS NOT NULL THEN 1
WHEN (SELECT dh90.tipoasociacion FROM mapuche.dh90 WHERE dh90.nro_cargo = dh03.nro_cargo) = 'S' THEN 1
WHEN (SELECT dh90.tipoasociacion FROM mapuche.dh90 WHERE dh90.nro_cargoasociado = dh03.nro_cargo AND dh90.tipoasociacion = 'S' LIMIT 1) = 'S' THEN 1
ELSE 0 END) AS subrogancia,

   (CASE
WHEN (SELECT dh18.nro_cargo FROM mapuche.dh18 WHERE dh18.nro_cargo = dh03.nro_cargo AND (fec_desde &lt; (${periodo_actual}::character varying)::DATE ) AND (fec_hasta IS NULL OR fec_hasta >= (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE) LIMIT 1) IS NOT NULL
THEN (SELECT dh18.codc_categ FROM mapuche.dh18 WHERE dh18.nro_cargo = dh03.nro_cargo AND (fec_desde &lt; (${periodo_actual}::character varying)::DATE ) AND (fec_hasta IS NULL OR fec_hasta >= (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE) LIMIT 1)
WHEN (SELECT dh90.tipoasociacion FROM mapuche.dh90 WHERE dh90.nro_cargo = dh03.nro_cargo) = 'S' THEN (SELECT d2.codc_categ FROM mapuche.dh03 d2 WHERE d2.nro_cargo in (SELECT dh90.nro_cargoasociado FROM mapuche.dh90 WHERE dh90.nro_cargo = dh03.nro_cargo AND dh90.tipoasociacion = 'S'))
WHEN (SELECT dh90.tipoasociacion FROM mapuche.dh90 WHERE dh90.nro_cargoasociado = dh03.nro_cargo AND dh90.tipoasociacion = 'S' LIMIT 1) = 'S' THEN (SELECT d2.codc_categ FROM mapuche.dh03 d2 WHERE d2.nro_cargo in (SELECT dh90.nro_cargoasociado FROM mapuche.dh90 WHERE dh90.nro_cargoasociado = dh03.nro_cargo AND dh90.tipoasociacion = 'S' LIMIT 1))
ELSE 'SIN CATEGORIA SUBROGADA' END) as categoria_subrogada,

(SELECT dh35.tipo_escal ||
(CASE  WHEN dh35.nro_orden &lt; 10 THEN '0' || dh35.nro_orden::TEXT ELSE dh35.nro_orden::TEXT END) FROM mapuche.dh35
WHERE dh35.codc_carac = dh03.codc_carac AND dh35.tipo_escal = (SELECT tipo_escal FROM mapuche.dh11 WHERE codc_categ = dh03.codc_categ)) AS caracter_id,

(CASE WHEN (SELECT dh90.nro_cargo FROM mapuche.dh90 WHERE dh90.nro_cargo = dh03.nro_cargo) IS NOT NULL THEN 1
WHEN (SELECT dh90.nro_cargo FROM mapuche.dh90 WHERE dh90.nro_cargoasociado = dh03.nro_cargo LIMIT 1) IS NOT NULL THEN 2
ELSE 0 END) AS asociado_id,
COALESCE( (SELECT CASE WHEN (dl02.es_remunerada IS true) AND (dl02.porcremuneracion > 0) THEN 2
		   WHEN (dl02.es_absorcion IS true) THEN 1
		   ELSE 3  END as estado
		   FROM mapuche.dh05 dh05 JOIN mapuche.dl02 dl02 ON dh05.nrovarlicencia=dl02.nrovarlicencia
		   WHERE (fec_alta &lt; (${periodo_actual}::character varying)::date)
		   AND (fec_baja IS NULL OR fec_baja >= (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE)
		   AND (fec_desde &lt; (${periodo_actual}::character varying)::DATE)
		   AND (fec_hasta IS NULL OR fec_hasta >= (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE)
		   AND (dh03.nro_legaj=dh05.nro_legaj OR dh03.nro_cargo=dh05.nro_cargo) ORDER BY estado DESC, nro_cargo DESC LIMIT 1),
		 (SELECT 1 FROM mapuche.dh03 dh03int WHERE dh03.nro_cargo= dh03int.nro_cargo
		  AND (dh03int.fec_alta &lt; (${periodo_actual}::character varying)::DATE)		  
		  AND (dh03int.fec_baja IS NULL OR dh03int.fec_baja >= (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE) LIMIT 1),  0) AS estado_del_cargo,
   
(CASE  WHEN (SELECT dh31.cant_horas FROM mapuche.dh31 WHERE dh31.codc_dedic = (SELECT dh11.codc_dedic FROM mapuche.dh11 WHERE dh11.codc_categ = dh03.codc_categ)) > 0
THEN (SELECT dh31.cant_horas FROM mapuche.dh31 WHERE dh31.codc_dedic = (SELECT dh11.codc_dedic FROM mapuche.dh11 WHERE dh11.codc_categ = dh03.codc_categ))
WHEN dh03.hs_dedic = 0 THEN dh03.horassemanales
ELSE dh03.hs_dedic END) AS horas,

0 AS antiguedad_en_escalafon,--Se calcula afuera

    CASE WHEN (100 - dh03.porc_aplic) = 100 THEN (100 - dh03.porc_aplic) || '.00'
WHEN (100 - dh03.porc_aplic) = 0 THEN '00' || (100 - dh03.porc_aplic) || '.00'
ELSE '0' || (100 - dh03.porc_aplic)
END AS porcentaje_reduccion_horaria,

(CASE WHEN dh03.nro_cargo IN (SELECT dh03.nro_cargo FROM mapuche.dh03 WHERE ((fec_alta &lt; (${periodo_actual}::character varying)::date)
AND (fec_baja IS NULL OR fec_baja >= (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE)))
THEN 1 ELSE 0 END) AS cant_cargos_activos,

    COALESCE(max(
                    CASE WHEN (codn_conce = -51) AND (nro_orimp = 0) AND (ano_retro = 0) AND (mes_retro = 0) THEN (dh21.nov1_conce/30)*100
                    ELSE '0' END
                    )::TEXT, '0.00') as porcentaje_trabajado_en_el_mes,
        COALESCE(max(
                    CASE WHEN (codn_conce > 0) AND (nro_orimp > 0)  THEN 1
                    ELSE 0 END
                    ), 0) as cant_cargos_liq,
       0 as importe_neto,
       0 as importe_bruto,
       0 as importe_gasto_total,
                   
dh03.codc_regio AS regional,
to_char(fec_alta, 'DD/MM/YYYY')  AS fecha_alta,
to_char(fec_baja, 'DD/MM/YYYY')  AS fecha_baja,
    vinculos.nro_cargo_base,
(SELECT dh11.tipo_escal FROM mapuche.dh11 WHERE dh11.codc_categ = dh03.codc_categ) AS tipo_escalafon,
(SELECT  array_to_string(array_agg(dl01.nrodefiniclicencia ORDER BY dl01.nrodefiniclicencia), '-') as licencia_codigo
FROM mapuche.dl02 dl02 LEFT JOIN mapuche.dl01 dl01 ON dl02.nrodefiniclicencia=dl01.nrodefiniclicencia
WHERE dl02.nrovarlicencia in (Select evaluar_licencias_cargo(dh03.nro_cargo,(${periodo_actual}::character varying)::date,${ano_per_act},${mes_per_act}) UNION Select evaluar_licencias_legajo(dh03.nro_legaj,(${periodo_actual}::character varying)::date,${ano_per_act},${mes_per_act}))) as licencia_codigo,
    idtareacargo,
    dh03.porc_aplic,
    dh03.nro_cargo_ant,
    dh03.cod_clasif_cargo,
    (SELECT  codn_carrera || '-' || codc_uacad FROM mapuche.dd99 WHERE nro_cargo = dh03.nro_cargo ORDER BY porcentaje DESC LIMIT 1) as codn_carrera_uacad,
    (SELECT dh11.nivel FROM mapuche.dh11 WHERE dh11.codc_categ = dh03.codc_categ) as nivel_funcion,
    (SELECT dh11.impp_basic FROM mapuche.dh11 WHERE dh11.codc_categ = dh03.codc_categ) as imp_basico_cat                   
    FROM mapuche.dh03 dh03
    JOIN cargos ON cargos.nro_cargo = dh03.nro_cargo
    LEFT JOIN public.vinculos ON (dh03.nro_cargo = vinculos.nro_cargo)
    LEFT JOIN mapuche.dh21 dh21 ON dh03.nro_cargo=dh21.nro_cargo AND dh03.nro_legaj=dh21.nro_legaj
    GROUP by dh03.nro_cargo, vinculos.nro_cargo_base
ORDER BY dh03.nro_cargo;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
