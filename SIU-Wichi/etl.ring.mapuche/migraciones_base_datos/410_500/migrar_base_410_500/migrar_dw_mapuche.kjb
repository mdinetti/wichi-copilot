    <entry>
      <name>VACUUM ANALYZE</name>
      <description/>
      <type>SQL</type>
      <sql>VACUUM FULL ANALYZE mapuche.map_dw_lt_porctrabajado&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_porcreduchoraria&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_antiguedad&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_rangoedades&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_redprogramatica&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_objetodelgasto&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_liquidaciones&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_imppresupfuentes&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_imppresupsubdependencia&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_conceptos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_dependenciadesemp&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_sede&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_hsdedicacion&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_asociado&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_subrogancia&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_agrupamiento&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_tipoplantacaracter&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_estadodelcargo&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_categoriascargo&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_dependenciadesig&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_persona&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_personacargo&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_ft_lt_cargos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_discapacidad&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_sistprev&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_nivelestudios&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_estadocivil&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_sexo&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_lt_activo&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_ft_lt_legajos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.map_dw_ft_liqconceptosxcargos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.d_categoria_incentivo&#x3b;&#xa;VACUUM FULL ANALYZE mapuche.d_rango_importes&#x3b;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dw</connection>
