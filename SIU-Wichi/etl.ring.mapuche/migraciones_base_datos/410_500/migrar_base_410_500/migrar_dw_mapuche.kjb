      </entry>
    <entry>
      <name>UPDATE rango importes</name>
      <description/>
      <type>SQL</type>
      <sql>UPDATE mapuche.map_dw_ft_lt_cargos &#xa; SET &#xa; rango_neto_codigo &#x3d; CASE WHEN importenetocargo &#x3c; 0 THEN&#xa;             trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000-1000&#xa;         ELSE&#xa;             trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000&#xa;  	 END,&#xa; rango_bruto_codigo&#x3d; CASE WHEN importebrutocargo &#x3c; 0 THEN&#xa;             trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000-1000&#xa;         ELSE&#xa;             trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000&#xa;END&#x3b;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>553</xloc>
      <yloc>20</yloc>
      </entry>
    <entry>
      <name>Actualizar dim d_rango_importes</name>
      <description/>
      <type>SQL</type>
      <sql>--d_rango_importes&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.d_rango_importes &#x28;rango_importes_codigo, rango_importes_cincomil_desc, rango_importes_mil_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT -1, &#x27;VALOR ERRONEO&#x27;, &#x27;VALOR ERRONEO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;    WHERE -1 NOT IN &#x28;SELECT DISTINCT rango_importes_codigo FROM mapuche.d_rango_importes&#x29;&#x3b;&#xa;INSERT INTO mapuche.d_rango_importes &#x28;rango_importes_codigo, rango_importes_cincomil_desc, rango_importes_mil_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT DISTINCT &#xa;        CASE WHEN importenetocargo &#x3c; 0 THEN&#xa;            trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000&#xa;	END,&#xa;        CASE WHEN importenetocargo &#x3c; 0 THEN&#xa;	    &#x28;trunc&#x28;importenetocargo&#x2f;5000&#x29;&#x2a;5000-5000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;importenetocargo&#x2f;5000&#x29;&#x2a;5000&#x29;&#x3a;&#x3a;text &#xa;        ELSE&#xa;	    &#x28;trunc&#x28;importenetocargo&#x2f;5000&#x29;&#x2a;5000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;importenetocargo&#x2f;5000&#x29;&#x2a;5000&#x2b;5000&#x29;&#x3a;&#x3a;text&#xa;	END,&#xa;        CASE WHEN importenetocargo &#x3c; 0 THEN&#xa;	    &#x28;trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000-1000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000&#x29;&#x3a;&#x3a;text&#xa;        ELSE&#xa;	    &#x28;trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000&#x2b;1000&#x29;&#x3a;&#x3a;text&#xa;	END&#xa;	, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;        FROM mapuche.map_dw_ft_lt_cargos ft&#xa;        WHERE&#xa;        CASE WHEN importenetocargo &#x3c; 0 THEN&#xa;            trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;importenetocargo&#x2f;1000&#x29;&#x2a;1000&#xa;	    END      &#xa;        NOT IN &#x28;SELECT rango_importes_codigo FROM mapuche.d_rango_importes&#x29;&#xa;        GROUP BY importenetocargo order by 1&#x3b;&#xa;INSERT INTO mapuche.d_rango_importes &#x28;rango_importes_codigo, rango_importes_cincomil_desc, rango_importes_mil_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT DISTINCT &#xa;        CASE WHEN importebrutocargo &#x3c; 0 THEN&#xa;            trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000&#xa;	END,&#xa;        CASE WHEN importebrutocargo &#x3c; 0 THEN&#xa;	    &#x28;trunc&#x28;importebrutocargo&#x2f;5000&#x29;&#x2a;5000-5000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;importebrutocargo&#x2f;5000&#x29;&#x2a;5000&#x29;&#x3a;&#x3a;text &#xa;        ELSE&#xa;	    &#x28;trunc&#x28;importebrutocargo&#x2f;5000&#x29;&#x2a;5000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;importebrutocargo&#x2f;5000&#x29;&#x2a;5000&#x2b;5000&#x29;&#x3a;&#x3a;text&#xa;	END,&#xa;        CASE WHEN importebrutocargo &#x3c; 0 THEN&#xa;	    &#x28;trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000-1000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000&#x29;&#x3a;&#x3a;text&#xa;        ELSE&#xa;	    &#x28;trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000&#x2b;1000&#x29;&#x3a;&#x3a;text&#xa;	END&#xa;	, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;        FROM mapuche.map_dw_ft_lt_cargos ft&#xa;        WHERE &#xa;        CASE WHEN importebrutocargo &#x3c; 0 THEN&#xa;            trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;importebrutocargo&#x2f;1000&#x29;&#x2a;1000&#xa;	    END      &#xa;        NOT IN &#x28;SELECT rango_importes_codigo FROM mapuche.d_rango_importes&#x29;&#xa;        GROUP BY importebrutocargo order by 1&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
