--Tablas para integracion Moodle

CREATE TABLE int_pv_cursos(
  curso integer,
  id_curso_externo character varying(50),
  nombre character varying(150),
  plataforma integer
);

CREATE TABLE int_pv_cursos_comisiones
(
  curso integer,
  comision integer
);

CREATE TABLE int_pv_plataformas
(
  plataforma integer,
  nombre character varying(100),
  url character varying(200),
  host character varying(200),
  token character varying,
  rol_alumno integer,
  rol_alumno_curso integer,
  categoria_curso_default integer,
  activa boolean
);

CREATE TABLE int_pv_plataformas_ra
(
  plataforma integer,
  responsable_academica integer
);

CREATE TABLE int_pv_roles_docentes
(
  plataforma integer,
  responsabilidad integer,
  rol_externo integer
);

CREATE TABLE int_pv_usuarios
(
  plataforma integer,
  persona integer,
  id_usuario_externo character varying(50)
);

CREATE TABLE comisiones_completas(
	comision integer,
	materia character varying,
	propuesta integer,
	plan integer,
	responsable_academica integer
);
CREATE TABLE inscripciones_personas_comisiones(
	comision integer,
	alumno integer,
	actividad integer,
	curso integer,
	legajo character varying,
	persona integer,
	propuesta integer,
	plan_version integer,
	ubicacion integer,
	plataforma integer,
	id_usuario_externo integer
);

CREATE TABLE inscripciones_comision(
	comision integer,
	curso integer,
	cantidad_inscripciones integer,
	cantidad_bajas integer,
	total integer
);

--Tablas para integracion Kolla
CREATE TABLE encuestas(
  respuesta integer, 
  persona integer, 
  formulario integer, 
  fecha_alta timestamp with time zone, 
  fecha_respuesta timestamp with time zone, 
  hash character varying(40) NOT NULL
);

CREATE TABLE encuestas_propuestas(
    kolla_id_encuesta numeric,
    encuesta integer,
    kolla_unidad_gestion character varying,
    respuesta integer,
    respuesta_externa integer,
    formulario integer,
    formulario_externo integer,
    elemento integer,
    elemento_externo integer,
    kolla_id_habilitacion integer,
    persona integer,
    alumno integer,
    propuesta integer,
    propuesta_nombre character varying
);

-- Tablas para Preinscripciones

CREATE TABLE d_cobertura_salud(
  cobertura_salud_codigo integer,
  cobertura_salud_desc text
);

CREATE TABLE d_identidad_genero(
  identidad_genero_codigo integer,
  identidad_genero_desc text
);

CREATE TABLE d_periodo_inscripcion_preinscripciones(
  periodo_inscripcion_codigo integer,
  periodo_inscripcion_desc text,
  anio_academico integer
);

CREATE TABLE d_pueblos_originarios(
  pueblo_originario_codigo integer,
  pueblo_originario_desc text
);

CREATE TABLE d_tipo_allegado(
  tipo_allegado_codigo text,
  tipo_allegado_desc text
);

CREATE TABLE d_tipo_documento(
  tipo_documento_codigo integer,
  tipo_documento_desc text
);

CREATE TABLE d_trabajo_ocupacion(
  trabajo_ocupacion_codigo integer,
  trabajo_ocupacion_desc text
);

CREATE TABLE d_turno_preferido(
   turno_preferido_codigo integer,
   turno_preferido_desc text
);

CREATE TABLE d_vive_con(
  vive_con_codigo integer,
  vive_con_desc text
);

