    <sql>--Crea el esquema Araucano
create schema araucano_dsa;

CREATE TABLE araucano_dsa.academica_d_facultades
(
  idfacultad serial NOT NULL,
  idfacultad_ona integer NOT NULL,
  facultad character varying(255),
  provincia character varying(255),
  localidad character varying(255),
  iduniversidad integer,
  universidad character varying(255),
  fechaact timestamp,
  CONSTRAINT academica_dsa_d_facultades_pkey PRIMARY KEY (idfacultad)
);

CREATE TABLE araucano_dsa.academica_d_generos
(
  idgenero serial NOT NULL,
  genero character(2) NOT NULL,
  generodescripcion character varying(50),
  fechaact timestamp,
  CONSTRAINT academica_dsa_d_generos_pkey PRIMARY KEY (idgenero)
);

CREATE TABLE araucano_dsa.academica_d_mug_paises
(
  idpais serial NOT NULL,
  idpais_ona smallint NOT NULL,
  nombre_pais character varying(255),
  continente character(2),
  nombre_continente character varying(255),
  fechaact timestamp,
  CONSTRAINT academica_dsa_d_mug_paises_pkey PRIMARY KEY (idpais)
);

CREATE TABLE araucano_dsa.academica_d_rda
(
  idrda serial NOT NULL,
  rda character varying(255),
  fechaact timestamp,
  CONSTRAINT academica_dsa_d_rda_pkey PRIMARY KEY (idrda)
);

CREATE TABLE araucano_dsa.academica_d_series
(
  idserie serial NOT NULL,
  serie character(4) NOT NULL,
  nombreserie character varying(255),
  fechaact timestamp,
  CONSTRAINT academica_dsa_d_series_pkey PRIMARY KEY (idserie)
);

CREATE TABLE araucano_dsa.academica_d_subseriesopcion
(
  idsubserieopcion serial NOT NULL,
  serie character(4) NOT NULL,
  subserie character(4) NOT NULL,
  subserieopcion character(4) NOT NULL,
  nombreserie character varying(255),
  nombresubserie character varying(255),
  nombresubserieopcion character varying(255),
  fechaact timestamp,
  CONSTRAINT academica_dsa_d_subseriesopcion_pkey PRIMARY KEY (idsubserieopcion)
);

CREATE TABLE araucano_dsa.academica_d_tipostitulos
(
  idtipotitulo serial NOT NULL,
  idtipotitulo_ona character(4) NOT NULL,
  tipotitulo character varying(255),
  nivel character varying(255),
  ttn character varying(255),
  fechaact timestamp,
  CONSTRAINT academica_dsa_d_tipostitulos_pkey PRIMARY KEY (idtipotitulo)
);

CREATE TABLE araucano_dsa.academica_d_titulos
(
  idtitulo serial NOT NULL,
  idtitulo_ona integer NOT NULL,
  titulo character varying(255),
  rama character varying(255),
  disciplina character varying(255),
  area character varying(255),
  idrda integer,
  fechaact timestamp,
  CONSTRAINT academica_dsa_d_titulos_pkey PRIMARY KEY (idtitulo)
);

CREATE TABLE araucano_dsa.academica_d_actividades 
(
  idactividad serial NOT NULL,
  idactividad_ona integer NOT NULL,
  nombre_actividad character varying(255),
  fechaact timestamp without time zone,
  CONSTRAINT academica_dsa_d_actividades_pkey PRIMARY KEY (idactividad)
);

CREATE TABLE araucano_dsa.academica_d_parentesco
(
  idparentesco serial NOT NULL,
  parentesco character(2) NOT NULL,
  parentescodescripcion character varying(50),
  fechaact timestamp without time zone,
  CONSTRAINT academica_dsa_d_parentesco_pkey PRIMARY KEY (idparentesco)
);

CREATE TABLE araucano_dsa.academica_d_procedencias
(
  idprocedencia serial NOT NULL,
  idprocedencia_ona integer NOT NULL,
  nombre_procedencia character varying(255),
  fechaact timestamp without time zone,
  CONSTRAINT academica_dsa_d_procedencias_pkey PRIMARY KEY (idprocedencia)
);

CREATE TABLE araucano_dsa.academica_ft_cuadro12
(
  idcuadro12 serial NOT NULL,
  idanioinformado smallint NOT NULL,
  idfacultad smallint NOT NULL,
  idfacultadingreso smallint NOT NULL,
  idtipotitulo smallint NOT NULL,
  idrda smallint NOT NULL,
  idtitulo smallint NOT NULL,
  idgenero smallint NOT NULL,
  idprocedencia smallint NOT NULL,
  idpais smallint NOT NULL,
  idsubserieopcion smallint NOT NULL,
  cantidadm double precision,
  cantidadn double precision,
  cantidads double precision,
  cantidad double precision,
  fechacarga timestamp NOT NULL, --(fecha y hora en que se cargó la información)
  CONSTRAINT academica_dsa_ft_cuadro12_pkey PRIMARY KEY (idcuadro12)
);

CREATE TABLE araucano_dsa.academica_ft_cuadro3
(
  idcuadro3 serial NOT NULL,
  idanioinformado smallint NOT NULL,
  idanioingreso smallint NOT NULL,
  idfacultad smallint NOT NULL,
  idfacultadingreso smallint NOT NULL,
  idtipotitulo smallint NOT NULL,
  idrda smallint NOT NULL,
  idtitulo smallint NOT NULL,
  idgenero smallint NOT NULL,
  idsubserieopcion smallint NOT NULL,
  cantidadm double precision,
  cantidadn double precision,
  cantidads double precision,
  cantidad double precision,
  fechacarga timestamp NOT NULL, --(fecha y hora en que se cargó la información)
  CONSTRAINT academica_dsa_ft_cuadro3_pkey PRIMARY KEY (idcuadro3)
);

CREATE TABLE araucano_dsa.academica_ft_cuadro4
(
  idcuadro4 serial NOT NULL,
  idanioinformado smallint NOT NULL,
  idanioingreso smallint NOT NULL,
  idfacultad smallint NOT NULL,
  idtipotitulo smallint NOT NULL,
  idrda smallint NOT NULL,
  idtitulo smallint NOT NULL,
  idgenero smallint NOT NULL,
  idsubserieopcion smallint NOT NULL,
  cantidadm double precision,
  cantidadn double precision,
  cantidad double precision,
  fechacarga timestamp NOT NULL, --(fecha y hora en que se cargó la información)
  CONSTRAINT academica_dsa_ft_cuadro4_pkey PRIMARY KEY (idcuadro4)
);

