INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	31,
	'Cantidad de árboles que se salvan de ser resmas (https://steemit.com/spanish/@sabias-que/sabias-cuantos-arboles-se-deben-talar-para-producir-una-resma-de-papel)',
