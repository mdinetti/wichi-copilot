	(SELECT 
	id_indicador, 
	descripcion_indicador,
	'Todos los años',
	sum(cast(valor_indicador_calculado as decimal(12))),
	CURRENT_DATE
	FROM sudocu_dsa.indicadores_calculados
	WHERE id_indicador IN (13,14,19,21,23,24,25,26,33,34,35,36,37,38,44,45,46,47,49,51,55,56,61,62,95,96,97,98,99,114,115,116,117,118,119,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,239,240,241,242,247,248)
	AND alcance NOT IN ('General')
