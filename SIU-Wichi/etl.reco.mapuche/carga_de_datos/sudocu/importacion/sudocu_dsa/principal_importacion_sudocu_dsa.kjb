INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	24, 
	'Cantidad de documentos en estado autorizado utilizando la API de integración (SIU-Pilagá, SIU-Diaguita, SIU-Guaraní, etc.)',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones
	WHERE atributos::json->>'integracion' = 'true' 
	AND id_tipo_relacion = 10 
	AND estado = 1
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	25, 
	'Cantidad de páginas de documentos en estado autorizado',
	date_part('year', d.ts) AS anio, 
	sum(a.paginas),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento d
	INNER JOIN sudocu_tmp.archivos a ON d.documento = a.id
	WHERE documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia = 'documento')
	AND d.documento_estado = '19'
	GROUP BY anio
	ORDER BY anio);
		
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	26, 
	'Cantidad de Mega Bytes que ocupan los documentos en estado autorizado (en Araí-Documentos)',
	date_part('year', d.ts) AS anio, 
	CEIL(sum(a.size)/1048576), --en Mega Bytes
	CURRENT_DATE
	FROM sudocu_tmp.d_documento d
	INNER JOIN sudocu_tmp.archivos a ON d.documento = a.id
	WHERE documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia = 'documento')
	AND d.documento_estado = '19'
	GROUP BY anio
	ORDER BY anio);	
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
