INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	44,
	'Cantidad de trámites que se transformaron en expedientes (contenedores)',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.ft_evento
	WHERE tipo_evento_id='17' AND atributos::json->>'transformado_de' IN (SELECT tipo_documento_id::text FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia='tramite')	
	GROUP BY anio
	ORDER BY anio);


INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	45, 
	'Cantidad de remisiones (pases) confirmadas de expedientes(contenedores)/trámites realizados entre áreas',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.ft_evento
	WHERE tipo_evento_id='16' AND resultado = 'confirmado'
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	46, 
	'Cantidad de expedientes (contenedores) en estado archivado por año de archivo',
	date_part('year', t1.ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento sd, 
	 (SELECT e.documento_uuid, e.ts
	  FROM sudocu_tmp.ft_evento e
	  JOIN (
	  SELECT documento_uuid, MAX(ts) AS max_ts
	  FROM sudocu_tmp.ft_evento
	  WHERE
	  tipo_evento_id = '23'
	  AND resultado = 'confirmado'
	  GROUP BY documento_uuid
	 ) AS latest ON e.documento_uuid = latest.documento_uuid AND e.ts = latest.max_ts) as t1
	WHERE sd.documento_uuid = t1.documento_uuid
	AND sd.documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia = 'contenedor')
	AND sd.documento_estado = '26' --expediente/trámite archivado
	GROUP BY anio
	ORDER BY anio);	

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	47, 
	'Cantidad de trámites en estado archivado por año de archivo',
	date_part('year', t1.ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento sd, 
	 (SELECT e.documento_uuid, e.ts
	  FROM sudocu_tmp.ft_evento e
	  JOIN (
	  SELECT documento_uuid, MAX(ts) AS max_ts
	  FROM sudocu_tmp.ft_evento
	  WHERE
	  tipo_evento_id = '23'
	  AND resultado = 'confirmado'
	  GROUP BY documento_uuid
	 ) AS latest ON e.documento_uuid = latest.documento_uuid AND e.ts = latest.max_ts) as t1
	WHERE sd.documento_uuid = t1.documento_uuid
	AND sd.documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia = 'tramite')
	AND sd.documento_estado = '26' --expediente/trámite archivado
	GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	48, 
	'Fecha y hora de instalación de la actual versión SUDOCU en producción',
	'General',
	run_on,
	CURRENT_DATE
	FROM sudocu_tmp.migrations
	ORDER BY id DESC
	LIMIT 1);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	49, 
	'Cantidad de expedientes (contenedores) y trámites',
	alcance, 
	sum(cast(valor_indicador_calculado as int4)),
	CURRENT_DATE
	FROM sudocu_dsa.indicadores_calculados
	WHERE id_indicador IN(19, 21) --19:cantidad de expediente   --21: cantidad de trámites
	GROUP BY alcance
	ORDER BY alcance);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	50, 
	'Altura en obeliscos apilados (altura: 67,5 mts)',
	alcance, 
	CAST(((sum(valor_indicador_calculado::decimal(12,4))) / 67.5) as decimal(12,2)),
	CURRENT_DATE
	FROM sudocu_dsa.indicadores_calculados
	WHERE id_indicador = 28 --28: Altura en metros de todas las resmas apiladas
	GROUP BY alcance
	ORDER BY alcance);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	51, 
	'Cantidad de documentos en estado autorizado iniciados dentro de SUDOCU',
	alcance, 
	sum(cast(valor_indicador_calculado as int4)),
	CURRENT_DATE
	FROM sudocu_dsa.indicadores_calculados
	WHERE id_indicador = 23 --23: cantidad de documentos en estado autorizado
	GROUP BY alcance
	ORDER BY alcance);
	
--Resto ahora el valor del id_indicador 24 (los que ingresaron por API integración)

	UPDATE sudocu_dsa.indicadores_calculados as tabla1
		SET valor_indicador_calculado= cast(tabla1.valor_indicador_calculado as int4) - cast(tabla2.valor_indicador_calculado as int4)
	FROM (SELECT id_indicador, alcance, valor_indicador_calculado
	      FROM  sudocu_dsa.indicadores_calculados WHERE id_indicador = 24) AS tabla2
	WHERE 
	tabla1.alcance=tabla2.alcance
	AND tabla1.id_indicador = 51;

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	52, 
	'Cantidad de volquete de un volumen de 15m3.',
	alcance, 
	CAST((((sum(valor_indicador_calculado::decimal(12,4))) * 0.21 * 0.297 * 0.055) /15) as decimal(12,2)),
	CURRENT_DATE
	FROM sudocu_dsa.indicadores_calculados
	WHERE id_indicador = 27 --27: cantidad de resmas
	GROUP BY alcance
	ORDER BY alcance);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	53, 
	'Peso del papel ahorrado en kilo gramos (peso resma: 2,464 kgrs)',
	alcance, 
	CAST(((sum(valor_indicador_calculado::decimal(12,4)) / 500) * 2.464) as decimal(12,2)),
	CURRENT_DATE
	FROM sudocu_dsa.indicadores_calculados
	WHERE id_indicador = 25 --25: cantidad de páginas
	GROUP BY alcance
	ORDER BY alcance);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	54, 
	'Cantidad de usuarios que realizaron alguna gestión',
	'General', 
	count(DISTINCT e.usuario_uuid),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento as d
	INNER JOIN sudocu_tmp.ft_evento e ON d.documento_uuid = e.documento_uuid);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(WITH tipos_firmas AS (
	SELECT jsonb_array_elements(firmas::jsonb)->>'tipo' AS tipo, date_part('YEAR', ts) AS anio 
	FROM sudocu_tmp.d_documento
	)
	SELECT 
	55, 
	'Cantidad de autorizaciones en documentos en estado autorizado con nivel de firma básica',
	anio,
	count(*), 
	CURRENT_DATE
	FROM tipos_firmas
	WHERE tipo = 'basica'
	GROUP BY tipo, anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(WITH tipos_firmas AS (
	SELECT jsonb_array_elements(firmas::jsonb)->>'tipo' AS tipo, date_part('YEAR', ts) AS anio 
	FROM sudocu_tmp.d_documento 
	)
	SELECT 
	56, 
	'Cantidad de autorizaciones en documentos en estado autorizado con nivel de firma digital',
	anio,
	count(*), 
	CURRENT_DATE
	FROM tipos_firmas
	WHERE tipo = 'firma'
	GROUP BY tipo, anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(WITH q as(
	SELECT
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'id_usuario_sso' as usuario,
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'nivel' as tipo_firma
	FROM sudocu_tmp.ft_evento 
	WHERE tipo_evento_id = '4' AND resultado='confirmado' AND atributos::jsonb->'autorizacion'->>'estado' = 'autorizado'
	),
	usuarios_basica as(
	SELECT count(*) as total, usuario, tipo_firma FROM q
	WHERE tipo_firma = 'basica'
	GROUP BY usuario, tipo_firma
	)
	SELECT 
	57, 
	'Cantidad de usuarios que realizaron al menos una autorización con nivel de firma básica',
	'General',
	count(total), 
	CURRENT_DATE
	FROM usuarios_basica 
	GROUP BY tipo_firma);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(WITH q as(
	SELECT
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'id_usuario_sso' as usuario,
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'nivel' as tipo_firma
	FROM sudocu_tmp.ft_evento 
	WHERE tipo_evento_id = '4' AND resultado='confirmado' AND atributos::jsonb->'autorizacion'->>'estado' = 'autorizado'
	),
	usuarios_firma_digital as(
	SELECT count(*) as total, usuario, tipo_firma FROM q
	WHERE tipo_firma = 'firma'
	GROUP BY usuario, tipo_firma
	)
	SELECT 
	59, 
	'Cantidad de usuarios que realizaron al menos una autorización con nivel de firma digital',
	'General',
	count(total), 
	CURRENT_DATE
	FROM usuarios_firma_digital 
	GROUP BY tipo_firma);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	61, 
	'Cantidad de procesos de autorización iniciados con modelo de autorización Simple',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.ft_evento 
	WHERE tipo_evento_id = '4' AND resultado='confirmado' AND (atributos::jsonb->'autorizacion'->>'metodo' = 'simple' 
	OR atributos::jsonb->'autorizacion'->>'metodo' is null) --'metodo' is null: para los casos de autorización desde dentro del formulario de modificación
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
