	FROM sudocu_tmp.ft_evento 
	WHERE tipo_evento_id = '4' AND resultado='confirmado' AND atributos::jsonb->'autorizacion'->>'metodo' = 'cadena'
	GROUP BY anio
	ORDER BY anio);
	
