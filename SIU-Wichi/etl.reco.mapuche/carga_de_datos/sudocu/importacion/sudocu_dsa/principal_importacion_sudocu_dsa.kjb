    <entry>
      <name>Calcula indicadoers</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>--script de relevamiento de indicadores SUDOCU v2.0

-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla: sudocu_dsa.indicadores_calculados
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS sudocu_dsa.indicadores_calculados;
CREATE TABLE sudocu_dsa.indicadores_calculados
(
	id_indicador integer NOT NULL,
	descripcion_indicador varchar(300) NOT NULL,
	alcance varchar(16) NOT NULL,
	valor_indicador_calculado varchar(60),
	tipo_campo character varying(10) DEFAULT 'int4',
	fecha_relevamiento_indicador date NOT NULL
);

ALTER TABLE sudocu_dsa.indicadores_calculados ADD CONSTRAINT pk_sudocu_dsa_2_sudocu_indicadores_calculados PRIMARY KEY (id_indicador,alcance);
  
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	 1,
	 'Fecha y hora de inicio del relevamiento de indicadores SUDOCU',
	 'General', 
	  clock_timestamp(),
	 CURRENT_DATE
	 );


-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla: sudocu_dsa.expedientes_tramites_mb
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

DROP TABLE IF EXISTS sudocu_dsa.expedientes_tramites_mb;
DROP SEQUENCE IF EXISTS sudocu_dsa.expedientes_tramites_mb_id_seq;
CREATE SEQUENCE sudocu_dsa.expedientes_tramites_mb_id_seq START 1;
CREATE TABLE sudocu_dsa.expedientes_tramites_mb
(
	id integer NOT NULL DEFAULT nextval('sudocu_dsa.expedientes_tramites_mb_id_seq'::regclass),
	total_mb decimal(12,2)
);

ALTER TABLE sudocu_dsa.expedientes_tramites_mb ADD CONSTRAINT pk_sudocu_dsa_sudocu_expedientes_tramites_mb PRIMARY KEY (id);

INSERT INTO sudocu_dsa.expedientes_tramites_mb(total_mb)
	(SELECT cast(sum(a.size)/1048576 as decimal(12,2))
	FROM sudocu_tmp.ft_evento e
	INNER JOIN sudocu_tmp.d_documento d ON e.atributos::json->>'documento_incorporado' = d.documento_uuid
	INNER JOIN sudocu_tmp.archivos a ON d.documento = a.id
	INNER JOIN sudocu_tmp.d_documento exp ON e.documento_uuid = exp.documento_uuid
	WHERE e.tipo_evento_id = '18' -- 18= evento incorporación
	OR e.tipo_evento_id = '19' -- 19= evento tramitación
	GROUP BY exp.documento_uuid);

-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla: sudocu_dsa.documentos_mb
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

DROP TABLE IF EXISTS sudocu_dsa.documentos_mb;
DROP SEQUENCE IF EXISTS sudocu_dsa.documentos_mb_id_seq;
CREATE SEQUENCE sudocu_dsa.documentos_mb_id_seq START 1;
CREATE TABLE sudocu_dsa.documentos_mb
(
	id integer NOT NULL DEFAULT nextval('sudocu_dsa.documentos_mb_id_seq'::regclass),
	total_mb decimal(12,2)
);

ALTER TABLE sudocu_dsa.documentos_mb ADD CONSTRAINT pk_sudocu_dsa_sudocu_documentos_mb PRIMARY KEY (id);

INSERT INTO sudocu_dsa.documentos_mb(total_mb)
	(SELECT CAST((a.size::decimal(50,2) / 1048576) as decimal(12,2))
	FROM sudocu_tmp.d_documento d
	INNER JOIN sudocu_tmp.archivos a ON d.documento = a.id
	INNER JOIN sudocu_tmp.d_tipo_documento dt ON d.documento_tipo_documento_id = dt.tipo_documento_id
	WHERE d.documento_estado = '19' AND dt.tipo_documento_esencia = 'documento');
	 

-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla: sudocu_dsa.enviados_no_recibidos
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

DROP TABLE IF EXISTS sudocu_dsa.enviados_no_recibidos;
DROP SEQUENCE IF EXISTS sudocu_dsa.enviados_no_recibidos_id_seq;
CREATE SEQUENCE sudocu_dsa.enviados_no_recibidos_id_seq START 1;
CREATE TABLE sudocu_dsa.enviados_no_recibidos
(
	id integer NOT NULL DEFAULT nextval('sudocu_dsa.enviados_no_recibidos_id_seq'::regclass),
	dias integer,
	ts timestamp without time zone
);

ALTER TABLE sudocu_dsa.enviados_no_recibidos ADD CONSTRAINT pk_sudocu_dsa_sudocu_enviados_no_recibidos PRIMARY KEY (id);

INSERT INTO sudocu_dsa.enviados_no_recibidos(dias,ts)
	(SELECT  FLOOR(EXTRACT(EPOCH FROM age(NOW(), e.ts)) / 86400), e.ts
	FROM sudocu_tmp.ft_evento e
	LEFT JOIN sudocu_tmp.d_documento d on d.documento_uuid = e.documento_uuid
	WHERE e.tipo_evento_id='16' AND d.documento_estado='3' AND e.resultado = 'enviado');
	 
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla: sudocu_dsa.documentos_archivados
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS sudocu_dsa.documentos_archivados;
CREATE TABLE sudocu_dsa.documentos_archivados
(
	id_documento uuid NOT NULL
);

ALTER TABLE sudocu_dsa.documentos_archivados ADD CONSTRAINT pk_sudocu_dsa_sudocu_documentos_archivados PRIMARY KEY (id_documento);

--Incorporo todos los documentos en estado autorizado
INSERT INTO sudocu_dsa.documentos_archivados(id_documento)
	(SELECT 
	documento_uuid::uuid
	FROM sudocu_tmp.d_documento
	WHERE documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia = 'documento')
	AND documento_estado = '19');

--Elimino los documentos que nunca fueron incorporados a Expedientes/Trámites.
DELETE FROM sudocu_dsa.documentos_archivados
WHERE id_documento IN (
    SELECT tid.id_documento
    FROM sudocu_dsa.documentos_archivados tid
    LEFT JOIN sudocu_tmp.documentos_relaciones sdr
    ON tid.id_documento = sdr.id_documento_relacionado::uuid
    WHERE sdr.id_documento_relacionado IS NULL);

--Elimino los documentos que están al menos en un Expedientes/Trámites distinto al estado archivado.
DELETE FROM sudocu_dsa.documentos_archivados WHERE id_documento IN 
	(
	SELECT 
	tid.id_documento 
	FROM sudocu_dsa.documentos_archivados tid
	LEFT JOIN sudocu_tmp.documentos_relaciones sdr ON tid.id_documento = sdr.id_documento_relacionado::uuid
	LEFT JOIN sudocu_tmp.d_documento sd ON sdr.id_documento = sd.documento_uuid   --link con los exp_tram
	WHERE sd.documento_estado &lt;&gt; '26'); --26: archivado
