UPDATE sudocu_dsa.indicadores_calculados SET valor_indicador_calculado = 0 WHERE id_indicador=73 AND valor_indicador_calculado is null;

DROP TABLE IF EXISTS sudocu_dsa.expedientes_tramites_mb;
DROP SEQUENCE IF EXISTS sudocu_dsa.expedientes_tramites_mb_id_seq;
DROP TABLE IF EXISTS sudocu_dsa.documentos_mb;
DROP SEQUENCE IF EXISTS sudocu_dsa.documentos_mb_id_seq;
DROP TABLE IF EXISTS sudocu_dsa.documentos_archivados;
DROP TABLE IF EXISTS sudocu_dsa.enviados_no_recibidos;
DROP SEQUENCE IF EXISTS sudocu_dsa.enviados_no_recibidos_id_seq;

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	43,
	'Fecha y hora de finalización del relevamiento de indicadores SUDOCU',
	'General', 
	clock_timestamp(),
	CURRENT_DATE
	);

UPDATE sudocu_dsa.indicadores_calculados SET valor_indicador_calculado = 0 WHERE valor_indicador_calculado IN ('','NULL') AND (id_indicador = 75 OR id_indicador = 250);

UPDATE sudocu_dsa.indicadores_calculados SET tipo_campo = 'timestamp' WHERE id_indicador IN (1,18,20,22,43,48);
UPDATE sudocu_dsa.indicadores_calculados SET tipo_campo = 'char' WHERE id_indicador IN (2,3);
UPDATE sudocu_dsa.indicadores_calculados SET tipo_campo = 'float' WHERE id_indicador IN (27,28,29,30,31,32,50,52,53);
</sql>
