INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	8, 
	'Cantidad de usuarios con nivel de firma básica habilitada',
	'General',
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_usuario
	WHERE estado = 'N' AND nivel_firma::json->>'basica' = 'true');
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(WITH q as(
	SELECT
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'id_usuario_sso' as usuario,
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'nivel' as tipo_firma,
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'timestamp' as ts,
	date_part('year', ts) AS anio 
	FROM sudocu_tmp.ft_evento 
	WHERE tipo_evento_id = '4' AND resultado='confirmado' AND atributos::jsonb->'autorizacion'->>'estado' = 'autorizado'
	),
	usuarios_basica as(
	SELECT count(*) as total, usuario, tipo_firma, anio FROM q
	WHERE tipo_firma = 'basica'
	GROUP BY usuario, tipo_firma, anio
	)
	SELECT 
	9, 
	'Cantidad de usuarios que realizaron al menos una autorización con nivel de firma básica (por año)',
	anio,
	count(total), 
	CURRENT_DATE
	FROM usuarios_basica 
	GROUP BY tipo_firma, anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	10, 
	'Cantidad de usuarios con nivel de firma digital habilitada',
	'General',
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_usuario
	WHERE estado = 'N' AND nivel_firma::json->>'reconocida' = 'true');

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(WITH q as(
	SELECT
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'id_usuario_sso' as usuario,
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'nivel' as tipo_firma,
	jsonb_array_elements(atributos::jsonb->'autorizacion'->'autorizantes')->>'timestamp' as ts,
	date_part('year', ts) AS anio 
	FROM sudocu_tmp.ft_evento 
	WHERE tipo_evento_id = '4' AND resultado='confirmado' AND atributos::jsonb->'autorizacion'->>'estado' = 'autorizado'
	),
	usuarios_firma_digital as(
	SELECT count(*) as total, usuario, tipo_firma, anio FROM q
	WHERE tipo_firma = 'firma'
	GROUP BY usuario, tipo_firma, anio
	)
	SELECT 
	11, 
	'Cantidad de usuarios que realizaron al menos una autorización con nivel de firma digital (por año)',
	anio,
	count(total), 
	CURRENT_DATE
	FROM usuarios_firma_digital 
	GROUP BY tipo_firma, anio);
	
