INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	114, 
	'Cantidad de documentos de tipo Providencia Automática en estado Autorizado',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_tipo_documento_id::integer = 30000 --providencia_auto
	AND documento_estado = '19'
	GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	115, 
	'Cantidad de documentos en estado autorizado de tipo Hoja de Ruta',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_tipo_documento_id::integer = 30002 --hoja de ruta
	AND documento_estado = '19'
	GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	116, 
	'Cantidad de documentos en estado autorizado provenientes automáticamente de SIU-Pilagá',
	date_part('year', dr.ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones as dr
	INNER JOIN sudocu_tmp.d_documento d ON d.documento_uuid = dr.id_documento_relacionado
	WHERE dr.atributos::jsonb->>'integracion' = 'true' 
	AND dr.id_tipo_relacion = 10 
	AND dr.estado = 1	
	AND d.documento_tipo_documento_id::integer > 10000 AND d.documento_tipo_documento_id::integer &lt; 10010 --pilagá
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	117, 
	'Cantidad de documentos en estado autorizado provenientes automáticamente de SIU-Diaguita',
	date_part('year', dr.ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones as dr
	INNER JOIN sudocu_tmp.d_documento d ON d.documento_uuid = dr.id_documento_relacionado
	WHERE dr.atributos::jsonb->>'integracion' = 'true' 
	AND dr.id_tipo_relacion = 10 
	AND dr.estado = 1	
	AND ((d.documento_tipo_documento_id::integer > 10049 AND d.documento_tipo_documento_id::integer &lt; 10061) --diaguita
	OR (d.documento_tipo_documento_id::integer > 10100 AND d.documento_tipo_documento_id::integer &lt; 10111) --diaguita
	OR (d.documento_tipo_documento_id::integer > 10200 AND d.documento_tipo_documento_id::integer &lt; 10215)) --diaguita	
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	118, 
	'Cantidad de documentos en estado autorizado provenientes automáticamente de SIU-Guaraní',
	date_part('year', dr.ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones as dr
	INNER JOIN sudocu_tmp.d_documento d ON d.documento_uuid = dr.id_documento_relacionado
	WHERE dr.atributos::jsonb->>'integracion' = 'true' 
	AND dr.id_tipo_relacion = 10 
	AND dr.estado = 1	
	AND (d.documento_tipo_documento_id::integer > 10299 AND d.documento_tipo_documento_id::integer &lt; 10302) --guaraní
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	119, 
	'Cantidad de documentos en estado autorizado provenientes automáticamente pero no de los módulos SIU-Pilagá, SIU-Diaguita o SIU-Guaraní',
	date_part('year', dr.ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones as dr
	INNER JOIN sudocu_tmp.d_documento d ON d.documento_uuid = dr.id_documento_relacionado
	WHERE dr.atributos::jsonb->>'integracion' = 'true' 
	AND dr.id_tipo_relacion = 10 
	AND dr.estado = 1	
	AND --otros distintos a SIU-Pilagá, SIU-Diaguita y SIU-Guaraní 
	(d.documento_tipo_documento_id::integer &lt; 10001 
	OR (d.documento_tipo_documento_id::integer > 10009 AND d.documento_tipo_documento_id::integer &lt; 10050)   
	OR (d.documento_tipo_documento_id::integer > 10060 AND d.documento_tipo_documento_id::integer &lt; 10101)
	OR (d.documento_tipo_documento_id::integer > 10110 AND d.documento_tipo_documento_id::integer &lt; 10201)
	OR (d.documento_tipo_documento_id::integer > 10214 AND d.documento_tipo_documento_id::integer &lt; 10300)
	OR d.documento_tipo_documento_id::integer > 10301)
	GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	220, 
	'Cantidad de documentos de tipo Providencia Automática distinto al estado Autorizado',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_tipo_documento_id::integer = 30000 --providencia_auto
	AND documento_estado &lt;&gt; '19'
	GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	221, 
	'Cantidad de documentos con "incorporación programada" pendiente de incorporación menor o igual a 1 día',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones
	WHERE estado = 2 --2 "documento está pendiente de incorporación"
	AND id_tipo_relacion in (8,10) -- 8 "tramita a" "tramitado en" y --10	"incorporado" "incorporado"
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) &lt;= 1   -- &lt;= 1 días
	 GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	222, 
	'Cantidad de documentos con "incorporación programada" pendiente de incorporación mayor a 1 y menor o igual a 2 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones
	WHERE estado = 2 --2 "documento está pendiente de incorporación"
	AND id_tipo_relacion in (8,10) -- 8 "tramita a" "tramitado en" y --10	"incorporado" "incorporado"
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) > 1 AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) &lt;=2   -- mayor a 1 día y menor o igual a 2 días
	 GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	223, 
	'Cantidad de documentos con "incorporación programada" pendiente de incorporación mayor a 2 y menor o igual a 5 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones
	WHERE estado = 2 --2 "documento está pendiente de incorporación"
	AND id_tipo_relacion in (8,10) -- 8 "tramita a" "tramitado en" y --10	"incorporado" "incorporado"
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) > 2 AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) &lt;=5   -- mayor a 2 días y menor o igual a 5 días
	 GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	224, 
	'Cantidad de documentos con "incorporación programada" pendiente de incorporación mayor a 5 y menor o igual a 10 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones
	WHERE estado = 2 --2 "documento está pendiente de incorporación"
	AND id_tipo_relacion in (8,10) -- 8 "tramita a" "tramitado en" y --10	"incorporado" "incorporado"
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) > 5 AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) &lt;=10   -- mayor a 5 días y menor o igual a 10 días
	 GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	225, 
	'Cantidad de documentos con "incorporación programada" pendiente de incorporación mayor a 10 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.documentos_relaciones
	WHERE estado = 2 --2 "documento está pendiente de incorporación"
	AND id_tipo_relacion in (8,10) -- 8 "tramita a" "tramitado en" y --10	"incorporado" "incorporado"
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) > 10   -- mayor a 10 días
	 GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	226, 
	'Cantidad de archivos adjuntos (directorio sudocu_files)',
	date_part('year', ts) AS anio, 
	count(id),
	CURRENT_DATE
	FROM sudocu_tmp.archivos
	WHERE repositorio = 'filesystem' AND estado = 1
	GROUP BY anio
	ORDER BY anio);	

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	227, 
	'Cantidad de Mega Bytes que ocupan los archivos adjuntos (directorio sudocu_files)',
	date_part('year', ts) AS anio, 
	CEIL(sum(size)/1048576), --en Mega Bytes
	CURRENT_DATE
	FROM sudocu_tmp.archivos
	WHERE repositorio = 'filesystem' AND estado = 1
	GROUP BY anio
	ORDER BY anio);	

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	228, 
	'Cantidad de documentos de tipo Providencia Automática distinto al estado Autorizado menor o igual a 1 día',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_tipo_documento_id::integer = 30000 --providencia_auto
	AND documento_estado &lt;&gt; '19 ' 
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) &lt;= 1   -- &lt;= 1 días
	 GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	229, 
	'Cantidad de documentos de tipo Providencia Automática distinto al estado Autorizado mayor a 1 y menor o igual a 2 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_tipo_documento_id::integer = 30000 --providencia_auto
	AND documento_estado &lt;&gt; '19'
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) > 1 AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) &lt;=2   -- mayor a 1 día y menor o igual a 2 días
	 GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	230, 
	'Cantidad de documentos de tipo Providencia Automática distinto al estado Autorizado mayor a 2 y menor o igual a 5 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_tipo_documento_id::integer = 30000 --providencia_auto
	AND documento_estado &lt;&gt; '19' 
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) > 2 AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) &lt;=5   -- mayor a 2 días y menor o igual a 5 días
	 GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	231, 
	'Cantidad de documentos de tipo Providencia Automática distinto al estado Autorizado mayor a 5 y menor o igual a 10 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_tipo_documento_id::integer = 30000 --providencia_auto
	AND documento_estado &lt;&gt; '19'  
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) > 5 AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) &lt;=10   -- mayor a 5 días y menor o igual a 10 días
	 GROUP BY anio
	ORDER BY anio);	
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	232, 
	'Cantidad de documentos de tipo Providencia Automática distinto al estado Autorizado mayor a 10 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_tipo_documento_id::integer = 30000 --providencia_auto
	AND documento_estado &lt;&gt; '19'  
	AND (FLOOR(EXTRACT(EPOCH FROM age(NOW(), ts)) / 86400)) > 10   -- mayor a 10 días
	 GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	233, 
	'Cantidad de contenedores (expedientes)/trámites que fueron remitidos (pase) y aún no recibidos menor o igual 1 día',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_dsa.enviados_no_recibidos
	WHERE dias &lt;= 1
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	234, 
	'Cantidad de contenedores (expedientes)/trámites que fueron remitidos (pase) y aún no recibidos mayor a 1 y menor o igual a 5 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_dsa.enviados_no_recibidos
	WHERE dias > 1 AND dias &lt;=5
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	235, 
	'Cantidad de contenedores (expedientes)/trámites que fueron remitidos (pase) y aún no recibidos mayor a 5 y menor o igual 10 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_dsa.enviados_no_recibidos
	WHERE dias > 5 AND dias &lt;=10
	GROUP BY anio
	ORDER BY anio);


INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	236, 
	'Cantidad de contenedores (expedientes)/trámites que fueron remitidos (pase) y aún no recibidos mayor a 10 días',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_dsa.enviados_no_recibidos
	WHERE dias > 10
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	237, 
	'Cantidad de remisiones (pases) canceladas de expedientes(contenedores)/trámites realizados entre áreas',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.ft_evento
	WHERE tipo_evento_id='16'  --remisión (pase)
	AND resultado = 'anulado'
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	238, 
	'Cantidad de contenedores (expedientes)/trámites con más de un registro del tipo remisión (pase) con resultado "enviado" en la tabla sudocu.eventos',
	'General', 
	COUNT(enviados_mayor_a_1.casos),
	CURRENT_DATE
	FROM 
	(SELECT 
	count(DISTINCT documento_uuid) as casos
	FROM sudocu_tmp.ft_evento
	WHERE tipo_evento_id = '16'  -- remisión (pase)
	AND resultado = 'enviado'
	GROUP BY documento_uuid
	HAVING COUNT(documento_uuid) > 1) as enviados_mayor_a_1);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	239, 
	'Cantidad de Expedientes (contenedores) con clave Corresponde en la numeración',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_nro::jsonb ? 'corresponde' AND documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia='contenedor')
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	240, 
	'Cantidad de Trámites con clave Corresponde  en la numeración',
	date_part('year', ts) AS anio, 
	count(*),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE documento_nro::jsonb ? 'corresponde' AND documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia='tramite')
	GROUP BY anio
	ORDER BY anio);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	241, 
	'Cantidad de documentos en estado autorizado que nunca fueron incorporados a Expedientes/Trámites.',
	date_part('year', sd.ts) AS anio, 
	COUNT(sd.documento_uuid) AS cantidad_no_existentes,
	CURRENT_DATE
	FROM sudocu_tmp.d_documento sd
	LEFT JOIN sudocu_tmp.documentos_relaciones sdr
	ON sd.documento_uuid = sdr.id_documento_relacionado
	WHERE 
	sd.documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia='documento')
	AND sd.documento_estado = '19'
	AND sdr.id_documento_relacionado IS NULL
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	242, 
	'Cantidad de expedientes (contenedores)/trámites sin documentos',
	'General',	
	COUNT(*),
	CURRENT_DATE
	FROM sudocu_dsa.expedientes_tramites_mb);
	
	--Resto ahora el valor del id_indicador 49 'Cantidad de expedientes (contenedores) y trámites' con el actual 242
	UPDATE sudocu_dsa.indicadores_calculados as tabla1
		SET valor_indicador_calculado= cast(tabla2.valor_indicador_49 as int4) - cast(tabla1.valor_indicador_calculado as int4)
	FROM (SELECT sum(cast(valor_indicador_calculado as decimal(12))) as valor_indicador_49
	      FROM  sudocu_dsa.indicadores_calculados WHERE id_indicador = 49) AS tabla2
	WHERE 
	tabla1.id_indicador = 242;

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	243, 
	'Cantidad de expedientes (contenedores)/trámites > 1MB y &lt;= 3MB',
	'General',
	count(total_mb),
	CURRENT_DATE
	FROM sudocu_dsa.expedientes_tramites_mb
	WHERE total_mb > 1 AND total_mb &lt;= 3);
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	244, 
	'Cantidad de expedientes (contenedores)/trámites > 3MB y &lt;= 5MB',
	'General',
	count(total_mb),
	CURRENT_DATE
	FROM sudocu_dsa.expedientes_tramites_mb
	WHERE total_mb > 3 AND total_mb &lt;= 5);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	245, 
	'Cantidad de documentos en estado autorizado > 50KB y &lt;= 100KB',
	'General',
	count(id),
	CURRENT_DATE
	FROM sudocu_dsa.documentos_mb
	WHERE total_mb > 0.05 AND total_mb &lt;= 0.1);    -- 0.05MB y 0.1MB

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	246, 
	'Cantidad de documentos en estado autorizado > 100KB y &lt;= 200KB',
	'General',
	count(id),
	CURRENT_DATE
	FROM sudocu_dsa.documentos_mb
	WHERE total_mb > 0.1 AND total_mb &lt;= 0.2);    -- 0.1MB y 0.2MB	
	
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	247, 
	'Cantidad de Mega Bytes que ocupan los documentos en estado autorizado que nunca fueron incorporados a Expedientes/Trámites',
	date_part('year', sd.ts) AS anio, 
	CEIL(sum(sa.size)/1048576), --en Mega Bytes
	CURRENT_DATE
	FROM sudocu_tmp.d_documento sd
	INNER JOIN sudocu_tmp.archivos sa ON sd.documento = sa.id
	LEFT JOIN sudocu_tmp.documentos_relaciones sdr
	ON sd.documento_uuid = sdr.id_documento_relacionado
	WHERE 
	sd.documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia='documento')
	AND sd.documento_estado = '19'
	AND sdr.id_documento_relacionado IS NULL
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	248,
	'Cantidad de documentos en estado autorizado que no tienen registro en sudocu.archivos',
	date_part('year', ts) AS anio, 
	COUNT(documento_uuid),
	CURRENT_DATE
	FROM sudocu_tmp.d_documento
	WHERE 
	documento_tipo_documento_id IN (SELECT tipo_documento_id FROM sudocu_tmp.d_tipo_documento WHERE tipo_documento_esencia='documento')
	AND documento_estado = '19'
	AND documento IS NULL
	GROUP BY anio
	ORDER BY anio);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	249,
	'Cantidad de documentos en estado autorizado que se encuentran únicamente en Expedientes/Trámites en estado Archivado',
	'General',
	COUNT(*),
	CURRENT_DATE
	FROM sudocu_dsa.documentos_archivados);

INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	250,
	'Cantidad de Mega Bytes que ocupan los documentos en estado autorizado que se encuentran únicamente en Expedientes/Trámites en estado Archivado',
	'General',
	CAST(sum(a.size::decimal(50,2) / 1048576) as decimal(12)),
	CURRENT_DATE
	FROM sudocu_dsa.documentos_archivados e
	LEFT JOIN sudocu_tmp.d_documento d ON e.id_documento = d.documento_uuid::uuid
	LEFT JOIN sudocu_tmp.archivos a ON d.documento = a.id);

