--Todos los años (CON DECIMALES)
INSERT INTO sudocu_dsa.indicadores_calculados(id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, fecha_relevamiento_indicador)
	(SELECT 
	id_indicador, 
	descripcion_indicador,
	'Todos los años',
	sum(cast(valor_indicador_calculado as decimal(12,2))),
	CURRENT_DATE
	FROM sudocu_dsa.indicadores_calculados
	WHERE id_indicador IN (27,28,29,30,31,32,50,52,53)
