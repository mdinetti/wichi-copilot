  <step>
    <name>persona</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_guarani</connection>
    <sql>SELECT &#xa;	p.persona,&#xa;	p.apellido &#x7c;&#x7c; &#x27; &#x27; &#x7c;&#x7c; p.nombres as apyno,&#xa;	coalesce&#x28;p.fecha_nacimiento,&#x27;2199-12-31&#x27;&#x29; as fecha_nacimiento,&#xa;	td.desc_abreviada &#x7c;&#x7c; &#x27; &#x27; &#x7c;&#x7c; pd.nro_documento AS tipoynum,&#xa;	&#x28;SELECT email FROM mdp_personas_contactos WHERE contacto_tipo &#x3d; &#x27;MP&#x27; AND p.persona &#x3d; persona order by persona_contacto DESC LIMIT 1&#x29; as email,&#xa;	&#x28;SELECT telefono_codigo_area &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; telefono_numero as telefono FROM mdp_personas_contactos WHERE contacto_tipo &#x3d; &#x27;C&#x27; AND p.persona &#x3d; persona order by persona_contacto DESC LIMIT 1&#x29; as telefono,&#xa;	p.apellido_elegido  &#x7c;&#x7c; &#x27; &#x27; &#x7c;&#x7c; p.nombres_elegido as apyno_elegido,&#xa;	CASE WHEN p.pertenece_pueblo_originario &#x3d; &#x27;S&#x27; AND p.pueblo_originario &#x3d; 27 THEN p.pueblo_originario_otro&#xa;		WHEN p.pertenece_pueblo_originario &#x3d; &#x27;S&#x27; THEN po.nombre&#xa;		ELSE &#x27;No Pertenece&#x2f;NULO&#x27; END as pueblo_originario,&#xa;	CASE WHEN p.identidad_genero &#x3d; 13 THEN p.identidad_genero_otro&#xa;	ELSE coalesce&#x28;i.nombre,&#x27;VACIO&#x2f;NULO&#x27;&#x29; END as identidad_genero&#xa;FROM mdp_personas p JOIN mdp_personas_documentos pd ON pd.documento &#x3d; p.documento_principal&#xa;JOIN mdp_tipo_documento td ON pd.tipo_documento&#x3d;td.tipo_documento&#xa;LEFT JOIN mdp_pueblos_originarios po ON &#x28;p.pueblo_originario &#x3d; po.pueblo_originario&#x29;&#xa;LEFT JOIN  mdp_identidad_genero i ON &#x28;p.identidad_genero &#x3d; i.identidad_genero &#x29;&#xa;ORDER BY 1&#x3b;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
