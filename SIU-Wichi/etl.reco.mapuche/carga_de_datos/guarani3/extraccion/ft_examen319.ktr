  <step>
    <name>examen</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_guarani</connection>
    <sql>-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Archivo: FT_Examen.txt
--  * Examenes de Actas Cerradas y Abiertas
--  * Examenes en otras propuestas (Examenes equivalentes). Muestra examenes de actividades
--    que se encuentran en el plan actual del alumno

-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- ACTAS DE EXAMEN CERRADAS
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
WITH actas_cerradas as (SELECT *  FROM negocio.sga_actas WHERE sga_actas.origen = 'E' AND estado='C'),
actas_cerradas_det as (SELECT * FROM negocio.sga_actas_detalle WHERE sga_actas_detalle.instancia IN (3,4,7) -- Regulares / Libres / Examen Complementario
	  AND sga_actas_detalle.estado = 'A' AND sga_actas_detalle.rectificado = 'N'),
 actas_abiertas as (SELECT *  FROM negocio.sga_actas WHERE sga_actas.origen = 'E' AND estado='A')
SELECT  
	_wichi_mesas_examen.mesa_examen_ubicacion as ubicacion_id,
	cast(_wichi_mesas_examen.anio_academico as integer) as anio_academico,
	2 as codigo_tipo_periodo,
	coalesce(_wichi_mesas_examen.turno_examen_nombre,'SIN TURNO') as turno_examen_nombre,
	_wichi_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,
	to_char(greatest(_wichi_mesas_examen.mesa_examen_fecha,'19000101'::date), 'DD/MM/YYYY') as fecha_examen,
    _wichi_mesas_examen.llamado_mesa as mesa_id,
	sga_alumnos.alumno,
	sga_alumnos.propuesta,
	actas_cerradas_det.plan_version as plan_version,
	_wichi_mesas_examen.mesa_examen_elemento as actividad,
	sga_catedras.catedra as catedra,
	actas_cerradas_det.resultado as resultado,
	actas_cerradas_det.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	0 as actividad_comun,
	actas_cerradas.tipo_acta as tipo_acta,
	actas_cerradas.nro_acta as nro_acta,
	actas_cerradas.estado as estado_acta,
	actas_cerradas_det.instancia as condicion_alumno,
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
       WHEN mdp_personas.sexo = 'X' THEN 3 
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (_wichi_mesas_examen.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera
	intentos.nro_intento as nrointento,       -- Número de vez que intenta rendir examen de la materia
	
	1 as uno, -- Cantidad de registros de exámenes. Es siempre 1
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    sga_alumnos.modalidad,
 	sga_alumnos.persona,
 	wdc.hs_trabajo_situacion_alumno as horas_trabajadas, 
	wdc.estado_civil,
	wdc.localidad_per_lec,
	wdc.localidad_proc,
	wdc.costeo_estudios,
	wdc.beca,
	wdc.tecno_internet,
	wdc.tecno_pc,
	wdc.idioma,
	wdc.discapacidad
	FROM actas_cerradas
	JOIN actas_cerradas_det on actas_cerradas_det.id_acta = actas_cerradas.id_acta
	JOIN sga_planes_versiones on sga_planes_versiones.plan_version = actas_cerradas_det.plan_version
	JOIN _wichi_mesas_examen on _wichi_mesas_examen.llamado_mesa = actas_cerradas.llamado_mesa     
	JOIN sga_alumnos on sga_alumnos.alumno = actas_cerradas_det.alumno
	JOIN sga_propuestas on sga_propuestas.propuesta = sga_alumnos.propuesta
	JOIN mdp_personas on sga_alumnos.persona = mdp_personas.persona
	JOIN _wichi_ingreso_alumnos as ingreso ON ingreso.alumno = sga_alumnos.alumno
	JOIN _wichi_intentos_examenes intentos ON (intentos.alumno = actas_cerradas_det.alumno AND intentos.elemento = _wichi_mesas_examen.mesa_examen_elemento
      AND intentos.llamado_mesa = _wichi_mesas_examen.llamado_mesa)
    LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = actas_cerradas_det.escala_nota AND sga_escalas_notas_det.nota = actas_cerradas_det.nota)
    LEFT JOIN sga_catedras ON sga_catedras.catedra = _wichi_mesas_examen.mesa_examen_catedra		 
	JOIN _wichi_datos_censales wdc ON (sga_alumnos.persona = wdc.persona AND _wichi_mesas_examen.anio_academico = wdc.anio_academico)
	     
	WHERE (${periodo} = 0 or _wichi_mesas_examen.anio_academico = ${periodo})

UNION ALL

  -- Examenes aprobados en otras propuestas del alumno
  SELECT  
	_wichi_mesas_examen.mesa_examen_ubicacion as ubicacion_id,
	cast(_wichi_mesas_examen.anio_academico as integer) as anio_academico,
	2 as codigo_tipo_periodo,
	coalesce(_wichi_mesas_examen.turno_examen_nombre,'SIN TURNO') as turno_examen_nombre,
	_wichi_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,
	to_char(greatest(_wichi_mesas_examen.mesa_examen_fecha,'19000101'::date), 'DD/MM/YYYY') as fecha_examen,
    _wichi_mesas_examen.llamado_mesa as mesa_id,
	sga_alumnos2.alumno,     
	sga_alumnos2.propuesta,
	sga_planes_versiones2.plan_version as plan_version,  
	_wichi_mesas_examen.mesa_examen_elemento as actividad,  
	sga_catedras.catedra as catedra,
	actas_cerradas_det.resultado as resultado,
	actas_cerradas_det.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	1 as actividad_comun,
	actas_cerradas.tipo_acta as tipo_acta,
	actas_cerradas.nro_acta as nro_acta,
	actas_cerradas.estado as estado_acta,
	actas_cerradas_det.instancia as condicion_alumno,
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (_wichi_mesas_examen.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera
	intentos.nro_intento as nrointento,       -- Número de vez que intenta rendir examen de la materia
	
	1 as uno, -- Cantidad de registros de exámenes. Es siempre 1
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    sga_alumnos.modalidad,
 	sga_alumnos.persona,
 	wdc.hs_trabajo_situacion_alumno as horas_trabajadas, 
	wdc.estado_civil,
	wdc.localidad_per_lec,
	wdc.localidad_proc,
	wdc.costeo_estudios,
	wdc.beca,
	wdc.tecno_internet,
	wdc.tecno_pc,
	wdc.idioma,
	wdc.discapacidad

	FROM actas_cerradas JOIN actas_cerradas_det on actas_cerradas_det.id_acta = actas_cerradas.id_acta
	JOIN sga_planes_versiones on sga_planes_versiones.plan_version = actas_cerradas_det.plan_version
	JOIN _wichi_mesas_examen on _wichi_mesas_examen.llamado_mesa = actas_cerradas.llamado_mesa
	JOIN sga_alumnos on sga_alumnos.alumno = actas_cerradas_det.alumno
	JOIN mdp_personas on sga_alumnos.persona = mdp_personas.persona
 -- Otra propuesta
	JOIN sga_alumnos as sga_alumnos2 ON sga_alumnos2.persona = sga_alumnos.persona
	JOIN sga_propuestas on sga_propuestas.propuesta = sga_alumnos2.propuesta
	JOIN sga_planes_versiones as sga_planes_versiones2  ON  sga_planes_versiones2.plan_version = sga_alumnos2.plan_version
	JOIN sga_elementos_revision as sga_elementos_revision2  ON sga_elementos_revision2.elemento = _wichi_mesas_examen.mesa_examen_elemento
	JOIN sga_elementos_plan as sga_elementos_plan2  ON sga_elementos_plan2.plan_version      = sga_alumnos2.plan_version
	                                               AND sga_elementos_plan2.elemento_revision = sga_elementos_revision2.elemento_revision
	LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = actas_cerradas_det.escala_nota AND sga_escalas_notas_det.nota = actas_cerradas_det.nota)
    LEFT JOIN sga_catedras ON sga_catedras.catedra = _wichi_mesas_examen.mesa_examen_catedra
	JOIN _wichi_ingreso_alumnos as ingreso ON ingreso.alumno = sga_alumnos.alumno
	JOIN _wichi_intentos_examenes intentos ON (intentos.alumno = actas_cerradas_det.alumno AND intentos.elemento = _wichi_mesas_examen.mesa_examen_elemento
    AND intentos.llamado_mesa = _wichi_mesas_examen.llamado_mesa)
	JOIN _wichi_datos_censales wdc ON (sga_alumnos.persona = wdc.persona AND _wichi_mesas_examen.anio_academico = wdc.anio_academico)
	     
	WHERE sga_alumnos2.propuesta &lt;&gt; sga_alumnos.propuesta
		 AND (${periodo} = 0 or _wichi_mesas_examen.anio_academico = ${periodo})


-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- ACTAS ABIERTAS
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
UNION ALL

-- Actas abiertas de examenes donde el alumno lo hizo por su propuesta
SELECT  
	_wichi_mesas_examen.mesa_examen_ubicacion as ubicacion_id,
	cast(_wichi_mesas_examen.anio_academico as integer) as anio_academico,
	2 as codigo_tipo_periodo,
	coalesce(_wichi_mesas_examen.turno_examen_nombre,'SIN TURNO') as turno_examen_nombre,
	_wichi_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,
	to_char(greatest(_wichi_mesas_examen.mesa_examen_fecha,'19000101'::date), 'DD/MM/YYYY') as fecha_examen,
    _wichi_mesas_examen.llamado_mesa as mesa_id,
	sga_alumnos.alumno,
	sga_alumnos.propuesta,
	sga_eval_detalle_examenes.plan_version as plan_version,
	_wichi_mesas_examen.mesa_examen_elemento as actividad,
	sga_catedras.catedra as catedra,
	sga_eval_detalle_examenes.resultado as resultado,
	sga_eval_detalle_examenes.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	0 as actividad_comun,
	actas_abiertas.tipo_acta as tipo_acta,
	actas_abiertas.nro_acta as nro_acta,
	actas_abiertas.estado as estado_acta,
	sga_eval_detalle_examenes.instancia as condicion_alumno,
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (_wichi_mesas_examen.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera
	intentos.nro_intento as nrointento,       -- Número de vez que intenta rendir examen de la materia
	
	1 as uno, -- Cantidad de registros de exámenes. Es siempre 1
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    sga_alumnos.modalidad,
 	sga_alumnos.persona,
 	wdc.hs_trabajo_situacion_alumno as horas_trabajadas, 
	wdc.estado_civil,
	wdc.localidad_per_lec,
	wdc.localidad_proc,
	wdc.costeo_estudios,
	wdc.beca,
	wdc.tecno_internet,
	wdc.tecno_pc,
	wdc.idioma,
	wdc.discapacidad
	FROM actas_abiertas
	JOIN sga_eval_detalle_examenes  on sga_eval_detalle_examenes.id_acta = actas_abiertas.id_acta
	JOIN sga_planes_versiones on sga_planes_versiones.plan_version = sga_eval_detalle_examenes.plan_version
	JOIN _wichi_mesas_examen on _wichi_mesas_examen.llamado_mesa = actas_abiertas.llamado_mesa
	JOIN sga_alumnos on sga_alumnos.alumno = sga_eval_detalle_examenes.alumno
	JOIN sga_propuestas on sga_propuestas.propuesta = sga_alumnos.propuesta
	JOIN mdp_personas on sga_alumnos.persona = mdp_personas.persona
	JOIN _wichi_ingreso_alumnos as ingreso ON ingreso.alumno = sga_alumnos.alumno
	JOIN _wichi_intentos_examenes as intentos ON (intentos.alumno = sga_alumnos.alumno AND intentos.elemento = _wichi_mesas_examen.mesa_examen_elemento
      AND intentos.llamado_mesa = actas_abiertas.llamado_mesa)
	LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = sga_eval_detalle_examenes.escala_nota AND  sga_escalas_notas_det.nota = sga_eval_detalle_examenes.nota)
    LEFT JOIN sga_catedras ON sga_catedras.catedra = _wichi_mesas_examen.mesa_examen_catedra
	JOIN _wichi_datos_censales wdc ON (sga_alumnos.persona = wdc.persona AND _wichi_mesas_examen.anio_academico = wdc.anio_academico)
	     
	WHERE sga_eval_detalle_examenes.instancia IN (3,4,7) -- Regulares / Libres / Examen Complementario
	  AND (${periodo} = 0 or _wichi_mesas_examen.anio_academico = ${periodo})

UNION ALL

  -- Examenes aprobados en otras propuestas del alumno
  SELECT  
	_wichi_mesas_examen.mesa_examen_ubicacion as ubicacion_id,
	cast(_wichi_mesas_examen.anio_academico as integer) as anio_academico,
	2 as codigo_tipo_periodo,
	coalesce(_wichi_mesas_examen.turno_examen_nombre,'SIN TURNO') as turno_examen_nombre,
	_wichi_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,
	to_char(greatest(_wichi_mesas_examen.mesa_examen_fecha,'19000101'::date), 'DD/MM/YYYY') as fecha_examen,
    _wichi_mesas_examen.llamado_mesa as mesa_id,
	sga_alumnos2.alumno,     
	sga_alumnos2.propuesta, 
	sga_planes_versiones2.plan_version as plan_version, 
	_wichi_mesas_examen.mesa_examen_elemento as actividad, 
	sga_catedras.catedra as catedra,
	sga_eval_detalle_examenes.resultado as resultado,
	sga_eval_detalle_examenes.nota as nota,
	sga_escalas_notas_det.concepto as concepto,
	1 as actividad_comun,
	actas_abiertas.tipo_acta as tipo_acta,
	actas_abiertas.nro_acta as nro_acta,
	actas_abiertas.estado as estado_acta,
	sga_eval_detalle_examenes.instancia as condicion_alumno,
	CASE
	   WHEN mdp_personas.sexo = 'M' THEN 1
	   WHEN mdp_personas.sexo = 'F' THEN 2
	END AS sexo,
       (CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (_wichi_mesas_examen.anio_academico ||'-12-31'), mdp_personas.fecha_nacimiento))
	) END) as edad,
	mdp_personas.nacionalidad,
(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
		ELSE NULL END
	FROM mdp_datos_estudios 
	WHERE mdp_datos_estudios.persona = mdp_personas.persona
	LIMIT 1) as colegio,
	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera
	intentos.nro_intento as nrointento,       -- Número de vez que intenta rendir examen de la materia
	
	1 as uno, -- Cantidad de registros de exámenes. Es siempre 1
	ingreso.anio_academico_institucion as anio_ingreso_institucion,
	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,
	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,
    sga_alumnos.modalidad,
 	sga_alumnos.persona,
 	wdc.hs_trabajo_situacion_alumno as horas_trabajadas, 
	wdc.estado_civil,
	wdc.localidad_per_lec,
	wdc.localidad_proc,
	wdc.costeo_estudios,
	wdc.beca,
	wdc.tecno_internet,
	wdc.tecno_pc,
	wdc.idioma,
	wdc.discapacidad
	FROM actas_abiertas
    JOIN sga_eval_detalle_examenes  ON sga_eval_detalle_examenes.id_acta = actas_abiertas.id_acta
	JOIN sga_planes_versiones ON sga_planes_versiones.plan_version = sga_eval_detalle_examenes.plan_version
	JOIN _wichi_mesas_examen ON _wichi_mesas_examen.llamado_mesa = actas_abiertas.llamado_mesa
	JOIN sga_alumnos ON sga_alumnos.alumno = sga_eval_detalle_examenes.alumno
	JOIN mdp_personas ON sga_alumnos.persona = mdp_personas.persona
	JOIN _wichi_intentos_examenes intentos ON (intentos.alumno = sga_eval_detalle_examenes.alumno AND intentos.elemento = _wichi_mesas_examen.mesa_examen_elemento
	  AND intentos.llamado_mesa = _wichi_mesas_examen.llamado_mesa)

	-- Otra propuesta del alumno  
	JOIN sga_alumnos as sga_alumnos2 on sga_alumnos2.persona = sga_alumnos.persona
	JOIN sga_propuestas ON sga_propuestas.propuesta = sga_alumnos2.propuesta
	JOIN sga_planes_versiones as sga_planes_versiones2 on sga_planes_versiones2.plan_version = sga_alumnos2.plan_version
	JOIN sga_elementos_revision as sga_elementos_revision2 on sga_elementos_revision2.elemento = _wichi_mesas_examen.mesa_examen_elemento
	JOIN sga_elementos_plan as sga_elementos_plan2 on sga_elementos_plan2.plan_version      = sga_alumnos2.plan_version
	                                               AND sga_elementos_plan2.elemento_revision = sga_elementos_revision2.elemento_revision

    LEFT JOIN sga_escalas_notas_det ON (sga_escalas_notas_det.escala_nota = sga_eval_detalle_examenes.escala_nota AND  sga_escalas_notas_det.nota = sga_eval_detalle_examenes.nota)
    LEFT JOIN sga_catedras ON sga_catedras.catedra = _wichi_mesas_examen.mesa_examen_catedra
	JOIN _wichi_ingreso_alumnos as ingreso ON ingreso.alumno = sga_alumnos2.alumno
	JOIN _wichi_datos_censales wdc ON (sga_alumnos.persona = wdc.persona AND _wichi_mesas_examen.anio_academico = wdc.anio_academico)
	     
	WHERE sga_eval_detalle_examenes.instancia IN (3,4,7) -- Regulares / Libres / Examen Complementario	  
	  AND sga_alumnos2.propuesta &lt;&gt; sga_alumnos.propuesta
	  AND (${periodo} = 0 or _wichi_mesas_examen.anio_academico = ${periodo})</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>80</xloc>
      <yloc>144</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
