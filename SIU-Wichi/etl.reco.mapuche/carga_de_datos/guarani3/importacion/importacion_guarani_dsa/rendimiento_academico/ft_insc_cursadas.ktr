  <step>
    <name>ft_insc_cursadas</name>
    <type>TableInput</type>
    <description>Lee los datos de siu_dsa.guarani_tmp</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT
 ltub.ubicacion_id
, ltaa.anio_id as anio_academico
, lttp.tipo_periodo_id
, ltpc.periodo_id as periodo_lectivo_id 
, a.alumno_id 
, lte.edad_id
, lts.sexo_id
, n.nacionalidad_id 
, ltpro.procedencia_id
, ltc.propuesta_formativa_id
, ra.responsable_academica_id
, ltpl.plan_version_id
, ltm.actividad_id
, ltcr.catedra_id
, ltco.comision_id
, ltcg.condicion_id
, ltmc.actividad_comun_id as tipo_actividad_id
, inscripcion::integer
, nro_transaccion::integer
, ltei.estado_inscripcion_id
, lttc.turno_cursada_id
, to_date(fecha_inscripcion,'dd/mm/yyyy')as fecha_inscripcion
, cast((case when ltiu.anio_id &lt; 1949 then -1 else ltiu.anio_id end)as integer) as anio_ingreso_institucion
, ltpi.periodo_inscripcion_id as periodo_inscripcion_pf_id
, cast(cantidad_registros_inscripciones as integer) as cantidad_registros_inscripciones
, moda.modalidad_id 
, per.persona_id
, coalesce(lth.horas_trabajadas_id, 
    (select horas_trabajadas_id from guarani3_dsa.d_horas_trabajadas where horas_trabajadas_codigo = '-9' and vigente='Y')
  ) as horas_trabajadas_id
, estc.estado_civil_id
, loc_per.localidad_id as localidad_periodo_lectivo_id
, loc_pro.localidad_id as localidad_procedencia_id
, ft.costeo_estudios_id
, ft.beca_id
, ft.tecno_internet_id
, ft.tecno_pc_id
, ft.idioma_id
, ft.discapacidad_id
FROM guarani3_tmp.ft_inscripciones_cursadas ft
left outer join guarani3_dsa.d_ubicacion ltub on (ft.ubicacion_id=ltub.ubicacion_codigo and ltub.instalacion_id = ${instalacion_id} and ltub.vigente='Y')
left outer join public.d_anio ltaa on (cast(ft.anio_academico as integer) = ltaa.anio_id)
left outer join guarani3_dsa.d_tipo_periodo lttp on (ft.tipo_periodo_id=lttp.tipo_periodo_codigo and lttp.vigente='Y')
left outer join guarani3_dsa.d_alumno a on (ft.alumno_id::integer = a.alumno_codigo and a.instalacion_id = ${instalacion_id} and a.vigente='Y')
left outer join guarani3_dsa.d_edad lte on (ft.edad_id::integer = lte.edad and lte.vigente = 'Y' )
left outer join guarani3_dsa.d_sexo lts on (ft.sexo_id::integer = lts.sexo_codigo and lts.vigente = 'Y')
left outer join guarani3_dsa.d_nacionalidad n on (ft.nacionalidad_id::integer = n.nacionalidad_codigo and n.vigente='Y') 
left outer join guarani3_dsa.d_procedencia ltpro on (ft.colegio_secundario_id = ltpro.colegio_id and ltpro.vigente = 'Y')
left outer join guarani3_dsa.d_propuesta_formativa ltc on (ft.propuesta_formativa_id = ltc.propuesta_formativa_codigo and ltc.instalacion_id = ${instalacion_id}  and ltc.vigente = 'Y')
left outer join guarani3_tmp.d_propuesta_formativa pf on (ft.propuesta_formativa_id = pf.propuesta_formativa_id)
left outer join guarani3_dsa.d_responsable_academica ra on (pf.responsables_academicas_codigo = ra.responsable_academica_codigo and ra.instalacion_id = ${instalacion_id} and ra.vigente = 'Y')
left outer join guarani3_dsa.d_actividad ltm on (ft.actividad_id::integer=ltm.elemento and ltm.instalacion_id = ${instalacion_id} and ltm.vigente='Y')
left outer join guarani3_dsa.d_catedra ltcr on ( ft.catedra_id = ltcr.catedra_codigo and ltcr.instalacion_id = ${instalacion_id} and ltcr.vigente='Y')
left outer join guarani3_dsa.d_condicion ltcg on (ft.instancias_desc = ltcg.condicion_codigo and  ltcg.vigente='Y')
left outer join guarani3_dsa.d_actividad_comun ltmc on (ft.tipo_actividad_id=ltmc.actividad_comun_codigo and ltmc.vigente='Y')
left outer join guarani3_dsa.d_plan_version ltpl on (ft.plan_version_id=ltpl.plan_version_codigo and ltpl.instalacion_id = ${instalacion_id} and ltpl.vigente='Y')
left outer join guarani3_dsa.d_estado_inscripcion ltei on (ft.estado_inscripcion_id = ltei.estado_inscripcion_codigo and ltei.vigente='Y')
left outer join guarani3_dsa.d_comision ltco on (ft.comision_id = ltco.comision_codigo and ltco.instalacion_id = ${instalacion_id} and ltco.vigente='Y')
left outer join public.d_anio ltiu on (cast (ft.anio_ingreso_institucion as integer)= ltiu.anio_id)
left outer join guarani3_dsa.d_periodo_inscripcion ltpi on (ft.periodo_inscripcion_pf_desc = ltpi.periodo_inscripcion_codigo and ft.anio_ingreso_pf = ltpi.anio_academico and ltpi.instalacion_id = ${instalacion_id} and ltpi.vigente='Y')
left outer join guarani3_dsa.d_tipo_periodo lttt on (ft.tipo_periodo_id = lttt.tipo_periodo_codigo and lttt.vigente='Y')
left outer join guarani3_dsa.d_periodo_anio_academico ltpc on ((ft.anio_academico || ' - ' || ft.tipo_periodo_id || ' - ' || ft.periodo_lectivo_desc) = ltpc.periodo_desc and ft.anio_academico = ltpc.anio_academico and ltpc.tipo_periodo_id = lttt.tipo_periodo_id and ltpc.instalacion_id = ${instalacion_id} and ltpc.vigente='Y')
left outer join guarani3_dsa.d_turno_cursada lttc on (ft.turno_id = lttc.turno_cursada_codigo and lttc.vigente='Y')
left join guarani3_dsa.d_persona per on (ft.persona_id = per.persona_codigo and per.instalacion_id = ${instalacion_id} and per.vigente='Y')
left join guarani3_dsa.d_horas_trabajadas lth on (ft.horas_trabajadas_id = lth.horas_trabajadas_codigo and lth.vigente = 'Y')
left join guarani3_dsa.d_localidad loc_per on (ft.localidad_per_lec_id = loc_per.localidad_codigo and loc_per.vigente='Y')    
left join guarani3_dsa.d_localidad loc_pro on (ft.localidad_proc_id = loc_pro.localidad_codigo and loc_pro.vigente='Y') 
left join guarani3_dsa.d_estado_civil estc on (ft.estado_civil_id = estc.estado_civil_codigo and estc.vigente='Y') 
left join guarani3_dsa.d_modalidad moda on (ft.modalidad_id = moda.modalidad_codigo and moda.vigente = 'Y' )</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
