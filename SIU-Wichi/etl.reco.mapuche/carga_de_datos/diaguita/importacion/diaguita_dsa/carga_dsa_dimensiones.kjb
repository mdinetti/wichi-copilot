    <entry>
      <name>corregir datos catalogo_bienes_servicios</name>
      <description/>
      <type>SQL</type>
      <sql>&#xa;--corregir cat&#xe1;logo de bienes_servicios &#x28;COMPRAS&#x29;&#xa;&#xa;update diaguita_dsa.d_catalogo_bien_servicio &#xa;set catalogo_bien_nivel1_desc &#x3d;&#xa;&#x28;&#xa;  select left&#x28;codigo_completo, 1&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nombre&#xa;  from diaguita_tmp.d_catalogo_bienes_servicios t&#xa;  where cast&#x28;t.id_catalogo_bien_patrimonial as integer&#x29; &#x3d; catalogo_bien_nivel1_codigo&#xa;&#x29;&#xa;where catalogo_bien_nivel1_desc &#x7e; &#x27;&#x5e;&#x5b;0-9&#x5d;&#x27;&#x3b;&#xa;&#xa;update diaguita_dsa.d_catalogo_bien_servicio &#xa;set catalogo_bien_nivel2_desc &#x3d;&#xa;&#x28;&#xa;  select left&#x28;codigo_completo, 3&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nombre&#xa;  from diaguita_tmp.d_catalogo_bienes_servicios t&#xa;  where cast&#x28;t.id_catalogo_bien_patrimonial as integer&#x29; &#x3d; catalogo_bien_nivel2_codigo&#xa;&#x29;&#xa;where catalogo_bien_nivel2_desc &#x7e; &#x27;&#x5e;&#x5b;0-9&#x5d;&#x27;&#x3b;&#xa;&#xa;update diaguita_dsa.d_catalogo_bien_servicio &#xa;set catalogo_bien_nivel3_desc &#x3d;&#xa;&#x28;&#xa;  select left&#x28;codigo_completo, 5&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nombre&#xa;  from diaguita_tmp.d_catalogo_bienes_servicios t&#xa;  where cast&#x28;t.id_catalogo_bien_patrimonial as integer&#x29; &#x3d; catalogo_bien_nivel3_codigo&#xa;&#x29;&#xa;where catalogo_bien_nivel3_desc &#x7e; &#x27;&#x5e;&#x5b;0-9&#x5d;&#x27;&#x3b;&#xa;&#xa;update diaguita_dsa.d_catalogo_bien_servicio &#xa;set catalogo_bien_nivel4_desc &#x3d;&#xa;&#x28;&#xa;  select left&#x28;codigo_completo, 5&#x29; &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; nombre&#xa;  from diaguita_tmp.d_catalogo_bienes_servicios t&#xa;  where cast&#x28;t.id_catalogo_bien_patrimonial as integer&#x29; &#x3d; catalogo_bien_nivel4_codigo&#xa;&#x29;&#xa;where catalogo_bien_nivel4_desc &#x7e; &#x27;&#x5e;&#x5b;0-9&#x5d;&#x5c;.&#x5b;0-9&#x5d;&#x5c;.&#x5b;0-9&#x5d;&#x27;&#x3b;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
