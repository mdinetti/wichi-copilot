    <entry>
      <name>update ft jndi sin inst</name>
      <description/>
      <type>SQL</type>
      <sql>update &#x24;&#x7b;esquema&#x7d;.&#x24;&#x7b;tabla_ft&#x7d; ft&#xa;set unidad_generica_id &#x3d; coalesce&#x28;&#xa;    &#x28;select distinct unidad_generica_id&#xa;    from d_unidad u, &#x24;&#x7b;esquema&#x7d;.&#x24;&#x7b;tabla_dimension&#x7d; dim ,d_instalacion i&#xa;    where dim.&#x24;&#x7b;campo_dim_id&#x7d; &#x3d; ft.&#x24;&#x7b;campo_ft_id&#x7d;&#xa;    and dim.instalacion_id &#x3d; u.instalacion_id&#xa;    and u.unidad_desc &#x3d; dim.&#x24;&#x7b;campo_desc&#x7d;&#xa;    and i.fuente_dato_id &#x3d; &#x24;&#x7b;sistema_fuente&#x7d;&#x29;&#xa;  , 0&#x29;&#xa;where &#x24;&#x7b;forzar_ft&#x7d;&#x3d;1 or coalesce&#x28;ft.unidad_generica_id, 0&#x29; &#x3d; 0&#x3b;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename>&#x24;&#x7b;Internal.Job.Filename.Directory&#x7d;&#x2f;update_ft_sin_inst.sql</sqlfilename>
      <sendOneStatement>T</sendOneStatement>
      <connection>DBWichi</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>224</xloc>
      <yloc>80</yloc>
      </entry>
    <entry>
      <name>&#xc9;xito</name>
      <description/>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>400</xloc>
      <yloc>80</yloc>
      </entry>
