      <description/>
      <type>SQL</type>
      <sql>UPDATE pilaga_tmp.ft_movimientos_gastos  SET fecha_valor&#x3d; &#x28;&#x24;&#x7b;periodo&#x7d;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01-01&#x27;&#x29;&#x3a;&#x3a;date WHERE fecha_valor&#x3c; &#x28;&#x24;&#x7b;periodo&#x7d;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01-01&#x27;&#x29;&#x3a;&#x3a;date AND devengado_ex&#x3c;&#x3e;0&#x3b;&#xa;UPDATE pilaga_tmp.ft_movimientos_gastos  SET fecha_valor&#x3d; &#x28;&#x24;&#x7b;periodo&#x7d;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01-01&#x27;&#x29;&#x3a;&#x3a;date WHERE fecha_valor&#x3c; &#x28;&#x24;&#x7b;periodo&#x7d;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27;-01-01&#x27;&#x29;&#x3a;&#x3a;date AND pagado_ex&#x3c;&#x3e;0&#x3b;&#xa;DELETE FROM pilaga_tmp.ft_movimientos_gastos WHERE devengado_ex&#x3c;&#x3e;0.00 AND paso in &#x28;SELECT paso_anterior  FROM pilaga_tmp.ft_movimientos_gastos  WHERE etapa_presupuestaria &#x3d;&#x27;PA&#x27; and pagado_ex &#x3c;&#x3e; 0 AND extract&#x28;year from fecha_movimiento&#x29; &#x3c; extract&#x28;year from fecha_valor&#x29;&#x29;&#x3b;&#xa;DELETE FROM pilaga_tmp.ft_movimientos_gastos WHERE etapa_presupuestaria &#x3d;&#x27;PA&#x27; and pagado_ex &#x3c;&#x3e; 0 AND extract&#x28;year from fecha_movimiento&#x29; &#x3c; extract&#x28;year from fecha_valor&#x29;&#x3b;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dsa</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>592</xloc>
      <yloc>704</yloc>
      </entry>
