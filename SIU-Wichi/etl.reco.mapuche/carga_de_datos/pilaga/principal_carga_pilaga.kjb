<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>principal_carga_pilaga</name>
    <description>Extrae los txt e importa los datos al la base siu_wichi</description>
    <extended_description>Los pasos a realizar&#x3a;&#xa;1- Extraer los archivos txt desde la base pilaga.&#xa;2- Importar los txt en la base siu_wichi.pilaga_tmp&#xa;3- Importar los datos en la base siu_wichi.pilaga_dsa&#xa;4- Importar los datos en la base siu_wichi.pilaga &#x28;dw&#x29;</extended_description>
    <job_version/>
    <job_status>0</job_status>
  <directory>&#x2f;</directory>
  <created_user>-</created_user>
  <created_date>2013&#x2f;01&#x2f;24 12&#x3a;23&#x3a;51.985</created_date>
  <modified_user>-</modified_user>
  <modified_date>2013&#x2f;01&#x2f;24 12&#x3a;23&#x3a;51.985</modified_date>
    <parameters>
        <parameter>
            <name>actualizacion</name>
            <default_value>-1</default_value>
            <description>si se trata de una actualizacion de datos &#x3c;1&#x3a;SI &#x7c; 0&#x3a;NO&#x3e;</description>
        </parameter>
        <parameter>
            <name>base_clave</name>
            <default_value>__SIN_VALOR___x1tljQ7imSqp_fBnDme5M2WZBADj0iuK</default_value>
            <description>clave del usuario de la base siu_wichi</description>
        </parameter>
        <parameter>
            <name>base_host</name>
            <default_value>localhost</default_value>
            <description>IP o nombre del host donde se encuentra la base siu_wichi</description>
        </parameter>
        <parameter>
            <name>base_nombre</name>
            <default_value>siu_wichi</default_value>
            <description>nombre de la base de datos de wichi</description>
        </parameter>
        <parameter>
            <name>base_puerto</name>
            <default_value>5432</default_value>
            <description>puerto al en el que escucha el servidor de postgres de wichi</description>
        </parameter>
        <parameter>
            <name>base_usuario</name>
            <default_value>postgres</default_value>
            <description>usuario que tiene acceso al servidor de postgres de wichi</description>
        </parameter>
        <parameter>
            <name>comentario</name>
            <default_value/>
            <description>&#x28;Opcional&#x29; </description>
        </parameter>
        <parameter>
            <name>commit_size</name>
            <default_value>10000</default_value>
            <description>cada cuantos insert se hace commit</description>
        </parameter>
        <parameter>
            <name>directorioDestino</name>
            <default_value>&#x2f;home&#x2f;wichi&#x2f;pilaga</default_value>
            <description>directorio donde se va a crear el paquete con los txt extraidos de pilag&#xe1;</description>
        </parameter>
        <parameter>
            <name>directorioTemporal</name>
            <default_value>&#x2f;home&#x2f;wichi&#x2f;pilaga&#x2f;temp</default_value>
            <description>directorio temporal vac&#xed;o para armado del paquete</description>
        </parameter>
        <parameter>
            <name>directorioTxt</name>
            <default_value>&#x2f;home&#x2f;wichi&#x2f;pilaga&#x2f;txt</default_value>
            <description>directorio temporal donde se van a crear los txt extraidos de la base de pilag&#xe1;</description>
        </parameter>
        <parameter>
            <name>encriptacion</name>
            <default_value>ninguna</default_value>
            <description>tipo de encriptaci&#xf3;n&#x3a; publica&#x7c;ninguna</description>
        </parameter>
        <parameter>
            <name>instalacion</name>
            <default_value/>
            <description>N&#xfa;mero de instalaci&#xf3;n en formato id-codigo &#x28;ej&#x3a; 3-692&#x29;</description>
        </parameter>
        <parameter>
            <name>passPgp</name>
            <default_value/>
            <description>&#x28;Opcional&#x29;</description>
        </parameter>
        <parameter>
            <name>periodo</name>
            <default_value>0</default_value>
            <description>&#x3c;AAAA&#x3e; a&#xf1;o al que corresponden los datos importados ej&#x3a;2012</description>
        </parameter>
        <parameter>
            <name>rutaGpg</name>
            <default_value>&#x2f;usr&#x2f;bin&#x2f;gpg</default_value>
            <description>ruta al ejecutable de gpg</description>
        </parameter>
        <parameter>
            <name>userIdServidorCentral</name>
            <default_value/>
            <description>user ID de gpg del servidor central Wichi</description>
        </parameter>
        <parameter>
            <name>wildcardPgp</name>
            <default_value/>
            <description>Generalmente se puede dejar vac&#xed;o</description>
        </parameter>
    </parameters>
    <slaveservers>
    </slaveservers>
