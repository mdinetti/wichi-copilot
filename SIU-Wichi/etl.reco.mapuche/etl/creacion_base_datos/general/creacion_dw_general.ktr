    <quoteString>N</quoteString>
    <sql>--Tablas comunes

CREATE TABLE public.version
(
  id serial,
  "version" character(6),
  descripcion text,
  fechacarga timestamp without time zone,
  CONSTRAINT dsa_ft_version_pkey PRIMARY KEY (id)
);
COMMENT ON TABLE version IS 'Tabla con información de las versiones de la base de datos y las migraciones entre versiones.';

--Tabla para el log de accesos
CREATE TABLE public.dw_ft_logacceso
(
 id_mensaje integer,
 fecha date,
 hora integer,
 minuto integer,
 usuario character varying(50),
 nombre text,
 tipo text,
 ruta text,
 cant_sesiones integer DEFAULT 0,
 cant_consultas integer DEFAULT 0
)
WITH (
 OIDS=FALSE
);
CREATE INDEX idx_fecha_log ON dw_ft_logacceso USING btree (fecha);

--Tabla de tipos de exportaciones disponibles para los tableros / reportes
CREATE TABLE public.tipo_exportacion
(
  tipo_exportacion_codigo character varying(50) NOT NULL,
  tipo_exportacion_orden integer NOT NULL,
  tipo_exportacion_valor character varying(50) NOT NULL,
  CONSTRAINT pk_tipo_exportacion PRIMARY KEY (tipo_exportacion_codigo)
)
WITH (
OIDS=FALSE
);
COMMENT ON TABLE tipo_exportacion IS 'Tabla con los tipos de exportaciones disponibles para los reportes.';

--Tabla de generos
CREATE TABLE public.d_genero
(
  genero_id integer not null, 
  genero_codigo character varying,
  genero_desc character varying,
  fecha_desde DATE,
  fecha_hasta DATE,
  version INTEGER,
  vigente VARCHAR,
  fecha_actualizacion TIMESTAMP without time zone,
  constraint d_genero_pkey primary key (genero_id)
);

--Fin tablas comunes

--Tablas de registro y configuración
CREATE TABLE public.d_institucion
(
  institucion_id serial NOT NULL,
  institucion_codigo_saf character varying NOT NULL,
  institucion_codigo_ona character varying NOT NULL,
  institucion_desc character varying NOT NULL,
  institucion_sigla character varying,
  CONSTRAINT d_institucion_pkey PRIMARY KEY (institucion_id)
)
WITH (
  OIDS=FALSE
);

CREATE TABLE public.d_unidad_generica
(
  unidad_generica_id serial NOT NULL,
  institucion_id integer NOT NULL,
  unidad_generica_desc character varying NOT NULL,
  rol_desc character varying NOT NULL,
  CONSTRAINT d_unidad_generica_pkey PRIMARY KEY (unidad_generica_id),
  CONSTRAINT d_unidad_generica_institucion_id_fkey FOREIGN KEY (institucion_id)
      REFERENCES d_institucion (institucion_id) MATCH SIMPLE
      ON UPDATE NO ACTION ON DELETE NO ACTION
)
WITH (
  OIDS=FALSE
);
CREATE INDEX idxp_unidadgenericaid ON public.d_unidad_generica USING btree (unidad_generica_id);

CREATE TABLE public.d_fuente_dato
(
  fuente_dato_id serial NOT NULL,
  fuente_dato_desc character varying NOT NULL,
  con_subfuente boolean DEFAULT false,
  CONSTRAINT d_fuente_dato_pkey PRIMARY KEY (fuente_dato_id)
)
WITH (
  OIDS=FALSE
);

CREATE TABLE public.d_instalacion
(
  instalacion_id serial not null,
  instalacion_desc text,
  instalacion_codigo text default trim(to_char(trunc(random()*1000), '000')),
  fuente_dato_id integer not null,
  activa character(1) DEFAULT 'S',
  subfuente_id integer DEFAULT 0,
  CONSTRAINT d_instalacion_pkey PRIMARY KEY (instalacion_id),
  CONSTRAINT d_instalacion_fuente_dato_fkey FOREIGN KEY (fuente_dato_id)
      REFERENCES d_fuente_dato (fuente_dato_id)
);

--Tabla para el registro de las importaciones de datos
CREATE TABLE public.importacion
(
  importacion_id serial NOT NULL,
  instalacion_id integer, -- hace referencia a un registro de la tabla instalaciones
  fecha_datos timestamp without time zone, -- Fecha en que se exportaron los datos del sistema de origen
  fecha_inicio timestamp without time zone, -- fecha/hora de inicio de la  importación de los datos a dw
  fecha_fin timestamp without time zone, -- fecha/hora de finalización de la  importación de los datos a dw)
  tipo character varying, -- actualizacion | nueva
  parametros character varying, -- indica que datos se importaron, ej: período, unidad acad.
  observaciones text,
  estado character varying, -- en proceso | terminada
  CONSTRAINT importacion_pkey PRIMARY KEY (importacion_id),
  CONSTRAINT d_importacion_instalacion_id_fkey FOREIGN KEY (instalacion_id)
      REFERENCES d_instalacion (instalacion_id)
      ON UPDATE NO ACTION ON DELETE NO ACTION
)
WITH (
  OIDS=FALSE
);
--ALTER TABLE importacion OWNER TO postgres;
COMMENT ON TABLE importacion IS 'Tabla con información de las importaciones de datos que se realizan en siu_dw';
COMMENT ON COLUMN importacion.instalacion_id IS 'hace referencia a un registro de la tabla instalaciones';
COMMENT ON COLUMN importacion.fecha_datos IS 'Fecha en que se exportaron los datos del sistema de origen';
COMMENT ON COLUMN importacion.fecha_inicio IS 'fecha/hora de inicio de la  importación de los datos a dw';
COMMENT ON COLUMN importacion.fecha_fin IS 'fecha/hora de finalización de la  importación de los datos a dw';
COMMENT ON COLUMN importacion.tipo IS 'actualizacion | nueva';
COMMENT ON COLUMN importacion.parametros IS 'indica que datos se importaron, ej: período, unidad acad.';
COMMENT ON COLUMN importacion.estado IS 'en proceso | terminada';

CREATE TABLE public.d_unidad
(
  unidad_id serial NOT NULL,
  unidad_generica_id integer NOT NULL,
  instalacion_id integer NOT NULL,
  unidad_desc character varying NOT NULL,
  CONSTRAINT d_unidad_pkey PRIMARY KEY (unidad_id),
  CONSTRAINT d_unidad_unidad_generica_id_fkey FOREIGN KEY (unidad_generica_id)
      REFERENCES d_unidad_generica (unidad_generica_id) MATCH SIMPLE
      ON UPDATE NO ACTION ON DELETE NO ACTION,
  CONSTRAINT d_unidad_instalacion_id_fkey FOREIGN KEY (instalacion_id)
      REFERENCES d_instalacion(instalacion_id)
      ON UPDATE NO ACTION ON DELETE NO ACTION,
  CONSTRAINT d_unidad_fuente_dato_id_key UNIQUE (instalacion_id, unidad_desc)
)
WITH (
  OIDS=FALSE
);

CREATE TABLE public.parametro_instalacion
(
  instalacion_id integer not null,
  nombre text not null,
  valor text,
  CONSTRAINT d_parametro_instalacion_pkey PRIMARY KEY (instalacion_id, nombre),
  CONSTRAINT d_parametro_instalacion_instalacion_fkey FOREIGN KEY (instalacion_id)
      REFERENCES d_instalacion (instalacion_id)
);

--Tablas para el manejo de fechas y periodos

CREATE TABLE public.d_anio
(
  anio_id integer not null,   -- YYYY
  constraint d_anio_pkey primary key (anio_id)
);

CREATE TABLE d_mes
(
  mes_id integer NOT NULL,
  mes_desc character varying NOT NULL,
  CONSTRAINT d_mes_pkey PRIMARY KEY (mes_id)
);
CREATE TABLE public.d_periodo
(
  periodo_id integer not null,   -- YYYYMM 
  periodo_desc character varying not null, -- MM-YYYY
  anio integer,  -- YYYY
  mes integer, -- número de mes
  mes_desc character varying,  -- ej: ‘Enero’
  constraint d_periodo_pkey primary key (periodo_id)
);

CREATE TABLE public.d_fecha
(
  fecha_id date NOT NULL,
  anio integer NOT NULL,
  mes integer NOT NULL,
  dia integer NOT NULL,
  dia_semana integer NOT NULL, --(Dom(1) - Sab(7)) 
  dia_semana_desc character varying NOT NULL, --(Domingo - Sabado)
  dia_semana_abreviada_desc character varying NOT NULL, --(Dom - Sab)
  mes_desc character varying NOT NULL, --(Enero - Diciembre)
  mes_abreviado_desc character varying NOT NULL, --(Ene - Dic)
  trimestre integer NOT NULL, -- (1 al 4)
  trimestre_desc character varying NOT NULL,   --(1er trimestre - 4to trimestre)
  semestre integer NOT NULL, -- (1 o 2)	
  semestre_desc character varying NOT NULL, --(1er semestre - 2do semestre)
  quincena integer NOT NULL, -- (1 o 2)	
  quincena_desc character varying NOT NULL, --(1er quincena - 2da quincena)
  constraint d_fecha_pkey primary key (fecha_id)
);
CREATE INDEX idx_d_fecha_anio ON d_fecha USING btree (anio);
CREATE INDEX idx_d_fecha_dia ON d_fecha USING btree (dia);
CREATE INDEX idx_d_fecha_mes ON d_fecha USING btree (mes);

create extension pgcrypto; 

-- Crear tabla para las subfuentes
CREATE TABLE IF NOT EXISTS public.d_subfuente
(
    subfuente_id serial,
    fuente_dato_id integer,
    subfuente_desc character varying,
    habilitada boolean,
    CONSTRAINT pk_d_subfuente PRIMARY KEY (subfuente_id),
    CONSTRAINT d_subfuente_fuente_dato_id_fkey FOREIGN KEY (fuente_dato_id)
        REFERENCES public.d_fuente_dato (fuente_dato_id) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION
);


--Crear tabla de configuración de parámetros de la fuente
CREATE TABLE public.parametros_fuente_dato (
    fuente_dato_id INTEGER,
    esquema character varying,
    clave character varying, 
    valor character varying,  
    CONSTRAINT parametros_fuente_dato_pk PRIMARY KEY (fuente_dato_id, clave)
);

	
