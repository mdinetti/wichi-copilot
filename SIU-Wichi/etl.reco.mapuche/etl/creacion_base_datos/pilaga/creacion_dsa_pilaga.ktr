  concepto_ingreso_id integer,
  tipo_operacion_id integer,
  ejercicio_id integer,
  codigo_ud_id integer,
  tipo_resolucion_id integer,
  nro_resolucion character varying,
  anio_resolucion integer,
  credito_original numeric(14,2),
  credito_modificatorio numeric(14,2),
  credito numeric(14,2),
  preventivo numeric(14,2),
  compromiso numeric(14,2),
  devengado numeric(14,2),
  pagado numeric(14,2),
  devengado_ex numeric(14,2),
  pagado_ex numeric(14,2),
  retenciones numeric(14,2),
  disponibilidades numeric(14,2),
  previsto_de_ingreso numeric(14,2),
  estimado_de_ingreso numeric(14,2),
  devengado_de_ingreso numeric(14,2),
  cobrado numeric(14,2)
);

