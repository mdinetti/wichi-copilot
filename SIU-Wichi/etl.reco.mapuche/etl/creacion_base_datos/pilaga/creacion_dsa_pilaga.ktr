    <sql>--Esquema pilaga_dsa

--Crea el esquema dsa de pilagá
CREATE SCHEMA pilaga_dsa;

--tablas dimensiones 

--d_red_programatica
CREATE TABLE pilaga_dsa.d_red_programatica
(
  red_programatica_id integer NOT NULL,
  red_programatica_codigo character varying,
  programa_desc character varying,
  subprograma_desc character varying,
  proyecto_desc character varying,
  actividad_desc character varying,
  obra_desc character varying,
  red_programatica_combo_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
 CONSTRAINT pk_d_red_programatica PRIMARY KEY (red_programatica_id)
);

--d_banco_sucursal
CREATE TABLE pilaga_dsa.d_banco_sucursal
 (
  banco_sucursal_id integer NOT NULL, 
  banco_desc character varying,
  cuit character varying, -- datos del banco
  sucursal_desc character varying,
  sucursal_codigo character varying,
  fecha_desde date, 
  fecha_hasta date, 
  version integer, 
  vigente character varying,
  fecha_actualizacion TIMESTAMP WITHOUT TIME ZONE,
CONSTRAINT pk_d_banco_sucursal PRIMARY KEY (banco_sucursal_id)
);

--d_circuito_gestion 
CREATE TABLE pilaga_dsa.d_circuito_gestion
(
  circuito_gestion_id integer NOT NULL,
  circuito_gestion_codigo character varying,
  circuito_gestion_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
 CONSTRAINT pk_d_circuito_gestion PRIMARY KEY (circuito_gestion_id)
);

--d_codigo_economico
CREATE TABLE pilaga_dsa.d_codigo_economico
(
  codigo_economico_id integer NOT NULL,
  codigo_economico_codigo character varying,
  codigo_economico_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
 CONSTRAINT pk_d_codigo_economico PRIMARY KEY (codigo_economico_id)
);

-- d_concepto_ingreso
CREATE TABLE pilaga_dsa.d_concepto_ingreso
 (
  concepto_ingreso_id integer NOT NULL,
  concepto_ingreso_codigo character varying, 
  tipo_ingreso_desc character varying, 
  concepto_ingreso_desc character varying, 
  fecha_desde date, 
  fecha_hasta date, 
  version integer, 
  vigente character varying, 
  fecha_actualizacion TIMESTAMP WITHOUT TIME ZONE,
CONSTRAINT pk_d_concepto_ingreso PRIMARY KEY (concepto_ingreso_id)
);

--d_finalidad_funcion
CREATE TABLE pilaga_dsa.d_finalidad_funcion
(
  finalidad_funcion_id integer NOT NULL,
  finalidad_codigo smallint,
  funcion_codigo smallint,
  finalidad_desc character varying,
  funcion_desc character varying,
  finalidad_funcion_combo_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
CONSTRAINT pk_d_finalidad_funcion PRIMARY KEY (finalidad_funcion_id)
);

-- d_fuente
CREATE TABLE pilaga_dsa.d_fuente
(
  fuente_id integer NOT NULL,
  fuente_codigo smallint,
  fuente_desc character varying,
  fuentecompleto_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
 CONSTRAINT pk_dsa_d_fuente PRIMARY KEY (fuente_id)
);
CREATE UNIQUE INDEX pk_d_fuente ON pilaga_dsa.d_fuente  (fuente_id);

--d_grupo_presupuestario
CREATE TABLE pilaga_dsa.d_grupo_presupuestario
(
  grupo_presupuestario_id integer NOT NULL,
  grupo_presupuestario_codigo character varying,
  grupo_presupuestario_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
 CONSTRAINT pk_d_grupo_presupuestario PRIMARY KEY (grupo_presupuestario_id)
);

-- d_moneda 
CREATE TABLE pilaga_dsa.d_moneda
 (
  moneda_id integer NOT NULL,
  moneda_tipo_desc character varying, 
  moneda_codigo character varying, 
  moneda_desc character varying, 
  fecha_desde date, 
  fecha_hasta date, 
  version integer, 
  vigente character varying, 
  fecha_actualizacion TIMESTAMP WITHOUT TIME ZONE,
CONSTRAINT pk_d_moneda PRIMARY KEY (moneda_id)
);

--d_objeto_del_gasto
CREATE TABLE pilaga_dsa.d_objeto_del_gasto
(
  objeto_del_gasto_id integer NOT NULL,
  objeto_del_gasto_codigo character varying, 
  resumen_desc character varying, 
  inciso_desc character varying, 
  partida_principal_desc character varying, 
  partida_parcial_desc character varying, 
  objeto_del_gasto_desc character varying,
  orden integer, 
  fecha_desde date, 
  fecha_hasta date, 
  version integer, 
  vigente character varying, 
  fecha_actualizacion TIMESTAMP WITHOUT TIME ZONE,
 CONSTRAINT pk_d_objeto_del_gasto PRIMARY KEY (objeto_del_gasto_id)
);

-- d_rubro_ingreso
CREATE TABLE pilaga_dsa.d_rubro_ingreso
 (
  rubro_ingreso_id integer NOT NULL, 
  rubro_ingreso_codigo character varying, 
  grupo_desc character varying,
  rubro_desc character varying,
  tipo_desc character varying,
  clase_desc character varying,
  rubro_ingreso_desc character varying, 
  fecha_desde date, 
  fecha_hasta date, 
  version integer, 
  vigente character varying,
  fecha_actualizacion TIMESTAMP WITHOUT TIME ZONE,
CONSTRAINT pk_d_rubro_ingreso PRIMARY KEY (rubro_ingreso_id)
);

--d_unidad_presupuestaria
CREATE TABLE pilaga_dsa.d_unidad_presupuestaria
(
  unidad_presupuestaria_id integer NOT NULL,
  unidad_presupuestaria_codigo character varying,
  unidad_presupuestaria_desc character varying,
  subunidad_presupuestaria_desc character varying,
  subsubunidad_presupuestaria_desc character varying,
  unidad_presupuestaria_combo_desc character varying,
  instalacion_id INTEGER,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
 CONSTRAINT pk_d_unidad_presupuestaria PRIMARY KEY (unidad_presupuestaria_id)
);

--d_tipo_comprobante. De tercero.
CREATE TABLE pilaga_dsa.d_tipo_comprobante
(
  tipo_comprobante_id integer NOT NULL,
  tipo_comprobante_codigo character varying,
  tipo_comprobante_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
CONSTRAINT pk_d_tipo_comprobante PRIMARY KEY (tipo_comprobante_id)
);
--CREATE INDEX d_tipo_comprobante_por_codigo ON pilaga_dsa.d_tipo_comprobante (tipo_comprobante_codigo);

--d_tipo_documento (son documentos de la Universidad, no de terceros.)
CREATE TABLE pilaga_dsa.d_tipo_documento
(
  tipo_documento_id integer NOT NULL,
  tipo_documento_codigo character varying,
  tipo_documento_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
CONSTRAINT pk_d_tipo_documento PRIMARY KEY (tipo_documento_id)
);

--d_documento_principal (son documentos de la Universidad, no de terceros.)
CREATE TABLE pilaga_dsa.d_documento_principal
(
  documento_principal_id integer NOT NULL,
  documento_principal_codigo character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
CONSTRAINT pk_d_documento_principal PRIMARY KEY (documento_principal_id)
);

--d_tipo_persona. Clasificacion de proveedores que hace la Universidad. (Cliente / Proveedor / Tercero)
CREATE TABLE pilaga_dsa.d_tipo_persona
(
  tipo_persona_id integer NOT NULL,
  tipo_persona_codigo character varying,
  tipo_persona_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
CONSTRAINT pk_d_tipo_persona PRIMARY KEY (tipo_persona_id)
);

--d_persona
CREATE TABLE pilaga_dsa.d_persona     
(
  persona_id integer not null,
  persona_codigo integer,
  persona_tipo_documento character varying,
  persona_nro_documento character varying,
  fisica_o_juridica character varying,
  razon_social_apyno character varying,
  nombre_fantasia character varying,
  genero_id character varying,
  nacionalidad character varying,
  email character varying,
  cbu character varying,
  persona_detalle character varying,
  estado character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
CONSTRAINT pk_d_persona PRIMARY KEY (persona_id)
);

--d_cuenta_bancaria (banco, tipo y número de cuenta) Tambien existen cuentas “puente” que son usadas para hacer transferencias entre tesorerias y deberían siempre quedar con saldo cero.                        

CREATE TABLE pilaga_dsa.d_cuenta_bancaria
 (
  cuenta_bancaria_id integer NOT NULL,
  cuenta_bancaria_numero character varying,  
  cuenta_bancaria_tipo_desc character varying,
  cuenta_bancaria_desc character varying, -- Incluir entre parentesis la moneda   
  fecha_desde date, 
  fecha_hasta date, 
  version integer, 
  vigente character varying, 
  fecha_actualizacion TIMESTAMP WITHOUT TIME ZONE,
CONSTRAINT pk_d_cuenta_bancaria PRIMARY KEY (cuenta_bancaria_id)
);

--d_unidad_gestion
CREATE TABLE pilaga_dsa.d_unidad_gestion
 (
  unidad_gestion_id integer NOT NULL, 
  unidad_gestion_codigo character varying, 
  unidad_gestion_desc character varying, 
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
 CONSTRAINT pk_d_unidad_gestion PRIMARY KEY (unidad_gestion_id)
);

--d_fondo
CREATE TABLE pilaga_dsa.d_fondo
(
  fondo_id integer NOT NULL,
  tipo_fondo_desc character varying,          -- Presupuestario, No presupuestario
  tipo_fondo_terceros_desc character varying, -- Retenciones, Fondos de terceros
  fondo_desc character varying,               -- Retención de IVA, Retención de IIBB
  fondo_combo_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
CONSTRAINT pk_d_fondo PRIMARY KEY (fondo_id)
);

--d_cuenta_tesoreria (tesorería, tipo y número de cuenta)
CREATE TABLE pilaga_dsa.d_cuenta_tesoreria
 (
  cuenta_tesoreria_id integer NOT NULL, 
  cuenta_tesoreria_tipo_desc character varying, --Efectivo, Bancaria, Virtual
  cuenta_tesoreria_codigo integer, -- Codigo de cuenta en Pilaga
  cuenta_tesoreria_desc character varying, 
  tesoreria_desc character varying,  -- En realidad es usuario o responsable.? Se puede agregar entre parentesis la moneda.
  fecha_desde date, 
  fecha_hasta date, 
  version integer, 
  vigente character varying,
  fecha_actualizacion TIMESTAMP WITHOUT TIME ZONE,
CONSTRAINT pk_d_cuenta_tesoreria PRIMARY KEY (cuenta_tesoreria_id)
);

-- d_expediente
CREATE TABLE pilaga_dsa.d_expediente
(
  expediente_id integer NOT NULL,
  anio integer,
  tipo character varying, -- Se obtiene de “E” igual que d_tipo_documento
  expediente_nro character varying,
  expediente_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
CONSTRAINT pk_d_expediente PRIMARY KEY (expediente_id)
);

--d_comprobante (anio, numero[puesto y numero], fecha, descripcion) de tercero.
CREATE TABLE pilaga_dsa.d_comprobante
(
  comprobante_id integer NOT NULL,
  comprobante_fecha date,
  tipo_comprobante_id integer,
  persona_id integer,
  comprobante_numero character varying,
  comprobante_detalle character varying,
  importe numeric(14,2),
  detalle character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
CONSTRAINT pk_d_comprobante PRIMARY KEY (comprobante_id)
);
--CREATE INDEX d_comprobante_por_numero ON pilaga_dsa.d_comprobante (tipo_comprobante_id, persona_id, comprobante_numero);

--d_ejercicio
CREATE TABLE pilaga_dsa.d_ejercicio
(
  ejercicio_id integer NOT NULL,
  ejercicio_codigo character varying,
  ejercicio_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
 CONSTRAINT pk_d_ejercicio PRIMARY KEY (ejercicio_id)
);

-- d_medio_pago (sau_te_medios)
CREATE TABLE pilaga_dsa.d_medio_pago
 (
  medio_pago_id integer NOT NULL,
  medio_pago_codigo smallint,
  medio_pago_desc character varying,
  medio_pago_tipo_codigo character varying,
  medio_pago_tipo_desc character varying,
  fecha_desde date,
  fecha_hasta date,
  version integer,
  vigente character varying,
  fecha_actualizacion timestamp without time zone,
 CONSTRAINT pk_d_medio_pago PRIMARY KEY (medio_pago_id)
 );

