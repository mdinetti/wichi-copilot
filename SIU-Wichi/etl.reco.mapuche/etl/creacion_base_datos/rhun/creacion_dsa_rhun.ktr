    <sql>--Crea el esquema rhun_dsa&#xa;CREATE SCHEMA rhun_dsa&#x3b;&#xa;&#xa;--Tablas del esquema rhun&#xa;create table rhun_dsa.d_unidad_academica&#x28;&#xa;	unidad_academica_id	integer,&#xa;	unidad_academica_codigo	character varying,&#xa;	unidad_academica_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_unidad_academica primary key &#x28;unidad_academica_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_tipo_cargo_asociado&#x28;&#xa;	tipo_cargo_asociado_id	integer,&#xa;	tipo_cargo_asociado_codigo	character varying,&#xa;	tipo_cargo_asociado_desc	character varying,&#xa;	orden	integer,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_tipo_cargo_asociado primary key &#x28;tipo_cargo_asociado_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_concepto&#x28;&#xa;	concepto_id	integer,&#xa;	concepto_codigo	character varying,&#xa;	concepto_desc	character varying,&#xa;	tipo_concepto_codigo	character varying,&#xa;	tipo_concepto_desc	character varying,&#xa;	objeto_gasto_permanente_codigo character varying,&#xa;	objeto_gasto_transitorio_codigo character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_concepto primary key &#x28;concepto_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_escalafon&#x28;&#xa;	escalafon_id	integer,&#xa;	escalafon_codigo	character varying,&#xa;	escalafon_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_escalafon primary key &#x28;escalafon_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_categoria_universidad&#x28;&#xa;	categoria_universidad_id	integer,&#xa;	categoria_universidad_desc	character varying,&#xa;	categoria_universidad_dedicacion	character varying,&#xa;	escalafon_codigo	character varying,&#xa;	cargo_codigo	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_d_categoria_universidad primary key &#x28;categoria_universidad_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_fuente_financiamiento&#x28;&#xa;	fuente_financiamiento_id	integer,&#xa;	fuente_financiamiento_codigo	character varying,&#xa;	fuente_financiamiento_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_fuente_financiamiento primary key &#x28;fuente_financiamiento_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_estado_laboral&#x28;&#xa;	estado_laboral_id	integer,&#xa;	estado_laboral_codigo	character varying,&#xa;	estado_laboral_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_estado_laboral primary key &#x28;estado_laboral_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_situacion_laboral&#x28;&#xa;	situacion_laboral_id	integer,&#xa;	situacion_laboral_codigo	character varying,&#xa;	situacion_laboral_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_situacion_laboral primary key &#x28;situacion_laboral_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_ona_jerarquia&#x28;&#xa;	ona_jerarquia_id	integer,&#xa;	ona_rama_codigo	character varying,&#xa;	ona_rama_desc	character varying,&#xa;	ona_disciplina_codigo	character varying,&#xa;	ona_disciplina_desc	character varying,&#xa;	ona_area_codigo	character varying,&#xa;	ona_area_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_ona_jerarquia primary key &#x28;ona_jerarquia_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_agrupamiento_no_docente&#x28;&#xa;	agrupamiento_no_docente_id	integer,&#xa;	agrupamiento_no_docente_codigo	character varying,&#xa;	agrupamiento_no_docente_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_agrupamiento_no_docente primary key &#x28;agrupamiento_no_docente_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_nivel_ensenianza&#x28;&#xa;	nivel_ensenianza_id	integer,&#xa;	nivel_ensenianza_codigo	character varying,&#xa;	nivel_ensenianza_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_nivel_ensenianza primary key &#x28;nivel_ensenianza_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_anios_de_antiguedad&#x28;&#xa;	anios_de_antiguedad_id	integer,&#xa;	antiguedad_codigo	character varying,&#xa;	antiguedad_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_anios_de_antiguedad primary key &#x28;anios_de_antiguedad_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_antiguedad_docente&#x28;&#xa;	antiguedad_docente_id	integer,&#xa;	antiguedad_docente_codigo	character varying,&#xa;	antiguedad_docente_desc	character varying,&#xa;	rango_antiguedad_docente_codigo	character varying,&#xa;	rango_antiguedad_docente_desc	character varying,&#xa;	meses	integer, --lo generamos nosotros con valores del 0 al 720&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_antiguedad_docente primary key &#x28;antiguedad_docente_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_estado_cargo&#x28;&#xa;	estado_cargo_id	integer,&#xa;	estado_cargo_codigo	character varying,&#xa;	estado_cargo_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_estado_cargo primary key &#x28;estado_cargo_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_tipo_planta&#x28;&#xa;	tipo_planta_id	integer,&#xa;	tipo_planta_codigo	character varying,&#xa;	tipo_planta_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_tipo_planta primary key &#x28;tipo_planta_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_objeto_del_gasto&#x28;&#xa;	objeto_del_gasto_id	integer,&#xa;	objeto_del_gasto_codigo	character varying,&#xa;	resumen	character varying,&#xa;	inciso	character varying,&#xa;	partida_principal	character varying,&#xa;	partida_parcial	character varying,&#xa;	orden	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_objeto_del_gasto primary key &#x28;objeto_del_gasto_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_periodo_retroactivo&#x28;&#xa;	periodo_retroactivo_id	integer,&#xa;	periodo_retroactivo_codigo	character varying, --Concatenar anio_codigo y mes_codigo&#xa;	anio_codigo	character varying,&#xa;	anio_desc	character varying,&#xa;	mes_codigo	character varying,&#xa;	mes_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_periodo_retroactivo primary key &#x28;periodo_retroactivo_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_tipo_grupo_concepto&#x28;&#xa;	tipo_grupo_concepto_id	integer,&#xa;	tipo_grupo_concepto_codigo	character varying,&#xa;	tipo_grupo_concepto_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_tipo_grupo_concepto primary key &#x28;tipo_grupo_concepto_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;&#xa;create table rhun_dsa.d_nacionalidad&#x28;&#xa;	nacionalidad_id	integer,&#xa;	nacionalidad_codigo	character varying,&#xa;	nacionalidad_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_d_nacionalidad primary key &#x28;nacionalidad_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_estado_civil&#x28;&#xa;	estado_civil_id	integer,&#xa;	estado_civil_codigo	character varying,&#xa;	estado_civil_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_estado_civil primary key &#x28;estado_civil_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_sistema_previsional&#x28;&#xa;	sistema_previsional_id	integer,&#xa;	sistema_previsional_codigo	character varying,&#xa;	sistema_previsional_desc	character varying,&#xa;	tipo_sistema_previsional_codigo character varying,&#xa;	tipo_sistema_previsional_desc character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_sistema_previsional primary key &#x28;sistema_previsional_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_nivel_educacion&#x28;&#xa;	nivel_educacion_id	integer,&#xa;	nivel_educacion_codigo	character varying,&#xa;	sirhu	text,&#xa;	nivel_educacion_tipo_codigo	character varying,&#xa;	nivel_educacion_desc	character varying,&#xa;	nivel_educacion_tipo_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_nivel_educacion primary key &#x28;nivel_educacion_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;&#xa;create table rhun_dsa.d_ona_tipo_titulo&#x28;&#xa;	ona_tipo_titulo_id	integer,&#xa;	tipo_titulo_codigo	character varying,&#xa;	tipo_titulo_desc	character varying,&#xa;	titulo_codigo	character varying,&#xa;	titulo_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_ona_tipo_titulo primary key &#x28;ona_tipo_titulo_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_categoria_conicet&#x28;&#xa;	categoria_conicet_id	integer,&#xa;	categoria_conicet_codigo	character varying,&#xa;	categoria_conicet_tipo_desc	character varying,&#xa;	categoria_conicet_desc	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_categoria_conicet primary key &#x28;categoria_conicet_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_equivalencia_cargo&#x28;&#xa;	equivalencia_cargo_id	integer,&#xa;	equivalencia_cargo_codigo	character varying,&#xa;	escalafon_codigo	character varying,&#xa;	categoria_dedicacion	character varying,&#xa;	categoria_tipo	character varying, -- 1er nivel de la dimensi&#xf3;n&#xa;	categoria_denominacion	character varying, -- 2do nivel de la dimensi&#xf3;n&#xa;	categoria_horas	character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_equivalencia_cargo primary key &#x28;equivalencia_cargo_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;create table rhun_dsa.d_persona&#x28;&#xa;	persona_id integer,&#xa;	persona_codigo character varying,&#xa;	persona_desc character varying,&#xa;	fecha_desde	date,&#xa;	fecha_hasta	date,&#xa;	&#x22;version&#x22;	integer,&#xa;	vigente	character varying,&#xa;	fecha_actualizacion	 timestamp without time zone,&#xa;	constraint idxp_dsa_d_persona primary key &#x28;persona_id&#x29;&#xa;&#x29;&#x3b;&#xa;--indice para que la carga de la dimension sea m&#xe1;s r&#xe1;pida&#xa;CREATE INDEX idxp_dsa_d_persona_codigo ON rhun_dsa.d_persona USING btree &#x28;persona_codigo&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_dsa.d_categoria_incentivo&#xa;&#x28;&#xa;  categoria_incentivo_id integer NOT NULL,&#xa;  categoria_incentivo_codigo character varying,&#xa;  categoria_incentivo_desc character varying,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  &#x22;version&#x22; integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone,&#xa;  CONSTRAINT idxp_dsa_d_categoria_incentivo PRIMARY KEY &#x28;categoria_incentivo_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_dsa.d_cargo_por_persona&#xa;&#x28;&#xa;  cargo_por_persona_id integer NOT NULL,&#xa;  cargo_por_persona_codigo character varying,&#xa;  cargo_por_persona_desc character varying,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  version integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone,&#xa;  CONSTRAINT idxp_dsa_d_cargo_por_persona PRIMARY KEY &#x28;cargo_por_persona_id &#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_dsa.d_hora_dedicacion&#xa;&#x28;&#xa;  hora_dedicacion_id integer NOT NULL,&#xa;  hora_dedicacion_codigo character varying,&#xa;  hora_dedicacion_desc character varying,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  version integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone,&#xa;  CONSTRAINT idxp_dsa_d_hora_dedicacion PRIMARY KEY &#x28;hora_dedicacion_id &#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_dsa.d_edad&#xa;&#x28;&#xa;  edad_id integer NOT NULL,&#xa;  edad_codigo character varying,&#xa;  edad_desc character varying,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  &#x22;version&#x22; integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone,&#xa;  CONSTRAINT idxp_dsa_d_edad PRIMARY KEY &#x28;edad_id&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_dsa.ft_cargo_liquidado&#xa;&#x28;&#xa;periodo_id integer NOT NULL,&#xa;numero_cargo integer NOT NULL,&#xa;persona_id integer NOT NULL,&#xa;escalafon_id integer NOT NULL,&#xa;categoria_universidad_id integer NOT NULL,&#xa;equivalencia_cargo_id integer NOT NULL,&#xa;unidad_academica_id integer NOT NULL,&#xa;fuente_financiamiento_id integer NOT NULL,&#xa;estado_laboral_id integer NOT NULL,&#xa;tipo_planta_id integer NOT NULL,&#xa;estado_cargo_id integer NOT NULL,&#xa;situacion_laboral_id integer NOT NULL,&#xa;nivel_ensenianza_id integer NOT NULL,&#xa;rango_antiguedad_id integer NOT NULL,&#xa;horas_d