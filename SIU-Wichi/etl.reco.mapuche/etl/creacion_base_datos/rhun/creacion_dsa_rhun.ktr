 NULL,&#xa;categoria_universidad_id integer NOT NULL,&#xa;unidad_academica_id  integer NOT NULL,&#xa;equivalencia_cargo_id  integer NOT NULL,&#xa;fuente_financiamiento_id  integer NOT NULL,&#xa;estado_laboral_id  integer NOT NULL,&#xa;tipo_planta_id  integer NOT NULL,&#xa;estado_cargo_id  integer NOT NULL,&#xa;situacion_laboral_id  integer NOT NULL,&#xa;nivel_ensenianza_id  integer NOT NULL,&#xa;rango_antiguedad_id integer NOT NULL,&#xa;horas_dedicacion_id integer NOT NULL,&#xa;anios_antiguedad_id  integer NOT NULL,&#xa;agrupamiento_nd_id  integer NOT NULL,&#xa;tipo_cargo_asociado_id  integer NOT NULL,&#xa;escalafon_relacionado_id  integer NOT NULL,&#xa;dedicacion_relacionada_id integer NOT NULL,&#xa;categoria_relacionada_id integer NOT NULL,&#xa;objeto_del_gasto_id integer NOT NULL,&#xa;persona_id integer NOT NULL,&#xa;numero_cargo_id integer NOT NULL,&#xa;equivalencia_cargo_relacionado_id integer NOT NULL,&#xa;escalafon_id  integer NOT NULL,&#xa;importe_por_grupo_de_concepto  numeric&#x28;13,2&#x29; NOT NULL,&#xa;conceptos_por_cargos_por_grupos integer NOT NULL&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_dsa.ft_datos_personales_planta&#xa;&#x28;&#xa;periodo_id  integer NOT NULL,&#xa;persona_id integer NOT NULL,&#xa;nacionalidad_id  integer NOT NULL,&#xa;estado_civil_id  integer NOT NULL,&#xa;sexo_id  integer NOT NULL,&#xa;edad_id integer NOT NULL,&#xa;sistema_previsional_id  integer NOT NULL,&#xa;nivel_educacion_id  integer NOT NULL,&#xa;titulo_id  integer NOT NULL,&#xa;categoria_conicet_id integer NOT NULL,&#xa;categoria_incentivo_id integer NOT NULL,&#xa;personas integer NOT NULL&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE rhun_dsa.ft_cargos_planta&#xa;&#x28;&#xa;periodo_id  integer NOT NULL,&#xa;numero_cargo  integer NOT NULL,&#xa;persona_id integer NOT NULL,&#xa;escalafon_id  integer NOT NULL,&#xa;categoria_universidad_id integer NOT NULL,&#xa;equivalencia_cargo_id  integer NOT NULL,&#xa;unidad_academica_id  integer NOT NULL,&#xa;ona_jerarquia_id  integer NOT NULL,&#xa;agrupamiento_nd_id  integer NOT NULL,&#xa;nivel_ensenianza_id  integer NOT NULL,&#xa;grado  integer NOT NULL,&#xa;rango_antiguedad_id integer NOT NULL,&#xa;horas_dedicacion_id integer NOT NULL,&#xa;porcentaje_dedicacion_id integer NOT NULL,&#xa;porcentaje_investigacion_id integer NOT NULL,&#xa;porcentaje_extension_id integer NOT NULL,&#xa;porcentaje_gestion_id integer NOT NULL,&#xa;numero_cargo_id  integer NOT NULL,&#xa;tipo_cargo_asociado_id  integer NOT NULL,&#xa;escalafon_relacionado_id  integer NOT NULL,&#xa;dedicacion_relacionada_id integer NOT NULL,&#xa;categoria_relacionada_id integer NOT NULL,&#xa;nacionalidad_id  integer NOT NULL,&#xa;estado_civil_id  integer NOT NULL,&#xa;sexo_id integer NOT NULL,&#xa;edad_id integer NOT NULL,&#xa;sistema_previsional_id  integer NOT NULL,&#xa;nivel_educacion_id  integer NOT NULL,&#xa;titulo_id  integer NOT NULL,&#xa;categoria_conicet_id integer NOT NULL,&#xa;categoria_incentivo_id integer NOT NULL,&#xa;equivalencia_cargo_relacionado_id integer NOT NULL,&#xa;cargos  integer NOT NULL,&#xa;sueldo_bruto  numeric&#x28;13,2&#x29; NOT NULL&#xa;&#x29;&#x3b;&#xa;</sql>
