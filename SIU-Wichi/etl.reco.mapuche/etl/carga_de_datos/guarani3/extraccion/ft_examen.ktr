  <step>
    <name>examen</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_guarani</connection>
    <sql>-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;-- Archivo&#x3a; FT_Examen.txt&#xa;--  &#x2a; Examenes de Actas Cerradas y Abiertas&#xa;--  &#x2a; Examenes en otras propuestas &#x28;Examenes equivalentes&#x29;. Muestra examenes de actividades&#xa;--    que se encuentran en el plan actual del alumno&#xa;-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;&#xa;-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;-- ACTAS DE EXAMEN CERRADAS&#xa;-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;WITH actas_cerradas as &#x28;SELECT &#x2a;  FROM negocio.sga_actas WHERE sga_actas.origen &#x3d; &#x27;E&#x27; AND estado&#x3d;&#x27;C&#x27;&#x29;,&#xa;actas_cerradas_det as &#x28;SELECT &#x2a; FROM negocio.sga_actas_detalle WHERE sga_actas_detalle.instancia IN &#x28;3,4,7&#x29; -- Regulares &#x2f; Libres &#x2f; Examen Complementario&#xa;	  AND sga_actas_detalle.estado &#x3d; &#x27;A&#x27; AND sga_actas_detalle.rectificado &#x3d; &#x27;N&#x27;&#x29;,&#xa; actas_abiertas as &#x28;SELECT &#x2a;  FROM negocio.sga_actas WHERE sga_actas.origen &#x3d; &#x27;E&#x27; AND estado&#x3d;&#x27;A&#x27;&#x29;&#xa;SELECT  &#xa;	vw_mesas_examen.mesa_examen_ubicacion as ubicacion_id,&#xa;	cast&#x28;vw_mesas_examen.anio_academico as integer&#x29; as anio_academico,&#xa;	sga_periodos_genericos.periodo_generico_tipo as codigo_tipo_periodo,&#xa;	pte.nombre as turno_examen_nombre,&#xa;	vw_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,&#xa;	to_char&#x28;greatest&#x28;vw_mesas_examen.mesa_examen_fecha,&#x27;19000101&#x27;&#x3a;&#x3a;date&#x29;, &#x27;DD&#x2f;MM&#x2f;YYYY&#x27;&#x29; as fecha_examen,&#xa;    vw_mesas_examen.llamado_mesa as mesa_id,&#xa;	sga_alumnos.alumno,&#xa;	sga_alumnos.propuesta,&#xa;	actas_cerradas_det.plan_version as plan_version,&#xa;	sga_elementos.elemento as actividad,&#xa;	sga_catedras.catedra as catedra,&#xa;	actas_cerradas_det.resultado as resultado,&#xa;	actas_cerradas_det.nota as nota,&#xa;	sga_escalas_notas_det.concepto as concepto,&#xa;	0 as actividad_comun,&#xa;	actas_cerradas.tipo_acta as tipo_acta,&#xa;	actas_cerradas.nro_acta as nro_acta,&#xa;	actas_cerradas.estado as estado_acta,&#xa;	actas_cerradas_det.instancia as condicion_alumno,&#xa;	CASE&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;M&#x27; THEN 1&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;F&#x27; THEN 2&#xa;       WHEN mdp_personas.sexo &#x3d; &#x27;X&#x27; THEN 3 &#xa;	END AS sexo,&#xa;       &#x28;CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE &#x28;&#xa;		extract&#x28;year from age&#x28;date &#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;, mdp_personas.fecha_nacimiento&#x29;&#x29;&#xa;	&#x29; END&#x29; as edad,&#xa;	mdp_personas.nacionalidad,&#xa;&#x28;SELECT CASE WHEN mdp_datos_estudios.nivel_estudio &#x3d; 3 THEN mdp_datos_estudios.colegio &#xa;		ELSE NULL END&#xa;	FROM mdp_datos_estudios &#xa;	WHERE mdp_datos_estudios.persona &#x3d; mdp_personas.persona&#xa;	LIMIT 1&#x29; as colegio,&#xa;	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera&#xa;	intentos.nro_intento as nrointento,       -- N&#xfa;mero de vez que intenta rendir examen de la materia&#xa;	&#xa;	1 as uno, -- Cantidad de registros de ex&#xe1;menes. Es siempre 1&#xa;	ingreso.anio_academico_institucion as anio_ingreso_institucion,&#xa;	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,&#xa;	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,&#xa; 	sga_alumnos.persona,&#xa; 	concat&#x28;&#x27;select get_horas_trabajo_araucano&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_horas_trabajadas,&#xa;	concat&#x28;&#x27;select get_estado_civil&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_estado_civil,&#xa;	concat&#x28;&#x27;select get_localidad_per_lec&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_per_lec,&#xa;	concat&#x28;&#x27;select get_localidad_proc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_proc,&#xa;	concat&#x28;&#x27;select get_costeo_estudios&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_costeo_estudios,&#xa;	concat&#x28;&#x27;select get_beca&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_beca,&#xa;	concat&#x28;&#x27;select get_tecno_internet&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_internet,&#xa;	concat&#x28;&#x27;select get_tecno_pc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_pc,&#xa;	concat&#x28;&#x27;select get_idioma&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_idioma,&#xa;	0 as discapacidad&#xa;	FROM    &#xa;		actas_cerradas,&#xa;	     actas_cerradas_det LEFT JOIN sga_escalas_notas_det ON &#x28;sga_escalas_notas_det.escala_nota &#x3d; actas_cerradas_det.escala_nota AND sga_escalas_notas_det.nota &#x3d; actas_cerradas_det.nota&#x29;,&#xa;	     sga_planes_versiones,&#xa;	     vw_mesas_examen&#xa;                LEFT JOIN sga_catedras ON sga_catedras.catedra &#x3d; vw_mesas_examen.mesa_examen_catedra,&#xa;	     sga_elementos,&#xa;	     sga_periodos as pte,&#xa;	     sga_alumnos,&#xa;	     sga_propuestas,&#xa;	     mdp_personas,&#xa;	     _wichi_ingreso_alumnos as ingreso,&#xa;	     _wichi_intentos_examenes intentos,&#xa;		 sga_periodos_genericos&#xa;	     &#xa;	WHERE actas_cerradas_det.id_acta &#x3d; actas_cerradas.id_acta&#xa;	  AND vw_mesas_examen.llamado_mesa &#x3d; actas_cerradas.llamado_mesa&#xa;	  AND sga_elementos.elemento &#x3d; vw_mesas_examen.mesa_examen_elemento&#xa;	  AND pte.periodo &#x3d; vw_mesas_examen.turno_examen_periodo&#xa;	  AND pte.periodo_generico &#x3d; sga_periodos_genericos.periodo_generico&#xa;	  AND sga_planes_versiones.plan_version &#x3d; actas_cerradas_det.plan_version&#xa;	  AND sga_alumnos.alumno &#x3d; actas_cerradas_det.alumno&#xa;	  AND sga_alumnos.persona &#x3d; mdp_personas.persona&#xa;	  AND sga_propuestas.propuesta &#x3d; sga_alumnos.propuesta&#xa;	  AND ingreso.alumno &#x3d; sga_alumnos.alumno&#xa;	  AND intentos.alumno &#x3d; actas_cerradas_det.alumno&#xa;	  AND intentos.elemento &#x3d; vw_mesas_examen.mesa_examen_elemento&#xa;      AND intentos.llamado_mesa &#x3d; vw_mesas_examen.llamado_mesa&#xa;      AND &#x28;&#x24;&#x7b;periodo&#x7d; &#x3d; 0 or vw_mesas_examen.anio_academico &#x3d; &#x24;&#x7b;periodo&#x7d;&#x29;&#xa;&#xa;UNION ALL&#xa;&#xa;  -- Examenes aprobados en otras propuestas del alumno&#xa;  SELECT  &#xa;	vw_mesas_examen.mesa_examen_ubicacion as ubicacion_id,&#xa;	cast&#x28;vw_mesas_examen.anio_academico as integer&#x29; as anio_academico,&#xa;	sga_periodos_genericos.periodo_generico_tipo as codigo_tipo_periodo,&#xa;	pte.nombre as turno_examen_nombre,&#xa;	vw_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,&#xa;	to_char&#x28;greatest&#x28;vw_mesas_examen.mesa_examen_fecha,&#x27;19000101&#x27;&#x3a;&#x3a;date&#x29;, &#x27;DD&#x2f;MM&#x2f;YYYY&#x27;&#x29; as fecha_examen,&#xa;    vw_mesas_examen.llamado_mesa as mesa_id,&#xa;	sga_alumnos2.alumno,     &#xa;	sga_alumnos2.propuesta,&#xa;	sga_planes_versiones2.plan_version as plan_version,  &#xa;	sga_elementos.elemento as actividad,  &#xa;	sga_catedras.catedra as catedra,&#xa;	actas_cerradas_det.resultado as resultado,&#xa;	actas_cerradas_det.nota as nota,&#xa;	sga_escalas_notas_det.concepto as concepto,&#xa;	1 as actividad_comun,&#xa;	actas_cerradas.tipo_acta as tipo_acta,&#xa;	actas_cerradas.nro_acta as nro_acta,&#xa;	actas_cerradas.estado as estado_acta,&#xa;	actas_cerradas_det.instancia as condicion_alumno,&#xa;	CASE&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;M&#x27; THEN 1&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;F&#x27; THEN 2&#xa;	END AS sexo,&#xa;       &#x28;CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE &#x28;&#xa;		extract&#x28;year from age&#x28;date &#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;, mdp_personas.fecha_nacimiento&#x29;&#x29;&#xa;	&#x29; END&#x29; as edad,&#xa;	mdp_personas.nacionalidad,&#xa;&#x28;SELECT CASE WHEN mdp_datos_estudios.nivel_estudio &#x3d; 3 THEN mdp_datos_estudios.colegio &#xa;		ELSE NULL END&#xa;	FROM mdp_datos_estudios &#xa;	WHERE mdp_datos_estudios.persona &#x3d; mdp_personas.persona&#xa;	LIMIT 1&#x29; as colegio,&#xa;	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera&#xa;	intentos.nro_intento as nrointento,       -- N&#xfa;mero de vez que intenta rendir examen de la materia&#xa;	&#xa;	1 as uno, -- Cantidad de registros de ex&#xe1;menes. Es siempre 1&#xa;	ingreso.anio_academico_institucion as anio_ingreso_institucion,&#xa;	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,&#xa;	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,&#xa; 	sga_alumnos.persona,&#xa; 	concat&#x28;&#x27;select get_horas_trabajo_araucano&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_horas_trabajadas,&#xa;	concat&#x28;&#x27;select get_estado_civil&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_estado_civil,&#xa;	concat&#x28;&#x27;select get_localidad_per_lec&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_per_lec,&#xa;	concat&#x28;&#x27;select get_localidad_proc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_proc,&#xa;	concat&#x28;&#x27;select get_costeo_estudios&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_costeo_estudios,&#xa;	concat&#x28;&#x27;select get_beca&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_beca,&#xa;	concat&#x28;&#x27;select get_tecno_internet&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_internet,&#xa;	concat&#x28;&#x27;select get_tecno_pc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_pc,&#xa;	concat&#x28;&#x27;select get_idioma&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_idioma,&#xa;	0 as discapacidad&#xa;	FROM &#xa;         actas_cerradas,&#xa;	     actas_cerradas_det LEFT JOIN sga_escalas_notas_det ON &#x28;sga_escalas_notas_det.escala_nota &#x3d; actas_cerradas_det.escala_nota AND sga_escalas_notas_det.nota &#x3d; actas_cerradas_det.nota&#x29;,&#xa;	     sga_planes_versiones,&#xa;	     vw_mesas_examen&#xa;                LEFT JOIN sga_catedras ON sga_catedras.catedra &#x3d; vw_mesas_examen.mesa_examen_catedra,&#xa;	     sga_elementos,&#xa;	     sga_periodos as pte,&#xa;	     sga_alumnos,&#xa;	     sga_propuestas,&#xa;	     mdp_personas,&#xa;	     _wichi_ingreso_alumnos as ingreso,&#xa;	     _wichi_intentos_examenes intentos,&#xa;&#xa;	     sga_alumnos as sga_alumnos2,&#xa;	     sga_planes_versiones as sga_planes_versiones2,&#xa;	     sga_elementos_plan as sga_elementos_plan2,&#xa;	     sga_elementos_revision as sga_elementos_revision2,&#xa;		 sga_periodos_genericos&#xa;	     &#xa;	WHERE actas_cerradas_det.id_acta &#x3d; actas_cerradas.id_acta&#xa;	  AND vw_mesas_examen.llamado_mesa &#x3d; actas_cerradas.llamado_mesa&#xa;	  AND sga_elementos.elemento &#x3d; vw_mesas_examen.mesa_examen_elemento&#xa;	  AND pte.periodo &#x3d; vw_mesas_examen.turno_examen_periodo&#xa;	  AND pte.periodo_generico &#x3d; sga_periodos_genericos.periodo_generico&#xa;	  AND sga_planes_versiones.plan_version &#x3d; actas_cerradas_det.plan_version&#xa;	  AND sga_alumnos.alumno &#x3d; actas_cerradas_det.alumno&#xa;	  AND sga_alumnos.persona &#x3d; mdp_personas.persona&#xa;	  AND sga_elementos.elemento &#x3d; vw_mesas_examen.mesa_examen_elemento&#xa;	  &#xa;	  -- Otra propuesta del alumno  &#xa;	  AND sga_alumnos2.persona &#x3d; sga_alumnos.persona&#xa;	  AND sga_alumnos2.propuesta &#x3c;&#x3e; sga_alumnos.propuesta&#xa;	  AND sga_propuestas.propuesta &#x3d; sga_alumnos2.propuesta&#xa;	  AND sga_planes_versiones2.plan_version &#x3d; sga_alumnos2.plan_version&#xa;	  AND ingreso.alumno &#x3d; sga_alumnos2.alumno&#xa;	  AND sga_elementos_revision2.elemento &#x3d; sga_elementos.elemento&#xa;	  AND sga_elementos_plan2.plan_version      &#x3d; sga_alumnos2.plan_version&#xa;	  AND sga_elementos_plan2.elemento_revision &#x3d; sga_elementos_revision2.elemento_revision&#xa;	  &#xa;	  AND intentos.alumno &#x3d; actas_cerradas_det.alumno&#xa;	  AND intentos.elemento &#x3d; vw_mesas_examen.mesa_examen_elemento&#xa;      AND intentos.llamado_mesa &#x3d; vw_mesas_examen.llamado_mesa&#xa;	  AND &#x28;&#x24;&#x7b;periodo&#x7d; &#x3d; 0 or vw_mesas_examen.anio_academico &#x3d; &#x24;&#x7b;periodo&#x7d;&#x29;&#xa;&#xa;&#xa;-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;-- ACTAS ABIERTAS&#xa;-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;UNION ALL&#xa;&#xa;-- Actas abiertas de examenes donde el alumno lo hizo por su propuesta&#xa;SELECT  &#xa;	vw_mesas_examen.mesa_examen_ubicacion as ubicacion_id,&#xa;	cast&#x28;vw_mesas_examen.anio_academico as integer&#x29; as anio_academico,&#xa;	sga_periodos_genericos.periodo_generico_tipo as codigo_tipo_periodo,&#xa;	pte.nombre as turno_examen_nombre,&#xa;	vw_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,&#xa;	to_char&#x28;greatest&#x28;vw_mesas_examen.mesa_examen_fecha,&#x27;19000101&#x27;&#x3a;&#x3a;date&#x29;, &#x27;DD&#x2f;MM&#x2f;YYYY&#x27;&#x29; as fecha_examen,&#xa;    vw_mesas_examen.llamado_mesa as mesa_id,&#xa;	sga_alumnos.alumno,&#xa;	sga_alumnos.propuesta, -- sga_propuestas.codigo as carrera,&#xa;	sga_eval_detalle_examenes.plan_version as plan_version,&#xa;	sga_elementos.elemento as actividad, &#xa;	--vw_mesas_examen.mesa_examen_elemento as materia,&#xa;	sga_catedras.catedra as catedra,&#xa;	sga_eval_detalle_examenes.resultado as resultado,&#xa;	sga_eval_detalle_examenes.nota as nota,&#xa;	sga_escalas_notas_det.concepto as concepto,&#xa;	0 as actividad_comun,&#xa;	actas_abiertas.tipo_acta as tipo_acta,&#xa;	actas_abiertas.nro_acta as nro_acta,&#xa;	actas_abiertas.estado as estado_acta,&#xa;	sga_eval_detalle_examenes.instancia as condicion_alumno,&#xa;	CASE&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;M&#x27; THEN 1&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;F&#x27; THEN 2&#xa;	END AS sexo,&#xa;       &#x28;CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE &#x28;&#xa;		extract&#x28;year from age&#x28;date &#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;, mdp_personas.fecha_nacimiento&#x29;&#x29;&#xa;	&#x29; END&#x29; as edad,&#xa;	mdp_personas.nacionalidad,&#xa;&#x28;SELECT CASE WHEN mdp_datos_estudios.nivel_estudio &#x3d; 3 THEN mdp_datos_estudios.colegio &#xa;		ELSE NULL END&#xa;	FROM mdp_datos_estudios &#xa;	WHERE mdp_datos_estudios.persona &#x3d; mdp_personas.persona&#xa;	LIMIT 1&#x29; as colegio,&#xa;	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera&#xa;	intentos.nro_intento as nrointento,       -- N&#xfa;mero de vez que intenta rendir examen de la materia&#xa;	&#xa;	1 as uno, -- Cantidad de registros de ex&#xe1;menes. Es siempre 1&#xa;	ingreso.anio_academico_institucion as anio_ingreso_institucion,&#xa;	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,&#xa;	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,&#xa; 	sga_alumnos.persona,&#xa; 	concat&#x28;&#x27;select get_horas_trabajo_araucano&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_horas_trabajadas,&#xa;	concat&#x28;&#x27;select get_estado_civil&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_estado_civil,&#xa;	concat&#x28;&#x27;select get_localidad_per_lec&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_per_lec,&#xa;	concat&#x28;&#x27;select get_localidad_proc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_proc,&#xa;	concat&#x28;&#x27;select get_costeo_estudios&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_costeo_estudios,&#xa;	concat&#x28;&#x27;select get_beca&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_beca,&#xa;	concat&#x28;&#x27;select get_tecno_internet&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_internet,&#xa;	concat&#x28;&#x27;select get_tecno_pc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_pc,&#xa;	concat&#x28;&#x27;select get_idioma&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_idioma,&#xa;	0 as discapacidad&#xa;	FROM &#xa;         actas_abiertas,&#xa;         sga_eval_detalle_examenes LEFT JOIN sga_escalas_notas_det ON &#x28;sga_escalas_notas_det.escala_nota &#x3d; sga_eval_detalle_examenes.escala_nota AND  sga_escalas_notas_det.nota &#x3d; sga_eval_detalle_examenes.nota&#x29;,&#xa;	     sga_planes_versiones,&#xa;	     vw_mesas_examen&#xa;                LEFT JOIN sga_catedras ON sga_catedras.catedra &#x3d; vw_mesas_examen.mesa_examen_catedra,&#xa;	     sga_elementos,&#xa;	     sga_periodos as pte,&#xa;	     sga_alumnos,&#xa;	     sga_propuestas,&#xa;	     mdp_personas,&#xa;	     _wichi_ingreso_alumnos as ingreso,&#xa;	     _wichi_intentos_examenes as intentos,&#xa;		 sga_periodos_genericos&#xa;	     &#xa;	WHERE sga_eval_detalle_examenes.id_acta &#x3d; actas_abiertas.id_acta&#xa;	  AND sga_eval_detalle_examenes.instancia IN &#x28;3,4,7&#x29; -- Regulares &#x2f; Libres &#x2f; Examen Complementario&#xa;	  AND vw_mesas_examen.llamado_mesa &#x3d; actas_abiertas.llamado_mesa&#xa;	  AND sga_elementos.elemento &#x3d; vw_mesas_examen.mesa_examen_elemento&#xa;	  AND pte.periodo &#x3d; vw_mesas_examen.turno_examen_periodo&#xa;	  AND pte.periodo_generico &#x3d; sga_periodos_genericos.periodo_generico&#xa;	  AND sga_planes_versiones.plan_version &#x3d; sga_eval_detalle_examenes.plan_version&#xa;	  AND sga_alumnos.alumno &#x3d; sga_eval_detalle_examenes.alumno&#xa;	  AND sga_alumnos.persona &#x3d; mdp_personas.persona&#xa;	  AND sga_propuestas.propuesta &#x3d; sga_alumnos.propuesta&#xa;&#xa;	  AND ingreso.alumno &#x3d; sga_alumnos.alumno&#xa;&#xa;	  AND intentos.alumno &#x3d; sga_alumnos.alumno&#xa;	  AND intentos.elemento &#x3d; sga_elementos.elemento&#xa;      AND intentos.llamado_mesa &#x3d; actas_abiertas.llamado_mesa&#xa;	  AND &#x28;&#x24;&#x7b;periodo&#x7d; &#x3d; 0 or vw_mesas_examen.anio_academico &#x3d; &#x24;&#x7b;periodo&#x7d;&#x29;&#xa;&#xa;UNION ALL&#xa;&#xa;  -- Examenes aprobados en otras propuestas del alumno&#xa;  SELECT  &#xa;	vw_mesas_examen.mesa_examen_ubicacion as ubicacion_id,&#xa;	cast&#x28;vw_mesas_examen.anio_academico as integer&#x29; as anio_academico,&#xa;	sga_periodos_genericos.periodo_generico_tipo as codigo_tipo_periodo,&#xa;	pte.nombre as turno_examen_nombre,&#xa;	vw_mesas_examen.mesa_examen_nombre as mesa_examen_nombre,&#xa;	to_char&#x28;greatest&#x28;vw_mesas_examen.mesa_examen_fecha,&#x27;19000101&#x27;&#x3a;&#x3a;date&#x29;, &#x27;DD&#x2f;MM&#x2f;YYYY&#x27;&#x29; as fecha_examen,&#xa;    vw_mesas_examen.llamado_mesa as mesa_id,&#xa;	sga_alumnos2.alumno,     &#xa;	sga_alumnos2.propuesta, &#xa;	sga_planes_versiones2.plan_version as plan_version, &#xa;	sga_elementos.elemento as actividad, &#xa;	sga_catedras.catedra as catedra,&#xa;	sga_eval_detalle_examenes.resultado as resultado,&#xa;	sga_eval_detalle_examenes.nota as nota,&#xa;	sga_escalas_notas_det.concepto as concepto,&#xa;	1 as actividad_comun,&#xa;	actas_abiertas.tipo_acta as tipo_acta,&#xa;	actas_abiertas.nro_acta as nro_acta,&#xa;	actas_abiertas.estado as estado_acta,&#xa;	sga_eval_detalle_examenes.instancia as condicion_alumno,&#xa;	CASE&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;M&#x27; THEN 1&#xa;	   WHEN mdp_personas.sexo &#x3d; &#x27;F&#x27; THEN 2&#xa;	END AS sexo,&#xa;       &#x28;CASE WHEN mdp_personas.fecha_nacimiento IS NULL THEN NULL ELSE &#x28;&#xa;		extract&#x28;year from age&#x28;date &#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;, mdp_personas.fecha_nacimiento&#x29;&#x29;&#xa;	&#x29; END&#x29; as edad,&#xa;	mdp_personas.nacionalidad,&#xa;&#x28;SELECT CASE WHEN mdp_datos_estudios.nivel_estudio &#x3d; 3 THEN mdp_datos_estudios.colegio &#xa;		ELSE NULL END&#xa;	FROM mdp_datos_estudios &#xa;	WHERE mdp_datos_estudios.persona &#x3d; mdp_personas.persona&#xa;	LIMIT 1&#x29; as colegio,&#xa;	intentos.total_intentos as totalintentos, -- Total de veces que ha intentado rendir la materia dentro de la carrera&#xa;	intentos.nro_intento as nrointento,       -- N&#xfa;mero de vez que intenta rendir examen de la materia&#xa;	&#xa;	1 as uno, -- Cantidad de registros de ex&#xe1;menes. Es siempre 1&#xa;	ingreso.anio_academico_institucion as anio_ingreso_institucion,&#xa;	ingreso.anio_academico_propuesta as anio_ingreso_propuesta,&#xa;	ingreso.periodo_inscripcion_nombre as periodo_inscripcion_nombre,&#xa; 	sga_alumnos.persona,&#xa; 	concat&#x28;&#x27;select get_horas_trabajo_araucano&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_horas_trabajadas,&#xa;	concat&#x28;&#x27;select get_estado_civil&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_estado_civil,&#xa;	concat&#x28;&#x27;select get_localidad_per_lec&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_per_lec,&#xa;	concat&#x28;&#x27;select get_localidad_proc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_proc,&#xa;	concat&#x28;&#x27;select get_costeo_estudios&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_costeo_estudios,&#xa;	concat&#x28;&#x27;select get_beca&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_beca,&#xa;	concat&#x28;&#x27;select get_tecno_internet&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_internet,&#xa;	concat&#x28;&#x27;select get_tecno_pc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_pc,&#xa;	concat&#x28;&#x27;select get_idioma&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;vw_mesas_examen.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_idioma,&#xa;	0 as discapacidad&#xa;	FROM &#xa;         actas_abiertas,&#xa;         sga_eval_detalle_examenes LEFT JOIN sga_escalas_notas_det ON &#x28;sga_escalas_notas_det.escala_nota &#x3d; sga_eval_detalle_examenes.escala_nota AND  sga_escalas_notas_det.nota &#x3d; sga_eval_detalle_examenes.nota&#x29;,&#xa;	     sga_planes_versiones,&#xa;	     vw_mesas_examen&#xa;                LEFT JOIN sga_catedras ON sga_catedras.catedra &#x3d; vw_mesas_examen.mesa_examen_catedra,&#xa;	     sga_elementos,&#xa;	     sga_periodos as pte,&#xa;	     sga_alumnos,&#xa;	     sga_propuestas,&#xa;	     mdp_personas,&#xa;	     _wichi_ingreso_alumnos as ingreso,&#xa;	     _wichi_intentos_examenes intentos,&#xa;&#xa;	     sga_alumnos as sga_alumnos2,&#xa;	     sga_planes_versiones as sga_planes_versiones2,&#xa;	     sga_elementos_plan as sga_elementos_plan2,&#xa;	     sga_elementos_revision as sga_elementos_revision2,&#xa;		 sga_periodos_genericos&#xa;	     &#xa;	WHERE sga_eval_detalle_examenes.id_acta &#x3d; actas_abiertas.id_acta&#xa;	  AND sga_eval_detalle_examenes.instancia IN &#x28;3,4,7&#x29; -- Regulares &#x2f; Libres &#x2f; Examen Complementario&#xa;	  AND vw_mesas_examen.llamado_mesa &#x3d; actas_abiertas.llamado_mesa&#xa;	  AND sga_elementos.elemento &#x3d; vw_mesas_examen.mesa_examen_elemento&#xa;&#xa;	  AND pte.periodo &#x3d; vw_mesas_examen.turno_examen_periodo&#xa;	  AND pte.periodo_generico &#x3d; sga_periodos_genericos.periodo_generico&#xa;	  AND sga_planes_versiones.plan_version &#x3d; sga_eval_detalle_examenes.plan_version&#xa;	  AND sga_alumnos.alumno &#x3d; sga_eval_detalle_examenes.alumno&#xa;	  AND sga_alumnos.persona &#x3d; mdp_personas.persona&#xa;	  &#xa;	  -- Otra propuesta del alumno  &#xa;	  AND sga_alumnos2.persona &#x3d; sga_alumnos.persona&#xa;	  AND sga_alumnos2.propuesta &#x3c;&#x3e; sga_alumnos.propuesta&#xa;	  AND sga_propuestas.propuesta &#x3d; sga_alumnos2.propuesta&#xa;	  AND sga_planes_versiones2.plan_version &#x3d; sga_alumnos2.plan_version&#xa;	  AND ingreso.alumno &#x3d; sga_alumnos2.alumno&#xa;	  AND sga_elementos_revision2.elemento &#x3d; sga_elementos.elemento&#xa;	  AND sga_elementos_plan2.plan_version      &#x3d; sga_alumnos2.plan_version&#xa;	  AND sga_elementos_plan2.elemento_revision &#x3d; sga_elementos_revision2.elemento_revision&#xa;	  &#xa;	  AND intentos.alumno &#x3d; sga_eval_detalle_examenes.alumno&#xa;	  AND intentos.elemento &#x3d; vw_mesas_examen.mesa_examen_elemento&#xa;	  AND intentos.llamado_mesa &#x3d; vw_mesas_examen.llamado_mesa&#xa;	  AND &#x28;&#x24;&#x7b;periodo&#x7d; &#x3d; 0 or vw_mesas_examen.anio_academico &#x3d; &#x24;&#x7b;periodo&#x7d;&#x29;</sql>
    <limit>0</limit>
