    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>-- SE ELIMINAN TODOS LOS DATOS PREVIOS&#xa;TRUNCATE TABLE diaguita_dsa.ft_compras&#x3b;&#xa;&#xa;-- SE CARGAN LOS DATOS DE LA TEMPORAL&#xa;INSERT INTO diaguita_dsa.ft_compras&#xa;&#x28;&#xa;  id_compras,&#xa;  etapa,&#xa;  identificador_solicitud,&#xa;  fecha_creacion_solicitud,&#xa;  descripcion_solicitud,&#xa;  prioridad_solicitud,&#xa;  estado_solicitud,&#xa;  referente_solicitud,&#xa;  id_lugar_entrega_solicitud,&#xa;  id_oficina_central_contratacion_solicitud,&#xa;  id_area_solicitud,&#xa;  descripcion_item_solicitado,&#xa;  id_rubro_solicitud,&#xa;  cantidad_item_solicitado,&#xa;  unidad_medida_item_solicitado,&#xa;  precio_estimado_item_solicitado,&#xa;  id_area_item_solicitado,&#xa;  numero_mcc,&#xa;  descripcion_mcc,&#xa;  identificador_convocatoria,&#xa;  fecha_creacion_convocatoria,&#xa;  descripcion_convocatoria,&#xa;  estado_convocatoria,&#xa;  prioridad_convocatoria,&#xa;  id_convocatoria,&#xa;  expediente_ejercicio_conv,&#xa;  expediente_convocatoria,&#xa;  tipo_procedimiento_convocatoria,&#xa;  id_oficina_convocatoria,&#xa;  id_procedimiento_modalidad,&#xa;  id_procedimiento_clase,&#xa;  usuario_autorizante_conv,&#xa;  fecha_autorizacion_conv, &#xa;  id_renglon,&#xa;  descripcion_renglon,&#xa;  numero_renglon,&#xa;  precio_estimado_renglon,&#xa;  catalogo_bien_servicio_renglon,&#xa;  id_rubro_convocatoria,&#xa;  id_renglon_area,&#xa;  cantidad_renglon,&#xa;  id_item_area,&#xa;  id_convocatoria_aa,&#xa;  id_acto_apertura,&#xa;  inicio_acto_apertura,&#xa;  fecha_acto_apertura,&#xa;  fin_acto_apertura,&#xa;  oficina_acto_apertura,&#xa;  lugar_acto_apertura,&#xa;  identificador_acto_apertura,&#xa;  estado_acto_apertura,&#xa;  id_acto_apertura_de,&#xa;  fecha_creacion_dictamen,&#xa;  fecha_generacion_dictamen,&#xa;  identificador_dictamen,&#xa;  estado_dictamen,&#xa;  -- Adjudicacion&#xa;  id_renglon_ad,&#xa;  estado_adjudicacion,&#xa;  identificador_adjudicacion,&#xa;  id_proveedor,&#xa;  cantidad_ad,&#xa;  monto_unitario,&#xa;  id_adjudicacion,&#xa;  -- Orden de Compra&#xa;  id_renglon_area_oc,&#xa;  id_detalle_orden_compra_oc,&#xa;  id_proveedor_oc,&#xa;  id_area_oc,&#xa;  estado_orden_compra,&#xa;  identificador_orden_compra,&#xa;  fecha_emision_oc,&#xa;  id_lugar_entrega_oc,&#xa;  fecha_vencimiento_oc,&#xa;  cantidad_oc,&#xa;  id_adjudicacion_oc,&#xa;  id_moneda_oc,&#xa;  -- Recepciones&#xa;  id_detalle_orden_compra_re,&#xa;  fecha_recepcion,&#xa;  estado_recepcion,&#xa;  remito,&#xa;  factura_numero,&#xa;  identificador_acta_provisoria_recepcion,&#xa;  fecha_acta_provisoria_re,&#xa;  id_area_re,&#xa;  identificador_acta_definitiva_recepcion,&#xa;  fecha_acta_definitiva_re,&#xa;  cantidad_recibida,&#xa;  cantidad_aceptada,&#xa;  cantidad_rechazada&#xa;&#x29;&#xa;SELECT&#xa;  id_compras&#x3a;&#x3a;integer,&#xa;  etapa,&#xa;  identificador_solicitud,&#xa;  fecha_creacion_solicitud&#x3a;&#x3a;date,&#xa;  descripcion_solicitud,&#xa;  prioridad_solicitud,&#xa;  estado_solicitud,&#xa;  referente_solicitud,&#xa;  id_lugar_entrega_solicitud&#x3a;&#x3a;integer,&#xa;  id_oficina_central_contratacion_solicitud&#x3a;&#x3a;integer,&#xa;  id_area_solicitud&#x3a;&#x3a;integer,&#xa;  descripcion_item_solicitado,&#xa;  id_rubro_solicitud&#x3a;&#x3a;integer,&#xa;  to_number&#x28;cantidad_item_solicitado,&#x27;99999999999.99&#x27;&#x29;,&#xa;  unidad_medida_item_solicitado,&#xa;  to_number&#x28;precio_estimado_item_solicitado,&#x27;99999999999.99&#x27;&#x29;,&#xa;  id_area_item_solicitado&#x3a;&#x3a;integer,&#xa;  coalesce&#x28;numero_mcc,&#x27;Sin N&#xfa;mero&#x27;&#x29; as numero_mcc,&#xa;  coalesce&#x28;descripcion_mcc,&#x27;Sin Modelo de Compras Centralizado&#x27;&#x29; as descripcion_mcc,&#xa;  identificador_convocatoria,&#xa;  fecha_creacion_convocatoria&#x3a;&#x3a;date,&#xa;  descripcion_convocatoria,&#xa;  estado_convocatoria,&#xa;  prioridad_convocatoria,&#xa;  id_convocatoria&#x3a;&#x3a;integer,&#xa;  expediente_ejercicio_conv&#x3a;&#x3a;integer,&#xa;  expediente_convocatoria,&#xa;  tipo_procedimiento_convocatoria,&#xa;  id_oficina_convocatoria&#x3a;&#x3a;integer,&#xa;  id_procedimiento_modalidad&#x3a;&#x3a;integer,&#xa;  id_procedimiento_clase&#x3a;&#x3a;integer,&#xa;  usuario_autorizante_conv&#x3a;&#x3a;integer,&#xa;  fecha_autorizacion_conv&#x3a;&#x3a;date,&#xa;  id_renglon&#x3a;&#x3a;integer,&#xa;  descripcion_renglon,&#xa;  numero_renglon,&#xa;  to_number&#x28;precio_estimado_renglon,&#x27;99999999999.99&#x27;&#x29;,&#xa;  catalogo_bien_servicio_renglon&#x3a;&#x3a;integer,&#xa;  id_rubro_convocatoria&#x3a;&#x3a;integer,&#xa;  id_renglon_area&#x3a;&#x3a;integer,&#xa;  to_number&#x28;cantidad_renglon,&#x27;99999999999.99&#x27;&#x29;,&#xa;  id_item_area&#x3a;&#x3a;integer,&#xa;  id_convocatoria_aa&#x3a;&#x3a;integer,&#xa;  id_acto_apertura&#x3a;&#x3a;integer,&#xa;  inicio_acto_apertura&#x3a;&#x3a;timestamp,&#xa;  inicio_acto_apertura&#x3a;&#x3a;date,&#xa;  fin_acto_apertura&#x3a;&#x3a;timestamp,&#xa;  oficina_acto_apertura,&#xa;  lugar_acto_apertura,&#xa;  identificador_acto_apertura,&#xa;  estado_acto_apertura,&#xa;  id_acto_apertura_de&#x3a;&#x3a;integer,&#xa;  fecha_creacion_dictamen&#x3a;&#x3a;date,&#xa;  fecha_generacion_dictamen&#x3a;&#x3a;date,&#xa;  identificador_dictamen,&#xa;  estado_dictamen,&#xa;  -- Adjudicacion&#xa;  id_renglon_ad&#x3a;&#x3a;integer,&#xa;  estado_adjudicacion,&#xa;  identificador_adjudicacion,&#xa;  id_proveedor&#x3a;&#x3a;integer,&#xa;  to_number&#x28;cantidad_ad,&#x27;99999999999.99&#x27;&#x29;,&#xa;  to_number&#x28;monto_unitario,&#x27;99999999999.99&#x27;&#x29;,&#xa;  id_adjudicacion&#x3a;&#x3a;integer,&#xa;  -- Orden de Compra&#xa;  id_renglon_area_oc&#x3a;&#x3a;integer,&#xa;  id_detalle_orden_compra_oc&#x3a;&#x3a;integer,&#xa;  id_proveedor_oc&#x3a;&#x3a;integer,&#xa;  id_area_oc&#x3a;&#x3a;integer,&#xa;  estado_orden_compra,&#xa;  identificador_orden_compra,&#xa;  fecha_emision_oc&#x3a;&#x3a;date,&#xa;  id_lugar_entrega_oc&#x3a;&#x3a;integer,&#xa;  fecha_vencimiento_oc&#x3a;&#x3a;date,&#xa;  to_number&#x28;cantidad_oc,&#x27;99999999999.99&#x27;&#x29;,&#xa;  id_adjudicacion_oc&#x3a;&#x3a;integer,&#xa;  id_moneda_oc&#x3a;&#x3a;integer,&#xa;  -- Recepciones&#xa;  id_detalle_orden_compra_re&#x3a;&#x3a;integer,&#xa;  fecha_recepcion&#x3a;&#x3a;date,&#xa;  estado_recepcion,&#xa;  remito,&#xa;  factura_numero,&#xa;  identificador_acta_provisoria_recepcion,&#xa;  fecha_acta_provisoria_re&#x3a;&#x3a;date,&#xa;  id_area_re&#x3a;&#x3a;integer,&#xa;  identificador_acta_definitiva_recepcion,&#xa;  fecha_acta_definitiva_re&#x3a;&#x3a;date,&#xa;  to_number&#x28;cantidad_recibida,&#x27;99999999999.99&#x27;&#x29;,&#xa;  to_number&#x28;cantidad_aceptada,&#x27;99999999999.99&#x27;&#x29;,&#xa;  to_number&#x28;cantidad_rechazada,&#x27;99999999999.99&#x27;&#x29;&#xa;FROM diaguita_tmp.ft_compras&#x3b;&#xa;&#xa;-- Completa orden de compra en base a Recepcion &#x2f;&#x2f; En &#x28;4&#x29; completa &#x28;3&#x29; &#x2f;&#x2f; &#x28;A&#x29;&#xa;UPDATE diaguita_dsa.ft_compras c SET&#xa;  etapa&#x3d;c.etapa &#x7c;&#x7c; &#x27; A&#x27;,&#xa;  id_renglon_area_oc&#x3d;c2.id_renglon_area_oc,&#xa;  id_detalle_orden_compra_oc&#x3d;c2.id_detalle_orden_compra_oc,&#xa;  id_proveedor&#x3d;c2.id_proveedor_oc,&#xa;  id_proveedor_oc&#x3d;c2.id_proveedor_oc,&#xa;  id_area_oc&#x3d;c2.id_area_oc,&#xa;  estado_orden_compra&#x3d;c2.estado_orden_compra,&#xa;  identificador_orden_compra&#x3d;c2.identificador_orden_compra,&#xa;  fecha_emision_oc&#x3d;c2.fecha_emision_oc,&#xa;  id_lugar_entrega_oc&#x3d;c2.id_lugar_entrega_oc,&#xa;  fecha_vencimiento_oc&#x3d;c2.fecha_vencimiento_oc,&#xa;  cantidad_oc&#x3d;0,&#xa;  id_adjudicacion_oc&#x3d;c2.id_adjudicacion_oc,&#xa;  id_moneda_oc&#x3d;c2.id_moneda_oc&#xa;FROM diaguita_dsa.ft_compras c2&#xa;WHERE c.id_detalle_orden_compra_re &#x3d; c2.id_detalle_orden_compra_oc &#xa;	AND c.id_detalle_orden_compra_oc IS NULL and c.id_detalle_orden_compra_re IS NOT NULL&#x3b;&#xa;&#xa;-- Completa Convocatoria en base a Orden de Compra &#x2f;&#x2f; En &#x28;3&#x29; y &#x28;4&#x29; completa &#x28;2&#x29; &#x2f;&#x2f; &#x28;B&#x29;&#xa;UPDATE diaguita_dsa.ft_compras c SET&#xa; etapa&#x3d;c.etapa &#x7c;&#x7c; &#x27; B&#x27;,&#xa; id_renglon_ad&#x3d;c2.id_renglon_ad,&#xa; estado_adjudicacion&#x3d;c2.estado_adjudicacion,&#xa; identificador_adjudicacion&#x3d;c2.identificador_adjudicacion,&#xa; id_proveedor&#x3d;c2.id_proveedor,&#xa; monto_unitario_oc&#x3d;CASE WHEN c.etapa&#x3d;&#x27;3&#x27; THEN c2.monto_unitario ELSE 0 END&#xa;FROM diaguita_dsa.ft_compras c2&#xa;WHERE c.id_adjudicacion_oc &#x3d; c2.id_adjudicacion &#xa;	AND c.id_adjudicacion IS NULL and c.id_adjudicacion_oc IS NOT NULL&#x3b;&#xa;&#xa;-- Completa Convocatoria en base a Acto de adjudicacion &#x2f;&#x2f; En &#x28;2&#x29;, &#x28;3&#x29; y &#x28;4&#x29; completa &#x28;1&#x29; &#x2f;&#x2f; &#x28;C&#x29;&#xa;UPDATE diaguita_dsa.ft_compras c SET&#xa; etapa&#x3d;c.etapa &#x7c;&#x7c; &#x27; C&#x27;,&#xa; identificador_solicitud&#x3d;c2.identificador_solicitud,&#xa; fecha_creacion_solicitud&#x3d;c2.fecha_creacion_solicitud,&#xa; descripcion_solicitud&#x3d;c2.descripcion_solicitud,&#xa; prioridad_solicitud&#x3d;c2.prioridad_solicitud,&#xa; estado_solicitud&#x3d;c2.estado_solicitud,&#xa; referente_solicitud&#x3d;c2.referente_solicitud,&#xa; id_lugar_entrega_solicitud&#x3d;c2.id_lugar_entrega_solicitud,&#xa; id_oficina_central_contratacion_solicitud&#x3d;c2.id_oficina_central_contratacion_solicitud,&#xa; id_area_solicitud&#x3d;c2.id_area_solicitud,&#xa; descripcion_item_solicitado&#x3d;c2.descripcion_item_solicitado,&#xa; id_rubro_solicitud&#x3d;c2.id_rubro_solicitud,&#xa; cantidad_item_solicitado&#x3d;0,&#xa; unidad_medida_item_solicitado&#x3d;c2.unidad_medida_item_solicitado,&#xa; precio_estimado_item_solicitado&#x3d;0,&#xa; id_area_item_solicitado&#x3d;c2.id_area_item_solicitado,&#xa; numero_mcc&#x3d;c2.numero_mcc,&#xa; descripcion_mcc&#x3d;c2.descripcion_mcc,&#xa; identificador_convocatoria&#x3d;c2.identificador_convocatoria,&#xa; fecha_creacion_convocatoria&#x3d;c2.fecha_creacion_convocatoria,&#xa; descripcion_convocatoria&#x3d;c2.descripcion_convocatoria,&#xa; estado_convocatoria&#x3d;c2.estado_convocatoria,&#xa; prioridad_convocatoria&#x3d;c2.prioridad_convocatoria,&#xa; id_convocatoria&#x3d;c2.id_convocatoria,&#xa; expediente_ejercicio_conv&#x3d;c2.expediente_ejercicio_conv,&#xa; expediente_convocatoria&#x3d;c2.expediente_convocatoria,&#xa; tipo_procedimiento_convocatoria&#x3d;c2.tipo_procedimiento_convocatoria,&#xa; id_oficina_convocatoria&#x3d;c2.id_oficina_convocatoria,&#xa; id_procedimiento_modalidad&#x3d;c2.id_procedimiento_modalidad,&#xa; id_procedimiento_clase&#x3d;c2.id_procedimiento_clase,&#xa; usuario_autorizante_conv&#x3d;c2.usuario_autorizante_conv,&#xa; fecha_autorizacion_conv&#x3d;c2.fecha_autorizacion_conv,&#xa; id_renglon&#x3d;c2.id_renglon,&#xa; descripcion_renglon&#x3d;c2.descripcion_renglon,&#xa; numero_renglon&#x3d;c2.numero_renglon,&#xa; precio_estimado_renglon&#x3d;0,&#xa; catalogo_bien_servicio_renglon&#x3d;c2.catalogo_bien_servicio_renglon,&#xa; id_rubro_convocatoria&#x3d;c2.id_rubro_convocatoria,&#xa; id_renglon_area&#x3d;c2.id_renglon_area,&#xa; cantidad_renglon&#x3d;0,&#xa; id_item_area&#x3d;c2.id_item_area,&#xa; id_convocatoria_aa&#x3d;c2.id_convocatoria_aa,&#xa; id_acto_apertura&#x3d;c2.id_acto_apertura,&#xa; inicio_acto_apertura&#x3d;c2.inicio_acto_apertura,&#xa; fin_acto_apertura&#x3d;c2.fin_acto_apertura,&#xa; oficina_acto_apertura&#x3d;c2.oficina_acto_apertura,&#xa; lugar_acto_apertura&#x3d;c2.lugar_acto_apertura,&#xa; identificador_acto_apertura&#x3d;c2.identificador_acto_apertura,&#xa; estado_acto_apertura&#x3d;c2.estado_acto_apertura,&#xa; id_acto_apertura_de&#x3d;c2.id_acto_apertura_de,&#xa; fecha_creacion_dictamen&#x3d;c2.fecha_creacion_dictamen,&#xa; fecha_generacion_dictamen&#x3d;c2.fecha_generacion_dictamen,&#xa; identificador_dictamen&#x3d;c2.identificador_dictamen,&#xa; estado_dictamen&#x3d;c2.estado_dictamen&#xa;FROM diaguita_dsa.ft_compras c2&#xa;WHERE c.id_renglon_ad &#x3d; c2.id_renglon &#xa;	AND c.id_renglon IS NULL and c.id_renglon_ad IS NOT NULL&#x3b;&#xa;&#xa;--Se cargan los ID reales de los codigos de area&#xa;-- id_area_solicitud&#xa;UPDATE diaguita_dsa.ft_compras SET id_area_solicitud &#x3d; &#xa; coalesce&#x28;&#x28;SELECT a.area_id &#xa;		FROM diaguita_dsa.d_area a, diaguita_dsa.w_area w&#xa;		WHERE id_area_solicitud&#x3d;w.codigo&#x3a;&#x3a;integer&#xa;		AND w.codigo_asignado&#x3d;a.area_nivel2_codigo&#xa;		AND &#x24;&#x7b;instalacion_id&#x7d; &#x3d; a.instalacion_id&#x29;&#xa;		,0&#x29;&#xa;WHERE id_area_solicitud IS NOT NULL&#x3b;&#xa;-- id_area_item_solicitado&#xa;UPDATE diaguita_dsa.ft_compras SET id_area_item_solicitado &#x3d; &#xa; coalesce&#x28;&#x28;SELECT a.area_id &#xa;		FROM diaguita_dsa.d_area a, diaguita_dsa.w_area w&#xa;		WHERE id_area_item_solicitado&#x3d;w.codigo&#x3a;&#x3a;integer&#xa;		AND w.codigo_asignado&#x3d;a.area_nivel2_codigo&#xa;		AND &#x24;&#x7b;instalacion_id&#x7d; &#x3d; a.instalacion_id&#x29;&#xa;		,0&#x29;&#xa;WHERE id_area_item_solicitado IS NOT NULL&#x3b;&#xa;-- id_area_oc&#xa;UPDATE diaguita_dsa.ft_compras SET id_area_oc &#x3d; &#xa; coalesce&#x28;&#x28;SELECT a.area_id &#xa;		FROM diaguita_dsa.d_area a, diaguita_dsa.w_area w&#xa;		WHERE id_area_oc&#x3d;w.codigo&#x3a;&#x3a;integer&#xa;		AND w.codigo_asignado&#x3d;a.area_nivel2_codigo&#xa;		AND &#x24;&#x7b;instalacion_id&#x7d; &#x3d; a.instalacion_id&#x29;&#xa;		,0&#x29;&#xa;WHERE id_area_oc IS NOT NULL&#x3b;&#xa;-- id_area_re&#xa;UPDATE diaguita_dsa.ft_compras SET id_area_re &#x3d; &#xa; coalesce&#x28;&#x28;SELECT a.area_id &#xa;		FROM diaguita_dsa.d_area a, diaguita_dsa.w_area w&#xa;		WHERE id_area_re&#x3d;w.codigo&#x3a;&#x3a;integer&#xa;		AND w.codigo_asignado&#x3d;a.area_nivel2_codigo&#xa;		AND &#x24;&#x7b;instalacion_id&#x7d; &#x3d; a.instalacion_id&#x29;&#xa;		,0&#x29;&#xa;WHERE id_area_re IS NOT NULL&#x3b;&#xa;&#xa;-- ACTUALIZA LOS IDENTIFICADORES CON VALORES POR DEFECTO&#xa;UPDATE diaguita_dsa.ft_compras SET identificador_solicitud&#x3d;&#x27;S&#x2f;N&#x27;&#xa;WHERE identificador_solicitud IS NULL OR identificador_solicitud &#x3d; &#x27;&#x27;&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET identificador_convocatoria&#x3d;&#x27;S&#x2f;N&#x27;&#xa;WHERE identificador_convocatoria IS NULL OR identificador_convocatoria &#x3d; &#x27;&#x27;&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET identificador_acto_apertura&#x3d;&#x27;S&#x2f;N&#x27;&#xa;WHERE identificador_acto_apertura IS NULL OR identificador_acto_apertura &#x3d; &#x27;&#x27;&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET identificador_dictamen&#x3d;&#x27;S&#x2f;N&#x27;&#xa;WHERE identificador_dictamen IS NULL OR identificador_dictamen &#x3d; &#x27;&#x27;&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET identificador_adjudicacion&#x3d;&#x27;S&#x2f;N&#x27;&#xa;WHERE identificador_adjudicacion IS NULL OR identificador_adjudicacion &#x3d; &#x27;&#x27;&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET identificador_orden_compra&#x3d;&#x27;S&#x2f;N&#x27;&#xa;WHERE identificador_orden_compra IS NULL OR identificador_orden_compra &#x3d; &#x27;&#x27;&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET identificador_acta_provisoria_recepcion&#x3d;&#x27;S&#x2f;N&#x27;&#xa;WHERE identificador_acta_provisoria_recepcion IS NULL OR identificador_acta_provisoria_recepcion &#x3d; &#x27;&#x27;&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET identificador_acta_definitiva_recepcion&#x3d;&#x27;S&#x2f;N&#x27;&#xa;WHERE identificador_acta_definitiva_recepcion IS NULL OR identificador_acta_definitiva_recepcion &#x3d; &#x27;&#x27;&#x3b;&#xa;&#xa;-- COLAPSA &#x28;RESUME&#x29; LOS REGISTROS DE LAS PRIMERAS ETAPAS EN LOS DE LA SIGUIENTE SI ES QUE SE PUEDE TICKET 747&#xa;-- &#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#xa;-- Colapsa Solicitudes y Convocatorias &#x28;1&#x29; en Adjudicaciones &#x28;2 C&#x29;&#xa;SELECT 0 AS id_renglon,0 as id_renglon_ad,2 as cantidad INTO TEMP paso_1&#x3b; -- Crea un registro para que siempre exista la tabla&#xa;INSERT INTO paso_1 &#x28;id_renglon, id_renglon_ad, cantidad&#x29; &#xa;SELECT DISTINCT c1.id_renglon, c2.id_renglon_ad, count&#x28;&#x2a;&#x29; AS cantidad&#xa;FROM diaguita_dsa.ft_compras c1, diaguita_dsa.ft_compras c2&#xa;WHERE c1.etapa&#x3d;&#x27;1&#x27; AND c2.etapa&#x3d;&#x27;2 C&#x27; &#xa;AND c1.id_renglon&#x3d;c2.id_renglon_ad&#xa;GROUP BY 1,2&#x3b;&#xa;DELETE FROM paso_1 WHERE cantidad&#x3e;1&#x3b;&#xa;--SELECT &#x2a; FROM paso_1&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras c2 SET&#xa;     -- Paso 1&#xa;        cantidad_item_solicitado &#x3d; c1.cantidad_item_solicitado,&#xa;        precio_estimado_item_solicitado &#x3d; c1.precio_estimado_item_solicitado,&#xa;        precio_estimado_renglon &#x3d; c1.precio_estimado_renglon,&#xa;        cantidad_renglon &#x3d; c1.cantidad_renglon&#xa;    FROM diaguita_dsa.ft_compras c1, paso_1 &#xa;WHERE c2.id_renglon_ad&#x3d;paso_1.id_renglon_ad AND c2.etapa &#x3d; &#x27;2 C&#x27; AND paso_1.id_renglon&#x3d;c1.id_renglon AND c1.etapa &#x3d; &#x27;1&#x27;&#x3b;&#xa;DELETE FROM diaguita_dsa.ft_compras WHERE id_renglon IN &#x28;SELECT id_renglon FROM paso_1&#x29; AND etapa &#x3d; &#x27;1&#x27;&#x3b;&#xa;&#xa;-- Colapsa Adjudicaciones &#x28;2 C&#x29; en Ordenes de Compra &#x28;3 B C&#x29;&#xa;SELECT 0 AS id_adjudicacion,0 as id_adjudicacion_oc,2 as cantidad INTO TEMP paso_2&#x3b; -- Crea un registro para que siempre exista la tabla&#xa;INSERT INTO paso_2 &#x28;id_adjudicacion, id_adjudicacion_oc, cantidad&#x29; &#xa;SELECT DISTINCT c2.id_adjudicacion, c3.id_adjudicacion_oc, count&#x28;&#x2a;&#x29; AS cantidad&#xa;FROM diaguita_dsa.ft_compras c2, diaguita_dsa.ft_compras c3&#xa;WHERE c2.etapa&#x3d;&#x27;2 C&#x27; AND c3.etapa&#x3d;&#x27;3 B C&#x27; &#xa;AND c2.id_adjudicacion&#x3d;c3.id_adjudicacion_oc&#xa;GROUP BY 1,2&#x3b;&#xa;DELETE FROM paso_2 WHERE cantidad&#x3e;1&#x3b;&#xa;--SELECT &#x2a; FROM paso_2&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras c3 SET&#xa;     -- Paso 1&#xa;        cantidad_item_solicitado &#x3d; c2.cantidad_item_solicitado,&#xa;        precio_estimado_item_solicitado &#x3d; c2.precio_estimado_item_solicitado,&#xa;        precio_estimado_renglon &#x3d; c2.precio_estimado_renglon,&#xa;        cantidad_renglon &#x3d; c2.cantidad_renglon,&#xa;     -- Paso 2&#xa;        cantidad_ad &#x3d; c2.cantidad_ad,&#xa;        monto_unitario &#x3d; c2.monto_unitario&#xa;    FROM diaguita_dsa.ft_compras c2, paso_2 &#xa;WHERE c3.id_adjudicacion_oc&#x3d;paso_2.id_adjudicacion_oc AND c3.etapa &#x3d; &#x27;3 B C&#x27; AND paso_2.id_adjudicacion&#x3d;c2.id_adjudicacion AND c2.etapa &#x3d; &#x27;2 C&#x27;&#x3b;&#xa;DELETE FROM diaguita_dsa.ft_compras WHERE id_adjudicacion IN &#x28;SELECT id_adjudicacion FROM paso_2&#x29; AND etapa &#x3d; &#x27;2 C&#x27;&#x3b;&#xa;&#xa;-- Colapsa Ordenes de Compra &#x28;3 B C&#x29; en Recepciones &#x28;4 A B C&#x29;&#xa;SELECT 0 AS id_detalle_orden_compra_oc,0 as id_detalle_orden_compra_re,2 as cantidad INTO TEMP paso_3&#x3b; -- Crea un registro para que siempre exista la tabla&#xa;INSERT INTO paso_3 &#x28;id_detalle_orden_compra_oc, id_detalle_orden_compra_re, cantidad&#x29; &#xa;SELECT DISTINCT c3.id_detalle_orden_compra_oc, c4.id_detalle_orden_compra_re, count&#x28;&#x2a;&#x29; AS cantidad&#xa;FROM diaguita_dsa.ft_compras c3, diaguita_dsa.ft_compras c4&#xa;WHERE c3.etapa&#x3d;&#x27;3 B C&#x27; AND c4.etapa&#x3d;&#x27;4 A B C&#x27; &#xa;AND c3.id_detalle_orden_compra_oc&#x3d;c4.id_detalle_orden_compra_re&#xa;GROUP BY 1,2&#x3b;&#xa;DELETE FROM paso_3 WHERE cantidad&#x3e;1&#x3b;&#xa;--SELECT &#x2a; FROM paso_3&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras c4 SET&#xa;     -- Paso 1&#xa;        cantidad_item_solicitado &#x3d; c3.cantidad_item_solicitado,&#xa;        precio_estimado_item_solicitado &#x3d; c3.precio_estimado_item_solicitado,&#xa;        precio_estimado_renglon &#x3d; c3.precio_estimado_renglon,&#xa;        cantidad_renglon &#x3d; c3.cantidad_renglon,&#xa;     -- Paso 2&#xa;        cantidad_ad &#x3d; c3.cantidad_ad,&#xa;        monto_unitario &#x3d; c3.monto_unitario,&#xa;     -- Paso 3&#xa;        cantidad_oc &#x3d; c3.cantidad_oc,&#xa;        monto_unitario_oc &#x3d; c3.monto_unitario_oc&#xa;    FROM diaguita_dsa.ft_compras c3, paso_3 &#xa;WHERE c4.id_detalle_orden_compra_re&#x3d;paso_3.id_detalle_orden_compra_re AND c4.etapa &#x3d; &#x27;4 A B C&#x27; AND paso_3.id_detalle_orden_compra_oc&#x3d;c3.id_detalle_orden_compra_oc AND c3.etapa &#x3d; &#x27;3 B C&#x27;&#x3b;&#xa;DELETE FROM diaguita_dsa.ft_compras WHERE id_detalle_orden_compra_oc IN &#x28;SELECT id_detalle_orden_compra_oc FROM paso_3&#x29; AND etapa &#x3d; &#x27;3 B C&#x27;&#x3b;&#xa;-- &#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#x2a;&#xa;&#xa;-- Actualiza fechas y timestamp vacios con valor del 31&#x2f;12&#x2f;2199 para que aparezcan los registros en el saiku&#xa;UPDATE diaguita_dsa.ft_compras SET fecha_creacion_dictamen&#x3d;&#x27;2199-12-31&#x27;&#x3a;&#x3a;date WHERE fecha_creacion_dictamen IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET fecha_generacion_dictamen&#x3d;&#x27;2199-12-31&#x27;&#x3a;&#x3a;date WHERE fecha_generacion_dictamen IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET fecha_emision_oc&#x3d;&#x27;2199-12-31&#x27;&#x3a;&#x3a;date WHERE fecha_emision_oc IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET fecha_vencimiento_oc&#x3d;&#x27;2199-12-31&#x27;&#x3a;&#x3a;date WHERE fecha_vencimiento_oc IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET fecha_recepcion&#x3d;&#x27;2199-12-31&#x27;&#x3a;&#x3a;date WHERE fecha_recepcion IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET fecha_acta_provisoria_re&#x3d;&#x27;2199-12-31&#x27;&#x3a;&#x3a;date WHERE fecha_acta_provisoria_re IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET fecha_acta_definitiva_re&#x3d;&#x27;2199-12-31&#x27;&#x3a;&#x3a;date WHERE fecha_acta_definitiva_re IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET inicio_acto_apertura&#x3d;&#x27;2199-12-31 23&#x3a;59&#x3a;59&#x27;&#x3a;&#x3a;timestamp WHERE inicio_acto_apertura IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET fin_acto_apertura&#x3d;&#x27;2199-12-31 23&#x3a;59&#x3a;59&#x27;&#x3a;&#x3a;timestamp WHERE fin_acto_apertura IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET fecha_acto_apertura&#x3d;&#x27;2199-12-31&#x27;&#x3a;&#x3a;date WHERE fecha_acto_apertura IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET fecha_autorizacion_conv&#x3d;&#x27;2199-12-31&#x27;&#x3a;&#x3a;date WHERE fecha_autorizacion_conv IS NULL&#x3b;&#xa;&#xa;-- Le pone VACIA&#x2f;NULA a clase y modalidad que no tienen datos para que no desaparezcan los registros.&#xa;UPDATE diaguita_dsa.ft_compras SET id_procedimiento_clase&#x3d;0 WHERE id_procedimiento_clase IS NULL&#x3b;&#xa;UPDATE diaguita_dsa.ft_compras SET id_procedimiento_modalidad&#x3d;0 WHERE id_procedimiento_modalidad IS NULL&#x3b;&#xa;&#xa;&#xa;-- ACTUALIZA LOS IMPORTES TOTALES&#xa;UPDATE diaguita_dsa.ft_compras c SET&#xa;  importe_total_solicitud &#x3d; precio_estimado_item_solicitado &#x2a; cantidad_item_solicitado,&#xa;  importe_total_convocatoria &#x3d; precio_estimado_renglon &#x2a; cantidad_renglon,&#xa;  importe_total_adjudicado &#x3d; monto_unitario &#x2a; cantidad_ad,&#xa;  importe_total_oc &#x3d; monto_unitario_oc &#x2a; cantidad_oc&#x3b;&#xa;&#xa;&#xa;</sql>
