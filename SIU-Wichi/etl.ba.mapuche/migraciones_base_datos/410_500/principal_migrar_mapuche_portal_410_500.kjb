      <name>crear indices</name>
      <description/>
      <type>SQL</type>
      <sql>-- Se crea un indice para esta tabla porque de lo contrario la proxima vista es muy lenta.&#xa;CREATE INDEX personal_ft_acreditaciones_index ON mapuche_tmp.personal_ft_acreditaciones &#x28;idperiodo, idpersona&#x29;&#x3b;</sql>
