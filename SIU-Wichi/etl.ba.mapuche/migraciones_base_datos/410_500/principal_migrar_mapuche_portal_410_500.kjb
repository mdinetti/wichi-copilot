    <entry>
      <name>error 8 2</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <logmessage>Se produjo un error al momento de cerrar el registro de importaci&#xf3;n de datos en public.importacion.</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>&#x5b;ERROR&#x5d;&#x3a; Cerrar importaci&#xf3;n</logsubject>
      <parallel>N</parallel>
