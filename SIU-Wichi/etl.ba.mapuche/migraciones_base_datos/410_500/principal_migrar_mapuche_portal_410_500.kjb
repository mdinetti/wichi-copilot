    <entry>
      <name>crear tablas tmp portal</name>
      <description/>
      <type>SQL</type>
      <sql>CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_activos &#x28;&#xa;    idactivo integer NOT NULL,&#xa;    activo character varying&#x28;1&#x29; NOT NULL,&#xa;    descactivo character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_antiguedades &#x28;&#xa;    idantiguedad integer NOT NULL,&#xa;    antiguedad numeric&#x28;4,0&#x29; NOT NULL&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_caracteres &#x28;&#xa;    idcaracter integer NOT NULL,&#xa;    caracter character varying&#x28;1&#x29; NOT NULL,&#xa;    desccaracter character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_cargos &#x28;&#xa;    idnro_cargo integer NOT NULL,&#xa;    nro_cargo integer NOT NULL&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_categorias &#x28;&#xa;    idcategoria integer NOT NULL,&#xa;    categoria character varying&#x28;4&#x29; NOT NULL,&#xa;    nombre character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_dedicaciones &#x28;&#xa;    iddedicacion integer NOT NULL,&#xa;    dedicacion character varying&#x28;4&#x29; NOT NULL,&#xa;    nombre character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_depsubdep &#x28;&#xa;    iddepsubdep integer NOT NULL,&#xa;    anoperiodo integer NOT NULL,&#xa;    dependen integer NOT NULL,&#xa;    subdepen integer NOT NULL,&#xa;    nombre character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_edades &#x28;&#xa;    idedad integer NOT NULL,&#xa;    edad numeric&#x28;3,0&#x29; NOT NULL&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_escalafones &#x28;&#xa;    idescalafon integer NOT NULL,&#xa;    escalafon character varying&#x28;1&#x29; NOT NULL,&#xa;    nombre character varying&#x28;255&#x29; NOT NULL&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_fec_datos &#x28;&#xa;    idfec_datos integer NOT NULL,&#xa;    fec_datos date NOT NULL&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_fuentes &#x28;&#xa;    idfuente integer NOT NULL,&#xa;    codigofuente integer NOT NULL,&#xa;    descfuente character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_generos &#x28;&#xa;    idgenero integer NOT NULL,&#xa;    genero character varying&#x28;1&#x29; NOT NULL,&#xa;    descgenero character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_incentivos &#x28;&#xa;    idincentivo integer NOT NULL,&#xa;    incentivo character varying&#x28;1&#x29; NOT NULL,&#xa;    descincentivo character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_licencias &#x28;&#xa;    idlicencia integer NOT NULL,&#xa;    licencia character varying&#x28;1&#x29; NOT NULL,&#xa;    desclicencia character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_nivelestudio &#x28;&#xa;    idnivelestudio integer NOT NULL,&#xa;    nivelestud character varying&#x28;4&#x29; NOT NULL,&#xa;    nombre character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_periodos &#x28;&#xa;    idperiodo integer NOT NULL,&#xa;    anio integer NOT NULL,&#xa;    mes integer NOT NULL,&#xa;    descmes character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_personas &#x28;&#xa;    idpersona integer NOT NULL,&#xa;    nro_legajo integer NOT NULL,&#xa;    apyno character varying&#x28;255&#x29;,&#xa;    fec_nacim date,&#xa;    idgenero integer&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_rangos_importes &#x28;&#xa;    idrango_importe integer NOT NULL,&#xa;    rango_importe character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_d_unidadacad &#x28;&#xa;    idunidadacad integer NOT NULL,&#xa;    unidadacad character varying&#x28;4&#x29; NOT NULL,&#xa;    nombre character varying&#x28;255&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_ft_acreditaciones &#x28;&#xa;    idacreditacion integer NOT NULL,&#xa;    idperiodo integer NOT NULL,&#xa;    idpersona integer NOT NULL,&#xa;    idnivelestud integer NOT NULL,&#xa;    idfuente integer NOT NULL,&#xa;    iddepsubdep integer NOT NULL,&#xa;    idunidadacad integer NOT NULL,&#xa;    idcategoria integer NOT NULL,&#xa;    iddedicacion integer NOT NULL,&#xa;    idescalafon integer NOT NULL,&#xa;    idfec_datos integer NOT NULL,&#xa;    idnro_cargo integer NOT NULL,&#xa;    idlicencia integer NOT NULL,&#xa;    idcaracter integer NOT NULL,&#xa;    idincentivo integer NOT NULL,&#xa;    idantiguedad integer NOT NULL,&#xa;    idedad integer NOT NULL,&#xa;    idgenero integer NOT NULL,&#xa;    idactivo integer NOT NULL,&#xa;    imp_neto double precision,&#xa;    imp_dctos double precision,&#xa;    imp_aporte double precision,&#xa;    imp_bruto double precision,&#xa;    imp_total double precision,&#xa;    idrango_neto integer DEFAULT 0 NOT NULL,&#xa;    idrango_bruto integer DEFAULT 0 NOT NULL,&#xa;    unidadgenerica_id smallint DEFAULT 0 NOT NULL&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE IF NOT EXISTS mapuche_tmp.personal_periodo_a_generar &#x28;&#xa;    idperiodo integer NOT NULL,&#xa;    anio integer NOT NULL,&#xa;    mes integer NOT NULL&#xa;&#x29;&#x3b;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dsa</connection>
