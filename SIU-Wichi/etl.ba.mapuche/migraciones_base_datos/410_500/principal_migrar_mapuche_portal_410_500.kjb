    <entry>
      <name>VACUUM</name>
      <description/>
      <type>SQL</type>
      <sql>VACUUM FULL ANALYZE mapuche_tmp.personal_d_activos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_antiguedades&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_caracteres&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_cargos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_categorias&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_dedicaciones&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_depsubdep&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_edades&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_escalafones&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_fec_datos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_fuentes&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_generos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_incentivos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_licencias&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_nivelestudio&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_periodos&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_personas&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_rangos_importes&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_d_unidadacad&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_ft_acreditaciones&#x3b;&#xa;VACUUM FULL ANALYZE mapuche_tmp.personal_periodo_a_generar&#x3b;&#xa;&#xa;</sql>
