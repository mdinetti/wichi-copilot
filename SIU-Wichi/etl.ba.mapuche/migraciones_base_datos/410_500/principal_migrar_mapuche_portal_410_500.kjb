      <yloc>200</yloc>
      </entry>
    <entry>
      <name>migrar FTs</name>
      <description/>
      <type>SQL</type>
      <sql>-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Se crea una vista para sumarizar&#x2f;agrupar todas las acreditaciones por periodo-persona.&#xa;CREATE OR REPLACE VIEW mapuche_tmp.view_personas AS &#xa; SELECT ft.idperiodo, ft.idpersona, max&#x28;ft.idnivelestud&#x29; AS idnivelestud, &#xa;     max&#x28;ft.idgenero&#x29; AS idgenero, max&#x28;ft.idedad&#x29; AS idedad, max&#x28;ft.idactivo&#x29; AS idactivo,&#xa;     &#x28;SELECT ft2.idincentivo&#xa;         FROM mapuche_tmp.personal_ft_acreditaciones ft2, mapuche_tmp.personal_d_incentivos i, mapuche.d_categoria_incentivo mi&#xa;         WHERE ft.idperiodo&#x3d;ft2.idperiodo AND ft.idpersona&#x3d;ft2.idpersona AND ft2.idincentivo&#x3d;i.idincentivo AND i.incentivo&#x3d;mi.categoria_incentivo_codigo&#xa;      ORDER BY mi.orden LIMIT 1&#x29; as idincentivo,&#xa;     sum&#x28;ft.imp_total&#x29; AS imp_total&#xa;   FROM mapuche_tmp.personal_ft_acreditaciones ft&#xa;  GROUP BY ft.idperiodo, ft.idpersona&#x3b;&#xa;-- Se insertan todos los registros en la ft de legajos del cubo.&#xa;INSERT INTO mapuche.map_dw_ft_lt_legajos &#x28;periodoinfo, persona_id, nivelestudio_id, estadocivil_id, activo_id, &#xa;					  sexo_id, sistprev_id, discapacidad_id, edad_id, cargahorariahs, &#xa;					  legajosconcargoactivo, legajosliq, fechacarga, categoria_incentivo_id,unidad_generica_id&#x29;&#xa;    SELECT DISTINCT &#x28;p.anio&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; p.mes&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date, &#xa;	cubo_l.persona_id, &#xa;	nivelestudio_id, &#xa;	-1, &#xa;	activo_id,&#xa;	sexo_id,&#xa;	-1,&#xa;	-1,&#xa;	edad_id,&#xa;	0,&#xa;	CASE WHEN a.activo&#x3d;&#x27;S&#x27; THEN 1 ELSE 0 END,&#xa;	CASE WHEN imp_total&#x3d;0 THEN 0 ELSE 1 END,&#xa;	now&#x28;&#x29;&#x3a;&#x3a;date,&#xa;	categoria_incentivo_id,&#xa;	0 --unidad generica &#xa;&#xa;    FROM mapuche_tmp.view_personas ft, &#xa;        mapuche_tmp.personal_d_periodos p, &#xa;        mapuche_tmp.personal_d_personas l, mapuche.map_dw_lt_persona cubo_l,&#xa;        mapuche.map_dw_lt_nivelestudios cubo_ne, mapuche_tmp.personal_d_nivelestudio ne,&#xa;        mapuche.map_dw_lt_activo cubo_a, &#xa;        mapuche.map_dw_lt_sexo cubo_g, mapuche_tmp.personal_d_generos g,&#xa;        mapuche.map_dw_lt_rangoedades cubo_e, mapuche_tmp.personal_d_edades e,&#xa;        mapuche_tmp.personal_d_activos a, &#xa;        mapuche.d_categoria_incentivo cubo_i, mapuche_tmp.personal_d_incentivos i     &#xa;    WHERE ft.idperiodo&#x3d;p.idperiodo AND ft.idpersona&#x3d;l.idpersona &#xa;	AND l.nro_legajo&#x3a;&#x3a;varchar&#x3d;cubo_l.legajo_id_map &#xa;	AND ft.idnivelestud&#x3d;ne.idnivelestudio &#xa;	AND CASE WHEN ne.nivelestud&#x3d;&#x27;&#x23;&#x27; THEN 0&#x3a;&#x3a;varchar ELSE ne.nivelestud END&#x3d;cubo_ne.nivelestudio_id_map &#xa;	AND cubo_a.activo_id_map&#x3d;&#x27;1&#x27; &#xa;	AND ft.idgenero&#x3d;g.idgenero AND g.genero&#x3d;cubo_g.sexo_id_map&#xa;	AND ft.idedad&#x3d;e.idedad AND cubo_e.edad&#x3d;e.edad &#xa;	AND ft.idactivo&#x3d;a.idactivo &#xa;	AND ft.idincentivo&#x3d;i.idincentivo &#xa;	AND cubo_i.categoria_incentivo_codigo&#x3d;i.incentivo &#xa;	AND &#x28;p.anio&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; p.mes&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date NOT IN &#x28;SELECT DISTINCT ft2.periodoinfo FROM mapuche.map_dw_ft_lt_legajos ft2&#x29;&#x3b;&#xa;DROP VIEW mapuche_tmp.view_personas&#x3b;&#xa;-- ------------------------&#xa;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Cargos&#xa;DELETE FROM mapuche.map_dw_ft_lt_cargos WHERE fechaalta IS NULL&#x3b;&#xa;INSERT INTO mapuche.map_dw_ft_lt_cargos &#x28;personacargo_id, periodoinfo, &#xa;                    dependenciadesign_id, categoria_id, nudo,&#xa;					estadodelcargo_id, plantacarac_id, agrupamiento_id, subrogancia_id,&#xa;					asociado_id, antiguedadescalafon_id, hsdedicacion_id, porctrabajado_id,&#xa;					porcreduccionhoraria_id, sede_id, antiguedadliq_id, fechaalta, fechabaja,&#xa;					dependenciadesemp_id, cantcargosliq, cantcargosactivos, importenetocargo,&#xa;					importebrutocargo, importegastototalcargo, fechacarga,&#xa;					rango_neto_codigo, rango_bruto_codigo, unidad_generica_id&#x29;&#xa;    SELECT DISTINCT cubo_ppc.personacargo_id, &#xa;        &#x28;p.anio&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; p.mes&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date, &#xa;        CASE &#xa;		WHEN ua.unidadacad &#x3d; &#x27;&#x23;&#x27; THEN -1&#xa;		ELSE cubo_ua.dependenciadesign_id&#xa;	END, &#xa;        max&#x28;categoria_id&#x29;, &#xa;        null, --nudo&#xa;	CASE -- &#x28;estadodelcargo_id&#x29; 0&#x3d;Baja, 1&#x3d;Activo sin Licencia, 2&#x3d;Activo con Licencia con Goce o 3&#x3d;Activo con Licencia sin Goce&#xa;	    WHEN a.activo&#x3c;&#x3e;&#x27;S&#x27; THEN &#x28;SELECT estadodelcargo_id FROM mapuche.map_dw_lt_estadodelcargo WHERE estadodelcargo_id_map&#x3d;&#x27;0&#x27;&#x29; &#xa;	    WHEN l.licencia&#x3d;&#x27;N&#x27; THEN &#x28;SELECT estadodelcargo_id FROM mapuche.map_dw_lt_estadodelcargo WHERE estadodelcargo_id_map&#x3d;&#x27;1&#x27;&#x29;&#xa;	    WHEN sum&#x28;imp_total&#x29;&#x3d;0 THEN &#x28;SELECT estadodelcargo_id FROM mapuche.map_dw_lt_estadodelcargo WHERE estadodelcargo_id_map&#x3d;&#x27;3&#x27;&#x29;&#xa;	    ELSE &#x28;SELECT estadodelcargo_id FROM mapuche.map_dw_lt_estadodelcargo WHERE estadodelcargo_id_map&#x3d;&#x27;2&#x27;&#x29;&#xa;	END,&#xa;	cubo_carac.plantacarac_id, &#xa;	-1, --agrupamiento_id&#xa;	-1, --subrogancia_id&#xa;	-1, --asociado_id &#xa;	cubo_antig.antiguedad_id, --antiguedadescalafon_id&#xa;	-1, --hsdedicacion_id &#xa;	-1, --porctrabajado_id&#xa;	-1, --porcreduccionhoraria_id &#xa;	-1, --sede_id&#xa;	cubo_antig.antiguedad_id, --antiguedadliq_id &#xa;	null&#x3a;&#x3a;date, --fechaalta&#xa;	null&#x3a;&#x3a;date, --fechabaja&#xa;	-1, --dependenciadesemp_id &#xa;	1, --cantcargosliq &#xa;	CASE --cantcargosactivos&#xa;	    WHEN a.activo&#x3c;&#x3e;&#x27;S&#x27; THEN 0&#xa;	    ELSE 1&#xa;	END, &#xa;	sum&#x28;imp_neto&#x29;, --importenetocargo&#xa;	sum&#x28;imp_bruto&#x29;, --importebrutocargo &#xa;	sum&#x28;imp_total&#x29;, --importegastototalcargo &#xa;	now&#x28;&#x29;, --fechacarga, &#xa;        CASE WHEN sum&#x28;imp_neto&#x29; &#x3c; 0 THEN&#xa;            trunc&#x28;sum&#x28;imp_neto&#x29;&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;sum&#x28;imp_neto&#x29;&#x2f;1000&#x29;&#x2a;1000&#xa; 	END,&#xa;        CASE WHEN sum&#x28;imp_bruto&#x29; &#x3c; 0 THEN&#xa;            trunc&#x28;sum&#x28;imp_bruto&#x29;&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;sum&#x28;imp_bruto&#x29;&#x2f;1000&#x29;&#x2a;1000&#xa; 	END,&#xa;	0 --unidad generica&#xa;    FROM mapuche_tmp.personal_ft_acreditaciones ft,&#xa;        mapuche_tmp.personal_d_periodos p, &#xa;        mapuche.map_dw_lt_dependenciadesig cubo_ua, mapuche_tmp.personal_d_unidadacad ua,&#xa;        mapuche.map_dw_lt_categoriascargo cubo_c, mapuche_tmp.personal_d_categorias c,&#xa;        mapuche_tmp.personal_d_activos a,&#xa;        mapuche_tmp.personal_d_licencias l,&#xa;        mapuche.map_dw_lt_tipoplantacaracter cubo_carac, mapuche_tmp.personal_d_caracteres carac,&#xa;        mapuche.map_dw_lt_antiguedad cubo_antig, mapuche_tmp.personal_d_antiguedades antig,&#xa;        mapuche.v_persona_personacargo cubo_ppc,&#xa;        mapuche_tmp.personal_d_personas pers, mapuche_tmp.personal_d_cargos carg &#xa;    WHERE ft.idperiodo&#x3d;p.idperiodo &#xa;	AND ft.idunidadacad&#x3d;ua.idunidadacad &#xa;	AND ua.unidadacad&#x3d;cubo_ua.dependenciadesign_id_map &#xa;	AND cubo_ua.vigente&#x3d;&#x27;Y&#x27; &#xa;	AND ft.idcategoria&#x3d;c.idcategoria &#xa;	AND c.categoria&#x3d;cubo_c.categoria_id_map &#xa;	AND ft.idactivo&#x3d;a.idactivo &#xa;	AND ft.idlicencia&#x3d;l.idlicencia &#xa;	AND ft.idcaracter&#x3d;carac.idcaracter &#xa;	AND carac.caracter&#x3d;tipoplanta_id_map &#xa;	AND caracter_id_map IN &#x28;&#x27;W01&#x27;, &#x27;W02&#x27;&#x29; &#xa;	AND ft.idantiguedad&#x3d;antig.idantiguedad &#xa;	AND cubo_antig.anios&#x3d;CASE WHEN antig.antiguedad &#x3e; 71 THEN 71 ELSE antig.antiguedad END &#xa;	AND ft.idpersona&#x3d;pers.idpersona &#xa;	AND pers.nro_legajo&#x3a;&#x3a;varchar&#x3d;cubo_ppc.legajo_id_map &#xa;	AND ft.idnro_cargo&#x3d;carg.idnro_cargo &#xa;	AND carg.nro_cargo&#x3a;&#x3a;varchar&#x3d;cubo_ppc.cargo_id_map &#xa;	AND &#x28;p.anio&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; p.mes&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date NOT IN &#x28;SELECT DISTINCT ft2.periodoinfo FROM mapuche.map_dw_ft_lt_cargos ft2&#x29;&#xa;    GROUP BY cubo_ppc.personacargo_id, p.anio, p.mes, a.activo, l.licencia, ua.unidadacad, dependenciadesign_id, &#xa;	cubo_carac.plantacarac_id, cubo_antig.antiguedad_id&#x3b;&#xa;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Cargos por Concepto &#x28;esta es una carga ficticia de conceptos, por eso los codigos de concepto se ponen en -1 indicando que no corresponden a ningun concepto&#x29;&#xa;-- Se genera un registro por cada imputacion que tiene cada cargo con los importes correspondientes a cada imputacion.&#xa;DELETE FROM mapuche.map_dw_ft_liqconceptosxcargos WHERE liquidacion_id &#x3d; -1&#x3b;&#xa;INSERT INTO mapuche.map_dw_ft_liqconceptosxcargos &#x28;&#xa;        liquidacion_id,&#xa;        concepto_id,&#xa;        personacargo_id,&#xa;        periodoinfo,&#xa;        imppresupcodunicosujeto_id,&#xa;        imppresupfuente_id,&#xa;        objetogasto_id,&#xa;        programa_id,&#xa;        importe_liq,&#xa;        importenetocargo,&#xa;        importebrutocargo,&#xa;        importegastototalcargo,&#xa;        importedescuentoscargo,&#xa;        importeaportescargo, &#xa;        cargosxcptosximputaciones,&#xa;		unidad_generica_id,&#xa;        fechacarga&#x29;&#xa;    SELECT DISTINCT &#xa;        -1,                         -- liquidacion_id&#xa;        -1,                         -- concepto_id&#xa;        cubo_ppc.personacargo_id, &#xa;        &#x28;p.anio&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; p.mes&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date, &#xa;        mdsd.imppresupsubdependencia_id, -- imppresupcodunicosujeto_id&#xa;        cubo_f.imppresupfuente_id,  -- impresupfuente_id&#xa;        -1,                         -- objetogasto_id&#xa;        -1,                         -- programa_id&#xa;	    CASE                       -- importe_liq &#xa;	        WHEN sum&#x28;imp_total&#x29; &#x3e; 0 THEN  sum&#x28;imp_total&#x29;&#xa;	        WHEN sum&#x28;imp_bruto&#x29; &#x3e; 0 THEN  sum&#x28;imp_bruto&#x29;&#xa;	        WHEN sum&#x28;imp_neto&#x29;  &#x3c; 0 THEN -sum&#x28;imp_neto&#x29;&#xa;	        ELSE 0&#xa;	    END,&#xa;	    sum&#x28;imp_neto&#x29;,              --importenetocargo&#xa;	    sum&#x28;imp_bruto&#x29;,             --importebrutocargo &#xa;	    sum&#x28;imp_total&#x29;,             --importegastototalcargo &#xa;        sum&#x28;imp_dctos&#x29;, -- importedescuentoscargo  -- mapuche_tmp.personal_ft_acreditaciones.imp_dctos --&#x3e; mapuche.map_dw_ft_liqconceptosxcargos.importedescuentoscargo&#xa;        sum&#x28;imp_aporte&#x29;, -- importeaportescargo    -- mapuche_tmp.personal_ft_acreditaciones.imp_aporte --&#x3e; mapuche.map_dw_ft_liqconceptosxcargos.importeaportescargo	    &#xa;        1,                          -- cargosxcptosximputaciones&#xa;		0,  --unidad generica&#xa;	    now&#x28;&#x29;                       -- fechacarga, &#xa;    FROM mapuche_tmp.personal_ft_acreditaciones ft,&#xa;        mapuche_tmp.personal_d_periodos p, &#xa;        mapuche.map_dw_lt_imppresupfuentes cubo_f, mapuche_tmp.personal_d_fuentes f,&#xa;        mapuche.v_persona_personacargo cubo_ppc, mapuche_tmp.personal_d_personas pers, mapuche_tmp.personal_d_cargos carg, &#xa;        mapuche_tmp.personal_d_depsubdep dsd, mapuche.map_dw_lt_imppresupsubdependencia mdsd&#xa;    WHERE ft.idperiodo&#x3d;p.idperiodo AND &#xa;        ft.idfuente&#x3d;f.idfuente AND f.codigofuente&#x3a;&#x3a;text&#x3d;cubo_f.imppresupfuente_id_map AND&#xa;        ft.idpersona&#x3d;pers.idpersona AND pers.nro_legajo&#x3a;&#x3a;varchar&#x3d;cubo_ppc.legajo_id_map AND ft.idnro_cargo&#x3d;carg.idnro_cargo AND&#xa;        carg.nro_cargo&#x3a;&#x3a;varchar&#x3d;cubo_ppc.cargo_id_map AND&#xa;        &#x28;p.anio&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-&#x27; &#x7c;&#x7c; p.mes&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;-01&#x27;&#x29;&#x3a;&#x3a;date NOT IN &#x28;SELECT DISTINCT ft2.periodoinfo FROM mapuche.map_dw_ft_liqconceptosxcargos ft2&#x29; AND&#xa;        ft.iddepsubdep &#x3d; dsd.iddepsubdep AND lpad&#x28;dsd.dependen&#x3a;&#x3a;varchar, 2, &#x27;0&#x27;&#x29; &#x7c;&#x7c; lpad&#x28;dsd.subdepen&#x3a;&#x3a;varchar,3,&#x27;0&#x27;&#x29; &#x3d; mdsd.imppresupsubdependencia_id_map&#xa;    GROUP BY cubo_ppc.personacargo_id, p.anio, p.mes, mdsd.imppresupsubdependencia_id, cubo_f.imppresupfuente_id&#x3b;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>828</xloc>
      <yloc>77</yloc>
      </entry>
