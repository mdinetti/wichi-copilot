    <entry>
      <name>migrar Dimensiones</name>
      <description/>
      <type>SQL</type>
      <sql>--map_dw_lt_estadodelcargo&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;estadodelcargo_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;estadodelcargo_id&#x29; END FROM mapuche.map_dw_lt_estadodelcargo&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_estadodelcargo ALTER COLUMN estadodelcargo_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_estadodelcargo &#x28;estadodelcargo_id_map, estadodelcargo_desc, cargoactivo_id_map, cargoactivo_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT &#x27;0&#x27;, &#x27;Cargo dado de baja&#x27;, &#x27;N&#x27;, &#x27;No activo&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29;  WHERE &#x27;0&#x27; NOT IN &#x28;SELECT distinct estadodelcargo_id_map FROM mapuche.map_dw_lt_estadodelcargo&#x29;&#x3b;&#xa;INSERT INTO mapuche.map_dw_lt_estadodelcargo &#x28;estadodelcargo_id_map, estadodelcargo_desc, cargoactivo_id_map, cargoactivo_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT &#x27;1&#x27;, &#x27;Cargo activo sin licencia&#x27;, &#x27;S&#x27;, &#x27;Activo&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29;  WHERE &#x27;1&#x27; NOT IN &#x28;SELECT distinct estadodelcargo_id_map FROM mapuche.map_dw_lt_estadodelcargo&#x29;&#x3b;&#xa;INSERT INTO mapuche.map_dw_lt_estadodelcargo &#x28;estadodelcargo_id_map, estadodelcargo_desc, cargoactivo_id_map, cargoactivo_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT &#x27;2&#x27;, &#x27;Cargo activo con licencia con goce de sueldo&#x27;, &#x27;S&#x27;, &#x27;Activo&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29;  WHERE &#x27;2&#x27; NOT IN &#x28;SELECT distinct estadodelcargo_id_map FROM mapuche.map_dw_lt_estadodelcargo&#x29;&#x3b;&#xa;INSERT INTO mapuche.map_dw_lt_estadodelcargo &#x28;estadodelcargo_id_map, estadodelcargo_desc, cargoactivo_id_map, cargoactivo_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT &#x27;3&#x27;, &#x27;Cargo activo con licencia sin goce de sueldo&#x27;, &#x27;S&#x27;, &#x27;Activo&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;,1,&#x27;Y&#x27;,now&#x28;&#x29;  WHERE &#x27;3&#x27; NOT IN &#x28;SELECT distinct estadodelcargo_id_map FROM mapuche.map_dw_lt_estadodelcargo&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_estadodelcargo ALTER COLUMN estadodelcargo_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;&#xa;-- Antiguedad &#x28;expresada en anios&#x29;, vamos a tomar un maximo de 71 anios&#xa;-- asignar en la ft el id que corresponda&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;antiguedad_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;antiguedad_id&#x29; END FROM mapuche.map_dw_lt_antiguedad&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_antiguedad ALTER COLUMN antiguedad_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_antiguedad &#x28;rangoantiguedad_desc, anios, fechadesde, fechahasta, version, vigente, fechaact&#x29; &#xa;    SELECT CASE &#xa;              WHEN antiguedad &#x3c; 1 THEN &#x27;Menos de 1&#x27;&#xa;              WHEN antiguedad &#x3c; 6 THEN &#x27;De 1 a 5&#x27;&#xa;              WHEN antiguedad &#x3c; 11 THEN &#x27;De 6 a 10&#x27;&#xa;              WHEN antiguedad &#x3c; 16 THEN &#x27;De 11 a 15&#x27;&#xa;              WHEN antiguedad &#x3c; 21 THEN &#x27;De 16 a 20&#x27;&#xa;              WHEN antiguedad &#x3c; 26 THEN &#x27;De 21 a 25&#x27;&#xa;              ELSE &#x27;M&#xe1;s de 25&#x27; &#xa;           END as rangoantiguedad_desc,&#xa;           antiguedad as anios,  now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;           FROM mapuche_tmp.personal_d_antiguedades &#xa;           WHERE antiguedad &#x3c; 71 AND &#xa;           antiguedad NOT IN &#x28;SELECT distinct anios FROM mapuche.map_dw_lt_antiguedad&#x29;&#xa;    UNION&#xa;    SELECT &#x27;M&#xe1;s de 25&#x27;, 71 ,  now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; WHERE 71 NOT IN &#x28;SELECT distinct anios FROM mapuche.map_dw_lt_antiguedad&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_antiguedad ALTER COLUMN antiguedad_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;&#xa;-- Categorias y escalafones&#xa;-- Se homogeinizan los nombres &#x28;descripciones&#x29; de los escalafones para que luego al agregarlos no generen dos filas distintas en los reportes&#xa;UPDATE mapuche_tmp.personal_d_escalafones&#xa;  SET nombre &#x3d; &#x28;SELECT escalafon_desc FROM mapuche.map_dw_lt_categoriascargo WHERE escalafon&#x3d;escalafon_id_map LIMIT 1&#x29;&#xa;  WHERE escalafon IN &#x28;SELECT escalafon_id_map FROM mapuche.map_dw_lt_categoriascargo&#x29;&#x3b;&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;categoria_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;categoria_id&#x29; END FROM mapuche.map_dw_lt_categoriascargo&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_categoriascargo ALTER COLUMN categoria_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_categoriascargo &#x28;categoria_id_map, categoria_desc, escalafon_id_map, escalafon_desc,&#xa;	dedicacion_id_map, dedicacion_desc, estadolaboral_id_map, estadolaboral_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT DISTINCT c.categoria, c.nombre, e.escalafon, e.nombre, d.dedicacion, d.nombre, &#x27;W&#x27;, &#x27;Importado de Wichi&#x27; , now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;        FROM mapuche_tmp.personal_ft_acreditaciones a, mapuche_tmp.personal_d_categorias c, mapuche_tmp.personal_d_dedicaciones d, mapuche_tmp.personal_d_escalafones e&#xa;    WHERE a.idcategoria&#x3d;c.idcategoria AND a.iddedicacion&#x3d;d.iddedicacion AND a.idescalafon&#x3d;e.idescalafon AND&#xa;        categoria NOT IN &#x28;SELECT categoria_id_map FROM mapuche.map_dw_lt_categoriascargo&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_categoriascargo ALTER COLUMN categoria_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;&#xa;-- Dependencias &#x28;map_dw_lt_dependenciadesig  y map_dw_lt_dependenciadesemp&#x29; en wichi &#x28;personal_d_unidadacad&#x29;&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;dependenciadesign_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;dependenciadesign_id&#x29; END FROM mapuche.map_dw_lt_dependenciadesig&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_dependenciadesig ALTER COLUMN dependenciadesign_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_dependenciadesig &#x28;dependenciadesign_id_map, dependenciadesign_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT unidadacad, nombre, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;        FROM mapuche_tmp.personal_d_unidadacad &#xa;        WHERE unidadacad &#x3c;&#x3e; &#x27;&#x23;&#x27; AND unidadacad NOT IN &#x28;SELECT dependenciadesign_id_map FROM mapuche.map_dw_lt_dependenciadesig WHERE vigente&#x3d;&#x27;Y&#x27;&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_dependenciadesig ALTER COLUMN dependenciadesign_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;&#xa;-- Fuentes &#x28;map_dw_lt_imppresupfuentes&#x29; en wichi &#x28;personal_d_fuentes&#x29;&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;imppresupfuente_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;imppresupfuente_id&#x29; END FROM mapuche.map_dw_lt_imppresupfuentes&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_imppresupfuentes ALTER COLUMN imppresupfuente_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_imppresupfuentes &#x28;imppresupfuente_id_map, imppresupfuente_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT codigofuente&#x3a;&#x3a;varchar, descfuente , now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; FROM mapuche_tmp.personal_d_fuentes&#xa;        WHERE codigofuente&#x3a;&#x3a;varchar NOT IN &#x28;SELECT imppresupfuente_id_map FROM mapuche.map_dw_lt_imppresupfuentes&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_imppresupfuentes ALTER COLUMN imppresupfuente_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;&#xa;-- Dependencias y Subdependencias de Imputacion Presupuestaria &#x28;map_dw_lt_imppresupsubdependencia&#x29; en wichi &#x28;personal_d_depsubdep&#x29;&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;imppresupsubdependencia_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;imppresupsubdependencia_id&#x29; END FROM mapuche.map_dw_lt_imppresupsubdependencia&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_imppresupsubdependencia ALTER COLUMN imppresupsubdependencia_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_imppresupsubdependencia &#x28;imppresupsubdependencia_id_map, imppresupsubdependencia_desc, imppresupdependencia_id_map, imppresupdependencia_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;   select imppresupsubdependencia_codigo&#xa;	, subdepen_nombre&#xa;	, dependen_nombre&#xa;	, nombre&#xa;	, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;from &#xa;&#x28;&#xa;SELECT lpad&#x28;dependen&#x3a;&#x3a;varchar, 2, &#x27;0&#x27;&#x29; &#x7c;&#x7c; lpad&#x28;subdepen&#x3a;&#x3a;varchar,3,&#x27;0&#x27;&#x29; as imppresupsubdependencia_codigo, &#xa;anoperiodo,&#xa;subdepen,&#xa;CASE WHEN subdepen&#x3d;0 THEN &#x27;Sin Subdependencia&#x27; ELSE nombre END as subdepen_nombre,&#xa;dependen&#x3a;&#x3a;varchar as dependen_nombre,&#xa;CASE WHEN subdepen&#x3d;0 THEN nombre ELSE NULL END as nombre&#xa;FROM mapuche_tmp.personal_d_depsubdep&#xa;WHERE lpad&#x28;dependen&#x3a;&#x3a;varchar, 2, &#x27;0&#x27;&#x29; &#x7c;&#x7c; lpad&#x28;subdepen&#x3a;&#x3a;varchar,3,&#x27;0&#x27;&#x29; NOT IN &#x28;SELECT imppresupsubdependencia_id_map FROM mapuche.map_dw_lt_imppresupsubdependencia&#x29;&#xa;&#x29;a &#xa;where &#x28;lpad&#x28;a.dependen_nombre&#x3a;&#x3a;varchar, 2, &#x27;0&#x27;&#x29; &#x7c;&#x7c; lpad&#x28;a.subdepen&#x3a;&#x3a;varchar,3,&#x27;0&#x27;&#x29;, a.anoperiodo&#x29; IN &#x28;select lpad&#x28;dependen&#x3a;&#x3a;varchar, 2, &#x27;0&#x27;&#x29; &#x7c;&#x7c; lpad&#x28;subdepen&#x3a;&#x3a;varchar,3,&#x27;0&#x27;&#x29;,max&#x28;anoperiodo&#x29; from  mapuche_tmp.personal_d_depsubdep group by 1&#x29;&#x3b;&#xa;UPDATE mapuche.map_dw_lt_imppresupsubdependencia modif&#xa;    SET imppresupdependencia_desc &#x3d; &#x28;SELECT imppresupdependencia_desc FROM mapuche.map_dw_lt_imppresupsubdependencia dato&#xa;                                         WHERE modif.imppresupdependencia_id_map&#x3d;dato.imppresupdependencia_id_map ORDER BY imppresupsubdependencia_id_map LIMIT 1&#x29;&#xa;    WHERE imppresupdependencia_desc IS NULL&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_imppresupsubdependencia ALTER COLUMN imppresupsubdependencia_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Niveles de Estudio &#x28;map_dw_lt_nivelestudios&#x29; en wichi &#x28;personal_d_nivelestudio&#x29;&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;nivelestudio_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;nivelestudio_id&#x29; END FROM mapuche.map_dw_lt_nivelestudios&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_nivelestudios ALTER COLUMN nivelestudio_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_nivelestudios &#x28;nivelestudio_id_map, nivelestudio_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT nivelestud, nombre , now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; &#xa;        FROM mapuche_tmp.personal_d_nivelestudio &#xa;        WHERE nivelestud &#x3c;&#x3e; &#x27;&#x23;&#x27; AND nivelestud NOT IN &#x28;SELECT nivelestudio_id_map FROM mapuche.map_dw_lt_nivelestudios&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_nivelestudios ALTER COLUMN nivelestudio_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Inserta los dos valores por defecto en nivel de estudio&#xa;-- En mapuche el codigo para vacio es &#x27;&#x23;&#x27;&#xa;INSERT INTO mapuche.map_dw_lt_nivelestudios &#xa;	&#x28;nivelestudio_id, nivelestudio_id_map, nivelestudio_desc,  fechadesde, fechahasta, version,  vigente, fechaact &#x29;&#xa;SELECT -1,&#x27;-1&#x27;,&#x27;VALOR ERRONEO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;WHERE &#x27;-1&#x27; NOT IN &#x28;SELECT nivelestudio_id_map FROM mapuche.map_dw_lt_nivelestudios&#x29;&#x3b;&#xa;INSERT INTO mapuche.map_dw_lt_nivelestudios &#xa;	&#x28;nivelestudio_id, nivelestudio_id_map, nivelestudio_desc,  fechadesde, fechahasta, version,  vigente, fechaact &#x29;&#xa;SELECT 0,&#x27;0&#x27;,&#x27;VACIO&#x2f;NULO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;WHERE &#x27;0&#x27; NOT IN &#x28;SELECT nivelestudio_id_map FROM mapuche.map_dw_lt_nivelestudios&#x29;&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;&#xa;-- Personas &#x28;map_dw_lt_persona&#x29; en wichi &#x28;personal_d_personas&#x29;&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;persona_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;persona_id&#x29; END FROM mapuche.map_dw_lt_persona&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_persona ALTER COLUMN persona_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_persona &#x28;legajo_id_map, letra, apellido, nombre, apellidonombre_desc, fecha_nacimiento, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT nro_legajo&#x3a;&#x3a;varchar,&#xa;        substring&#x28;upper&#x28;trim&#x28;apyno&#x29;&#x29; from 1 for 1&#x29;, &#xa;        substring&#x28;upper&#x28;trim&#x28;apyno&#x29;&#x29; from 1 for position&#x28;&#x27;,&#x27; in trim&#x28;apyno&#x29;&#x29;-1&#x29;, &#xa;        substring&#x28;upper&#x28;trim&#x28;apyno&#x29;&#x29; from position&#x28;&#x27;,&#x27; in trim&#x28;apyno&#x29;&#x29;&#x2b;1&#x29;,&#xa;	    upper&#x28;trim&#x28;apyno&#x29;&#x29; &#x7c;&#x7c; &#x27; &#x28;&#x27;&#x7c;&#x7c; nro_legajo&#x3a;&#x3a;varchar &#x7c;&#x7c; &#x27;&#x29;&#x27;, &#xa;	    fec_nacim,&#xa;	    now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;        FROM mapuche_tmp.personal_d_personas &#xa;        WHERE nro_legajo&#x3a;&#x3a;varchar NOT IN &#x28;SELECT legajo_id_map FROM mapuche.map_dw_lt_persona&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_persona ALTER COLUMN persona_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Edad &#x28;expresada en anios&#x29;, tabla map_dw_lt_rangoedades que en wichi es personal_d_edades&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;edad_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;edad_id&#x29; END FROM mapuche.map_dw_lt_rangoedades&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_rangoedades ALTER COLUMN edad_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_rangoedades &#x28;rangoedad_desc, edad, fechadesde, fechahasta, version, vigente, fechaact&#x29; &#xa;    SELECT CASE &#xa;              WHEN edad &#x3c; 18 THEN &#x27;Menos de 18&#x27;&#xa;              WHEN edad &#x3c; 31 THEN &#x27;De 18 a 30&#x27;&#xa;              WHEN edad &#x3c; 41 THEN &#x27;De 31 a 40&#x27;&#xa;              WHEN edad &#x3c; 51 THEN &#x27;De 41 a 50&#x27;&#xa;              WHEN edad &#x3c; 61 THEN &#x27;De 51 a 60&#x27;&#xa;              WHEN edad &#x3c; 66 THEN &#x27;De 61 a 65&#x27;&#xa;              ELSE &#x27;M&#xe1;s de 65&#x27; &#xa;           END as rangoedad_desc,&#xa;           edad,&#xa;           now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;           FROM mapuche_tmp.personal_d_edades &#xa;           WHERE edad NOT IN &#x28;SELECT distinct edad FROM mapuche.map_dw_lt_rangoedades&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_rangoedades ALTER COLUMN edad_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Tipo Planta y Caracter &#x28;el wichi solo tiene tipo de planta&#x29;, tabla map_dw_lt_tipoplantacaracter que en wichi es personal_d_caracteres&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;plantacarac_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;plantacarac_id&#x29; END FROM mapuche.map_dw_lt_tipoplantacaracter&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_tipoplantacaracter ALTER COLUMN plantacarac_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_tipoplantacaracter &#x28;tipoplanta_id_map, tipoplanta_desc, caracter_id_map, caracter_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;  &#xa;    SELECT &#x27;P&#x27;, &#x27;Planta Permanente&#x27;, &#x27;W01&#x27;, &#x27;Permanente importado de Wichi.&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;    WHERE &#x27;W01&#x27; NOT IN &#x28;SELECT distinct caracter_id_map FROM mapuche.map_dw_lt_tipoplantacaracter&#x29;&#x3b;&#xa;INSERT INTO mapuche.map_dw_lt_tipoplantacaracter &#x28;tipoplanta_id_map, tipoplanta_desc, caracter_id_map, caracter_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;  &#xa;    SELECT &#x27;T&#x27;, &#x27;Planta Transitoria&#x27;, &#x27;W02&#x27;, &#x27;Transitorio importado de Wichi.&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;    WHERE &#x27;W02&#x27; NOT IN &#x28;SELECT distinct caracter_id_map FROM mapuche.map_dw_lt_tipoplantacaracter&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_tipoplantacaracter ALTER COLUMN plantacarac_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;&#xa;--incentivos&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;categoria_incentivo_id&#x29;&#x3d;-1 THEN 1 WHEN max&#x28;categoria_incentivo_id&#x29;&#x3d;0 THEN 1 ELSE max&#x28;categoria_incentivo_id&#x29; END FROM mapuche.d_categoria_incentivo&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.d_categoria_incentivo ALTER COLUMN categoria_incentivo_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.d_categoria_incentivo &#x28;categoria_incentivo_codigo, categoria_incentivo_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT incentivo, descincentivo , now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;        FROM mapuche_tmp.personal_d_incentivos &#xa;        WHERE incentivo NOT IN &#x28;SELECT categoria_incentivo_codigo FROM mapuche.d_categoria_incentivo&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.d_categoria_incentivo ALTER COLUMN categoria_incentivo_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;-- Se insertan los valores de orden &#xa;--UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;99&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;1 WHERE categoria_incentivo_codigo&#x3d;&#x27;1&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;2 WHERE categoria_incentivo_codigo&#x3d;&#x27;A&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;3 WHERE categoria_incentivo_codigo&#x3d;&#x27;2&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;4 WHERE categoria_incentivo_codigo&#x3d;&#x27;B&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;5 WHERE categoria_incentivo_codigo&#x3d;&#x27;3&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;6 WHERE categoria_incentivo_codigo&#x3d;&#x27;C&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;7 WHERE categoria_incentivo_codigo&#x3d;&#x27;4&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;8 WHERE categoria_incentivo_codigo&#x3d;&#x27;D&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;9 WHERE categoria_incentivo_codigo&#x3d;&#x27;5&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;10 WHERE categoria_incentivo_codigo&#x3d;&#x27;E&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;11 WHERE categoria_incentivo_codigo&#x3d;&#x27;I&#x27;&#x3b;&#xa;UPDATE mapuche.d_categoria_incentivo SET orden&#x3d;12 WHERE categoria_incentivo_codigo&#x3d;&#x27; &#x27;&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;&#xa;--d_rango_importes&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.d_rango_importes &#x28;rango_importes_codigo, rango_importes_cincomil_desc, rango_importes_mil_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT -1, &#x27;VALOR ERRONEO&#x27;, &#x27;VALOR ERRONEO&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;    WHERE -1 NOT IN &#x28;SELECT DISTINCT rango_importes_codigo FROM mapuche.d_rango_importes&#x29;&#x3b;&#xa;INSERT INTO mapuche.d_rango_importes &#x28;rango_importes_codigo, rango_importes_cincomil_desc, rango_importes_mil_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT DISTINCT &#xa;        CASE WHEN imp_neto &#x3c; 0 THEN&#xa;            trunc&#x28;imp_neto&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;imp_neto&#x2f;1000&#x29;&#x2a;1000&#xa;	END,&#xa;        CASE WHEN imp_neto &#x3c; 0 THEN&#xa;	    &#x28;trunc&#x28;imp_neto&#x2f;5000&#x29;&#x2a;5000-5000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;imp_neto&#x2f;5000&#x29;&#x2a;5000&#x29;&#x3a;&#x3a;text &#xa;        ELSE&#xa;	    &#x28;trunc&#x28;imp_neto&#x2f;5000&#x29;&#x2a;5000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;imp_neto&#x2f;5000&#x29;&#x2a;5000&#x2b;5000&#x29;&#x3a;&#x3a;text&#xa;	END,&#xa;        CASE WHEN imp_neto &#x3c; 0 THEN&#xa;	    &#x28;trunc&#x28;imp_neto&#x2f;1000&#x29;&#x2a;1000-1000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;imp_neto&#x2f;1000&#x29;&#x2a;1000&#x29;&#x3a;&#x3a;text&#xa;        ELSE&#xa;	    &#x28;trunc&#x28;imp_neto&#x2f;1000&#x29;&#x2a;1000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;imp_neto&#x2f;1000&#x29;&#x2a;1000&#x2b;1000&#x29;&#x3a;&#x3a;text&#xa;	END&#xa;	, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;        FROM mapuche_tmp.personal_ft_acreditaciones ft&#xa;        WHERE&#xa;        CASE WHEN imp_neto &#x3c; 0 THEN&#xa;            trunc&#x28;imp_neto&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;imp_neto&#x2f;1000&#x29;&#x2a;1000&#xa;	    END      &#xa;        NOT IN &#x28;SELECT rango_importes_codigo FROM mapuche.d_rango_importes&#x29;&#xa;        GROUP BY imp_neto order by 1&#x3b;&#xa;INSERT INTO mapuche.d_rango_importes &#x28;rango_importes_codigo, rango_importes_cincomil_desc, rango_importes_mil_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT DISTINCT &#xa;        CASE WHEN imp_bruto &#x3c; 0 THEN&#xa;            trunc&#x28;imp_bruto&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;imp_bruto&#x2f;1000&#x29;&#x2a;1000&#xa;	END,&#xa;        CASE WHEN imp_bruto &#x3c; 0 THEN&#xa;	    &#x28;trunc&#x28;imp_bruto&#x2f;5000&#x29;&#x2a;5000-5000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;imp_bruto&#x2f;5000&#x29;&#x2a;5000&#x29;&#x3a;&#x3a;text &#xa;        ELSE&#xa;	    &#x28;trunc&#x28;imp_bruto&#x2f;5000&#x29;&#x2a;5000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;imp_bruto&#x2f;5000&#x29;&#x2a;5000&#x2b;5000&#x29;&#x3a;&#x3a;text&#xa;	END,&#xa;        CASE WHEN imp_bruto &#x3c; 0 THEN&#xa;	    &#x28;trunc&#x28;imp_bruto&#x2f;1000&#x29;&#x2a;1000-1000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;imp_bruto&#x2f;1000&#x29;&#x2a;1000&#x29;&#x3a;&#x3a;text&#xa;        ELSE&#xa;	    &#x28;trunc&#x28;imp_bruto&#x2f;1000&#x29;&#x2a;1000&#x29;&#x3a;&#x3a;text &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; &#x28;trunc&#x28;imp_bruto&#x2f;1000&#x29;&#x2a;1000&#x2b;1000&#x29;&#x3a;&#x3a;text&#xa;	END&#xa;	, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;        FROM mapuche_tmp.personal_ft_acreditaciones ft&#xa;        WHERE &#xa;        CASE WHEN imp_bruto &#x3c; 0 THEN&#xa;            trunc&#x28;imp_bruto&#x2f;1000&#x29;&#x2a;1000-1000&#xa;        ELSE&#xa;            trunc&#x28;imp_bruto&#x2f;1000&#x29;&#x2a;1000&#xa;	    END      &#xa;        NOT IN &#x28;SELECT rango_importes_codigo FROM mapuche.d_rango_importes&#x29;&#xa;        GROUP BY imp_bruto order by 1&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;-- Persona-Cargo&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;personacargo_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;personacargo_id&#x29; END FROM mapuche.map_dw_lt_personacargo&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_personacargo ALTER COLUMN personacargo_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_personacargo &#x28;persona_id, cargo_id_map, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT DISTINCT cubo_p.persona_id, c.nro_cargo , now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#xa;        FROM mapuche_tmp.personal_ft_acreditaciones ft, mapuche.map_dw_lt_persona cubo_p, mapuche_tmp.personal_d_personas p, mapuche_tmp.personal_d_cargos c &#xa;        WHERE ft.idpersona&#x3d;p.idpersona AND p.nro_legajo&#x3a;&#x3a;varchar&#x3d;cubo_p.legajo_id_map AND&#xa;            ft.idnro_cargo&#x3d;c.idnro_cargo AND&#xa;            &#x28;cubo_p.persona_id, c.nro_cargo&#x3a;&#x3a;varchar&#x29; NOT IN &#x28;SELECT persona_id, cargo_id_map FROM mapuche.map_dw_lt_personacargo&#x29;&#x3b;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_personacargo ALTER COLUMN personacargo_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;-- ---------------------------------------------------------------------------------------------------------------------------------------------&#xa;&#xa;-- activo &#x28;map_dw_lt_activo&#x29;&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;activo_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;activo_id&#x29; END FROM mapuche.map_dw_lt_activo&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_activo ALTER COLUMN activo_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;DELETE FROM mapuche.map_dw_lt_activo WHERE activo_id_map IN &#x28;&#x27;0&#x27;,&#x27;1&#x27;&#x29;&#x3b;&#xa;INSERT INTO mapuche.map_dw_lt_activo &#x28;activo_id_map, activo_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT &#x27;0&#x27;,&#x27;Jubilado&#x27;,now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#x3b;&#xa;INSERT INTO mapuche.map_dw_lt_activo &#x28;activo_id_map, activo_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;    SELECT &#x27;1&#x27;,&#x27;Activo&#x27;,now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#x3b;&#xa;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_activo ALTER COLUMN activo_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;&#xa;-- Sexo&#xa;-- Crear el serial&#xa;CREATE SEQUENCE id_wichi_seq&#x3b;&#xa;SELECT setval&#x28;&#x27;id_wichi_seq&#x27;, &#x28;SELECT CASE WHEN max&#x28;sexo_id&#x29;&#x3d;-1 THEN 1 ELSE max&#x28;sexo_id&#x29; END FROM mapuche.map_dw_lt_sexo&#x29;&#x29;&#x3b;&#xa;ALTER TABLE mapuche.map_dw_lt_sexo ALTER COLUMN sexo_id SET DEFAULT nextval&#x28;&#x27;id_wichi_seq&#x27;&#x3a;&#x3a;regclass&#x29;&#x3b;&#xa;-- Insertar los datos faltantes&#xa;INSERT INTO mapuche.map_dw_lt_sexo &#x28;sexo_id_map, sexo_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;SELECT genero, descgenero , now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29; FROM mapuche_tmp.personal_d_generos&#xa;        WHERE genero NOT IN &#x28;SELECT sexo_id_map FROM mapuche.map_dw_lt_sexo&#x29;&#x3b;&#xa;        &#xa;DELETE FROM mapuche.map_dw_lt_sexo WHERE sexo_id_map &#x3d; &#x27;-1&#x27;&#x3b;&#xa;INSERT INTO mapuche.map_dw_lt_sexo VALUES &#x28;-1,&#x27;-1&#x27;,&#x27;Valor err&#xf3;neo o nulo&#x27;, now&#x28;&#x29;&#x3a;&#x3a;date,&#x27;2199-12-31&#x27;&#x3a;&#x3a;date,1,&#x27;Y&#x27;,now&#x28;&#x29;&#x29;&#x3b;&#xa;&#xa;-- Eliminar el default&#xa;ALTER TABLE mapuche.map_dw_lt_sexo ALTER COLUMN sexo_id DROP DEFAULT&#x3b;&#xa;DROP SEQUENCE id_wichi_seq&#x3b;&#xa;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
