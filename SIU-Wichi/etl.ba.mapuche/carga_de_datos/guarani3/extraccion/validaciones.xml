<?xml version="1.0" encoding="UTF-8" ?>

<!--

Este xml especifica validaciones a realizar
en la carga de datos a Wichi. Si no se cumple alguna
de las validaciones significa que los datos son
inválidos o que el extractor o importador es
inadecuado.

Mantener una copia de este archivo en los
exportadores y otra en los importadores, para poder
controlar que al actualizar una se actualice la otra.

-->


<validaciones id="validacionesG3v6"> <!-- el id debe cambiar con cualquier cambio en este xml -->
	<sistemaFuente>
		<codigo>10</codigo> <!-- el código del sistema fuente según estándares wichi -->
		<nombre>guarani3</nombre> <!-- valor permitido para el nombre del sistema fuente, sin el número de versión -->
		<obtencionDeSistema> <!-- cómo saber cuál es el sistema fuente (nombre sin versión) -->
			<sql><![CDATA[
                            select (case when(
                                    select count(distinct(table_name))
                                    from information_schema.tables
                                    where table_schema in ('negocio', 'guarani')
                                    and table_name in (
                                      'sga_alumnos',
                                      'sga_catedras_equivalentes',
                                      'sga_comisiones',
                                      'sga_condiciones',
                                      'sga_niveles_formacion')
                            ) = 5 then 'guarani3' else 'otra' end) as sistema
			]]>
			</sql>
		</obtencionDeSistema>
	</sistemaFuente>
	<versionSistemaFuente>
		<versionesAceptadas> <!-- versiones del sistema fuente que pasan la validación -->
			<version>^3\.11\..*$</version>
			<version>^3\.12\..*$</version>
			<version>^3\.13\..*$</version>
			<version>^3\.14\..*$</version>
			<version>^3\.15\..*$</version>
			<version>^3\.16\..*$</version>
			<version>^3\.17\..*$</version>
			<version>^3\.18\..*$</version>
			<version>^3\.19\..*$</version>
			<version>^3\.20\.0$</version>
			<version>^3\.20\.1$</version>
			<version>^3\.21\.0$</version>
			<version>^3\.22\.0$</version>
		</versionesAceptadas>
		<versionesNoAceptadas> <!-- versiones del sistema fuente que NO pasan la validación -->
			<version>^0\..*</version>
			<version>^1\..*</version>
			<version>^2\..*</version>
			<version>^3\.0\..*$</version>
			<version>^3\.1\..*$</version>
			<version>^3\.2\..*$</version>
			<version>^3\.3\..*$</version>
			<version>^3\.4\..*$</version>
			<version>^3\.5\..*$</version>
			<version>^3\.6\..*$</version>
			<version>^3\.7\..*$</version>
			<version>^3\.8\..*$</version>
			<version>^3\.9\..*$</version>
			<version>^3\.10\..*$</version>
		</versionesNoAceptadas>
		<obtencionDeVersion> <!-- cómo saber cuál es la versión del sistema fuente -->
			<sql><![CDATA[
                                select version_app as "version"
                                from ${esquema_guarani}.app_versiones
                                where fecha_actualizacion = 
                                (select max(fecha_actualizacion) from ${esquema_guarani}.app_versiones)
			]]>
			</sql>
		</obtencionDeVersion>
	</versionSistemaFuente>
