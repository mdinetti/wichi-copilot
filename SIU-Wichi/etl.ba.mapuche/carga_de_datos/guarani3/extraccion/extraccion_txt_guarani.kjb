   vFecha := COALESCE(pFecha, CURRENT_DATE);
   _tecno := '';
   
   SELECT dato_censal_act INTO iDatoCensal
   	 FROM his_datos_censales, his_datos_actividades
	WHERE his_datos_censales.persona = pPersona
	  AND his_datos_actividades.dato_censal = his_datos_censales.dato_censal
      AND DATE(his_datos_actividades.fecha_alta) &lt;= vFecha
	ORDER BY his_datos_actividades.fecha_alta DESC
   LIMIT 1;
   
   IF iDatoCensal IS NULL THEN
     -- Busco el dato censal mas proximo siguiente a la fecha.
     SELECT dato_censal_act INTO iDatoCensal
   	   FROM his_datos_censales, his_datos_actividades
	  WHERE his_datos_censales.persona = pPersona
	    AND his_datos_actividades.dato_censal = his_datos_censales.dato_censal
        AND DATE(his_datos_actividades.fecha_alta) > vFecha
	  ORDER BY his_datos_actividades.fecha_alta DESC  
     LIMIT 1;
   END IF;

   IF iDatoCensal IS NOT NULL THEN   
	SELECT  CASE WHEN tecnologia_pc_casa = 'S' THEN 'casa-' ELSE '' END 
	|| CASE WHEN tecnologia_pc_trabajo = 'S' THEN 'trabajo-' ELSE '' END 
	|| CASE WHEN tecnologia_pc_universidad = 'S' THEN 'universidad-' ELSE '' END 
	|| CASE WHEN tecnologia_pc_otro_lugar = 'S' THEN 'otro-' ELSE '' END 
	INTO _tecno FROM his_datos_actividades WHERE his_datos_actividades.dato_censal_act = iDatoCensal;
END IF;

  -- Retorno el id del Dato Censal de actividad
  Return _tecno;
	
END;
$BODY$
  LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_tecno_pc(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_tecno_pc ++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Function:  get_idioma
-- Devuelve si la persona sabe algun idioma
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. idiomas de la persona
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CREATE OR REPLACE FUNCTION public.get_idioma(pPersona integer, pfecha date)
  RETURNS character varying AS
$BODY$
DECLARE iDatoCensal Integer;
DECLARE vFecha DATE;
DECLARE _idioma character varying;
BEGIN
   iDatoCensal := NULL;
   vFecha := COALESCE(pFecha, CURRENT_DATE);
   _idioma := '';
   
   SELECT dato_censal_act INTO iDatoCensal
   	 FROM his_datos_censales, his_datos_actividades
	WHERE his_datos_censales.persona = pPersona
	  AND his_datos_actividades.dato_censal = his_datos_censales.dato_censal
      AND DATE(his_datos_actividades.fecha_alta) &lt;= vFecha
	ORDER BY his_datos_actividades.fecha_alta DESC
   LIMIT 1;
   
   IF iDatoCensal IS NULL THEN
     -- Busco el dato censal mas proximo siguiente a la fecha.
     SELECT dato_censal_act INTO iDatoCensal
   	   FROM his_datos_censales, his_datos_actividades
	  WHERE his_datos_censales.persona = pPersona
	    AND his_datos_actividades.dato_censal = his_datos_censales.dato_censal
        AND DATE(his_datos_actividades.fecha_alta) > vFecha
	  ORDER BY his_datos_actividades.fecha_alta DESC  
     LIMIT 1;
   END IF;

   IF iDatoCensal IS NOT NULL THEN   
	SELECT  CASE WHEN nivel_idioma_ingles in (1,2,3) THEN 'Ingles-' ELSE '' END 
	|| CASE WHEN nivel_idioma_aleman in (1,2,3) THEN 'Alemán-' ELSE '' END 
	|| CASE WHEN nivel_idioma_frances in (1,2,3) THEN 'Francés-' ELSE '' END 
	|| CASE WHEN nivel_idioma_italiano in (1,2,3) THEN 'Italiano-' ELSE '' END 
	|| CASE WHEN nivel_idioma_portugues in (1,2,3) THEN 'Portugués-' ELSE '' END 
	|| CASE WHEN nivel_idioma_chino in (1,2,3) THEN 'Chino-' ELSE '' END 
	|| CASE WHEN nivel_idioma_otro in (1,2,3) THEN 'Otro-' ELSE '' END 
	INTO _idioma FROM his_datos_actividades WHERE his_datos_actividades.dato_censal_act = iDatoCensal;
END IF;

  -- Retorno el id del Dato Censal de actividad
  Return _idioma;
	
END;
$BODY$
  LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_idioma(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_idioma ++++++++++++++++
</sql>
