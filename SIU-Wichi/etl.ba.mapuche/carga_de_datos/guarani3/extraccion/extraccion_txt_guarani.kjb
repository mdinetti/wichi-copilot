      <name>temporales parte2</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>-- ////////////////////////////////////////////////////////////////
-- WICHI - Version 7.2.0
-- TABLAS TEMPORALES Y FUNCIONES UTILIZADAS EN LAS EXTRACCIONES DE DATOS 
--
-- La ejecuciòn de esto puede demorar algunos minutos...
-- ////////////////////////////////////////////////////////////////


----------------------------------------------------------------------------------------------------------------
-------- CALCULA EL NIVEL DE ESTUDIO PADRES
----------------------------------------------------------------------------------------------------------------
DROP TABLE IF EXISTS public.tmp_his_personas_allegados ;
CREATE TABLE public.tmp_his_personas_allegados AS
SELECT dato_censal_allegado, dato_allegado, dato_censal, tipo_allegado, 
       apellido, nombres, calle, numero, piso, departamento, unidad, 
       CASE WHEN localidad = 0 THEN -2 ELSE localidad END as localidad, barrio, codigo_postal, telefono,  CASE WHEN his_personas_allegados.estudio_alcanzado = 12 THEN 13
					 WHEN (his_personas_allegados.estudio_alcanzado is null) THEN 0
					 WHEN (his_personas_allegados.estudio_alcanzado = 13) THEN -2
					 WHEN his_personas_allegados.estudio_alcanzado = 14 THEN 12
					 ELSE his_personas_allegados.estudio_alcanzado
				END AS estudio_alcanzado, 
       trabajo_existe, trabajo_hace, trabajo_ocupacion, trabajo_tarea, 
       trabajo_otro, fecha_alta
  FROM negocio.his_personas_allegados;

DROP TABLE IF EXISTS public._wichi_nivel_estudio_allegados;
CREATE TABLE public._wichi_nivel_estudio_allegados AS
SELECT dato_censal, max(estudio_alcanzado) as estudio_alcanzado, date(fecha_alta) as fecha_alta FROM public.tmp_his_personas_allegados 
WHERE tipo_allegado IN ('P','M','T')
Group by 1,3
ORDER BY 1;

CREATE INDEX IF NOT EXISTS id_wichi_nivel_estudio_allegados1
    ON public._wichi_nivel_estudio_allegados USING btree
    (dato_censal ASC NULLS LAST)
    TABLESPACE pg_default;


-- Function: public.get_nivel_estudio_allegados(integer, date, character)

-- DROP FUNCTION public.get_nivel_estudio_allegados(integer, date, character);

CREATE OR REPLACE FUNCTION public.get_nivel_estudio_allegados(
	ppersona integer,
	pfecha date)
    RETURNS smallint
AS $BODY$
	DECLARE _dato_censal_allegado INTEGER;
	DECLARE _fecha DATE;
	DECLARE _nivel_instruccion SMALLINT;
BEGIN
	_dato_censal_allegado := NULL;
	_fecha := COALESCE(pFecha, CURRENT_DATE);
	_nivel_instruccion := -2; -- Desconoce

	-- Se busca el dato censal más próximo anterior a la fecha.
	SELECT		_wichi_nivel_estudio_allegados.dato_censal INTO _dato_censal_allegado
	FROM		his_datos_censales, _wichi_nivel_estudio_allegados 
	WHERE		his_datos_censales.persona = pPersona AND
				his_datos_censales.dato_censal = _wichi_nivel_estudio_allegados.dato_censal AND
				_wichi_nivel_estudio_allegados.fecha_alta &lt;= _fecha
	ORDER BY	_wichi_nivel_estudio_allegados.fecha_alta DESC
	LIMIT		1;

	IF _dato_censal_allegado IS NULL THEN
		-- Busco el dato censal más próximo siguiente a la fecha.
		SELECT		_wichi_nivel_estudio_allegados.dato_censal INTO _dato_censal_allegado
		FROM		his_datos_censales, _wichi_nivel_estudio_allegados 
		WHERE		his_datos_censales.persona = pPersona AND
					his_datos_censales.dato_censal = _wichi_nivel_estudio_allegados.dato_censal AND
					_wichi_nivel_estudio_allegados.fecha_alta > _fecha
		ORDER BY	_wichi_nivel_estudio_allegados.fecha_alta
		LIMIT		1;
	END IF;

	IF _dato_censal_allegado IS NOT NULL THEN
		SELECT	estudio_alcanzado INTO _nivel_instruccion FROM	_wichi_nivel_estudio_allegados
		WHERE	_wichi_nivel_estudio_allegados.dato_censal = _dato_censal_allegado;
	END IF;

	RETURN _nivel_instruccion;
END;
$BODY$
LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_nivel_estudio_allegados(integer, date) TO public;
-- ++++++++++++++++++++++++++++++ Fin Function get_nivel_estudio_allegados ++++++++++++++++


-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Function:  get_discapacidad
-- Devuelve si la persona posee alguna discapacidad
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. discapacidad de la persona
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CREATE OR REPLACE FUNCTION public.get_discapacidad(pPersona integer, pFecha date)
  RETURNS character varying AS
$BODY$
DECLARE iDatoCensal Integer;
DECLARE vFecha DATE;
DECLARE _discapacidad character varying;
BEGIN
   iDatoCensal := NULL;
   vFecha := COALESCE(pFecha, CURRENT_DATE);
   _discapacidad := '';
   
   SELECT dato_censal_disc INTO iDatoCensal
   	 FROM his_datos_censales, his_datos_discapacidad
	WHERE his_datos_censales.persona = pPersona
	  AND his_datos_discapacidad.dato_censal = his_datos_censales.dato_censal
      AND DATE(his_datos_discapacidad.fecha_alta) &lt;= vFecha
	ORDER BY his_datos_discapacidad.fecha_alta DESC, his_datos_discapacidad.dato_censal_disc  DESC
   LIMIT 1;
   
   IF iDatoCensal IS NULL THEN
     -- Busco el dato censal mas proximo siguiente a la fecha.
     SELECT dato_censal_disc INTO iDatoCensal
   	   FROM his_datos_censales, his_datos_discapacidad
	  WHERE his_datos_censales.persona = pPersona
	    AND his_datos_discapacidad.dato_censal = his_datos_censales.dato_censal
        AND DATE(his_datos_discapacidad.fecha_alta) > vFecha
	  ORDER BY his_datos_discapacidad.fecha_alta DESC, his_datos_discapacidad.dato_censal_disc  DESC
     LIMIT 1;
   END IF;

   IF iDatoCensal IS NOT NULL THEN   
	SELECT  CASE WHEN disc_auditiva = 'S' THEN 'disc_auditiva-' ELSE '' END 
	|| CASE WHEN disc_visual = 'S' THEN 'disc_visual-' ELSE '' END 
	|| CASE WHEN disc_motora = 'S' THEN 'disc_motora-' ELSE '' END 
	|| CASE WHEN disc_cond_psicosocial = 'S' THEN 'disc_cond_psicosocial-' ELSE '' END 
	|| CASE WHEN disc_otra = 'S' THEN 'disc_otra-' ELSE '' END  
	INTO _discapacidad FROM his_datos_discapacidad WHERE his_datos_discapacidad.dato_censal_disc = iDatoCensal;
END IF;

  -- Retorno el id del Dato Censal de discapacidad
  Return _discapacidad;
	
END;
$BODY$
  LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_discapacidad(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_discapacidad ++++++++++++++++


---------------------------------------------------------------------------------------
--Materializo vista comisiones y agrego indices
---------------------------------------------------------------------------------------
DROP TABLE IF EXISTS public._wichi_comisiones;
CREATE TABLE public._wichi_comisiones as SELECT * from negocio.vw_comisiones  WHERE (${periodo} = 0 or anio_academico = ${periodo});

CREATE INDEX IF NOT EXISTS id_comisiones_elemento
    ON public._wichi_comisiones USING btree
    (elemento ASC NULLS LAST)
    TABLESPACE pg_default;

CREATE INDEX IF NOT EXISTS id_comisiones_comision
    ON public._wichi_comisiones USING btree
    (comision ASC NULLS LAST)
    TABLESPACE pg_default;


CREATE INDEX IF NOT EXISTS id_comisiones_anio_academico
    ON public._wichi_comisiones USING btree
    (anio_academico ASC NULLS LAST)
    TABLESPACE pg_default;

---------------------------------------------------------------------------------------
--Materializo vista mesa_examen y agrego indices
---------------------------------------------------------------------------------------
DROP TABLE IF EXISTS public._wichi_mesas_examen;
CREATE TABLE public._wichi_mesas_examen as SELECT * from negocio.vw_mesas_examen  WHERE (${periodo} = 0 or anio_academico = ${periodo});

CREATE INDEX IF NOT EXISTS id_mesas_examen_catedra
    ON public._wichi_mesas_examen USING btree
    (mesa_examen_catedra ASC NULLS LAST)
    TABLESPACE pg_default;

CREATE INDEX IF NOT EXISTS id_mesas_examen_llamado
    ON public._wichi_mesas_examen USING btree
    (llamado_mesa ASC NULLS LAST)
    TABLESPACE pg_default;


CREATE INDEX IF NOT EXISTS id_mesas_examen_anio_academico
    ON public._wichi_mesas_examen USING btree
    (anio_academico ASC NULLS LAST)
    TABLESPACE pg_default;

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla de datos censales por año académico y persona
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

DROP TABLE IF EXISTS public._wichi_datos_censales_tmp;
CREATE TABLE IF NOT EXISTS public._wichi_datos_censales_tmp
(
    persona integer NOT NULL,
    anio_academico integer NOT NULL
);

INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT persona, anio_academico FROM public._wichi_ha_x_titulo_anio WHERE (${periodo} = 0 or anio_academico = ${periodo});


INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT alu.persona, c.anio_academico FROM public._wichi_intentos_cursadas ic JOIN negocio.sga_alumnos alu ON ic.alumno = alu.alumno
		JOIN public._wichi_comisiones c ON ic.comision = c.comision 
		WHERE (${periodo} = 0 or c.anio_academico = ${periodo});

INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT alu.persona, me.anio_academico FROM public._wichi_intentos_examenes ie JOIN negocio.sga_alumnos alu ON ie.alumno = alu.alumno
		JOIN public._wichi_mesas_examen me ON ie.llamado_mesa = me.llamado_mesa 
		WHERE (${periodo} = 0 or me.anio_academico = ${periodo});
	
INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT alu.persona, CASE WHEN greatest(equiv_otorg.fecha,'19000101'::date) >= to_date(cast(extract(year from greatest(equiv_otorg.fecha,'19000101'::date)) as text) || '0401','YYYYMMDD') 
         THEN extract(year from greatest(equiv_otorg.fecha,'19000101'::date))::integer
    	 ELSE extract(year from greatest(equiv_otorg.fecha,'19000101'::date))::integer - 1
    END as anio_academico
	FROM negocio.sga_equiv_otorgada equiv_otorg JOIN negocio.sga_equiv_tramite equiv_tra ON equiv_otorg.equivalencia_tramite = equiv_tra.equivalencia_tramite
	JOIN negocio.sga_alumnos alu ON alu.alumno = equiv_tra.alumno
	Where equiv_otorg.estado = 'C' AND equiv_otorg.resultado = 'A'  AND equiv_otorg.estado = 'A'  AND equiv_otorg.rectificado = 'N'
AND (${periodo} = 0 or greatest(equiv_otorg.fecha,'19000101'::date) BETWEEN to_date(${periodo}||'-04-01', 'YYYY-MM-DD') AND to_date((${periodo}+1)||'-03-31','YYYY-MM-DD'));

INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT alu.persona, CASE WHEN greatest(reconocimiento.fecha,'19000101'::date) >= to_date(cast(extract(year from greatest(reconocimiento.fecha,'19000101'::date)) as text) || '0401','YYYYMMDD') 
         THEN extract(year from greatest(reconocimiento.fecha,'19000101'::date))::integer
    	 ELSE extract(year from greatest(reconocimiento.fecha,'19000101'::date))::integer - 1
    END as anio_academico
	FROM negocio.sga_reconocimiento reconocimiento
	JOIN negocio.sga_alumnos alu ON alu.alumno = reconocimiento.alumno
	Where reconocimiento.estado = 'C' 
AND (${periodo} = 0 or greatest(reconocimiento.fecha,'19000101'::date) BETWEEN to_date(${periodo}||'-04-01', 'YYYY-MM-DD') AND to_date((${periodo}+1)||'-03-31','YYYY-MM-DD'));


DROP TABLE IF EXISTS public._wichi_datos_censales;
CREATE TABLE public._wichi_datos_censales (
	persona INTEGER NOT NULL,
	anio_academico INTEGER NOT NULL,
	hs_trabajo_situacion_alumno VARCHAR, --horas_trabajadas
	estado_civil INTEGER,
	localidad_per_lec INTEGER,
	localidad_proc INTEGER,
	costeo_estudios VARCHAR,
	beca VARCHAR,
	tecno_internet VARCHAR,
	tecno_pc VARCHAR,
	idioma VARCHAR,
	discapacidad VARCHAR,
	max_estudio_padres INTEGER
);

INSERT INTO public._wichi_datos_censales
SELECT DISTINCT persona, anio_academico FROM public._wichi_datos_censales_tmp;

DROP TABLE IF EXISTS public._wichi_datos_censales_tmp;

--Actualiza actividades
UPDATE public._wichi_ha_x_titulo_anio orig  SET cant_act_aprobadas = cant_act_aprobadas_anio_actual, cant_act_realizadas= cant_act_realizadas_anio_actual ;

with suma_cant as (SELECT orig.alumno,orig.anio_academico, orig.certificado, sum(ha.cant_act_aprobadas) as canta, sum(ha.cant_act_realizadas) as cantr
  FROM public._wichi_ha_x_titulo_anio ha, public._wichi_ha_x_titulo_anio orig
  WHERE ha.anio_academico &lt;= orig.anio_academico and ha.alumno = orig.alumno and ha.certificado = orig.certificado
  group by 1,2,3)
UPDATE public._wichi_ha_x_titulo_anio orig  SET cant_act_aprobadas = canta, cant_act_realizadas= cantr from suma_cant 
		where orig.alumno = suma_cant.alumno and orig.anio_academico = suma_cant.anio_academico and orig.certificado = suma_cant.certificado;


