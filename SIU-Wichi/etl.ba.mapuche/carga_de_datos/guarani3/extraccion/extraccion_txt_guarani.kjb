-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla de datos censales por año académico y persona
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

DROP TABLE IF EXISTS public._wichi_datos_censales_tmp;
CREATE TABLE IF NOT EXISTS public._wichi_datos_censales_tmp
(
    persona integer NOT NULL,
    anio_academico integer NOT NULL
);

INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT persona, anio_academico FROM public._wichi_ha_x_titulo_anio WHERE (${periodo} = 0 or anio_academico = ${periodo});


INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT alu.persona, c.anio_academico FROM public._wichi_intentos_cursadas ic JOIN negocio.sga_alumnos alu ON ic.alumno = alu.alumno
		JOIN public._wichi_comisiones c ON ic.comision = c.comision 
		WHERE (${periodo} = 0 or c.anio_academico = ${periodo});

INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT alu.persona, me.anio_academico FROM public._wichi_intentos_examenes ie JOIN negocio.sga_alumnos alu ON ie.alumno = alu.alumno
		JOIN public._wichi_mesas_examen me ON ie.llamado_mesa = me.llamado_mesa 
		WHERE (${periodo} = 0 or me.anio_academico = ${periodo});
	
INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT alu.persona, CASE WHEN greatest(equiv_otorg.fecha,'19000101'::date) >= to_date(cast(extract(year from greatest(equiv_otorg.fecha,'19000101'::date)) as text) || '0401','YYYYMMDD') 
         THEN extract(year from greatest(equiv_otorg.fecha,'19000101'::date))::integer
    	 ELSE extract(year from greatest(equiv_otorg.fecha,'19000101'::date))::integer - 1
    END as anio_academico
	FROM negocio.sga_equiv_otorgada equiv_otorg JOIN negocio.sga_equiv_tramite equiv_tra ON equiv_otorg.equivalencia_tramite = equiv_tra.equivalencia_tramite
	JOIN negocio.sga_alumnos alu ON alu.alumno = equiv_tra.alumno
	Where equiv_otorg.estado = 'C' AND equiv_otorg.resultado = 'A'  AND equiv_otorg.estado = 'A'  AND equiv_otorg.rectificado = 'N'
AND (${periodo} = 0 or greatest(equiv_otorg.fecha,'19000101'::date) BETWEEN to_date(${periodo}||'-04-01', 'YYYY-MM-DD') AND to_date((${periodo}+1)||'-03-31','YYYY-MM-DD'));

INSERT INTO public._wichi_datos_censales_tmp
SELECT DISTINCT alu.persona, CASE WHEN greatest(reconocimiento.fecha,'19000101'::date) >= to_date(cast(extract(year from greatest(reconocimiento.fecha,'19000101'::date)) as text) || '0401','YYYYMMDD') 
         THEN extract(year from greatest(reconocimiento.fecha,'19000101'::date))::integer
    	 ELSE extract(year from greatest(reconocimiento.fecha,'19000101'::date))::integer - 1
    END as anio_academico
	FROM negocio.sga_reconocimiento reconocimiento
	JOIN negocio.sga_alumnos alu ON alu.alumno = reconocimiento.alumno
	Where reconocimiento.estado = 'C' 
AND (${periodo} = 0 or greatest(reconocimiento.fecha,'19000101'::date) BETWEEN to_date(${periodo}||'-04-01', 'YYYY-MM-DD') AND to_date((${periodo}+1)||'-03-31','YYYY-MM-DD'));


DROP TABLE IF EXISTS public._wichi_datos_censales;
CREATE TABLE public._wichi_datos_censales (
	persona INTEGER NOT NULL,
	anio_academico INTEGER NOT NULL,
	hs_trabajo_situacion_alumno VARCHAR, --horas_trabajadas
	estado_civil INTEGER,
	localidad_per_lec INTEGER,
	localidad_proc INTEGER,
	costeo_estudios VARCHAR,
	beca VARCHAR,
	tecno_internet VARCHAR,
	tecno_pc VARCHAR,
	idioma VARCHAR,
	max_estudio_padres INTEGER
);

INSERT INTO public._wichi_datos_censales
SELECT DISTINCT persona, anio_academico FROM public._wichi_datos_censales_tmp;

DROP TABLE IF EXISTS public._wichi_datos_censales_tmp;


--Actualiza actividades
Analyze  public._wichi_ha_x_titulo_anio;

UPDATE public._wichi_ha_x_titulo_anio orig  SET cant_act_aprobadas = cant_act_aprobadas_anio_actual, cant_act_realizadas= cant_act_realizadas_anio_actual ;

with suma_cant as (SELECT orig.alumno,orig.anio_academico, orig.certificado, sum(ha.cant_act_aprobadas) as canta, sum(ha.cant_act_realizadas) as cantr
  FROM public._wichi_ha_x_titulo_anio ha, public._wichi_ha_x_titulo_anio orig
  WHERE ha.anio_academico &lt;= orig.anio_academico and ha.alumno = orig.alumno and ha.certificado = orig.certificado
  group by 1,2,3)
UPDATE public._wichi_ha_x_titulo_anio orig  SET cant_act_aprobadas = canta, cant_act_realizadas= cantr from suma_cant 
		where orig.alumno = suma_cant.alumno and orig.anio_academico = suma_cant.anio_academico and orig.certificado = suma_cant.certificado;


