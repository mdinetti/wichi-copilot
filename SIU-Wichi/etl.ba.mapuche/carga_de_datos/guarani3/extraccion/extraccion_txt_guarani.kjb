      <sql>-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Version 3.15.0
-- Function: get_actividades_x_certificado_plan_version
--
-- Recupera los elementos de tipo "Actividad" que intervienen en el cumplimiento de un certificado.
--
-- Recibe:  
--	get_actividades_x_certificado_plan_version(integer, integer)
--		1.- Certificado (puede ser nulo)
--		2.- Versión de Plan de Estudios (puede ser nulo)
--
-- Retorna: 
--		1. Plan_version
--		2. Certificado
--		3. Elemento
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

-- DROP FUNCTION IF EXISTS public.get_actividades_x_certificado_plan_version(integer, integer);
CREATE OR REPLACE FUNCTION public.get_actividades_x_certificado_plan_version(pCertificado integer, pPlanVersion integer)
  RETURNS TABLE(plan_version integer, certificado integer, elemento integer) AS
$BODY$
DECLARE 
  _elemento Integer;
  _certificado integer;
  _plan_version integer;
  _cur1 record;

BEGIN

 
 CREATE TEMP TABLE _temp_planes_certificados(plan_version integer, certificado integer, elemento integer);

 -- Recorro los certificados de las versiones de planes de estudios 
 FOR _cur1 IN SELECT pc.plan_version, pc.certificado 
                FROM sga_planes_certificados as pc
			   WHERE (pPlanVersion IS NULL OR pc.plan_version = pPlanVersion)	
			     AND (pCertificado IS NULL OR pc.certificado = pCertificado)	
 LOOP
    -- Recupero las actividades del certificado en la version de plan de estudios
    INSERT INTO _temp_planes_certificados (plan_version, certificado, elemento)
       SELECT _cur1.plan_version, _cur1.certificado, e.*
         FROM get_actividades_certificado_plan_version (_cur1.certificado, _cur1.plan_version) as e (integer);
 END LOOP;              

 -- Retorno las actividades de los certificados en las versiones de planes de estudios. 
 RETURN QUERY (SELECT t.plan_version, t.certificado, t.elemento FROM _temp_planes_certificados as t ORDER BY 1, 2, 3);

  DROP TABLE _temp_planes_certificados;
END;
$BODY$
LANGUAGE 'plpgsql' VOLATILE;
  
-- ++++++++++++++++++++++++++ Fin Function get_actividades_x_certificado_plan_version +++++++++++++++++++++++++++++++++++++++
  
-- REVOKE EXECUTE ON FUNCTION public.get_actividades_x_certificado_plan_version (integer, integer) FROM public;
GRANT EXECUTE ON FUNCTION public.get_actividades_x_certificado_plan_version(integer, integer) TO public;




-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Version 3.12.0
-- Function: get_anio_academico_ingreso_alumno
--
-- Recupera el año academico de ingreso del alumno en la instititucion/propuesta/ciclo basico
--
-- Recibe:  get_anio_academico_ingreso_alumno(integer, integer)
--   1. Alumno
--   2. Ingreso a que: 1-Institucion / 2-Propuesta / 3-Ciclo basico
--
-- Retorna: 
--   1. Año academico
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

-- DROP FUNCTION public.get_anio_academico_ingreso_alumno(integer,integer);
CREATE OR REPLACE FUNCTION public.get_anio_academico_ingreso_alumno(pAlumno INTEGER, pIngresoA integer) 
  RETURNS INTEGER AS 
$BODY$
DECLARE 
 _propuesta integer;
 _persona integer;
 _plan_insc integer;
 _plan_actual integer;
 _plan_version_actual integer;
 _plan_version_insc integer;
 _anio_insc_propuesta integer;
 _periodo_insc_propuesta integer;
 _anio_academico_ingreso integer;
 _anio_ingreso_ciclo_basico integer;

 cur_cb RECORD;

BEGIN
  _anio_academico_ingreso := NULL;
  _anio_ingreso_ciclo_basico := NULL;
  _anio_insc_propuesta := NULL;
  
  -- Recupero el año academico y plan de estudios de la inscripcion en la propuesta  y actual.
  -- Recupera la inscripcion aceptada o pendiente.
 SELECT a.persona, pa.propuesta, pa.plan_version, plan_insc.plan, pa.anio_academico, a.plan_version, plan_actual.plan, pi.periodo_inscripcion 
   INTO _persona, _propuesta, _plan_version_insc, _plan_insc, _anio_insc_propuesta, _plan_version_actual, _plan_actual, _periodo_insc_propuesta
   FROM sga_alumnos as a,
	sga_planes_versiones as plan_actual,
        sga_propuestas_aspira as pa, 
        sga_planes_versiones as plan_insc,
        sga_situacion_aspirante as sa,
        sga_periodos_inscripcion_fechas as pif, 
        sga_periodos_inscripcion as pi
  WHERE a.alumno = pAlumno
    AND plan_actual.plan_version = a.plan_version
    AND pa.propuesta = a.propuesta
    AND pa.persona   = a.persona
    AND plan_insc.plan_version = pa.plan_version
    AND sa.situacion_asp = pa.situacion_asp 
    AND sa.resultado_asp IN ('P','A') 
    AND pif.periodo_insc = pa.periodo_insc
    AND pi.periodo_inscripcion = pif.periodo_inscripcion;

  -- Por default el año de ingreso en la propuesta
  _anio_academico_ingreso := _anio_insc_propuesta;

  IF pIngresoA = 1 THEN
     -- Año academico de ingreso en la institucion. En la primer propuesta en la que ingresó (incluye ciclo basico)
     SELECT MIN(pa.anio_academico)
       INTO _anio_academico_ingreso
       FROM sga_alumnos as a,
    		sga_planes_versiones as plan_actual,
            sga_propuestas_aspira as pa, 
            sga_planes_versiones as plan_insc,
            sga_situacion_aspirante as sa
      WHERE a.persona = _persona
        AND plan_actual.plan_version = a.plan_version
        AND pa.propuesta = a.propuesta
        AND pa.persona   = a.persona
        AND plan_insc.plan_version = pa.plan_version
        AND sa.situacion_asp = pa.situacion_asp 
        AND sa.resultado_asp IN ('P','A');

  ELSIF pIngresoA = 2 THEN
     -- Año academico de ingreso en la propuesta 
     _anio_academico_ingreso := _anio_insc_propuesta;

ELSIF pIngresoA = 3 THEN	 
      _anio_ingreso_ciclo_basico := NULL; 
      -- Año academico de ingreso en el ciclo basico (si existia ciclo basico asociado a la propuesta-plan en la que se inscribió el alumno) 
      SELECT MIN(pa.anio_academico)
        INTO _anio_ingreso_ciclo_basico       
       FROM (SELECT cast(get_relacion_propuesta as integer) as relacion FROM get_relacion_propuesta(pAlumno)) as r,
            sga_propuestas_relacion as pr,
            sga_propuestas_relacion_grupo as g,
            sga_propuestas_relacion_plan as rp,
            sga_planes as plan_ciclo_basico, 
            sga_propuestas as prop_ciclo_basico,
            sga_propuestas_aspira as pa,
            sga_situacion_aspirante as sa
      WHERE pr.relacion = r.relacion
        AND g.relacion = r.relacion
        AND rp.relacion_grupo = g.relacion_grupo
        AND plan_ciclo_basico.plan = rp.plan
        AND prop_ciclo_basico.propuesta = plan_ciclo_basico.propuesta
        AND prop_ciclo_basico.propuesta_tipo = 203 -- Ciclo Básico o Común
        AND pa.propuesta = prop_ciclo_basico.propuesta
        AND pa.persona = _persona
        AND sa.situacion_asp = pa.situacion_asp 
        AND sa.resultado_asp IN ('P','A'); 

	-- Si lo encontro devuelvo el año academico de ingreso en el ciclo basico.	 
    IF FOUND  AND _anio_ingreso_ciclo_basico IS NOT NULL THEN
	   _anio_academico_ingreso := _anio_ingreso_ciclo_basico;
    END IF;	
  END IF;  
  -- Retorno el año academico de ingreso
  RETURN _anio_academico_ingreso;
END;
$BODY$
LANGUAGE 'plpgsql' VOLATILE;
-- ++++++++++++++++++++++++++++++ Fin Function get_anio_academico_ingreso_alumno ++++++++++++++++++++++++++++++

-- REVOKE EXECUTE ON FUNCTION public.get_anio_academico_ingreso_alumno (integer, integer) FROM public;
GRANT EXECUTE ON FUNCTION public.get_anio_academico_ingreso_alumno (integer, integer) to public;

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Version 3.12.0
-- Function:  get_horas_trabajo_araucano
-- Devuelve el dato de las horas de trabajo del alumno
--
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. Horas que trabajò
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

-- DROP FUNCTION public.get_horas_trabajo_araucano(integer);
CREATE OR REPLACE FUNCTION public.get_horas_trabajo_araucano(
    ppersona integer,
    pfecha date)
  RETURNS character varying AS
$BODY$
	DECLARE _dato_censal_eco INTEGER;
	DECLARE _fecha DATE;
	DECLARE _horas_trabajo VARCHAR(4);
BEGIN
	_dato_censal_eco := NULL;
	_fecha := COALESCE(pFecha, CURRENT_DATE);


	-- Se busca el dato censal más próximo anterior a la fecha.
	SELECT		his_datos_economicos.dato_censal_eco INTO _dato_censal_eco
	FROM		his_datos_censales
				JOIN his_datos_economicos ON his_datos_censales.dato_censal = his_datos_economicos.dato_censal
	WHERE		his_datos_censales.persona = ppersona AND
				DATE(his_datos_economicos.fecha_alta) &lt;= _fecha
	ORDER BY	his_datos_economicos.fecha_alta DESC
	LIMIT		1;

	IF _dato_censal_eco IS NULL THEN
		-- Busco el dato censal más próximo siguiente a la fecha.
			SELECT		his_datos_economicos.dato_censal_eco INTO _dato_censal_eco
			FROM		his_datos_censales
						JOIN his_datos_economicos ON his_datos_censales.dato_censal = his_datos_economicos.dato_censal
			WHERE		his_datos_censales.persona = ppersona AND
						DATE(his_datos_economicos.fecha_alta) > _fecha
			ORDER BY	his_datos_economicos.fecha_alta
			LIMIT		1;
	END IF;

	_horas_trabajo := '-9';
	IF _dato_censal_eco IS NOT NULL THEN
		SELECT	CASE
					WHEN his_datos_economicos.trabajo_existe IS NULL OR (his_datos_economicos.trabajo_existe = 1 AND his_datos_economicos.trabajo_hora_sem IS NULL) THEN '-8' --Desconoce
					WHEN his_datos_economicos.trabajo_existe = 1 THEN his_datos_economicos.trabajo_hora_sem -- Trabajó al menos una hora
					WHEN his_datos_economicos.trabajo_existe = 4 THEN '-8'   -- Desconoce
					ELSE '-9' -- No trabajó
				END INTO _horas_trabajo
		FROM	his_datos_economicos
		WHERE	his_datos_economicos.dato_censal_eco = _dato_censal_eco;
	END IF;

	RETURN _horas_trabajo;
	END;
$BODY$
  LANGUAGE plpgsql STABLE
  COST 100;


-- REVOKE EXECUTE ON FUNCTION public.get_horas_trabajo_araucano(integer,date) FROM public;
GRANT EXECUTE ON FUNCTION public.get_horas_trabajo_araucano(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_horas_trabajo_araucano ++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Version 3.12.0
-- Function:  get_forma_ingreso_interfaces_corta
-- Devuelve el dato de la forma de ingreso del alumno
--
-- Recibe:  1. Id del Alumno, Año Ingreso.
-- Retorna: 1. Forma de ingreso
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CREATE OR REPLACE FUNCTION public.get_forma_ingreso_interfaces_corta(
    palumno integer,
    anio_academico_ingreso numeric)
  RETURNS integer AS
$BODY$
DECLARE
_fecha_fin_anio_academico_ingreso date;
_cant_equivalencias integer;
_codigo_forma_ingreso integer;
BEGIN
_fecha_fin_anio_academico_ingreso := anio_academico_ingreso + 1 || '-03-31';

_cant_equivalencias := 0;
select sum(cantidad) INTO _cant_equivalencias
FROM (
SELECT count(*) cantidad
   FROM sga_equiv_tramite
     JOIN sga_equiv_otorgada ON sga_equiv_otorgada.equivalencia_tramite = sga_equiv_tramite.equivalencia_tramite
  WHERE sga_equiv_tramite.estado = 'C'::bpchar AND sga_equiv_otorgada.rectificado = 'N'::bpchar
  and sga_equiv_otorgada.estado = 'A'
  and sga_equiv_tramite.alumno = palumno
  and sga_equiv_otorgada.fecha &lt;= _fecha_fin_anio_academico_ingreso
UNION ALL
SELECT COUNT(sga_reconocimiento.nro_tramite)
FROM sga_reconocimiento
WHERE sga_reconocimiento.estado = 'C' AND
sga_reconocimiento.alumno = palumno AND
sga_reconocimiento.fecha &lt;= _fecha_fin_anio_academico_ingreso
) a;

IF _cant_equivalencias > 0 THEN
_codigo_forma_ingreso := 2;
ELSE
_codigo_forma_ingreso := 1;
END IF;

RETURN _codigo_forma_ingreso;
END;
$BODY$
  LANGUAGE plpgsql VOLATILE
  COST 100;

GRANT EXECUTE ON FUNCTION public.get_forma_ingreso_interfaces_corta(integer, numeric) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_forma_ingreso_interfaces_corta ++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Function:  get_estado_civil
-- Devuelve el estado civil de la persona
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. Estado civil
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

-- DROP FUNCTION public.get_estado_civil(integer, date);
CREATE OR REPLACE FUNCTION public.get_estado_civil(pPersona integer, pfecha date)
  RETURNS integer AS
$BODY$
DECLARE iDatoCensal Integer;
DECLARE vFecha DATE;
DECLARE _ec Integer;
BEGIN
   iDatoCensal := NULL;
   vFecha := COALESCE(pFecha, CURRENT_DATE);
   _ec := 0;
   
   SELECT dato_censal_per INTO iDatoCensal
   	 FROM his_datos_censales, his_datos_personales
	WHERE his_datos_censales.persona = pPersona
	  AND his_datos_personales.dato_censal = his_datos_censales.dato_censal
      AND DATE(his_datos_personales.fecha_alta) &lt;= vFecha
	ORDER BY his_datos_personales.fecha_alta DESC
   LIMIT 1;
   
   IF iDatoCensal IS NULL THEN
     -- Busco el dato censal mas proximo siguiente a la fecha.
     SELECT dato_censal_per INTO iDatoCensal
   	   FROM his_datos_censales, his_datos_personales
	  WHERE his_datos_censales.persona = pPersona
	    AND his_datos_personales.dato_censal = his_datos_censales.dato_censal
        AND DATE(his_datos_personales.fecha_alta) > vFecha
	  ORDER BY his_datos_personales.fecha_alta DESC  
     LIMIT 1;
   END IF;

   IF iDatoCensal IS NOT NULL THEN   
	SELECT estado_civil INTO _ec FROM his_datos_personales WHERE his_datos_personales.dato_censal_per = iDatoCensal;
   END IF;

  -- Retorno el id del Dato Censal personal
  Return _ec;
	
END;
$BODY$
  LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_estado_civil(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_estado_civil ++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Function:  get_localidad_per_lec
-- Devuelve la localidad del periodo lectivo de la persona
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. localidad
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

-- DROP FUNCTION public.get_localidad_per_lec(integer);
CREATE OR REPLACE FUNCTION public.get_localidad_per_lec( ppersona integer,  pfecha date)
  RETURNS integer AS
$BODY$
DECLARE iDatoCensal Integer;
DECLARE vFecha DATE;
DECLARE _localidad Integer;
BEGIN
   iDatoCensal := NULL;
   vFecha := COALESCE(pFecha, CURRENT_DATE);
   _localidad := 0;
   
   SELECT dato_censal_per INTO iDatoCensal
   	 FROM his_datos_censales, his_datos_personales
	WHERE his_datos_censales.persona = pPersona
	  AND his_datos_personales.dato_censal = his_datos_censales.dato_censal
      AND DATE(his_datos_personales.fecha_alta) &lt;= vFecha
	ORDER BY his_datos_personales.fecha_alta DESC
   LIMIT 1;
   
   IF iDatoCensal IS NULL THEN
     -- Busco el dato censal mas proximo siguiente a la fecha.
     SELECT dato_censal_per INTO iDatoCensal
   	   FROM his_datos_censales, his_datos_personales
	  WHERE his_datos_censales.persona = pPersona
	    AND his_datos_personales.dato_censal = his_datos_censales.dato_censal
        AND DATE(his_datos_personales.fecha_alta) > vFecha
	  ORDER BY his_datos_personales.fecha_alta DESC  
     LIMIT 1;
   END IF;

   IF iDatoCensal IS NOT NULL THEN   
	SELECT CASE WHEN periodo_lectivo_localidad = 0 THEN -2 ELSE periodo_lectivo_localidad END as periodo_lectivo_localidad INTO _localidad FROM his_datos_personales WHERE his_datos_personales.dato_censal_per = iDatoCensal;
   END IF;

  -- Retorno el id del Dato Censal personal
  Return _localidad;
	
END;
$BODY$
  LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_localidad_per_lec(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_localidad_per_lec ++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Function:  get_localidad_proc
-- Devuelve la localidad de procedencia de la persona
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. localidad
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

-- DROP FUNCTION public.get_localidad_proc(integer);
CREATE OR REPLACE FUNCTION public.get_localidad_proc(pPersona integer, pfecha date)
  RETURNS integer AS
$BODY$
DECLARE iDatoCensal Integer;
DECLARE vFecha DATE;
DECLARE _localidad Integer;
BEGIN
   iDatoCensal := NULL;
   vFecha := COALESCE(pFecha, CURRENT_DATE);
   _localidad := 0;
   
   SELECT dato_censal_per INTO iDatoCensal
   	 FROM his_datos_censales, his_datos_personales
	WHERE his_datos_censales.persona = pPersona
	  AND his_datos_personales.dato_censal = his_datos_censales.dato_censal
      AND DATE(his_datos_personales.fecha_alta) &lt;= vFecha
	ORDER BY his_datos_personales.fecha_alta DESC
   LIMIT 1;
   
   IF iDatoCensal IS NULL THEN
     -- Busco el dato censal mas proximo siguiente a la fecha.
     SELECT dato_censal_per INTO iDatoCensal
   	   FROM his_datos_censales, his_datos_personales
	  WHERE his_datos_censales.persona = pPersona
	    AND his_datos_personales.dato_censal = his_datos_censales.dato_censal
        AND DATE(his_datos_personales.fecha_alta) > vFecha
	  ORDER BY his_datos_personales.fecha_alta DESC  
     LIMIT 1;
   END IF;

   IF iDatoCensal IS NOT NULL THEN   
	SELECT CASE WHEN procedencia_localidad = 0 THEN -2 ELSE procedencia_localidad END as procedencia_localidad INTO _localidad FROM his_datos_personales WHERE his_datos_personales.dato_censal_per = iDatoCensal;
   END IF;

  -- Retorno el id del Dato Censal personal
  Return _localidad;
	
END;
$BODY$
  LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_localidad_proc(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_localidad_proc ++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Function:  get_costeo_estudios
-- Devuelve el costeo de estudios de la persona
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. costeo estudio
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

CREATE OR REPLACE FUNCTION public.get_costeo_estudios(pPersona integer, pfecha date)
  RETURNS character varying AS
$BODY$
DECLARE iDatoCensal Integer;
DECLARE vFecha DATE;
DECLARE _costeo character varying;
BEGIN
   iDatoCensal := NULL;
   vFecha := COALESCE(pFecha, CURRENT_DATE);
   _costeo := '';
   
   SELECT dato_censal_eco INTO iDatoCensal
   	 FROM his_datos_censales, his_datos_economicos
	WHERE his_datos_censales.persona = pPersona
	  AND his_datos_economicos.dato_censal = his_datos_censales.dato_censal
      AND DATE(his_datos_economicos.fecha_alta) &lt;= vFecha
	ORDER BY his_datos_economicos.fecha_alta DESC
   LIMIT 1;
   
   IF iDatoCensal IS NULL THEN
     -- Busco el dato censal mas proximo siguiente a la fecha.
     SELECT dato_censal_eco INTO iDatoCensal
   	   FROM his_datos_censales, his_datos_economicos
	  WHERE his_datos_censales.persona = pPersona
	    AND his_datos_economicos.dato_censal = his_datos_censales.dato_censal
        AND DATE(his_datos_economicos.fecha_alta) > vFecha
	  ORDER BY his_datos_economicos.fecha_alta DESC  
     LIMIT 1;
   END IF;

   IF iDatoCensal IS NOT NULL THEN   
	SELECT  CASE WHEN costeo_estudios_familiar = 'S' THEN 'familiar-' ELSE '' END 
	|| CASE WHEN costeo_estudios_plan_social = 'S' THEN 'plan_social-' ELSE '' END 
	|| CASE WHEN costeo_estudios_trabajo = 'S' THEN 'trabajo-' ELSE '' END 
	|| CASE WHEN costeo_estudios_beca = 'S' THEN 'beca-' ELSE '' END 
	|| CASE WHEN costeo_estudios_otro = 'S' THEN 'otro-' ELSE '' END INTO _costeo FROM his_datos_economicos WHERE his_datos_economicos.dato_censal_eco = iDatoCensal;
END IF;

  -- Retorno el id del Dato Censal personal
  Return _costeo;
	
END;
$BODY$
  LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_costeo_estudios(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_costeo_estudios ++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Function:  get_beca
-- Devuelve si la persona tiene beca o no
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. beca S o N
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CREATE OR REPLACE FUNCTION public.get_beca(pPersona integer, pfecha date)
  RETURNS character(1) AS
$BODY$
DECLARE iDatoCensal Integer;
DECLARE vFecha DATE;
DECLARE _beca character(1);
BEGIN
   iDatoCensal := NULL;
   vFecha := COALESCE(pFecha, CURRENT_DATE);
   _beca := 'N';
   
   SELECT dato_censal_eco INTO iDatoCensal
   	 FROM his_datos_censales, his_datos_economicos
	WHERE his_datos_censales.persona = pPersona
	  AND his_datos_economicos.dato_censal = his_datos_censales.dato_censal
      AND DATE(his_datos_economicos.fecha_alta) &lt;= vFecha
	ORDER BY his_datos_economicos.fecha_alta DESC
   LIMIT 1;
   
   IF iDatoCensal IS NULL THEN
     -- Busco el dato censal mas proximo siguiente a la fecha.
     SELECT dato_censal_eco INTO iDatoCensal
   	   FROM his_datos_censales, his_datos_economicos
	  WHERE his_datos_censales.persona = pPersona
	    AND his_datos_economicos.dato_censal = his_datos_censales.dato_censal
        AND DATE(his_datos_economicos.fecha_alta) > vFecha
	  ORDER BY his_datos_economicos.fecha_alta DESC  
     LIMIT 1;
   END IF;

   IF iDatoCensal IS NOT NULL THEN   
	SELECT coalesce(beca,'N') INTO _beca FROM his_datos_economicos WHERE his_datos_economicos.dato_censal_eco = iDatoCensal;
END IF;

  -- Retorno el id del Dato Censal personal
  Return _beca;
	
END;
$BODY$
  LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_beca(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_beca ++++++++++++++++
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Function:  get_tecno_internet
-- Devuelve si la persona tiene internet o no
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. lugar donde dispone internet
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CREATE OR REPLACE FUNCTION public.get_tecno_internet(pPersona integer, pfecha date)
  RETURNS character varying AS
$BODY$
DECLARE iDatoCensal Integer;
DECLARE vFecha DATE;
DECLARE _tecno character varying;
BEGIN
   iDatoCensal := NULL;
   vFecha := COALESCE(pFecha, CURRENT_DATE);
   _tecno := '';
   
   SELECT dato_censal_act INTO iDatoCensal
   	 FROM his_datos_censales, his_datos_actividades
	WHERE his_datos_censales.persona = pPersona
	  AND his_datos_actividades.dato_censal = his_datos_censales.dato_censal
      AND DATE(his_datos_actividades.fecha_alta) &lt;= vFecha
	ORDER BY his_datos_actividades.fecha_alta DESC
   LIMIT 1;
   
   IF iDatoCensal IS NULL THEN
     -- Busco el dato censal mas proximo siguiente a la fecha.
     SELECT dato_censal_act INTO iDatoCensal
   	   FROM his_datos_censales, his_datos_actividades
	  WHERE his_datos_censales.persona = pPersona
	    AND his_datos_actividades.dato_censal = his_datos_censales.dato_censal
        AND DATE(his_datos_actividades.fecha_alta) > vFecha
	  ORDER BY his_datos_actividades.fecha_alta DESC  
     LIMIT 1;
   END IF;

   IF iDatoCensal IS NOT NULL THEN   
	SELECT  CASE WHEN tecnologia_int_casa = 'S' THEN 'casa-' ELSE '' END 
	|| CASE WHEN tecnologia_int_trabajo = 'S' THEN 'trabajo-' ELSE '' END 
	|| CASE WHEN tecnologia_int_universidad = 'S' THEN 'universidad-' ELSE '' END 
	|| CASE WHEN tecnologia_int_otro_lugar = 'S' THEN 'lugar-' ELSE '' END 
	INTO _tecno FROM his_datos_actividades WHERE his_datos_actividades.dato_censal_act = iDatoCensal;
END IF;

  -- Retorno el id del Dato Censal de actividad
  Return _tecno;
	
END;
$BODY$
  LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_tecno_internet(integer, date) TO public;

-- ++++++++++++++++++++++++++++++ Fin Function get_tecno_internet ++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- SIU-GUARANI 3
-- Function:  get_tecno_pc
-- Devuelve si la persona tiene pc o no
-- Recibe:  1. Id de la Persona.
-- Retorna: 1. lugar donde dispone pc
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
CREATE OR REPLACE FUNCTION public.get_tecno_pc(pPersona integer, pfecha date)
