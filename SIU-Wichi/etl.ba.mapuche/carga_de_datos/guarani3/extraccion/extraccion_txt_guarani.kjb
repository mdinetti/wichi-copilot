      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>-- ////////////////////////////////////////////////////////////////
-- WICHI - Version 7.1.0
-- TABLAS TEMPORALES Y FUNCIONES UTILIZADAS EN LAS EXTRACCIONES DE DATOS 
--
-- La ejecuciòn de esto puede demorar algunos minutos...
-- ////////////////////////////////////////////////////////////////


-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla: _wichi_ingreso_alumnos
-- Por cada alumno se registra el año academico de ingreso y el período de inscripción
-- Inscripciones Aceptadas o Pendientes (solo hay una u otra).
-- Usado en FT_Examenes.txt, FT_Cursadas.txt, FT_Equivalencias.txt, FT_Alumnos.txt
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

DROP TABLE IF EXISTS public._wichi_ingreso_alumnos;

CREATE TABLE public._wichi_ingreso_alumnos (
   alumno integer NOT NULL,
   persona integer NOT NULL,
   propuesta integer NOT NULL,
   anio_academico_institucion integer NULL,   -- año academico de ingreso por 1ra vez en la institucion.
   anio_academico_propuesta integer NULL,     -- año academico de ingreso en la propuesta
   anio_academico_ciclo_basico integer NULL,  -- año academico de ingreso en el ciclo basico si tiene, sino en la propuesta
   periodo_inscripcion integer NOT NULL,
   periodo_inscripcion_nombre varchar(100) NOT NULL,
   situacion_asp integer

);


INSERT INTO public._wichi_ingreso_alumnos (alumno, persona, propuesta, anio_academico_propuesta, anio_academico_ciclo_basico, 
        periodo_inscripcion, periodo_inscripcion_nombre,situacion_asp)
WITH pa as (SELECT spa.persona,spa.propuesta,spa.anio_academico,spa.situacion_asp,spa.periodo_insc, resultado_asp FROM sga_propuestas_aspira spa JOIN sga_situacion_aspirante sa ON (spa.situacion_asp = sa.situacion_asp) WHERE sa.resultado_asp IN ('P','A'))
 SELECT a.alumno,
        pa.persona , 
        pa.propuesta, 
        pa.anio_academico , -- anio academico de ingreso en la propuesta
        COALESCE(public.get_anio_academico_ingreso_alumno(a.alumno, 3) , pa.anio_academico), -- anio academico de ingreso en el ciclo basico
        pi.periodo_inscripcion,
        pi.nombre as periodo_inscripcion_nombre,
 		pa.situacion_asp
   FROM pa LEFT JOIn sga_periodos_inscripcion_fechas as pif ON (pif.periodo_insc = pa.periodo_insc)
	LEFT JOIN sga_periodos_inscripcion pi ON (pi.periodo_inscripcion = pif.periodo_inscripcion)
	JOIN  sga_alumnos a ON (a.propuesta = pa.propuesta AND a.persona = pa.persona);


CREATE INDEX _wichi_ingreso_alumnos_1 ON public._wichi_ingreso_alumnos (alumno);
CREATE INDEX _wichi_ingreso_alumnos_2 ON public._wichi_ingreso_alumnos (persona, propuesta);
CREATE INDEX _wichi_ingreso_alumnos_3 ON public._wichi_ingreso_alumnos (alumno, anio_academico_propuesta);
CREATE INDEX _wichi_ingreso_alumnos_4 ON public._wichi_ingreso_alumnos (alumno, anio_academico_ciclo_basico);


-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Verifico cual es el año academico de ingreso a la institucion. tomo el menor valor por cada persona.
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS public.tmp_wichi_ingreso;
CREATE TABLE public.tmp_wichi_ingreso (persona integer, anio_academico integer);

INSERT INTO public.tmp_wichi_ingreso (persona, anio_academico)
SELECT persona, MIN(anio_academico_propuesta)  
  FROM public._wichi_ingreso_alumnos
GROUP BY persona;

CREATE INDEX tmp_wichi_ingreso_1 ON public.tmp_wichi_ingreso (persona);

UPDATE public._wichi_ingreso_alumnos
  SET anio_academico_institucion = public.tmp_wichi_ingreso.anio_academico
 FROM public.tmp_wichi_ingreso
WHERE public.tmp_wichi_ingreso.persona = public._wichi_ingreso_alumnos.persona;

-- Borro tabla temporal
DROP TABLE IF EXISTS public.tmp_wichi_ingreso;



--  -----------------------------------------------------------------------------------
--  -----------------------------------------------------------------------------------
--
-- TABLAS UTILIZADAS EN EXTRACCION DE DATOS DE CURSADAS, EXAMENES Y EQUIVALENCIAS
--
--  -----------------------------------------------------------------------------------
--  -----------------------------------------------------------------------------------

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla que registra por cada alumno la cantidad de veces que intentó cursar una actividad y por cada cursada que nro de vez es.
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS public._wichi_intentos_cursadas;
CREATE TABLE public._wichi_intentos_cursadas (
	alumno INTEGER NOT NULL,
	elemento INTEGER NOT NULL,
	comision integer NOT NULL,
	total_intentos integer,
	nro_intento integer);


-- Creo indice
CREATE INDEX id_wichi_intentos_cursadas ON public._wichi_intentos_cursadas (alumno, elemento, comision);

DROP TABLE IF EXISTS public._wichi_tot;
CREATE TABLE public._wichi_tot (alumno integer, elemento integer, total_intentos integer);

	
DROP FUNCTION IF EXISTS public._f_wichi_intentos_cursadas();
CREATE OR REPLACE FUNCTION public._f_wichi_intentos_cursadas() 
 RETURNS VOID AS 
$BODY$
DECLARE 
  _nro_intento smallint;
  _elemento_anterior integer;
  _alumno_anterior integer;
  _comision_anterior integer;
  _insertar boolean;
  cur1 record;
        
  BEGIN
  _nro_intento := 1;	
  _elemento_anterior  := NULL;
  _alumno_anterior    := NULL;
  _comision_anterior  := NULL;
    		
  DELETE FROM public._wichi_intentos_cursadas; 		
  
  -- Recupero los alumnos en actas de cursadas abiertas y cerradas.
  -- Alumnos de actas de promocion abiertas y cerradas de comisiones que tienen solo la instancia de promocion.
  FOR cur1 IN (
              -- Actas de cursadas Cerradas
              -- ++++++++++++++++++++++ INICIO personalizacion UNICEN-UNR +++++++++++++++++++++++++++++++++++++++++++++++  
              (SELECT d.alumno, a.comision, c.elemento, d.fecha as fecha
                FROM sga_actas as a
                JOIN sga_actas_detalle as d ON  d.id_acta = a.id_acta
                JOIN sga_comisiones as c ON c.comision = a.comision      
               WHERE a.origen = 'R' --tipo_acta Normal y Rectificativas
                 AND a.estado = 'C'
                 AND d.estado = 'A'
                 AND d.rectificado = 'N'
              UNION -- Si hay duplicados deja un solo registro - CASO UNICEN -UNR - Actas de Cursadas sin todos los alumnos de la comision
                -- Alumnos de actas de promocion
		      SELECT d.alumno, a.comision, c.elemento, d.fecha as fecha
                FROM sga_actas as a
                JOIN sga_actas_detalle as d ON  d.id_acta = a.id_acta
                JOIN sga_comisiones as c ON c.comision = a.comision      
               WHERE a.origen = 'P' --tipo_acta Normal y Rectificativas
                 AND a.estado = 'C'
                 AND d.estado = 'A'
                 AND d.rectificado = 'N'                  
                 -- Actas de Promocion donde la comision tiene la instancia Regular (existe acta de Regularidad)
                 AND a.comision IN (SELECT comision FROM sga_comisiones_instancias WHERE instancia = 1)                 
               )  
             -- ++++++++++++++++++++++ Fin personalizacion UNICEN -UNR +++++++++++++++++++++++++++++++++++++++++++++++ 
             UNION ALL
			 -- Actas de Cursadas Abiertas
             SELECT d.alumno, a.comision, c.elemento, COALESCE(d.fecha_regular, a.fecha_generacion) as fecha
                FROM sga_actas as a,
                     sga_eval_detalle_cursadas as d, 
                     sga_comisiones as c
               WHERE a.origen = 'R'
                 AND a.tipo_acta = 'N' -- Acta Normal
                 AND a.estado = 'A'
                 AND c.comision = a.comision      
                 AND d.id_acta_cursada = a.id_acta
             UNION ALL
              -- Actas de PROMOCIONES cerradas, de comisiones que tienen solo instancia de promocion.
              SELECT d.alumno, a.comision, c.elemento, d.fecha as fecha
                FROM sga_actas as a,
                     sga_actas_detalle as d, 
                     sga_comisiones as c
               WHERE a.origen = 'P' 
                 AND a.estado = 'C'
                 AND c.comision = a.comision      
                 AND d.id_acta = a.id_acta
                 AND d.estado = 'A'
                 AND d.rectificado = 'N'
				 AND a.comision IN (SELECT comision 
				                      FROM sga_comisiones_instancias 
									 WHERE comision IN (SELECT comision FROM sga_comisiones_instancias WHERE instancia = 2)
									GROUP BY 1 
									HAVING COUNT(*) = 1
									)
             UNION ALL
              -- Actas de PROMOCIONES abiertas, de comisiones que tienen solo instancia de promocion.
              SELECT d.alumno, a.comision, c.elemento, COALESCE(d.fecha_promocion, a.fecha_generacion) as fecha
                FROM sga_actas as a,
                     sga_eval_detalle_cursadas as d, 
                     sga_comisiones as c
               WHERE a.origen    = 'P'
                 AND a.tipo_acta = 'N' -- Acta Normal
                 AND a.estado    = 'A'
                 AND d.id_acta_promocion = a.id_acta
                 AND c.comision  = a.comision      
				 AND a.comision IN (SELECT comision 
				                      FROM sga_comisiones_instancias 
									 WHERE comision IN (SELECT comision FROM sga_comisiones_instancias WHERE instancia = 2)
									GROUP BY 1 
									HAVING COUNT(*) = 1
									)
              ORDER BY 1, 3, 4)
  LOOP
      _insertar := true;
      IF cur1.alumno = _alumno_anterior AND cur1.elemento = _elemento_anterior THEN
         IF cur1.comision = _comision_anterior THEN
            -- Es la misma comsion,posiblemente es el acta de promocion de cursada..
            _insertar := false;
         ELSE
           _nro_intento := _nro_intento + 1;   
         END IF;
      ELSE
         _nro_intento := 1;
      END IF;

      IF _insertar THEN
        INSERT INTO public._wichi_intentos_cursadas (alumno, elemento, comision, nro_intento) VALUES (cur1.alumno, cur1.elemento, cur1.comision, _nro_intento);
      END IF;
      
	  _elemento_anterior := cur1.elemento;        
	  _alumno_anterior   := cur1.alumno;        
	  _comision_anterior  := cur1.comision;        
  END LOOP;
	
  -- Actualizo el total de intentos
  
  INSERT INTO public._wichi_tot (alumno,elemento, total_intentos)
    SELECT alumno, elemento, count(*)
      FROM public._wichi_intentos_cursadas
    GROUP BY alumno, elemento;  
  
  -- Actualizo el total de intentos de cursadas de la materia
  UPDATE public._wichi_intentos_cursadas
    SET total_intentos = t.total_intentos
    FROM public._wichi_tot as t
  WHERE t.alumno = public._wichi_intentos_cursadas.alumno
    AND t.elemento = public._wichi_intentos_cursadas.elemento;  
    
   
  END;
$BODY$
LANGUAGE 'plpgsql' VOLATILE;
-- ++++++++++++++++++++++++++++++ Fin Function _f_wichi_intentos_cursadas(integer) ++++++++++++++++

-- Ejecuto la funcion asi llena la tabla de intentos de examenes
SELECT * FROM public._f_wichi_intentos_cursadas();

DROP FUNCTION IF EXISTS public._f_wichi_intentos_cursadas();
DROP TABLE IF EXISTS public._wichi_tot;



-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Archivo: FT_Examen.txt
-- Examenes de Actas Abiertas y Cerradas
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla que registra por cada alumno la cantidad de veces que intentó rendir una actividad y por cada examen que nro de vez es.
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS public._wichi_intentos_examenes;
CREATE TABLE public._wichi_intentos_examenes (
	alumno INTEGER NOT NULL,
	elemento INTEGER NOT NULL,
	llamado_mesa integer NOT NULL,
	total_intentos integer,
	nro_intento integer);

-- Tabla temporal de totales de intentos por alumno y elemento.
DROP TABLE IF EXISTS public._wichi_tot;
CREATE TABLE public._wichi_tot (alumno integer, elemento integer, total_intentos integer);

-- Indice
CREATE INDEX idx_wichi_intentos_examenes ON public._wichi_intentos_examenes (alumno, elemento, llamado_mesa);

	
DROP FUNCTION IF EXISTS public._f_wichi_intentos_examenes();
CREATE OR REPLACE FUNCTION public._f_wichi_intentos_examenes() 
 RETURNS VOID AS 
$BODY$
DECLARE 
  _nro_intento smallint;
  _elemento_anterior integer;
  _alumno_anterior integer;
  _llamado_mesa_anterior integer;
  _insertar boolean;
  cur1 record;
        
  BEGIN
  _nro_intento := 1;	
  _elemento_anterior  := NULL;
  _alumno_anterior    := NULL;
  _llamado_mesa_anterior  := NULL;
    		
  DELETE FROM public._wichi_intentos_examenes; 		
  
  -- Recupero los alumnos en actas de examen abiertas y cerradas
  FOR cur1 IN (SELECT d.alumno, a.llamado_mesa, m.elemento, d.fecha
                FROM sga_actas as a,
                     sga_actas_detalle as d, 
                     sga_llamados_mesa as llm,
                     sga_mesas_examen as m
               WHERE a.origen = 'E'
                 -- AND a.tipo_acta = 'N' -- Acta normal
                 AND a.estado = 'C'
                 AND llm.llamado_mesa = a.llamado_mesa
                 AND m.mesa_examen = llm.mesa_examen
                 AND d.id_acta = a.id_acta
                 AND d.instancia IN (3,4,7) -- Regulares / Libres / Examen Complementario
                 AND d.estado = 'A'
                 AND d.rectificado = 'N'
              UNION ALL    
              SELECT d.alumno, a.llamado_mesa, m.elemento, COALESCE(d.fecha, llm.fecha) as fecha
                FROM sga_actas as a,
                     sga_eval_detalle_examenes as d, 
                     sga_llamados_mesa as llm,
                     sga_mesas_examen as m
               WHERE a.origen = 'E'
                 AND a.tipo_acta = 'N' -- Acta normal
                 AND a.estado = 'A'
                 AND llm.llamado_mesa = a.llamado_mesa
                 AND m.mesa_examen = llm.mesa_examen
                 AND d.id_acta = a.id_acta
                 AND d.instancia IN (3,4,7) -- Regulares / Libres / Examen Complementario
              ORDER BY 1, 3, 4)
  LOOP
      _insertar := true;
      IF cur1.alumno = _alumno_anterior AND cur1.elemento = _elemento_anterior THEN
         IF cur1.llamado_mesa = _llamado_mesa_anterior THEN
            _insertar := false;
         ELSE
           _nro_intento := _nro_intento + 1;   
         END IF;
      ELSE
         _nro_intento := 1;
      END IF;

      IF _insertar THEN
        INSERT INTO public._wichi_intentos_examenes (alumno, elemento, llamado_mesa, nro_intento) VALUES (cur1.alumno, cur1.elemento, cur1.llamado_mesa, _nro_intento);
      END IF;
      
	  _elemento_anterior := cur1.elemento;        
	  _alumno_anterior   := cur1.alumno;        
	  _llamado_mesa_anterior  := cur1.llamado_mesa;        
  END LOOP;
	
  -- Actualizo el total de intentos
  
  INSERT INTO public._wichi_tot (alumno,elemento, total_intentos)
    SELECT alumno, elemento, count(*)
      FROM public._wichi_intentos_examenes
    GROUP BY alumno, elemento;  
  
  -- Actualizo el total de intentos de examenes por cada alumno-actividad
  UPDATE public._wichi_intentos_examenes
    SET total_intentos = t.total_intentos
    FROM public._wichi_tot as t
  WHERE t.alumno = public._wichi_intentos_examenes.alumno
    AND t.elemento = public._wichi_intentos_examenes.elemento;  
    
   
  END;
$BODY$
LANGUAGE 'plpgsql' VOLATILE;
-- ++++++++++++++++++++++++++++++ Fin Function _f_wichi_intentos_examenes(integer) ++++++++++++++++

-- Ejecuto la funcion asi llena la tabla 
SELECT * FROM public._f_wichi_intentos_examenes();

-- Borro funcion y tabla temporal de totales
DROP FUNCTION IF EXISTS public._f_wichi_intentos_examenes();
DROP TABLE IF EXISTS public._wichi_tot;

-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Alumnos que promocionaron en comisiones
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS public._wichi_alumnos_promovidos;
CREATE TABLE public._wichi_alumnos_promovidos (comision integer, alumno integer);

INSERT INTO public._wichi_alumnos_promovidos (comision, alumno)
 SELECT sga_actas.comision, sga_actas_detalle.alumno
   FROM sga_actas, sga_actas_detalle
  WHERE sga_actas.origen = 'P' -- Promociones
	AND sga_actas.estado = 'C' -- cerradas
	AND sga_actas_detalle.id_acta = sga_actas.id_acta
	AND sga_actas_detalle.resultado = 'A' -- Alumnos que promocionaron.
	AND sga_actas_detalle.estado = 'A'
	AND sga_actas_detalle.rectificado = 'N';

CREATE INDEX idx_wichi_alumnos_promovidos ON public._wichi_alumnos_promovidos (comision, alumno);


--  -----------------------------------------------------------------------------------
--  -----------------------------------------------------------------------------------
--
-- TABLAS UTILIZADAS EN EXTRACCION DE DATOS DE ALUMNOS ARAUCANO (NUI, REI, EGR)
--
--  -----------------------------------------------------------------------------------
--  -----------------------------------------------------------------------------------

-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Archivos temporales para ser usados en FT_Alumnos.txt
--
-- Año academico: Examenes      -> del turno de examen
--                Promociones   -> del periodo lectivo
--                Equivalencias -> Segun la fecha en que cae dentro del año academico..
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla que registra la historia academica de los alumnos
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS public._wichi_hist_academica;
CREATE TABLE public._wichi_hist_academica (
    id_ha SERIAL NOT NULL,
	alumno INTEGER NOT NULL,
	elemento INTEGER NOT NULL,
	origen char(1) NOT NULL,
	origen_otra_propuesta boolean NOT NULL DEFAULT false,
	fecha date NOT NULL,
	anio_academico INTEGER NOT NULL,
	resultado char(1) NOT NULL,
	comision integer NULL,
	llamado_mesa integer NULL,
	equivalencia integer NULL,
	equivalencia_origen integer NULL,  -- Si es interna, externa...
	equivalencia_automatica char(1)  -- Si es interna, externa...
);


-- Cargo la tabla con Examenes	
INSERT INTO public._wichi_hist_academica (	
	alumno,
	elemento,
	origen,
	origen_otra_propuesta,
	fecha,
	anio_academico,
	resultado,
	llamado_mesa)
SELECT 
	d.alumno,	
	me.elemento,
	a.origen,
	false,
    greatest(d.fecha,'19000101'::date),
	COALESCE(me.anio_academico, p.anio_academico),
	d.resultado,
	a.llamado_mesa
FROM sga_actas as a, 
     sga_actas_detalle as d, 
     sga_llamados_mesa as llm
     LEFT JOIN sga_llamados_turno as llt ON llt.llamado = llm.llamado
     LEFT JOIN sga_periodos as p  ON p.periodo = llt.periodo,
     sga_mesas_examen as me 
WHERE d.id_acta = a.id_acta
  AND llm.llamado_mesa = a.llamado_mesa
  AND me.mesa_examen = llm.mesa_examen
  AND a.origen = 'E'   -- Examenes
  AND a.estado = 'C'   -- Cerradas
  AND d.estado = 'A'   -- Activo
  AND d.rectificado = 'N'   -- No rectificado
  AND d.resultado IN ('A','R') -- Aprobados y Desaprobados
  AND d.instancia IN (3,4,7)  -- Regulares / Libres / Examen Complementario
;


-- Cargo la tabla con Promociones	
INSERT INTO public._wichi_hist_academica (
	alumno,
	elemento,
	origen,
	origen_otra_propuesta,
	fecha,
	anio_academico,
	resultado,
	comision)
SELECT 
	d.alumno,
	com.elemento,
	a.origen,
	false,
    greatest(d.fecha,'19000101'::date),
	p.anio_academico,
	d.resultado,
	a.comision
FROM sga_actas as a, sga_actas_detalle as d, sga_comisiones as com, sga_periodos_lectivos as pl, sga_periodos as p
WHERE d.id_acta = a.id_acta
  AND com.comision = a.comision
  AND pl.periodo_lectivo = com.periodo_lectivo
  AND p.periodo = pl.periodo
  AND a.origen IN ('R','P')   -- Cursadas / Promociones
  AND a.estado = 'C'   -- Cerradas
  AND d.estado = 'A'   -- Activo
  AND d.rectificado = 'N'   -- No rectificado
  AND ((a.origen = 'P' AND d.resultado = 'A') OR     -- Solo los que promocionaron
       (a.origen = 'R' AND d.resultado IN ('A','R'))  -- Cursadas aprobadas / desaprobadas
      )
;  

-- Cargo la tabla con Equivalencias
INSERT INTO public._wichi_hist_academica (
	alumno,
	elemento,
	origen,
	origen_otra_propuesta,
	fecha,
	anio_academico,
	resultado,
	equivalencia,
	equivalencia_automatica)
SELECT 
	t.alumno,	
	e.elemento,
	CASE e.instancia
	  WHEN 10 THEN 'B' -- Equiv total
	  WHEN 11 THEN 'C' -- Equiv de Regularidad
	  WHEN 12 THEN 'D' -- Equiv Parcial
	  WHEN 14 THEN 'Z' -- Equiv de Regularidad - Correlativas
	END as origen,  
	false,
    greatest(e.fecha,'19000101'::date),
	CASE WHEN e.fecha >= to_date(cast(extract(year from greatest(e.fecha,'19000101'::date)) as text) || '0401','YYYYMMDD') 
				THEN extract(year from greatest(e.fecha,'19000101'::date))
	            ELSE extract(year from greatest(e.fecha,'19000101'::date)) - 1
		  END as anio_academico,
	e.resultado,
	e.equivalencia,
	t.generacion_automatica
FROM negocio.sga_equiv_tramite as t, negocio.sga_equiv_otorgada as e
WHERE e.equivalencia_tramite = t.equivalencia_tramite
  AND t.estado = 'C'   -- Cerradas
  AND e.estado = 'A'   -- Activo
  AND e.rectificado = 'N'   -- No rectificado
  AND e.resultado IN ('A','R') -- aprobadas/desaprobadas
;  

-- Cargo Examenes por Aprobacion por Resolucion

INSERT INTO public._wichi_hist_academica (
	alumno,
	elemento,
	origen,
	origen_otra_propuesta,
	fecha,
	anio_academico,
	resultado)
SELECT 
    sga_reconocimiento.alumno AS alumno,
    sga_reconocimiento_act.elemento,
    'A'::bpchar AS origen,
    CASE
            WHEN sga_alumnos.alumno &lt;&gt; alu2.alumno THEN true
            ELSE false
        END AS origen_otra_propuesta,
    greatest(sga_reconocimiento.fecha,'19000101'::date),
    CASE
	    WHEN sga_reconocimiento.fecha >= to_date(cast(extract(year from greatest(sga_reconocimiento.fecha,'19000101'::date)) as text) || '0401','YYYYMMDD') 
			THEN extract(year from greatest(sga_reconocimiento.fecha,'19000101'::date))
	    	ELSE extract(year from greatest(sga_reconocimiento.fecha,'19000101'::date)) - 1
	  END as anio_academico,
    'A'::bpchar AS resultado
    FROM sga_reconocimiento,
    sga_reconocimiento_act,
    sga_alumnos,
    sga_documentos,
    sga_elementos,
    sga_elementos_revision,
    sga_elementos_plan,
    sga_g3entidades_subtipos,
    sga_alumnos alu2
  WHERE sga_reconocimiento_act.nro_tramite = sga_reconocimiento.nro_tramite AND sga_alumnos.alumno = sga_reconocimiento.alumno
 AND sga_documentos.documento = sga_reconocimiento.documento AND sga_reconocimiento.estado = 'C'::bpchar 
AND sga_reconocimiento_act.reconocimiento_total = 'S'::bpchar AND sga_elementos.elemento = sga_reconocimiento_act.elemento 
AND sga_elementos_revision.elemento = sga_elementos.elemento AND sga_elementos_plan.plan_version = alu2.plan_version 
AND sga_elementos_plan.elemento_revision = sga_elementos_revision.elemento_revision 
AND sga_g3entidades_subtipos.entidad_subtipo = sga_elementos.entidad_subtipo AND sga_g3entidades_subtipos.entidad_tipo = 2 
AND alu2.persona = sga_alumnos.persona AND (alu2.alumno = sga_alumnos.alumno OR (alu2.plan_version IN ( SELECT ep2.plan_version
FROM sga_elementos_plan ep2  WHERE ep2.elemento_revision = sga_elementos_revision.elemento_revision)));


-- Creo indice
CREATE INDEX id_wichi_historia_academica1 ON public._wichi_hist_academica (alumno, elemento);
CREATE INDEX id_wichi_historia_academica2 ON public._wichi_hist_academica (alumno, anio_academico, origen, resultado, elemento);
-- CREATE INDEX id_wichi_historia_academica3 ON _wichi_hist_academica (alumno, anio_academico);
-- CREATE INDEX id_wichi_historia_academica4 ON _wichi_hist_academica (alumno, anio_academico, origen);


-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla de alumnos a informar. TOMAR TODOS, TENGAN O NO TITULO ARAUCANO (VER MAPEO NULOS) CHEQUEAR CONDICIONES WHERE

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS public._wichi_alumnos;
CREATE TABLE public._wichi_alumnos (
	alumno INTEGER NOT NULL,
	plan_version INTEGER NOT NULL,
	certificado INTEGER NOT NULL,
	titulo_araucano INTEGER ,
	titulo_nivel varchar(50),
	fecha_egreso DATE,
	anio_academico_egreso integer
);

INSERT INTO public._wichi_alumnos (alumno, plan_version, certificado, titulo_araucano,titulo_nivel)
   SELECT a.alumno, a.plan_version, pc.certificado, t.titulo_araucano, t.titulo_nivel
     FROM sga_alumnos as a, sga_planes_certificados as pc, sga_certificados as t 
    WHERE pc.plan_version = a.plan_version
      AND t.certificado = pc.certificado;

-- Creo indice
CREATE INDEX id_wichi_alumnos1 ON public._wichi_alumnos (alumno);
CREATE INDEX id_wichi_alumnos2 ON public._wichi_alumnos (alumno, certificado);
CREATE INDEX id_wichi_alumnos3 ON public._wichi_alumnos (alumno, titulo_araucano, anio_academico_egreso);

-- Actualizo fecha de egreso en los titulos obtenidos por los alumnos
UPDATE public._wichi_alumnos
   SET fecha_egreso = greatest(co.fecha_egreso,'19000101'::date),
       anio_academico_egreso =    
	                 CASE
	                    WHEN co.fecha_egreso >= to_date(cast(extract(year from greatest(co.fecha_egreso,'19000101'::date)) as text) || '0401','YYYYMMDD') 
							THEN extract(year from greatest(co.fecha_egreso,'19000101'::date))
	                    	ELSE extract(year from greatest(co.fecha_egreso,'19000101'::date)) - 1
		              END    
FROM sga_certificados_otorg as co
WHERE public._wichi_alumnos.alumno = co.alumno
  AND public._wichi_alumnos.certificado = co.certificado;
    


-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla que contiene las actividades de cada certificado en los planes de estudios
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS public._wichi_actividades_x_titulo;
CREATE TABLE public._wichi_actividades_x_titulo (
	plan_version INTEGER NOT NULL,
	certificado INTEGER NOT NULL,
	elemento INTEGER NOT NULL
);

-- Cargo la tabla con los datos de la base
INSERT INTO public._wichi_actividades_x_titulo (plan_version, certificado, elemento)
   SELECT distinct e.* 
     FROM public.get_actividades_x_certificado_plan_version (NULL, NULL) as e (integer, integer, integer);
	 
-- Creo indice
CREATE INDEX _wichi_actividades_x_titulo1 ON public._wichi_actividades_x_titulo (plan_version, certificado);


-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla de cantidad de materias realizadas (promocion/examen/equivalencia) por año academico
-- y cantidad de materias aprobadas.
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
DROP TABLE IF EXISTS public._wichi_ha_x_titulo_anio;
CREATE TABLE public._wichi_ha_x_titulo_anio (
	alumno INTEGER NOT NULL,
	persona INTEGER NOT NULL,
	anio_academico INTEGER NOT NULL,
	certificado INTEGER NOT NULL,
	titulo_araucano INTEGER ,
	titulo_nivel varchar(50),
	cant_act_realizadas INTEGER NOT NULL DEFAULT 0,
	cant_act_aprobadas INTEGER NOT NULL  DEFAULT 0,
	cant_act_realizadas_anio_anterior INTEGER NOT NULL DEFAULT 0,
	cant_act_aprobadas_anio_anterior INTEGER NOT NULL DEFAULT 0,
        cant_act_realizadas_anio_actual INTEGER NOT NULL DEFAULT 0,
	cant_act_aprobadas_anio_actual INTEGER NOT NULL  DEFAULT 0
);


DROP FUNCTION IF EXISTS public._f_wichi_calcular_activides_x_anio();
CREATE OR REPLACE FUNCTION public._f_wichi_calcular_activides_x_anio()
  RETURNS void AS
$BODY$
DECLARE
  cnt smallint;
  c_anio record;
  c_alumno record;
       
  BEGIN

  -- Limpio la tabla
  DELETE FROM public._wichi_ha_x_titulo_anio;

  -- Recorro los años academicos de la base
  FOR c_anio IN SELECT anio_academico FROM sga_anios_academicos
               ORDER BY 1 ASC
  LOOP

         -- Registro totales por año
         INSERT INTO public._wichi_ha_x_titulo_anio (
              alumno, persona, anio_academico, certificado, titulo_araucano,titulo_nivel, cant_act_realizadas_anio_actual, cant_act_realizadas_anio_anterior, cant_act_aprobadas_anio_actual, cant_act_aprobadas_anio_anterior)
             WITH actividades AS (select a.alumno,ha.anio_academico,SUM(CASE WHEN ha.resultado='A' THEN 1 ELSE 0 END) as actividades_aprob,COUNT(*) as actividades_total
									from public._wichi_alumnos as a
									INNER JOIN public._wichi_hist_academica as ha ON ha.alumno = a.alumno and ha.origen IN ('P','E','A','B')
									INNER JOIN public._wichi_actividades_x_titulo as at ON at.plan_version = a.plan_version AND at.certificado = a.certificado AND ha.elemento=at.elemento
									WHERE ha.anio_academico = c_anio.anio_academico OR ha.anio_academico = c_anio.anio_academico-1
									group by a.alumno,ha.anio_academico)
         SELECT a.alumno,
				t.persona,
                c_anio.anio_academico,
                a.certificado,
                a.titulo_araucano,
			    a.titulo_nivel,
                coalesce(activ_anio_acad.actividades_total,0) as cant_act_realizadas_anio_actual,
                coalesce(activ_anio_anterior.actividades_total,0) as cant_act_realizadas_anio_anterior,
                coalesce(activ_anio_acad.actividades_aprob,0) as cant_act_aprobadas_anio_actual,
                coalesce(activ_anio_anterior.actividades_aprob,0) as cant_act_aprobadas_anio_anterior
               FROM public._wichi_alumnos as a
               INNER JOIN public._wichi_ingreso_alumnos as t ON t.alumno = a.alumno
               LEFT JOIN actividades as activ_anio_acad ON activ_anio_acad.alumno = a.alumno and activ_anio_acad.anio_academico=c_anio.anio_academico
			   LEFT JOIN actividades as activ_anio_anterior ON activ_anio_anterior.alumno = a.alumno and activ_anio_anterior.anio_academico=c_anio.anio_academico-1

                    -- solo informo si egreso en el año a informar o despues o no egreso aun por este titulo
              WHERE (a.anio_academico_egreso IS NULL OR a.anio_academico_egreso  >= c_anio.anio_academico)
                -- Solo ingresantes anteriores o en el año a informar
                AND t.anio_academico_propuesta &lt;= c_anio.anio_academico;  -- año academico de ingreso en la propuesta
     
   --   END LOOP; -- Alumnos con ingreso menor o igual al año a evaluar
  END LOOP; -- Años academicos

END;
$BODY$
  LANGUAGE 'plpgsql' VOLATILE
  COST 100;
-- ++++++++++++++++++++++++++++++ Fin Function _f_wichi_calcular_activides_x_anio  ++++++++++++++++

-- REVOKE EXECUTE ON FUNCTION public._f_wichi_calcular_activides_x_anio () FROM public;
GRANT EXECUTE ON FUNCTION public._f_wichi_calcular_activides_x_anio() to public;

-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Calculo cantidad de actividades realizadas por el alumno por año academico
-- Este proceso puede tardar algunos minutos...
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
SELECT * FROM public._f_wichi_calcular_activides_x_anio();
DROP FUNCTION IF EXISTS public._f_wichi_calcular_activides_x_anio();

CREATE INDEX _wichi_ha_alumnos_1 ON public._wichi_ha_x_titulo_anio (alumno);
CREATE INDEX _wichi_ha_persona_1 ON public._wichi_ha_x_titulo_anio (persona);
CREATE INDEX _wichi_ha_anio_1 ON public._wichi_ha_x_titulo_anio (anio_academico);
CREATE INDEX _wichi_ha_anio_alu ON public._wichi_ha_x_titulo_anio (anio_academico,alumno);
CREATE INDEX _wichi_ha_anio_alu_cert ON public._wichi_ha_x_titulo_anio (anio_academico,alumno, certificado);
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Tabla que define por año academico los alumnos segun categoria.
-- categoria_araucano: NUI = Nuevo Inscripto / REI = Reinscripto / EGR = Egresado
-- REI: Considera reinscripto del año académico correspondiente al alumno que realiza
-- por lo menos una actividad académica dentro de las fechas correspondientes (cursadas, examenes, inscripciones, reinscripcion a carrera).
-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

DROP TABLE IF EXISTS public._wichi_actividades_alumno;
CREATE TABLE public._wichi_actividades_alumno (
	id_actividad SERIAL NOT NULL,
	alumno INTEGER NOT NULL,
	anio_academico INTEGER NOT NULL
);

INSERT INTO public._wichi_actividades_alumno (alumno, anio_academico)
 -- inscripciones a cursadas
 SELECT DISTINCT ic.alumno, p.anio_academico 
   FROM public._wichi_alumnos as a, sga_insc_cursada as ic, sga_comisiones as com, sga_periodos_lectivos as pl, sga_periodos as p
  WHERE ic.alumno = a.alumno
    AND com.comision = ic.comision
    AND pl.periodo_lectivo = com.periodo_lectivo
    AND p.periodo = pl.periodo
 UNION
 -- inscripciones a examenes
 SELECT DISTINCT ie.alumno, p.anio_academico 
   FROM public._wichi_alumnos as a, sga_insc_examen as ie, sga_llamados_mesa as llm, sga_llamados_turno as ll, sga_periodos as p
  WHERE ie.alumno = a.alumno
 AND llm.llamado_mesa = ie.llamado_mesa
 AND ll.llamado = llm.llamado
 AND p.periodo = ll.periodo
 UNION	  
 -- reinscripciones a propuestas
 SELECT r.alumno, r.anio_academico
   FROM public._wichi_alumnos as a, sga_reinscripciones as r
  WHERE r.alumno = a.alumno
;

CREATE INDEX idx_wichi_actividades_alumno1 ON public._wichi_actividades_alumno (alumno, anio_academico);


-- Tabla para registrar NUI-Nuevos inscritos REI-Reinscriptos EGR-Egresados
DROP TABLE IF EXISTS public._wichi_nui_rei_egr;
CREATE TABLE public._wichi_nui_rei_egr (
	alumno INTEGER NOT NULL,
	anio_academico INTEGER NOT NULL,
	titulo_araucano INTEGER  ,
	categoria_araucano char(3) NOT NULL);


-- NUEVOS INSCRIPTOS
-- Informo por año academico aquellos alumnos que ingresaron a la propuesta ese año.
INSERT INTO public._wichi_nui_rei_egr (alumno,	anio_academico,	titulo_araucano, categoria_araucano)
   SELECT a.alumno, aa.anio_academico, a.titulo_araucano, 'NUI'
     FROM public._wichi_ingreso_alumnos as ia, 
          public._wichi_alumnos as a,
	  sga_anios_academicos as aa
    WHERE a.alumno = ia.alumno
	  AND (a.titulo_nivel &lt;&gt; 'INTERMEDIO' OR a.titulo_nivel IS NULL)
      AND aa.anio_academico = ia.anio_academico_ciclo_basico -- ia.anio_academico_propuesta
;  



-- REINSCRIPTOS
-- Informo por año academico aquellos que ingresaron en un año anterior y que realizaron alguna actividad academica.
INSERT INTO public._wichi_nui_rei_egr (alumno,	anio_academico,	titulo_araucano, categoria_araucano)
   
    -- Con historia academica en cada año e ingreso en año academico anterior..
    SELECT DISTINCT a.alumno, aa.anio_academico, a.titulo_araucano, 'REI'
     FROM public._wichi_ingreso_alumnos as ia, 
          public._wichi_alumnos as a,
          sga_anios_academicos as aa,
          public._wichi_hist_academica as ha

    WHERE a.alumno = ia.alumno
	  AND (a.titulo_nivel &lt;&gt; 'INTERMEDIO' OR a.titulo_nivel IS NULL)
	  AND ia.anio_academico_ciclo_basico &lt; aa.anio_academico  -- ia.anio_academico_propuesta
          -- que tienen historia academica...
	  AND ha.alumno = a.alumno 
	  AND ha.anio_academico = aa.anio_academico

   UNION  -- No considera los duplicados

   -- Otras actividades realizadas como ser: inscripciones a cursadas/examenes/reinscripciones a propuestas
   SELECT DISTINCT a.alumno, aa.anio_academico, a.titulo_araucano, 'REI'
     FROM public._wichi_ingreso_alumnos as ia, 
          public._wichi_alumnos as a,
          sga_anios_academicos as aa,
          public._wichi_actividades_alumno as act_realizadas 
    WHERE a.alumno = ia.alumno
	  AND (a.titulo_nivel &lt;&gt; 'INTERMEDIO' OR a.titulo_nivel IS NULL)
	  AND ia.anio_academico_ciclo_basico &lt; aa.anio_academico  -- ia.anio_academico_propuesta
	  AND act_realizadas.alumno = a.alumno
	  AND act_realizadas.anio_academico = aa.anio_academico
;				  

-- EGRESADOS de cada titulo
-- Informo por año academico aquellos que egresaron en ese año academico para ese titulo araucano
INSERT INTO public._wichi_nui_rei_egr (alumno,	anio_academico,	titulo_araucano, categoria_araucano)
   SELECT a.alumno, aa.anio_academico, a.titulo_araucano, 'EGR'
     FROM public._wichi_ingreso_alumnos as ia, 
          public._wichi_alumnos as a,
          sga_anios_academicos as aa
    WHERE a.alumno = ia.alumno
      AND a.anio_academico_egreso = aa.anio_academico  -- Solo informo el año academico en que egreso en ese titulo el alumno
      AND ia.anio_academico_ciclo_basico &lt;= aa.anio_academico  -- ia.anio_academico_propuesta
;				  

-- Creo indice
CREATE INDEX _wichi_nui_rei_egr1 ON public._wichi_nui_rei_egr (alumno, anio_academico, titulo_araucano, categoria_araucano);


-- Borro los Reinscriptos que ingresaron ese mismo año. Si es Nuevo Inscripto, no puede ser Reinscripto
DELETE FROM public._wichi_nui_rei_egr
 WHERE categoria_araucano = 'REI'
  AND  cast(alumno as varchar) || '|' || cast(anio_academico as varchar) || '|' || cast( titulo_araucano as varchar) IN 
      (SELECT cast(alumno as varchar) || '|' || cast(anio_academico as varchar) || '|' || cast( titulo_araucano as varchar) 
         FROM public._wichi_nui_rei_egr WHERE categoria_araucano = 'REI' 
       INTERSECT
       SELECT cast(alumno as varchar) || '|' || cast(anio_academico as varchar) || '|' || cast( titulo_araucano as varchar) 
         FROM public._wichi_nui_rei_egr WHERE categoria_araucano = 'NUI' 
      );

----------------------------------------------------------------------------------------------------------------
-------- CALCULA EL NIVEL DE ESTUDIO PADRES
----------------------------------------------------------------------------------------------------------------
DROP TABLE IF EXISTS public.tmp_his_personas_allegados ;
CREATE TABLE public.tmp_his_personas_allegados AS
SELECT dato_censal_allegado, dato_allegado, dato_censal, tipo_allegado, 
       apellido, nombres, calle, numero, piso, departamento, unidad, 
       CASE WHEN localidad = 0 THEN -2 ELSE localidad END as localidad, barrio, codigo_postal, telefono,  CASE WHEN his_personas_allegados.estudio_alcanzado = 12 THEN 13
					 WHEN (his_personas_allegados.estudio_alcanzado is null) THEN 0
					 WHEN (his_personas_allegados.estudio_alcanzado = 13) THEN -2
					 WHEN his_personas_allegados.estudio_alcanzado = 14 THEN 12
					 ELSE his_personas_allegados.estudio_alcanzado
				END AS estudio_alcanzado, 
       trabajo_existe, trabajo_hace, trabajo_ocupacion, trabajo_tarea, 
       trabajo_otro, fecha_alta
  FROM negocio.his_personas_allegados;

DROP TABLE IF EXISTS public._wichi_nivel_estudio_allegados;
CREATE TABLE public._wichi_nivel_estudio_allegados AS
SELECT dato_censal, max(estudio_alcanzado) as estudio_alcanzado, date(fecha_alta) as fecha_alta FROM public.tmp_his_personas_allegados 
WHERE tipo_allegado IN ('P','M','T')
Group by 1,3
ORDER BY 1;

CREATE INDEX IF NOT EXISTS id_wichi_nivel_estudio_allegados1
    ON public._wichi_nivel_estudio_allegados USING btree
    (dato_censal ASC NULLS LAST)
    TABLESPACE pg_default;


-- Function: public.get_nivel_estudio_allegados(integer, date, character)

-- DROP FUNCTION public.get_nivel_estudio_allegados(integer, date, character);

CREATE OR REPLACE FUNCTION public.get_nivel_estudio_allegados(
	ppersona integer,
	pfecha date)
    RETURNS smallint
AS $BODY$
	DECLARE _dato_censal_allegado INTEGER;
	DECLARE _fecha DATE;
	DECLARE _nivel_instruccion SMALLINT;
BEGIN
	_dato_censal_allegado := NULL;
	_fecha := COALESCE(pFecha, CURRENT_DATE);
	_nivel_instruccion := -2; -- Desconoce

	-- Se busca el dato censal más próximo anterior a la fecha.
	SELECT		_wichi_nivel_estudio_allegados.dato_censal INTO _dato_censal_allegado
	FROM		his_datos_censales, _wichi_nivel_estudio_allegados 
	WHERE		his_datos_censales.persona = pPersona AND
				his_datos_censales.dato_censal = _wichi_nivel_estudio_allegados.dato_censal AND
				_wichi_nivel_estudio_allegados.fecha_alta &lt;= _fecha
	ORDER BY	_wichi_nivel_estudio_allegados.fecha_alta DESC
	LIMIT		1;

	IF _dato_censal_allegado IS NULL THEN
		-- Busco el dato censal más próximo siguiente a la fecha.
		SELECT		_wichi_nivel_estudio_allegados.dato_censal INTO _dato_censal_allegado
		FROM		his_datos_censales, _wichi_nivel_estudio_allegados 
		WHERE		his_datos_censales.persona = pPersona AND
					his_datos_censales.dato_censal = _wichi_nivel_estudio_allegados.dato_censal AND
					_wichi_nivel_estudio_allegados.fecha_alta > _fecha
		ORDER BY	_wichi_nivel_estudio_allegados.fecha_alta
		LIMIT		1;
	END IF;

	IF _dato_censal_allegado IS NOT NULL THEN
		SELECT	estudio_alcanzado INTO _nivel_instruccion FROM	_wichi_nivel_estudio_allegados
		WHERE	_wichi_nivel_estudio_allegados.dato_censal = _dato_censal_allegado;
	END IF;

	RETURN _nivel_instruccion;
END;
$BODY$
LANGUAGE plpgsql VOLATILE;

GRANT EXECUTE ON FUNCTION public.get_nivel_estudio_allegados(integer, date) TO public;


