UPDATE public._wichi_datos_censales cd SET hs_trabajo_situacion_alumno = get_horas_trabajo_araucano(persona, date(anio_academico + 1 ||'-03-31'));
UPDATE public._wichi_datos_censales cd SET estado_civil = get_estado_civil(persona,date(anio_academico + 1 ||'-03-31'));
UPDATE public._wichi_datos_censales cd SET localidad_per_lec = get_localidad_per_lec(persona,date(anio_academico + 1 ||'-03-31'));
UPDATE public._wichi_datos_censales cd SET localidad_proc = get_localidad_proc(persona,date(anio_academico + 1 ||'-03-31'));
UPDATE public._wichi_datos_censales cd SET costeo_estudios = get_costeo_estudios(persona,date(anio_academico + 1 ||'-03-31'));
UPDATE public._wichi_datos_censales cd SET beca = get_beca(persona,date(anio_academico + 1 ||'-03-31'));
UPDATE public._wichi_datos_censales cd SET tecno_internet = get_tecno_internet(persona,date(anio_academico + 1 ||'-03-31'));
UPDATE public._wichi_datos_censales cd SET tecno_pc = get_tecno_pc(persona,date(anio_academico + 1 ||'-03-31'));
UPDATE public._wichi_datos_censales cd SET idioma = get_idioma(persona,date(anio_academico + 1 ||'-03-31'));
