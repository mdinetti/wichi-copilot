  <parameters>
    <parameter>
      <name>carga_bloquear_actualizacion</name>
      <default_value>0</default_value>
      <description>si es 1 y en wichi existen datos para el periodo, detiene la ejecución</description>
    </parameter>
    <parameter>
      <name>carga_comentario</name>
      <default_value/>
      <description>(Opcional) </description>
    </parameter>
    <parameter>
      <name>carga_directorioTemporal</name>
      <default_value>/tmp/wichi</default_value>
      <description>directorio temporal vacío para armado del paquete</description>
    </parameter>
    <parameter>
      <name>carga_instalacion</name>
      <default_value/>
      <description>Número de instalación en formato id-codigo</description>
    </parameter>
    <parameter>
      <name>carga_periodo</name>
      <default_value>0</default_value>
      <description>&lt;AAAA> año al que corresponden los datos importados ej:2012</description>
    </parameter>
    <parameter>
      <name>carga_solo_actualizacion</name>
      <default_value>0</default_value>
      <description>si es 1 y en wichi NO existen datos para el periodo, detiene la ejecución</description>
    </parameter>
    <parameter>
      <name>fuente_clave</name>
      <default_value>__SIN_VALOR___x1tljQ7imSqp_fBnDme5M2WZBADj0iuK</default_value>
      <description>contraseña de la base de datos del sistema fuente</description>
    </parameter>
    <parameter>
      <name>fuente_host</name>
      <default_value>localhost</default_value>
      <description>IP o nombre del host donde se encuentra la base de datos del sistema fuente</description>
    </parameter>
    <parameter>
      <name>fuente_nombre</name>
      <default_value>sq</default_value>
      <description>nombre de la base de datos del sistema fuente</description>
    </parameter>
    <parameter>
      <name>fuente_puerto</name>
      <default_value>5432</default_value>
      <description>puerto de la base de datos del sistema fuente</description>
    </parameter>
    <parameter>
      <name>fuente_usuario</name>
      <default_value>postgres</default_value>
      <description>usuario de la base de datos del sistema fuente</description>
    </parameter>
    <parameter>
      <name>paquete_directorio</name>
      <default_value/>
      <description>(Opcional) si se especifica, al terminar deja una copia del paquete de datos wichi</description>
    </parameter>
    <parameter>
      <name>paquete_encriptacion</name>
      <default_value>ninguna</default_value>
      <description>tipo de encriptación: publica|ninguna</description>
    </parameter>
    <parameter>
      <name>paquete_passPgp</name>
      <default_value/>
      <description>(Opcional)</description>
    </parameter>
    <parameter>
      <name>paquete_rutaGpg</name>
      <default_value>/usr/bin/gpg</default_value>
      <description>ruta al ejecutable de gpg</description>
    </parameter>
    <parameter>
      <name>paquete_userIdServidorCentral</name>
      <default_value/>
      <description>user ID de gpg del servidor central Wichi</description>
    </parameter>
    <parameter>
      <name>paquete_wildcardPgp</name>
      <default_value/>
      <description>Generalmente se puede dejar vacío</description>
    </parameter>
    <parameter>
      <name>performance_commit_size</name>
      <default_value>10000</default_value>
      <description>cada cuantos insert se hace commit</description>
    </parameter>
  </parameters>
