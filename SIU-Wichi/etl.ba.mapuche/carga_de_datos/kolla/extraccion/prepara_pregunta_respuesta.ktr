  <step>
    <name>prepara respuestas multiples</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_fuente</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>CREATE TABLE IF NOT EXISTS kolla.temp_multiples&#xa;&#x28;&#xa;  encuesta_codigo varchar,&#xa;  pregunta_codigo varchar,&#xa;  pregunta_desc varchar,&#xa;  respuesta_codigo varchar,&#xa;  respuesta_desc varchar,&#xa;  respuesta_codigo_combinado varchar&#xa;&#x29;&#x3b;&#xa;TRUNCATE TABLE kolla.temp_multiples&#x3b;&#xa;&#xa;-- Selecciona todas las respuestas concatenando las multiples en una sola combinacion que arma todas las posibilidades de respuestas existentes.&#xa;INSERT INTO kolla.temp_multiples&#xa;SELECT DISTINCT &#xa;  rd.respondido_encuesta AS encuesta_codigo, &#xa;  pr.pregunta AS pregunta_codigo, &#xa;  &#x27;&#x27; AS pregunta_desc,&#xa;  array_to_string&#x28;array_agg&#x28;rd.respuesta_codigo ORDER BY pr.orden&#x29;, &#x27;-&#x2f;-&#x27;&#x29; as respuesta_codigo,&#xa;  array_to_string&#x28;array_agg&#x28;replace&#x28;r.valor_tabulado, &#x27;&#x22;&#x27;, &#x27;&#xb4;&#x27;&#x29; ORDER BY pr.orden&#x29;, &#x27; -&#x2f;- &#x27;&#x29; as respuestas_desc,  &#xa;  array_to_string&#x28;array_agg&#x28;rd.respuesta_codigo ORDER BY pr.orden&#x29;, &#x27;-&#x2f;-&#x27;&#x29; as respuesta_codigo_combinado&#xa;FROM kolla.sge_respondido_detalle rd, kolla.sge_pregunta_respuesta pr, kolla.sge_encuesta_definicion ed,&#xa; kolla.sge_respuesta r, &#x28;select distinct encuesta_codigo from kolla.temp_encuestas&#x29; tmp&#xa;WHERE tmp.encuesta_codigo &#x3d; ed.encuesta &#xa;  AND rd.respuesta_codigo&#x3d;pr.respuesta &#xa;and rd.encuesta_definicion&#x3d;ed.encuesta_definicion AND ed.pregunta&#x3d;pr.pregunta&#xa;and rd.respuesta_codigo&#x3d;r.respuesta&#xa;and rd.respuesta_codigo&#x3e;0 AND rd.respuesta_codigo is not null&#xa;GROUP BY 1,2&#x3b;&#xa;&#xa;-- Borra todas las respuestas unicas ya que estan cargadas antes.&#xa;DELETE FROM kolla.temp_multiples WHERE respuesta_codigo_combinado not like&#x28;&#x27;&#x25;-&#x2f;-&#x25;&#x27;&#x29;&#x3b;&#xa;</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
    </arguments>
