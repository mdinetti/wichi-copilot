  <step>
    <name>Ejecutar script SQL</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <sql>SELECT DISTINCT&#xa; instalacion_id,&#xa; pregunta_codigo,&#xa; &#x27;&#x27; AS pregunta_desc,&#xa; encuestado_codigo,&#xa; unnest&#x28;string_to_array&#x28;respuesta_codigo,&#x27;-&#x2f;-&#x27;&#x29;&#x29; AS respuesta_codigo,&#xa; &#x27;&#x27; AS respuesta_desc&#xa;INTO TEMP temp_multiples&#xa;FROM kolla_tmp.ft_encuesta_datos &#xa;WHERE respuesta_codigo like &#x27;&#x25;-&#x2f;-&#x25;&#x27;&#x3b;&#xa;&#xa;UPDATE temp_multiples tmp&#xa;SET pregunta_desc &#x3d; &#xa;    &#x28;SELECT DISTINCT pregunta_desc &#xa;     FROM kolla_tmp.d_pregunta_respuesta pr&#xa;     WHERE pr.instalacion_id&#x3d;tmp.instalacion_id AND tmp.pregunta_codigo&#x3d;pr.pregunta_codigo&#x29;&#x3b;&#xa;&#xa;UPDATE temp_multiples tmp&#xa;SET respuesta_desc&#x3d;&#xa;    &#x28;SELECT respuesta_desc &#xa;     FROM kolla_tmp.d_pregunta_respuesta pr&#xa;     WHERE tmp.instalacion_id&#x3d;pr.instalacion_id AND tmp.pregunta_codigo&#x3d;pr.pregunta_codigo AND tmp.respuesta_codigo&#x3d;pr.respuesta_codigo&#x29;&#x3b;&#xa;&#xa;SELECT DISTINCT&#xa; instalacion_id,&#xa; pregunta_codigo,&#xa; pregunta_desc,&#xa; encuestado_codigo,&#xa; &#x27;-2&#x27; as respuesta_codigo,&#xa; array_to_string&#x28;array_agg&#x28;respuesta_desc ORDER BY respuesta_codigo&#x29;, &#x27; -&#x2f;- &#x27;&#x29; as respuesta_desc,&#xa; array_to_string&#x28;array_agg&#x28;respuesta_codigo ORDER BY respuesta_codigo&#x29;, &#x27;-&#x2f;-&#x27;&#x29; as respuesta_codigo_combinado&#xa;INTO TEMP temp_multiples_concatenadas&#xa;FROM temp_multiples&#xa;GROUP BY 1,2,3,4,5&#x3b;&#xa;&#xa;DELETE FROM temp_multiples_concatenadas&#xa;WHERE &#x28;instalacion_id,pregunta_codigo, respuesta_codigo, respuesta_codigo_combinado&#x29; IN &#xa;&#x28;SELECT instalacion_id,pregunta_codigo, respuesta_codigo, respuesta_codigo_combinado FROM kolla_tmp.d_pregunta_respuesta&#x29;&#x3b;&#xa;&#xa;INSERT INTO kolla_tmp.d_pregunta_respuesta &#x28;instalacion_id, pregunta_codigo, pregunta_desc, respuesta_codigo, respuesta_desc, respuesta_codigo_combinado&#x29;&#xa;SELECT DISTINCT instalacion_id, pregunta_codigo, pregunta_desc, respuesta_codigo, respuesta_desc, respuesta_codigo_combinado&#xa;FROM temp_multiples_concatenadas&#x3b;</sql>
    <set_params>N</set_params>
