  <step>
    <name>fechas</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_mapuche</connection>
    <sql>SELECT	per_anoct as ano_per_act, &#xa;	per_mesct as mes_per_act,&#xa;    per_anoct&#x2a;100 &#x2b; per_mesct AS periodo_info,&#xa;    CASE WHEN per_mesct &#x3e;&#x3d;9 AND per_mesct &#x3c; 12 THEN per_anoct&#x3a;&#x3a;TEXT&#x7c;&#x7c;&#x28;per_mesct&#x2b;1&#x29;&#x3a;&#x3a;TEXT&#x7c;&#x7c;&#x27;01&#x27; &#xa;	WHEN per_mesct &#x3c; 12 THEN per_anoct&#x3a;&#x3a;TEXT&#x7c;&#x7c;&#x27;0&#x27;&#x7c;&#x7c;&#x28;per_mesct&#x2b;1&#x29;&#x3a;&#x3a;TEXT&#x7c;&#x7c;&#x27;01&#x27; &#xa;	ELSE &#x28;per_anoct&#x2b;1&#x29;&#x3a;&#x3a;TEXT&#x7c;&#x7c;&#x27;0101&#x27;&#xa;	END AS periodo_actual&#xa;FROM	mapuche.dh99&#x3b;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
