<job>
  <name>extraccion_guarani_compartidos</name>
    <description/>
    <extended_description/>
    <job_version/>
    <job_status>0</job_status>
  <directory>&#x2f;</directory>
  <created_user>-</created_user>
  <created_date>2017&#x2f;03&#x2f;02 10&#x3a;23&#x3a;01.764</created_date>
  <modified_user>-</modified_user>
  <modified_date>2017&#x2f;03&#x2f;02 10&#x3a;23&#x3a;01.764</modified_date>
    <parameters>
        <parameter>
            <name>commit_size</name>
            <default_value>10000</default_value>
            <description>cada cuantos insert se hace commit</description>
        </parameter>
        <parameter>
            <name>directorioTxt</name>
            <default_value>&#x2f;home&#x2f;wichi&#x2f;guarani3&#x2f;txt</default_value>
            <description>directorio temporal donde se van a crear los txt extraidos de la base</description>
        </parameter>
        <parameter>
            <name>encriptacion</name>
            <default_value>ninguna</default_value>
            <description>tipo de encriptaci&#xf3;n&#x3a; publica&#x7c;ninguna</description>
        </parameter>
        <parameter>
            <name>fuente_host</name>
            <default_value>localhost</default_value>
            <description>IP o nombre del host donde se encuentra la base de datos del sistema fuente</description>
        </parameter>
        <parameter>
            <name>fuente_nombre</name>
            <default_value>guarani</default_value>
            <description>nombre de la base de datos del sistema fuente</description>
        </parameter>
        <parameter>
            <name>fuente_pass</name>
            <default_value/>
            <description>contrase&#xf1;a de la base de datos del sistema fuente</description>
        </parameter>
        <parameter>
            <name>fuente_puerto</name>
            <default_value>5432</default_value>
            <description>puerto de la base de datos del sistema fuente</description>
        </parameter>
        <parameter>
            <name>fuente_usuario</name>
            <default_value>postgres</default_value>
            <description>usuario de la base de datos del sistema fuente</description>
        </parameter>
        <parameter>
            <name>instalacion_id</name>
            <default_value/>
            <description>&#x28;Opcional&#x29; id de la instalacion </description>
        </parameter>
        <parameter>
            <name>passPgp</name>
            <default_value/>
            <description>&#x28;Opcional&#x29;</description>
        </parameter>
        <parameter>
            <name>periodo</name>
            <default_value>0</default_value>
            <description>&#x3c;AAAA&#x3e; per&#xed;odo a extraer, o 0&#x3d;todos</description>
        </parameter>
        <parameter>
            <name>rutaGpg</name>
            <default_value>&#x2f;usr&#x2f;bin&#x2f;gpg</default_value>
            <description>ruta al ejecutable de gpg</description>
        </parameter>
        <parameter>
            <name>userIdServidorCentral</name>
            <default_value/>
            <description>user ID de gpg del servidor central Wichi</description>
        </parameter>
        <parameter>
            <name>wildcardPgp</name>
            <default_value/>
            <description>Generalmente se puede dejar vac&#xed;o</description>
        </parameter>
    </parameters>
    <slaveservers>
    </slaveservers>
