  <step>
    <name>alumnos</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_guarani</connection>
    <sql>-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;-- Generaci&#xf3;n del archivo LT_Alumnos.txt&#xa;--&#xa;-- A&#xf1;o de ingreso&#x3a; Si tiene ciclo basico, entonces ingreso al ciclo basico sino el ingreso en la propuesta.&#xa;-- Devuelve los datos por &#x22;a&#xf1;o academico &#x2b; alumno &#x28;x propuesta&#x29; &#x2b; titulo araucano&#x22;&#xa;-- &#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#x2b;&#xa;With ha as &#x28;SELECT &#x2a; FROM _wichi_ha_x_titulo_anio WHERE anio_academico &#x3d; &#x3f;&#x29;&#xa;SELECT distinct&#xa;	ha.anio_academico,&#xa;	sga_alumnos.plan_version,&#xa;	sga_alumnos.propuesta as propuesta_formativa,&#xa;	sga_alumnos.ubicacion,&#xa;	ha.titulo_araucano as titulo_araucano,&#xa;	&#x28;CASE mdp_personas.sexo WHEN &#x27;M&#x27; THEN 1 WHEN &#x27;F&#x27; THEN 2 END&#x29; as sexo,&#xa;	ingreso.anio_academico_ciclo_basico as anio_ingreso_propuesta ,      -- a&#xf1;o de ingresoal ciclo basico. si no tiene ciclo basico muestra el de la propuesta&#xa;	&#x28;SELECT CASE WHEN mdp_datos_estudios.nivel_estudio &#x3d; 3 THEN mdp_datos_estudios.colegio &#xa;			ELSE NULL END&#xa;		FROM mdp_datos_estudios &#xa;		WHERE mdp_datos_estudios.persona &#x3d; mdp_personas.persona&#xa;		LIMIT 1&#x29; as colegio_id,&#xa;	ha.cant_act_realizadas as cant_rendidas, &#xa;	ha.cant_act_aprobadas as cant_aprobadas, &#xa;	ha.cant_act_realizadas_anio_anterior as cant_rendidas_anio_anterior, &#xa;	ha.cant_act_aprobadas_anio_anterior as cant_aprobadas_anio_anterior, &#xa;	concat&#x28;&#x27;select get_horas_trabajo_araucano&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;ha.anio_academico &#x2b; 1 &#x7c;&#x7c;&#x27;-03-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_hs_trabajo_situacion_alumno,&#xa;    --ingreso.tipo_ingreso_propuesta,&#xa;   &#x27;SELECT public.get_forma_ingreso_interfaces_corta&#x28;&#x27;&#x7c;&#x7c;ha.alumno&#x7c;&#x7c;&#x27;,&#x27;&#x7c;&#x7c;ingreso.anio_academico_propuesta&#x7c;&#x7c;&#x27;&#x29;&#x3b;&#x27; query_forma_ingreso,&#xa;    &#x28;CASE WHEN fecha_nacimiento IS NULL THEN NULL ELSE &#x28;&#xa;		extract&#x28;year from age&#x28;date &#x28;ha.anio_academico &#x7c;&#x7c;&#x27;-12-31&#x27;&#x29;, fecha_nacimiento&#x29;&#x29;&#xa;	&#x29; END&#x29; as edad,&#xa;    ha.alumno as alumno,&#xa;	mdp_personas.nacionalidad,&#xa;	sga_alumnos.calidad,&#xa;	&#x28;SELECT	COALESCE&#x28;min&#x28;trabajo_existe&#x29;,4&#x29; FROM mdp_personas_allegados&#xa;	WHERE tipo_allegado IN &#x28;&#x27;P&#x27;,&#x27;M&#x27;,&#x27;T&#x27;&#x29; AND mdp_personas_allegados.persona &#x3d; sga_alumnos.persona&#x29; as max_trabajo_padres,&#xa;	&#x28;SELECT max&#x28;estudio_alcanzado&#x29; FROM _wichi_nivel_estudio_allegados &#xa;	WHERE _wichi_nivel_estudio_allegados.persona &#x3d; sga_alumnos.persona&#x29; as max_estudio_padres,&#xa;	sga_alumnos.persona,&#xa;	concat&#x28;&#x27;select get_estado_civil&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;ha.anio_academico &#x2b; 1 &#x7c;&#x7c;&#x27;-03-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_estado_civil,&#xa;	concat&#x28;&#x27;select get_localidad_per_lec&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;ha.anio_academico &#x2b; 1 &#x7c;&#x7c;&#x27;-03-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_per_lec,&#xa;	concat&#x28;&#x27;select get_localidad_proc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;ha.anio_academico &#x2b; 1 &#x7c;&#x7c;&#x27;-03-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_localidad_proc,&#xa;	concat&#x28;&#x27;select get_costeo_estudios&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;ha.anio_academico &#x2b; 1 &#x7c;&#x7c;&#x27;-03-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_costeo_estudios,&#xa;	concat&#x28;&#x27;select get_beca&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;ha.anio_academico &#x2b; 1 &#x7c;&#x7c;&#x27;-03-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_beca,&#xa;	concat&#x28;&#x27;select get_tecno_internet&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;ha.anio_academico &#x2b; 1 &#x7c;&#x7c;&#x27;-03-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_internet,&#xa;	concat&#x28;&#x27;select get_tecno_pc&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;ha.anio_academico &#x2b; 1 &#x7c;&#x7c;&#x27;-03-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_tecno_pc,&#xa;	concat&#x28;&#x27;select get_idioma&#x28;&#x27;,sga_alumnos.persona, &#x27;,&#x2a;&#x27;,date&#x28;ha.anio_academico &#x2b; 1 &#x7c;&#x7c;&#x27;-03-31&#x27;&#x29;,&#x27;&#x2a;&#x29;&#x27;&#x29; as query_idioma,&#xa;	0 as discapacidad,&#xa;    ingreso.situacion_asp,&#xa;    &#x28;CASE WHEN nui.alumno IS NOT NULL THEN 1 ELSE NULL END&#x29; as nuevos_inscriptos,&#xa;    &#x28;CASE WHEN rei.alumno IS NOT NULL THEN 1 ELSE NULL END&#x29; as reinscriptos,&#xa;    &#x28;CASE WHEN egr.alumno IS NOT NULL THEN 1 ELSE NULL END&#x29; as egresados,&#xa;	0 as campo_cero&#xa;FROM&#xa;    _wichi_alumnos alu JOIN ha ON &#x28;ha.alumno &#x3d; alu.alumno AND ha.certificado &#x3d; alu.certificado&#x29;&#xa;    LEFT JOIN _wichi_nui_rei_egr nui ON &#x28;nui.alumno &#x3d; ha.alumno AND nui.anio_academico &#x3d; ha.anio_academico AND &#x28;ha.titulo_nivel &#x3c;&#x3e; &#x27;INTERMEDIO&#x27; OR ha.titulo_nivel IS NULL&#x29; AND &#x28;nui.titulo_araucano &#x3d; ha.titulo_araucano OR ha.titulo_araucano IS NULL&#x29; AND nui.categoria_araucano &#x3d; &#x27;NUI&#x27;&#x29;&#xa;    LEFT JOIN _wichi_nui_rei_egr rei ON &#x28;rei.alumno &#x3d; ha.alumno AND rei.anio_academico &#x3d; ha.anio_academico AND &#x28;ha.titulo_nivel &#x3c;&#x3e; &#x27;INTERMEDIO&#x27; OR ha.titulo_nivel IS NULL&#x29; AND &#x28;rei.titulo_araucano &#x3d; ha.titulo_araucano OR ha.titulo_araucano IS NULL&#x29; AND rei.categoria_araucano &#x3d; &#x27;REI&#x27;&#x29;&#xa;    LEFT JOIN _wichi_nui_rei_egr egr ON &#x28;egr.alumno &#x3d; ha.alumno AND egr.anio_academico &#x3d; ha.anio_academico  AND &#x28;egr.titulo_araucano &#x3d; ha.titulo_araucano OR ha.titulo_araucano IS NULL&#x29; AND egr.categoria_araucano &#x3d; &#x27;EGR&#x27;&#x29;&#xa;    LEFT JOIN _wichi_ingreso_alumnos ingreso ON &#x28;ingreso.alumno &#x3d; alu.alumno&#x29;&#xa;    LEFT JOIN sga_alumnos ON &#x28;sga_alumnos.alumno &#x3d; alu.alumno&#x29;,&#xa;    mdp_personas&#xa;WHERE mdp_personas.persona &#x3d; sga_alumnos.persona&#xa; and &#x28;&#xa;        nui.alumno IS NOT NULL or&#xa;        rei.alumno IS NOT NULL or&#xa;        egr.alumno IS NOT NULL&#xa; &#x29;</sql>
    <limit/>
    <lookup>Select values</lookup>
    <execute_each_row>Y</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
