        <default_value/>
        </field>
      </fields>
    <use_formatting>Y</use_formatting>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>489</xloc>
      <yloc>250</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>MINANIOACADEMICO</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <fields>
      <field>
        <field_name>minanioacademico</field_name>
        <variable_name>MINANIOACADEMICO</variable_name>
        <variable_type>ROOT_JOB</variable_type>
        <default_value/>
        </field>
      </fields>
    <use_formatting>Y</use_formatting>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>487</xloc>
      <yloc>131</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>gua_dsa_anioacademico_actual</name>
    <type>TableInput</type>
    <description>Obtiene el a&#xf1;o actual</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT EXTRACT&#x28;YEAR from CURRENT_DATE&#x29; as anioactual</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>240</xloc>
      <yloc>250</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>gua_dsa_minima_anioacademico</name>
    <type>TableInput</type>
    <description>Obtiene el m&#xed;nimo a&#xf1;o de ingreso que hay cargado hasta el momento en guarani.gua_dsa_ids_lt_anioacademico</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT min&#x28;minanioacademico&#x29; as minanioacademico&#xa;FROM&#x28;&#xa;SELECT&#xa;  min&#x28;anioacademico&#x29; as minanioacademico&#xa;FROM guarani_dsa.gua_dsa_ids_lt_anioacademico&#xa;WHERE anioacademico &#x3c;&#x3e; -1&#xa;&#xa;UNION &#xa;&#xa;SELECT&#xa;  min&#x28;cast&#x28;anioacademico as integer&#x29;&#x29; as minanioacademico&#xa;FROM guarani_tmp.gua_dsa_ft_alumnosarau&#xa;&#xa;UNION&#xa;&#xa;SELECT&#xa;  min&#x28;cast&#x28;anioacademico as integer&#x29;&#x29; as minanioacademico&#xa;FROM guarani_tmp.gua_dsa_ft_cursado&#xa;&#xa;UNION&#xa;&#xa;SELECT&#xa;  min&#x28;cast&#x28;anioacademico as integer&#x29;&#x29; as minanioacademico&#xa;FROM guarani_tmp.gua_dsa_ft_equivalencia&#xa;&#xa;UNION&#xa;&#xa;SELECT&#xa;  min&#x28;cast&#x28;anioacademico as integer&#x29;&#x29; as minanioacademico&#xa;FROM guarani_tmp.gua_dsa_ft_examen&#xa;&#xa;UNION&#xa;&#xa;SELECT&#xa;  min&#x28;cast&#x28;anioacademico as integer&#x29;&#x29; as minanioacademico&#xa;FROM guarani_tmp.gua_dsa_ft_procedenciaaspirantes&#xa;&#xa;UNION&#xa;&#xa;SELECT EXTRACT&#x28;YEAR from CURRENT_DATE&#x29; -1 as minanioacademico&#xa;&#xa;&#x29; a</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>238</xloc>
      <yloc>131</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step_error_handling>
  </step_error_handling>
   <slave-step-copy-partition-distribution>
</slave-step-copy-partition-distribution>
   <slave_transformation>N</slave_transformation>

</transformation>
