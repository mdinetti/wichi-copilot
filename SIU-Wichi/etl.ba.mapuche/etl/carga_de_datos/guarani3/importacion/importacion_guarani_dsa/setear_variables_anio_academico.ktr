  <connection>
    <name>siu_dsa</name>
    <server>&#x24;&#x7b;dsa_nombrehost&#x7d;</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>&#x24;&#x7b;dsa_nombrebase&#x7d;</database>
    <port>&#x24;&#x7b;dsa_puerto&#x7d;</port>
    <username>&#x24;&#x7b;dsa_usuario&#x7d;</username>
    <password>&#x24;&#x7b;dsa_clave&#x7d;</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>&#x24;&#x7b;dsa_puerto&#x7d;</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SQL_CONNECT</code><attribute>SET datestyle to iso,YMD</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>N</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
  <hop> <from>gua_dsa_minima_anioacademico</from><to>MINANIOACADEMICO</to><enabled>Y</enabled> </hop>
  <hop> <from>gua_dsa_anioacademico_actual</from><to>ANIOACTUAL</to><enabled>Y</enabled> </hop>
  </order>
  <step>
    <name>ANIOACTUAL</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
