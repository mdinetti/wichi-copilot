  <step>
    <name>obtiene el texto del esquema</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT distinct -1, -1, replace&#x28;s.texto,&#x27;&#x40;1&#x27;,i.instalacion_codigo&#x29; AS texto&#xa; FROM public.d_instalacion i, kolla_tmp.aux_strings s&#xa; WHERE i.instalacion_id&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;int AND s.tipo&#x3d;&#x27;esquema-inicio&#x27; &#xa;UNION &#xa;SELECT distinct e.encuesta_codigo&#x3a;&#x3a;integer, -1, &#xa;  replace&#x28;replace&#x28;replace&#x28;replace&#x28;s.texto,&#x27;&#x40;2&#x27;,&#x27;&#x28;&#x27; &#x7c;&#x7c; &#x28;SELECT array_to_string&#x28;array_agg&#x28;e2.encuesta_id ORDER BY 1&#x29;,&#x27;, &#x27;&#x29; FROM kolla.d_encuesta e2 WHERE e2.encuesta_codigo&#x3d;e.encuesta_codigo&#x29; &#x7c;&#x7c; &#x27;&#x29;&#x27;&#x29;,&#xa;  &#x27;&#x40;1&#x27;,regexp_replace&#x28;regexp_replace&#x28;translate&#x28;e.encuesta_desc,s_e.texto, s_n.texto&#x29;, &#x27;&#x5b;&#x5e;a-zA-Z0-9&#x3f;&#x5d;&#x27;, &#x27; &#x27;, &#x27;g&#x27;&#x29;, &#x27;&#x28;&#x28; &#x29;&#x7b;2,&#x7d;&#x7c;&#x5c;t&#x2b;&#x29;&#x27;, &#x27; &#x27;, &#x27;g&#x27;&#x29;&#x29;,&#x27;&#x40;3&#x27;,&#x27;&#x28;&#x27; &#x7c;&#x7c; e.encuesta_codigo &#x7c;&#x7c; &#x27;&#x29;&#x27;&#x29;,&#x27;&#x40;4&#x27;,&#x27;&#x28;&#x27; &#x7c;&#x7c; e.unidad_gestion_desc &#x7c;&#x7c; &#x27;&#x29;&#x27;&#x29; AS texto&#xa; FROM kolla.d_encuesta e, kolla_tmp.aux_strings s, kolla_tmp.aux_strings s_n, kolla_tmp.aux_strings s_e   &#xa; WHERE e.instalacion_id&#x3a;&#x3a;integer&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;integer AND&#xa;  s.tipo&#x3d;&#x27;cubo-inicio&#x27; AND s_n.tipo&#x3d;&#x27;caracteres-normales&#x27; AND s_e.tipo&#x3d;&#x27;caracteres-especiales&#x27; AND&#xa;  e.encuesta_id IN &#x28;SELECT distinct encuesta_id FROM kolla.ft_entrevista entrevistas WHERE entrevistas.instalacion_id&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;integer&#x29;&#xa;UNION&#xa;SELECT distinct e.encuesta_codigo&#x3a;&#x3a;integer, 0, &#xa;  s.texto AS texto&#xa; FROM kolla.d_encuesta e, kolla_tmp.aux_strings s   &#xa; WHERE e.instalacion_id&#x3a;&#x3a;integer&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;integer AND&#xa;  s.tipo&#x3d;&#x27;cubo-inicio-elemento&#x27; AND &#xa;  e.encuesta_id IN &#x28;SELECT distinct encuesta_id &#xa;                         FROM kolla.ft_entrevista entrevistas &#xa;                         WHERE entrevistas.instalacion_id&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;integer AND&#xa;                               entrevistas.elemento_id&#x3e;0&#x29;&#xa;UNION &#xa;SELECT distinct&#xa;  e.encuesta_codigo&#x3a;&#x3a;integer, &#xa;  pos.posicion&#x3a;&#x3a;integer,&#xa;  replace&#x28;replace&#x28;replace&#x28;replace&#x28;replace&#x28;replace&#x28;replace&#x28;s.texto,&#x27;&#x40;90&#x27;,translate&#x28;pos.bloque_nombre,s_e.texto, s_n.texto&#x29;&#x7c;&#x7c;&#x27;&#x26;&#x23;13&#x3b;&#x26;&#x23;10&#x3b;&#x27;&#x7c;&#x7c;translate&#x28;coalesce&#x28;pos.siete_pregunta_nombre,&#x27;&#x27;&#x29;,s_e.texto, s_n.texto&#x29;&#x29;,&#x27;&#x40;6&#x27;,case when pos.bloque_codigo&#x3a;&#x3a;integer &#x25; 2 &#x3d; 0 then &#x27;&#x23;1d891d&#x3b;&#x27; else &#x27;&#x23;372476&#x3b;&#x27; end&#x29;,&#x27;&#x40;5&#x27;,lpad&#x28;pos.posicion,4,&#x27;0&#x27;&#x29;&#x29;,&#x27;&#x40;4&#x27;,substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x29;,&#x27;&#x40;3&#x27;, pr.pregunta_codigo&#x3a;&#x3a;text&#x29;,&#x27;&#x40;1&#x27;,pos.posicion&#x29;,&#x27;&#x40;2&#x27;,regexp_replace&#x28;regexp_replace&#x28;translate&#x28;pr.pregunta_desc,s_e.texto, s_n.texto&#x29;, &#x27;&#x5b;&#x5e;a-zA-Z0-9&#x3f;&#x5d;&#x27;, &#x27; &#x27;, &#x27;g&#x27;&#x29;, &#x27;&#x28;&#x28; &#x29;&#x7b;2,&#x7d;&#x7c;&#x5c;t&#x2b;&#x29;&#x27;, &#x27; &#x27;, &#x27;g&#x27;&#x29;&#x29; AS texto&#xa; FROM kolla.d_encuesta e, kolla_tmp.posiciones pos, kolla_dsa.d_pregunta_respuesta pr,&#xa;      kolla_tmp.aux_strings s, kolla_tmp.aux_strings s_n, kolla_tmp.aux_strings s_e &#xa; WHERE &#x28;pos.componente_numero &#x3c;&#x3e; &#x27;11&#x27; OR &#x28;pos.componente_numero &#x3d; &#x27;11&#x27; AND &#x27;&#x24;&#x7b;cantidades&#x7d;&#x27; IN &#x28;&#x27;D&#x27;, &#x27;A&#x27;&#x29;&#x29;&#x29; AND&#xa;       e.encuesta_codigo&#x3d;pos.encuesta_codigo&#x3a;&#x3a;integer AND pr.pregunta_codigo&#x3d; pos.pregunta_codigo&#x3a;&#x3a;integer AND &#xa;       s.tipo&#x3d;&#x27;dimension&#x27; AND s_n.tipo&#x3d;&#x27;caracteres-normales&#x27; AND s_e.tipo&#x3d;&#x27;caracteres-especiales&#x27; AND &#xa;       e.encuesta_id IN &#x28;SELECT distinct encuesta_id FROM kolla.ft_entrevista entrevistas WHERE entrevistas.instalacion_id&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;integer&#x29;&#xa;UNION&#xa;SELECT distinct&#xa;  e.encuesta_codigo&#x3a;&#x3a;integer, &#xa;  pos.posicion&#x3a;&#x3a;integer&#x2a;1000&#x2b;pos.posicion_cantidad&#x3a;&#x3a;integer,&#xa;  replace&#x28;replace&#x28;replace&#x28;replace&#x28;replace&#x28;replace&#x28;replace&#x28;s.texto,&#x27;&#x40;90&#x27;,translate&#x28;pos.bloque_nombre,s_e.texto, s_n.texto&#x29;&#x7c;&#x7c;&#x27;&#x26;&#x23;13&#x3b;&#x26;&#x23;10&#x3b;&#x27;&#x7c;&#x7c;translate&#x28;coalesce&#x28;pos.siete_pregunta_nombre,&#x27;&#x27;&#x29;,s_e.texto, s_n.texto&#x29;&#x29;,&#x27;&#x40;6&#x27;,case when pos.bloque_codigo&#x3a;&#x3a;integer &#x25; 2 &#x3d; 0 then &#x27;&#x23;1d891d&#x3b;&#x27; else &#x27;&#x23;372476&#x3b;&#x27; end&#x29;,&#x27;&#x40;5&#x27;,lpad&#x28;pos.posicion,4,&#x27;0&#x27;&#x29;&#x29;,&#x27;&#x40;4&#x27;,substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x29;,&#x27;&#x40;8&#x27;, pos.posicion_cantidad&#x29;,&#x27;&#x40;1&#x27;,pos.posicion&#x29;,&#x27;&#x40;2&#x27;,regexp_replace&#x28;regexp_replace&#x28;translate&#x28;pr.pregunta_desc,s_e.texto, s_n.texto&#x29;, &#x27;&#x5b;&#x5e;a-zA-Z0-9&#x3f;&#x5d;&#x27;, &#x27; &#x27;, &#x27;g&#x27;&#x29;, &#x27;&#x28;&#x28; &#x29;&#x7b;2,&#x7d;&#x7c;&#x5c;t&#x2b;&#x29;&#x27;, &#x27; &#x27;, &#x27;g&#x27;&#x29;&#x29; AS texto&#xa; FROM kolla.d_encuesta e, kolla_tmp.posiciones pos, kolla_dsa.d_pregunta_respuesta pr,&#xa;      kolla_tmp.aux_strings s, kolla_tmp.aux_strings s_n, kolla_tmp.aux_strings s_e &#xa; WHERE &#x27;&#x24;&#x7b;cantidades&#x7d;&#x27; IN &#x28;&#x27;M&#x27;, &#x27;A&#x27;&#x29; AND &#xa;       e.encuesta_codigo&#x3d;pos.encuesta_codigo&#x3a;&#x3a;integer AND pr.pregunta_codigo&#x3d; pos.pregunta_codigo&#x3a;&#x3a;integer AND&#xa;       pos.posicion_cantidad&#x3a;&#x3a;integer &#x3e; 0 AND &#xa;       s.tipo&#x3d;&#x27;cantidad&#x27; AND s_n.tipo&#x3d;&#x27;caracteres-normales&#x27; AND s_e.tipo&#x3d;&#x27;caracteres-especiales&#x27; AND &#xa;       e.encuesta_id IN &#x28;SELECT distinct encuesta_id FROM kolla.ft_entrevista entrevistas WHERE entrevistas.instalacion_id&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;integer&#x29;&#xa;UNION&#xa; SELECT distinct e.encuesta_codigo&#x3a;&#x3a;integer, 999999, s.texto as texto&#xa; FROM kolla.d_encuesta e, kolla_tmp.aux_strings s &#xa; WHERE s.tipo&#x3d;&#x27;cubo-fin&#x27; AND&#xa;  e.encuesta_id IN &#x28;SELECT distinct encuesta_id FROM kolla.ft_entrevista entrevistas &#xa;    WHERE entrevistas.instalacion_id&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;integer&#x29;&#xa;UNION&#xa; SELECT distinct e.encuesta_codigo&#x3a;&#x3a;integer, 999998, s.texto as texto&#xa; FROM kolla.d_encuesta e, kolla_tmp.aux_strings s &#xa; WHERE s.tipo&#x3d;&#x27;cubo-fin-elemento&#x27; AND&#xa;  e.encuesta_id IN &#x28;SELECT distinct encuesta_id FROM kolla.ft_entrevista entrevistas &#xa;    WHERE entrevistas.instalacion_id&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;integer AND&#xa;          entrevistas.elemento_id&#x3e;0&#x29;&#xa;UNION&#xa; SELECT DISTINCT ug.unidad_generica_id&#x2b;100000 AS id, 0,&#xa;    replace&#x28;replace&#x28;replace&#x28;s.texto,&#x27;&#x40;rol&#x27;,ug.rol_desc&#x29;,&#x27;&#x40;encuesta&#x27;,&#x27; Encuestas&#x27;&#x29;,&#x27;&#x40;unidad_analisis&#x27;,ug.unidad_generica_desc&#x29; AS texto &#xa; FROM public.d_unidad_generica ug,&#xa;     kolla_tmp.aux_strings s&#xa; WHERE ug.unidad_generica_id &#x3e; 0 AND s.tipo&#x3d;&#x27;rol-inicio&#x27;&#xa;UNION&#xa; SELECT DISTINCT ug.unidad_generica_id&#x2b;100000 AS id, 99999999,&#xa;     s.texto AS texto &#xa; FROM public.d_unidad_generica ug,&#xa;     kolla_tmp.aux_strings s&#xa; WHERE ug.unidad_generica_id &#x3e; 0 AND s.tipo&#x3d;&#x27;rol-fin&#x27;&#xa;UNION&#xa; SELECT DISTINCT ug.unidad_generica_id&#x2b;100000 AS id, e.encuesta_codigo,&#xa;    replace&#x28;replace&#x28;replace&#x28;replace&#x28;s.texto,&#x27;&#x40;rol&#x27;,ug.rol_desc&#x29;,&#x27;&#x40;encuesta&#x27;,&#xa;       regexp_replace&#x28;regexp_replace&#x28;translate&#x28;e.encuesta_desc,s_e.texto, s_n.texto&#x29;, &#x27;&#x5b;&#x5e;a-zA-Z0-9&#x3f;&#x5d;&#x27;, &#x27; &#x27;, &#x27;g&#x27;&#x29;, &#x27;&#x28;&#x28; &#x29;&#x7b;2,&#x7d;&#x7c;&#x5c;t&#x2b;&#x29;&#x27;, &#x27; &#x27;, &#x27;g&#x27;&#x29;&#x29;,&#xa;       &#x27;&#x40;1&#x27;,&#x27;&#x28;&#x27; &#x7c;&#x7c; e.encuesta_codigo &#x7c;&#x7c; &#x27;&#x29;&#x27;&#x29;&#xa;    ,&#x27;&#x40;unidad_analisis&#x27;,ug.unidad_generica_desc&#x29; AS texto &#xa; FROM public.d_unidad_generica ug, &#x28;SELECT encuesta_codigo, encuesta_desc FROM kolla.d_encuesta WHERE encuesta_id&#x3e;0 AND&#xa;                                   encuesta_id IN &#x28;SELECT distinct encuesta_id FROM kolla.ft_entrevista entrevistas &#xa;                                                          WHERE entrevistas.instalacion_id&#x3d;substring&#x28;&#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;,1, position&#x28;&#x27;-&#x27; in &#x27;&#x24;&#x7b;carga_instalacion&#x7d;&#x27;&#x29;-1&#x29;&#x3a;&#x3a;integer&#x29;&#x29; e,&#xa;     kolla_tmp.aux_strings s, kolla_tmp.aux_strings s_n, kolla_tmp.aux_strings s_e&#xa; WHERE ug.unidad_generica_id &#x3e; 0 AND s.tipo&#x3d;&#x27;rol-encuesta&#x27; AND s_n.tipo&#x3d;&#x27;caracteres-normales&#x27; AND s_e.tipo&#x3d;&#x27;caracteres-especiales&#x27;&#xa;UNION&#xa; SELECT distinct 9999999, 9999999, s.texto as texto&#xa; FROM kolla_tmp.aux_strings s &#xa; WHERE s.tipo&#x3d;&#x27;esquema-fin&#x27;&#xa;ORDER BY 1,2&#x3b;</sql>
