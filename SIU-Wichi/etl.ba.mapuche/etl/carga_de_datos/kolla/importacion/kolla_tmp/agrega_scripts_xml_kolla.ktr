      <line> <item>14</item><item>cubo-inicio-integracion</item><item>&#x3c;Cube name&#x3d;&#x27;&#x40;1_&#x40;3&#x27; caption&#x3d;&#x27;&#x40;1_&#x40;4&#x27;  visible&#x3d;&#x27;true&#x27; cache&#x3d;&#x27;true&#x27; enabled&#x3d;&#x27;true&#x27;&#x3e;&#xa;    &#x3c;View alias&#x3d;&#x27;ft_kolla_g3&#x27;&#x3e;&#xa;        &#x3c;SQL dialect&#x3d;&#x27;generic&#x27;&#x3e;&#xa;            &#x3c;&#x21;&#x5b;CDATA&#x5b;SELECT &#x2a; FROM kolla.ft_kolla_g3 WHERE encuesta_id IN &#x40;2&#x5d;&#x5d;&#x3e;&#xa;        &#x3c;&#x2f;SQL&#x3e;&#xa;    &#x3c;&#x2f;View&#x3e;&#xa;    &#x3c;DimensionUsage source&#x3d;&#x22;unidad_analisis&#x22; name&#x3d;&#x22;unidad_analisis&#x22; caption&#x3d;&#x22;&#x26;&#x23;60&#x3b;span style&#x3d;display&#x3a;none&#x3b;&#x26;&#x23;62&#x3b;000000&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;Unidad de An&#x26;&#x23;225&#x3b;lisis&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;&#x22; visible&#x3d;&#x22;true&#x22; foreignKey&#x3d;&#x22;unidad_generica_id&#x22; highCardinality&#x3d;&#x22;false&#x22;&#x3e;&#xa;    &#x3c;&#x2f;DimensionUsage&#x3e;&#xa;        &#x3c;DimensionUsage source&#x3d;&#x27;Encuesta&#x27; name&#x3d;&#x27;encuesta&#x27; caption&#x3d;&#x27;&#x26;&#x23;60&#x3b;span style&#x3d;display&#x3a;none&#x3b;&#x26;&#x23;62&#x3b;00000&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;Encuesta&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;&#x27; visible&#x3d;&#x27;true&#x27; foreignKey&#x3d;&#x27;encuesta_id&#x27; highCardinality&#x3d;&#x27;false&#x27; description&#x3d;&#x27; &#x27;&#x3e;&#xa;    &#x3c;&#x2f;DimensionUsage&#x3e;&#xa;    &#x3c;DimensionUsage source&#x3d;&#x27;fecha&#x27; name&#x3d;&#x27;periodo&#x27; caption&#x3d;&#x27;&#x26;&#x23;60&#x3b;span style&#x3d;display&#x3a;none&#x3b;&#x26;&#x23;62&#x3b;00001&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;Fecha de carga&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;&#x27; visible&#x3d;&#x27;true&#x27; foreignKey&#x3d;&#x27;fecha_id&#x27; highCardinality&#x3d;&#x27;fa