      <line> <item>4</item><item>esquema-inicio</item><item>&#x3c;Schema name&#x3d;&#x27;3-Kolla_&#x40;1&#x27; quoteSql&#x3d;&#x27;false&#x27;&#x3e;&#xa;   &#x3c;Dimension type&#x3d;&#x22;StandardDimension&#x22; visible&#x3d;&#x22;true&#x22; highCardinality&#x3d;&#x22;false&#x22; name&#x3d;&#x22;unidad_analisis&#x22; caption&#x3d;&#x22;Unidad de An&#x26;&#x23;225&#x3b;lisis&#x22; description&#x3d;&#x22;Unidad por la que los distintos usuarios van a filtrar su acceso&#x22;&#x3e;&#xa;    &#x3c;Hierarchy name&#x3d;&#x22;unidad_analisis&#x22; visible&#x3d;&#x22;true&#x22; hasAll&#x3d;&#x22;true&#x22; allMemberName&#x3d;&#x22;Todos&#x22; allMemberCaption&#x3d;&#x22;Total Unidad de An&#x26;&#x23;225&#x3b;lisis&#x22; primaryKey&#x3d;&#x22;unidad_generica_id&#x22; caption&#x3d;&#x22;Unidad de An&#x26;&#x23;225&#x3b;lisis&#x22;&#x3e;&#xa;      &#x3c;Table name&#x3d;&#x22;d_unidad_generica&#x22; schema&#x3d;&#x22;public&#x22;&#x3e;&#xa;      &#x3c;&#x2f;Table&#x3e;&#xa;      &#x3c;Level name&#x3d;&#x22;unidad_analisis&#x22; visible&#x3d;&#x22;true&#x22; column&#x3d;&#x22;unidad_generica_desc&#x22; type&#x3d;&#x22;String&#x22; uniqueMembers&#x3d;&#x22;false&#x22; levelType&#x3d;&#x22;Regular&#x22; hideMemberIf&#x3d;&#x22;Never&#x22; caption&#x3d;&#x22;Unidad de An&#x26;&#x23;225&#x3b;lisis&#x22;&#x3e;&#xa;      &#x3c;&#x2f;Level&#x3e;&#xa;    &#x3c;&#x2f;Hierarchy&#x3e;&#xa;   &#x3c;&#x2f;Dimension&#x3e;&#xa;   &#x3c;Dimension type&#x3d;&#x27;TimeDimension&#x27; visible&#x3d;&#x27;true&#x27; highCardinality&#x3d;&#x27;false&#x27; name&#x3d;&#x27;fecha&#x27; caption&#x3d;&#x27;Fecha&#x27;&#x3e;&#xa;    &#x3c;Hierarchy name&#x3d;&#x27;fecha&#x27; visible&#x3d;&#x27;true&#x27; hasAll&#x3d;&#x27;true&#x27; allMemberName&#x3d;&#x27;Todas&#x27; primaryKey&#x3d;&#x27;fecha_id&#x27; caption&#x3d;&#x27;Fecha&#x27;&#x3e;&#xa;      &#x3c;Table name&#x3d;&#x27;d_fecha&#x27; schema&#x3d;&#x27;public&#x27;&#x3e;&#xa;      &#x3c;&#x2f;Table&#x3e;&#xa;      &#x3c;Level name&#x3d;&#x27;anio&#x