    <data>
      <line> <item>1</item><item>dimension</item><item>    &#x3c;Dimension type&#x3d;&#x27;StandardDimension&#x27; visible&#x3d;&#x27;true&#x27; foreignKey&#x3d;&#x27;pregunta_&#x40;1&#x27; highCardinality&#x3d;&#x27;false&#x27; name&#x3d;&#x27;&#x40;2_&#x40;1&#x27; caption&#x3d;&#x27;&#x26;&#x23;60&#x3b;span style&#x3d;display&#x3a;none&#x3b;&#x26;&#x23;62&#x3b;&#x40;5&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;&#x26;&#x23;60&#x3b;span style&#x3d;color&#x3a;&#x40;6&#x26;&#x23;62&#x3b;&#x40;2&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;&#x27; description&#x3d;&#x27;&#x40;90&#x27;&#x3e;&#xa;      &#x3c;Hierarchy name&#x3d;&#x27;respuesta&#x27; visible&#x3d;&#x27;true&#x27; hasAll&#x3d;&#x27;true&#x27; primaryKey&#x3d;&#x27;pregunta_respuesta_id&#x27;&#x3e;&#xa;        &#x3c;View alias&#x3d;&#x27;d_pregunta_respuesta&#x40;3&#x27;&#x3e;&#xa;          &#x3c;SQL dialect&#x3d;&#x27;generic&#x27;&#x3e;&#xa;            &#x3c;&#x21;&#x5b;CDATA&#x5b;SELECT &#x2a; FROM kolla.d_pregunta_respuesta WHERE pregunta_codigo&#x3d;&#x40;3 AND instalacion_id&#x3d;&#x40;4&#x5d;&#x5d;&#x3e;&#xa;          &#x3c;&#x2f;SQL&#x3e;&#xa;         &#x3c;&#x2f;View&#x3e;&#xa;        &#x3c;Level name&#x3d;&#x27;&#x40;2&#x27; visible&#x3d;&#x27;true&#x27; table&#x3d;&#x27;d_pregunta_respuesta&#x40;3&#x27; column&#x3d;&#x27;respuesta_desc&#x27; type&#x3d;&#x27;String&#x27; uniqueMembers&#x3d;&#x27;false&#x27; levelType&#x3d;&#x27;Regular&#x27; hideMemberIf&#x3d;&#x27;Never&#x27; description&#x3d;&#x27;&#x40;90&#x27;&#x3e;&#xa;        &#x3c;&#x2f;Level&#x3e;&#xa;      &#x3c;&#x2f;Hierarchy&#x3e;&#xa;    &#x3c;&#x2f;Dimension&#x3e;</item> </line>
      <line> <item>2</item><item>cubo-inicio</item><item>  &#x3c;Cube name&#x3d;&#x27;&#x40;1_&#x40;3&#x27; caption&#x3d;&#x27;&#x40;1_&#x40;4&#x27;  visible&#x3d;&#x27;true&#x27; cache&#x3d;&#x27;true&#x27; enabled&#x3d;&#x27;true&#x27;&#x3e;&#xa;    &#x3c;View alias&#x3d;&#x27;ft_entrevista&#x27;&#x3e;&#xa;        &#x3c;SQL dialect&#x3d;&#x27;generic&#x27;&#x3e;&#xa;            &#x3c;&#x21;&#x5b;CDATA&#x5b;SELECT &#x2a; FROM kolla.ft_entrevista WHERE encuesta_id IN &#x40;2&#x5d;&#x5d;&#x3e;&#xa;        &#x3c;&#x2f;SQL&#x3e;&#xa;    &#x3c;&#x2f;View&#x3e;&#xa;    &#x3c;DimensionUsage source&#x3d;&#x22;unidad_analisis&#x22; name&#x3d;&#x22;unidad_analisis&#x22; caption&#x3d;&#x22;&#x26;&#x23;60&#x3b;span style&#x3d;display&#x3a;none&#x3b;&#x26;&#x23;62&#x3b;000000&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;Unidad de An&#x26;&#x23;225&#x3b;lisis&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;&#x22; visible&#x3d;&#x22;true&#x22; foreignKey&#x3d;&#x22;unidad_generica_id&#x22; highCardinality&#x3d;&#x22;false&#x22;&#x3e;&#xa;    &#x3c;&#x2f;DimensionUsage&#x3e;&#xa;        &#x3c;DimensionUsage source&#x3d;&#x27;Encuesta&#x27; name&#x3d;&#x27;encuesta&#x27; caption&#x3d;&#x27;&#x26;&#x23;60&#x3b;span style&#x3d;display&#x3a;none&#x3b;&#x26;&#x23;62&#x3b;00000&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;Encuesta&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;&#x27; visible&#x3d;&#x27;true&#x27; foreignKey&#x3d;&#x27;encuesta_id&#x27; highCardinality&#x3d;&#x27;false&#x27; description&#x3d;&#x27; &#x27;&#x3e;&#xa;    &#x3c;&#x2f;DimensionUsage&#x3e;&#xa;    &#x3c;DimensionUsage source&#x3d;&#x27;fecha&#x27; name&#x3d;&#x27;periodo&#x27; caption&#x3d;&#x27;&#x26;&#x23;60&#x3b;span style&#x3d;display&#x3a;none&#x3b;&#x26;&#x23;62&#x3b;00001&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;Fecha de carga&#x26;&#x23;60&#x3b;&#x2f;span&#x26;&#x23;62&#x3b;&#x27; visible&#x3d;&#x27;true&#x27; foreignKey&#x3d;&#x27;fecha_id&#x27; highCardinality&#x3d;&#x27;false&#x27; description&#x3d;&#x27; &#x27;&#x3e;&#xa;    &#x3c;&#x2f;DimensionUsage&#x3e;</item> </line>
