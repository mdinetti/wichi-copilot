  <step>
    <name>ft_lt_legajos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_mapuche</connection>
    <sql>SELECT	distinct ${periodo_info} AS periodo_info,
	dh01.nro_legaj,
	trim(dh01.desc_appat)::BYTEA AS apellido,
	trim(dh01.desc_nombr)::BYTEA AS nombre,
	CASE WHEN dh01.tipo_estad = 'A' THEN 1 
         WHEN dh01.tipo_estad = 'J' THEN 0
         WHEN dh01.tipo_estad = 'P'THEN 2
    ELSE -2 END AS tipo_estado,
	dh01.tipo_sexo AS sexo,

	CASE WHEN ((${mes_per_act}) - extract(MONTH FROM dh01.fec_nacim)) &lt; 0
	THEN ((${ano_per_act} - extract(YEAR FROM dh01.fec_nacim)) - 1)
	WHEN (((${mes_per_act}) - extract(MONTH FROM dh01.fec_nacim)) = 0) AND (extract(DAY FROM dh01.fec_nacim) > 1)
	THEN (${ano_per_act} - extract(YEAR FROM dh01.fec_nacim) - 1)
	ELSE (${ano_per_act} - extract(YEAR FROM dh01.fec_nacim)) END AS anios,
    dh01.fec_nacim,
	(SELECT dh09.codc_estcv FROM mapuche.dh09 WHERE dh09.nro_legaj = dh01.nro_legaj) AS estado_civil,
	(SELECT trim(s.codc_nivel)::BYTEA FROM mapuche.dh06 p, mapuche.dh33 s,mapuche.dh83 t WHERE p.nro_legaj = dh01.nro_legaj AND p.codc_titul = s.codc_titul
	AND t.codc_nivel = s.codc_nivel ORDER BY t.nro_jerar DESC LIMIT 1) AS nivel_estudio,
    (SELECT s.codc_titul::BYTEA FROM mapuche.dh06 p, mapuche.dh33 s,mapuche.dh83 t WHERE p.nro_legaj = dh01.nro_legaj AND p.codc_titul = s.codc_titul
	AND t.codc_nivel = s.codc_nivel ORDER BY t.nro_jerar DESC LIMIT 1) AS titulo,
    get_nivel_estudio_liq(dh01.nro_legaj,${ano_per_act},${mes_per_act})::BYTEA as nivel_estudio_liq,
    get_titulo_liq(dh01.nro_legaj,${ano_per_act},${mes_per_act})::BYTEA as titulo_liq,
	CASE WHEN (SELECT 1 FROM mapuche.dhd9 WHERE dhd9.nro_legaj = dh01.nro_legaj GROUP BY dhd9.nro_legaj) = 1
	THEN 1 ELSE 0 END AS discapacidad_id,
	0 AS cant_horas,
	CASE WHEN (SELECT 1 FROM mapuche.dh03 WHERE (fec_alta &lt; (${periodo_actual}::character varying)::date) AND (fec_baja is null or fec_baja >=  (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE) AND dh03.nro_legaj = dh01.nro_legaj GROUP BY dh03.nro_legaj) = 1
	THEN 1 ELSE 0 END AS cant_leg_activos,
	CASE WHEN (SELECT 1 FROM mapuche.dh21 WHERE dh21.nro_legaj = dh01.nro_legaj AND dh21.codn_conce > 0 AND dh21.nro_orimp >0 GROUP BY dh21.nro_legaj) = 1
	THEN 1 ELSE 0 END AS cant_leg_liq,
	COALESCE((SELECT tipo_incen FROM mapuche.dh03 WHERE
					(fec_alta &lt; (${periodo_actual}::character varying)::date) AND
					(fec_baja is null or fec_baja >=  (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE) AND
		tipo_incen NOT IN ('','N') AND	dh03.nro_legaj = dh01.nro_legaj AND tipo_incen IS NOT NULL
			ORDER BY tipo_incen LIMIT 1) , ' ') AS categoria_incentivo_codigo,
	COALESCE((SELECT dedi_incen FROM mapuche.dh03 WHERE
					(fec_alta &lt; (${periodo_actual}::character varying)::date) AND
					(fec_baja is null or fec_baja >=  (${ano_per_act}||'-'||${mes_per_act}||'-'||01)::DATE) AND
		tipo_incen NOT IN ('','N') AND	dh03.nro_legaj = dh01.nro_legaj AND tipo_incen IS NOT NULL
			ORDER BY tipo_incen LIMIT 1) , ' ') AS dedicacion_incentivo_codigo,
	LPAD(dh01.nro_cuil1::varchar, 2, '0') || LPAD(dh01.nro_cuil::varchar, 8, '0') || dh01.nro_cuil2 AS cuil,
	(SELECT correo_electronico::BYTEA FROM mapuche.dha1 WHERE dh01.nro_legaj=nro_persona AND domprincipal is TRUE  ORDER BY ano_vigencia, mes_vigencia DESC LIMIT 1) as correo_electronico,
    (SELECT (codigo_pais || '-' || coalesce(codigo_provincia,estado_extranjero) || '-' || coalesce(codigo_postal,0) || '-' || coalesce(codigo_repetidos,'00'))::BYTEA FROM mapuche.dha1 WHERE dh01.nro_legaj=nro_persona AND domprincipal is TRUE  ORDER BY ano_vigencia, mes_vigencia DESC LIMIT 1) as domicilio_codigo,
    (SELECT 'Calle: ' || coalesce(REPLACE(calle, '|', '')::BYTEA,'-') || ' Nro:' ||  coalesce(REPLACE(numero, '|', '')::BYTEA,'-') || ' Piso:' ||  coalesce(REPLACE(piso, '|', '')::BYTEA,'-') || ' Dpto:' || coalesce(REPLACE(dpto_oficina, '|', '')::BYTEA,'-') || ' Zona:' || coalesce(REPLACE(zona_paraje_barrio, '|', '')::BYTEA,'-') FROM mapuche.dha1 WHERE dh01.nro_legaj=nro_persona AND domprincipal is TRUE  ORDER BY ano_vigencia, mes_vigencia DESC LIMIT 1) as direccion,
    (SELECT dh09.codc_regio FROM mapuche.dh09 WHERE dh09.nro_legaj = dh01.nro_legaj) AS regional_cabecera,
    (SELECT dh09.codc_uacad FROM mapuche.dh09 WHERE dh09.nro_legaj = dh01.nro_legaj) AS unidad_academica_cabecera,
    (SELECT dh09.coddependesemp FROM mapuche.dh09 WHERE dh09.nro_legaj = dh01.nro_legaj) AS depdesemp_cabecera,
    dh01.tipo_facto || dh01.tipo_rh as grupo_sanguineo,
    (SELECT telefono::BYTEA || ' / ' || telefono_celular::BYTEA  FROM mapuche.dha1 WHERE dh01.nro_legaj=nro_persona AND domprincipal is TRUE  ORDER BY ano_vigencia, mes_vigencia DESC LIMIT 1) as telefono,
    dh01.nro_ficha,
    dh01.anioalta,
    dh01.periodoalta as mesalta,
    dh01.tipo_docum,
    dh01.nro_docum,
    dh01.anioactualizacion,
    dh01.periodoactualizacion as mesactualizacion,
    dh01g.id_genero as identidad_genero,
    (SELECT dh09.codc_obsoc FROM mapuche.dh09 WHERE dh09.nro_legaj = dh01.nro_legaj) AS codc_obsoc,
    (SELECT dh09.fec_ingreso FROM mapuche.dh09 WHERE dh09.nro_legaj = dh01.nro_legaj) AS fec_ingreso,
    (SELECT dh09.fecha_recibo FROM mapuche.dh09 WHERE dh09.nro_legaj = dh01.nro_legaj) AS fecha_recibo,
    dha8.codigosituacion,
    dha8.codigocondicion,
    dha8.codigoactividad,
    dha8.codigozona,
    dha8.porcaporteadicss,
    dha8.provincialocalidad,
    (SELECT dh09.nro_afili FROM mapuche.dh09 WHERE dh09.nro_legaj = dh01.nro_legaj) AS nro_afili

	FROM mapuche.dh01 dh01
	LEFT JOIN mapuche.dh01_genero dh01g ON (dh01.nro_legaj = dh01g.nro_legaj)
	LEFT JOIN mapuche.dha8 dha8 ON (dh01.nro_legaj = dha8.nro_legajo)
	WHERE (dh01.tipo_estad = 'A' OR dh01.tipo_estad = 'J' OR (dh01.tipo_estad = 'P' AND dh01.nro_legaj in (Select distinct nro_legaj from mapuche.dh21))
	 OR (dh01.tipo_estad = 'P' AND 'Si' = '${carga_legajos_pasivos}'))
	ORDER BY dh01.nro_legaj</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>96</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
