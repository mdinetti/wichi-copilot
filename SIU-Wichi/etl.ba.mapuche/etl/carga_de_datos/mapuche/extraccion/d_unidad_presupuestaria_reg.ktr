  <step>
    <name>unidad_presupuestaria</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_mapuche</connection>
    <sql>SELECT CASE 	WHEN dp18.codn_area &#x3c; 10 THEN &#x27;0&#x27; &#x7c;&#x7c; dp18.codn_area&#x3a;&#x3a;TEXT ELSE dp18.codn_area&#x3a;&#x3a;TEXT END &#x7c;&#x7c; &#xa;                CASE &#xa;               	WHEN dp19.codn_subar &#x3c; 10 THEN &#x27;00&#x27; &#x7c;&#x7c; dp19.codn_subar&#x3a;&#x3a;TEXT &#xa;                WHEN dp19.codn_subar &#x3c; 100 THEN &#x27;0&#x27; &#x7c;&#x7c; dp19.codn_subar&#x3a;&#x3a;TEXT &#xa;                ELSE dp19.codn_subar&#x3a;&#x3a;TEXT &#xa;                END &#x7c;&#x7c;&#xa;                CASE &#xa;               	WHEN subsubde.codn_subsubar &#x3c; 10 THEN &#x27;00&#x27; &#x7c;&#x7c; subsubde.codn_subsubar&#x3a;&#x3a;TEXT &#xa;                WHEN subsubde.codn_subsubar &#x3c; 100 THEN &#x27;0&#x27; &#x7c;&#x7c; subsubde.codn_subsubar&#x3a;&#x3a;TEXT &#xa;                ELSE subsubde.codn_subsubar&#x3a;&#x3a;TEXT &#xa;                END AS unidad_presupuestaria_codigo,&#xa;                CASE WHEN dp18.codn_area &#x3c; 10 THEN &#x27;0&#x27; &#x7c;&#x7c; dp18.codn_area&#x3a;&#x3a;TEXT ELSE dp18.codn_area&#x3a;&#x3a;TEXT END &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; regexp_replace&#x28;trim&#x28;dp18.desc_area&#x29;,  &#x27;&#x5b;&#x5e;a-zA-Z0-9&#xe1;&#xe9;&#xed;&#xf3;&#xfa;&#xfc;&#xc1;&#xc9;&#xcd;&#xd3;&#xda;&#xdc;&#xf1;&#xd1;.&#x3a;,&#x2f;&#x28;&#x29; &#x5d;&#x27;, &#x27;&#x27;,&#x27;g&#x27;&#x29; AS unidad_presupuestaria_desc,&#xa;		CASE WHEN dp19.codn_subar &#x3c; 10 THEN &#x27;00&#x27; &#x7c;&#x7c; dp19.codn_subar&#x3a;&#x3a;TEXT &#xa;                WHEN dp19.codn_subar &#x3c; 100 THEN &#x27;0&#x27; &#x7c;&#x7c; dp19.codn_subar&#x3a;&#x3a;TEXT &#xa;                ELSE dp19.codn_subar&#x3a;&#x3a;TEXT  END &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; regexp_replace&#x28;trim&#x28;dp19.desc_subar&#x29;,  &#x27;&#x5b;&#x5e;a-zA-Z0-9&#xe1;&#xe9;&#xed;&#xf3;&#xfa;&#xfc;&#xc1;&#xc9;&#xcd;&#xd3;&#xda;&#xdc;&#xf1;&#xd1;.&#x3a;,&#x2f;&#x28;&#x29; &#x5d;&#x27;, &#x27;&#x27;,&#x27;g&#x27;&#x29; AS subunidad_presupuestaria_desc,&#xa;                CASE WHEN subsubde.codn_subsubar &#x3c; 10 THEN &#x27;00&#x27; &#x7c;&#x7c; subsubde.codn_subsubar&#x3a;&#x3a;TEXT &#xa;                WHEN subsubde.codn_subsubar &#x3c; 100 THEN &#x27;0&#x27; &#x7c;&#x7c; subsubde.codn_subsubar&#x3a;&#x3a;TEXT &#xa;                ELSE subsubde.codn_subsubar&#x3a;&#x3a;TEXT &#xa;                END &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; regexp_replace&#x28;trim&#x28;subsubde.desc_subsubar&#x29;,  &#x27;&#x5b;&#x5e;a-zA-Z0-9&#xe1;&#xe9;&#xed;&#xf3;&#xfa;&#xfc;&#xc1;&#xc9;&#xcd;&#xd3;&#xda;&#xdc;&#xf1;&#xd1;.&#x3a;,&#x2f;&#x28;&#x29; &#x5d;&#x27;, &#x27;&#x27;,&#x27;g&#x27;&#x29; AS subsubunidad_presupuestaria_desc&#xa;  FROM mapuche.dp18 JOIN  mapuche.dp19 ON &#x28;dp18.codn_area &#x3d; dp19.codn_area&#x29;&#xa;  JOIN mapuche.subsubde ON &#x28;dp19.codn_area &#x3d; subsubde.codn_area AND dp19.codn_subar &#x3d; subsubde.codn_subar&#x29;&#xa;  ORDER BY 1</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
