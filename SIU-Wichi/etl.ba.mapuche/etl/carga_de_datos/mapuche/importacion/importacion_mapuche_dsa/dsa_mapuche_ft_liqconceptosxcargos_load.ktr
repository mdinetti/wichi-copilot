  </step>
  <step>
    <name>mapuche_tmp.ft_liqconceptosxcargos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT 
  ft_liqconceptosxcargos.periodo_info as periodo_id, 
  substring(periodo_info::TEXT FROM 1 for 4)::integer as anio_id,
  substring(periodo_info::TEXT FROM 5 for 2)::integer as mes_id,
  d_liquidacion.liquidacion_id, 
  d_concepto.concepto_id, 
  d_persona.persona_id, 
  nro_cargo_base::integer,
  cargo_id::integer as nro_cargo,
  d_tipo_ejercicio.tipo_ejercicio_id,
  d_unidad_presupuestaria.unidad_presupuestaria_id, 
  d_imppresupfuente.imppresupfuente_id , 
  d_objetodelgasto.objetodelgasto_id, 
  d_redprogramatica.red_programatica_id,
  d_finalidad_funcion.finalidad_funcion_id,
  d_grupo_presupuestario.grupo_presupuestario_id, 
  a1.antiguedad_id as antiguedadliq_id,
  ft_liqconceptosxcargos.dias_trabajados,
  retro.periodo_retroactivo_id,
  ft_liqconceptosxcargos.importe_liq, 
  ft_liqconceptosxcargos.porc_imppresup,
  ft_liqconceptosxcargos.nro_recibo,
  ft_liqconceptosxcargos.nro_orimp,
  ft_liqconceptosxcargos.cant_cargosxconcepto,
  right('0000' || cast(ft_liqconceptosxcargos.grupo_presupuestario_id as text),4) || ft_liqconceptosxcargos.unidad_presupuestaria_id as centro_costos,
  case when d_concepto.conceptotipo_codigo = 'A' then 0
       when d_concepto.conceptotipo_codigo = 'D' AND ft_liqconceptosxcargos.nro_orimp > 0 then (-1)* ft_liqconceptosxcargos.importe_liq
	   when ft_liqconceptosxcargos.nro_orimp > 0 then ft_liqconceptosxcargos.importe_liq
       else 0
  end as importenetocargo,
  case when d_concepto.conceptotipo_codigo = 'A' then 0
       when d_concepto.conceptotipo_codigo = 'D' then 0
       when ft_liqconceptosxcargos.nro_orimp > 0 then ft_liqconceptosxcargos.importe_liq
	   else 0
  end as importebrutocargo,
  case when d_concepto.conceptotipo_codigo = 'D' then 0
       when ft_liqconceptosxcargos.nro_orimp > 0 then ft_liqconceptosxcargos.importe_liq
       else 0
  end as importegastototalcargo,
  case when d_concepto.conceptotipo_codigo = 'D' AND ft_liqconceptosxcargos.nro_orimp > 0 then ft_liqconceptosxcargos.importe_liq
       else 0
  end as importedescuentoscargo,
  case when d_concepto.conceptotipo_codigo = 'A' AND ft_liqconceptosxcargos.nro_orimp > 0 then ft_liqconceptosxcargos.importe_liq
       else 0
  end as importeaportescargo,
  case when d_concepto.conceptotipo_codigo = 'F' AND ft_liqconceptosxcargos.nro_orimp > 0 then ft_liqconceptosxcargos.importe_liq
       else 0
  end as importeasigfam,
  case when d_concepto.conceptotipo_codigo = 'C' AND ft_liqconceptosxcargos.nro_orimp > 0 then ft_liqconceptosxcargos.importe_liq
       else 0
  end as importeremconap,
  case when d_concepto.conceptotipo_codigo = 'S' AND ft_liqconceptosxcargos.nro_orimp > 0 then ft_liqconceptosxcargos.importe_liq
       else 0
  end as importeremsinap,
  case when d_concepto.conceptotipo_codigo = 'O' AND ft_liqconceptosxcargos.nro_orimp > 0 then ft_liqconceptosxcargos.importe_liq
       else 0
  end as importeotrosrem,
  ft_liqconceptosxcargos.novedad_1,
  ft_liqconceptosxcargos.novedad_2,
  current_date as fechacarga,
${subfuente_id} as subfuente_id
FROM 
  mapuche_tmp.ft_liqconceptosxcargos 
  left outer join mapuche_dsa.d_concepto on (d_concepto.concepto_codigo = ft_liqconceptosxcargos.concepto_id AND d_concepto.vigente='Y' and d_concepto.subfuente_id = ${subfuente_concepto})
  left outer join mapuche_dsa.d_persona on (ft_liqconceptosxcargos.legajo_id = d_persona.legajo_codigo and d_persona.subfuente_id = ${subfuente_persona})
  left outer join mapuche_dsa.d_objetodelgasto on ( d_objetodelgasto.objetodelgasto_codigo = ft_liqconceptosxcargos.obj_gasto_id AND d_objetodelgasto.vigente = 'Y' AND d_objetodelgasto.vigente='Y' and d_objetodelgasto.subfuente_id = ${subfuente_objetodelgasto}) 
  left outer join mapuche_dsa.d_redprogramatica on (d_redprogramatica.red_programatica_codigo = ft_liqconceptosxcargos.red_programatica_id and d_redprogramatica.vigente = 'Y' and d_redprogramatica.subfuente_id = ${subfuente_redprogramatica})
  left outer join mapuche_dsa.d_imppresupfuente on (d_imppresupfuente.imppresupfuente_codigo = ft_liqconceptosxcargos.imp_presup_fuente_id  and d_imppresupfuente.vigente = 'Y' )
  left outer join mapuche_dsa.d_unidad_presupuestaria on (d_unidad_presupuestaria.unidad_presupuestaria_codigo = ft_liqconceptosxcargos.unidad_presupuestaria_id and d_unidad_presupuestaria.vigente = 'Y' and d_unidad_presupuestaria.subfuente_id = ${subfuente_unidad_presupuestaria})
  left outer join mapuche_dsa.d_liquidacion on (d_liquidacion.liquidacion_codigo = ft_liqconceptosxcargos.liquidacion_nro and d_liquidacion.vigente = 'Y' and d_liquidacion.subfuente_id = ${subfuente_liquidacion})
  left outer join mapuche_dsa.d_tipo_ejercicio on (d_tipo_ejercicio.tipo_ejercicio_codigo = ft_liqconceptosxcargos.tipo_ejercicio_id and d_tipo_ejercicio.vigente = 'Y')
  left outer join mapuche_dsa.d_finalidad_funcion on (d_finalidad_funcion.finalidad_codigo = ft_liqconceptosxcargos.finalidad_id and d_finalidad_funcion.funcion_codigo = ft_liqconceptosxcargos.funcion_id 
and d_finalidad_funcion.vigente = 'Y' and d_finalidad_funcion.subfuente_id = ${subfuente_finalidadfuncion})
  left outer join mapuche_dsa.d_grupo_presupuestario on (d_grupo_presupuestario.grupo_presupuestario_codigo = ft_liqconceptosxcargos.grupo_presupuestario_id and d_grupo_presupuestario.vigente = 'Y' and d_grupo_presupuestario.subfuente_id = ${subfuente_grupopresupuestario})
  left outer join mapuche_dsa.d_antiguedad a1 on (a1.anios = ft_liqconceptosxcargos.antiguedad_liq AND a1.vigente = 'Y' )
  left outer join mapuche_dsa.d_periodo_retroactivo retro on (retro.anio_codigo = ft_liqconceptosxcargos.anio_retro AND retro.mes_codigo = ft_liqconceptosxcargos.mes_retro)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>176</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
