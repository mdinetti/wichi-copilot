  <step>
    <name>tmp -&#x3e; ft_cargos_liq</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT&#xa;  to_char&#x28;periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29; as periodo_id&#xa;, numero_cargo as numero_cargo&#xa;, cuil_cuit as persona_codigo&#xa;, escalafon_id as escalafon_codigo&#xa;, cod_cargo_universidad as cargo_codigo&#xa;, equivalencia_cargo_id as equivalencia_cargo_codigo&#xa;, unidad_academica_id as unidad_academica_codigo&#xa;, fuente_financiamiento_id as fuente_financiamiento_codigo&#xa;, estado_laboral_id as estado_laboral_codigo&#xa;, tipo_planta_id as tipo_planta_codigo&#xa;, estado_cargo_id as estado_cargo_codigo&#xa;, situacion_laboral_id as situacion_laboral_codigo&#xa;, nivel_ensenianza_id as nivel_ensenianza_codigo&#xa;, CASE WHEN cast&#x28;meses_antiguedad as integer&#x29; &#x3e; 731 THEN &#x27;731&#x27; ELSE meses_antiguedad END as rango_antiguedad_codigo --Si supera los 731 meses se pone directamente meses&#x3d;731 &#x28;m&#xe1;s de 60 a&#xf1;os&#x29;&#xa;, horas_dedicacion as hora_dedicacion_codigo&#xa;, nro_cargo_pers as numero_cargo_codigo&#xa;, anios_antiguedad as anios_antiguedad_codigo&#xa;, agrupamiento_nd_id as agrupamiento_no_docente_codigo&#xa;, tipo_cargo_asociado_id as tipo_cargo_asociado_codigo&#xa;, escalafon_relacionado_id as escalafon_relacionado_codigo&#xa;, cargo_univ_relacionado_id as cargo_univ_relacionado_codigo&#xa;, &#x28;&#xa;  select coalesce&#x28;&#xa;  &#x28;&#xa;    select equivalencia_cargo_id&#xa;    from rhun_tmp.lt_equivalencias_cargos&#xa;    where&#xa;      equivalencia_cargo_id &#x3d;&#xa;      &#x28;&#xa;        select equivalencia_cargo_categ_univ&#xa;        from rhun_tmp.lt_categorias_univ&#xa;        where&#xa;          to_char&#x28;periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29;&#x3d;to_char&#x28;c.periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29; and &#xa;          escalafon_categ_univ &#x3d; &#x28;&#xa;            select escalafon_relacionado_id&#xa;            from rhun_tmp.ft_cargos_liq&#xa;            where to_char&#x28;periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29;&#x3d;to_char&#x28;c.periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29; and numero_cargo&#x3d;c.numero_cargo&#xa;          &#x29; and&#xa;          cod_cargo_universidad &#x3d; &#x28;&#xa;            select cargo_univ_relacionado_id&#xa;            from rhun_tmp.ft_cargos_liq&#xa;            where to_char&#x28;periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29;&#x3d;to_char&#x28;c.periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29; and numero_cargo&#x3d;c.numero_cargo&#xa;          &#x29;&#xa;      &#x29; and&#xa;      escalafon_id &#x3d;&#xa;      &#x28;&#xa;        select escalafon_relacionado_id&#xa;        from rhun_tmp.ft_cargos_liq&#xa;        where to_char&#x28;periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29;&#x3d;to_char&#x28;c.periodo&#x3a;&#x3a;timestamp,&#x27;YYYYMM&#x27;&#x29; and numero_cargo&#x3d;c.numero_cargo&#xa;      &#x29;&#xa;  &#x29;,&#xa;  &#x27;VACIO&#x2f;NULO&#x27;&#xa;  &#x29;&#xa;&#x29; as equivalencia_cargo_relacionado_codigo&#xa;&#xa;, 1 as cantidad_cargos&#xa;FROM rhun_tmp.ft_cargos_liq c</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
