    <sql>  SELECT ft.usuario_codigo&#xa;, ft.curso_codigo&#xa;, ru.rol_codigo&#xa;, TO_CHAR&#x28;TO_TIMESTAMP&#x28;fecha &#x2a; 10000 &#x29;, &#x27;YYYY-MM-DD&#x27;&#x29;&#x3a;&#x3a;date fecha_id&#xa;, cantidad&#xa;, ft.plataforma_g3&#x3a;&#x3a;integer&#xa;,&#x27;Y&#x27; as vigente -- campo para usar con los database lookup&#xa;  FROM moodle_tmp.ft_actividades ft LEFT JOIN&#xa;  &#x28;SELECT curso_codigo, usuario_codigo,plataforma_g3, min&#x28;rol_codigo&#x29; as rol_codigo&#xa;  FROM moodle_tmp.d_rol_usuario&#xa;  group by 1,2,3&#x29; ru &#xa;  ON ft.usuario_codigo &#x3d; ru.usuario_codigo AND ft.curso_codigo&#x3d;ru.curso_codigo AND ft.plataforma_g3&#x3d;ru.plataforma_g3 &#x3b;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
