  <step>
    <name>base_pilaga</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_pilaga</connection>
    <sql>-- Se generan todos los registros juntando los comprobantes con los devengados de los moviemientos de gastos&#xa;SELECT DISTINCT comprob.comprobante as comprobante_codigo&#xa;		, comprob.tipo_de_comprobante as comprobante_tipo_codigo&#xa;		, comprob.numero as numero&#xa;		, comprob.anio as anio&#xa;		, comprob.persona as persona_codigo&#xa;		, comprob.paso as paso&#xa;	FROM 	sau_gb_tramites as tramite&#xa;		INNER JOIN sau_gb_pasos as pa &#xa;			ON pa.tramite &#x3d; tramite.tramite&#xa;		INNER JOIN sau_gb_transacciones as tr &#xa;			ON tr.paso &#x3d; pa.paso&#xa;		INNER JOIN sau_no_mapeador_transaccional mt &#xa;			ON tr.transaccion &#x3d; mt.numero_en_gestion&#xa;		INNER JOIN sau_np_detalles_movimientos dm &#xa;			ON dm.mov_presupuestario_contable &#x3d; mt.mov_presupuestario_contable&#xa;		inner join&#x28;&#xa;		SELECT cr.paso, co.comprobante, co.tipo_de_comprobante, co.numero, co.anio, co.persona&#xa;			FROM sau_gb_comprobantes_respaldo cr, sau_no_comprobantes co &#xa;				WHERE cr.comprobante &#x3d; co.comprobante AND tipo_de_comprobante IN &#xa;			&#x28;SELECT tipo_de_documentacion FROM sau_no_documentacion_tipos &#xa;				WHERE tipo_documentacion&#x3d;&#x27;C&#x27;&#x29;&#xa;		&#x29; comprob on pa.paso &#x3d; comprob.paso OR pa.paso_anterior &#x3d; comprob.paso &#xa;		LEFT JOIN sau_li_liquidaciones li &#xa;			ON li.nro_operacion_original &#x3d; pa.paso AND li.estado &#x3c;&#x3e; &#x27;U&#x27;&#xa;	WHERE pa.ejercicio &#x3d; &#x28;SELECT ejercicio FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29;&#xa;	 AND  dm.etapa_presupuestaria in &#x28; &#x27;CR&#x27;, &#x27;PR&#x27;, &#x27;CD&#x27;, &#x27;DE&#x27;,&#x27;PA&#x27;&#x29;&#x3b;&#xa;&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>306</xloc>
      <yloc>95</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

