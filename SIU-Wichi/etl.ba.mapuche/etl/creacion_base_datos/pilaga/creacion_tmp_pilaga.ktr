    <quoteString>N</quoteString>
    <sql>--Esquema pilaga_tmp

--Crea el esquema temporal de pilagá
CREATE SCHEMA pilaga_tmp;

--tablas temporales 

--d_red_programatica
CREATE TABLE pilaga_tmp.d_red_programatica
(
  programa_codigo text,
  programa_desc text,
  subprograma_desc text,
  proyecto_desc text,
  actividad_desc text,
  obra_desc text,
  red_programatica_combo_desc text
  --CONSTRAINT pk_d_red_programatica PRIMARY KEY (programa_codigo)
);

--d_banco_sucursal
CREATE TABLE pilaga_tmp.d_banco_sucursal
 (
  banco_desc text NOT NULL,
  cuit text, -- datos del banco
  sucursal_desc text,
  sucursal_codigo text
);

--d_circuito_gestion 
CREATE TABLE pilaga_tmp.d_circuito_gestion
(
  circuito_gestion_codigo text,
  circuito_gestion_desc text,
 CONSTRAINT pk_d_circuito_gestion PRIMARY KEY (circuito_gestion_codigo)
);

--d_codigo_economico
CREATE TABLE pilaga_tmp.d_codigo_economico
(
  codigo_economico_codigo text,
  codigo_economico_desc text,
  CONSTRAINT pk_d_codigo_economico PRIMARY KEY (codigo_economico_codigo)
);

--d_concepto_ingreso
CREATE TABLE pilaga_tmp.d_concepto_ingreso
 (
  concepto_ingreso_codigo text, 
  concepto_ingreso_desc text, 
  tipo_ingreso_desc text, 
 CONSTRAINT pk_d_concepto_ingreso PRIMARY KEY (concepto_ingreso_codigo)
);

--d_finalidad_funcion
CREATE TABLE pilaga_tmp.d_finalidad_funcion
(
  finalidad_codigo text,
  funcion_codigo text,
  finalidad_desc text,
  funcion_desc text,
  finalidad_funcion_combo_desc text
);

CREATE INDEX idx_tmp_d_finalidad_funcion_finalidad_codigo ON pilaga_tmp.d_finalidad_funcion USING btree (finalidad_codigo);

-- d_fuente
CREATE TABLE pilaga_tmp.d_fuente
(
  fuente_codigo text,
  fuente_desc text,
  fuentecompleto_desc text
);
CREATE INDEX idx_tmp_d_fuente_codigo ON pilaga_tmp.d_fuente USING btree (fuente_codigo);

--d_grupo_presupuestario
CREATE TABLE pilaga_tmp.d_grupo_presupuestario
(
  grupo_presupuestario_codigo text,
  grupo_presupuestario_desc text
  --CONSTRAINT pk_d_grupo_presupuestario PRIMARY KEY (grupo_presupuestario_codigo)
);

-- d_moneda
CREATE TABLE pilaga_tmp.d_moneda
 (
  moneda_codigo text, 
  moneda_tipo_desc text, 
  moneda_desc text, 
 CONSTRAINT pk_d_moneda PRIMARY KEY (moneda_codigo)
);

--d_objeto_del_gasto
CREATE TABLE pilaga_tmp.d_objeto_del_gasto
(
  objeto_del_gasto_codigo text, 
  resumen_desc text, 
  inciso_desc text, 
  partida_principal_desc text, 
  partida_parcial_desc text, 
  objeto_del_gasto_desc text,
  orden integer, 
 CONSTRAINT pk_d_objeto_del_gasto PRIMARY KEY (objeto_del_gasto_codigo)
);

-- d_rubro_ingreso
CREATE TABLE pilaga_tmp.d_rubro_ingreso
 (
  rubro_ingreso_codigo text,
  grupo_desc text,
  rubro_desc text,
  tipo_desc text,
  clase_desc text, 
  rubro_ingreso_desc text, 
CONSTRAINT pk_d_rubro_ingreso PRIMARY KEY (rubro_ingreso_codigo)
);

--d_unidad_presupuestaria
CREATE TABLE pilaga_tmp.d_unidad_presupuestaria
(
  unidad_presupuestaria_codigo text,
  unidad_presupuestaria_desc text,
  subunidad_presupuestaria_desc text,
  subsubunidad_presupuestaria_desc text,
  unidad_presupuestaria_combo_desc text,
 CONSTRAINT pk_d_unidad_presupuestaria PRIMARY KEY (unidad_presupuestaria_codigo)
);

--d_tipo_comprobante. De tercero.
CREATE TABLE pilaga_tmp.d_tipo_comprobante
(
  tipo_comprobante_codigo text,
  tipo_comprobante_desc text,
CONSTRAINT pk_d_tipo_comprobante PRIMARY KEY (tipo_comprobante_codigo)
);

--d_tipo_documento son documentos de la Universidad, no de terceros.
CREATE TABLE pilaga_tmp.d_tipo_documento
(
  tipo_documento_codigo text,
  tipo_documento_desc text,
CONSTRAINT pk_d_tipo_documento PRIMARY KEY (tipo_documento_codigo)
);

--d_documento_principal son documentos de la Universidad, no de terceros.
CREATE TABLE pilaga_tmp.d_documento_principal
(
  documento_principal_codigo text,
CONSTRAINT pk_d_documento_principal PRIMARY KEY (documento_principal_codigo)
);

--d_tipo_persona. Clasificacion de proveedores que hace la Universidad 
-- Cliente / Proveedor / Tercero
CREATE TABLE pilaga_tmp.d_tipo_persona
(
  tipo_persona_codigo text,
  tipo_persona_desc text,
CONSTRAINT pk_d_tipo_persona PRIMARY KEY (tipo_persona_codigo)
);

--d_persona
CREATE TABLE pilaga_tmp.d_persona     
(
  persona_codigo text,
  persona_tipo_documento text,
  persona_nro_documento text,
  fisica_o_juridica text,
  razon_social_apyno text,
  nombre_fantasia text,
  sexo text,
  nacionalidad text,
  email text,
  cbu text,
  persona_detalle text,
  estado text,
  
CONSTRAINT pk_d_persona PRIMARY KEY (persona_codigo)
);

--d_cuenta_bancaria (banco, tipo y número de cuenta) Tambien existen cuentas “puente” que son usadas para hacer transferencias entre tesorerias y deberían siempre quedar con saldo cero.                        
CREATE TABLE pilaga_tmp.d_cuenta_bancaria
 (
  cuenta_bancaria_codigo text NOT NULL,
  cuenta_bancaria_tipo_desc text,
  descripcion text, 
  CONSTRAINT pk_d_cuenta_bancaria PRIMARY KEY (cuenta_bancaria_codigo)
);

--d_unidad_gestion
CREATE TABLE pilaga_tmp.d_unidad_gestion
 (
  unidad_gestion_codigo text, 
  unidad_gestion_desc text, 
 CONSTRAINT pk_d_unidad_gestion PRIMARY KEY (unidad_gestion_codigo)
);

--d_fondo
CREATE TABLE pilaga_tmp.d_fondo
(
  tipo_fondo_desc text,               -- Presupuestario, No presupuestario
  tipo_fondo_terceros_desc text, -- Retenciones, Fondos de terceros
  fondo_desc text,                       -- Retención de IVA, Retención de IIBB
  fondo_combo_desc text
);

--d_cuenta_tesoreria (tesorería, tipo y número de cuenta)
CREATE TABLE pilaga_tmp.d_cuenta_tesoreria
 (
  cuenta_tesoreria_desc text,
  cuenta_tesoreria_tipo_desc text, --Efectivo, Bancaria, Virtual
  moneda_codigo integer, 
  cuenta_tesoreria_codigo text,
  tesoreria_desc text
);

-- d_expediente
CREATE TABLE pilaga_tmp.d_expediente
(
  anio integer,
  tipo text, -- Se obtiene de “E” igual que d_tipo_documento
  expediente_nro text,
  expediente_desc text
);
CREATE INDEX idx_tmp_d_expediente_expediente_nro ON pilaga_tmp.d_expediente USING btree (expediente_nro);


--d_comprobante (anio, numero[puesto y numero], fecha, descripcion)  De tercero.
CREATE TABLE pilaga_tmp.d_comprobante
(
  fecha date,
  tipo_codigo text,
  persona_codigo text,
  numero text,
  importe numeric(14,2),
  descripcion text
);
CREATE INDEX idx_tmp_d_comprobante_numero ON pilaga_tmp.d_comprobante USING btree (numero);

--d_ejercicio
CREATE TABLE pilaga_tmp.d_ejercicio
(
  ejercicio_codigo text,
  ejercicio_nombre text,
 CONSTRAINT pk_d_ejercicio PRIMARY KEY (ejercicio_codigo)
);

-- d_medio_pago
CREATE TABLE pilaga_tmp.d_medio_pago
 (
  medio_pago_codigo text,
  medio_pago_desc text,
  medio_pago_tipo_codigo text
);
CREATE INDEX idx_tmp_d_medio_pago_codigo ON pilaga_tmp.d_medio_pago USING btree (medio_pago_codigo);

--d_concepto
CREATE TABLE pilaga_tmp.d_concepto
(
  concepto_desc text
);
CREATE INDEX d_concepto_por_concepto_desc ON pilaga_tmp.d_concepto (concepto_desc);

--d_estado_liquidacion
CREATE TABLE pilaga_tmp.d_estado_liquidacion
(
