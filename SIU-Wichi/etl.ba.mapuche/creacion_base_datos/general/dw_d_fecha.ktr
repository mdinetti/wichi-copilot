        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

var quincena_desc;
var quincena;
var dia_actual = dia.getInteger();

switch(true){
	case (dia_actual &lt; 16):
		quincena_desc = "1er Quincena";
		quincena = 1
		break;
	case (dia_actual> 15):
		quincena_desc = "2da Quincena";
		quincena = 2
		break;
	default: 
		quincena_desc = "NADA";
		quincena = 999;
		break;
}
</jsScript_script>
