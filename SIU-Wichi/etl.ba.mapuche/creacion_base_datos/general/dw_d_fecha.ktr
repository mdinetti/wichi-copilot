<transformation>
  <info>
    <name>dw_d_fecha</name>
    <description>Carga la dimensión d_fecha</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <trans_status>0</trans_status>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>DIAS_SEMANA</name>
        <default_value>Domingo,Lunes,Martes,Miercoles,Jueves,Viernes,Sabado</default_value>
        <description>Días de la semana</description>
      </parameter>
      <parameter>
        <name>DIAS_SEMANA_ABREV</name>
        <default_value>Dom,Lun,Mar,Mie,Jue,Vie,Sab</default_value>
        <description>Abreviatura días de la semana</description>
      </parameter>
      <parameter>
        <name>DIA_INICIO</name>
        <default_value>01/01/1980</default_value>
        <description>Dia inicial</description>
      </parameter>
      <parameter>
        <name>MESES_ANO</name>
        <default_value>Enero, Febrero,Marzo,Abril,Mayo,Junio,Julio,Agosto,Septiembre,Octubre,Noviembre,Diciembre</default_value>
        <description>Meses del año </description>
      </parameter>
      <parameter>
        <name>MESES_ANO_ABREV</name>
        <default_value>Ene,Feb,Mar,Abr,May,Jun,Jul,Ago,Sep,Oct,Nov,Dic</default_value>
        <description>Abreviatura meses del año</description>
      </parameter>
      <parameter>
        <name>dw_clave</name>
        <default_value>postgres</default_value>
        <description>password del usuario de la base siu_dw</description>
      </parameter>
      <parameter>
        <name>dw_nombrebase</name>
        <default_value>siu_wichi</default_value>
        <description>nombre de la base de datos dw</description>
      </parameter>
      <parameter>
        <name>dw_nombrehost</name>
        <default_value>localhost</default_value>
        <description>nombre o ip del host de la base dw</description>
      </parameter>
      <parameter>
        <name>dw_puerto</name>
        <default_value>5432</default_value>
        <description>puerto al que se conecta a la base de datos dw</description>
      </parameter>
      <parameter>
        <name>dw_usuario</name>
        <default_value>postgres</default_value>
        <description>nombre de usuario de la base siu_dw</description>
