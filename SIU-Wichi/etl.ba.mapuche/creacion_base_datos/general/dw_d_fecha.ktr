        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

var trimestre_desc;
var semestre;
var semestre_desc;
var trimestre_actual = trimestre.getInteger();

switch(trimestre_actual){
	case 1:
		trimestre_desc = "1er Trimestre";
		semestre_desc = "1er Semestre";
		semestre = 1
		break;
	case 2:
		trimestre_desc = "2do Trimestre";
		semestre_desc = "1er Semestre";
		semestre = 1;
		break;
	case 3:
		trimestre_desc = "3er Trimestre";
		semestre_desc = "2do Semestre";
		semestre = 2;
		break;
	case 4:
		trimestre_desc = "4to Trimestre";
		semestre_desc = "2do Semestre";
		semestre = 2;
		break;
	default: 
		trimestre_desc = "NADA";
		semestre_desc = "NADA";
		semestre = 999;
		break;
}
</jsScript_script>
      </jsScript>
