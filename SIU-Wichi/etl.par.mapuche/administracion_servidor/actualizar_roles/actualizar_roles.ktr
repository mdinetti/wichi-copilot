    <connection>wichi</connection>
    <sql>SELECT DISTINCT rol_desc, unidad_generica_desc
FROM public.d_unidad_generica uagenerica, public.d_unidad unidad
WHERE uagenerica.unidad_generica_id=unidad.unidad_generica_id
    AND unidad_generica_desc &lt;&gt; ''
    AND rol_desc &lt;&gt; ''
    --AND unidad.unidad_generica_id > 0 HC: comentado el 7/9/2020 para que agrege las UA sin definir (0)
ORDER BY rol_desc;
</sql>
