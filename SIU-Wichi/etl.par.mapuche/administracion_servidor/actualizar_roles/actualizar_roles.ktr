  <step>
    <name>formatear</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>/*
 * Formatea el xml: indentación y enmascarado
 * El enmascarado va a fallar cuando hayan &lt; y > en fórmulas
 * o comillas sueltas en algunos lugares.
 * se incluye el encabezado &lt;?xml ...> por las dudas.
 */

const indentacion = '  '
var partes1 = xml.split('&lt;');
var margen = 0
for (i=0; i&lt;partes1.length; i++) {
	parte1 = partes1[i]
	partes2 = parte1.split('>')
	if(partes2.length != 2) {
		var temp = 1;
		//trans_Status = ERROR_TRANSFORMATION;
		//newRow = createRowCopy(getOutputRowMeta().size());
		//newRow[getInputRowMeta().size()] = 'error!!!'
		//putRow(newRow);
	}
	else {
		var tagEscapado = escapeXml(partes2[0])
		var tagAux = replace(tagEscapado, '&amp;quot;', '"');
		var tag = replace(tagAux, '&amp;amp;', '&amp;');
		if(tag[0]=='/') { //cierra
			margen = margen - 1
		}
		var linea1 = '&lt;' + tag + '>'
		for(j=0; j&lt;margen; j++) {
			linea1 = indentacion + linea1
		}
		if(tag[0]!='/' &amp;&amp; tag[tag.length-1]!='/' &amp;&amp; tag[0]!='?') { //abre
			margen = margen + 1
		}
		newRow = createRowCopy(getOutputRowMeta().size());
		newRow[getInputRowMeta().size()] = linea1
		putRow(newRow);
		/* var linea2 = escapeXml(partes2[1]);
		*if(linea2 != null &amp;&amp; linea2 != '') {
		*	linea2 = linea2;
		*	for(j=0; j&lt;margen; j++) {
		*		linea2 = indentacion + linea2
		*	}
		*	newRow = createRowCopy(getOutputRowMeta().size());
		*	newRow[getInputRowMeta().size()] = linea2
		*	putRow(newRow);
		}*/
	}
}

// Don't output the input row.
trans_Status = SKIP_TRANSFORMATION;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>linea</name>
        <rename>linea</rename>
