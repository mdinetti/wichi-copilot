  id_convocatoria,
  expediente_ejercicio_conv,
  expediente_convocatoria,
  tipo_procedimiento_convocatoria,
  id_oficina_convocatoria,
  id_procedimiento_modalidad,
  id_procedimiento_clase,  
  usuario_autorizante_conv,
  fecha_autorizacion_conv,
  id_renglon,
  descripcion_renglon,
  numero_renglon,
