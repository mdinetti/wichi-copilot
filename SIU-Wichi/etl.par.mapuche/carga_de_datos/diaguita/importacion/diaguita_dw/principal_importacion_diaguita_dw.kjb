  fecha_creacion_dictamen,
  fecha_generacion_dictamen,
  identificador_dictamen,
  estado_dictamen,
  id_renglon_ad,
  estado_adjudicacion,
  identificador_adjudicacion,
  id_proveedor,
  cantidad_ad,
  monto_unitario,
  id_adjudicacion,
  id_renglon_area_oc,
  id_detalle_orden_compra_oc,
  id_proveedor_oc,
  id_area_oc,
  estado_orden_compra,
  identificador_orden_compra,
  fecha_emision_oc,
  id_lugar_entrega_oc,
  fecha_vencimiento_oc,
  cantidad_oc,
  monto_unitario_oc,
  id_adjudicacion_oc,
  id_moneda_oc,
  id_detalle_orden_compra_re,
  fecha_recepcion,
  estado_recepcion,
  remito,
  factura_numero,
  identificador_acta_provisoria_recepcion,
  fecha_acta_provisoria_re,
  id_area_re,
  identificador_acta_definitiva_recepcion,
  fecha_acta_definitiva_re,
  cantidad_recibida,
  cantidad_aceptada,
  cantidad_rechazada,
  importe_total_solicitud,
  importe_total_convocatoria,
  importe_total_adjudicado,
  importe_total_oc
)
SELECT 
  id_compras,
  etapa,
  identificador_solicitud,
  fecha_creacion_solicitud,
  descripcion_solicitud,
  prioridad_solicitud,
