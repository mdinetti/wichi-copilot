    <entry>
      <name>carga_datos_compras</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE diaguita.d_lugar_entrega;
TRUNCATE TABLE diaguita.d_oficina_contrataciones;
TRUNCATE TABLE diaguita.d_proveedor;
TRUNCATE TABLE diaguita.d_procedimiento_modalidades;
TRUNCATE TABLE diaguita.d_procedimiento_clases;
TRUNCATE TABLE diaguita.d_rubro;
TRUNCATE TABLE diaguita.d_moneda;
TRUNCATE TABLE diaguita.d_usuario;
TRUNCATE TABLE diaguita.ft_compras;
INSERT INTO diaguita.d_lugar_entrega SELECT * FROM diaguita_dsa.d_lugar_entrega;
INSERT INTO diaguita.d_oficina_contrataciones SELECT * FROM diaguita_dsa.d_oficina_contrataciones;
INSERT INTO diaguita.d_proveedor SELECT * FROM diaguita_dsa.d_proveedor;
INSERT INTO diaguita.d_procedimiento_modalidades SELECT * FROM diaguita_dsa.d_procedimiento_modalidades;
INSERT INTO diaguita.d_procedimiento_clases SELECT * FROM diaguita_dsa.d_procedimiento_clases;
INSERT INTO diaguita.d_rubro SELECT * FROM diaguita_dsa.d_rubro;
INSERT INTO diaguita.d_moneda SELECT * FROM diaguita_dsa.d_moneda;
INSERT INTO diaguita.d_usuario SELECT * FROM diaguita_dsa.d_usuario;
INSERT INTO diaguita.ft_compras (
  id_compras,
  etapa,
  identificador_solicitud,
  fecha_creacion_solicitud,
  descripcion_solicitud,
