  <step>
    <name>ft_preinscripciones</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_preinscripciones</connection>
    <sql>SELECT  responsable_academica, propuesta, ubicacion, modalidad, periodo_insc, date(fecha_preinscripcion) as fecha_preinscripcion, pp.estado as estado_preinsc,  
apellido || ', ' || nombres as apyno,
tipo_documento,
nro_documento, 
sexo::integer, fecha_nacimiento, 
CASE WHEN (extract(MONTH FROM fecha_preinscripcion) - extract(MONTH FROM fecha_nacimiento)) &lt; 0
	THEN ((extract(Year FROM fecha_preinscripcion) - extract(YEAR FROM fecha_nacimiento)) - 1)
	WHEN ((extract(MONTH FROM fecha_preinscripcion) - extract(MONTH FROM fecha_nacimiento)) = 0) AND (extract(DAY FROM fecha_nacimiento) > 1)
	THEN (extract(Year FROM fecha_preinscripcion) - extract(YEAR FROM fecha_nacimiento) - 1)
	ELSE (extract(Year FROM fecha_preinscripcion) - extract(YEAR FROM fecha_nacimiento)) END AS edad,
nacionalidad,
loc_nacimiento, estado_civil, alu_est_civil_uh,
CASE 
	WHEN turno_preferido = 'M' THEN 1
    WHEN turno_preferido = 'T' THEN 2
    WHEN turno_preferido = 'N' THEN 3
    ELSE 0
END as turno_preferido,
colegio_secundario, titulo_secundario, anio_egreso_sec,
CASE
	WHEN existe_trab_alum IS NULL OR (existe_trab_alum = 1 AND hora_sem_trab_alum IS NULL) THEN '-8' 
	WHEN existe_trab_alum = 1 THEN hora_sem_trab_alum 
	WHEN existe_trab_alum = 4 THEN '-8'   
	ELSE '-9' 
END  as alu_trabajo,
 --sit_laboral_alu,
pertenece_pueblo_originario, pueblo_originario, pueblo_originario_otro,
identidad_genero, identidad_genero_otro, 
celular_numero, e_mail,
apellido_elegido || ', ' || nombres_elegido as apyno_elegido, 
apellido_padre || ', ' || nombres_padre as apyno_padre, 
apellido_madre || ', ' || nombres_madre as apyno_madre, 
sit_laboral_padre, padre_trab_ocup, sit_laboral_madre, madre_trab_ocup,
--sit_actual_padre, sit_actual_madre, 
CASE WHEN padre_vive = 'S' THEN 'V'
ELSE padre_vive END as sit_actual_padre, 
CASE WHEN madre_vive = 'S' THEN 'V'
ELSE madre_vive END as sit_actual_madre,
CASE WHEN ult_est_cur_padre = 12 THEN 13
	WHEN (ult_est_cur_padre is null) THEN 0
	WHEN (ult_est_cur_padre = 13) THEN -2
	WHEN ult_est_cur_padre = 14 THEN 12
	ELSE ult_est_cur_padre END as nivel_estudio_padre,  
CASE WHEN ult_est_cur_madre = 12 THEN 13
	WHEN (ult_est_cur_madre is null) THEN 0
	WHEN (ult_est_cur_madre = 13) THEN -2
	WHEN ult_est_cur_madre = 14 THEN 12
	ELSE ult_est_cur_madre END as nivel_estudio_madre, 
tipo_allegado, apellido_pers_alleg || ', ' || nombre_pers_alleg as apyno_pers_alleg, 
(CASE WHEN alu_cos_est_ap_fam = 'S' THEN 'familiar-' ELSE '' END 
	|| CASE WHEN alu_cos_est_plsoc = 'S' THEN 'plan_social-' ELSE '' END 
	|| CASE WHEN alu_cos_est_trab = 'S' THEN 'trabajo-' ELSE '' END 
	|| CASE WHEN alu_cos_est_beca = 'S' THEN 'beca-' ELSE '' END 
	|| CASE WHEN alu_cos_est_otra = 'S' THEN 'otro-' ELSE '' END) as costeo_estudios,
tiene_beca,
(CASE WHEN alu_tec_pc_casa = 'S' THEN 'casa-' ELSE '' END 
	|| CASE WHEN alu_tec_pc_trab = 'S' THEN 'trabajo-' ELSE '' END 
	|| CASE WHEN alu_tec_pc_univ = 'S' THEN 'universidad-' ELSE '' END 
	|| CASE WHEN alu_tec_pc_otro = 'S' THEN 'otro-' ELSE '' END) as tecno_pc,

(CASE WHEN alu_tec_int_movil = 'S' THEN 'movil-' ELSE '' END 
    || CASE WHEN alu_tec_int_casa = 'S' THEN 'casa-' ELSE '' END 
	|| CASE WHEN alu_tec_int_trab = 'S' THEN 'trabajo-' ELSE '' END 
	|| CASE WHEN alu_tec_int_univ = 'S' THEN 'universidad-' ELSE '' END 
	|| CASE WHEN alu_tec_int_otro = 'S' THEN 'lugar-' ELSE '' END) as tecno_int,

(CASE WHEN alu_idioma_ingl::integer in (1,2,3) THEN 'Ingles-' ELSE '' END 
	|| CASE WHEN alu_idioma_alem::integer in (1,2,3) THEN 'Alemán-' ELSE '' END 
	|| CASE WHEN alu_idioma_fran::integer in (1,2,3) THEN 'Francés-' ELSE '' END 
	|| CASE WHEN alu_idioma_ital::integer in (1,2,3) THEN 'Italiano-' ELSE '' END 
	|| CASE WHEN alu_idioma_port::integer in (1,2,3) THEN 'Portugués-' ELSE '' END 
	|| CASE WHEN alu_idioma_chino::integer in (1,2,3) THEN 'Chino-' ELSE '' END 
	|| CASE WHEN alu_idioma_otro is not null THEN 'Otro-' ELSE '' END) as idioma ,

condicion_discapacidad,
tiene_cud,
(CASE WHEN disc_auditiva = 'S' THEN 'disc_auditiva-' ELSE '' END 
	|| CASE WHEN disc_visual = 'S' THEN 'disc_visual-' ELSE '' END 
	|| CASE WHEN disc_motora = 'S' THEN 'disc_motora-' ELSE '' END 
	|| CASE WHEN disc_cond_psicosocial = 'S' THEN 'disc_cond_psicosocial-' ELSE '' END 
	|| CASE WHEN disc_otra = 'S' THEN 'disc_otra-' ELSE '' END ) as discapacidad,

cant_hijos_alum, 
vive_actual_con, 
obra_social_alu,  
loc_per_lect, 
loc_proc, 
es_celiaco, adeuda_materias --, p.estado
FROM public.sga_preinscripcion_propuestas pp LEFT JOIN public.sga_preinscripcion p ON (pp.id_preinscripcion = p.id_preinscripcion)</sql>
    <limit>0</limit>
