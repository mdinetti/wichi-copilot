  <step>
    <name>base_pilaga</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_pilaga</connection>
    <sql>--movimientos de tesoreria &#x28;ingresos y egresos&#x29;&#xa;--ft_tesorerias&#xa;SELECT  &#xa;	mov_tran.fecha_transaccion as fecha,&#xa;	date_part&#x28;&#x27;year&#x27;,mov_tran.fecha_transaccion&#x29;&#x3a;&#x3a;integer AS anio,	&#xa;	date_part&#x28;&#x27;month&#x27;,mov_tran.fecha_transaccion&#x29;&#x3a;&#x3a;integer AS mes,  &#xa;	mov_det.medio_pago as medio_pago,&#xa;	case when sau_te_cheques_propios.numero_cheque is not null then sau_te_cheques_propios.numero_cheque&#xa;	      when sau_te_cheques_terceros.numero_cheque is not null then sau_te_cheques_terceros.numero_cheque&#xa;	      else sau_te_transferencias_bancaria.numero_transferencia&#xa;	end as numero_medio ,&#xa;	case when pasox.tipo_doc_ppal is null then pa_dev.tipo_doc_ppal&#x3a;&#x3a;varchar else pasox.tipo_doc_ppal&#x3a;&#x3a;varchar end &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c;&#xa;	case when pasox.nro_doc_ppal  is null then pa_dev.nro_doc_ppal&#x3a;&#x3a;varchar  else pasox.nro_doc_ppal&#x3a;&#x3a;varchar  end &#x7c;&#x7c; &#x27; &#x2f; &#x27; &#x7c;&#x7c;&#xa;	case when pasox.anio_doc_ppal is null then pa_dev.anio_doc_ppal&#x3a;&#x3a;varchar else pasox.anio_doc_ppal&#x3a;&#x3a;varchar end AS documento_principal_codigo,&#xa;	cta_teso.cuenta_tesoreria as cuenta_tesoreria ,&#xa;	cta_teso_b.persona as bancocb,&#xa;	cta_teso_b.sucursal as sucursalcb,&#xa;	cta_teso_b.cuenta as cuenta,&#xa;	sucursal.codigo_sucursal as sucursal_codigo, &#xa;	case when mov_det.cuenta_credito &#x3d; cta_teso.cuenta_tesoreria then mov_det.importe else 0 end as debito,&#xa; 	case when mov_det.cuenta_debito &#x3d; cta_teso.cuenta_tesoreria then mov_det.importe else 0  end as credito&#xa; 	&#xa;   FROM sau_gb_pasos as pa_dev&#xa;        INNER JOIN anx_personas as p ON p.persona &#x3d; pa_dev.proveedor_o_beneficiario&#xa;        INNER JOIN sau_li_liquidaciones as li ON pa_dev.paso &#x3d; li.nro_operacion_original&#xa;	INNER JOIN sau_te_pagos_planificados as pp ON li.liquidacion &#x3d; pp.liquidacion&#xa;	INNER JOIN sau_te_planificados_x_pago as pxp ON pp.pago_planificado &#x3d; pxp.pago_planificado&#xa;   	INNER JOIN sau_te_mov_transacciones as mov_tran ON mov_tran.transaccion &#x3d; pxp.transaccion&#xa;	INNER JOIN sau_te_movimientos_financieros as mov ON mov_tran.movimiento_financiero &#x3d; mov.movimiento_financiero&#xa;	INNER JOIN sau_te_mov_financiero_detalles as mov_det ON mov_det.transaccion &#x3d; mov_tran.transaccion --mov_tran_2.transaccion --AND mov_det.orden &#x3d; mov_tran_2.orden&#xa;	LEFT OUTER JOIN &#x28;sau_te_cheques_pagos &#xa;			INNER JOIN sau_te_cheques_propios ON sau_te_cheques_propios.cheque &#x3d; sau_te_cheques_pagos.cheque&#x29; &#xa;		 ON mov_det.transaccion &#x3d; sau_te_cheques_pagos.transaccion &#xa;		AND mov_det.orden &#x3d; sau_te_cheques_pagos.orden&#xa;	LEFT OUTER JOIN &#x28;sau_te_transferencias_pagos &#xa;			INNER JOIN sau_te_transferencias_bancaria ON sau_te_transferencias_bancaria.transferencia_bancaria &#x3d; sau_te_transferencias_pagos.transferencia_bancaria&#x29; &#xa;			ON mov_det.transaccion &#x3d; sau_te_transferencias_pagos.transaccion  &#xa;			AND mov_det.orden &#x3d; sau_te_transferencias_pagos.orden&#xa;	LEFT OUTER JOIN &#x28;sau_te_cheques_ter_mov &#xa;			INNER JOIN sau_te_cheques_terceros ON sau_te_cheques_terceros.cheque_tercero &#x3d; sau_te_cheques_ter_mov.cheque_tercero&#x29; &#xa;			ON mov_det.transaccion &#x3d; sau_te_cheques_ter_mov.transaccion AND mov_det.orden &#x3d; sau_te_cheques_ter_mov.orden&#xa;	INNER JOIN sau_te_medios as medio ON medio.medio_pago &#x3d; mov_det.medio_pago&#xa;	JOIN sau_te_cuentas_tesoreria as cta_teso  ON &#x28;cta_teso.cuenta_tesoreria  &#x3d; mov_det.cuenta_debito or  cta_teso.cuenta_tesoreria &#x3d; mov_det.cuenta_credito&#x29;&#xa;	LEFT OUTER JOIN sau_te_cuentas_teso_bancarias as cta_teso_b ON cta_teso_b.cuenta_tesoreria &#x3d; cta_teso.cuenta_tesoreria&#xa;	LEFT OUTER JOIN sau_te_cuentas_bancarias as cta_bancaria ON cta_bancaria.banco &#x3d; cta_teso_b.persona &#xa;			and cta_bancaria.sucursal &#x3d; cta_teso_b.sucursal and cta_bancaria.cuenta &#x3d; cta_teso_b.cuenta&#xa;	LEFT OUTER JOIN sau_te_sucursales as sucursal ON sucursal.banco &#x3d; cta_bancaria.banco and sucursal.sucursal &#x3d; cta_bancaria.sucursal&#xa;	LEFT OUTER JOIN sau_te_bancos as banco ON banco.banco &#x3d; cta_bancaria.banco&#xa;	LEFT OUTER JOIN sau_gb_pasos as pasox ON mov.paso &#x3d; pasox.paso&#xa;   WHERE &#xa;   date_part&#x28;&#x27;year&#x27;,mov_tran.fecha_transaccion&#x29;&#x3a;&#x3a;integer &#x3d; &#x28;SELECT ejercicio&#x3a;&#x3a;integer FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27; or estado&#x3d;&#x27;AC&#x27;&#x29;&#x3b; &#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
