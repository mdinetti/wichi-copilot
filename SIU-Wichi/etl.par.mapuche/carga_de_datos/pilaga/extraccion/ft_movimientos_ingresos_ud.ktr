           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_pilaga</connection>
    <sql>--ft_movimientos -&#x3e; Ingresos&#xa;--Conculta para extraer los movimientos de Ingresos que iran a parar a la ft de movimientos&#xa;--Devengado&#xa;WITH tramites AS &#x28;SELECT &#x2a; FROM sau_gb_tramites WHERE circuito IN &#x28;&#x27;INGC&#x27;,&#x27;INGT&#x27;,&#x27;COMP&#x27;, &#x27;INGD&#x27;&#x29;&#x29;,&#xa; tramites2 AS &#x28;SELECT &#x2a; FROM sau_gb_tramites WHERE circuito IN &#x28;&#x27;INGC&#x27;,&#x27;INGT&#x27;, &#x27;INGD&#x27;&#x29;&#x29;&#xa;SELECT   pa.ejercicio&#x3a;&#x3a;integer AS ejercicio&#xa;	, tr.fecha&#x3a;&#x3a;date AS fecha_movimiento&#xa;	, pa.tramite&#xa;	, pa.paso&#xa;	, pa.paso_anterior&#xa;	, tr.fecha_valor&#x3a;&#x3a;date as fecha_valor&#xa;	, pa.tipo_contenedor as tipo_contenedor&#xa;	, pa.anio_contenedor as anio_contenedor&#xa;	, pa.nro_contenedor as nro_contenedor&#xa;	, NULL as fecha_vencimiento&#xa;	, replace&#x28;replace&#x28;pa.descripcion,E&#x27;&#x5c;r&#x27;, &#x27;&#x27;&#x29;,E&#x27;&#x5c;n&#x27;,&#x27;&#x27;&#x29; as concepto_desc&#xa;	, dm.etapa_presupuestaria&#xa;	, substring&#x28;dm.partida,29,1&#x29; as tipo_ejercicio --&#x28;A&#x29;actual o &#x28;R&#x29;remanente&#xa;	, eleul.codigo &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; elesu.codigo &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; eless.codigo as codup&#xa;	, elegp.codigo as codgru&#xa;	, elefu.codigo as codfuente&#xa;	, NULL as codinciso&#xa;	, NULL as coddec&#xa;	, NULL as codprog&#xa;	, NULL as codfun&#xa;	, NULL as codfi&#xa;	, NULL as codcre&#xa;	, tramites.circuito as codgest -- gestion&#xa;	, 0.0 as credito_original&#xa;	, 0.0 as credito_modificatorio&#xa;	, 0.0 as credito&#xa;	, 0.0 as preventivo&#xa;	, 0.0 as compromiso&#xa;	, 0.0 as devengado&#xa;	, 0.0 as pagado&#xa;	, case when dm.etapa_presupuestaria &#x3d; &#x27;PI&#x27; then ctx.importe_devengado &#x2a; con_el.porcentaje &#x2f; 100 else 0.0 end as previsto_de_ingreso&#xa;	, case when dm.etapa_presupuestaria &#x3d; &#x27;EI&#x27; then ctx.importe_devengado &#x2a; con_el.porcentaje &#x2f; 100 else 0.0 end as estimado_de_ingreso&#xa; 	, case when dm.etapa_presupuestaria &#x3d; &#x27;DI&#x27; then ctx.importe_devengado &#x2a; con_el.porcentaje &#x2f; 100 else 0.0 end as devengado_de_ingreso&#xa;    , case when dm.etapa_presupuestaria &#x3d; &#x27;CI&#x27; then ctx.importe_cobrado &#x2a; con_el.porcentaje &#x2f; 100 else 0.0 end as cobrado&#xa;	--, ctx.importe_cobrado &#x2a; con_el.porcentaje &#x2f; 100 as cobrado	&#xa;	, elem.codigo_completo as codrubro&#xa;	, comp_d.concepto as codconcepto&#xa;	, substring&#x28;dm.partida,31,1&#x29; as moneda &#xa;	, pa.proveedor_o_beneficiario as codpersona&#xa;	, &#x27;C&#x27; as tipo_persona_codigo --Cliente&#xa;	, pa.tipo_doc_ppal as tipo_doc_ppal&#xa;	, pa.nro_doc_ppal as nro_doc_ppal &#xa;	, pa.anio_doc_ppal as anio_doc_ppal &#xa;	, pa.tipo_operacion&#xa;	, 0 as contribuyente_codigo&#xa;	, 0 as nivel_autorizacion_codigo&#xa;	, 0 as estado_liquidacion_codigo&#xa;	, 0 as retenciones&#xa;	, 0 as disponibilidades&#xa;	, extract&#x28;month from tr.fecha_valor&#x29; as mes&#xa;	, ctx.renglon&#xa;	, smcu.codigo_completo as codigo_ud&#xa;	, smgsu.tipo_resolucion  &#xa;	, smgsu.nro_resolucion  &#xa;	, smgsu.anio_resolucion&#xa;	&#xa;FROM tramites&#xa; INNER JOIN sau_gb_pasos as pa on tramites.tramite &#x3d; pa.tramite&#xa; INNER JOIN sau_gb_transacciones as tr on tr.paso &#x3d; pa.paso&#xa; INNER JOIN sau_gb_comprobantes_respaldo as cr ON pa.paso &#x3d; cr.paso OR pa.paso_anterior &#x3d; cr.paso&#xa; INNER JOIN sau_no_comprobantes_detalle as comp_d ON cr.comprobante &#x3d; comp_d.comprobante&#xa; INNER JOIN sau_no_concepto_transaccion as ctx ON ctx.numero_en_gestion &#x3d; tr.transaccion &#xa; AND ctx.tipo_operacion &#x3d; pa.tipo_operacion &#xa; AND ctx.comprobante &#x3d; comp_d.comprobante &#xa; AND ctx.renglon &#x3d; comp_d.renglon&#xa; &#xa; INNER JOIN sau_no_conceptos_elementos as con_el ON con_el.concepto &#x3d; comp_d.concepto&#xa; INNER JOIN sau_no_conceptos as con ON con.concepto &#x3d; con_el.concepto&#xa; INNER JOIN sau_np_elementos as elem ON elem.elemento &#x3d; con_el.elemento AND elem.componente &#x3d; &#x27;CL&#x27;&#xa; INNER JOIN sau_np_elementos as eleul ON eleul.elemento &#x3d; comp_d.unidad_principal&#xa; INNER JOIN sau_np_elementos as elesu ON elesu.elemento &#x3d; comp_d.sub_unidad&#xa; INNER JOIN sau_np_elementos as eless ON eless.elemento &#x3d; comp_d.sub_subunidad&#xa; INNER JOIN sau_np_elementos as elegp ON elegp.elemento &#x3d; comp_d.grupo_presupuestario&#xa; INNER JOIN sau_np_elementos as elefu ON elefu.elemento &#x3d; comp_d.fuente_fin&#xa; INNER JOIN sau_no_mapeador_transaccional mt ON tr.transaccion &#x3d; mt.numero_en_gestion&#xa; INNER JOIN sau_np_detalles_movimientos dm ON dm.mov_presupuestario_contable &#x3d; mt.mov_presupuestario_contable&#xa; AND dm.tm &#x3d; comp_d.tipo_moneda&#xa; LEFT JOIN sau_me_grupo_resolucion_ud as smgsu &#xa; 	INNER JOIN sau_me_codigos_ud as smcu ON smcu.ud_id &#x3d; smgsu.ud_id &#xa; ON smgsu.gp &#x3d; comp_d.grupo_presupuestario&#xa;&#xa;WHERE pa.tipo_operacion in &#x28;&#x27;CDCC&#x27;,&#x27;CDCT&#x27;,&#x27;CDIC&#x27;,&#x27;CDIT&#x27;,&#x27;RIDE&#x27;, &#x27;DTDI&#x27;&#x29;&#xa;AND pa.ejercicio&#x3a;&#x3a;integer &#x3d; &#x28;SELECT ejercicio&#x3a;&#x3a;integer FROM public.sau_no_ejercicios WHERE estado&#x3d;&#x27;A&#x27;&#x29;&#xa;&#xa;-- cobrado&#xa;UNION &#xa;--ft_movimientos -&#x3e; Ingresos&#xa;--Conculta para extraer los movimientos de Ingresos que ir&#xc3;&#xa1;n a parar a la ft de movimientos&#xa;SELECT   pa.ejercicio&#x3a;&#x3a;integer AS ejercicio &#xa;	, tr.fecha&#x3a;&#x3a;date AS fecha_movimiento&#xa;	, pa.tramite&#xa;	, pa.paso&#xa;	, pa.paso_anterior&#xa;	, tr.fecha_valor&#x3a;&#x3a;date as fecha_valor&#xa;	, doc_cobro.tipo_contenedor as tipo_contenedor&#xa;	, doc_cobro.anio_contenedor as anio_contenedor&#xa;	, doc_cobro.nro_contenedor as nro_contenedor&#xa;	, NULL as fecha_vencimiento&#xa;	, doc_cobro.concepto_desc as concepto_desc&#xa;	, dm.etapa_presupuestaria&#xa;	, substring&#x28;dm.partida,29,1&#x29; as tipo_ejercicio --&#x28;A&#x29;actual o &#x28;R&#x29;remanente&#xa;	, eleul.codigo &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; elesu.codigo &#x7c;&#x7c; &#x27;.&#x27; &#x7c;&#x7c; eless.codigo as codup&#xa;	, elegp.codigo as codgru&#xa;	, elefu.codigo as codfuente&#xa;	, NULL as codinciso&#xa;	, NULL as coddec&#xa;	, NULL as codprog&#xa;	, NULL as codfun&#xa;	, NULL as codfi&#xa;	, NULL as codcre&#xa;	, tramites2.circuito as codgest -- gestion&#xa;	, 0.0 as credito_original&#xa;	, 0.0 as credito_modificatorio&#xa;	, 0.0 as credito&#xa;	, 0.0 as preventivo&#xa;	, 0.0 as compromiso&#xa;	, 0.0 as devengado&#xa;	, 0.0 as pagado&#xa;	, case when dm.etapa_presupuestaria &#x3d; &#x27;PI&#x27; then ctx.importe_devengado &#x2a; con_el.porcentaje &#x2f; 100 else 0.0 end as previsto_de_ingreso&#xa;	, case when dm.etapa_presupuestaria &#x3d; &#x27;EI&#x27; then ctx.importe_devengado &#x2a; con_el.porcentaje &#x2f; 100 else 0.0 end as estimado_de_ingreso&#xa;	, case when dm.etapa_presupuestaria &#x3d; &#x27;DI&#x27; then ctx.importe_devengado &#x2a; con_el.porcentaje &#x2f; 100 else 0.0 end as devengado_de_ingreso&#xa;	, ctx.importe_cobrado &#x2a; con_el.porcentaje &#x2f; 100 as cobrado&#xa;	, elem.codigo_completo as codrubro&#xa;	, comp_d.concepto as codconcepto&#xa;	, substring&#x28;dm.partida,31,1&#x29; as moneda &#xa;	, pa.proveedor_o_beneficiario as codpersona&#xa;	, &#x27;C&#x27; as tipo_persona_codigo --Cliente&#xa;	, doc_cobro.tipo_doc_ppal as tipo_doc_ppal&#xa;	, doc_cobro.nro_doc_ppal as nro_doc_ppal &#xa;	, doc_cobro.anio_doc_ppal as anio_doc_ppal &#xa;	, pa.tipo_operacion&#xa;	, 0 as contribuyente_codigo&#xa;	, 0 as nivel_autorizacion_codigo&#xa;	, 0 as estado_liquidacion_codigo&#xa;	, 0 as retenciones&#xa;	, 0 as disponibilidades&#xa;	, extract&#x28;month from tr.fecha_valor&#x29; as mes&#xa;	, ctx.renglon&#xa;	, smcu.codigo_completo as codigo_ud &#xa;	, smgsu.tipo_resolucion  &#xa;	, smgsu.nro_resolucion  &#xa;	, smgsu.anio_resolucion&#xa;	&#xa;FROM tramites2&#xa; INNER JOIN sau_gb_pasos as pa on tramites2.tramite &#x3d; pa.tramite&#xa; INNER JOIN sau_gb_transacciones as tr on tr.paso &#x3d; pa.paso&#xa; INNER JOIN sau_gb_comprobantes_respaldo as cr ON pa.paso &#x3d; cr.paso OR pa.paso_anterior &#x3d; cr.paso&#xa; INNER JOIN sau_no_comprobantes_detalle as comp_d ON cr.comprobante &#x3d; comp_d.comprobante&#xa; INNER JOIN sau_no_concepto_transaccion as ctx ON ctx.numero_en_gestion &#x3d; tr.transaccion &#xa; AND ctx.tipo_operacion &#x3d; pa.tipo_operacion &#xa; AND ctx.comprobante &#x3d; comp_d.comprobante &#xa; AND ctx.renglon &#x3d; comp_d.renglon&#xa; &#xa; INNER JOIN sau_no_conceptos_elementos as con_el ON con_el.concepto &#x3d; comp_d.concepto&#xa; INNER JOIN sau_no_conceptos as con ON con.concepto &#x3d; con_el.concepto&#xa; INNER JOIN sau_np_elementos as elem ON elem.elemento &#x3d; con_el.elemento AND elem.componente &#x3d; &#x27;CL&#x27;&#xa; INNER JOIN sau_np_elementos as eleul ON eleul.elemento &#x3d; comp_d.unidad_principal&#xa; INNER JOIN sau_np_elementos as elesu ON elesu.elemento &#x3d; comp_d.sub_unidad&#xa; INNER JOIN sau_np_elementos as eless ON eless.elemento &#x3d; comp_d.sub_subunidad&#xa; INNER JOIN sau_np_elementos as elegp ON elegp.elemento &#x3d; comp_d.grupo_presupuestario&#xa; INNER JOIN sau_np_elementos as elefu ON elefu.elemento &#x3d; comp_d.fuente_fin&#xa; INNER JOIN sau_no_mapeador_transaccional mt ON tr.transaccion &#x3d; mt.numero_en_gestion&#xa; INNER JOIN sau_np_detalles_movimientos dm ON dm.mov_presupuestario_contable &#x3d; mt.mov_presupuestario_contable&#xa; AND dm.tm &#x3d; comp_d.tipo_moneda&#xa; LEFT OUTER JOIN &#x28;SELECT pp.paso, pa.tipo_doc_ppal, pa.nro_doc_ppal, pa.anio_doc_ppal, pa.tipo_contenedor, pa.nro_contenedor, anio_contenedor, replace&#x28;replace&#x28;pa.descripcion,E&#x27;&#x5c;r&#x27;, &#x27;&#x27;&#x29;,E&#x27;&#x5c;n&#x27;,&#x27;&#x27;&#x29; as concepto_desc&#xa;		    FROM sau_gb_pasos as pa&#xa;		    , sau_te_movimientos_financieros as mf&#xa;		    , sau_te_mov_transacciones  as tx_mf&#xa;		    , sau_te_planificados_x_pago as pxp&#xa;		    , sau_te_pagos_planificados  as pp&#xa;		    WHERE mf.paso &#x3d; pa.paso&#xa;		      AND tx_mf.movimiento_financiero &#x3d; mf.movimiento_financiero&#xa;			  AND pxp.transaccion &#x3d; tx_mf.transaccion&#xa;			  AND pp.pago_planificado &#x3d; pxp.pago_planificado&#xa;			  AND pa.nro_doc_ppal  is not null&#xa;			&#x29; as doc_cobro ON doc_cobro.paso &#x3d; pa.paso&#xa; LEFT JOIN sau_me_grupo_resolucion_ud as smgsu &#xa; 	INNER JOIN sau_me_codigos_ud as smcu ON smcu.ud_id &#x3d; smgsu.ud_id &#xa; ON smgsu.gp &#x3d; comp_d.grupo_presupuestario&#xa;WHERE pa.tipo_operacion in &#x28; &#x27;CCIC&#x27;, &#x27;CCIT&#x27;, &#x27;DTPA&#x27;&#x29;&#x3b;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>192</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

