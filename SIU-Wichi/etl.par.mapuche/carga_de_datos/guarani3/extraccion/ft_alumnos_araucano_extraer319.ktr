  <step>
    <name>alumnos</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_guarani</connection>
    <sql>-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Generación del archivo LT_Alumnos.txt
--
-- Año de ingreso: Si tiene ciclo basico, entonces ingreso al ciclo basico sino el ingreso en la propuesta.
-- Devuelve los datos por "año academico + alumno (x propuesta) + titulo araucano"
-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
With ha as (SELECT * FROM _wichi_ha_x_titulo_anio WHERE anio_academico = ?)
SELECT distinct
	ha.anio_academico,
	sga_alumnos.plan_version,
	sga_alumnos.propuesta as propuesta_formativa,
	sga_alumnos.ubicacion,
	ha.titulo_araucano as titulo_araucano,
	(CASE mdp_personas.sexo WHEN 'M' THEN 1 WHEN 'F' THEN 2 WHEN 'X' THEN 3 END) as sexo,
	ingreso.anio_academico_ciclo_basico as anio_ingreso_propuesta ,      -- año de ingresoal ciclo basico. si no tiene ciclo basico muestra el de la propuesta
	(SELECT CASE WHEN mdp_datos_estudios.nivel_estudio = 3 THEN mdp_datos_estudios.colegio 
			ELSE NULL END
		FROM mdp_datos_estudios 
		WHERE mdp_datos_estudios.persona = mdp_personas.persona
		LIMIT 1) as colegio_id,
	ha.cant_act_realizadas as cant_rendidas, 
	ha.cant_act_aprobadas as cant_aprobadas, 
	ha.cant_act_realizadas_anio_anterior as cant_rendidas_anio_anterior, 
	ha.cant_act_aprobadas_anio_anterior as cant_aprobadas_anio_anterior, 
	wdc.hs_trabajo_situacion_alumno,
    --ingreso.tipo_ingreso_propuesta,
   'SELECT public.get_forma_ingreso_interfaces_corta('||ha.alumno||','||ingreso.anio_academico_propuesta||');' query_forma_ingreso,
    (CASE WHEN fecha_nacimiento IS NULL THEN NULL ELSE (
		extract(year from age(date (ha.anio_academico ||'-12-31'), fecha_nacimiento))
	) END) as edad,
    ha.alumno as alumno,
	mdp_personas.nacionalidad,
	sga_alumnos.calidad,
    sga_alumnos.modalidad,
	(SELECT	COALESCE(min(trabajo_existe),4) FROM mdp_personas_allegados pa LEFT JOIN mdp_datos_censales dc ON (pa.dato_censal = dc.dato_censal)
	WHERE tipo_allegado IN ('P','M','T') AND dc.persona = sga_alumnos.persona) as max_trabajo_padres,
	wdc.max_estudio_padres,
	sga_alumnos.persona,
	wdc.estado_civil,
	wdc.localidad_per_lec,
	wdc.localidad_proc,
	wdc.costeo_estudios,
	wdc.beca,
	wdc.tecno_internet,
	wdc.tecno_pc,
	wdc.idioma,
	wdc.discapacidad,
	ingreso.situacion_asp,
    (CASE WHEN nui.alumno IS NOT NULL THEN 1 ELSE NULL END) as nuevos_inscriptos,
    (CASE WHEN rei.alumno IS NOT NULL THEN 1 ELSE NULL END) as reinscriptos,
    (CASE WHEN egr.alumno IS NOT NULL THEN 1 ELSE NULL END) as egresados,
	0 as campo_cero
FROM
    _wichi_alumnos alu JOIN ha ON (ha.alumno = alu.alumno AND ha.certificado = alu.certificado)
    LEFT JOIN _wichi_nui_rei_egr nui ON (nui.alumno = ha.alumno AND nui.anio_academico = ha.anio_academico AND (ha.titulo_nivel &lt;&gt; 'INTERMEDIO' OR ha.titulo_nivel IS NULL) AND (nui.titulo_araucano = ha.titulo_araucano OR ha.titulo_araucano IS NULL) AND nui.categoria_araucano = 'NUI')
    LEFT JOIN _wichi_nui_rei_egr rei ON (rei.alumno = ha.alumno AND rei.anio_academico = ha.anio_academico AND (ha.titulo_nivel &lt;&gt; 'INTERMEDIO' OR ha.titulo_nivel IS NULL) AND (rei.titulo_araucano = ha.titulo_araucano OR ha.titulo_araucano IS NULL) AND rei.categoria_araucano = 'REI')
    LEFT JOIN _wichi_nui_rei_egr egr ON (egr.alumno = ha.alumno AND egr.anio_academico = ha.anio_academico  AND (egr.titulo_araucano = ha.titulo_araucano OR ha.titulo_araucano IS NULL) AND egr.categoria_araucano = 'EGR')
    LEFT JOIN _wichi_ingreso_alumnos ingreso ON (ingreso.alumno = alu.alumno)
    LEFT JOIN sga_alumnos ON (sga_alumnos.alumno = alu.alumno)
	LEFT JOIN _wichi_datos_censales wdc ON (sga_alumnos.persona = wdc.persona AND ha.anio_academico = wdc.anio_academico),
    mdp_personas
WHERE mdp_personas.persona = sga_alumnos.persona
 AND (
        nui.alumno IS NOT NULL or
        rei.alumno IS NOT NULL or
        egr.alumno IS NOT NULL
 )</sql>
