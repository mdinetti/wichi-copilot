  <step>
    <name>Unidades Academicas</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>--Retorna la cantidad de UA de las que hay en la FT que no se cargaron en el tmp de la dimension UA&#xa;--0 &#x3d; se van actualizar todas las UA&#xa;--&#x3c;&#x3e; 0 &#x3d; solo se actualizan algunas UA&#xa;select count&#x28;&#x2a;&#x29; as cantidad_ua&#xa;from &#xa;&#x28;&#xa;select unidad_adademica_ft, unidad_academica_dim&#xa;from&#xa;&#x28;&#xa;--IDs unidades academicas FT&#xa;select distinct &#x28;unidadacademica_id&#x29; as unidad_adademica_ft&#xa;from guarani.&#x24;&#x7b;tabla_ft&#x7d;  &#xa;--gua_dw_ft_alumnosarau&#xa;&#x29; a&#xa;left join &#xa;--devuelve los ids de las unidades acad&#xe9;micas de la dimensi&#xf3;n correspondientes a las UA cargadas en el tmp &#xa;&#x28;&#xa;select distinct&#x28;b.unidadacademica_id&#x29; as unidad_academica_dim&#xa;from guarani_tmp.gua_dsa_lt_unidadesacademicas a &#xa;inner join guarani.gua_dw_lt_unidadesacademicas b&#xa;on a.unidadacademica_id &#x3d; b.unidadacademica_id_gua&#xa;&#x29;b&#xa;ON a.unidad_adademica_ft &#x3d; b.unidad_academica_dim&#xa;&#x29;sub&#xa;where sub.unidad_academica_dim is null&#xa;&#x3b;&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>275</xloc>
      <yloc>129</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step_error_handling>
  </step_error_handling>
