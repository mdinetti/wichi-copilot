  <step>
    <name>obtener_datos_academica</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>origen_siu_wichi</connection>
    <sql>SELECT&#xa;	anio_id&#xa;	, unidad_generica_id&#xa;	, anio_ingreso_id&#xa;	, genero_id&#xa;	, titulo_id&#xa;	, nivel AS nivel&#xa;	, sum&#x28;cant_nip&#x29; AS cant_nip&#xa;	, sum&#x28;cant_nie&#x29; AS cant_nie&#xa;	, sum&#x28;cant_ni&#x29; AS cant_ni&#xa;    , sum&#x28;cant_ni_en_actividad&#x29; AS cant_ni_en_actividad&#xa;	, sum&#x28;cant_r&#x29; AS cant_r&#xa;	, sum&#x28;cant_ep&#x29; AS cant_ep&#xa;	, sum&#x28;cant_ee&#x29; AS cant_ee&#xa;FROM &#xa;	&#x28;&#xa;	SELECT&#xa;		c.idanioinformado AS anio_id&#xa;		, c.unidad_generica_id&#xa;		, 0 AS anio_ingreso_id&#xa;		, COALESCE&#x28;gt.genero_id, 0&#x29; AS genero_id&#xa;		, c.idtitulo AS titulo_id&#xa;		, tt.nivel AS nivel&#xa;		, sum&#x28;cantidad&#x29; AS cant_nip&#xa;		, 0 AS cant_nie&#xa;		, 0 AS cant_ni&#xa;        , 0 AS cant_ni_en_actividad&#xa;		, 0 AS cant_r&#xa;		, 0 AS cant_ep&#xa;		, 0 AS cant_ee&#xa;	FROM araucano.academica_ft_cuadros1y2 c&#xa;		INNER JOIN araucano.academica_d_series s&#xa;			ON c.idserie &#x3d; s.idserie &#xa;		INNER JOIN araucano.academica_d_tipostitulos tt&#xa;			ON c.idtipotitulo &#x3d; tt.idtipotitulo&#xa;		INNER JOIN araucano.academica_d_generos g&#xa;			ON c.idgenero &#x3d; g.idgenero&#xa;		LEFT JOIN public.d_genero gt&#xa;			ON g.generodescripcion &#x3d; gt.genero_desc&#xa;	WHERE s.serie&#x3d;&#x27;NIP&#x27;&#xa;	GROUP BY 1,2,3,4,5,6&#xa;	-----&#xa;	UNION&#xa;	-----&#xa;	SELECT&#xa;		c.idanioinformado AS anio_id&#xa;		, c.unidad_generica_id&#xa;		, 0 AS anio_ingreso_id&#xa;		, COALESCE&#x28;gt.genero_id, 0&#x29; AS genero_id&#xa;		, c.idtitulo AS titulo_id&#xa;		, tt.nivel AS nivel&#xa;		, 0 AS cant_nip&#xa;		, sum&#x28;cantidad&#x29; AS cant_nie&#xa;		, 0 AS cant_ni&#xa;        , 0 AS cant_ni_en_actividad&#xa;		, 0 AS cant_r&#xa;		, 0 AS cant_ep&#xa;		, 0 AS cant_ee&#xa;	FROM araucano.academica_ft_cuadros1y2 c&#xa;		INNER JOIN araucano.academica_d_series s&#xa;			ON c.idserie &#x3d; s.idserie &#xa;		INNER JOIN araucano.academica_d_tipostitulos tt&#xa;			ON c.idtipotitulo &#x3d; tt.idtipotitulo&#xa;		INNER JOIN araucano.academica_d_generos g&#xa;			ON c.idgenero &#x3d; g.idgenero&#xa;		LEFT JOIN public.d_genero gt&#xa;			ON g.generodescripcion &#x3d; gt.genero_desc&#xa;	WHERE s.serie&#x3d;&#x27;NIQ&#x27;&#xa;	GROUP BY 1,2,3,4,5,6&#xa;	-----&#xa;	UNION&#xa;	-----&#xa;	SELECT&#xa;		c.idanioinformado AS anio_id&#xa;		, c.unidad_generica_id&#xa;		, 0 AS anio_ingreso_id&#xa;		, COALESCE&#x28;gt.genero_id, 0&#x29; AS genero_id&#xa;		, c.idtitulo AS titulo_id&#xa;		, tt.nivel AS nivel&#xa;		, 0 AS cant_nip&#xa;		, 0 AS cant_nie&#xa;		, sum&#x28;cantidad&#x29; AS cant_ni&#xa;        , 0 AS cant_ni_en_actividad&#xa;		, 0 AS cant_r&#xa;		, 0 AS cant_ep&#xa;		, 0 AS cant_ee&#xa;	FROM araucano.academica_ft_cuadros1y2 c&#xa;		INNER JOIN araucano.academica_d_series s&#xa;			ON c.idserie &#x3d; s.idserie &#xa;		INNER JOIN araucano.academica_d_tipostitulos tt&#xa;			ON c.idtipotitulo &#x3d; tt.idtipotitulo&#xa;		INNER JOIN araucano.academica_d_generos g&#xa;			ON c.idgenero &#x3d; g.idgenero&#xa;		LEFT JOIN public.d_genero gt&#xa;			ON g.generodescripcion &#x3d; gt.genero_desc&#xa;	WHERE s.serie&#x3d;&#x27;NI&#x27;&#xa;	GROUP BY 1,2,3,4,5,6&#xa;	-----&#xa;	UNION&#xa;	-----&#xa;	SELECT&#xa;		c.idanioinformado AS anio_id&#xa;		, c.unidad_generica_id&#xa;		, 0 AS anio_ingreso_id&#xa;		, COALESCE&#x28;gt.genero_id, 0&#x29; AS genero_id&#xa;		, c.idtitulo AS titulo_id&#xa;		, tt.nivel AS nivel&#xa;		, 0 AS cant_nip&#xa;		, 0 AS cant_nie&#xa;		, 0 AS cant_ni&#xa;        , 0 AS cant_ni_en_actividad&#xa;		, sum&#x28;cantidad&#x29; AS cant_r&#xa;		, 0 AS cant_ep&#xa;		, 0 AS cant_ee&#xa;	FROM araucano.academica_ft_cuadros1y2 c&#xa;		INNER JOIN araucano.academica_d_series s&#xa;			ON c.idserie &#x3d; s.idserie &#xa;		INNER JOIN araucano.academica_d_tipostitulos tt&#xa;			ON c.idtipotitulo &#x3d; tt.idtipotitulo&#xa;		INNER JOIN araucano.academica_d_generos g&#xa;			ON c.idgenero &#x3d; g.idgenero&#xa;		LEFT JOIN public.d_genero gt&#xa;			ON g.generodescripcion &#x3d; gt.genero_desc&#xa;	WHERE s.serie&#x3d;&#x27;R&#x27;&#xa;	GROUP BY 1,2,3,4,5,6&#xa;	-----&#xa;	UNION&#xa;	-----&#xa;	SELECT&#xa;		c.idanioinformado AS anio_id&#xa;		, c.unidad_generica_id&#xa;		, 0 AS anio_ingreso_id&#xa;		, COALESCE&#x28;gt.genero_id, 0&#x29; AS genero_id&#xa;		, c.idtitulo AS titulo_id&#xa;		, tt.nivel AS nivel&#xa;		, 0 AS cant_nip&#xa;		, 0 AS cant_nie&#xa;		, 0 AS cant_ni&#xa;        , 0 AS cant_ni_en_actividad&#xa;		, 0 AS cant_r&#xa;		, 0 AS cant_ep&#xa;		, sum&#x28;cantidad&#x29; AS cant_ee&#xa;	FROM araucano.academica_ft_cuadros1y2 c&#xa;		INNER JOIN araucano.academica_d_series s&#xa;			ON c.idserie &#x3d; s.idserie &#xa;		INNER JOIN araucano.academica_d_tipostitulos tt&#xa;			ON c.idtipotitulo &#x3d; tt.idtipotitulo&#xa;		INNER JOIN araucano.academica_d_generos g&#xa;			ON c.idgenero &#x3d; g.idgenero&#xa;		LEFT JOIN public.d_genero gt&#xa;			ON g.generodescripcion &#x3d; gt.genero_desc&#xa;	WHERE s.serie&#x3d;&#x27;E&#x27;&#xa;	GROUP BY 1,2,3,4,5,6&#xa;	-----&#xa;	UNION&#xa;	-----&#xa;	SELECT&#xa;		c.idanioinformado AS anio_id&#xa;		, c.unidad_generica_id&#xa;		, 0 AS anio_ingreso_id&#xa;		, COALESCE&#x28;gt.genero_id, 0&#x29; AS genero_id&#xa;		, c.idtitulo AS titulo_id&#xa;		, tt.nivel AS nivel&#xa;		, 0 AS cant_nip&#xa;		, 0 AS cant_nie&#xa;		, 0 AS cant_ni&#xa;        , 0 AS cant_ni_en_actividad&#xa;		, 0 AS cant_r&#xa;		, sum&#x28;cantidad&#x29; AS cant_ep  -- Se usa esta variables para tomar los matriculados de Posgrado&#xa;		, 0 AS cant_ee&#xa;	FROM araucano.academica_ft_cuadros1y2 c&#xa;		INNER JOIN araucano.academica_d_series s&#xa;			ON c.idserie &#x3d; s.idserie &#xa;		INNER JOIN araucano.academica_d_tipostitulos tt&#xa;			ON c.idtipotitulo &#x3d; tt.idtipotitulo AND tt.nivel &#x3d; &#x27;Posgrado&#x27;&#xa;		INNER JOIN araucano.academica_d_generos g&#xa;			ON c.idgenero &#x3d; g.idgenero&#xa;		LEFT JOIN public.d_genero gt&#xa;			ON g.generodescripcion &#x3d; gt.genero_desc&#xa;	WHERE s.serie&#x3d;&#x27;MA&#x27;&#xa;	GROUP BY 1,2,3,4,5,6&#xa;	-----&#xa;	UNION&#xa;	-----&#xa;	SELECT&#xa;		c.idanioinformado AS anio_id&#xa;		, c.unidad_generica_id&#xa;		, 0 AS anio_ingreso_id&#xa;		, COALESCE&#x28;gt.genero_id, 0&#x29; AS genero_id&#xa;		, c.idtitulo AS titulo_id&#xa;		, tt.nivel AS nivel&#xa;		, 0 AS cant_nip&#xa;		, 0 AS cant_nie&#xa;        , 0 AS cant_ni&#xa;		, sum&#x28;cantidad&#x29; AS cant_ni_en_actividad&#xa;		, 0 AS cant_r&#xa;		, 0 AS cant_ep&#xa;		, 0 AS cant_ee&#xa;	FROM araucano.academica_ft_cuadro18 c&#xa;		INNER JOIN araucano.academica_d_tipostitulos tt&#xa;			ON c.idtipotitulo &#x3d; tt.idtipotitulo&#xa;		INNER JOIN araucano.academica_d_generos g&#xa;			ON c.idgenero &#x3d; g.idgenero&#xa;		LEFT JOIN public.d_genero gt&#xa;			ON g.generodescripcion &#x3d; gt.genero_desc&#xa;	WHERE c.idsubserieopcion IN &#x28;SELECT idsubserieopcion FROM araucano.academica_d_subseriesopcion&#xa;                                                WHERE serie &#x3d; &#x27;NI&#x27; AND subserie &#x3d; &#x27;PM&#x27; &#xa;                                                    AND subserieopcion BETWEEN &#x27;1&#x27; AND &#x27;6&#x27;&#xa;                                &#x29;&#xa;	GROUP BY 1,2,3,4,5,6&#xa;    &#x29; DATOS&#xa;GROUP BY 1,2,3,4,5,6&#x3b;&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
