        <jsScript_script>var pieces &#x3d; cabecera.split&#x28;&#x22;&#x7c;&#x22;&#x29;&#xa;&#xa;for&#x28;i&#x3d;0&#x3b; i&#x3c;pieces.length&#x3b; i&#x2b;&#x2b;&#x29; &#x7b;&#xa;&#xa;    &#x2f;&#x2f; create a new row object, that fits our output size&#xa;    var row &#x3d; createRowCopy&#x28;getOutputRowMeta&#x28;&#x29;.size&#x28;&#x29;&#x29;&#x3b;&#xa;&#xa;    &#x2f;&#x2f; find the index of the first field appended by this step&#xa;    var idx &#x3d; getInputRowMeta&#x28;&#x29;.size&#x28;&#x29;&#x3b;&#xa;&#xa;	q &#x3d; pieces&#x5b;i&#x5d;&#xa;	if&#x28;q&#x5b;0&#x5d;&#x3d;&#x3d;&#x27;&#x22;&#x27;&#x29;&#xa;		b &#x3d; q.substring&#x28;1,q.length-1&#x29;&#xa;	else&#xa;		b &#x3d; q&#xa;&#xa;	row&#x5b;1&#x5d; &#x3d; b&#xa;&#xa;    &#x2f;&#x2f; output the row&#xa;    putRow&#x28;row&#x29;&#x3b;&#xa;&#x7d;&#xa;trans_Status &#x3d; SKIP_TRANSFORMATION&#x3b;</jsScript_script>
