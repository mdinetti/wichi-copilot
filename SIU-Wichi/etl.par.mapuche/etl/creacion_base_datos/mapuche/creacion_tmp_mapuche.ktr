    <sql>--Crea al esquema mapuche_tmp
CREATE SCHEMA mapuche_tmp;

--Tablas temporales mapuche
CREATE TABLE mapuche_tmp.ft_liqconceptosxcargos (
    periodo_info integer,
    liquidacion_nro VARCHAR,
    concepto_id VARCHAR,
    cargo_id VARCHAR,
    legajo_id VARCHAR,
    unidad_presupuestaria_id VARCHAR,
    tipo_ejercicio_id VARCHAR,
    grupo_presupuestario_id VARCHAR,
    imp_presup_fuente_id VARCHAR,
    obj_gasto_id VARCHAR,
    red_programatica_id VARCHAR,
	finalidad_id VARCHAR,
	funcion_id VARCHAR,
    importe_liq numeric(11,2),
    nro_cargo_base VARCHAR,
	porc_imppresup VARCHAR,
	antiguedad_liq smallint,
	dias_trabajados smallint,
	anio_retro VARCHAR,
	mes_retro VARCHAR,
	nro_recibo integer,
	nro_orimp integer,
    cant_cargosxconcepto smallint,
    novedad_1 numeric(11,2),
    novedad_2 numeric(11,2)
);


CREATE TABLE mapuche_tmp.ft_cargos (
    periodo_info integer,
    cargo_id VARCHAR,
    legajo_id VARCHAR,
    dependencia_desig_id VARCHAR,
    nudo VARCHAR,
    dependencia_desemp_id VARCHAR,
    categoria_id VARCHAR,
    agrupamiento_id VARCHAR,
    subrogancia_id VARCHAR,
    categoria_subrogada_id VARCHAR,
    caracter_id VARCHAR,
    asociado_id VARCHAR,
    estado_del_cargo_id VARCHAR,
    cant_hs_dedicacion numeric(11,2),
    antiguedad_en_escalafon smallint,
    porcentaje_trabajado_en_el_mes VARCHAR,
    porcentaje_reduccion_horaria VARCHAR,
    cant_cargos_activos smallint,
    cant_cargos_liq smallint,
    importe_neto numeric(11,2),
    importe_bruto numeric(11,2),
    importe_gasto_total numeric(11,2),
    regional VARCHAR,
    fecha_alta date,
    fecha_baja date,
    nro_cargo_base VARCHAR,
    tipo_escalafon VARCHAR,
    licencia_codigo VARCHAR,
    tarea_codigo VARCHAR,
    porc_aplic VARCHAR,
    nro_cargo_ant VARCHAR,
    clasif_cargo_cod VARCHAR,
    carrera_cod VARCHAR,
    nivel_funcion VARCHAR,
    imp_basico_cat numeric(10,2)
);
CREATE TABLE mapuche_tmp.ft_legajos (
    periodo_info integer,
    legajo_id VARCHAR,
    activo_id VARCHAR,
    sexo_id VARCHAR,
    edad integer,
    estado_civil_id VARCHAR,
    nivel_estudio_id VARCHAR,
    categoria_incentivo_codigo VARCHAR,
    dedicacion_incentivo_codigo VARCHAR,
    discapacidad_id VARCHAR,
    total_carga_horaria_hs smallint,
    cant_legajos_con_cargo_activo smallint,
    cant_legajos_liq smallint,
    apellido VARCHAR,
    nombre VARCHAR,
    cuil VARCHAR,
    titulo VARCHAR,
    nivel_estudio_liq VARCHAR,
    correo_electronico VARCHAR,
	regional_cabecera_id VARCHAR,
	dependencia_cabecera_id VARCHAR,
    depdesemp_cabecera VARCHAR,
	fecha_nacimiento date,
	domicilio_codigo VARCHAR,
	direccion VARCHAR,
    grupo_sanguineo VARCHAR,
    telefono VARCHAR,
    nro_ficha integer,
    tipo_docum VARCHAR,
    nro_docum VARCHAR,
    anioalta integer,
    mesalta integer,
    anioactualizacion integer,
    mesactualizacion integer,
    identidad_genero VARCHAR,
    codc_obsoc VARCHAR,
    fec_ingreso date,
    fecha_recibo date,
    codigosituacion VARCHAR,
    codigocondicion VARCHAR,
    codigoactividad VARCHAR,
    codigozona VARCHAR,
    porcaporteadicss VARCHAR,
    provincialocalidad VARCHAR,
    nro_afili VARCHAR,    
    titulo_liq VARCHAR
);

CREATE TABLE mapuche_tmp.d_antiguedad
(
  legajo character varying,
  antiguedaduno character varying,
  antiguedadud character varying,
  antiguedadusu character varying
);

CREATE TABLE mapuche_tmp.d_estadolaboral
(
  estado_laboral_codigo character varying,
  estado_laboral_desc character varying
);

CREATE TABLE mapuche_tmp.d_objgasto
(
  obj_gasto_codigo VARCHAR
, obj_gasto_desc VARCHAR
);

CREATE TABLE mapuche_tmp.d_agrupamiento (
    agrupamiento_codigo VARCHAR,
    agrupamiento_desc VARCHAR
);

CREATE TABLE mapuche_tmp.d_caracter (
    caracter_codigo VARCHAR,
    caracter_desc VARCHAR,
    tipo_planta_codigo VARCHAR
);
CREATE TABLE mapuche_tmp.d_categoriascargo (
    categoria_codigo VARCHAR,
    categoria_desc VARCHAR,
    escalafon_codigo VARCHAR,
    estado_laboral_codigo VARCHAR,
    dedicacion_codigo VARCHAR
);

CREATE TABLE mapuche_tmp.d_concepto (
    concepto_codigo VARCHAR,
    concepto_desc VARCHAR,
    concepto_tipo_codigo VARCHAR
);
CREATE TABLE mapuche_tmp.d_dedicacion (
    dedicacion_codigo VARCHAR,
    dedicacion_desc VARCHAR
);
CREATE TABLE mapuche_tmp.d_dependenciadesemp (
    dependencia_desemp_codigo VARCHAR,
    dependencia_desemp_desc VARCHAR
);
CREATE TABLE mapuche_tmp.d_dependenciadesig (
    dependencia_desig_codigo VARCHAR,
    dependencia_desig_desc VARCHAR
);

CREATE TABLE mapuche_tmp.d_escalafon (
    escalafon_codigo VARCHAR,
    escalafon_desc VARCHAR
);
CREATE TABLE mapuche_tmp.d_estadocivil (
    estado_civil_codigo VARCHAR,
    estado_civil_desc VARCHAR
);
CREATE TABLE mapuche_tmp.d_unidad_presupuestaria (
    unidad_presupuestaria_codigo VARCHAR,
    unidad_presupuestaria_desc VARCHAR,
    subunidad_presupuestaria_desc VARCHAR,
    subsubunidad_presupuestaria_desc VARCHAR
);
CREATE TABLE mapuche_tmp.d_liquidacion (
    liquidacion_codigo VARCHAR,
    liquidacion_desc VARCHAR,
	es_cerrada VARCHAR,
    sino_cerra VARCHAR
);
CREATE TABLE mapuche_tmp.d_nivelestudio (
    nivel_estudio_codigo VARCHAR,
    nivel_estudio_desc VARCHAR
);
CREATE TABLE mapuche_tmp.d_redprogramatica (
	codn_progr integer,
	codn_subpr integer,
	codn_proye integer,
	codn_activ integer,
	codn_obra integer,
	desc_imput VARCHAR
);
CREATE TABLE mapuche_tmp.d_regional
(
  regional_codigo character varying,
  regional_desc character varying
);
CREATE TABLE mapuche_tmp.d_titulo (
    titulo_codigo VARCHAR,
    titulo_desc VARCHAR
);

CREATE TABLE mapuche_tmp.d_grupo_presupuestario (
    grupo_presupuestario_codigo VARCHAR,
    grupo_presupuestario_desc VARCHAR
);

CREATE TABLE mapuche_tmp.d_finalidad_funcion (
    finalidad_codigo VARCHAR,
    finalidad_desc VARCHAR,
	funcion_codigo VARCHAR,
    funcion_desc VARCHAR
);


CREATE TABLE mapuche_tmp.d_licencia (
    licencia_codigo VARCHAR,
    licencia_desc VARCHAR
);

CREATE TABLE mapuche_tmp.d_domicilio (
    domicilio_codigo VARCHAR,
    pais_desc VARCHAR,
	provincia_desc VARCHAR,
	codigo_postal_desc VARCHAR,
	localidad_desc VARCHAR
);

CREATE TABLE mapuche_tmp.d_tarea (
    tarea_codigo VARCHAR,
    tarea_desc VARCHAR
);

CREATE TABLE mapuche_tmp.d_clasificacion_cargo (
    clasificacion_cargo_codigo VARCHAR,
    clasificacion_cargo_desc VARCHAR
);    
    
CREATE TABLE mapuche_tmp.d_tipo_documento (
    tipo_documento_codigo VARCHAR,
    tipo_documento_desc VARCHAR
); 

CREATE TABLE mapuche_tmp.d_nivel_funcion (
    nivel_funcion_codigo VARCHAR,
    nivel_funcion_desc VARCHAR
); 

CREATE TABLE mapuche_tmp.d_carrera (
    carrera_codigo VARCHAR,
    carrera_desc VARCHAR
); 

CREATE TABLE mapuche_tmp.d_identidad_genero (
    identidad_genero_codigo VARCHAR,
    identidad_genero_desc VARCHAR
); 

CREATE TABLE mapuche_tmp.d_obra_social (
    obra_social_codigo VARCHAR,
    obra_social_desc VARCHAR
);
</sql>
