    <entry>
      <name>Delete tabla FT dw (periodo, subfuente)</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>--Delete de los datos (periodo,subfuente) en la FT de la base siu_wichi.mapuche
DELETE FROM mapuche.ft_personal_${periodo} 
WHERE periodo_id = ${periodo} AND subfuente_id = ${subfuente_id};
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>688</xloc>
      <yloc>464</yloc>
      <attributes_kjc/>
    </entry>
