    <entry>
      <name>crear_indices</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE INDEX IF NOT EXISTS idx_ft_periodo_${periodo} ON mapuche.ft_personal_${periodo} USING btree (periodo_id) WITH (FILLFACTOR=100); 
CREATE INDEX IF NOT EXISTS idx_ft_unidadgenericaid_${periodo} ON mapuche.ft_personal_${periodo} USING btree (unidad_generica_id) WITH (FILLFACTOR=100);
CREATE INDEX IF NOT EXISTS idx_ft_liquidacion_${periodo} ON mapuche.ft_personal_${periodo} USING btree (liquidacion_id) WITH (FILLFACTOR=100);
CREATE INDEX IF NOT EXISTS idx_ft_concepto_${periodo} ON mapuche.ft_personal_${periodo} USING btree (concepto_id) WITH (FILLFACTOR=100);
CREATE INDEX IF NOT EXISTS idx_ft_categoria_escalafon_${periodo} ON mapuche.ft_personal_${periodo} USING btree (categoria_id) WITH (FILLFACTOR=100);
CREATE INDEX IF NOT EXISTS idx_ft_persona_periodo_${periodo} ON mapuche.ft_personal_${periodo} USING btree (persona_id) WITH (FILLFACTOR=100); 
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>272</xloc>
      <yloc>432</yloc>
      <attributes_kjc/>
    </entry>
