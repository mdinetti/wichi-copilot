  <step>
    <name>persona</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_diaguita</connection>
    <sql>SELECT persona as persona_codigo, &#xa;	&#x28;SELECT COALESCE&#x28;td.tipo_de_documento_de_identidad, &#x27;&#x27;&#x29; &#xa;	 FROM diaguita.anx_personas_x_documentos pd&#xa;		, diaguita.anx_tipos_documento_identidad td&#xa;	 WHERE pd.persona &#x3d; p.persona &#xa;		AND pd.tipo_de_documento_de_identidad&#x3d;td.tipo_de_documento_de_identidad&#xa;	 ORDER BY prioridad&#xa;	LIMIT 1&#x29; as persona_tipo_documento, &#xa;	&#x28;SELECT COALESCE&#x28;numero,&#x27;&#x27;&#x29; FROM diaguita.anx_personas_x_documentos pd, diaguita.anx_tipos_documento_identidad td&#xa;	WHERE pd.persona &#x3d; p.persona AND pd.tipo_de_documento_de_identidad&#x3d;td.tipo_de_documento_de_identidad&#xa;	ORDER BY prioridad&#xa;	LIMIT 1&#x29; as persona_nro_documento,&#xa;	fisica_o_juridica,&#xa;	razon_social,&#xa;	nombre_fantasia,&#xa;	sexo,&#xa;	nacionalidad&#x3a;&#x3a;varchar as nacionalidad,&#xa;	email,&#xa;	cbu,&#xa;&#x27;&#x28;&#x27; &#x7c;&#x7c; &#xa;&#x28;SELECT &#xa;COALESCE&#x28;td.tipo_de_documento_de_identidad, &#x27;&#x27;&#x29; &#xa;FROM diaguita.anx_personas_x_documentos pd, diaguita.anx_tipos_documento_identidad td&#xa;		WHERE pd.persona &#x3d; p.persona &#xa;AND pd.tipo_de_documento_de_identidad&#x3d;td.tipo_de_documento_de_identidad&#xa;		ORDER BY prioridad&#xa;		LIMIT 1&#x29; &#x7c;&#x7c; &#xa;&#x27; - &#x27; &#x7c;&#x7c; &#xa;&#x28;SELECT &#xa;COALESCE&#x28;numero,&#x27;&#x27;&#x29; &#xa;FROM diaguita.anx_personas_x_documentos pd, diaguita.anx_tipos_documento_identidad td&#xa;		WHERE pd.persona &#x3d; p.persona &#xa;AND pd.tipo_de_documento_de_identidad&#x3d;td.tipo_de_documento_de_identidad&#xa;		ORDER BY prioridad&#xa;		LIMIT 1&#x29;  &#x7c;&#x7c;&#xa; &#x27;&#x29; &#x27; &#x7c;&#x7c; &#xa;COALESCE&#x28;razon_social,&#x27;&#x27;&#x29; &#x7c;&#x7c;&#xa;	CASE WHEN position&#x28;nombre_fantasia in razon_social&#x29;&#x3e;0&#xa;		THEN &#x27;&#x27;&#xa;		ELSE &#x27; &#x3a; &#x27; &#x7c;&#x7c; COALESCE&#x28;nombre_fantasia,&#x27;&#x27;&#x29;&#xa;	END &#xa;	AS persona_detalle,&#xa;	estado&#xa;	FROM diaguita.anx_personas p&#x3b;</sql>
    <limit>0</limit>
    <lookup/>
