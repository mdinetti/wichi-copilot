    <entry>
      <name>Actualizar conc y exp pagado</name>
      <description/>
      <type>SQL</type>
      <sql>CREATE TEMP TABLE mov_et_2 AS SELECT distinct m.expediente_id,m.concepto_id,m.documento_principal_id FROM pilaga.ft_movimientos m&#xa;					WHERE m.etapa_presupuestaria_id&#x3d;2 AND anio_id &#x3d; &#x24;&#x7b;periodo&#x7d; ORDER BY 3&#x3b;&#xa;&#xa;UPDATE pilaga.ft_movimientos ft SET expediente_id &#x3d; m.expediente_id, concepto_id &#x3d;  m.concepto_id FROM mov_et_2 m&#xa;WHERE ft.anio_id &#x3d; &#x24;&#x7b;periodo&#x7d; AND ft.pagado &#x3e; 0 AND m.documento_principal_id&#x3d;ft.documento_principal_id&#x3b;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dsa</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>624</xloc>
      <yloc>352</yloc>
      </entry>
