    <sql>--Crea el esquema kolla en dw&#xa;CREATE SCHEMA kolla&#x3b;&#xa;&#xa;CREATE TABLE kolla.d_concepto&#xa;&#x28;&#xa;  concepto_id serial NOT NULL,&#xa;  instalacion_id integer NOT NULL,&#xa;  concepto_codigo integer NOT NULL,&#xa;  concepto_codigo_externo character varying NOT NULL,&#xa;  concepto_desc character varying NOT NULL,&#xa;  unidad_gestion_codigo character varying NOT NULL,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  version integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone,&#xa;  CONSTRAINT pk_d_concepto PRIMARY KEY &#x28;concepto_id&#x29;&#xa;&#x29;&#x3b;&#xa;INSERT INTO kolla.d_concepto &#x28;concepto_id, instalacion_id, concepto_codigo, concepto_codigo_externo, concepto_desc, unidad_gestion_codigo&#x29; &#xa;     VALUES &#x28;-1, -1, -1, &#x27;VI&#x27;, &#x27;VALOR INVALIDO&#x27;, &#x27;VI&#x27;&#x29;&#x3b;&#xa;INSERT INTO kolla.d_concepto &#x28;concepto_id, instalacion_id, concepto_codigo, concepto_codigo_externo, concepto_desc, unidad_gestion_codigo&#x29; &#xa;     VALUES &#x28;0, -1, -1, &#x27;V&#x2f;N&#x27;, &#x27;VACIO &#x2f; NULO&#x27;, &#x27;V&#x2f;N&#x27;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE kolla.d_elemento&#xa;&#x28;&#xa;  elemento_id serial NOT NULL,&#xa;  instalacion_id integer NOT NULL,&#xa;  elemento_codigo integer NOT NULL,&#xa;  elemento_codigo_externo character varying NOT NULL,&#xa;  elemento_desc character varying NOT NULL,&#xa;  unidad_gestion_codigo character varying NOT NULL,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  version integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone,&#xa;  CONSTRAINT pk_d_elemento PRIMARY KEY &#x28;elemento_id&#x29;&#xa;&#x29;&#x3b;&#xa;INSERT INTO kolla.d_elemento &#x28;elemento_id, instalacion_id, elemento_codigo, elemento_codigo_externo, elemento_desc, unidad_gestion_codigo&#x29; &#xa;     VALUES &#x28;-1, -1, -1, &#x27;VI&#x27;, &#x27;VALOR INVALIDO&#x27;, &#x27;VI&#x27;&#x29;&#x3b;&#xa;INSERT INTO kolla.d_elemento &#x28;elemento_id, instalacion_id, elemento_codigo, elemento_codigo_externo, elemento_desc, unidad_gestion_codigo&#x29; &#xa;     VALUES &#x28;0, -1, -1, &#x27;V&#x2f;N&#x27;, &#x27;VACIO &#x2f; NULO&#x27;, &#x27;V&#x2f;N&#x27;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE kolla.d_encuesta&#xa;&#x28;&#xa;  encuesta_id serial NOT NULL,&#xa;  instalacion_id integer NOT NULL,&#xa;  encuesta_codigo integer NOT NULL,&#xa;  encuesta_desc character varying NOT NULL,&#xa;  habilitacion character varying NOT NULL,&#xa;  encuesta_periodo character varying NOT NULL,&#xa;  unidad_gestion_desc character varying NOT NULL,&#xa;  anonima character varying,&#xa;  usuario character varying,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  version integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone,&#xa;  CONSTRAINT pk_d_encuesta PRIMARY KEY &#x28;encuesta_id&#x29;&#xa;&#x29;&#x3b;&#xa;INSERT INTO kolla.d_encuesta &#x28;encuesta_id, instalacion_id, encuesta_codigo, encuesta_desc, habilitacion, encuesta_periodo, unidad_gestion_desc&#x29; &#xa;     VALUES &#x28;-1, -1, -1, &#x27;VALOR INVALIDO&#x27;, &#x27;0&#x27;, &#x27;VALOR INVALIDO&#x27;, &#x27;VALOR INVALIDO&#x27;&#x29;&#x3b;&#xa;INSERT INTO kolla.d_encuesta &#x28;encuesta_id, instalacion_id, encuesta_codigo, encuesta_desc, habilitacion, encuesta_periodo, unidad_gestion_desc&#x29; &#xa;     VALUES &#x28;0, -1, -1, &#x27;VACIO &#x2f; NULO&#x27;, &#x27;0&#x27;, &#x27;VACIO &#x2f; NULO&#x27;, &#x27;VACIO &#x2f; NULO&#x27;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE kolla.d_pregunta_respuesta&#xa;&#x28;&#xa;  pregunta_respuesta_id serial NOT NULL,&#xa;  instalacion_id integer NOT NULL,&#xa;  pregunta_codigo integer NOT NULL,&#xa;  pregunta_desc character varying NOT NULL,&#xa;  respuesta_codigo integer,&#xa;  respuesta_desc character varying,&#xa;  respuesta_codigo_combinado character varying,&#xa;  fecha_desde date,&#xa;  fecha_hasta date,&#xa;  version integer,&#xa;  vigente character varying,&#xa;  fecha_actualizacion timestamp without time zone,&#xa;  CONSTRAINT pk_d_pregunta_respuesta PRIMARY KEY &#x28;pregunta_respuesta_id&#x29;&#xa;&#x29;&#x3b;&#xa;INSERT INTO kolla.d_pregunta_respuesta &#x28;pregunta_respuesta_id, instalacion_id, pregunta_codigo, pregunta_desc, respuesta_codigo, respuesta_desc, respuesta_codigo_combinado&#x29;&#xa;VALUES &#x28;-1, -1, -1, &#x27;PREGUNTA INVALIDA&#x27;, -1, &#x27;RESPUESTA INVALIDA&#x27;, &#x27;RINV&#x27;&#x29;&#x3b;&#xa;INSERT INTO kolla.d_pregunta_respuesta &#x28;pregunta_respuesta_id, instalacion_id, pregunta_codigo, pregunta_desc, respuesta_codigo, respuesta_desc, respuesta_codigo_combinado&#x29;&#xa;VALUES &#x28;0, -1, -1, &#x27;VACIO &#x2f; NULO&#x27;, -1, &#x27;VACIO &#x2f; NULO&#x27;, &#x27;RV&#x2f;N&#x27;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE kolla.ft_entrevista&#xa;&#x28;&#xa;  entrevista_id serial NOT NULL,&#xa;  encuesta_id integer NOT NULL,&#xa;  encuestado_id integer NOT NULL,&#xa;  codigo_externo character varying,&#xa;  instalacion_id integer NOT NULL,&#xa;  unidad_generica_id integer NOT NULL,&#xa;  fecha_id date NOT NULL,&#xa;  pregunta_1 integer,&#xa;  pregunta_2 integer,&#xa;  pregunta_3 integer,&#xa;  pregunta_4 integer,&#xa;  pregunta_5 integer,&#xa;  pregunta_6 integer,&#xa;  pregunta_7 integer,&#xa;  pregunta_8 integer,&#xa;  pregunta_9 integer,&#xa;  pregunta_10 integer,&#xa;  pregunta_11 integer,&#xa;  pregunta_12 integer,&#xa;  pregunta_13 integer,&#xa;  pregunta_14 integer,&#xa;  pregunta_15 integer,&#xa;  pregunta_16 integer,&#xa;  pregunta_17 integer,&#xa;  pregunta_18 integer,&#xa;  pregunta_19 integer,&#xa;  pregunta_20 integer,&#xa;  pregunta_21 integer,&#xa;  pregunta_22 integer,&#xa;  pregunta_23 integer,&#xa;  pregunta_24 integer,&#xa;  pregunta_25 integer,&#xa;  pregunta_26 integer,&#xa;  pregunta_27 integer,&#xa;  pregunta_28 integer,&#xa;  pregunta_29 integer,&#xa;  pregunta_30 integer,&#xa;  pregunta_31 integer,&#xa;  pregunta_32 integer,&#xa;  pregunta_33 integer