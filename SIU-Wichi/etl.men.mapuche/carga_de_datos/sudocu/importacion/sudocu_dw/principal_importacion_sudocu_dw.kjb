      <sql>DROP TABLE IF EXISTS sudocu.indicadores;
CREATE TABLE sudocu.indicadores
(
	id_indicador integer,
	descripcion_indicador varchar(300),
	alcance varchar(16),
	valor_indicador_calculado varchar(60),
	tipo_campo character varying(10),
	fecha_relevamiento_indicador date
);

INSERT INTO sudocu.indicadores(
	id_indicador, descripcion_indicador, alcance, valor_indicador_calculado, tipo_campo, fecha_relevamiento_indicador)
SELECT * FROM sudocu_dsa.indicadores_calculados
WHERE alcance = 'General'
	UNION
SELECT * FROM sudocu_dsa.indicadores_calculados
WHERE alcance &lt;&gt; 'General' --AND alcance::integer between 2020 and extract(year from current_date)
order by id_indicador, alcance;</sql>
