  <order>
  <hop> <from>Rando antiguedad</from><to>Dimension lookup&#x2f;update</to><enabled>Y</enabled> </hop>
  <hop> <from>map_dsa_ft_cargos</from><to>Rando antiguedad</to><enabled>Y</enabled> </hop>
  </order>
  <step>
    <name>Dimension lookup&#x2f;update</name>
    <type>DimensionLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
      <schema>mapuche_dsa</schema>
      <table>d_antiguedad</table>
      <connection>siu_dsa</connection>
      <commit>100</commit>
      <update>Y</update>
      <fields>
        <key>
          <name>antiguedad</name>
          <lookup>anios</lookup>
        </key>
        <date>
          <name>fecha_actualizacion</name>
          <from>fecha_desde</from>
          <to>fecha_hasta</to>
        </date>
        <field>
          <name>rangoantiguedad_desc</name>
          <lookup>rangoantiguedad_desc</lookup>
          <update>Insert</update>
        </field>
        <field>
          <name/>
          <lookup>vigente</lookup>
          <update>LastVersion</update>
        </field>
        <field>
          <name/>
          <lookup>fecha_actualizacion</lookup>
          <update>DateInsertedOrUpdated</update>
        </field>
        <return>
          <name>antiguedad_id</name>
          <rename/>
          <creation_method>tablemax</creation_method>
          <use_autoinc>N</use_autoinc>
          <version>version</version>
        </return>
      </fields>
      <sequence/>
      <min_year>1900</min_year>
      <max_year>2199</max_year>
      <cache_size>5000</cache_size>
      <preload_cache>N</preload_cache>
      <use_start_date_alternative>N</use_start_date_alternative>
      <start_date_alternative>none</start_date_alternative>
      <start_date_field_name/>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>592</xloc>
      <yloc>112</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>Rando antiguedad</name>
    <type>NumberRange</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <inputField>antiguedad</inputField>
    <outputField>rangoantiguedad_desc</outputField>
    <fallBackValue>Valor inv&#xe1;lido</fallBackValue>
    <rules>
      <rule>
        <lower_bound>0.0</lower_bound>
        <upper_bound>1.0</upper_bound>
        <value>Menos de 1</value>
      </rule>
      <rule>
        <lower_bound>1.0</lower_bound>
        <upper_bound>6.0</upper_bound>
        <value>De 1 a 5</value>
      </rule>
      <rule>
        <lower_bound>6.0</lower_bound>
        <upper_bound>11.0</upper_bound>
        <value>De 6 a 10</value>
      </rule>
      <rule>
        <lower_bound>11.0</lower_bound>
        <upper_bound>16.0</upper_bound>
        <value>De 11 a 15</value>
      </rule>
      <rule>
        <lower_bound>16.0</lower_bound>
        <upper_bound>21.0</upper_bound>
        <value>De 16 a 20</value>
      </rule>
      <rule>
        <lower_bound>21.0</lower_bound>
        <upper_bound>26.0</upper_bound>
        <value>De 21 a 25</value>
      </rule>
      <rule>
        <lower_bound>26.0</lower_bound>
        <upper_bound>1.7976931348623157E308</upper_bound>
        <value>M&#xe1;s de 25</value>
      </rule>
    </rules>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>304</xloc>
      <yloc>112</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>map_dsa_ft_cargos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT &#xa;  DISTINCT ft_liqconceptosxcargos.antiguedad_liq as antiguedad&#xa;FROM &#xa;  mapuche_tmp.ft_liqconceptosxcargos&#xa;  WHERE ft_liqconceptosxcargos.antiguedad_liq is not null &#xa;UNION&#xa;SELECT &#xa;  DISTINCT ft_cargos.antiguedad_en_escalafon as antiguedad&#xa;FROM &#xa;  mapuche_tmp.ft_cargos&#xa;    WHERE ft_cargos.antiguedad_en_escalafon is not null &#xa;ORDER BY 1 ASC&#x3b;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>80</xloc>
      <yloc>112</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step_error_handling>
  </step_error_handling>
   <slave-step-copy-partition-distribution>
</slave-step-copy-partition-distribution>
   <slave_transformation>N</slave_transformation>

</transformation>
