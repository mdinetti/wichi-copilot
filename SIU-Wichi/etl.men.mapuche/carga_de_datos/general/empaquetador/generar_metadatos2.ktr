union select 'validaciones_empaquetador' as clave, '${validaciones_validacionesId}' as valor
union select 'sistema_fuente' as clave, q.sistema as valor from (${validaciones_sqlSistFuente}) q
union select 'version_sistema_fuente' as clave, '3.5' as valor
union select 'comentarios' as clave, '${comentarios}' as valor
union select 'instalacion' as clave, '${instalacion}' as valor</sql>
