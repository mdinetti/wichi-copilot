  <step>
    <name>gua_dsa_ft_equivalencia</name>
    <type>TableInput</type>
    <description>Lee los datos de siu_dsa.guarani_tmp</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT&#xa;  ltu.unidadacademica_id&#xa;, ltaa.anio_id as anioacademico&#xa;, lttp.tipoperiodo_id&#xa;--, lttp.tipoperiodo_id_gua as periodo_desc&#xa;, to_date&#x28;fechaequivalencia,&#x27;dd&#x2f;mm&#x2f;yyyy&#x27;&#x29; as fechaequivalencia&#xa;, ltlj.legajo_id&#xa;, ltc.carrera_id&#xa;, ltpl.plan_id as plancarrera_id&#xa;, versionplan_id&#xa;, ltm.materia_id&#xa;, ltae.alcanceequivalencia_id&#xa;, ltr.resultado_id&#xa;, ltno.nota_id as nota&#xa;, ltoe.origenequivalencia_id&#xa;, equivalenciaguarani_id&#xa;, ltmc.materiacomun_id as tipomateria_id&#xa;, ltea.estadoacta_id&#xa;, ltce.condicion_id as condicionalumno_id&#xa;, cast&#x28;cantidadregistrosexamen as integer&#x29; as cantidadregistrosexamen&#xa;, ltiu.anio_id as anioingresoua&#xa;, cast&#x28;cohorte as integer&#x29; as cohorte&#xa;, ltpi.periodoinsccarrera_id as periodoinsccarrera_id&#xa;, ltpi.periodoinsccarrera_desc as periodoinscripcioncarrera_desc&#xa;FROM guarani_tmp.gua_dsa_ft_equivalencia ft&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_unidadesacademicas ltu on &#x28;ft.unidadacademica_id&#x3d;ltu.unidadacademica_id_gua and ltu.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_tiposperiodo lttp on &#x28;ft.tipoperiodo_id &#x3d; lttp.tipoperiodo_id_gua and lttp.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_carreras ltc on &#x28;&#x28;ft.unidadacademica_id&#x7c;&#x7c;ft.carrera_id&#x29;&#x3d;ltc.carrera_id_gua and ltc.unidadacademica_id &#x3d; ltu.unidadacademica_id and ltc.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_planes ltpl on &#x28;ft.plancarrera_id&#x3d;ltpl.plan_id_gua and &#x28;ft.unidadacademica_id&#x7c;&#x7c;ft.carrera_id&#x29; &#x3d; ltpl.carrera_id_gua and ft.unidadacademica_id&#x3d;ltpl.unidadacademica_id_gua and ltpl.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_materias ltm on &#x28;ft.materia_id&#x3d;ltm.materia_id_gua and ft.unidadacademica_id &#x3d; ltm.unidadacademica_id_gua and ltm.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_resultados ltr on &#x28;ft.resultado_id&#x3d;ltr.resultado_id_gua and ltr.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_origenequivalencia ltoe on &#x28;ft.origenequivalencia_id &#x3d; ltoe.origenequivalencia_id_gua and ltoe.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_materiacomun ltmc on &#x28;ft.tipomateria_id &#x3d; ltmc.materiacomun_id_gua and ltmc.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_estadosacta ltea on &#x28;ft.estadoacta_id &#x3d; ltea.estadoacta_id_gua and ltea.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_condicion ltce on &#x28;ft.condicionalumno_id &#x3d; ltce.condicion_id_gua and ltce.tipocondicion_desc &#x3d; &#x27;E&#x27; and ltce.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_notas ltno on &#x28;coalesce&#x28;ft.nota,&#x27;VACIO&#x2f;NULO&#x27;&#x29; &#x3d; ltno.nota_id_gua and ltr.resultado_id &#x3d; ltno.resultado_id and ltno.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_legajos ltlj on &#x28;ft.legajo &#x3d; ltlj.legajo_id_gua and ltlj.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join public.d_anio ltaa on &#x28;cast&#x28;ft.anioacademico as integer&#x29; &#x3d; ltaa.anio_id&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_alcanceequivalencia ltae on &#x28;ft.alcanceequivalencia_id &#x3d; ltae.alcanceequivalencia_id_gua and ltae.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;left outer join public.d_anio ltiu on &#x28;cast &#x28;ft.anioingresoua as integer&#x29;&#x3d; ltiu.anio_id&#x29;&#xa;left outer join guarani_dsa.gua_dsa_ids_lt_periodosinsccarrera ltpi on &#x28;ft.periodoinscripcioncarrera_desc &#x3d; ltpi.periodoinsccarrera_id_gua and ft.cohorte &#x3d; ltpi.anioingresocarrera_id_gua and ltpi.vigente&#x3d;&#x27;Y&#x27;&#x29;&#xa;&#xa;&#xa;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
