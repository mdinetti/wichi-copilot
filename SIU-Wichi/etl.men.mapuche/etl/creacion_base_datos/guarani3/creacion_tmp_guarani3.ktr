taformas&#xa;&#x28;&#xa;  plataforma integer,&#xa;  nombre character varying&#x28;100&#x29;,&#xa;  url character varying&#x28;200&#x29;,&#xa;  host character varying&#x28;200&#x29;,&#xa;  token character varying,&#xa;  rol_alumno integer,&#xa;  rol_alumno_curso integer,&#xa;  categoria_curso_default integer,&#xa;  activa boolean&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE int_pv_plataformas_ra&#xa;&#x28;&#xa;  plataforma integer,&#xa;  responsable_academica integer&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE int_pv_roles_docentes&#xa;&#x28;&#xa;  plataforma integer,&#xa;  responsabilidad integer,&#xa;  rol_externo integer&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE int_pv_usuarios&#xa;&#x28;&#xa;  plataforma integer,&#xa;  persona integer,&#xa;  id_usuario_externo character varying&#x28;50&#x29;&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE comisiones_completas&#x28;&#xa;	comision integer,&#xa;	materia character varying,&#xa;	propuesta integer,&#xa;	plan integer,&#xa;	responsable_academica integer&#xa;&#x29;&#x3b;&#xa;CREATE TABLE inscripciones_personas_comisiones&#x28;&#xa;	comision integer,&#xa;	alumno integer,&#xa;	actividad integer,&#xa;	curso integer,&#xa;	legajo character varying,&#xa;	persona integer,&#xa;	propuesta integer,&#xa;	plan_version integer,&#xa;	ubicacion integer,&#xa;	plataforma integer,&#xa;	id_usuario_externo integer&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE inscripciones_comision&#x28;&#xa;	comision integer,&#xa;	curso integer,&#xa;	cantidad_inscripciones integer,&#xa;	cantidad_bajas integer,&#xa;	total integer&#xa;&#x29;&#x3b;&#xa;&#xa;--Tablas para integracion Kolla&#xa;CREATE TABLE encuestas&#x28;&#xa;  respuesta integer, &#xa;  persona integer, &#xa;  formulario integer, &#xa;  fecha_alta timestamp with time zone, &#xa;  fecha_respuesta timestamp with time zone, &#xa;  hash character varying&#x28;40&#x29; NOT NULL&#xa;&#x29;&#x3b;&#xa;&#xa;CREATE TABLE encuestas_propuestas&#x28;&#xa;    kolla_id_encuesta numeric,&#xa;    encuesta integer,&#xa;    kolla_unidad_gesti