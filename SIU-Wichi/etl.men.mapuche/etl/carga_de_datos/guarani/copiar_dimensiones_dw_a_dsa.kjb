    <entry>
      <name>SQL</name>
      <description/>
      <type>SQL</type>
      <sql>delete from guarani_dsa.gua_dsa_ids_lt_catedras&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_catedras&#x28;catedra_id, catedra_id_gua, catedra_desc, materia_id, materia_id_gua, unidadacademica_id_gua, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select catedra_id, catedra_id_gua, catedra_desc, materia_id, materia_id_gua, unidadacademica_id_gua, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_catedras&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_notas&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_notas&#x28;nota_id, nota_id_gua, nota_desc, resultado_id, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select nota_id, nota_id_gua, nota_desc, resultado_id, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_notas&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_origenequivalencia&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_origenequivalencia&#x28;origenequivalencia_id, origenequivalencia_id_gua, origenequivalencia_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select origenequivalencia_id, origenequivalencia_id_gua, origenequivalencia_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_origenequivalencia&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_resultados&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_resultados&#x28;resultado_id, resultado_id_gua, resultado_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select resultado_id, resultado_id_gua, resultado_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_resultados&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_planes&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_planes&#x28;plan_id, carrera_id_gua, plan_id_gua, plan_desc, planversion_id, unidadacademica_id_gua, carrera_id, carrera_desc, unidadacademica_id, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select pl.plan_id, pl.carrera_id_gua, pl.plan_id_gua, pl.plan_desc, pl.planversion_id, ua.unidadacademica_id_gua, pl.carrera_id, pl.carrera_desc, &#xa;pl.unidadacademica_id, pl.fechadesde, pl.fechahasta, pl.version, pl.vigente, pl.fechaact &#xa;from guarani.gua_dw_lt_planes pl join guarani.gua_dw_lt_unidadesacademicas ua on pl.unidadacademica_id &#x3d; ua.unidadacademica_id&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_alcanceequivalencia&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_alcanceequivalencia&#x28;alcanceequivalencia_id, alcanceequivalencia_id_gua, alcanceequivalencia_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select alcanceequivalencia_id, alcanceequivalencia_id_gua, alcanceequivalencia_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_alcanceequivalencia&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_materiacomun&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_materiacomun&#x28;materiacomun_id, materiacomun_id_gua, materiacomun_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select materiacomun_id, materiacomun_id_gua, materiacomun_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_materiacomun&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_condicion&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_condicion&#x28;condicion_id, condicion_id_gua, condicion_desc, tipocondicion_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select condicion_id, condicion_id_gua, condicion_desc, tipocondicion_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_condicion&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_materias&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_materias&#x28;materia_id, materia_id_gua, materia_desc, unidadacademica_id_gua, unidadacademica_id, descripcion_completa, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select materia_id, materia_id_gua, materia_desc, unidadacademica_id_gua, unidadacademica_id, descripcion_completa, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_materias&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_estadosacta&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_estadosacta&#x28;estadoacta_id, estadoacta_id_gua, estadoacta_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select estadoacta_id, estadoacta_id_gua, estadoacta_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_estadosacta&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_comision&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_comision&#x28;comision_id, comision_desc, comision_id_gua, unidadacademica_id_gua, catedra_id, materia_id, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select comision_id, comision_desc, comision_id_gua, unidadacademica_id_gua, catedra_id, materia_id, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_comision&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_legajos&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_legajos&#x28;legajo_id, legajo_id_gua, legajo_desc, agrupamiento_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select legajo_id, legajo_id_gua, legajo_desc, agrupamiento_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_legajos&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_sedes&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_sedes&#x28;sede_id, sede_id_gua, sede_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select sede_id, sede_id_gua, sede_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_sedes&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_tiposperiodo&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_tiposperiodo&#x28;tipoperiodo_id, tipoperiodo_id_gua, tipoperiodo_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select tipoperiodo_id, tipoperiodo_id_gua, tipoperiodo_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_tiposperiodo&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_periodosinsccarrera&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_periodosinsccarrera&#x28;periodoinsccarrera_id, anioingresocarrera_id_gua, periodoinsccarrera_id_gua, periodoinsccarrera_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select periodoinsccarrera_id, anioingresocarrera_id_gua, periodoinsccarrera_id_gua, periodoinsccarrera_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_periodosinsccarrera&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_periodosanioacad&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_periodosanioacad&#x28;periodo_id, periodo_desc, periodoordenanio, tipoperiodo_id, anioacademico, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select periodo_id, periodo_desc, periodoordenanio, tipoperiodo_id, anioacademico, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_periodosanioacad&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_totalintentos&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_totalintentos&#x28;totalintento_id, totalintento_id_gua, totalintento_desc, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select totalintento_id, totalintento_id_gua, totalintento_desc, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_totalintentos&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_intentos&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_intentos&#x28;intento_id, nrointento_id, totalintento_id, primeravez, fechadesde, fechahasta, version, vigente, fechaact&#x29;&#xa;select intento_id, nrointento_id, totalintento_id, primeravez, fechadesde, fechahasta, version, vigente, fechaact from guarani.gua_dw_lt_intentos&#x3b;&#xa;&#xa;delete from guarani_dsa.gua_dsa_ids_lt_situacionesaspirantes&#x3b;&#xa;insert into guarani_dsa.gua_dsa_ids_lt_situaciones