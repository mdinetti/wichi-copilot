  <step>
    <name>ft_compras_1</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>siu_diaguita</connection>
    <sql>SELECT &#x2a;, &#x27;1&#x27; as etapa FROM&#xa;&#x28;SELECT &#xa;  &#x27;SBS&#x3a;&#x27; &#x7c;&#x7c; s.numero &#x7c;&#x7c; &#x27;&#x2f;&#x27; &#x7c;&#x7c; s.ejercicio AS identificador_solicitud, &#xa;  s.fecha_creacion AS fecha_creacion_solicitud,&#xa;  s.descripcion AS descripcion_solicitud, &#xa;  &#x28;SELECT nombre FROM diaguita.scp_prioridades p WHERE p.id_prioridad&#x3d;s.id_prioridad&#x29; AS prioridad_solicitud,&#xa;  &#x28;SELECT nombre FROM diaguita.scp_estados e WHERE e.estado&#x3d;s.estado&#x29; AS estado_solicitud,&#xa;  s.referente_nombre AS referente_solicitud,&#xa;  s.id_lugar_entrega AS id_lugar_entrega_solicitud,&#xa;  s.id_oficina AS id_oficina_central_contratacion_solicitud,&#xa;  s.id_area AS id_area_solicitud,&#xa;  scp_items_solicitados.descripcion AS descripcion_item_solicitado,&#xa;  scp_items_solicitados.rubro as id_rubro_solicitud,&#xa;  scp_items_areas.cantidad AS cantidad_item_solicitado, &#xa;  &#x28;SELECT nombre FROM diaguita.scp_unidades_medida u WHERE u.id_unidad_medida&#x3d;scp_items_solicitados.id_unidad_medida&#x29; AS unidad_medida_item_solicitado,  &#xa;  scp_items_solicitados.precio_estimado AS precio_estimado_item_solicitado,&#xa;  scp_items_areas.id_item_area AS id_area_item_solicitado,   -- id_area_destino&#xa;  coalesce&#x28;mcc.numero&#x3a;&#x3a;text, &#x27;Sin N&#xfa;mero&#x27;&#x29; as numero_mcc,&#xa;  coalesce&#x28;mcc.id_modelo_compra_centralizada &#x7c;&#x7c; &#x27; - &#x27; &#x7c;&#x7c; mcc.descripcion, &#x27;Sin Modelo de Compras Centralizado&#x27;&#x29; as descripcion_mcc&#xa;FROM &#xa;  diaguita.scp_solicitudes s&#xa;  LEFT JOIN diaguita.scp_modelos_compras_centralizadas mcc ON s.id_modelo_compra_centralizada &#x3d; mcc.id_modelo_compra_centralizada&#xa;  ,diaguita.scp_items_solicitados&#xa;  ,diaguita.scp_items_areas &#xa;WHERE &#xa;  scp_items_solicitados.id_solicitud &#x3d; s.id_solicitud&#xa;  AND scp_items_areas.id_item &#x3d; scp_items_solicitados.id_item&#xa;&#x29; solicitud&#xa;&#xa;FULL OUTER JOIN&#xa;&#x28;SELECT &#xa;  &#x28;SELECT sigla &#x7c;&#x7c; &#x27;&#x3a;&#x27; &#x7c;&#x7c; c.numero &#x7c;&#x7c; &#x27;&#x2f;&#x27; &#x7c;&#x7c; c.ejercicio FROM diaguita.scp_procedimiento_tipos p &#xa;   WHERE p.id_procedimiento_tipo&#x3d;c.id_procedimiento_tipo&#x29; AS&#xa;  identificador_convocatoria,&#xa;  c.fecha_creacion AS fecha_creacion_convocatoria,&#xa;  c.asunto_convocatoria AS descripcion_convocatoria,&#xa;  &#x28;SELECT nombre AS estado_convocatoria FROM diaguita.scp_estados e WHERE e.estado&#x3d;c.estado&#x29; AS estado_convocatoria,&#xa;  &#x28;SELECT nombre FROM diaguita.scp_prioridades p WHERE p.id_prioridad&#x3d;c.id_prioridad&#x29; AS prioridad_convocatoria,&#xa;  c.id_convocatoria AS id_convocatoria,&#xa;  c.expediente_ejercicio,&#xa;  c.expediente_numero AS expediente_convocatoria, &#xa;  &#x28;SELECT nombre FROM diaguita.scp_procedimiento_tipos p WHERE p.id_procedimiento_tipo&#x3d;c.id_procedimiento_tipo&#x29; AS tipo_procedimiento_convocatoria,&#xa;  c.id_oficina AS id_oficina_convocatoria, &#xa;  c.id_procedimiento_modalidad AS id_procedimiento_modalidad,&#xa;  c.id_procedimiento_clase AS id_procedimiento_clase,&#xa;  au.id_usuario_autorizante as usuario_autorizante_conv,&#xa;  date&#x28;au.fecha_cambio&#x29; as fecha_autorizacion_conv, &#xa;  -- scp_renglones&#xa;  scp_renglones.id_renglon AS id_renglon, 			-- CLAVE PARA adjudicaciones&#xa;  scp_renglones.descripcion AS descripcion_renglon, &#xa;  scp_renglones.numero_renglon AS numero_renglon, &#xa;  scp_renglones.precio_estimado AS precio_estimado_renglon, &#xa;  scp_renglones.id_catalogo_bien_servicio AS catalogo_bien_servicio_renglon, &#xa;  scp_renglones.rubro as id_rubro_convocatoria,&#xa;  scp_renglones_areas.id_renglon_area AS id_renglon_area,	-- CLAVE PARA ordenes de compra y recepciones.&#xa;  scp_renglones_areas.cantidad AS cantidad_renglon,&#xa;  scp_renglones_areas.id_item_area&#xa;FROM &#xa;  diaguita.scp_convocatorias c, &#xa;  diaguita.scp_renglones, &#xa;  diaguita.scp_renglones_areas,&#xa;  diaguita.scp_autorizaciones au&#xa;WHERE &#xa;  c.id_convocatoria &#x3d; scp_renglones.id_convocatoria AND&#xa;  scp_renglones.id_renglon &#x3d; scp_renglones_areas.id_renglon&#xa; AND au.estado &#x3d; &#x27;AU&#x27; AND au.id_tabla&#x3d; 2 -- convocatorias&#xa; AND c.id_convocatoria &#x3d; au.id_registro&#x29; convocatoria&#xa;ON solicitud.id_area_item_solicitado &#x3d; convocatoria.id_item_area&#xa;&#xa;FULL OUTER JOIN&#xa;&#x28;SELECT a.id_convocatoria AS id_convocatoria_aa,&#xa;	a.id_acto_apertura AS id_acto_apertura,&#xa;	a.fecha_hora_inicio AS inicio_acto_apertura,&#xa;	a.hora_fin AS fin_acto_apertura,&#xa;	a.oficina AS oficina_acto_apertura,&#xa;	a.lugar AS lugar_acto_apertura,&#xa;	&#x27;AAP&#x3a;&#x27; &#x7c;&#x7c; a.numero &#x7c;&#x7c; &#x27;&#x2f;&#x27; &#x7c;&#x7c; a.ejercicio AS identificador_acto_apertura, &#xa;	&#x28;SELECT nombre AS estado_acto_apertura FROM diaguita.scp_estados e WHERE e.estado&#x3d;a.estado&#x29; AS estado_acto_apertura&#xa;FROM diaguita.scp_actos_apertura a&#xa;&#x29; acto_apertura&#xa;ON convocatoria.id_convocatoria&#x3d;acto_apertura.id_convocatoria_aa&#xa;&#xa;FULL OUTER JOIN&#xa;&#x28;SELECT d.id_acto_apertura AS id_acto_apertura_de,&#xa;	d.fecha_creacion AS fecha_creacion_dictamen,&#xa;	d.fecha_generacion_dictamen AS fecha_generacion_dictamen,&#xa;	&#x27;DIE&#x3a;&#x27; &#x7c;&#x7c; d.numero &#x7c;&#x7c; &#x27;&#x2f;&#x27; &#x7c;&#x7c; d.ejercicio AS identificador_dictamen, &#xa;	&#x28;SELECT nombre AS estado_acto_apertura FROM diaguita.scp_estados e WHERE e.estado&#x3d;d.estado&#x29; AS estado_dictamen&#xa;FROM diaguita.scp_dictamenes_evaluacion d&#xa;&#x29; dictamen_evaluacion&#xa;ON acto_apertura.id_acto_apertura&#x3d;dictamen_evaluacion.id_acto_apertura_de&#x3b;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>96</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

