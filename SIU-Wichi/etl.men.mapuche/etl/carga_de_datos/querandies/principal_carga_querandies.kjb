<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>principal_carga_querandies</name>
  <description>Carga de datos provenientes de SIU-Querandies</description>
  <extended_description>Carga de datos provenientes de SIU-Querandies.
A fin de posibilitar la carga de datos en instalaciones donde no exista conectividad entre el la base de datos Wichi y el sistema fuente, el proceso de carga está separado en extracción e importación.
</extended_description>
  <job_version/>
  <job_status>1</job_status>
  <directory>/</directory>
  <created_user>-</created_user>
  <created_date>2013/01/24 12:23:51.985</created_date>
  <modified_user>-</modified_user>
  <modified_date>2013/01/24 12:23:51.985</modified_date>
  <parameters>
    <parameter>
      <name>base_wichi_clave</name>
      <default_value>__SIN_VALOR___x1tljQ7imSqp_fBnDme5M2WZBADj0iuK</default_value>
      <description>clave del usuario de la base siu_wichi</description>
    </parameter>
    <parameter>
      <name>base_wichi_host</name>
      <default_value>localhost</default_value>
      <description>IP o nombre del host donde se encuentra la base siu_wichi</description>
    </parameter>
    <parameter>
      <name>base_wichi_nombre</name>
      <default_value>siu_wichi</default_value>
      <description>nombre de la base de datos de wichi</description>
    </parameter>
    <parameter>
      <name>base_wichi_puerto</name>
      <default_value>5432</default_value>
      <description>puerto al en el que escucha el servidor de postgres de wichi</description>
    </parameter>
    <parameter>
      <name>base_wichi_usuario</name>
      <default_value>postgres</default_value>
      <description>usuario que tiene acceso al servidor de postgres de wichi</description>
    </parameter>
    <parameter>
      <name>carga_actualizacion</name>
      <default_value>auto</default_value>
      <description>0/1/auto . Si es "auto" carga o actualiza los datos según corresponda. Los valores 0 y 1 permiten restringir la acción: Si es 0 y en wichi existen datos para el periodo, detiene la ejecucion. Si es 1 y en wichi no existen datos para el periodo, detiene la ejecución.</description>
    </parameter>
    <parameter>
      <name>carga_comentario</name>
      <default_value>importacion</default_value>
      <description>(Opcional) </description>
    </parameter>
    <parameter>
      <name>carga_directorioTemporal</name>
      <default_value>/home/wichi/querandies</default_value>
      <description>directorio temporal vacío para armado del paquete</description>
    </parameter>
    <parameter>
      <name>carga_instalacion</name>
      <default_value></default_value>
      <description>Número de instalación en formato id-codigo (ej:3-692)</description>
    </parameter>
    <parameter>
      <name>paquete_directorio</name>
      <default_value>-</default_value>
      <description>(Opcional)  si se especifica, al terminar deja una copia del paquete de datos wichi. Debe ser distinto de "-"</description>
    </parameter>
    <parameter>
      <name>paquete_rutaGpg</name>
      <default_value>/usr/bin/gpg</default_value>
      <description>ruta al ejecutable de gpg</description>
    </parameter>
    <parameter>
      <name>performance_commit_size</name>
      <default_value>5000</default_value>
      <description>cada cuantos insert se hace commit</description>
    </parameter>
  </parameters>
