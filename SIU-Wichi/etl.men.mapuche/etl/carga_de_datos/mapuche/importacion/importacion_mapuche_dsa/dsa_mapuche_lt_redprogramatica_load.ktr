  <step>
    <name>map_tmp_lt_redprogramatica</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>siu_dsa</connection>
    <sql>SELECT CASE  WHEN dh27.codn_progr &lt; 10 THEN '0' || dh27.codn_progr::TEXT ELSE dh27.codn_progr::TEXT END ||
	CASE  WHEN dh27.codn_subpr &lt; 10 THEN '0' || dh27.codn_subpr::TEXT ELSE dh27.codn_subpr::TEXT END ||
	CASE  WHEN dh27.codn_proye &lt; 10 THEN '0' || dh27.codn_proye::TEXT ELSE dh27.codn_proye::TEXT END ||
	CASE  WHEN dh27.codn_activ &lt; 10 THEN '0' || dh27.codn_activ::TEXT ELSE dh27.codn_activ::TEXT END ||
	CASE  WHEN dh27.codn_obra &lt; 10 THEN '0' || dh27.codn_obra::TEXT ELSE dh27.codn_obra::TEXT END AS red_programatica_codigo,
CASE  WHEN codn_progr &lt; 10 THEN '0' || codn_progr::TEXT ELSE codn_progr::TEXT END as programa_codigo,
(SELECT distinct CASE  WHEN p.codn_progr &lt; 10 THEN '0' || p.codn_progr::TEXT || ' - ' || p.desc_imput  ELSE p.codn_progr::TEXT || ' - ' || p.desc_imput  END 
FROM mapuche_tmp.d_redprogramatica p where dh27.codn_progr=p.codn_progr AND p.codn_subpr = 0 AND p.codn_proye =0 AND p.codn_activ=0 AND p.codn_obra =0) as programa_desc,
CASE  WHEN codn_subpr &lt; 10 THEN '0' || codn_subpr::TEXT ELSE codn_subpr::TEXT END as subprograma_codigo,
COALESCE((SELECT CASE  WHEN subp.codn_subpr &lt; 10 THEN '0' || subp.codn_subpr::TEXT  || ' - ' || subp.desc_imput   ELSE subp.codn_subpr::TEXT || ' - ' || subp.desc_imput END FROM (SELECT distinct codn_progr, codn_subpr, codn_proye, codn_activ, codn_obra, desc_imput  as desc_imput
	FROM mapuche_tmp.d_redprogramatica where codn_subpr&lt;&gt;0 AND codn_proye =0 AND codn_activ=0 AND codn_obra =0)subp 
	where dh27.codn_progr=subp.codn_progr AND dh27.codn_subpr = subp.codn_subpr), '00 - SIN SUBPROGRAMA') as subprograma_desc,
CASE  WHEN codn_proye &lt; 10 THEN '0' || codn_proye::TEXT ELSE codn_proye::TEXT END as proyecto_codigo,
COALESCE((SELECT CASE  WHEN codn_proye &lt; 10 THEN '0' || codn_proye::TEXT || ' - ' || desc_imput  ELSE codn_proye::TEXT || ' - ' || desc_imput  END FROM (SELECT distinct codn_progr, codn_subpr, codn_proye, codn_activ, codn_obra, desc_imput  as desc_imput
	FROM mapuche_tmp.d_redprogramatica where codn_proye &lt;&gt;0 AND codn_activ=0 AND codn_obra =0)proy 
	where dh27.codn_progr=proy.codn_progr AND dh27.codn_subpr = proy.codn_subpr AND dh27.codn_proye = proy.codn_proye), '00 - SIN PROYECTO')  as proyecto_desc,
CASE  WHEN codn_activ &lt; 10 THEN '0' || codn_activ::TEXT ELSE codn_activ::TEXT END as actividad_codigo,
COALESCE((SELECT CASE  WHEN codn_activ &lt; 10 THEN '0' || codn_activ::TEXT || ' - ' || desc_imput  ELSE codn_activ::TEXT || ' - ' || desc_imput END FROM (SELECT distinct codn_progr, codn_subpr, codn_proye, codn_activ, codn_obra, desc_imput  as desc_imput
	FROM mapuche_tmp.d_redprogramatica where codn_activ&lt;&gt;0 AND codn_obra =0)actividades 
	where dh27.codn_progr=actividades.codn_progr AND dh27.codn_subpr = actividades.codn_subpr 
	AND dh27.codn_proye =actividades.codn_proye AND dh27.codn_activ=actividades.codn_activ), '00 - SIN ACTIVIDAD')  as actividad_desc,
CASE  WHEN codn_obra &lt; 10 THEN '0' || codn_obra::TEXT ELSE codn_obra::TEXT END as obra_codigo,
COALESCE((SELECT CASE  WHEN codn_obra &lt; 10 THEN '0' || codn_obra::TEXT || ' - ' || desc_imput ELSE codn_obra::TEXT || ' - ' || desc_imput END  FROM (SELECT distinct codn_progr, codn_subpr, codn_proye, codn_activ, codn_obra, desc_imput  as desc_imput
	FROM mapuche_tmp.d_redprogramatica where codn_obra &lt;&gt;0)obra 
	where dh27.codn_progr=obra.codn_progr AND dh27.codn_subpr = obra.codn_subpr 
	AND dh27.codn_proye =obra.codn_proye AND dh27.codn_activ=obra.codn_activ AND dh27.codn_obra  = obra.codn_obra ), '00 - SIN OBRA') as obra_desc, 
${subfuente} as subfuente_id
FROM mapuche_tmp.d_redprogramatica dh27
ORDER BY 1</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
