  <notepads>
    <notepad>
      <note>Solo se utiliza para generar filas</note>
      <xloc>2</xloc>
      <yloc>24</yloc>
      <width>201</width>
      <heigth>25</heigth>
      <fontname>Sans</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
