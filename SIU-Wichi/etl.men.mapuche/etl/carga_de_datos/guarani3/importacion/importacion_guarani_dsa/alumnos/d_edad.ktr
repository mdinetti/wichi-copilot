      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>siu_dsa</name>
    <server>&#x24;&#x7b;dsa_nombrehost&#x7d;</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>&#x24;&#x7b;dsa_nombrebase&#x7d;</database>
    <port>&#x24;&#x7b;dsa_puerto&#x7d;</port>
    <username>&#x24;&#x7b;dsa_usuario&#x7d;</username>
    <password>&#x24;&#x7b;dsa_clave&#x7d;</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>&#x24;&#x7b;dsa_puerto&#x7d;</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SQL_CONNECT</code><attribute>SET datestyle to iso,YMD</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>N</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
  <hop> <from>Generar las edades</from><to>Establecer Rango de edades</to><enabled>Y</enabled> </hop>
  <hop> <from>Generate Rows</from><to>Generar las edades</to><enabled>Y</enabled> </hop>
  <hop> <from>Establecer Rango de edades</from><to>Selecciona&#x2f;Renombra valores</to><enabled>Y</enabled> </hop>
  <hop> <from>Selecciona&#x2f;Renombra valores</from><to>Cargar&#x2f;Actualizar dimensi&#xf3;n</to><enabled>Y</enabled> </hop>
  </order>
  <step>
    <name>Cargar&#x2f;Actualizar dimensi&#xf3;n</name>
    <type>DimensionLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
      <schema>guarani3_dsa</schema>
      <table>d_edad</table>
      <connection>siu_dsa</connection>
      <commit>0</commit>
      <update>Y</update>
      <fields>
        <key>
          <name>edad</name>
          <lookup>edad</lookup>
        </key>
        <date>
          <name>fecha_actualizacion</name>
          <from>fecha_desde</from>
          <to>fecha_hasta</to>
        </date>
        <field>
          <name>rango_edad_desc</name>
          <lookup>rango_edad_desc</lookup>
          <update>Punch through</update>
        </field>
        <field>
          <name/>
          <lookup>vigente</lookup>
          <update>LastVersion</update>
        </field>
        <field>
          <name/>
          <lookup>fecha_actualizacion</lookup>
          <update>DateInsertedOrUpdated</update>
        </field>
        <return>
          <name>edad_id</name>
          <rename/>
          <creation_method>tablemax</creation_method>
          <use_autoinc>N</use_autoinc>
          <version>version</version>
        </return>
      </fields>
      <sequence/>
      <min_year>1900</min_year>
      <max_year>2199</max_year>
      <cache_size>5000</cache_size>
      <preload_cache>N</preload_cache>
      <use_start_date_alternative>Y</use_start_date_alternative>
      <start_date_alternative>sysdate</start_date_alternative>
      <start_date_field_name/>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>686</xloc>
      <yloc>171</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>Establecer Rango de edades</name>
    <type>NumberRange</type>
    <description>Genera los rangos de edades</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <inputField>edad</inputField>
    <outputField>rango_edad_desc</outputField>
    <fallBackValue>indefinido</fallBackValue>
    <rules>
      <rule>
        <lower_bound>-1.7976931348623157E308</lower_bound>
        <upper_bound>0.0</upper_bound>
        <value>Edades negativas o nulas</value>
      </rule>
      <rule>
        <lower_bound>0.0</lower_bound>
        <upper_bound>17.0</upper_bound>
        <value>0 - 16</value>
      </rule>
      <rule>
        <lower_bound>17.0</lower_bound>
        <upper_bound>20.0</upper_bound>
        <value>17 - 19</value>
      </rule>
      <rule>
        <lower_bound>20.0</lower_bound>
        <upper_bound>25.0</upper_bound>
        <value>20 - 24</value>
      </rule>
      <rule>
        <lower_bound>25.0</lower_bound>
        <upper_bound>30.0</upper_bound>
        <value>25 - 29</value>
      </rule>
      <rule>
        <lower_bound>30.0</lower_bound>
        <upper_bound>35.0</upper_bound>
        <value>30 - 34</value>
      </rule>
      <rule>
        <lower_bound>35.0</lower_bound>
        <upper_bound>40.0</upper_bound>
        <value>35 - 39</value>
      </rule>
      <rule>
        <lower_bound>40.0</lower_bound>
        <upper_bound>50.0</upper_bound>
        <value>40 - 49</value>
      </rule>
      <rule>
        <lower_bound>50.0</lower_bound>
        <upper_bound>60.0</upper_bound>
        <value>50 - 59</value>
      </rule>
      <rule>
        <lower_bound>60.0</lower_bound>
        <upper_bound>1.7976931348623157E308</upper_bound>
        <value>60 y M&#xe1;s</value>
      </rule>
    </rules>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>471</xloc>
      <yloc>67</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>Generar las edades</name>
    <type>Sequence</type>
    <description>Genera las edades del 0 al 110</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
      <valuename>edad</valuename>
      <use_database>N</use_database>
      <connection>siu_dsa</connection>
      <schema/>
      <seqname>SEQ_</seqname>
      <use_counter>Y</use_counter>
      <counter_name/>
      <start_at>0</start_at>
      <increment_by>1</increment_by>
      <max_value>110</max_value>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>245</xloc>
      <yloc>67</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>Generate Rows</name>
    <type>RowGenerator</type>
    <description>Este paso solo se utiliza para generar filas</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <fields>
      <field>
        <name>edades</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <limit>110</limit>
    <never_ending>N</never_ending>
    <interval_in_ms/>
    <row_time_field/>
    <last_time_field/>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>70</xloc>
      <yloc>68</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step>
    <name>Selecciona&#x2f;Renombra valores</name>
    <type>SelectValues</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <fields>      <field>        <name>edades</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>      <field>        <name>edad</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>      <field>        <name>rango_edad_desc</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>        <select_unspecified>N</select_unspecified>
      <remove>        <name>edades</name>
      </remove>    </fields>     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>472</xloc>
      <yloc>172</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

  <step_error_handling>
  </step_error_handling>
   <slave-step-copy-partition-distribution>
</slave-step-copy-partition-distribution>
   <slave_transformation>N</slave_transformation>

</transformation>
