    <entry>
      <name>crear importaci&#xf3;n</name>
      <description/>
      <type>SQL</type>
      <sql>insert into public.importacion&#x28;fecha_inicio, observaciones, estado,tipo, parametros, instalacion_id&#x29;&#xa;values&#x28;&#xa;    now&#x28;&#x29;,&#xa;    &#x27;&#x24;&#x7b;observaciones&#x7d;&#x27;,&#xa;    &#x27;en proceso&#x27;,&#xa;    &#x27;&#x24;&#x7b;tipo_importacion&#x7d;&#x27;,&#xa;    &#x27;base&#x3d;&#x24;&#x7b;dw_nombrebase&#x7d; host&#x3d;&#x24;&#x7b;dw_nombrehost&#x7d; puerto&#x3d;&#x24;&#x7b;dw_puerto&#x7d; usuario&#x3d;&#x24;&#x7b;dw_usuario&#x7d;&#x27;,&#xa;    &#x24;&#x7b;instalacion_id&#x7d;&#xa;&#x29;&#x3b;&#xa;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>siu_dw</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>590</xloc>
      <yloc>83</yloc>
      </entry>
